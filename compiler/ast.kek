// AST. Every node carries `id: Int`
// (unique within a parse session) so that later passes can key Maps by
// node.

struct AstPos {
    file: String,
    line: Int,
    col: Int,
}

struct AstError {
    pos: AstPos,
    msg: String,
}

struct AstFile {
    structs: Vec<AstStructDecl>,
    enums: Vec<AstEnumDecl>,
    funcs: Vec<AstFuncDecl>,
    impls: Vec<AstImplDecl>,
    traits: Vec<AstTraitDecl>,
}

// ---- types ----

enum AstType {
    Named(AstNamedType),
    Ref(AstRefType),
    Unit(AstUnitType),
    Tuple(AstTupleType),
    Fn(AstFnType),
}

// A named type `Name<Args>`. name may be a path to an associated type
// (`Self::Item`, `T::Item`). In the arguments of a trait bound, an
// associated type binding `Item = T` has name "=Item" and args [T].
struct AstNamedType {
    id: Int,
    pos: AstPos,
    mut name: String,
    mut args: Vec<AstType>,
}

// `&T` or `&mut T`: a borrowed capability, or (for any other type) the
// type itself.
struct AstRefType {
    id: Int,
    pos: AstPos,
    mutable: Bool,
    elem: AstType,
}

struct AstUnitType {
    id: Int,
    pos: AstPos,
}

// A function type: `fn(A) -> R`, or the trait bound `Fn(A) -> R` (also
// FnMut, FnOnce), possibly written `impl Fn(A) -> R` or `dyn Fn(A) -> R`.
// kind is the spelling before the parameters ("fn", "Fn", "impl FnMut",
// ...).
struct AstFnType {
    id: Int,
    pos: AstPos,
    kind: String,
    params: Vec<AstType>,
    mut result: Option<AstType>,
}

// `(A, B, ...)`: at least one element (`(A,)` has one).
struct AstTupleType {
    id: Int,
    pos: AstPos,
    elems: Vec<AstType>,
}

// ---- declarations ----

// `#[name]` or `#[name(arg, ...)]` (e.g. `#[derive(PartialEq, Hash)]`).
struct AstAttr {
    pos: AstPos,
    name: String,
    args: Vec<String>,
}

// A struct field; `mut name: T` can be assigned after construction.
struct AstField {
    id: Int,
    pos: AstPos,
    mutable: Bool,
    name: String,
    ty: AstType,
}

// A generic parameter `T` or `T: Bound + Bound`.
struct AstGeneric {
    id: Int,
    pos: AstPos,
    name: String,
    bounds: Vec<AstType>,
}

struct AstStructDecl {
    id: Int,
    pos: AstPos,
    mut attrs: Vec<AstAttr>,
    name: String,
    generics: Vec<AstGeneric>,
    fields: Vec<AstField>,
}

struct AstVariant {
    id: Int,
    pos: AstPos,
    name: String,
    fields: Vec<AstType>,
}

struct AstEnumDecl {
    id: Int,
    pos: AstPos,
    mut attrs: Vec<AstAttr>,
    name: String,
    generics: Vec<AstGeneric>,
    variants: Vec<AstVariant>,
}

// Param of a function (ty always present) or a closure (ty optional).
struct AstParam {
    id: Int,
    pos: AstPos,
    name: String,
    ty: Option<AstType>,
}

// A function, or a method in an `impl` block. A method's receiver is
// params[0], named `self` without a type; self_kind is its spelling
// ("self", "&self" or "&mut self", all the same since structs are
// references) and "" for functions without a receiver.
struct AstFuncDecl {
    id: Int,
    pos: AstPos,
    mut attrs: Vec<AstAttr>,
    name: String,
    generics: Vec<AstGeneric>,
    self_kind: String,
    params: Vec<AstParam>,
    result: Option<AstType>,
    wheres: Vec<AstWhere>,
    // false for a required trait method `fn f(&self);` (body is empty)
    has_body: Bool,
    body: AstBlock,
}

// A `where` clause item `T: Bound + Bound` (T may be any type, e.g.
// `Self::Item`).
struct AstWhere {
    id: Int,
    pos: AstPos,
    ty: AstType,
    bounds: Vec<AstType>,
}

// `type Name;` in a trait (ty is None) or `type Name = T;` in an impl.
struct AstAssocType {
    id: Int,
    pos: AstPos,
    name: String,
    mut ty: Option<AstType>,
}

// `trait Name: Super + Super { type A; fn f(&self) -> T; fn g(&self) { } }`.
struct AstTraitDecl {
    id: Int,
    pos: AstPos,
    name: String,
    generics: Vec<AstGeneric>,
    supers: Vec<AstType>,
    assoc: Vec<AstAssocType>,
    funcs: Vec<AstFuncDecl>,
}

// `impl<T> Target<T> { fn ... }`, or `impl<T> Trait for Target<T> { ... }`
// when trait_ty is set.
struct AstImplDecl {
    id: Int,
    pos: AstPos,
    generics: Vec<AstGeneric>,
    mut trait_ty: Option<AstType>,
    mut target: AstType,
    mut wheres: Vec<AstWhere>,
    assoc: Vec<AstAssocType>,
    funcs: Vec<AstFuncDecl>,
}

// ---- statements ----

enum AstStmt {
    Let(AstLetStmt),
    Assign(AstAssignStmt),
    FieldAssign(AstFieldAssignStmt),
    Break(AstBreakStmt),
    Continue(AstContinueStmt),
    While(AstWhileStmt),
    For(AstForStmt),
    Return(AstReturnStmt),
    Expr(AstExprStmt),
}

// `let x = e;` or, with pat set, `let (a, b) = e;` (name is then "_").
struct AstLetStmt {
    id: Int,
    pos: AstPos,
    mutable: Bool,
    name: String,
    pat: Option<AstPattern>,
    ty: Option<AstType>,
    init: AstExpr,
}

struct AstAssignStmt {
    id: Int,
    pos: AstPos,
    name: String,
    value: AstExpr,
}

struct AstFieldAssignStmt {
    id: Int,
    pos: AstPos,
    target: AstFieldExpr,
    value: AstExpr,
}

struct AstBreakStmt {
    id: Int,
    pos: AstPos,
}

struct AstContinueStmt {
    id: Int,
    pos: AstPos,
}

// `while cond { }`, or `while let pat = cond { }` when pat is set.
struct AstWhileStmt {
    id: Int,
    pos: AstPos,
    pat: Option<AstPattern>,
    cond: AstExpr,
    body: AstBlock,
}

// `for x in start..end { }` (end is Some) or `for x in vec { }`. With pat
// set, the loop variable is a pattern (`for (k, v) in ...`; var is "_").
struct AstForStmt {
    id: Int,
    pos: AstPos,
    var: String,
    pat: Option<AstPattern>,
    iter: AstExpr,
    end: Option<AstExpr>,
    body: AstBlock,
}

struct AstReturnStmt {
    id: Int,
    pos: AstPos,
    value: Option<AstExpr>,
}

struct AstExprStmt {
    id: Int,
    pos: AstPos,
    x: AstExpr,
    semi: Bool,
}

// ---- expressions ----

enum AstExpr {
    IntLit(AstIntLit),
    BoolLit(AstBoolLit),
    StrLit(AstStringLit),
    UnitLit(AstUnitLit),
    Ident(AstIdent),
    Binary(AstBinary),
    Unary(AstUnary),
    Call(AstCall),
    Method(AstMethodCall),
    Field(AstFieldExpr),
    Path(AstPathExpr),
    StructLit(AstStructLit),
    If(AstIf),
    Match(AstMatch),
    Block(AstBlock),
    Try(AstTry),
    Closure(AstClosure),
    Tuple(AstTupleLit),
    Range(AstRange),
}

// `start..end` or `start..=end` (inclusive).
struct AstRange {
    id: Int,
    pos: AstPos,
    start: AstExpr,
    end: AstExpr,
    inclusive: Bool,
}

struct AstIntLit {
    id: Int,
    pos: AstPos,
    value: Int,
}

struct AstBoolLit {
    id: Int,
    pos: AstPos,
    value: Bool,
}

struct AstStringLit {
    id: Int,
    pos: AstPos,
    value: String,
}

struct AstUnitLit {
    id: Int,
    pos: AstPos,
}

// `(a, b, ...)`: at least one element (`(a,)` has one).
struct AstTupleLit {
    id: Int,
    pos: AstPos,
    elems: Vec<AstExpr>,
}

// `name` or, with explicit type arguments, `name::<T>`.
struct AstIdent {
    id: Int,
    pos: AstPos,
    name: String,
    targs: Vec<AstType>,
}

// op is a token kind ("+", "==", "&&", ...).
struct AstBinary {
    id: Int,
    pos: AstPos,
    op: String,
    x: AstExpr,
    y: AstExpr,
}

// op is "-", "!", or one of "&", "&mut ", "*" (no-ops kept for Rust's
// spelling: values of structs and collections are references already).
struct AstUnary {
    id: Int,
    pos: AstPos,
    op: String,
    x: AstExpr,
}

struct AstCall {
    id: Int,
    pos: AstPos,
    func: AstExpr,
    args: Vec<AstExpr>,
}

struct AstMethodCall {
    id: Int,
    pos: AstPos,
    recv: AstExpr,
    name: String,
    targs: Vec<AstType>,
    args: Vec<AstExpr>,
}

// `x.name`, or `x.0` for a tuple element (name is the index).
struct AstFieldExpr {
    id: Int,
    pos: AstPos,
    x: AstExpr,
    name: String,
}

// `Type::name`; ty_args are the type's arguments (`Vec::<Int>::new`) and
// targs the function's (`Type::name::<T>`).
struct AstPathExpr {
    id: Int,
    pos: AstPos,
    ty: String,
    ty_args: Vec<AstType>,
    name: String,
    targs: Vec<AstType>,
}

struct AstFieldInit {
    id: Int,
    pos: AstPos,
    name: String,
    value: AstExpr,
}

struct AstStructLit {
    id: Int,
    pos: AstPos,
    name: String,
    fields: Vec<AstFieldInit>,
}

// `if cond { }`, or `if let pat = cond { }` when pat is set.
struct AstIf {
    id: Int,
    pos: AstPos,
    pat: Option<AstPattern>,
    cond: AstExpr,
    then: AstBlock,
    mut els: Option<AstExpr>,
}

// Pattern in a match arm. Patterns nest: `Ok(Some(n))`. A tuple pattern
// `(p, q)` has tuple set and its elements in args (`()` has none).
struct AstPattern {
    id: Int,
    pos: AstPos,
    mut wildcard: Bool,
    mut tuple: Bool,
    mut mutable: Bool,
    mut bind: String,
    mut ty: String,
    mut ctor: String,
    args: Vec<AstPattern>,
    mut int_value: Option<Int>,
    mut bool_lit: Option<Bool>,
    mut str_value: Option<String>,
}

struct AstMatchArm {
    id: Int,
    pos: AstPos,
    pat: AstPattern,
    body: AstExpr,
}

struct AstMatch {
    id: Int,
    pos: AstPos,
    x: AstExpr,
    arms: Vec<AstMatchArm>,
}

struct AstBlock {
    id: Int,
    pos: AstPos,
    stmts: Vec<AstStmt>,
    mut tail: Option<AstExpr>,
    mut end: AstPos,
}

struct AstTry {
    id: Int,
    pos: AstPos,
    x: AstExpr,
}

// `|x, y| body`, `|x: T| -> R { ... }`, `move |x| ...`.
struct AstClosure {
    id: Int,
    pos: AstPos,
    is_move: Bool,
    params: Vec<AstParam>,
    result: Option<AstType>,
    body: AstExpr,
}

// ---- helpers ----

fn ast_pos_string(p: AstPos) -> String {
    if p.file != "" {
        return p.file + ":" + p.line.to_string() + ":" + p.col.to_string();
    }
    p.line.to_string() + ":" + p.col.to_string()
}

fn ast_error_string(e: AstError) -> String {
    ast_pos_string(e.pos) + ": " + e.msg
}

fn ast_type_pos(t: AstType) -> AstPos {
    match t {
        AstType::Named(n) => n.pos,
        AstType::Ref(r) => r.pos,
        AstType::Unit(u) => u.pos,
        AstType::Tuple(t) => t.pos,
        AstType::Fn(t) => t.pos,
    }
}

fn ast_expr_pos(e: AstExpr) -> AstPos {
    match e {
        AstExpr::IntLit(x) => x.pos,
        AstExpr::BoolLit(x) => x.pos,
        AstExpr::StrLit(x) => x.pos,
        AstExpr::UnitLit(x) => x.pos,
        AstExpr::Ident(x) => x.pos,
        AstExpr::Binary(x) => x.pos,
        AstExpr::Unary(x) => x.pos,
        AstExpr::Call(x) => x.pos,
        AstExpr::Method(x) => x.pos,
        AstExpr::Field(x) => x.pos,
        AstExpr::Path(x) => x.pos,
        AstExpr::StructLit(x) => x.pos,
        AstExpr::If(x) => x.pos,
        AstExpr::Match(x) => x.pos,
        AstExpr::Block(x) => x.pos,
        AstExpr::Try(x) => x.pos,
        AstExpr::Closure(x) => x.pos,
        AstExpr::Tuple(x) => x.pos,
        AstExpr::Range(x) => x.pos,
    }
}

fn ast_expr_id(e: AstExpr) -> Int {
    match e {
        AstExpr::IntLit(x) => x.id,
        AstExpr::BoolLit(x) => x.id,
        AstExpr::StrLit(x) => x.id,
        AstExpr::UnitLit(x) => x.id,
        AstExpr::Ident(x) => x.id,
        AstExpr::Binary(x) => x.id,
        AstExpr::Unary(x) => x.id,
        AstExpr::Call(x) => x.id,
        AstExpr::Method(x) => x.id,
        AstExpr::Field(x) => x.id,
        AstExpr::Path(x) => x.id,
        AstExpr::StructLit(x) => x.id,
        AstExpr::If(x) => x.id,
        AstExpr::Match(x) => x.id,
        AstExpr::Block(x) => x.id,
        AstExpr::Try(x) => x.id,
        AstExpr::Closure(x) => x.id,
        AstExpr::Tuple(x) => x.id,
        AstExpr::Range(x) => x.id,
    }
}

fn ast_has_attr(f: AstFuncDecl, name: String) -> Bool {
    for a in f.attrs {
        if a.name == name {
            return true;
        }
    }
    false
}

// ast_find_attr returns the attribute named name.
fn ast_find_attr(attrs: Vec<AstAttr>, name: String) -> Option<AstAttr> {
    for a in attrs {
        if a.name == name {
            return Some(a);
        }
    }
    None
}

// ast_attr_has reports whether an attribute has the bare argument arg
// (`#[allow(similar)]`).
fn ast_attr_has(a: AstAttr, arg: String) -> Bool {
    for x in a.args {
        if x == arg {
            return true;
        }
    }
    false
}

// ast_attr_value returns the value of the argument `key = value` of an
// attribute (a string literal is unquoted).
fn ast_attr_value(a: AstAttr, key: String) -> Option<String> {
    let prefix = key + " = ";
    for x in a.args {
        if x.starts_with(prefix) {
            let v = x.slice(prefix.len(), x.len());
            if v.starts_with("\"") {
                return Some(ast_unquote(v));
            }
            return Some(v);
        }
    }
    None
}

// ast_unquote reverses ast_quote.
fn ast_unquote(q: String) -> String {
    let s = q.slice(1, q.len() - 1);
    let parts = Vec::new();
    let mut i = 0;
    let mut start = 0;
    while i < s.len() {
        if s.char_at(i).unwrap_or(0) == 92 {
            parts.push(s.slice(start, i));
            let e = s.char_at(i + 1).unwrap_or(0);
            if e == 110 {
                parts.push("\n");
            } else if e == 116 {
                parts.push("\t");
            } else if e == 114 {
                parts.push("\r");
            } else if e == 120 {
                let h = s.slice(i + 2, i + 4);
                let mut v = 0;
                for k in 0..2 {
                    v = v * 16 + tool_json_hex(h.char_at(k).unwrap_or(48));
                }
                parts.push(String::from_char(v));
                i = i + 2;
            } else {
                parts.push(String::from_char(e));
            }
            i = i + 2;
            start = i;
            continue;
        }
        i = i + 1;
    }
    parts.push(s.slice(start, s.len()));
    parts.join("")
}

// ast_pos_less orders positions by (file, line, col).
fn ast_pos_less(a: AstPos, b: AstPos) -> Bool {
    if a.file != b.file {
        return ast_str_less(a.file, b.file);
    }
    if a.line != b.line {
        return a.line < b.line;
    }
    a.col < b.col
}

// ast_str_less compares strings by UTF-16 code units (equal to byte order
// for the ASCII strings the compiler compares).
fn ast_str_less(a: String, b: String) -> Bool {
    let n = a.len().min(b.len());
    for i in 0..n {
        let x = a.char_at(i).unwrap_or(0);
        let y = b.char_at(i).unwrap_or(0);
        if x != y {
            return x < y;
        }
    }
    a.len() < b.len()
}

// ast_sort_errors is a stable sort by position.
fn ast_sort_errors(errs: Vec<AstError>) -> Vec<AstError> {
    let n = errs.len();
    if n <= 1 {
        return errs;
    }
    let mid = n / 2;
    let left = Vec::new();
    let right = Vec::new();
    for i in 0..n {
        let e = errs.get(i).unwrap_or(AstError {
            pos: AstPos { file: "", line: 0, col: 0 },
            msg: "",
        });
        if i < mid {
            left.push(e);
        } else {
            right.push(e);
        }
    }
    let l = ast_sort_errors(left);
    let r = ast_sort_errors(right);
    let out = Vec::new();
    let mut i = 0;
    let mut j = 0;
    while i < l.len() || j < r.len() {
        if j >= r.len() {
            out.push(ast_err_at(l, i));
            i = i + 1;
        } else if i >= l.len() {
            out.push(ast_err_at(r, j));
            j = j + 1;
        } else if ast_pos_less(ast_err_at(r, j).pos, ast_err_at(l, i).pos) {
            out.push(ast_err_at(r, j));
            j = j + 1;
        } else {
            out.push(ast_err_at(l, i));
            i = i + 1;
        }
    }
    out
}

fn ast_err_at(v: Vec<AstError>, i: Int) -> AstError {
    match v.get(i) {
        Some(e) => e,
        None => AstError { pos: AstPos { file: "", line: 0, col: 0 }, msg: "" },
    }
}

// ast_quote is the canonical string quoting of the dumps.
fn ast_quote(s: String) -> String {
    let parts = Vec::new();
    parts.push("\"");
    let n = s.len();
    let mut start = 0;
    for i in 0..n {
        let c = s.char_at(i).unwrap_or(0);
        let mut esc = "";
        if c == 92 {
            esc = "\\\\";
        } else if c == 34 {
            esc = "\\\"";
        } else if c == 10 {
            esc = "\\n";
        } else if c == 9 {
            esc = "\\t";
        } else if c == 13 {
            esc = "\\r";
        } else if c < 32 || c == 127 {
            esc = "\\x" + lex_hex2(c);
        }
        if esc != "" {
            parts.push(s.slice(start, i));
            parts.push(esc);
            start = i + 1;
        }
    }
    parts.push(s.slice(start, n));
    parts.push("\"");
    parts.join("")
}
