// Canonical dumps of tokens and syntax trees (`kek lex`, `kek ast`).

struct AstDumper {
    lines: Vec<String>,
}

fn ast_dump_pos(p: AstPos) -> String {
    p.line.to_string() + ":" + p.col.to_string()
}

fn ast_dump_tokens(toks: Vec<Tok>, errs: Vec<AstError>) -> Vec<String> {
    let mut out = Vec::new();
    for t in toks {
        out.push(ast_dump_pos(t.pos) + " " + lex_kind_name(t.kind) + " " + ast_quote(t.text));
    }
    for e in errs {
        out.push("error " + ast_error_string(e));
    }
    out
}

fn ast_indent(depth: Int) -> String {
    let mut parts = Vec::new();
    for i in 0..depth {
        parts.push("  ");
    }
    parts.join("")
}

fn ast_line(mut d: AstDumper, depth: Int, s: String) {
    d.lines.push(ast_indent(depth) + s);
}

fn ast_dump_file(f: AstFile) -> Vec<String> {
    let d = AstDumper { lines: Vec::new() };
    for s in f.structs {
        ast_line(d, 0, "struct " + s.name + " @" + ast_dump_pos(s.pos));
        ast_dump_attrs(d, 1, s.attrs);
        ast_dump_generics(d, 1, s.generics);
        for fl in s.fields {
            let m = if fl.mutable { " mut" } else { "" };
            ast_line(d, 1, "field " + fl.name + m + " @" + ast_dump_pos(fl.pos));
            ast_dump_type(d, 2, fl.ty);
        }
    }
    for e in f.enums {
        ast_line(d, 0, "enum " + e.name + " @" + ast_dump_pos(e.pos));
        ast_dump_attrs(d, 1, e.attrs);
        ast_dump_generics(d, 1, e.generics);
        for v in e.variants {
            ast_line(d, 1, "variant " + v.name + " @" + ast_dump_pos(v.pos));
            for t in v.fields {
                ast_dump_type(d, 2, t);
            }
        }
    }
    for fd in f.funcs {
        ast_dump_func(d, 0, fd);
    }
    for im in f.impls {
        ast_line(d, 0, "impl @" + ast_dump_pos(im.pos));
        ast_dump_generics(d, 1, im.generics);
        match im.trait_ty {
            Some(t) => {
                ast_line(d, 1, "trait");
                ast_dump_type(d, 2, t);
            }
            None => {}
        }
        ast_line(d, 1, "target");
        ast_dump_type(d, 2, im.target);
        ast_dump_wheres(d, 1, im.wheres);
        for a in im.assoc {
            ast_dump_assoc(d, 1, a);
        }
        for fd in im.funcs {
            ast_dump_func(d, 1, fd);
        }
    }
    for t in f.traits {
        ast_line(d, 0, "trait " + t.name + " @" + ast_dump_pos(t.pos));
        ast_dump_generics(d, 1, t.generics);
        for s in t.supers {
            ast_dump_type(d, 1, s);
        }
        for a in t.assoc {
            ast_dump_assoc(d, 1, a);
        }
        for fd in t.funcs {
            ast_dump_func(d, 1, fd);
        }
    }
    for a in f.aliases {
        ast_line(d, 0, "type " + a.name + " @" + ast_dump_pos(a.pos));
        ast_dump_type(d, 1, a.ty);
        match a.pred {
            Some(e) => {
                ast_line(d, 1, "where");
                ast_dump_expr(d, 2, e);
            }
            None => {}
        }
    }
    d.lines
}

fn ast_dump_assoc(d: AstDumper, depth: Int, a: AstAssocType) {
    ast_line(d, depth, "assoc-type " + a.name + " @" + ast_dump_pos(a.pos));
    match a.ty {
        Some(t) => ast_dump_type(d, depth + 1, t),
        None => {}
    }
}

fn ast_dump_attrs(d: AstDumper, depth: Int, attrs: Vec<AstAttr>) {
    for a in attrs {
        let mut s = "attr " + a.name;
        if a.args.len() > 0 {
            s = s + "(" + a.args.join(",") + ")";
        }
        ast_line(d, depth, s + " @" + ast_dump_pos(a.pos));
    }
}

fn ast_dump_func(d: AstDumper, depth: Int, fd: AstFuncDecl) {
    let mut h = "fn " + fd.name;
    if fd.self_kind != "" {
        h = h + " recv=" + fd.self_kind.replace(" ", "_");
    }
    if !fd.has_body {
        h = h + " no-body";
    }
    ast_line(d, depth, h + " @" + ast_dump_pos(fd.pos));
    ast_dump_attrs(d, depth + 1, fd.attrs);
    ast_dump_generics(d, depth + 1, fd.generics);
    ast_dump_wheres(d, depth + 1, fd.wheres);
    for e in fd.preds {
        ast_line(d, depth + 1, "pred");
        ast_dump_expr(d, depth + 2, e);
    }
    for p in fd.params {
        ast_dump_param(d, depth + 1, p);
    }
    match fd.result {
        Some(t) => {
            ast_line(d, depth + 1, "result");
            ast_dump_type(d, depth + 2, t);
        }
        None => {}
    }
    ast_dump_block(d, depth + 1, fd.body);
}

fn ast_dump_wheres(d: AstDumper, depth: Int, ws: Vec<AstWhere>) {
    for w in ws {
        ast_line(d, depth, "where @" + ast_dump_pos(w.pos));
        ast_dump_type(d, depth + 1, w.ty);
        for b in w.bounds {
            ast_dump_type(d, depth + 2, b);
        }
    }
}

fn ast_dump_generics(d: AstDumper, depth: Int, gs: Vec<AstGeneric>) {
    for g in gs {
        ast_line(d, depth, "generic " + g.name + " @" + ast_dump_pos(g.pos));
        for b in g.bounds {
            ast_dump_type(d, depth + 1, b);
        }
    }
}

fn ast_dump_targs(d: AstDumper, depth: Int, what: String, ts: Vec<AstType>) {
    if ts.len() == 0 {
        return;
    }
    ast_line(d, depth, what);
    for t in ts {
        ast_dump_type(d, depth + 1, t);
    }
}

fn ast_dump_type(d: AstDumper, depth: Int, t: AstType) {
    match t {
        AstType::Named(n) => {
            ast_line(d, depth, "type " + n.name + " @" + ast_dump_pos(n.pos));
            for a in n.args {
                ast_dump_type(d, depth + 1, a);
            }
        }
        AstType::Ref(r) => {
            ast_line(d, depth, if r.mutable { "ref-mut @" } else { "ref @" } + ast_dump_pos(r.pos));
            ast_dump_type(d, depth + 1, r.elem);
        }
        AstType::Unit(u) => ast_line(d, depth, "unit-type @" + ast_dump_pos(u.pos)),
        AstType::Fn(ft) => {
            ast_line(d, depth, "fn-type " + ft.kind.replace(" ", "_") + " @" + ast_dump_pos(ft.pos));
            for a in ft.params {
                ast_dump_type(d, depth + 1, a);
            }
            match ft.result {
                Some(r) => {
                    ast_line(d, depth + 1, "result");
                    ast_dump_type(d, depth + 2, r);
                }
                None => {}
            }
        }
        AstType::Tuple(tt) => {
            ast_line(d, depth, "tuple-type @" + ast_dump_pos(tt.pos));
            for a in tt.elems {
                ast_dump_type(d, depth + 1, a);
            }
        }
    }
}

fn ast_dump_param(d: AstDumper, depth: Int, p: AstParam) {
    let m = if p.mutable { " mut" } else { "" };
    ast_line(d, depth, "param " + p.name + m + " @" + ast_dump_pos(p.pos));
    match p.ty {
        Some(t) => ast_dump_type(d, depth + 1, t),
        None => {}
    }
}

fn ast_dump_block(d: AstDumper, depth: Int, b: AstBlock) {
    ast_line(d, depth, "block @" + ast_dump_pos(b.pos) + " end=" + ast_dump_pos(b.end));
    for s in b.stmts {
        ast_dump_stmt(d, depth + 1, s);
    }
    match b.tail {
        Some(e) => {
            ast_line(d, depth + 1, "tail");
            ast_dump_expr(d, depth + 2, e);
        }
        None => {}
    }
}

fn ast_dump_stmt(d: AstDumper, depth: Int, s: AstStmt) {
    match s {
        AstStmt::Let(l) => {
            ast_line(
                d,
                depth,
                "let " + l.name + " mut=" + l.mutable.to_string() + " @" + ast_dump_pos(l.pos),
            );
            match l.pat {
                Some(pt) => ast_dump_pattern(d, depth + 1, pt),
                None => {}
            }
            match l.ty {
                Some(t) => ast_dump_type(d, depth + 1, t),
                None => {}
            }
            ast_dump_expr(d, depth + 1, l.init);
        }
        AstStmt::Assign(a) => {
            ast_line(d, depth, "assign " + a.name + " @" + ast_dump_pos(a.pos));
            ast_dump_expr(d, depth + 1, a.value);
        }
        AstStmt::FieldAssign(a) => {
            ast_line(d, depth, "field-assign @" + ast_dump_pos(a.pos));
            ast_dump_expr(d, depth + 1, AstExpr::Field(a.target));
            ast_dump_expr(d, depth + 1, a.value);
        }
        AstStmt::Break(b) => ast_line(d, depth, "break @" + ast_dump_pos(b.pos)),
        AstStmt::Continue(c) => ast_line(d, depth, "continue @" + ast_dump_pos(c.pos)),
        AstStmt::While(w) => {
            ast_line(d, depth, "while @" + ast_dump_pos(w.pos));
            match w.pat {
                Some(pt) => ast_dump_pattern(d, depth + 1, pt),
                None => {}
            }
            ast_dump_expr(d, depth + 1, w.cond);
            ast_dump_block(d, depth + 1, w.body);
        }
        AstStmt::For(f) => {
            ast_line(d, depth, "for " + f.var + " @" + ast_dump_pos(f.pos));
            match f.pat {
                Some(pt) => ast_dump_pattern(d, depth + 1, pt),
                None => {}
            }
            ast_dump_expr(d, depth + 1, f.iter);
            match f.end {
                Some(e) => {
                    ast_line(d, depth + 1, "to");
                    ast_dump_expr(d, depth + 2, e);
                }
                None => {}
            }
            ast_dump_block(d, depth + 1, f.body);
        }
        AstStmt::Return(r) => {
            ast_line(d, depth, "return @" + ast_dump_pos(r.pos));
            match r.value {
                Some(e) => ast_dump_expr(d, depth + 1, e),
                None => {}
            }
        }
        AstStmt::Expr(x) => {
            ast_line(d, depth, "expr-stmt semi=" + x.semi.to_string() + " @" + ast_dump_pos(x.pos));
            ast_dump_expr(d, depth + 1, x.x);
        }
    }
}

fn ast_dump_expr(d: AstDumper, depth: Int, e: AstExpr) {
    match e {
        AstExpr::IntLit(x) => ast_line(
            d,
            depth,
            "int " + x.value.to_string() + " @" + ast_dump_pos(x.pos),
        ),
        AstExpr::BoolLit(x) => ast_line(
            d,
            depth,
            "bool " + x.value.to_string() + " @" + ast_dump_pos(x.pos),
        ),
        AstExpr::StrLit(x) => ast_line(
            d,
            depth,
            "string " + ast_quote(x.value) + " @" + ast_dump_pos(x.pos),
        ),
        AstExpr::UnitLit(x) => ast_line(d, depth, "unit @" + ast_dump_pos(x.pos)),
        AstExpr::Ident(x) => {
            ast_line(d, depth, "ident " + x.name + " @" + ast_dump_pos(x.pos));
            ast_dump_targs(d, depth + 1, "targs", x.targs);
        }
        AstExpr::Binary(x) => {
            ast_line(d, depth, "binary " + x.op + " @" + ast_dump_pos(x.pos));
            ast_dump_expr(d, depth + 1, x.x);
            ast_dump_expr(d, depth + 1, x.y);
        }
        AstExpr::Unary(x) => {
            ast_line(d, depth, "unary " + x.op + " @" + ast_dump_pos(x.pos));
            ast_dump_expr(d, depth + 1, x.x);
        }
        AstExpr::Call(x) => {
            ast_line(d, depth, "call @" + ast_dump_pos(x.pos));
            ast_dump_expr(d, depth + 1, x.func);
            for a in x.args {
                ast_dump_expr(d, depth + 1, a);
            }
        }
        AstExpr::Method(x) => {
            ast_line(d, depth, "method " + x.name + " @" + ast_dump_pos(x.pos));
            ast_dump_targs(d, depth + 1, "targs", x.targs);
            ast_dump_expr(d, depth + 1, x.recv);
            for a in x.args {
                ast_dump_expr(d, depth + 1, a);
            }
        }
        AstExpr::Field(x) => {
            ast_line(d, depth, "field " + x.name + " @" + ast_dump_pos(x.pos));
            ast_dump_expr(d, depth + 1, x.x);
        }
        AstExpr::Path(x) => {
            ast_line(d, depth, "path " + x.ty + "::" + x.name + " @" + ast_dump_pos(x.pos));
            ast_dump_targs(d, depth + 1, "ty-args", x.ty_args);
            ast_dump_targs(d, depth + 1, "targs", x.targs);
        }
        AstExpr::StructLit(x) => {
            ast_line(d, depth, "struct-lit " + x.name + " @" + ast_dump_pos(x.pos));
            for f in x.fields {
                ast_line(d, depth + 1, "init " + f.name + " @" + ast_dump_pos(f.pos));
                ast_dump_expr(d, depth + 2, f.value);
            }
        }
        AstExpr::If(x) => {
            ast_line(d, depth, "if @" + ast_dump_pos(x.pos));
            match x.pat {
                Some(pt) => ast_dump_pattern(d, depth + 1, pt),
                None => {}
            }
            ast_dump_expr(d, depth + 1, x.cond);
            ast_dump_block(d, depth + 1, x.then);
            match x.els {
                Some(e) => {
                    ast_line(d, depth + 1, "else");
                    ast_dump_expr(d, depth + 2, e);
                }
                None => {}
            }
        }
        AstExpr::Match(x) => {
            ast_line(d, depth, "match @" + ast_dump_pos(x.pos));
            ast_dump_expr(d, depth + 1, x.x);
            for a in x.arms {
                ast_line(d, depth + 1, "arm @" + ast_dump_pos(a.pos));
                ast_dump_pattern(d, depth + 2, a.pat);
                match a.guard {
                    Some(g) => {
                        ast_line(d, depth + 2, "guard");
                        ast_dump_expr(d, depth + 3, g);
                    }
                    None => {}
                }
                ast_dump_expr(d, depth + 2, a.body);
            }
        }
        AstExpr::Block(b) => ast_dump_block(d, depth, b),
        AstExpr::Try(x) => {
            ast_line(d, depth, "try @" + ast_dump_pos(x.pos));
            ast_dump_expr(d, depth + 1, x.x);
        }
        AstExpr::Closure(x) => {
            ast_line(
                d,
                depth,
                if x.is_move {
                    "move-closure @"
                } else {
                    "closure @"
                } + ast_dump_pos(x.pos),
            );
            for p in x.params {
                ast_dump_param(d, depth + 1, p);
            }
            match x.result {
                Some(r) => {
                    ast_line(d, depth + 1, "result");
                    ast_dump_type(d, depth + 2, r);
                }
                None => {}
            }
            ast_dump_expr(d, depth + 1, x.body);
        }
        AstExpr::Range(x) => {
            ast_line(
                d,
                depth,
                if x.inclusive {
                    "range-incl @"
                } else {
                    "range @"
                } + ast_dump_pos(x.pos),
            );
            ast_dump_expr(d, depth + 1, x.start);
            ast_dump_expr(d, depth + 1, x.end);
        }
        AstExpr::Index(x) => {
            ast_line(d, depth, "index @" + ast_dump_pos(x.pos));
            ast_dump_expr(d, depth + 1, x.x);
            ast_dump_expr(d, depth + 1, x.index);
        }
        AstExpr::Tuple(x) => {
            ast_line(d, depth, "tuple @" + ast_dump_pos(x.pos));
            for a in x.elems {
                ast_dump_expr(d, depth + 1, a);
            }
        }
    }
}

fn ast_dump_pattern(d: AstDumper, depth: Int, p: AstPattern) {
    let at = " @" + ast_dump_pos(p.pos);
    if p.wildcard {
        ast_line(d, depth, "pat _" + at);
        return;
    }
    if p.alts.len() > 0 {
        ast_line(d, depth, "pat or" + at);
        for a in p.alts {
            ast_dump_pattern(d, depth + 1, a);
        }
        return;
    }
    if p.range {
        let mut r = "pat range ";
        match p.range_lo {
            Some(v) => {
                r = r + v.to_string();
            }
            None => {}
        }
        r = r + if p.range_incl { "..=" } else { ".." };
        match p.range_hi {
            Some(v) => {
                r = r + v.to_string();
            }
            None => {}
        }
        ast_line(d, depth, r + at);
        return;
    }
    match p.at.get(0) {
        Some(sub) => {
            let m = if p.mutable { " mut" } else { "" };
            ast_line(d, depth, "pat at bind=" + p.bind + m + at);
            ast_dump_pattern(d, depth + 1, sub);
            return;
        }
        None => {}
    }
    if p.tuple {
        ast_line(d, depth, "pat tuple" + at);
        for a in p.args {
            ast_dump_pattern(d, depth + 1, a);
        }
        return;
    }
    match p.int_value {
        Some(v) => {
            ast_line(d, depth, "pat int " + v.to_string() + at);
            return;
        }
        None => {}
    }
    match p.bool_lit {
        Some(b) => {
            ast_line(d, depth, "pat bool " + b.to_string() + at);
            return;
        }
        None => {}
    }
    match p.str_value {
        Some(s) => {
            ast_line(d, depth, "pat string " + ast_quote(s) + at);
            return;
        }
        None => {}
    }
    let m = if p.mutable { " mut" } else { "" };
    ast_line(d, depth, "pat type=" + p.ty + " ctor=" + p.ctor + " bind=" + p.bind + m + at);
    for a in p.args {
        ast_dump_pattern(d, depth + 1, a);
    }
}
