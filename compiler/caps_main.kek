// `caps [-json] <path>` (prefix caps_ / Caps*): the capabilities, and so
// the effects, of every function.

// CapsReport is the JSON form of one function's capability report.
struct CapsReport {
    name: String,
    signature: String,
    line: Int,
    col: Int,
    handler: Bool,
    pure: Bool,
    async: Bool,
    // every capability operation it can reach is idempotent (a pure
    // function trivially); `#[handler(idempotent)]` requires it
    idempotent: Bool,
    // it mutates none of its inputs (compiler/chk_mut.kek, mu_readonly)
    readonly: Bool,
    caps: Vec<ChkBinding>,
    direct_effects: Vec<String>,
    unused_caps: Vec<String>,
    calls: Vec<String>,
    // calls of mask / hash / expose_unchecked on labeled data
    declassify: Vec<ChkDeclass>,
    // a #[policy] function (it may grant permissions)
    policy: Bool,
    // the permissions it takes ("Edit(d)") and returns
    requires: Vec<String>,
    grants: Vec<String>,
}

// caps_func_signature renders `fn name(p: T, ...) -> R` (FuncSignature);
// shared and mutable references are shown as written (`&T`, `&mut T`,
// `self: &Point` for `&self`).
fn caps_func_signature(fun: ChkFunc) -> String {
    if ast_has_attr(fun.decl, "const") {
        // a constant (compiler/desugar.kek): always pure
        return ast_display_name("const " + fun.name + ": " + ty_str(fun.result));
    }
    let mut ps = Vec::new();
    let mut i = 0;
    for p in fun.params {
        let mut t = ty_str(p.ty);
        if !ty_is_cap(p.ty) {
            t = caps_ref_prefix(fun.decl, i) + t;
        }
        ps.push(p.name + ": " + t);
        i = i + 1;
    }
    let mut s = "fn " + fun.name + "(" + ps.join(", ") + ")";
    if !ty_is_prim(ty_prune(fun.result), "()") {
        let r = match fun.decl.result {
            Some(t) => caps_type_ref(t),
            None => "",
        };
        s = s + " -> " + r + ty_str(fun.result);
    }
    ast_display_name(s)
}

// caps_ref_prefix is `&` or `&mut ` when parameter i is declared a
// reference.
fn caps_ref_prefix(d: AstFuncDecl, i: Int) -> String {
    if i == 0 && d.self_kind != "" {
        if d.self_kind == "&self" {
            return "&";
        }
        if d.self_kind == "&mut self" {
            return "&mut ";
        }
        return "";
    }
    match d.params.get(i) {
        Some(p) => match p.ty {
            Some(t) => caps_type_ref(t),
            None => "",
        },
        None => "",
    }
}

fn caps_type_ref(t: AstType) -> String {
    match t {
        AstType::Ref(r) => if r.mutable { "&mut " } else { "&" },
        _ => "",
    }
}

fn caps_sorted_keys(m: HashMap<String, Bool>) -> Vec<String> {
    let out: Vec<String> = m.keys().collect();
    chk_sort_strings(out);
    out
}

// caps_readonly is mu_readonly of a well-typed program (nothing
// otherwise).
fn caps_readonly(a: DiagAnalysis) -> HashMap<String, Int> {
    if !a.parse_ok {
        return HashMap::new();
    }
    for d in a.diags {
        if d.severity == "error" && d.phase != "lint" {
            return HashMap::new();
        }
    }
    mu_readonly(a.info, a.file)
}

// caps_reports summarizes every function in declaration order (CapReports).
fn caps_reports(a: DiagAnalysis) -> Vec<CapsReport> {
    let mut out = Vec::new();
    let ro = caps_readonly(a);
    for fun in a.info.func_list {
        if chk_is_lib(fun) {
            continue;
        }
        let p = diag_name_after(a, fun.decl.pos, fun.decl.name);
        let caps = diag_caps(fun);
        let mut unused = Vec::new();
        for c in caps {
            if c.uses == 0 {
                unused.push(c.name);
            }
        }
        out.push(CapsReport {
            name: ast_display_name(fun.name),
            signature: caps_func_signature(fun),
            line: p.line,
            col: p.col,
            handler: fun.handler,
            pure: caps.len() == 0,
            async: fun.async,
            idempotent: chk_idem_violation(a.info, fun).is_none(),
            readonly: ro.get(fun.name).unwrap_or(0) > 0,
            caps: caps,
            direct_effects: caps_sorted_keys(fun.effects),
            unused_caps: unused,
            calls: caps_sorted_keys(fun.calls),
            declassify: fun.declass,
            policy: chk_is_policy(fun),
            requires: chk_requires(fun),
            grants: chk_grants(fun),
        });
    }
    out
}

fn caps_report_json(r: CapsReport) -> IrjVal {
    let o = irjson_obj();
    irjson_set(o, "name", IrjVal::Str(r.name));
    irjson_set(o, "signature", IrjVal::Str(r.signature));
    irjson_set(o, "line", irjson_int(r.line));
    irjson_set(o, "col", irjson_int(r.col));
    irjson_set(o, "handler", irjson_bool(r.handler));
    irjson_set(o, "pure", irjson_bool(r.pure));
    irjson_set(o, "async", irjson_bool(r.async));
    irjson_set(o, "idempotent", irjson_bool(r.idempotent));
    irjson_set(o, "readonly", irjson_bool(r.readonly));
    let mut cs = Vec::new();
    for c in r.caps {
        let co = irjson_obj();
        irjson_set(co, "name", IrjVal::Str(c.name));
        irjson_set(co, "type", IrjVal::Str(ty_str(c.ty)));
        irjson_set(co, "used", irjson_bool(c.uses > 0));
        cs.push(irjson_val(co));
    }
    irjson_set(o, "caps", IrjVal::Arr(cs));
    irjson_set(o, "direct_effects", irjson_strs(r.direct_effects));
    irjson_set(o, "unused_caps", irjson_strs(r.unused_caps));
    irjson_set(o, "calls", irjson_strs(r.calls));
    let mut ds = Vec::new();
    for d in r.declassify {
        let dobj = irjson_obj();
        irjson_set(dobj, "call", IrjVal::Str(d.call));
        irjson_set(dobj, "line", irjson_int(d.pos.line));
        irjson_set(dobj, "col", irjson_int(d.pos.col));
        ds.push(irjson_val(dobj));
    }
    irjson_set(o, "declassify", IrjVal::Arr(ds));
    irjson_set(o, "policy", irjson_bool(r.policy));
    irjson_set(o, "requires", irjson_strs(r.requires));
    irjson_set(o, "grants", irjson_strs(r.grants));
    irjson_val(o)
}

// caps_declassify_line lists the declassifications of labeled data
// (`    declassify: mask (12:9), expose_unchecked (20:5)`) and the
// permissions taken and granted (`    requires: Edit(d)`).
fn caps_declassify_line(mut lines: Vec<String>, fun: ChkFunc) {
    let req = chk_requires(fun);
    if req.len() > 0 {
        lines.push("    requires: " + req.join(", "));
    }
    let gr = chk_grants(fun);
    if gr.len() > 0 {
        lines.push("    grants: " + gr.join(", "));
    }
    if fun.declass.len() == 0 {
        return;
    }
    let mut ds = Vec::new();
    for d in fun.declass {
        ds.push(d.call + " (" + d.pos.line.to_string() + ":" + d.pos.col.to_string() + ")");
    }
    lines.push("    declassify: " + ds.join(", "));
}

fn caps_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    let fl = diag_parse_flags(args, 1, "caps");
    if fl.err != "" {
        return diag_flag_error(fl, "caps", log);
    }
    if fl.rest.len() != 1 {
        log.error("kek caps: expected exactly one .kek file");
        return 1;
    }
    let path = fl.rest.get(0).unwrap_or("");
    let res = match frontend_load(path, fs, log) {
        Some(r) => r,
        None => {
            return 1;
        }
    };
    if diag_flag_bool(fl, "json") {
        let src = match diag_read_file(path, fs, log) {
            Some(s) => s,
            None => {
                return 1;
            }
        };
        let a = diag_analyze(src);
        let mut fns = Vec::new();
        for r in caps_reports(a) {
            fns.push(caps_report_json(r));
        }
        let o = irjson_obj();
        irjson_set(o, "file", IrjVal::Str(path));
        irjson_set(o, "functions", IrjVal::Arr(fns));
        log.info(irjson_encode(irjson_val(o), false));
        return 0;
    }
    let mut lines = Vec::new();
    for fun in res.info.func_list {
        if chk_is_lib(fun) {
            continue;
        }
        let mut caps = Vec::new();
        let mut unused = Vec::new();
        for c in diag_caps(fun) {
            caps.push(c.name + ": " + ty_str(c.ty));
            if c.uses == 0 {
                unused.push(c.name);
            }
        }
        let mut tag = "";
        if fun.handler {
            tag = " #[handler]";
            if chk_idempotent_attr(fun) {
                tag = " #[handler(idempotent)]";
            }
        }
        if fun.test {
            tag = " #[test]";
        }
        if chk_is_policy(fun) {
            tag = tag + " #[policy]";
        }
        if caps.len() == 0 {
            lines.push(fun.name + tag + ": pure");
            caps_declassify_line(lines, fun);
            continue;
        }
        let ops = caps_sorted_keys(fun.effects);
        lines.push(fun.name + tag + ": " + caps.join(", "));
        if ops.len() > 0 {
            lines.push("    direct effects: " + ops.join(", "));
        }
        match chk_idem_violation(res.info, fun) {
            None => lines.push("    idempotent: true"),
            Some(v) => {
                let mut via = "";
                if v.path.len() > 1 {
                    via = " via " + v.path.get(1).unwrap_or("");
                }
                lines.push("    idempotent: false (" + v.op + via + ")");
            }
        }
        caps_declassify_line(lines, fun);
        if unused.len() > 0 {
            lines.push("    warning: granted but unused: " + unused.join(", "));
        }
    }
    let mut shown = Vec::new();
    for l in lines {
        shown.push(ast_display_name(l));
    }
    frontend_print(log, shown);
    0
}
