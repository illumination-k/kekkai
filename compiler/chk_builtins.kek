// Builtin methods and static functions.

struct ChkBuiltin {
    recv: String,
    name: String,
    params: Vec<Ty>,
    result: Ty,
    async: Bool,
    consumes: Bool,
    op: String,
}

struct ChkBuiltins {
    methods: HashMap<String, ChkBuiltin>,
    statics: HashMap<String, ChkBuiltin>,
    // every builtin, in definition order
    all: Vec<ChkBuiltin>,
}

fn chk_lower_first(s: String) -> String {
    if s == "" {
        return s;
    }
    s.slice(0, 1).to_lower() + s.slice(1, s.len())
}

fn chk_def(
    mut bs: ChkBuiltins,
    recv: String,
    name: String,
    params: Vec<Ty>,
    result: Ty,
    async: Bool,
    consumes: Bool,
    is_static: Bool,
) {
    let b = ChkBuiltin {
        recv: recv,
        name: name,
        params: params,
        result: result,
        async: async,
        consumes: consumes,
        op: chk_lower_first(recv) + "." + name,
    };
    if is_static {
        bs.statics.insert(recv + "::" + name, b);
    } else {
        bs.methods.insert(recv + "." + name, b);
    }
    bs.all.push(b);
}

fn chk_m(bs: ChkBuiltins, recv: String, name: String, params: Vec<Ty>, result: Ty) {
    chk_def(bs, recv, name, params, result, false, false, false);
}

fn chk_ma(bs: ChkBuiltins, recv: String, name: String, params: Vec<Ty>, result: Ty) {
    chk_def(bs, recv, name, params, result, true, false, false);
}

fn chk_s(bs: ChkBuiltins, recv: String, name: String, params: Vec<Ty>, result: Ty) {
    chk_def(bs, recv, name, params, result, false, false, true);
}

fn chk_tys0() -> Vec<Ty> {
    Vec::new()
}

fn chk_tys1(a: Ty) -> Vec<Ty> {
    let mut v = Vec::new();
    v.push(a);
    v
}

fn chk_tys2(a: Ty, b: Ty) -> Vec<Ty> {
    let mut v = Vec::new();
    v.push(a);
    v.push(b);
    v
}

fn chk_res(ok: Ty, err: Ty) -> Ty {
    Ty::Result(ok, err)
}

fn chk_new_builtins() -> ChkBuiltins {
    let bs = ChkBuiltins { methods: HashMap::new(), statics: HashMap::new(), all: Vec::new() };
    let s = ty_string();
    let i = ty_int();
    let u = ty_unit();
    let b = ty_bool();
    let tx_err = Ty::Opaque("TxError");
    let net_err = Ty::Opaque("NetError");
    let io_err = Ty::Opaque("IoError");
    let resp = Ty::Opaque("Response");

    // ---- capabilities ----
    chk_m(bs, "Log", "info", chk_tys1(s), u);
    chk_m(bs, "Log", "warn", chk_tys1(s), u);
    chk_m(bs, "Log", "error", chk_tys1(s), u);

    chk_m(bs, "Clock", "now_ms", chk_tys0(), i);
    chk_m(bs, "Random", "int", chk_tys2(i, i), i);

    chk_ma(bs, "Net", "get", chk_tys1(s), chk_res(s, net_err));
    chk_ma(bs, "Net", "post", chk_tys2(s, s), chk_res(s, net_err));

    chk_ma(bs, "Db", "get", chk_tys1(s), chk_res(Ty::Option(s), tx_err));

    chk_ma(bs, "Tx", "get", chk_tys1(s), chk_res(Ty::Option(s), tx_err));
    chk_ma(bs, "Tx", "put", chk_tys2(s, s), chk_res(u, tx_err));
    chk_ma(bs, "Tx", "delete", chk_tys1(s), chk_res(u, tx_err));
    chk_m(bs, "Tx", "outbox", chk_tys2(s, s), u);
    chk_def(bs, "Tx", "commit", chk_tys0(), chk_res(u, tx_err), true, true, false);
    chk_def(bs, "Tx", "rollback", chk_tys0(), u, false, true, false);

    chk_ma(bs, "Fs", "read", chk_tys1(s), chk_res(s, io_err));
    chk_ma(bs, "Fs", "write", chk_tys2(s, s), chk_res(u, io_err));
    chk_ma(bs, "Fs", "list", chk_tys1(s), chk_res(Ty::Vec(s), io_err));
    chk_ma(bs, "Fs", "write_bytes", chk_tys2(s, Ty::Vec(i)), chk_res(u, io_err));
    // a line of standard input (None at its end), and the directory that
    // relative paths are resolved against (for a long-running program)
    chk_ma(bs, "Fs", "read_line", chk_tys0(), Ty::Option(s));
    // n bytes of standard input (None at its end), and text written to
    // standard output without a newline (framed protocols: `kek lsp`)
    chk_ma(bs, "Fs", "read_stdin", chk_tys1(i), Ty::Option(s));
    chk_ma(bs, "Fs", "write_stdout", chk_tys1(s), u);
    chk_ma(bs, "Fs", "set_cwd", chk_tys1(s), u);

    // ---- pure data ----
    chk_m(bs, "Int", "to_string", chk_tys0(), s);
    chk_m(bs, "Int", "abs", chk_tys0(), i);
    let int_ops = "bit_and bit_or bit_xor shl shr ushr min max".split(" ");
    for op in int_ops {
        chk_m(bs, "Int", op, chk_tys1(i), i);
    }
    chk_m(bs, "Bool", "to_string", chk_tys0(), s);

    chk_m(bs, "String", "len", chk_tys0(), i);
    chk_m(bs, "String", "parse_int", chk_tys0(), Ty::Option(i));
    chk_m(bs, "String", "contains", chk_tys1(s), b);
    chk_m(bs, "String", "starts_with", chk_tys1(s), b);
    chk_m(bs, "String", "ends_with", chk_tys1(s), b);
    chk_m(bs, "String", "trim", chk_tys0(), s);
    chk_m(bs, "String", "to_upper", chk_tys0(), s);
    chk_m(bs, "String", "to_lower", chk_tys0(), s);
    chk_m(bs, "String", "char_at", chk_tys1(i), Ty::Option(i));
    chk_m(bs, "String", "slice", chk_tys2(i, i), s);
    chk_m(bs, "String", "index_of", chk_tys1(s), Ty::Option(i));
    chk_m(bs, "String", "replace", chk_tys2(s, s), s);
    chk_m(bs, "String", "split", chk_tys1(s), Ty::Vec(s));
    chk_m(bs, "String", "to_bytes", chk_tys0(), Ty::Vec(i));
    // the core library's string hashing (DefaultHasher::write_str): FNV-1a
    // steps over the UTF-16 code units from state, then a -1 terminator
    chk_m(bs, "String", "__hash", chk_tys1(i), i);
    chk_s(bs, "String", "from_char", chk_tys1(i), s);
    chk_s(bs, "String", "from_bytes", chk_tys1(Ty::Vec(i)), s);
    chk_m(bs, "IoError", "message", chk_tys0(), s);

    chk_m(bs, "Request", "method", chk_tys0(), s);
    chk_m(bs, "Request", "path", chk_tys0(), s);
    chk_m(bs, "Request", "segment", chk_tys1(i), Ty::Option(s));
    chk_m(bs, "Request", "query", chk_tys1(s), Ty::Option(s));
    chk_m(bs, "Request", "header", chk_tys1(s), Ty::Option(s));
    chk_m(bs, "Request", "body", chk_tys0(), s);

    chk_m(bs, "Response", "with_header", chk_tys2(s, s), resp);

    chk_m(bs, "TxError", "message", chk_tys0(), s);
    chk_m(bs, "TxError", "retryable", chk_tys0(), b);
    chk_m(bs, "NetError", "message", chk_tys0(), s);

    chk_s(bs, "Response", "text", chk_tys2(i, s), resp);
    chk_s(bs, "Response", "json", chk_tys2(i, s), resp);
    chk_s(bs, "Response", "empty", chk_tys1(i), resp);
    chk_s(bs, "Response", "no_content", chk_tys0(), resp);
    chk_s(bs, "Response", "not_found", chk_tys0(), resp);
    chk_s(bs, "Response", "bad_request", chk_tys1(s), resp);
    bs
}

// ---- prelude intrinsics ----
//
// Only programs checked together with the runtime prelude see these (the
// lexer rejects `__` identifiers outside the prelude). Each lowers to a
// host operation that the code generator emits inline.

fn chk_tys3(a: Ty, b: Ty, c: Ty) -> Vec<Ty> {
    let mut v = chk_tys2(a, b);
    v.push(c);
    v
}

fn chk_ints(n: Int) -> Vec<Ty> {
    let mut v = Vec::new();
    for k in 0..n {
        v.push(ty_int());
    }
    v
}

// chk_wasi_funcs lists the WASI preview 1 functions available to the
// prelude as `__Wasi::name(...)`: name and arity (every parameter and the
// result are Int).
fn chk_wasi_funcs() -> Vec<String> {
    "args_get:2 args_sizes_get:2 environ_get:2 environ_sizes_get:2 clock_time_get:3 fd_close:1 fd_filestat_get:2 fd_prestat_get:2 fd_prestat_dir_name:3 fd_read:4 fd_readdir:5 fd_write:4 path_open:9 path_create_directory:3 random_get:2 proc_exit:1".split(
        " ",
    )
}

fn chk_add_intrinsics(c: Chk) {
    let bs = c.builtins;
    let i = ty_int();
    let u = ty_unit();
    let b = ty_bool();
    let s = ty_string();
    let any = Ty::Opaque("__Any");
    let chars = Ty::Opaque("__Chars");

    chk_s(bs, "__Chars", "new", chk_tys1(i), chars);
    chk_s(bs, "__Chars", "of", chk_tys1(s), chars);
    chk_m(bs, "__Chars", "len", chk_tys0(), i);
    chk_m(bs, "__Chars", "get", chk_tys1(i), i);
    chk_m(bs, "__Chars", "set", chk_tys2(i, i), u);
    let mut cp = chk_tys2(i, chars);
    cp.push(i);
    cp.push(i);
    chk_m(bs, "__Chars", "copy", cp, u);
    chk_m(bs, "__Chars", "freeze", chk_tys0(), s);

    chk_s(bs, "__Int", "rem_u", chk_tys2(i, i), i);
    chk_s(bs, "__Int", "div_u", chk_tys2(i, i), i);
    chk_s(bs, "__Int", "lt_u", chk_tys2(i, i), b);

    chk_s(bs, "__Any", "null", chk_tys0(), any);
    chk_s(bs, "__Any", "is_null", chk_tys1(any), b);

    for w in "8 16 32 64".split(" ") {
        chk_s(bs, "__Mem", "load" + w, chk_tys1(i), i);
        chk_s(bs, "__Mem", "store" + w, chk_tys2(i, i), u);
    }
    chk_s(bs, "__Mem", "size", chk_tys0(), i);
    chk_s(bs, "__Mem", "grow", chk_tys1(i), i);

    chk_s(bs, "__Js", "str_len", chk_tys1(any), i);
    chk_s(bs, "__Js", "str_to_mem", chk_tys2(any, i), u);
    chk_s(bs, "__Js", "str_from_mem", chk_tys2(i, i), any);
    chk_s(bs, "__Js", "err_message", chk_tys1(any), any);
    chk_s(bs, "__Js", "err_retryable", chk_tys1(any), b);

    for w in chk_wasi_funcs() {
        let parts = w.split(":");
        let name = parts.get(0).unwrap_or("");
        let n = parts.get(1).unwrap_or("0").parse_int().unwrap_or(0);
        chk_s(bs, "__Wasi", name, chk_ints(n), i);
    }

    // conversions between `__Any` and the prelude's own types
    for st in c.info.structs.keys() {
        if st.starts_with("__") || chk_prelude_type(st) {
            match c.info.structs.get(st) {
                Some(t) => {
                    chk_s(bs, st, "from_any", chk_tys1(any), Ty::Struct(t, Vec::new()));
                    chk_s(bs, st, "to_any", chk_tys1(Ty::Struct(t, Vec::new())), any);
                }
                None => {}
            }
        }
    }
    // the runtime state: one instance per program, created on first use
    // by the prelude function `__rt_new`
    match c.info.structs.get("__Rt") {
        Some(t) => chk_s(bs, "__Rt", "get", chk_tys0(), Ty::Struct(t, Vec::new())),
        None => {}
    }
}
