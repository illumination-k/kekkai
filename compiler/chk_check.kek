// Type checker. Results are recorded
// in ChkInfo maps keyed by AST node id.

struct ChkBinding {
    id: Int,
    name: String,
    ty: Ty,
    mut mutable: Bool,
    pos: AstPos,
    mut param: Bool,
    mut uses: Int,
}

struct ChkFunc {
    name: String,
    decl: AstFuncDecl,
    // generic params (an impl's first, then the function's own) and the
    // type names in scope in the signature and body (params and `Self`)
    tparams: Vec<TyParam>,
    tscope: HashMap<String, Ty>,
    // the trait declaring this method signature ("" otherwise)
    mut trait_name: String,
    // `where` bounds on types other than its params (e.g. `Self::Item: Ord`)
    mut wheres: Vec<ChkWhere>,
    params: Vec<ChkBinding>,
    mut result: Ty,
    handler: Bool,
    main: Bool,
    test: Bool,
    mut async: Bool,
    // user functions called from the body (keys; values unused)
    calls: HashMap<String, Bool>,
    // capability operations used directly in the body
    effects: HashMap<String, Bool>,
    // where each of effects is first used
    effect_pos: HashMap<String, AstPos>,
    // declassifications of personal data (Pii) in the body
    declass: Vec<ChkDeclass>,
}

// ChkDeclass is a call of a declassifying method of Pii (call: "mask",
// "hash" or "expose_unchecked").
struct ChkDeclass {
    call: String,
    pos: AstPos,
}

// kind: "func", "ok", "err", "some", "none", "variant", "static", "collection"
// targs are the type arguments of a generic function (kind "func"), one
// per func.tparams.
struct ChkCallInfo {
    mut kind: String,
    mut func: Option<ChkFunc>,
    mut enm: Option<TyEnum>,
    mut tag: Int,
    mut builtin: Option<ChkBuiltin>,
    mut op: String,
    mut ty: Ty,
    mut targs: Vec<Ty>,
}

struct ChkClosureInfo {
    tx: ChkBinding,
    result: Ty,
}

// kind: "builtin", "transaction", "generic", "func" (a method defined in
// an `impl`: func with type arguments targs)
struct ChkMethodInfo {
    kind: String,
    builtin: Option<ChkBuiltin>,
    mut op: String,
    mut recv_ty: Ty,
    closure: Option<ChkClosureInfo>,
    func: Option<ChkFunc>,
    targs: Vec<Ty>,
}

struct ChkTryInfo {
    closure: Option<ChkClosureInfo>,
    target: Ty,
}

struct ChkReturnInfo {
    closure: Option<ChkClosureInfo>,
}

// ChkForIter is a `for` loop over an iterator: `next` is the call of
// Iterator::next, after IntoIterator::into_iter (`into`) when the value is
// not an iterator itself.
struct ChkForIter {
    into: Option<ChkMethodInfo>,
    next: ChkMethodInfo,
}

// kind: "wild", "bind", "int", "bool", "string", "ctor"
struct ChkPatInfo {
    mut kind: String,
    mut ty: Ty,
    mut tag: Int,
    mut bind: Option<ChkBinding>,
    mut args: Vec<AstPattern>,
}

struct ChkInfo {
    funcs: HashMap<String, ChkFunc>,
    func_list: Vec<ChkFunc>,
    structs: HashMap<String, TyStruct>,
    enums: HashMap<String, TyEnum>,
    mut handler: Option<ChkFunc>,
    types: HashMap<Int, Ty>,
    uses: HashMap<Int, ChkBinding>,
    lets: HashMap<Int, ChkBinding>,
    assigns: HashMap<Int, ChkBinding>,
    fors: HashMap<Int, ChkBinding>,
    calls: HashMap<Int, ChkCallInfo>,
    methods: HashMap<Int, ChkMethodInfo>,
    fields: HashMap<Int, Int>,
    struct_lits: HashMap<Int, TyStruct>,
    tries: HashMap<Int, ChkTryInfo>,
    returns: HashMap<Int, ChkReturnInfo>,
    patterns: HashMap<Int, ChkPatInfo>,
    closures: HashMap<Int, ChkClosureInfo>,
    lambdas: HashMap<Int, ChkLambdaInfo>,
    // `for` loops over iterators (by statement id)
    for_iters: HashMap<Int, ChkForIter>,
    // the `where` bounds of the function being checked
    mut wheres: Vec<ChkWhere>,
    traits: HashMap<String, ChkTrait>,
    // trait name -> implementations
    impls: HashMap<String, Vec<ChkImpl>>,
    // binary operators resolved to a trait method (`==` on a struct)
    binops: HashMap<Int, ChkMethodInfo>,
    // structs and enums of the core library and the runtime prelude
    lib_types: HashMap<String, Bool>,
    // `type` aliases (transparent; refined ones carry a predicate) and
    // the aliases being resolved (to report cycles)
    aliases: HashMap<String, AstTypeAlias>,
    alias_busy: HashMap<String, Bool>,
    // functions whose bodies use refinements (`v[i]`, a refined alias, a
    // struct with refined fields) and those structs: the refinement pass
    // skips the other functions quickly
    refine_fns: HashMap<String, Bool>,
    alias_structs: HashMap<String, Bool>,
    // functions whose signature mentions a parameter as the resource of a
    // permission (`Can<Edit, d>`): calls substitute the arguments' paths
    path_fns: HashMap<String, Bool>,
}

// A closure's body is a scope with lambda set to the closure's id: a
// variable found beyond it is captured.
struct ChkScope {
    vars: HashMap<String, ChkBinding>,
    tx_boundary: Bool,
    mut lambda: Int,
}

// ChkLambdaInfo describes a closure expression: its parameters, the
// variables it captures (by value, in order of first use) and its type
// Ty::Fn.
struct ChkLambdaInfo {
    id: Int,
    params: Vec<ChkBinding>,
    captures: Vec<ChkBinding>,
    mut ty: Ty,
}

struct ChkRet {
    ty: Ty,
    closure: Option<ChkClosureInfo>,
}

struct Chk {
    // trait method -> the program's implementations, built on first use
    // (after the declarations)
    mut impl_idx: Option<HashMap<String, Vec<ChkFunc>>>,
    mut loops: Int,
    info: ChkInfo,
    errs: Vec<AstError>,
    mut next_id: Int,
    mut scopes: Vec<ChkScope>,
    mut rets: Vec<ChkRet>,
    mut cur: ChkFunc,
    // type names in scope (generic params, `Self`)
    mut tscope: HashMap<String, Ty>,
    // `_` may stand for a type (inside function bodies)
    mut infer_ok: Bool,
    // the parameters that a permission `Can<A, d>` in the signature being
    // declared can name, with their paths (docs/authz-flow.md)
    mut paths: HashMap<String, Ty>,
    // trait obligations of the function being checked
    mut obls: Vec<ChkObl>,
    // set by chk_lookup: the variable found is captured by a closure
    mut captured: Bool,
    builtins: ChkBuiltins,
    // prelude mode: the program includes the runtime prelude, which may
    // define Response / TxError / NetError / IoError as structs and use
    // the `__` intrinsics
    prelude: Bool,
}

struct ChkResult {
    info: ChkInfo,
    errs: Vec<AstError>,
    // the mutability pass (compiler/chk_mut.kek): its diagnostics (in
    // errs too when the rules are enforced) with their fixes
    mu: MuReport,
    // the refinement pass (compiler/refine.kek): its diagnostics (errors
    // are also in errs) and per-function summaries
    refine: RefReport,
}

fn chk_dummy_pos() -> AstPos {
    AstPos { file: "", line: 0, col: 0 }
}

fn chk_dummy_func() -> ChkFunc {
    let p = chk_dummy_pos();
    ChkFunc {
        name: "",
        tparams: Vec::new(),
        tscope: HashMap::new(),
        trait_name: "",
        wheres: Vec::new(),
        params: Vec::new(),
        result: ty_unit(),
        handler: false,
        main: false,
        test: false,
        async: false,
        calls: HashMap::new(),
        effects: HashMap::new(),
        effect_pos: HashMap::new(),
        declass: Vec::new(),
        decl: AstFuncDecl {
            id: 0,
            pos: p,
            attrs: Vec::new(),
            name: "",
            generics: Vec::new(),
            self_kind: "",
            params: Vec::new(),
            result: None,
            wheres: Vec::new(),
            preds: Vec::new(),
            has_body: true,
            body: AstBlock { id: 0, pos: p, stmts: Vec::new(), tail: None, end: p },
        },
    }
}

// chk_check type-checks a parsed program.
fn chk_check(f: AstFile) -> ChkResult {
    chk_check_mode(f, false, chk_parse_core())
}

// chk_check_c and chk_check_prelude_c check with a core library parsed
// before (a long-running compiler parses it once: compiler/serve.kek).
fn chk_check_c(f: AstFile, core: ChkCore) -> ChkResult {
    chk_check_mode(f, false, core)
}

fn chk_check_prelude_c(f: AstFile, core: ChkCore) -> ChkResult {
    chk_check_mode(f, true, core)
}

// chk_check_prelude type-checks a program together with the runtime
// prelude (see lib/prelude).
fn chk_check_prelude(f: AstFile) -> ChkResult {
    chk_check_mode(f, true, chk_parse_core())
}

// ChkCore is the parsed core library; next is the first node id after it
// (the ids of derived implementations follow).
struct ChkCore {
    file: AstFile,
    errs: Vec<AstError>,
    next: Int,
}

fn chk_parse_core() -> ChkCore {
    chk_parse_core_from(core_sources())
}

// chk_parse_core_from parses a core library from its sources (`kek fix`
// of lib/core checks the files being fixed).
fn chk_parse_core_from(mut srcs: Vec<FeSource>) -> ChkCore {
    let out = AstFile {
        structs: Vec::new(),
        enums: Vec::new(),
        funcs: Vec::new(),
        impls: Vec::new(),
        traits: Vec::new(),
        aliases: Vec::new(),
    };
    let mut errs = Vec::new();
    let ids = AstIds { next: 1099511627776 };
    srcs.push(FeSource { name: "<core>/tuple.kek", text: derive_tuples() });
    for s in srcs {
        let pr = parse_file(s.name, s.text, ids);
        for e in pr.errs {
            errs.push(e);
        }
        chk_append_file(out, pr.file);
    }
    ChkCore { file: out, errs: errs, next: ids.next }
}

// chk_with_core returns the program f together with the core library
// (lib/core), which every program includes. Core items come first so
// that a clash is reported at the user's definition; core nodes get ids
// from a separate range.
fn chk_with_core(f: AstFile, mut errs: Vec<AstError>, core: ChkCore) -> AstFile {
    let out = AstFile {
        structs: Vec::new(),
        enums: Vec::new(),
        funcs: Vec::new(),
        impls: Vec::new(),
        traits: Vec::new(),
        aliases: Vec::new(),
    };
    for e in core.errs {
        errs.push(e);
    }
    chk_append_file(out, core.file);
    chk_append_file(out, f);
    derive_items(out, AstIds { next: core.next }, errs);
    out
}

fn chk_append_file(mut out: AstFile, f: AstFile) {
    for x in f.structs {
        out.structs.push(x);
    }
    for x in f.enums {
        out.enums.push(x);
    }
    for x in f.funcs {
        out.funcs.push(x);
    }
    for x in f.impls {
        out.impls.push(x);
    }
    for x in f.traits {
        out.traits.push(x);
    }
    for x in f.aliases {
        out.aliases.push(x);
    }
}

// chk_is_core reports whether a position is in the core library.
fn chk_is_core(p: AstPos) -> Bool {
    p.file.starts_with("<core>/")
}

// chk_is_lib reports whether a function belongs to the core library or the
// runtime prelude (not to the user's program).
// chk_check_attr validates a function attribute: #[handler] /
// #[handler(idempotent)], #[main], #[declassify(reason = "...", owner =
// "...", expires = "YYYY-MM-DD")] (who approved the Pii declassifications
// of the function; see `kek assure`),
// #[test] / #[test(cases = N)], #[rare] (a path that is rarely taken; see
// `kek assure`) and #[allow(similar, reason = "...", owner = "...",
// expires = "YYYY-MM-DD")].
fn chk_check_attr(c: Chk, a: AstAttr) {
    if a.name == "handler" {
        for x in a.args {
            if x != "idempotent" {
                chk_errorf(
                    c,
                    a.pos,
                    "unknown argument `" + x + "` of `#[handler]` (expected `idempotent`)",
                );
            }
        }
        return;
    }
    if a.name == "declassify" || a.name == "policy" {
        for x in a.args {
            if !x.starts_with("reason = \"")
                && !x.starts_with("owner = \"")
                && !x.starts_with("expires = \"") {
                chk_errorf(
                    c,
                    a.pos,
                    "unknown argument `"
                        + x
                        + "` of `#["
                        + a.name
                        + "]` (expected reason, owner, expires)",
                );
            }
        }
        return;
    }
    if a.name == "fresh" || a.name == "owned" {
        // a core function whose result is a new container (shared
        // contents, not shared) when it is given shared values (`fresh`),
        // or an owned value built from what it reads (`owned`)
        if !chk_is_lib_pos(a.pos) {
            chk_errorf(
                c,
                a.pos,
                "`#[" + a.name + "]` is only allowed in the core library and the prelude",
            );
        }
        if a.args.len() > 0 {
            chk_errorf(c, a.pos, "`#[" + a.name + "]` takes no arguments");
        }
        return;
    }
    if a.name == "main" || a.name == "rare" {
        if a.args.len() > 0 {
            chk_errorf(c, a.pos, "`#[" + a.name + "]` takes no arguments");
        }
        return;
    }
    if a.name == "test" {
        for x in a.args {
            if !x.starts_with("cases = ") || x.slice(8, x.len()).parse_int().is_none() {
                chk_errorf(
                    c,
                    a.pos,
                    "unknown argument `" + x + "` of `#[test]` (expected `cases = N`)",
                );
            }
        }
        return;
    }
    if a.name == "allow" {
        if !ast_attr_has(a, "similar") && !ast_attr_has(a, "complexity") {
            chk_errorf(c, a.pos, "`#[allow]` supports only `similar` and `complexity`");
            return;
        }
        for x in a.args {
            if x != "similar"
                && x != "complexity"
                && !x.starts_with("reason = \"")
                && !x.starts_with("owner = \"")
                && !x.starts_with("expires = \"") {
                chk_errorf(
                    c,
                    a.pos,
                    "unknown argument `" + x + "` of `#[allow]` (expected reason, owner, expires)",
                );
            }
        }
        return;
    }
    chk_errorf(c, a.pos, "unknown attribute `#[" + a.name + "]`");
}

fn chk_is_lib(fun: ChkFunc) -> Bool {
    chk_is_lib_pos(fun.decl.pos)
}

fn chk_is_lib_pos(p: AstPos) -> Bool {
    p.file.starts_with("<core>/") || p.file.starts_with("<prelude>/")
}

fn chk_check_mode(user: AstFile, prelude: Bool, core: ChkCore) -> ChkResult {
    chk_check_cfg(user, prelude, core, ref_config_default())
}

// chk_check_cfg type-checks a program, then runs the refinement pass with
// the `[refine]` configuration cfg (when there are no type errors).
fn chk_check_cfg(user: AstFile, prelude: Bool, core: ChkCore, cfg: RefConfig) -> ChkResult {
    chk_check_full(user, prelude, core, cfg, mu_enforce())
}

// chk_check_full is chk_check_cfg; with mu set, it runs the mutability
// pass even when its rules are not enforced (`kek fix`).
fn chk_check_full(
    user: AstFile,
    prelude: Bool,
    core: ChkCore,
    cfg: RefConfig,
    mu: Bool,
) -> ChkResult {
    let info = ChkInfo {
        funcs: HashMap::new(),
        func_list: Vec::new(),
        structs: HashMap::new(),
        enums: HashMap::new(),
        handler: None,
        types: HashMap::new(),
        uses: HashMap::new(),
        lets: HashMap::new(),
        assigns: HashMap::new(),
        fors: HashMap::new(),
        calls: HashMap::new(),
        methods: HashMap::new(),
        fields: HashMap::new(),
        struct_lits: HashMap::new(),
        tries: HashMap::new(),
        returns: HashMap::new(),
        patterns: HashMap::new(),
        closures: HashMap::new(),
        lambdas: HashMap::new(),
        for_iters: HashMap::new(),
        wheres: Vec::new(),
        traits: HashMap::new(),
        impls: HashMap::new(),
        binops: HashMap::new(),
        lib_types: HashMap::new(),
        aliases: HashMap::new(),
        alias_busy: HashMap::new(),
        refine_fns: HashMap::new(),
        alias_structs: HashMap::new(),
        path_fns: HashMap::new(),
    };
    let core_errs = Vec::new();
    let f = chk_with_core(user, core_errs, core);
    let mut c = Chk {
        impl_idx: None,
        loops: 0,
        info: info,
        errs: core_errs,
        next_id: 0,
        scopes: Vec::new(),
        rets: Vec::new(),
        cur: chk_dummy_func(),
        tscope: HashMap::new(),
        infer_ok: false,
        paths: HashMap::new(),
        obls: Vec::new(),
        captured: false,
        builtins: chk_new_builtins(),
        prelude: prelude,
    };
    chk_declare(c, f);
    if prelude {
        chk_add_intrinsics(c);
    }
    for fun in c.info.func_list {
        if fun.decl.has_body {
            chk_func(c, fun);
        }
    }
    chk_compute_async(c);
    chk_check_idempotent(c);
    for fun in c.info.func_list {
        lin_check(c.info, fun, c.errs);
    }
    // the mutability and refinement passes need a well-typed program
    let typed = c.errs.len() == 0;
    let mut mr = mu_empty_report();
    if typed && mu {
        mr = mu_program(c.info, f);
        if mu_enforce() {
            for d in mr.diags {
                c.errs.push(AstError { pos: d.pos, msg: d.msg });
            }
        }
        for e in mr.flow {
            c.errs.push(e);
        }
    }
    let mut rr = ref_report_empty();
    if typed && !cfg.off {
        rr = ref_program(c.info, cfg, f);
        for d in rr.diags {
            if d.severity == "error" {
                c.errs.push(AstError { pos: d.pos, msg: d.msg });
            }
        }
    }
    ChkResult { info: c.info, errs: ast_sort_errors(c.errs), mu: mr, refine: rr }
}

fn chk_errorf(mut c: Chk, pos: AstPos, msg: String) {
    c.errs.push(AstError { pos: pos, msg: msg });
}

fn chk_new_var(mut c: Chk) -> Ty {
    c.next_id = c.next_id + 1;
    Ty::Var(TyVar { id: c.next_id, r: None })
}

fn chk_new_binding(mut c: Chk, name: String, t: Ty, pos: AstPos) -> ChkBinding {
    c.next_id = c.next_id + 1;
    ChkBinding { id: c.next_id, name: name, ty: t, mutable: false, pos: pos, param: false, uses: 0 }
}

// ---- declarations ----

fn chk_reserved(n: String) -> Bool {
    n == "Int"
        || n == "Bool"
        || n == "String"
        || n == "Result"
        || n == "Option"
        || n == "Request"
        || n == "Response"
        || n == "TxError"
        || n == "NetError"
        || n == "IoError"
        || n == "Vec"
        || n == "Log"
        || n == "Net"
        || n == "Db"
        || n == "Fs"
        || n == "Clock"
        || n == "Random"
        || n == "Tx"
        || n == "Ok"
        || n == "Err"
        || n == "Some"
        || n == "None"
        || n == "Self"
}

// chk_prelude_type reports the builtin types that the prelude defines as
// structs.
fn chk_prelude_type(n: String) -> Bool {
    n == "Response" || n == "TxError" || n == "NetError" || n == "IoError"
}

fn chk_declare(mut c: Chk, f: AstFile) {
    for ad in f.aliases {
        if chk_reserved(ad.name) || c.info.aliases.contains_key(ad.name) {
            chk_errorf(c, ad.pos, "type `" + ad.name + "` is already defined");
            continue;
        }
        c.info.aliases.insert(ad.name, ad);
    }
    for sd in f.structs {
        if (chk_reserved(sd.name) && !(c.prelude && chk_prelude_type(sd.name)))
            || c.info.aliases.contains_key(sd.name)
            || c.info.structs.contains_key(sd.name)
            || c.info.enums.contains_key(sd.name) {
            chk_errorf(c, sd.pos, "type `" + sd.name + "` is already defined");
            continue;
        }
        if chk_is_lib_pos(sd.pos) {
            c.info.lib_types.insert(sd.name, true);
        }
        c.info.structs.insert(sd.name, TyStruct {
            name: sd.name,
            params: chk_tparams(c, sd.generics, false),
            fields: Vec::new(),
        });
    }
    for ed in f.enums {
        if chk_reserved(ed.name)
            || c.info.aliases.contains_key(ed.name)
            || c.info.structs.contains_key(ed.name)
            || c.info.enums.contains_key(ed.name) {
            chk_errorf(c, ed.pos, "type `" + ed.name + "` is already defined");
            continue;
        }
        if chk_is_lib_pos(ed.pos) {
            c.info.lib_types.insert(ed.name, true);
        }
        c.info.enums.insert(ed.name, TyEnum {
            name: ed.name,
            params: chk_tparams(c, ed.generics, false),
            variants: Vec::new(),
        });
    }
    chk_declare_traits(c, f);
    for sd in f.structs {
        match c.info.structs.get(sd.name) {
            Some(mut st) => {
                if st.fields.len() == 0 {
                    c.tscope = chk_param_scope(st.params);
                    let mut seen: HashMap<String, Bool> = HashMap::new();
                    for fl in sd.fields {
                        if seen.contains_key(fl.name) {
                            chk_errorf(c, fl.pos, "duplicate field `" + fl.name + "`");
                        }
                        seen.insert(fl.name, true);
                        let t = chk_resolve_type(c, fl.ty, false);
                        if ref_alias_of(c.info, fl.ty) != "" {
                            c.info.alias_structs.insert(sd.name, true);
                        }
                        st.fields.push(TyField { name: fl.name, ty: t, mutable: fl.mutable });
                    }
                    c.tscope = HashMap::new();
                }
            }
            None => {}
        }
    }
    for ed in f.enums {
        match c.info.enums.get(ed.name) {
            Some(mut en) => {
                if en.variants.len() == 0 {
                    c.tscope = chk_param_scope(en.params);
                    let mut seen: HashMap<String, Bool> = HashMap::new();
                    for v in ed.variants {
                        if seen.contains_key(v.name) {
                            chk_errorf(c, v.pos, "duplicate variant `" + v.name + "`");
                        }
                        seen.insert(v.name, true);
                        let mut vi = TyVariant { name: v.name, fields: Vec::new() };
                        for ft in v.fields {
                            vi.fields.push(chk_resolve_type(c, ft, false));
                        }
                        en.variants.push(vi);
                    }
                    c.tscope = HashMap::new();
                    if en.variants.len() == 0 {
                        chk_errorf(
                            c,
                            ed.pos,
                            "enum `" + ed.name + "` must have at least one variant",
                        );
                    }
                }
            }
            None => {}
        }
    }
    for im in f.impls {
        match im.trait_ty {
            Some(tt) => chk_declare_trait_impl(c, im, tt),
            None => {}
        }
    }
    for fd in f.funcs {
        if c.info.funcs.contains_key(fd.name) {
            chk_errorf(c, fd.pos, "function `" + fd.name + "` is already defined");
            continue;
        }
        chk_declare_func(c, fd, fd.name, Vec::new(), HashMap::new());
    }
    for im in f.impls {
        if im.trait_ty.is_none() {
            chk_declare_impl(c, im);
        }
    }
    chk_declare_trait_methods(c);
    chk_declare_impl_methods(c);
    chk_check_supertraits(c);
    chk_alias_preds(c, f);
}

// chk_alias_preds type-checks the predicates of refined aliases: `Bool`
// expressions over `self` (the value, of the aliased type) in the linear
// fragment.
fn chk_alias_preds(mut c: Chk, f: AstFile) {
    for ad in f.aliases {
        // resolve every alias (reports cycles even in unused ones)
        let n = c.errs.len();
        chk_resolve_type(c, ad.ty, false);
        if c.errs.len() > n {
            continue;
        }
        match ad.pred {
            Some(e) => {
                let t = chk_resolve_type(
                    c,
                    AstType::Named(AstNamedType {
                        id: ad.id,
                        pos: ad.pos,
                        name: ad.name,
                        args: Vec::new(),
                    }),
                    false,
                );
                c.scopes = Vec::new();
                chk_push(c, false);
                chk_bind(c, chk_new_binding(c, "self", t, ad.pos));
                let n2 = c.errs.len();
                let pt = chk_expr(c, e);
                chk_expect(c, ast_expr_pos(e), pt, ty_bool(), "refinement predicate");
                if c.errs.len() == n2 {
                    chk_pred_formula(c, e);
                }
                chk_pop(c);
                c.scopes = Vec::new();
            }
            None => {}
        }
    }
}

// chk_preds type-checks a function's refinement predicates: `Bool`
// expressions over the parameters and `result` (the return value) in the
// linear fragment (docs/refinement.md).
fn chk_preds(c: Chk, fun: ChkFunc) {
    if fun.decl.preds.len() == 0 {
        return;
    }
    for p in fun.params {
        if p.name == "result" {
            let at = match fun.decl.preds.get(0) {
                Some(e) => ast_expr_pos(e),
                None => p.pos,
            };
            chk_errorf(
                c,
                at,
                "`result` in a predicate is the return value: a function with refinement predicates cannot have a parameter named `result`",
            );
        }
    }
    chk_push(c, false);
    chk_bind(c, chk_new_binding(c, "result", fun.result, fun.decl.pos));
    for e in fun.decl.preds {
        let n = c.errs.len();
        let t = chk_expr(c, e);
        chk_expect(c, ast_expr_pos(e), t, ty_bool(), "refinement predicate");
        if c.errs.len() == n {
            chk_pred_formula(c, e);
        }
    }
    chk_pop(c);
}

// chk_pred_formula reports a predicate outside the language of
// refinements: comparisons of linear integer terms, `&&`, `||`, `!` and
// boolean literals. Returns false after an error.
fn chk_pred_formula(c: Chk, e: AstExpr) -> Bool {
    match e {
        AstExpr::BoolLit(_) => true,
        AstExpr::Unary(u) => {
            if u.op == "!" {
                return chk_pred_formula(c, u.x);
            }
            chk_pred_unsupported(c, e)
        }
        AstExpr::Binary(b) => {
            if b.op == "&&" || b.op == "||" {
                return chk_pred_formula(c, b.x) && chk_pred_formula(c, b.y);
            }
            if b.op == "<"
                || b.op == "<="
                || b.op == ">"
                || b.op == ">="
                || b.op == "=="
                || b.op == "!=" {
                if !ty_is_prim(
                    ty_prune(c.info.types.get(ast_expr_id(b.x)).unwrap_or(ty_invalid())),
                    "Int",
                ) {
                    chk_errorf(
                        c,
                        b.pos,
                        "refinement predicates compare integers only: `" + ref_show(e) + "`",
                    );
                    return false;
                }
                return chk_pred_term(c, b.x) && chk_pred_term(c, b.y);
            }
            chk_pred_unsupported(c, e)
        }
        _ => chk_pred_unsupported(c, e),
    }
}

fn chk_pred_unsupported(c: Chk, e: AstExpr) -> Bool {
    chk_errorf(
        c,
        ast_expr_pos(e),
        "`"
            + ref_show(e)
            + "` is not supported in a refinement predicate (linear integer arithmetic: integers, `+`, `-`, `*` by a constant, comparisons, `&&`, `||`, `!`, `v.len()`, immutable fields)",
    );
    false
}

// chk_pred_term reports an integer term that is not linear.
fn chk_pred_term(c: Chk, e: AstExpr) -> Bool {
    match e {
        AstExpr::IntLit(_) => true,
        AstExpr::Ident(x) => {
            if ty_is_prim(ty_prune(c.info.types.get(x.id).unwrap_or(ty_invalid())), "Int") {
                return true;
            }
            chk_pred_unsupported(c, e)
        }
        AstExpr::Unary(u) => {
            if u.op == "-" {
                return chk_pred_term(c, u.x);
            }
            chk_pred_unsupported(c, e)
        }
        AstExpr::Binary(b) => {
            if b.op == "+" || b.op == "-" {
                return chk_pred_term(c, b.x) && chk_pred_term(c, b.y);
            }
            if b.op == "*" {
                if ref_const_expr(b.x).is_some() || ref_const_expr(b.y).is_some() {
                    return chk_pred_term(c, b.x) && chk_pred_term(c, b.y);
                }
                chk_errorf(
                    c,
                    b.pos,
                    "refinement predicates must be linear: `"
                        + ref_show(e)
                        + "` multiplies two variables (one side of `*` must be a constant)",
                );
                return false;
            }
            chk_pred_unsupported(c, e)
        }
        AstExpr::Method(m) => {
            // the length of a parameter (or `self`, `result`): a Vec in a
            // field can change through aliases, so `p.items.len()` is not
            // allowed
            if m.name == "len" && m.args.len() == 0 && ref_is_ident(ref_strip(m.recv)) {
                match ty_prune(c.info.types.get(ast_expr_id(m.recv)).unwrap_or(ty_invalid())) {
                    Ty::Vec(_) => {
                        return true;
                    }
                    Ty::Prim(n) => {
                        if n == "String" {
                            return true;
                        }
                    }
                    _ => {}
                }
            }
            chk_pred_unsupported(c, e)
        }
        AstExpr::Field(f) => {
            if ref_path_expr(f.x)
                && ty_is_prim(ty_prune(c.info.types.get(f.id).unwrap_or(ty_invalid())), "Int") {
                match ty_prune(c.info.types.get(ast_expr_id(f.x)).unwrap_or(ty_invalid())) {
                    Ty::Struct(st, _) => {
                        match chk_struct_field(st, f.name) {
                            Some(fi) => {
                                if fi.mutable {
                                    chk_errorf(
                                        c,
                                        f.pos,
                                        "refinement predicates can only mention immutable fields: `"
                                            + f.name
                                            + "` of `"
                                            + st.name
                                            + "` is `mut`",
                                    );
                                    return false;
                                }
                                return true;
                            }
                            None => {}
                        }
                    }
                    Ty::Tuple(_) => {
                        return true;
                    }
                    _ => {}
                }
            }
            chk_pred_unsupported(c, e)
        }
        _ => chk_pred_unsupported(c, e),
    }
}

// chk_tparams creates the params of a generic item. The caller resolves
// their bounds (chk_resolve_bounds) once they are in scope; structs and
// enums take no bounds.
fn chk_tparams(mut c: Chk, gs: Vec<AstGeneric>, allow_bounds: Bool) -> Vec<TyParam> {
    let mut out = Vec::new();
    let mut seen: HashMap<String, Bool> = HashMap::new();
    for g in gs {
        if seen.contains_key(g.name) {
            chk_errorf(
                c,
                g.pos,
                "the name `" + g.name + "` is already used for a generic parameter",
            );
        }
        seen.insert(g.name, true);
        if chk_reserved(g.name) {
            chk_errorf(c, g.pos, "`" + g.name + "` cannot be used as a generic parameter name");
        }
        if !allow_bounds {
            for b in g.bounds {
                chk_errorf(
                    c,
                    ast_type_pos(b),
                    "bounds on the params of a struct or enum are not supported: put them on its `impl` blocks and functions",
                );
            }
        }
        c.next_id = c.next_id + 1;
        out.push(TyParam { id: c.next_id, name: g.name, bounds: Vec::new() });
    }
    out
}

fn chk_param_scope(ps: Vec<TyParam>) -> HashMap<String, Ty> {
    let mut m: HashMap<String, Ty> = HashMap::new();
    for p in ps {
        m.insert(p.name, Ty::Param(p));
    }
    m
}

fn chk_copy_scope(s: HashMap<String, Ty>) -> HashMap<String, Ty> {
    let mut m: HashMap<String, Ty> = HashMap::new();
    for (k, t) in s.iter() {
        m.insert(k, t);
    }
    m
}

// chk_impl_type_name names the type an `impl` adds methods to (methods are
// functions named `Type::name`); "" when t cannot have methods.
fn chk_impl_type_name(c: Chk, t: Ty, lib: Bool) -> String {
    match ty_prune(t) {
        Ty::Struct(st, _) => st.name,
        Ty::Enum(en, _) => en.name,
        Ty::Prim(n) => if lib && n != "<invalid>" && n != "!" {
            n
        } else {
            ""
        },
        Ty::Vec(_) => if lib { "Vec" } else { "" },
        Ty::Option(_) => if lib { "Option" } else { "" },
        Ty::Result(_, _) => if lib { "Result" } else { "" },
        Ty::Tuple(_) => if lib { "Tuple" } else { "" },
        _ => "",
    }
}

fn chk_declare_impl(mut c: Chk, im: AstImplDecl) {
    for a in im.assoc {
        chk_errorf(c, a.pos, "associated types are only allowed in trait impls");
    }
    let ips = chk_tparams(c, im.generics, true);
    c.tscope = chk_param_scope(ips);
    chk_resolve_bounds(c, im.generics, ips);
    let target = chk_resolve_type(c, im.target, false);
    c.tscope.insert("Self", target);
    let iwheres = chk_resolve_wheres(c, im.wheres);
    c.tscope = HashMap::new();
    let tname = chk_impl_type_name(c, target, c.prelude || chk_is_core(im.pos));
    if tname == "" {
        if !ty_is_prim(ty_prune(target), "<invalid>") {
            chk_errorf(
                c,
                ast_type_pos(im.target),
                "cannot define methods on `"
                    + ty_str(target)
                    + "`: an `impl` block must be for a struct or enum of this program",
            );
        }
        return;
    }
    let used = chk_ty_params_in(target);
    for p in ips {
        if !used.contains_key(p.id) {
            chk_errorf(
                c,
                im.pos,
                "the type parameter `" + p.name + "` is not constrained by the impl target",
            );
        }
    }
    for fd in im.funcs {
        let key = tname + "::" + fd.name;
        if c.info.funcs.contains_key(key) {
            chk_errorf(
                c,
                fd.pos,
                "duplicate definitions with name `" + fd.name + "` for `" + tname + "`",
            );
            continue;
        }
        let mut sc = chk_param_scope(ips);
        sc.insert("Self", target);
        match chk_declare_func(c, fd, key, ips, sc) {
            Some(mut fun) => {
                for w in iwheres {
                    fun.wheres.push(w);
                }
            }
            None => {}
        }
    }
}

// chk_ty_params_in collects the ids of the params occurring in t.
fn chk_ty_params_in(t: Ty) -> HashMap<Int, Bool> {
    let m: HashMap<Int, Bool> = HashMap::new();
    chk_collect_params(t, m);
    m
}

fn chk_collect_params(t0: Ty, mut m: HashMap<Int, Bool>) {
    match ty_prune(t0) {
        Ty::Param(p) => {
            m.insert(p.id, true);
        }
        Ty::Result(a, b) => {
            chk_collect_params(a, m);
            chk_collect_params(b, m);
        }
        Ty::Option(a) => chk_collect_params(a, m),
        Ty::Vec(a) => chk_collect_params(a, m),
        Ty::Tuple(ts) => {
            for x in ts {
                chk_collect_params(x, m);
            }
        }
        Ty::Struct(_, ts) => {
            for x in ts {
                chk_collect_params(x, m);
            }
        }
        Ty::Enum(_, ts) => {
            for x in ts {
                chk_collect_params(x, m);
            }
        }
        Ty::Fn(ps, r) => {
            for x in ps {
                chk_collect_params(x, m);
            }
            chk_collect_params(r, m);
        }
        _ => {}
    }
}

// chk_declare_func declares a function or method named name. outer are
// the params of the enclosing impl (empty for functions) and scope the
// type names it brings into scope.
fn chk_declare_func(
    mut c: Chk,
    fd: AstFuncDecl,
    name: String,
    outer: Vec<TyParam>,
    scope: HashMap<String, Ty>,
) -> Option<ChkFunc> {
    let mut tparams = Vec::new();
    for p in outer {
        tparams.push(p);
    }
    let mut sc = chk_copy_scope(scope);
    let own = chk_tparams(c, fd.generics, true);
    for p in own {
        if sc.contains_key(p.name) && p.name != "Self" {
            chk_errorf(
                c,
                fd.pos,
                "the name `" + p.name + "` is already used for a generic parameter",
            );
        }
        tparams.push(p);
        sc.insert(p.name, Ty::Param(p));
    }
    c.tscope = sc;
    chk_resolve_bounds(c, fd.generics, own);
    let wheres = chk_resolve_wheres(c, fd.wheres);
    if !fd.has_body && scope.get("Self").is_none() {
        chk_errorf(c, fd.pos, "free function without a body");
    }
    if !fd.has_body && fd.preds.len() > 0 {
        chk_errorf(
            c,
            fd.pos,
            "refinement predicates are not supported on trait method declarations",
        );
    }
    let mut fun = ChkFunc {
        name: name,
        decl: fd,
        tparams: tparams,
        tscope: sc,
        trait_name: "",
        wheres: Vec::new(),
        params: Vec::new(),
        result: ty_unit(),
        handler: ast_has_attr(fd, "handler"),
        main: ast_has_attr(fd, "main"),
        test: ast_has_attr(fd, "test"),
        async: false,
        calls: HashMap::new(),
        effects: HashMap::new(),
        effect_pos: HashMap::new(),
        declass: Vec::new(),
    };
    for a in fd.attrs {
        if scope.contains_key("Self") && a.name != "fresh" && a.name != "owned" {
            chk_errorf(c, a.pos, "attributes are not allowed on methods");
            continue;
        }
        chk_check_attr(c, a);
    }
    let mut paths: HashMap<String, Ty> = HashMap::new();
    let mut pi = 0;
    for p in fd.params {
        paths.insert(p.name, ty_param_path(name, pi, p.name));
        pi = pi + 1;
    }
    c.paths = paths;
    let mut seen: HashMap<String, Bool> = HashMap::new();
    for p in fd.params {
        if p.name != "_" && seen.contains_key(p.name) {
            chk_errorf(c, p.pos, "duplicate parameter `" + p.name + "`");
        }
        seen.insert(p.name, true);
        let mut t = ty_unit();
        match p.ty {
            Some(te) => {
                t = chk_resolve_type(c, te, true);
            }
            None => {
                // the receiver `self`
                match scope.get("Self") {
                    Some(st) => {
                        t = st;
                    }
                    None => chk_errorf(
                        c,
                        p.pos,
                        "`self` parameter is only allowed in methods (functions in an `impl` block)",
                    ),
                }
            }
        }
        match t {
            Ty::Cap(k, borrowed) => {
                if k == "Tx" && !borrowed {
                    chk_errorf(
                        c,
                        p.pos,
                        "a function cannot take ownership of a transaction; borrow it with `&Tx` (only a `transaction` block can commit or roll back)",
                    );
                }
            }
            _ => {}
        }
        let mut b = chk_new_binding(c, p.name, t, p.pos);
        b.param = true;
        fun.params.push(b);
    }
    match fd.result {
        Some(te) => {
            fun.result = chk_resolve_type(c, te, false);
        }
        None => {}
    }
    c.paths = HashMap::new();
    let mut has_paths = ty_mentions_path(fun.result);
    for b in fun.params {
        if ty_mentions_path(b.ty) {
            has_paths = true;
        }
    }
    if has_paths {
        c.info.path_fns.insert(name, true);
    }
    if fun.handler {
        chk_handler_sig(c, fun);
    }
    if fun.main {
        chk_main_sig(c, fun);
    }
    if fun.test {
        chk_test_sig(c, fun);
    }
    fun.wheres = wheres;
    if fun.tparams.len() > 0 && (fun.handler || fun.main || fun.test) {
        chk_errorf(c, fd.pos, "an entry point or test cannot be generic");
    }
    c.info.funcs.insert(name, fun);
    c.info.func_list.push(fun);
    c.tscope = HashMap::new();
    Some(fun)
}

fn chk_main_sig(mut c: Chk, fun: ChkFunc) {
    match c.info.handler {
        Some(h) => {
            chk_errorf(
                c,
                fun.decl.pos,
                "a program has either one #[handler] or one #[main] (also defined: `"
                    + h.name
                    + "`)",
            );
            return;
        }
        None => {}
    }
    c.info.handler = Some(fun);
    let mut nargs = 0;
    for p in fun.params {
        let mut ok = false;
        match p.ty {
            Ty::Vec(e) => {
                if ty_is_prim(e, "String") {
                    nargs = nargs + 1;
                    if nargs > 1 {
                        chk_errorf(
                            c,
                            p.pos,
                            "#[main] takes at most one `Vec<String>` (the command-line arguments)",
                        );
                    }
                    ok = true;
                }
            }
            Ty::Cap(k, _) => {
                if k != "Tx" {
                    ok = true;
                }
            }
            _ => {}
        }
        if !ok {
            chk_errorf(
                c,
                p.pos,
                "#[main] parameters must be `Vec<String>` or capabilities (&Fs, &Log, &Net, &Db, &Clock, &Random), found `"
                    + ty_str(p.ty)
                    + "`",
            );
        }
    }
    if !ty_is_prim(fun.result, "Int") {
        chk_errorf(
            c,
            fun.decl.pos,
            "#[main] must return `Int` (the exit code), found `" + ty_str(fun.result) + "`",
        );
    }
}

fn chk_handler_sig(mut c: Chk, fun: ChkFunc) {
    match c.info.handler {
        Some(h) => {
            chk_errorf(
                c,
                fun.decl.pos,
                "only one #[handler] is allowed per program (also defined: `" + h.name + "`)",
            );
            return;
        }
        None => {}
    }
    c.info.handler = Some(fun);
    let mut nreq = 0;
    for p in fun.params {
        let mut ok = false;
        match p.ty {
            Ty::Opaque(n) => {
                if n == "Request" {
                    nreq = nreq + 1;
                    if nreq > 1 {
                        chk_errorf(c, p.pos, "a handler takes at most one Request");
                    }
                    ok = true;
                }
            }
            Ty::Cap(k, _) => {
                if k != "Tx" {
                    ok = true;
                }
            }
            _ => {}
        }
        if !ok {
            chk_errorf(
                c,
                p.pos,
                "handler parameters must be `Request` or capabilities (&Log, &Net, &Db, &Clock, &Random), found `"
                    + ty_str(p.ty)
                    + "`",
            );
        }
    }
    if !ty_is_named(fun.result, "Response") {
        chk_errorf(
            c,
            fun.decl.pos,
            "a handler must return `Response`, found `" + ty_str(fun.result) + "`",
        );
    }
}

// chk_test_sig checks a `#[test]` function: it receives borrowed
// capabilities (mocks) and, for a property test, values that `kek test`
// can generate (compiler/pbt.kek). It reports failure by returning
// `false` or `Err(message)`.
fn chk_test_sig(c: Chk, fun: ChkFunc) {
    if fun.handler {
        chk_errorf(c, fun.decl.pos, "a function cannot be both #[test] and #[handler]");
    }
    for p in fun.params {
        match p.ty {
            Ty::Cap(k, borrowed) => {
                if !borrowed || k == "Tx" {
                    chk_errorf(
                        c,
                        p.pos,
                        "test parameters must be capabilities (&Log, &Net, &Db, &Clock, &Random) or generatable values, found `"
                            + ty_str(p.ty)
                            + "`",
                    );
                }
            }
            _ => {
                let why = pbt_why(c.info, p.ty);
                if why != "" {
                    chk_errorf(
                        c,
                        p.pos,
                        "cannot generate inputs of type `"
                            + ty_str(p.ty)
                            + "` for a property test: "
                            + why,
                    );
                }
            }
        }
    }
    match fun.result {
        Ty::Prim(n) => {
            if n == "()" || n == "Bool" {
                return;
            }
        }
        Ty::Result(ok, err) => {
            if ty_is_prim(ok, "()") && ty_is_prim(err, "String") {
                return;
            }
        }
        _ => {}
    }
    chk_errorf(
        c,
        fun.decl.pos,
        "a test must return `()`, `Bool` or `Result<(), String>`, found `"
            + ty_str(fun.result)
            + "`",
    );
}

// chk_type_args resolves the type arguments of a named type, reporting an
// arity mismatch.
fn chk_type_args(c: Chk, te: AstNamedType, n: Int) -> Vec<Ty> {
    if te.args.len() != n {
        chk_errorf(
            c,
            te.pos,
            "`"
                + te.name
                + "` expects "
                + n.to_string()
                + " type argument(s), found "
                + te.args.len().to_string(),
        );
    }
    let mut out = Vec::new();
    for i in 0..n {
        match te.args.get(i) {
            Some(a) => out.push(chk_resolve_type(c, a, false)),
            None => out.push(ty_unit()),
        }
    }
    out
}

fn chk_ty_at(v: Vec<Ty>, i: Int) -> Ty {
    v.get(i).unwrap_or(ty_unit())
}

// chk_resolve_type converts a syntactic type. Capability types are
// accepted only when allow_cap is set (function parameters).
fn chk_resolve_type(mut c: Chk, te0: AstType, allow_cap: Bool) -> Ty {
    match te0 {
        AstType::Unit(_) => ty_unit(),
        AstType::Fn(ft) => {
            let mut ps = Vec::new();
            for a in ft.params {
                ps.push(chk_resolve_type(c, a, false));
            }
            let r = match ft.result {
                Some(rt) => chk_resolve_type(c, rt, false),
                None => ty_unit(),
            };
            Ty::Fn(ps, r)
        }
        AstType::Tuple(te) => {
            let mut ts = Vec::new();
            for el in te.elems {
                ts.push(chk_resolve_type(c, el, false));
            }
            Ty::Tuple(ts)
        }
        AstType::Ref(te) => {
            match te.elem {
                AstType::Named(inner) => {
                    if inner.args.len() == 0 && ty_is_cap_name(inner.name) {
                        if !allow_cap {
                            chk_errorf(
                                c,
                                te.pos,
                                "capability type `&"
                                    + inner.name
                                    + "` is only allowed as a function parameter",
                            );
                        }
                        return Ty::Cap(inner.name, true);
                    }
                }
                _ => {}
            }
            // `&T` and `&mut T` are T: values of structs, enums and
            // collections are references already
            chk_resolve_type(c, te.elem, false)
        }
        AstType::Named(te) => {
            let n = te.name;
            if n.contains("::") {
                chk_type_args(c, te, 0);
                return chk_assoc_type(c, te);
            }
            match c.tscope.get(n) {
                Some(t) => {
                    chk_type_args(c, te, 0);
                    return t;
                }
                None => {}
            }
            if n == "_" {
                if !c.infer_ok {
                    chk_errorf(c, te.pos, "the placeholder `_` is not allowed in item signatures");
                    return ty_invalid();
                }
                return chk_new_var(c);
            }
            if n == "Self" {
                chk_errorf(c, te.pos, "`Self` is only available in `impl` blocks");
                return ty_invalid();
            }
            if n == "Int" || n == "Bool" || n == "String" {
                chk_type_args(c, te, 0);
                return Ty::Prim(n);
            }
            if n == "Result" {
                let a = chk_type_args(c, te, 2);
                return Ty::Result(chk_ty_at(a, 0), chk_ty_at(a, 1));
            }
            if n == "Option" {
                let a = chk_type_args(c, te, 1);
                return Ty::Option(chk_ty_at(a, 0));
            }
            if n == "Vec" {
                let a = chk_type_args(c, te, 1);
                return Ty::Vec(chk_ty_at(a, 0));
            }
            if c.prelude && chk_prelude_type(n) {
                match c.info.structs.get(n) {
                    Some(st) => {
                        chk_type_args(c, te, 0);
                        return Ty::Struct(st, Vec::new());
                    }
                    None => {}
                }
            }
            if n == "Request"
                || n == "Response"
                || n == "TxError"
                || n == "NetError"
                || n == "IoError"
                || (c.prelude && (n == "__Any" || n == "__Chars")) {
                chk_type_args(c, te, 0);
                return Ty::Opaque(n);
            }
            if ty_is_cap_name(n) {
                chk_type_args(c, te, 0);
                if !allow_cap {
                    chk_errorf(
                        c,
                        te.pos,
                        "capability type `" + n + "` is only allowed as a function parameter",
                    );
                    return Ty::Cap(n, false);
                }
                if n != "Tx" {
                    chk_errorf(
                        c,
                        te.pos,
                        "capabilities are passed by borrowing: write `&" + n + "`",
                    );
                    return Ty::Cap(n, true);
                }
                return Ty::Cap(n, false);
            }
            match c.info.aliases.get(n) {
                Some(ad) => {
                    chk_type_args(c, te, 0);
                    if c.info.alias_busy.contains_key(n) {
                        chk_errorf(c, te.pos, "type alias `" + n + "` refers to itself");
                        return ty_invalid();
                    }
                    c.info.alias_busy.insert(n, true);
                    if ad.pred.is_some() {
                        c.info.refine_fns.insert(c.cur.name, true);
                    }
                    let saved = c.tscope;
                    c.tscope = HashMap::new();
                    let t = chk_resolve_type(c, ad.ty, false);
                    c.tscope = saved;
                    c.info.alias_busy.remove(n);
                    return t;
                }
                None => {}
            }
            match c.info.structs.get(n) {
                Some(st) => {
                    if n == "Can" && te.args.len() == 2 && c.info.lib_types.contains_key(n) {
                        let mut a = Vec::new();
                        a.push(chk_resolve_type(c, te.args.get(0).unwrap_or(te0), false));
                        a.push(chk_resolve_path(c, te.args.get(1).unwrap_or(te0)));
                        return Ty::Struct(st, a);
                    }
                    return Ty::Struct(st, chk_type_args(c, te, st.params.len()));
                }
                None => {}
            }
            match c.info.enums.get(n) {
                Some(en) => {
                    return Ty::Enum(en, chk_type_args(c, te, en.params.len()));
                }
                None => {}
            }
            chk_errorf(c, te.pos, "unknown type `" + n + "`");
            ty_unit()
        }
    }
}

fn chk_expect(c: Chk, pos: AstPos, got: Ty, want: Ty, what: String) {
    if !ty_unify(got, want) {
        chk_errorf(
            c,
            pos,
            "mismatched types in "
                + what
                + ": expected `"
                + ty_str(want)
                + "`, found `"
                + ty_str(got)
                + "`"
                + chk_pii_hint(got, want)
                + chk_label_hint(got, want)
                + chk_can_hint(got, want),
        );
    }
}

// ---- functions ----

fn chk_push(mut c: Chk, tx_boundary: Bool) {
    c.scopes.push(ChkScope { vars: HashMap::new(), tx_boundary: tx_boundary, lambda: 0 });
}

fn chk_pop(mut c: Chk) {
    c.scopes.pop();
}

fn chk_bind(c: Chk, b: ChkBinding) {
    if b.name == "_" {
        return;
    }
    match c.scopes.get(c.scopes.len() - 1) {
        Some(mut s) => {
            s.vars.insert(b.name, b);
        }
        None => {}
    }
}

fn chk_func(mut c: Chk, fun: ChkFunc) {
    c.cur = fun;
    c.tscope = fun.tscope;
    c.info.wheres = fun.wheres;
    c.infer_ok = true;
    c.loops = 0;
    c.scopes = Vec::new();
    chk_push(c, false);
    for p in fun.params {
        chk_bind(c, p);
    }
    c.rets = Vec::new();
    c.rets.push(ChkRet { ty: fun.result, closure: None });
    let t = chk_block(c, fun.decl.body);
    chk_expect(c, chk_tail_pos(fun.decl.body), t, fun.result, "function result");
    chk_preds(c, fun);
    chk_pop(c);
    chk_check_obls(c);
    c.info.wheres = Vec::new();
    c.cur = chk_dummy_func();
    c.tscope = HashMap::new();
    c.infer_ok = false;
}

// chk_tail_pos is the position to blame for a block's value.
fn chk_tail_pos(b: AstBlock) -> AstPos {
    match b.tail {
        Some(e) => ast_expr_pos(e),
        None => b.end,
    }
}

// chk_lookup resolves a name; it reports masked irrevocable capabilities
// used inside a transaction.
fn chk_lookup(mut c: Chk, name: String, pos: AstPos) -> Option<ChkBinding> {
    let mut crossed = false;
    let mut lambdas = Vec::new();
    c.captured = false;
    let mut i = c.scopes.len() - 1;
    while i >= 0 {
        match c.scopes.get(i) {
            Some(s) => {
                match s.vars.get(name) {
                    Some(b) => {
                        if lambdas.len() > 0 {
                            chk_capture(c, lambdas, b, pos);
                        }
                        match b.ty {
                            Ty::Cap(k, _) => {
                                if crossed && !ty_cap_revocable(k) {
                                    chk_errorf(
                                        c,
                                        pos,
                                        "capability `"
                                            + b.name
                                            + ": "
                                            + ty_str(b.ty)
                                            + "` cannot be used inside a transaction: its effects cannot be rolled back (use `tx.outbox(...)` to run an effect after commit)",
                                    );
                                }
                            }
                            _ => {}
                        }
                        return Some(b);
                    }
                    None => {}
                }
                if s.tx_boundary {
                    crossed = true;
                }
                if s.lambda != 0 {
                    lambdas.push(s.lambda);
                }
            }
            None => {}
        }
        i = i - 1;
    }
    None
}

// chk_capture records that the closures lambdas capture b.
fn chk_capture(mut c: Chk, lambdas: Vec<Int>, b: ChkBinding, pos: AstPos) {
    c.captured = true;
    if ty_is_cap(b.ty) {
        chk_errorf(
            c,
            pos,
            "closures cannot capture capability `"
                + b.name
                + "`: a closure is a pure value (call the capability outside, or pass it to a function)",
        );
        return;
    }
    for id in lambdas {
        match c.info.lambdas.get(id) {
            Some(mut li) => {
                let mut seen = false;
                for x in li.captures {
                    if x.id == b.id {
                        seen = true;
                    }
                }
                if !seen {
                    li.captures.push(b);
                }
            }
            None => {}
        }
    }
}

fn chk_record(mut c: Chk, id: Int, t: Ty) -> Ty {
    c.info.types.insert(id, t);
    t
}

fn chk_block(c: Chk, b: AstBlock) -> Ty {
    chk_push(c, false);
    let mut diverges = false;
    for s in b.stmts {
        if chk_stmt(c, s) {
            diverges = true;
        }
    }
    let mut t = ty_unit();
    match b.tail {
        Some(e) => {
            t = chk_expr(c, e);
        }
        None => {
            if diverges {
                t = ty_never();
            }
        }
    }
    let r = chk_record(c, b.id, t);
    chk_pop(c);
    r
}

// chk_stmt checks a statement and reports whether it diverges.
fn chk_stmt(mut c: Chk, s0: AstStmt) -> Bool {
    match s0 {
        AstStmt::Let(s) => {
            let mut t = ty_unit();
            match s.ty {
                Some(te) => {
                    let want = chk_resolve_type(c, te, false);
                    let got = chk_expr_expect(c, s.init, want);
                    chk_expect(c, ast_expr_pos(s.init), got, want, "let binding");
                    t = want;
                }
                None => {
                    t = chk_expr(c, s.init);
                }
            }
            if ty_is_prim(ty_prune(t), "!") {
                t = chk_new_var(c);
            }
            match s.pat {
                Some(pat) => {
                    chk_irrefutable(c, pat, t, "local binding");
                    return false;
                }
                None => {}
            }
            let mut b = chk_new_binding(c, s.name, t, s.pos);
            b.mutable = s.mutable;
            c.info.lets.insert(s.id, b);
            chk_bind(c, b);
            false
        }
        AstStmt::Assign(s) => {
            let ob = chk_lookup(c, s.name, s.pos);
            if c.captured {
                chk_errorf(
                    c,
                    s.pos,
                    "cannot assign to `"
                        + s.name
                        + "`: closures capture variables by value (store the state in a struct field instead)",
                );
            }
            let t = chk_expr(c, s.value);
            match ob {
                None => {
                    chk_errorf(c, s.pos, "cannot find value `" + s.name + "` in this scope");
                }
                Some(b) => {
                    if ty_is_cap(b.ty) {
                        chk_errorf(c, s.pos, "cannot assign to capability `" + s.name + "`");
                        return false;
                    }
                    if !b.mutable {
                        chk_errorf(
                            c,
                            s.pos,
                            "cannot assign twice to immutable variable `"
                                + s.name
                                + "` (declare it with `let mut`)",
                        );
                    }
                    c.info.assigns.insert(s.id, b);
                    chk_expect(c, ast_expr_pos(s.value), t, b.ty, "assignment");
                }
            }
            false
        }
        AstStmt::FieldAssign(s) => {
            let ft = chk_expr(c, AstExpr::Field(s.target));
            match c.info.types.get(ast_expr_id(s.target.x)) {
                Some(xt) => match ty_prune(xt) {
                    Ty::Tuple(_) => chk_errorf(
                        c,
                        s.pos,
                        "cannot assign to a tuple element: tuples are immutable",
                    ),
                    Ty::Struct(st, _) => match c.info.fields.get(s.target.id) {
                        Some(i) => match st.fields.get(i) {
                            Some(fi) => {
                                if !fi.mutable {
                                    chk_errorf(
                                        c,
                                        s.pos,
                                        "cannot assign to field `"
                                            + fi.name
                                            + "` of `"
                                            + st.name
                                            + "`: it is not declared `mut` (write `mut "
                                            + fi.name
                                            + ": ...` in the struct)",
                                    );
                                }
                            }
                            None => {}
                        },
                        None => {}
                    },
                    _ => {}
                },
                None => {}
            }
            let vt = chk_expr(c, s.value);
            chk_expect(c, ast_expr_pos(s.value), vt, ft, "field assignment");
            match ty_prune(c.info.types.get(ast_expr_id(s.target.x)).unwrap_or(ty_invalid())) {
                Ty::Struct(st, _) => {
                    if c.info.alias_structs.contains_key(st.name) {
                        c.info.refine_fns.insert(c.cur.name, true);
                    }
                }
                _ => {}
            }
            false
        }
        AstStmt::Break(s) => {
            if c.loops == 0 {
                chk_errorf(c, s.pos, "`break`/`continue` outside of a loop");
            }
            true
        }
        AstStmt::Continue(s) => {
            if c.loops == 0 {
                chk_errorf(c, s.pos, "`break`/`continue` outside of a loop");
            }
            true
        }
        AstStmt::While(s) => {
            let ct = chk_expr(c, s.cond);
            chk_push(c, false);
            match s.pat {
                Some(pat) => {
                    chk_let_pattern(c, pat, ct);
                }
                None => chk_expect(c, ast_expr_pos(s.cond), ct, ty_bool(), "while condition"),
            }
            c.loops = c.loops + 1;
            let bt = chk_block(c, s.body);
            c.loops = c.loops - 1;
            chk_pop(c);
            chk_expect(c, s.body.end, bt, ty_unit(), "while body");
            false
        }
        AstStmt::For(s) => {
            let it = chk_expr(c, s.iter);
            let mut elem = ty_invalid();
            match s.end {
                Some(end) => {
                    let et = chk_expr(c, end);
                    chk_expect(c, ast_expr_pos(s.iter), it, ty_int(), "range start");
                    chk_expect(c, ast_expr_pos(end), et, ty_int(), "range end");
                    elem = ty_int();
                }
                None => {
                    match ty_prune(it) {
                        Ty::Vec(e) => {
                            elem = e;
                        }
                        _ => {
                            elem = chk_for_iter(c, s, it);
                        }
                    }
                }
            }
            chk_push(c, false);
            let b = chk_new_binding(c, s.var, elem, s.pos);
            c.info.fors.insert(s.id, b);
            match s.pat {
                Some(pat) => chk_irrefutable(c, pat, elem, "`for` loop"),
                None => chk_bind(c, b),
            }
            c.loops = c.loops + 1;
            let bt = chk_block(c, s.body);
            c.loops = c.loops - 1;
            chk_expect(c, s.body.end, bt, ty_unit(), "for body");
            chk_pop(c);
            false
        }
        AstStmt::Return(s) => {
            let rc = chk_top_ret(c);
            c.info.returns.insert(s.id, ChkReturnInfo { closure: rc.closure });
            match s.value {
                None => chk_expect(c, s.pos, ty_unit(), rc.ty, "return"),
                Some(v) => {
                    let t = chk_expr(c, v);
                    chk_expect(c, ast_expr_pos(v), t, rc.ty, "return");
                }
            }
            true
        }
        AstStmt::Expr(s) => {
            let t = chk_expr(c, s.x);
            if ty_is_prim(ty_prune(t), "!") {
                return true;
            }
            if !s.semi {
                chk_expect(c, s.pos, t, ty_unit(), "statement");
            }
            false
        }
    }
}

// chk_let_pattern checks the pattern of `if let` / `while let` against
// the scrutinee type t (binding its variables in the current scope).
fn chk_let_pattern(c: Chk, pat: AstPattern, t: Ty) {
    let st = ty_prune(t);
    if ty_is_var(st) {
        chk_errorf(c, pat.pos, "type annotations needed for the `let` scrutinee");
    }
    chk_pattern(c, pat, st);
}

// chk_irrefutable checks a `let` or `for` pattern, which must match every
// value of t, and binds its variables in the current scope.
fn chk_irrefutable(c: Chk, pat: AstPattern, t: Ty, what: String) {
    chk_pattern(c, pat, t);
    let mut rows: Vec<Vec<AstPattern>> = Vec::new();
    rows.push(chk_pats1(pat));
    if !chk_exhaustive(c.info, rows, chk_tys1(t)) {
        chk_errorf(
            c,
            pat.pos,
            "refutable pattern in " + what + chk_missing(c.info, rows, t) + " (use `match`)",
        );
    }
}

fn chk_pats1(p: AstPattern) -> Vec<AstPattern> {
    let mut v = Vec::new();
    v.push(p);
    v
}

// chk_for_iter checks `for x in e` over an Iterator (or IntoIterator) e of
// type it and returns the element type.
fn chk_for_iter(mut c: Chk, s: AstForStmt, it: Ty) -> Ty {
    let t = ty_prune(it);
    if ty_is_prim(t, "<invalid>") {
        return ty_invalid();
    }
    if ty_is_var(t) {
        chk_errorf(c, ast_expr_pos(s.iter), "type annotations needed for the `for` loop");
        return ty_invalid();
    }
    let pos = ast_expr_pos(s.iter);
    let mut into = None;
    let mut iter_t = t;
    if !chk_implements(c.info, t, "Iterator", Vec::new(), 0) {
        if !chk_implements(c.info, t, "IntoIterator", Vec::new(), 0) {
            chk_errorf(
                c,
                pos,
                "`"
                    + ty_str(t)
                    + "` is not an iterator (it implements neither `Iterator` nor `IntoIterator`)",
            );
            return ty_invalid();
        }
        match c.info.funcs.get("IntoIterator::into_iter") {
            Some(tf) => {
                let mi = chk_trait_call(c, pos, tf, t, true, Vec::new(), Vec::new());
                iter_t = chk_norm(c.info, mi.recv_ty);
                into = Some(mi);
            }
            None => {
                return ty_invalid();
            }
        }
        if !chk_implements(c.info, iter_t, "Iterator", Vec::new(), 0) {
            chk_errorf(c, pos, "`" + ty_str(iter_t) + "` (from `into_iter`) is not an iterator");
            return ty_invalid();
        }
    }
    match c.info.funcs.get("Iterator::next") {
        Some(tf) => {
            let mi = chk_trait_call(c, pos, tf, iter_t, true, Vec::new(), Vec::new());
            c.info.for_iters.insert(s.id, ChkForIter { into: into, next: mi });
            match chk_norm(c.info, mi.recv_ty) {
                Ty::Option(e) => e,
                _ => ty_invalid(),
            }
        }
        None => ty_invalid(),
    }
}

fn chk_top_ret(c: Chk) -> ChkRet {
    match c.rets.get(c.rets.len() - 1) {
        Some(r) => r,
        None => ChkRet { ty: ty_unit(), closure: None },
    }
}

fn chk_expr(c: Chk, e: AstExpr) -> Ty {
    chk_expr_cap(c, e, false)
}

// chk_expr_cap checks an expression. Capability-typed identifiers are
// only permitted when allow_cap is set (method receivers and capability
// arguments).
fn chk_expr_cap(mut c: Chk, e0: AstExpr, allow_cap: Bool) -> Ty {
    match e0 {
        AstExpr::IntLit(e) => chk_record(c, e.id, ty_int()),
        AstExpr::BoolLit(e) => chk_record(c, e.id, ty_bool()),
        AstExpr::StrLit(e) => chk_record(c, e.id, ty_string()),
        AstExpr::UnitLit(e) => chk_record(c, e.id, ty_unit()),
        AstExpr::Ident(e) => {
            if e.name == "None" {
                match chk_lookup(c, e.name, e.pos) {
                    None => {
                        let t = Ty::Option(chk_new_var(c));
                        c.info.calls.insert(e.id, chk_call_info("none", t));
                        return chk_record(c, e.id, t);
                    }
                    Some(_) => {}
                }
            }
            match chk_lookup(c, e.name, e.pos) {
                None => {
                    match c.info.funcs.get(e.name) {
                        Some(fun) => {
                            return chk_record(c, e.id, chk_fn_item(c, e, fun));
                        }
                        None => {}
                    }
                    chk_errorf(c, e.pos, "cannot find value `" + e.name + "` in this scope");
                    chk_record(c, e.id, ty_invalid())
                }
                Some(mut b) => {
                    b.uses = b.uses + 1;
                    c.info.uses.insert(e.id, b);
                    if ty_is_cap(b.ty) && !allow_cap {
                        chk_errorf(
                            c,
                            e.pos,
                            "capability `"
                                + b.name
                                + "` cannot be used as a value: capabilities are second-class and can only be passed as arguments or used as method receivers",
                        );
                    }
                    chk_record(c, e.id, b.ty)
                }
            }
        }
        AstExpr::Unary(e) => {
            if e.op == "&" || e.op == "&mut " || e.op == "*" {
                let t = chk_expr_cap(c, e.x, allow_cap);
                return chk_record(c, e.id, t);
            }
            let t = chk_expr(c, e.x);
            if e.op == "-" {
                chk_expect(c, e.pos, t, ty_int(), "negation");
                return chk_record(c, e.id, ty_int());
            }
            chk_expect(c, e.pos, t, ty_bool(), "`!`");
            chk_record(c, e.id, ty_bool())
        }
        AstExpr::Binary(e) => {
            let t = chk_binary(c, e);
            chk_record(c, e.id, t)
        }
        AstExpr::Block(b) => chk_block(c, b),
        AstExpr::If(e) => {
            let ct = chk_expr(c, e.cond);
            chk_push(c, false);
            match e.pat {
                Some(pat) => {
                    chk_let_pattern(c, pat, ct);
                }
                None => chk_expect(c, ast_expr_pos(e.cond), ct, ty_bool(), "if condition"),
            }
            let tt = chk_block(c, e.then);
            chk_pop(c);
            match e.els {
                None => {
                    chk_expect(c, e.then.end, tt, ty_unit(), "`if` without `else`");
                    chk_record(c, e.id, ty_unit())
                }
                Some(els) => {
                    let et = chk_expr(c, els);
                    if !ty_unify(tt, et) {
                        chk_errorf(
                            c,
                            e.pos,
                            "`if` and `else` have incompatible types: `"
                                + ty_str(tt)
                                + "` vs `"
                                + ty_str(et)
                                + "`",
                        );
                    }
                    chk_record(c, e.id, ty_join(tt, et))
                }
            }
        }
        AstExpr::Match(e) => {
            let t = chk_match(c, e);
            chk_record(c, e.id, t)
        }
        AstExpr::Call(e) => {
            let t = chk_call(c, e);
            chk_record(c, e.id, t)
        }
        AstExpr::Path(e) => {
            let t = chk_path(c, e, None);
            chk_record(c, e.id, t)
        }
        AstExpr::Method(e) => {
            let t = chk_method(c, e);
            chk_record(c, e.id, t)
        }
        AstExpr::Field(e) => {
            let t = ty_prune(chk_expr(c, e.x));
            if ty_is_prim(t, "<invalid>") {
                return chk_record(c, e.id, ty_invalid());
            }
            match t {
                Ty::Tuple(ts) => {
                    match parse_int_text(e.name) {
                        Some(i) => {
                            if i < ts.len() {
                                c.info.fields.insert(e.id, i);
                                return chk_record(c, e.id, ts.get(i).unwrap_or(ty_invalid()));
                            }
                        }
                        None => {}
                    }
                    chk_errorf(c, e.pos, "no field `" + e.name + "` on type `" + ty_str(t) + "`");
                    chk_record(c, e.id, ty_invalid())
                }
                Ty::Struct(st, args) => {
                    let mut i = 0;
                    for fi in st.fields {
                        if fi.name == e.name {
                            c.info.fields.insert(e.id, i);
                            return chk_record(c, e.id, ty_subst(fi.ty, st.params, args));
                        }
                        i = i + 1;
                    }
                    chk_errorf(c, e.pos, "struct `" + st.name + "` has no field `" + e.name + "`");
                    chk_record(c, e.id, ty_invalid())
                }
                _ => {
                    chk_errorf(c, e.pos, "no field `" + e.name + "` on type `" + ty_str(t) + "`");
                    chk_record(c, e.id, ty_invalid())
                }
            }
        }
        AstExpr::StructLit(e) => {
            let mut lit_ty = None;
            let mut sname = e.name;
            if e.name == "Self" {
                match c.tscope.get("Self") {
                    Some(t) => match ty_prune(t) {
                        Ty::Struct(st, _) => {
                            lit_ty = Some(t);
                            sname = st.name;
                        }
                        _ => {}
                    },
                    None => {}
                }
            }
            match c.info.structs.get(sname) {
                None => {
                    chk_errorf(c, e.pos, "unknown struct `" + e.name + "`");
                    for f in e.fields {
                        chk_expr(c, f.value);
                    }
                    chk_record(c, e.id, ty_invalid())
                }
                Some(st) => {
                    c.info.struct_lits.insert(e.id, st);
                    if c.info.alias_structs.contains_key(st.name) {
                        c.info.refine_fns.insert(c.cur.name, true);
                    }
                    let sty = match lit_ty {
                        Some(t) => t,
                        None => Ty::Struct(st, chk_instantiate(c, st.params)),
                    };
                    let args = match ty_prune(sty) {
                        Ty::Struct(_, a) => a,
                        _ => Vec::new(),
                    };
                    let mut seen: HashMap<String, Bool> = HashMap::new();
                    for f in e.fields {
                        let t = chk_expr(c, f.value);
                        match chk_struct_field(st, f.name) {
                            None => {
                                chk_errorf(
                                    c,
                                    f.pos,
                                    "struct `" + st.name + "` has no field `" + f.name + "`",
                                );
                            }
                            Some(fi) => {
                                if seen.contains_key(f.name) {
                                    chk_errorf(
                                        c,
                                        f.pos,
                                        "field `" + f.name + "` specified more than once",
                                    );
                                }
                                seen.insert(f.name, true);
                                chk_expect(
                                    c,
                                    ast_expr_pos(f.value),
                                    t,
                                    ty_subst(fi.ty, st.params, args),
                                    "field `" + f.name + "`",
                                );
                            }
                        }
                    }
                    for fi in st.fields {
                        if !seen.contains_key(fi.name) {
                            chk_errorf(
                                c,
                                e.pos,
                                "missing field `"
                                    + fi.name
                                    + "` in initializer of `"
                                    + st.name
                                    + "`",
                            );
                        }
                    }
                    chk_record(c, e.id, sty)
                }
            }
        }
        AstExpr::Try(e) => {
            let t = chk_try(c, e);
            chk_record(c, e.id, t)
        }
        AstExpr::Closure(e) => chk_closure(c, e, None),
        AstExpr::Tuple(e) => {
            let mut ts = Vec::new();
            for el in e.elems {
                ts.push(chk_expr(c, el));
            }
            chk_record(c, e.id, Ty::Tuple(ts))
        }
        AstExpr::Index(e) => {
            c.info.refine_fns.insert(c.cur.name, true);
            let vt = ty_prune(chk_expr(c, e.x));
            let it = chk_expr(c, e.index);
            chk_expect(c, ast_expr_pos(e.index), it, ty_int(), "index");
            match vt {
                Ty::Vec(el) => chk_record(c, e.id, el),
                _ => {
                    if !ty_is_prim(vt, "<invalid>") {
                        chk_errorf(
                            c,
                            e.pos,
                            "cannot index a value of type `"
                                + ty_str(vt)
                                + "`: `x[i]` is only defined for `Vec` (use `get(i)` for an `Option`)",
                        );
                    }
                    chk_record(c, e.id, ty_invalid())
                }
            }
        }
        AstExpr::Range(e) => {
            let a = chk_expr(c, e.start);
            let b = chk_expr(c, e.end);
            chk_expect(c, ast_expr_pos(e.start), a, ty_int(), "range start");
            chk_expect(c, ast_expr_pos(e.end), b, ty_int(), "range end");
            let n = if e.inclusive {
                "RangeInclusive"
            } else {
                "Range"
            };
            match c.info.structs.get(n) {
                Some(st) => chk_record(c, e.id, Ty::Struct(st, Vec::new())),
                None => {
                    chk_errorf(c, e.pos, "the core library has no `" + n + "`");
                    chk_record(c, e.id, ty_invalid())
                }
            }
        }
    }
}

fn chk_struct_field(st: TyStruct, name: String) -> Option<TyField> {
    for f in st.fields {
        if f.name == name {
            return Some(f);
        }
    }
    None
}

fn chk_call_info(kind: String, t: Ty) -> ChkCallInfo {
    ChkCallInfo {
        kind: kind,
        func: None,
        enm: None,
        tag: 0,
        builtin: None,
        op: "",
        ty: t,
        targs: Vec::new(),
    }
}

// ---- generic instantiation ----

// chk_instantiate returns fresh inference variables for params ps.
fn chk_instantiate(c: Chk, ps: Vec<TyParam>) -> Vec<Ty> {
    let mut out = Vec::new();
    for p in ps {
        out.push(chk_new_var(c));
    }
    out
}

// chk_turbofish applies explicit type arguments (`f::<A, B>`) to the
// function's own generic params (after those of its impl).
fn chk_turbofish(c: Chk, pos: AstPos, fun: ChkFunc, targs: Vec<Ty>, given: Vec<AstType>) {
    if given.len() == 0 {
        return;
    }
    let own = fun.decl.generics.len();
    let off = fun.tparams.len() - own;
    if given.len() != own {
        chk_errorf(
            c,
            pos,
            "`"
                + fun.name
                + "` takes "
                + own.to_string()
                + " generic argument(s) but "
                + given.len().to_string()
                + " were supplied",
        );
        return;
    }
    for i in 0..own {
        match given.get(i) {
            Some(g) => {
                let t = chk_resolve_type(c, g, false);
                ty_unify(targs.get(off + i).unwrap_or(ty_unit()), t);
            }
            None => {}
        }
    }
}

fn chk_no_turbofish(c: Chk, pos: AstPos, what: String, given: Vec<AstType>) {
    if given.len() > 0 {
        chk_errorf(c, pos, what + " takes no generic arguments");
    }
}

// chk_oblige_bounds adds the obligations of the bounds of fun's params
// and of its `where` clauses, instantiated with targs.
fn chk_oblige_bounds(c: Chk, pos: AstPos, fun: ChkFunc, targs: Vec<Ty>) {
    chk_oblige_wheres(c, pos, fun.wheres, fun.tparams, targs);
    for i in 0..fun.tparams.len() {
        match fun.tparams.get(i) {
            Some(p) => {
                let t = targs.get(i).unwrap_or(ty_unit());
                for b in p.bounds {
                    if b.trait_name == "Fn" {
                        continue;
                    }
                    chk_oblige_args(
                        c,
                        pos,
                        b.trait_name,
                        ty_subst_all(b.args, fun.tparams, targs),
                        t,
                        "",
                    );
                    // associated type bindings `I: Iterator<Item = T>`
                    for j in 0..b.assoc_names.len() {
                        let want = ty_subst(
                            b.assoc_tys.get(j).unwrap_or(ty_unit()),
                            fun.tparams,
                            targs,
                        );
                        chk_assoc_eq(
                            c,
                            pos,
                            t,
                            b.trait_name,
                            b.assoc_names.get(j).unwrap_or(""),
                            want,
                            true,
                        );
                    }
                }
            }
            None => {}
        }
    }
}

// chk_param_types returns the parameter types of fun instantiated with
// targs.
fn chk_param_types(fun: ChkFunc, targs: Vec<Ty>) -> Vec<Ty> {
    let mut out = Vec::new();
    for p in fun.params {
        out.push(ty_subst(p.ty, fun.tparams, targs));
    }
    out
}

// chk_call_func checks a call of a user function (or method called by
// path) with already instantiated type arguments.
fn chk_call_func(
    mut c: Chk,
    id: Int,
    pos: AstPos,
    fun: ChkFunc,
    targs: Vec<Ty>,
    args: Vec<AstExpr>,
) -> Ty {
    if fun.trait_name != "" {
        // `Trait::m(...)`: Self is inferred from the arguments
        let mi = chk_trait_call(
            c,
            pos,
            fun,
            targs.get(0).unwrap_or(ty_unit()),
            false,
            args,
            Vec::new(),
        );
        let mut ci = chk_call_info("trait", mi.recv_ty);
        ci.func = mi.func;
        ci.targs = mi.targs;
        ci.op = mi.op;
        c.info.calls.insert(id, ci);
        return mi.recv_ty;
    }
    if fun.handler || fun.main {
        chk_errorf(c, pos, "the entry point `" + fun.name + "` cannot be called directly");
    }
    chk_fn_bounds(c, fun.tparams, targs);
    let mut ps = Vec::new();
    for t in chk_param_types(fun, targs) {
        ps.push(chk_norm(c.info, t));
    }
    let mut paths = Vec::new();
    if c.info.path_fns.contains_key(fun.name) {
        paths = chk_call_paths(c, fun, args, pos);
        ps = chk_subst_paths(fun, ps, paths);
    }
    chk_check_grant(c, fun, pos);
    chk_args(c, pos, "`" + fun.name + "`", args, ps);
    chk_oblige_bounds(c, pos, fun, targs);
    chk_note_call(c, fun, pos);
    let mut result = chk_norm(c.info, ty_subst(fun.result, fun.tparams, targs));
    if paths.len() > 0 {
        result = ty_subst_paths(result, fun.name, paths);
    }
    let mut ci = chk_call_info("func", result);
    ci.func = Some(fun);
    ci.targs = targs;
    c.info.calls.insert(id, ci);
    result
}

fn chk_binary(c: Chk, e: AstBinary) -> Ty {
    let xt = chk_expr(c, e.x);
    let yt = chk_expr(c, e.y);
    let op = e.op;
    if op == "&&" || op == "||" {
        chk_expect(c, ast_expr_pos(e.x), xt, ty_bool(), "logical operator");
        chk_expect(c, ast_expr_pos(e.y), yt, ty_bool(), "logical operator");
        return ty_bool();
    }
    if op == "==" || op == "!=" {
        if !ty_unify(xt, yt) {
            let mut hint = chk_pii_hint(xt, yt);
            if hint == "" {
                hint = chk_pii_hint(yt, xt);
            }
            chk_errorf(
                c,
                e.pos,
                "cannot compare `" + ty_str(xt) + "` with `" + ty_str(yt) + "`" + hint,
            );
            return ty_bool();
        }
        let p = ty_prune(xt);
        if chk_is_labeled(p) {
            chk_errorf(
                c,
                e.pos,
                "cannot compare `"
                    + ty_str(xt)
                    + "` with `"
                    + op
                    + "`"
                    + chk_labeled_cmp_hint(xt, yt),
            );
            return ty_bool();
        }
        if !chk_builtin_eq(p) {
            // PartialEq::eq (resolved when lowered: a type variable may
            // still become a primitive)
            chk_binop_trait(c, e, "PartialEq", "eq", xt);
        }
        return ty_bool();
    }
    if op == "<" || op == "<=" || op == ">" || op == ">=" {
        if ty_is_prim(ty_prune(xt), "Int") || ty_is_prim(ty_prune(yt), "Int") {
            chk_expect(c, ast_expr_pos(e.x), xt, ty_int(), "comparison");
            chk_expect(c, ast_expr_pos(e.y), yt, ty_int(), "comparison");
            return ty_bool();
        }
        if !ty_unify(xt, yt) {
            chk_errorf(c, e.pos, "cannot compare `" + ty_str(xt) + "` with `" + ty_str(yt) + "`");
            return ty_bool();
        }
        let m = if op == "<" {
            "lt"
        } else if op == "<=" {
            "le"
        } else if op == ">" { "gt" } else { "ge" };
        chk_binop_trait(c, e, "PartialOrd", m, xt);
        return ty_bool();
    }
    if op == "+" {
        if ty_is_prim(ty_prune(xt), "String") || ty_is_prim(ty_prune(yt), "String") {
            chk_expect(c, ast_expr_pos(e.x), xt, ty_string(), "string concatenation");
            chk_expect(c, ast_expr_pos(e.y), yt, ty_string(), "string concatenation");
            return ty_string();
        }
    }
    let px = ty_prune(xt);
    match px {
        Ty::Param(_) => {
            chk_errorf(
                c,
                e.pos,
                "binary operation `" + op + "` cannot be applied to type `" + ty_str(px) + "`",
            );
            return ty_invalid();
        }
        _ => {}
    }
    chk_expect(c, ast_expr_pos(e.x), xt, ty_int(), "arithmetic");
    chk_expect(c, ast_expr_pos(e.y), yt, ty_int(), "arithmetic");
    ty_int()
}

// chk_builtin_eq reports the types whose `==` is a primitive operation.
fn chk_builtin_eq(t: Ty) -> Bool {
    ty_is_prim(t, "Int") || ty_is_prim(t, "Bool") || ty_is_prim(t, "String") || ty_is_prim(t, "()")
}

// chk_binop_trait records the binary operator e as a call of trait method
// tr::m on operands of type t.
fn chk_binop_trait(mut c: Chk, e: AstBinary, tr: String, m: String, t: Ty) {
    match c.info.funcs.get(tr + "::" + m) {
        Some(tf) => {
            chk_oblige(c, e.pos, tr, t, "binary operation `" + e.op + "`");
            c.info.binops.insert(e.id, ChkMethodInfo {
                kind: "trait",
                builtin: None,
                op: tr,
                recv_ty: t,
                closure: None,
                func: Some(tf),
                targs: chk_tys1(t),
            });
        }
        None => chk_errorf(
            c,
            e.pos,
            "binary operation `" + e.op + "` cannot be applied to type `" + ty_str(t) + "`",
        ),
    }
}

fn chk_args(c: Chk, pos: AstPos, what: String, args: Vec<AstExpr>, params: Vec<Ty>) {
    if args.len() != params.len() {
        chk_errorf(
            c,
            pos,
            what
                + " takes "
                + params.len().to_string()
                + " argument(s) but "
                + args.len().to_string()
                + " were supplied",
        );
    }
    let mut i = 0;
    for a in args {
        match params.get(i) {
            None => {
                chk_expr(c, a);
            }
            Some(p) => chk_arg(c, a, p, what),
        }
        i = i + 1;
    }
}

// chk_arg checks one argument; capability parameters accept only a
// capability variable (borrowing it for the duration of the call).
fn chk_arg(c: Chk, a0: AstExpr, want: Ty, what: String) {
    let a = chk_strip_ref(a0);
    match want {
        Ty::Cap(wk, _) => {
            match a {
                AstExpr::Ident(id) => {
                    let t = ty_prune(chk_expr_cap(c, a, true));
                    let mut ok = false;
                    match t {
                        Ty::Cap(gk, _) => {
                            ok = gk == wk;
                        }
                        _ => {}
                    }
                    if !ok {
                        chk_errorf(
                            c,
                            id.pos,
                            "mismatched types in argument of "
                                + what
                                + ": expected capability `"
                                + ty_str(want)
                                + "`, found `"
                                + ty_str(t)
                                + "`",
                        );
                    }
                }
                _ => {
                    chk_expr(c, a);
                    chk_errorf(
                        c,
                        ast_expr_pos(a),
                        "expected capability `" + ty_str(want) + "` as argument of " + what,
                    );
                }
            }
        }
        _ => {
            let t = chk_expr_expect(c, a, want);
            chk_expect(c, ast_expr_pos(a), t, want, "argument of " + what);
        }
    }
}

// chk_expr_expect checks e where a value of type want is expected (a
// closure takes its parameter types from it).
fn chk_expr_expect(c: Chk, e: AstExpr, want: Ty) -> Ty {
    match e {
        AstExpr::Closure(cl) => chk_closure(c, cl, Some(want)),
        _ => chk_expr(c, e),
    }
}

// chk_fn_sig returns the signature of a value of type t that can be
// called: a fn type, or a type param with an `Fn(...)` bound.
fn chk_fn_sig(t: Ty) -> Option<Ty> {
    match ty_prune(t) {
        Ty::Fn(ps, r) => Some(Ty::Fn(ps, r)),
        Ty::Param(p) => {
            for b in p.bounds {
                if b.trait_name == "Fn" {
                    return b.assoc_tys.get(0);
                }
            }
            None
        }
        _ => None,
    }
}

// chk_closure checks a closure expression; want is the expected type.
fn chk_closure(mut c: Chk, e: AstClosure, want: Option<Ty>) -> Ty {
    let mut exp_ps = Vec::new();
    let mut exp_r = None;
    match want {
        Some(w) => match chk_fn_sig(w) {
            Some(Ty::Fn(ps, r)) => {
                exp_ps = ps;
                exp_r = Some(r);
            }
            _ => {}
        },
        None => {}
    }
    let mut li = ChkLambdaInfo { id: e.id, params: Vec::new(), captures: Vec::new(), ty: ty_unit() };
    c.info.lambdas.insert(e.id, li);
    chk_push(c, false);
    match c.scopes.get(c.scopes.len() - 1) {
        Some(mut s) => {
            s.lambda = e.id;
        }
        None => {}
    }
    let mut ps = Vec::new();
    let mut i = 0;
    for p in e.params {
        let mut t = match exp_ps.get(i) {
            Some(x) => x,
            None => chk_new_var(c),
        };
        match p.ty {
            Some(te) => {
                let at = chk_resolve_type(c, te, true);
                if !ty_unify(at, t) {
                    chk_errorf(
                        c,
                        p.pos,
                        "mismatched closure parameter: expected `"
                            + ty_str(t)
                            + "`, found `"
                            + ty_str(at)
                            + "`",
                    );
                }
                t = at;
            }
            None => {}
        }
        if ty_is_cap(t) {
            chk_errorf(c, p.pos, "a closure cannot take a capability parameter");
        }
        let mut b = chk_new_binding(c, p.name, t, p.pos);
        b.param = true;
        li.params.push(b);
        chk_bind(c, b);
        ps.push(t);
        i = i + 1;
    }
    let mut arity_ok = true;
    if exp_ps.len() > 0 && exp_ps.len() != e.params.len() {
        chk_errorf(
            c,
            e.pos,
            "expected a closure that takes "
                + exp_ps.len().to_string()
                + " argument(s), but it takes "
                + e.params.len().to_string(),
        );
        arity_ok = false;
    }
    let mut r = match exp_r {
        Some(x) => x,
        None => chk_new_var(c),
    };
    match e.result {
        Some(te) => {
            let rt = chk_resolve_type(c, te, false);
            ty_unify(r, rt);
            r = rt;
        }
        None => {}
    }
    c.rets.push(ChkRet { ty: r, closure: None });
    let saved_loops = c.loops;
    c.loops = 0;
    let bt = chk_expr_expect(c, e.body, r);
    c.loops = saved_loops;
    c.rets.pop();
    chk_pop(c);
    if !ty_unify(bt, r) {
        chk_errorf(
            c,
            ast_expr_pos(e.body),
            "mismatched types in closure body: expected `"
                + ty_str(r)
                + "`, found `"
                + ty_str(bt)
                + "`",
        );
    }
    let ft = Ty::Fn(ps, r);
    li.ty = ft;
    if !arity_ok {
        chk_record(c, e.id, ft);
        return ty_invalid();
    }
    chk_record(c, e.id, ft)
}

// chk_fn_item is the value of a named function `f` (a function pointer).
fn chk_fn_item(mut c: Chk, e: AstIdent, fun: ChkFunc) -> Ty {
    if fun.handler || fun.main || fun.test {
        chk_errorf(c, e.pos, "the entry point `" + fun.name + "` cannot be used as a value");
    }
    if c.info.path_fns.contains_key(fun.name) {
        chk_errorf(
            c,
            e.pos,
            "`"
                + fun.name
                + "` takes a permission for one of its parameters and cannot be used as a value",
        );
    }
    let targs = chk_instantiate(c, fun.tparams);
    chk_turbofish(c, e.pos, fun, targs, e.targs);
    let mut ps = Vec::new();
    for t in chk_param_types(fun, targs) {
        if ty_is_cap(t) {
            chk_errorf(
                c,
                e.pos,
                "`"
                    + fun.name
                    + "` takes a capability and cannot be used as a value (functions as values are pure)",
            );
        }
        ps.push(chk_norm(c.info, t));
    }
    chk_fn_bounds(c, fun.tparams, targs);
    chk_oblige_bounds(c, e.pos, fun, targs);
    chk_note_call(c, fun, e.pos);
    let mut ci = chk_call_info("fnitem", ty_unit());
    ci.func = Some(fun);
    ci.targs = targs;
    c.info.calls.insert(e.id, ci);
    Ty::Fn(ps, chk_norm(c.info, ty_subst(fun.result, fun.tparams, targs)))
}

// chk_fn_bounds unifies each type argument whose param has an `Fn(...)`
// bound with that signature (before the arguments are checked, so that a
// closure argument gets its parameter types).
fn chk_fn_bounds(c: Chk, ps: Vec<TyParam>, targs: Vec<Ty>) {
    for i in 0..ps.len() {
        match ps.get(i) {
            Some(p) => {
                for b in p.bounds {
                    if b.trait_name == "Fn" {
                        match b.assoc_tys.get(0) {
                            Some(sig) => {
                                ty_unify(
                                    targs.get(i).unwrap_or(ty_unit()),
                                    ty_subst(sig, ps, targs),
                                );
                            }
                            None => {}
                        }
                    }
                }
            }
            None => {}
        }
    }
}

// chk_value_call checks `f(args)` where f is a value (a closure).
fn chk_value_call(mut c: Chk, e: AstCall, ft: Ty) -> Ty {
    match chk_fn_sig(ft) {
        Some(Ty::Fn(ps, r)) => {
            chk_args(c, e.pos, "closure", e.args, ps);
            let ci = chk_call_info("closure", ft);
            c.info.calls.insert(e.id, ci);
            r
        }
        _ => {
            if ty_is_var(ty_prune(ft)) {
                chk_errorf(c, e.pos, "type annotations needed: cannot call a value of unknown type");
            } else if !ty_is_prim(ty_prune(ft), "<invalid>") {
                chk_errorf(c, e.pos, "expected function, found `" + ty_str(ft) + "`");
            }
            chk_exprs(c, e.args);
            ty_invalid()
        }
    }
}

// chk_strip_ref drops `&`/`&mut` around an argument (a capability may be
// passed as `&log`).
fn chk_strip_ref(e: AstExpr) -> AstExpr {
    match e {
        AstExpr::Unary(u) => {
            if u.op == "&" || u.op == "&mut " {
                return chk_strip_ref(u.x);
            }
            e
        }
        _ => e,
    }
}

fn chk_exprs(c: Chk, args: Vec<AstExpr>) {
    for a in args {
        chk_expr(c, a);
    }
}

fn chk_call(mut c: Chk, e: AstCall) -> Ty {
    match e.func {
        AstExpr::Ident(f) => {
            if f.name == "Ok" || f.name == "Err" || f.name == "Some" {
                if chk_lookup(c, f.name, f.pos).is_none() && !c.info.funcs.contains_key(f.name) {
                    let mut arg = chk_new_var(c);
                    if e.args.len() != 1 {
                        chk_errorf(c, e.pos, "`" + f.name + "` takes exactly one argument");
                        chk_exprs(c, e.args);
                    } else {
                        match e.args.get(0) {
                            Some(a) => {
                                arg = chk_expr(c, a);
                            }
                            None => {}
                        }
                    }
                    let mut ci = chk_call_info("some", ty_unit());
                    if f.name == "Ok" {
                        ci.kind = "ok";
                        ci.ty = Ty::Result(arg, chk_new_var(c));
                    } else if f.name == "Err" {
                        ci.kind = "err";
                        ci.ty = Ty::Result(chk_new_var(c), arg);
                    } else {
                        ci.ty = Ty::Option(arg);
                    }
                    c.info.calls.insert(e.id, ci);
                    return ci.ty;
                }
            }
            // a local variable (a closure) shadows a function
            if chk_lookup(c, f.name, f.pos).is_some() {
                let ft = chk_expr(c, e.func);
                return chk_value_call(c, e, ft);
            }
            match c.info.funcs.get(f.name) {
                None => {
                    chk_errorf(c, f.pos, "cannot find function `" + f.name + "`");
                    chk_exprs(c, e.args);
                    ty_invalid()
                }
                Some(fun) => {
                    let targs = chk_instantiate(c, fun.tparams);
                    chk_turbofish(c, f.pos, fun, targs, f.targs);
                    chk_call_func(c, e.id, e.pos, fun, targs, e.args)
                }
            }
        }
        AstExpr::Path(p) => chk_path(c, p, Some(e)),
        _ => {
            let ft = chk_expr(c, e.func);
            chk_value_call(c, e, ft)
        }
    }
}

// chk_path checks `Type::Name` (call is Some when applied to args).
fn chk_path(mut c: Chk, p: AstPathExpr, call: Option<AstCall>) -> Ty {
    let mut key = p.id;
    let mut args = Vec::new();
    let mut pos = p.pos;
    let mut is_call = false;
    match call {
        Some(ce) => {
            key = ce.id;
            args = ce.args;
            pos = ce.pos;
            is_call = true;
        }
        None => {}
    }
    // `Self::...` inside an impl names the impl's type
    let mut tyname = p.ty;
    let mut self_ty = None;
    if p.ty == "Self" {
        match c.tscope.get("Self") {
            Some(t) => {
                self_ty = Some(t);
                tyname = chk_impl_type_name(c, t, true);
                if tyname == "" {
                    tyname = chk_recv_name(t);
                }
            }
            None => {
                chk_errorf(c, p.pos, "`Self` is only available in `impl` blocks");
                chk_exprs(c, args);
                return ty_invalid();
            }
        }
    }
    let mut ty_args = Vec::new();
    for a in p.ty_args {
        ty_args.push(chk_resolve_type(c, a, false));
    }
    match c.info.enums.get(tyname) {
        Some(en) => {
            let eargs = match self_ty {
                Some(t) => match ty_prune(t) {
                    Ty::Enum(_, a) => a,
                    _ => chk_instantiate(c, en.params),
                },
                None => chk_instantiate(c, en.params),
            };
            if ty_args.len() > 0 && !ty_unify_all(eargs, ty_args) {
                chk_errorf(
                    c,
                    p.pos,
                    "`"
                        + en.name
                        + "` takes "
                        + en.params.len().to_string()
                        + " generic argument(s) but "
                        + ty_args.len().to_string()
                        + " were supplied",
                );
            }
            let ety = Ty::Enum(en, eargs);
            let mut tag = 0;
            for v in en.variants {
                if v.name == p.name {
                    if !is_call && v.fields.len() > 0 {
                        chk_errorf(
                            c,
                            p.pos,
                            "variant `"
                                + en.name
                                + "::"
                                + v.name
                                + "` takes "
                                + v.fields.len().to_string()
                                + " argument(s)",
                        );
                    }
                    chk_no_turbofish(c, p.pos, "a variant", p.targs);
                    chk_args(
                        c,
                        pos,
                        "`" + en.name + "::" + v.name + "`",
                        args,
                        ty_variant_fields(en, eargs, v),
                    );
                    let mut ci = chk_call_info("variant", ety);
                    ci.enm = Some(en);
                    ci.tag = tag;
                    c.info.calls.insert(key, ci);
                    return ety;
                }
                tag = tag + 1;
            }
            match c.info.funcs.get(tyname + "::" + p.name) {
                Some(_) => {}
                None => {
                    chk_errorf(c, p.pos, "no variant `" + p.name + "` in enum `" + en.name + "`");
                    chk_exprs(c, args);
                    return ty_invalid();
                }
            }
        }
        None => {}
    }
    match c.info.funcs.get(tyname + "::" + p.name) {
        Some(fun) => {
            if !is_call {
                chk_errorf(
                    c,
                    p.pos,
                    "`" + p.ty + "::" + p.name + "` is a function; call it with `()`",
                );
            }
            let targs = chk_instantiate(c, fun.tparams);
            chk_turbofish(c, p.pos, fun, targs, p.targs);
            // the impl's type, instantiated, must match `Self` or the
            // explicit type arguments
            match fun.tscope.get("Self") {
                Some(st) => {
                    let inst = ty_subst(st, fun.tparams, targs);
                    match self_ty {
                        Some(t) => {
                            ty_unify(inst, t);
                        }
                        None => {}
                    }
                    if ty_args.len() > 0 {
                        let want = match ty_prune(inst) {
                            Ty::Struct(s, _) => Ty::Struct(s, ty_args),
                            Ty::Enum(en, _) => Ty::Enum(en, ty_args),
                            _ => inst,
                        };
                        if !ty_unify(inst, want) {
                            chk_errorf(
                                c,
                                p.pos,
                                "mismatched generic arguments: `"
                                    + ty_str(want)
                                    + "` has no method `"
                                    + p.name
                                    + "`",
                            );
                        }
                    }
                }
                None => {}
            }
            return chk_call_func(c, key, pos, fun, targs, args);
        }
        None => {}
    }
    // a trait's associated function through a type: `T::default()`,
    // `Point::default()`
    match chk_path_type(c, p.ty, self_ty, ty_args) {
        Some(pt) => {
            let ts = chk_traits_with_method(c, pt, p.name);
            match ts.get(0) {
                Some(tn) => match c.info.funcs.get(tn + "::" + p.name) {
                    Some(tf) => {
                        if !is_call {
                            chk_errorf(
                                c,
                                p.pos,
                                "`" + p.ty + "::" + p.name + "` is a function; call it with `()`",
                            );
                        }
                        let mi = chk_trait_call(c, pos, tf, pt, false, args, p.targs);
                        let mut ci = chk_call_info("trait", mi.recv_ty);
                        ci.func = mi.func;
                        ci.targs = mi.targs;
                        ci.op = mi.op;
                        c.info.calls.insert(key, ci);
                        return mi.recv_ty;
                    }
                    None => {}
                },
                None => {}
            }
        }
        None => {}
    }
    if p.ty == "Vec" && p.name == "new" {
        if !is_call {
            chk_errorf(c, p.pos, "`Vec::new` is a function; call it with `()`");
        }
        chk_no_turbofish(c, p.pos, "`Vec::new`", p.targs);
        chk_args(c, pos, "`Vec::new`", args, Vec::new());
        let t = Ty::Vec(chk_new_var(c));
        if ty_args.len() > 0 {
            if ty_args.len() != 1 || !ty_unify(t, Ty::Vec(ty_args.get(0).unwrap_or(ty_unit()))) {
                chk_errorf(c, p.pos, "`Vec` takes 1 generic argument(s)");
            }
        }
        let mut ci = chk_call_info("collection", t);
        ci.op = chk_lower_first(p.ty) + ".new";
        c.info.calls.insert(key, ci);
        return t;
    }
    match c.builtins.statics.get(p.ty + "::" + p.name) {
        Some(b) => {
            if !is_call {
                chk_errorf(
                    c,
                    p.pos,
                    "`" + p.ty + "::" + p.name + "` is a function; call it with `()`",
                );
            }
            chk_args(c, pos, "`" + p.ty + "::" + p.name + "`", args, b.params);
            let mut ci = chk_call_info("static", b.result);
            ci.builtin = Some(b);
            c.info.calls.insert(key, ci);
            return b.result;
        }
        None => {}
    }
    chk_errorf(c, p.pos, "cannot find `" + p.ty + "::" + p.name + "`");
    chk_exprs(c, args);
    ty_invalid()
}

// chk_path_type is the type named by the first part of a path `T::f`
// (None when it names no type, e.g. a trait).
fn chk_path_type(c: Chk, name: String, self_ty: Option<Ty>, ty_args: Vec<Ty>) -> Option<Ty> {
    match self_ty {
        Some(t) => {
            return Some(t);
        }
        None => {}
    }
    match c.tscope.get(name) {
        Some(t) => {
            return Some(t);
        }
        None => {}
    }
    match c.info.structs.get(name) {
        Some(st) => {
            let args = if ty_args.len() > 0 {
                ty_args
            } else {
                chk_instantiate(c, st.params)
            };
            return Some(Ty::Struct(st, args));
        }
        None => {}
    }
    match c.info.enums.get(name) {
        Some(en) => {
            let args = if ty_args.len() > 0 {
                ty_args
            } else {
                chk_instantiate(c, en.params)
            };
            return Some(Ty::Enum(en, args));
        }
        None => {}
    }
    if name == "Int" || name == "Bool" || name == "String" {
        return Some(Ty::Prim(name));
    }
    None
}

fn chk_recv_name(t: Ty) -> String {
    match ty_prune(t) {
        Ty::Prim(n) => n,
        Ty::Opaque(n) => n,
        Ty::Cap(k, _) => k,
        Ty::Struct(s, _) => s.name,
        Ty::Enum(e, _) => e.name,
        Ty::Param(p) => p.name,
        Ty::Result(_, _) => "Result",
        Ty::Option(_) => "Option",
        Ty::Vec(_) => "Vec",
        Ty::Tuple(_) => "Tuple",
        Ty::Assoc(_, _, n) => n,
        Ty::Fn(_, _) => "fn",
        Ty::Var(_) => "?",
    }
}

fn chk_method(mut c: Chk, e: AstMethodCall) -> Ty {
    let rt = ty_prune(chk_expr_cap(c, e.recv, true));
    if ty_is_prim(rt, "<invalid>") {
        chk_exprs(c, e.args);
        return ty_invalid();
    }
    let mut is_cap = false;
    let mut borrowed = false;
    match rt {
        Ty::Cap(k, br) => {
            is_cap = true;
            borrowed = br;
            match e.recv {
                AstExpr::Ident(_) => {}
                _ => chk_errorf(c, e.pos, "capability receiver must be a variable"),
            }
            if k == "Db" && e.name == "transaction" {
                return chk_transaction(c, e);
            }
        }
        _ => {}
    }
    if !is_cap {
        match c.info.funcs.get(chk_recv_name(rt) + "::" + e.name) {
            Some(fun) => {
                if fun.decl.self_kind != "" {
                    return chk_user_method(c, e, rt, fun);
                }
            }
            None => {}
        }
    }
    match rt {
        Ty::Result(_, _) => {
            return chk_generic_method(c, e, rt);
        }
        Ty::Option(_) => {
            return chk_generic_method(c, e, rt);
        }
        Ty::Vec(_) => {
            return chk_generic_method(c, e, rt);
        }
        Ty::Var(_) => {
            chk_errorf(
                c,
                e.pos,
                "type annotations needed: cannot call method `"
                    + e.name
                    + "` on a value of unknown type",
            );
            chk_exprs(c, e.args);
            return ty_invalid();
        }
        _ => {}
    }
    let name = chk_recv_name(rt);
    match c.builtins.methods.get(name + "." + e.name) {
        None => {
            if !is_cap {
                match chk_trait_method(c, e, rt) {
                    Some(t) => {
                        return t;
                    }
                    None => {}
                }
            }
            chk_errorf(
                c,
                e.pos,
                "no method named `"
                    + e.name
                    + "` found for `"
                    + ty_str(rt)
                    + "`"
                    + chk_pii_hint(rt, ty_unit()),
            );
            chk_exprs(c, e.args);
            ty_invalid()
        }
        Some(b) => {
            if b.consumes && is_cap && borrowed {
                chk_errorf(
                    c,
                    e.pos,
                    "cannot call `"
                        + e.name
                        + "` on a borrowed transaction `&Tx`: only the `transaction` block that owns the `Tx` can end it",
                );
            }
            let what = "`" + name + "." + e.name + "`";
            chk_args(c, e.pos, what, e.args, b.params);
            if is_cap {
                if !c.cur.effects.contains_key(b.op) {
                    c.cur.effect_pos.insert(b.op, e.pos);
                }
                c.cur.effects.insert(b.op, true);
            }
            chk_no_turbofish(c, e.pos, what, e.targs);
            c.info.methods.insert(e.id, ChkMethodInfo {
                kind: "builtin",
                builtin: Some(b),
                op: "",
                recv_ty: rt,
                closure: None,
                func: None,
                targs: Vec::new(),
            });
            b.result
        }
    }
}

// chk_user_method checks a call of a method defined in an `impl`.
fn chk_user_method(mut c: Chk, e: AstMethodCall, rt: Ty, fun: ChkFunc) -> Ty {
    let targs = chk_instantiate(c, fun.tparams);
    chk_turbofish(c, e.pos, fun, targs, e.targs);
    chk_fn_bounds(c, fun.tparams, targs);
    let mut ps = Vec::new();
    for t in chk_param_types(fun, targs) {
        ps.push(chk_norm(c.info, t));
    }
    let mut paths = Vec::new();
    if c.info.path_fns.contains_key(fun.name) {
        let mut all = Vec::new();
        all.push(e.recv);
        for a in e.args {
            all.push(a);
        }
        paths = chk_call_paths(c, fun, all, e.pos);
        ps = chk_subst_paths(fun, ps, paths);
    }
    let self_t = ps.get(0).unwrap_or(ty_unit());
    if !ty_unify(self_t, rt) {
        chk_errorf(
            c,
            e.pos,
            "no method named `"
                + e.name
                + "` found for `"
                + ty_str(rt)
                + "` (it is defined for `"
                + ty_str(ty_resolve(self_t))
                + "`)",
        );
    }
    let mut rest = Vec::new();
    for i in 1..ps.len() {
        rest.push(ps.get(i).unwrap_or(ty_unit()));
    }
    chk_args(c, e.pos, "`" + fun.name + "`", e.args, rest);
    chk_oblige_bounds(c, e.pos, fun, targs);
    chk_note_call(c, fun, e.pos);
    c.info.methods.insert(e.id, ChkMethodInfo {
        kind: "func",
        builtin: None,
        op: "",
        recv_ty: rt,
        closure: None,
        func: Some(fun),
        targs: targs,
    });
    let mut result = chk_norm(c.info, ty_subst(fun.result, fun.tparams, targs));
    if paths.len() > 0 {
        result = ty_subst_paths(result, fun.name, paths);
    }
    result
}

// chk_trait_method checks `recv.m(args)` resolved through a trait (rt
// implements it). Returns None when no trait has such a method.
fn chk_trait_method(mut c: Chk, e: AstMethodCall, rt: Ty) -> Option<Ty> {
    let ts = chk_traits_with_method(c, rt, e.name);
    if ts.len() == 0 {
        return None;
    }
    if ts.len() > 1 {
        chk_errorf(
            c,
            e.pos,
            "multiple applicable items in scope: `"
                + e.name
                + "` is defined in traits "
                + ts.join(", "),
        );
    }
    let tf = match c.info.funcs.get(ts.get(0).unwrap_or("") + "::" + e.name) {
        Some(f) => f,
        None => {
            return None;
        }
    };
    if tf.decl.self_kind == "" {
        chk_errorf(
            c,
            e.pos,
            "`"
                + e.name
                + "` is an associated function, not a method: call it as `"
                + tf.name
                + "(...)`",
        );
    }
    let mut mi = chk_trait_call(c, e.pos, tf, rt, true, e.args, e.targs);
    let result = mi.recv_ty;
    mi.recv_ty = rt;
    c.info.methods.insert(e.id, mi);
    Some(result)
}

fn chk_generic_method(mut c: Chk, e: AstMethodCall, rt: Ty) -> Ty {
    chk_no_turbofish(c, e.pos, "`" + e.name + "`", e.targs);
    let mut mi = ChkMethodInfo {
        kind: "generic",
        builtin: None,
        op: e.name,
        recv_ty: rt,
        closure: None,
        func: None,
        targs: Vec::new(),
    };
    let mut result = ty_unit();
    let mut found = false;
    let n = e.name;
    match rt {
        Ty::Result(ok, _) => {
            if n == "is_ok" || n == "is_err" {
                chk_args(c, e.pos, "`" + n + "`", e.args, Vec::new());
                result = ty_bool();
                found = true;
            } else if n == "unwrap_or" {
                chk_args(c, e.pos, "`unwrap_or`", e.args, chk_tys1(ok));
                result = ok;
                found = true;
            }
        }
        Ty::Option(el) => {
            if n == "is_some" || n == "is_none" {
                chk_args(c, e.pos, "`" + n + "`", e.args, Vec::new());
                result = ty_bool();
                found = true;
            } else if n == "unwrap_or" {
                chk_args(c, e.pos, "`unwrap_or`", e.args, chk_tys1(el));
                result = el;
                found = true;
            }
        }
        Ty::Vec(el) => {
            mi.op = "vec." + n;
            let mut params = Vec::new();
            found = true;
            if n == "push" {
                params = chk_tys1(el);
                result = ty_unit();
            } else if n == "get" {
                params = chk_tys1(ty_int());
                result = Ty::Option(el);
            } else if n == "set" {
                params = chk_tys2(ty_int(), el);
                result = ty_bool();
            } else if n == "len" {
                result = ty_int();
            } else if n == "pop" {
                result = Ty::Option(el);
            } else if n == "join" {
                if !ty_unify(el, ty_string()) {
                    chk_errorf(
                        c,
                        e.pos,
                        "`join` requires `Vec<String>`, found `" + ty_str(rt) + "`",
                    );
                }
                params = chk_tys1(ty_string());
                result = ty_string();
            } else {
                found = false;
            }
            if found {
                chk_args(c, e.pos, "`Vec." + n + "`", e.args, params);
            }
        }
        _ => {}
    }
    if !found {
        match chk_trait_method(c, e, rt) {
            Some(t) => {
                return t;
            }
            None => {}
        }
        chk_errorf(c, e.pos, "no method named `" + n + "` found for `" + ty_str(rt) + "`");
        chk_exprs(c, e.args);
        return ty_invalid();
    }
    c.info.methods.insert(e.id, mi);
    result
}

fn chk_transaction(mut c: Chk, e: AstMethodCall) -> Ty {
    if !c.cur.effects.contains_key("db.transaction") {
        c.cur.effect_pos.insert("db.transaction", e.pos);
    }
    c.cur.effects.insert("db.transaction", true);
    if e.args.len() != 1 {
        chk_errorf(c, e.pos, "`transaction` takes exactly one closure argument `|tx| { ... }`");
        chk_exprs(c, e.args);
        return ty_invalid();
    }
    let a0 = e.args.get(0).unwrap_or(AstExpr::UnitLit(AstUnitLit { id: 0, pos: e.pos }));
    let mut ocl = None;
    match a0 {
        AstExpr::Closure(cl) => {
            if cl.params.len() == 1 {
                ocl = Some(cl);
            }
        }
        _ => {}
    }
    match ocl {
        None => {
            chk_errorf(
                c,
                ast_expr_pos(a0),
                "`transaction` expects a closure with one parameter: `|tx| { ... }`",
            );
            chk_expr(c, a0);
            ty_invalid()
        }
        Some(cl) => {
            let p0 = cl.params.get(0).unwrap_or(AstParam {
                id: 0,
                pos: cl.pos,
                mutable: false,
                name: "",
                ty: None,
            });
            let tx_type = Ty::Cap("Tx", false);
            match p0.ty {
                Some(pt) => {
                    let t = chk_resolve_type(c, pt, true);
                    if !ty_identical(t, tx_type) {
                        chk_errorf(
                            c,
                            p0.pos,
                            "the transaction parameter has type `Tx`, found `" + ty_str(t) + "`",
                        );
                    }
                }
                None => {}
            }
            let tx = chk_new_binding(c, p0.name, tx_type, p0.pos);
            let rv = chk_new_var(c);
            let result = Ty::Result(rv, chk_new_var(c));
            let ci = ChkClosureInfo { tx: tx, result: result };
            c.info.closures.insert(cl.id, ci);
            chk_push(c, true);
            chk_bind(c, tx);
            c.rets.push(ChkRet { ty: result, closure: Some(ci) });
            let saved_loops = c.loops;
            c.loops = 0;
            let bt = chk_expr_cap(c, cl.body, false);
            c.loops = saved_loops;
            c.rets.pop();
            chk_pop(c);
            if !ty_unify(bt, result) {
                chk_errorf(
                    c,
                    ast_expr_pos(cl.body),
                    "a transaction body must evaluate to a `Result` (usually `tx.commit()`), found `"
                        + ty_str(bt)
                        + "`",
                );
            }
            c.info.types.insert(cl.id, result);
            c.info.methods.insert(e.id, ChkMethodInfo {
                kind: "transaction",
                builtin: None,
                op: "",
                recv_ty: ty_unit(),
                closure: Some(ci),
                func: None,
                targs: Vec::new(),
            });
            result
        }
    }
}

fn chk_try(mut c: Chk, e: AstTry) -> Ty {
    let t = ty_prune(chk_expr(c, e.x));
    if ty_is_prim(t, "<invalid>") {
        return ty_invalid();
    }
    let rc = chk_top_ret(c);
    let mut target = ty_prune(rc.ty);
    c.info.tries.insert(e.id, ChkTryInfo { closure: rc.closure, target: rc.ty });
    match t {
        Ty::Result(tok, terr) => {
            if ty_is_var(target) {
                let a = chk_new_var(c);
                ty_unify(target, Ty::Result(a, chk_new_var(c)));
                target = ty_prune(target);
            }
            match target {
                Ty::Result(_, rerr) => {
                    if !ty_unify(terr, rerr) {
                        let s1 = ty_str(ty_resolve(terr));
                        chk_errorf(
                            c,
                            e.pos,
                            "`?` cannot convert the error type `"
                                + s1
                                + "` into `"
                                + ty_str(ty_resolve(rerr))
                                + "`",
                        );
                    }
                    tok
                }
                _ => {
                    chk_errorf(
                        c,
                        e.pos,
                        "the `?` operator can only be used on `Result` in a function that returns `Result` (this returns `"
                            + ty_str(target)
                            + "`)",
                    );
                    tok
                }
            }
        }
        Ty::Option(el) => {
            match target {
                Ty::Option(_) => {}
                _ => chk_errorf(
                    c,
                    e.pos,
                    "the `?` operator can only be used on `Option` in a function that returns `Option` (this returns `"
                        + ty_str(target)
                        + "`)",
                ),
            }
            el
        }
        Ty::Var(_) => {
            chk_errorf(c, e.pos, "type annotations needed for `?`");
            ty_invalid()
        }
        _ => {
            chk_errorf(
                c,
                e.pos,
                "the `?` operator can only be applied to `Result` or `Option`, found `"
                    + ty_str(t)
                    + "`",
            );
            ty_invalid()
        }
    }
}

// ---- async analysis ----

// chk_trait_impl_index maps each trait method `Tr::m` to the program's
// functions implementing it (`<T as Tr>::m`, `<T as Tr<A>>::m`); the core
// library's are left out (they take no capabilities).
fn chk_trait_impl_index(c: Chk) -> HashMap<String, Vec<ChkFunc>> {
    let mut idx: HashMap<String, Vec<ChkFunc>> = HashMap::new();
    for fun in c.info.func_list {
        if !fun.name.starts_with("<") || chk_is_lib(fun) {
            continue;
        }
        let close = match fun.name.index_of(">::") {
            Some(i) => i,
            None => {
                continue;
            }
        };
        let head = fun.name.slice(1, close);
        let at = match head.index_of(" as ") {
            Some(i) => i,
            None => {
                continue;
            }
        };
        let mut tr = head.slice(at + 4, head.len());
        match tr.index_of("<") {
            Some(i) => {
                tr = tr.slice(0, i);
            }
            None => {}
        }
        let key = tr + "::" + fun.name.slice(close + 3, fun.name.len());
        match idx.get(key) {
            Some(mut v) => v.push(fun),
            None => {
                let mut v = Vec::new();
                v.push(fun);
                idx.insert(key, v);
            }
        }
    }
    idx
}

// chk_note_trait_call records a call through trait method tf: any of the
// program's implementations of it may run, so all are callees (for async,
// effects, idempotency and `kek caps`).
fn chk_note_trait_call(mut c: Chk, tf: ChkFunc, pos: AstPos) {
    chk_note_call(c, tf, pos);
    let idx = match c.impl_idx {
        Some(m) => m,
        None => {
            let m = chk_trait_impl_index(c);
            c.impl_idx = Some(m);
            m
        }
    };
    for g in idx.get(tf.name).unwrap_or(Vec::new()) {
        c.cur.calls.insert(g.name, true);
    }
}

fn chk_compute_async(c: Chk) {
    let mut async_ops: HashMap<String, Bool> = HashMap::new();
    async_ops.insert("db.transaction", true);
    for b in c.builtins.all {
        if b.async {
            async_ops.insert(b.op, true);
        }
    }
    for mut fun in c.info.func_list {
        // Entry points are state machines driven by the host.
        fun.async = fun.handler || fun.main;
        for op in fun.effects.keys() {
            if async_ops.contains_key(op) {
                fun.async = true;
            }
        }
    }
    let mut changed = true;
    while changed {
        changed = false;
        for mut fun in c.info.func_list {
            if fun.async {
                continue;
            }
            for callee in fun.calls.keys() {
                match c.info.funcs.get(callee) {
                    Some(g) => {
                        if g.async {
                            fun.async = true;
                            changed = true;
                            break;
                        }
                    }
                    None => {}
                }
            }
        }
    }
}
