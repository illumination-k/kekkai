// Match checking and nested-pattern exhaustiveness (Maranget's usefulness
// algorithm).

struct ChkCtors {
    mut finite: Bool,
    names: Vec<String>,
    fields: Vec<Vec<Ty>>,
}

struct ChkTag {
    tag: Int,
    refutable: Bool,
}

fn chk_match(c: Chk, e: AstMatch) -> Ty {
    let mut st = ty_prune(chk_expr(c, e.x));
    if ty_is_prim(st, "<invalid>") {
        st = chk_new_var(c);
    }
    if ty_is_var(st) {
        chk_errorf(c, e.pos, "type annotations needed for match scrutinee");
        return ty_invalid();
    }
    let mut result = ty_never();
    let mut rows: Vec<Vec<AstPattern>> = Vec::new();
    for arm in e.arms {
        chk_push(c, false);
        chk_pattern(c, arm.pat, st);
        if rows.len() > 0 && chk_exhaustive(c.info, rows, chk_tys1(st)) {
            chk_errorf(c, arm.pos, "unreachable pattern");
        }
        match arm.guard {
            Some(g) => {
                // a guarded arm does not count toward exhaustiveness
                let gt = chk_expr(c, g);
                chk_expect(c, ast_expr_pos(g), gt, ty_bool(), "match guard");
            }
            None => {
                let mut row = Vec::new();
                row.push(arm.pat);
                rows.push(row);
            }
        }
        let at = chk_expr(c, arm.body);
        if !ty_unify(result, at) {
            let s1 = ty_str(ty_resolve(result));
            chk_errorf(
                c,
                ast_expr_pos(arm.body),
                "match arms have incompatible types: expected `"
                    + s1
                    + "`, found `"
                    + ty_str(ty_resolve(at))
                    + "`",
            );
        }
        result = ty_join(result, at);
        chk_pop(c);
    }
    if !chk_exhaustive(c.info, rows, chk_tys1(st)) {
        let s1 = ty_str(ty_resolve(st));
        chk_errorf(
            c,
            e.pos,
            "non-exhaustive patterns in match on `" + s1 + "`" + chk_missing(c.info, rows, st),
        );
    }
    result
}

// chk_ctors returns the constructor names and field types of a finite
// type (finite is false for Int, String, ...).
fn chk_ctors(t: Ty) -> ChkCtors {
    let mut out = ChkCtors { finite: true, names: Vec::new(), fields: Vec::new() };
    match ty_prune(t) {
        Ty::Result(ok, err) => {
            out.names.push("Ok(_)");
            out.names.push("Err(_)");
            out.fields.push(chk_tys1(ok));
            out.fields.push(chk_tys1(err));
        }
        Ty::Option(el) => {
            out.names.push("None");
            out.names.push("Some(_)");
            out.fields.push(Vec::new());
            out.fields.push(chk_tys1(el));
        }
        Ty::Enum(en, args) => {
            for v in en.variants {
                let mut n = en.name + "::" + v.name;
                if v.fields.len() > 0 {
                    n = n + "(..)";
                }
                out.names.push(n);
                out.fields.push(ty_variant_fields(en, args, v));
            }
        }
        Ty::Tuple(ts) => {
            out.names.push("(..)");
            out.fields.push(ts);
        }
        Ty::Prim(n) => {
            if n == "Bool" {
                out.names.push("false");
                out.names.push("true");
                out.fields.push(Vec::new());
                out.fields.push(Vec::new());
            } else {
                out.finite = false;
            }
        }
        _ => {
            out.finite = false;
        }
    }
    out
}

// chk_pat_tag: refutable with the tag if p tests a constructor (or bool
// literal); other literal patterns have tag -1.
fn chk_pat_tag(info: ChkInfo, p: AstPattern) -> ChkTag {
    match info.patterns.get(p.id) {
        None => ChkTag { tag: 0, refutable: false },
        Some(pi) => {
            if pi.kind == "ctor" || pi.kind == "tuple" {
                return ChkTag { tag: pi.tag, refutable: true };
            }
            if pi.kind == "bool" {
                if p.bool_lit.unwrap_or(false) {
                    return ChkTag { tag: 1, refutable: true };
                }
                return ChkTag { tag: 0, refutable: true };
            }
            if pi.kind == "int" || pi.kind == "string" || pi.kind == "range" {
                return ChkTag { tag: -1, refutable: true };
            }
            if pi.kind == "at" {
                match pi.args.get(0) {
                    Some(sub) => {
                        return chk_pat_tag(info, sub);
                    }
                    None => {}
                }
            }
            if pi.kind == "or" {
                // expanded by chk_expand_rows before it is specialized
                return ChkTag { tag: -2, refutable: true };
            }
            ChkTag { tag: 0, refutable: false }
        }
    }
}

fn chk_wild_pat() -> AstPattern {
    let mut p = ast_new_pattern(-1, chk_dummy_pos());
    p.wildcard = true;
    p
}

fn chk_pat_at(r: Vec<AstPattern>, i: Int) -> AstPattern {
    match r.get(i) {
        Some(p) => p,
        None => chk_wild_pat(),
    }
}

// chk_append_rest returns out ++ r[1:].
fn chk_append_rest(mut out: Vec<AstPattern>, r: Vec<AstPattern>) -> Vec<AstPattern> {
    for i in 1..r.len() {
        out.push(chk_pat_at(r, i));
    }
    out
}

fn chk_pat_args(info: ChkInfo, p: AstPattern) -> Vec<AstPattern> {
    match info.patterns.get(p.id) {
        Some(pi) => pi.args,
        None => Vec::new(),
    }
}

// chk_expand_rows replaces a leading `x @ p` by p and splits a row whose
// first pattern is an or-pattern into one row per alternative.
fn chk_expand_rows(info: ChkInfo, rows: Vec<Vec<AstPattern>>) -> Vec<Vec<AstPattern>> {
    let mut out = Vec::new();
    for r in rows {
        chk_expand_row(info, r, out);
    }
    out
}

fn chk_expand_row(info: ChkInfo, r: Vec<AstPattern>, mut out: Vec<Vec<AstPattern>>) {
    if r.len() > 0 {
        match info.patterns.get(chk_pat_at(r, 0).id) {
            Some(pi) => {
                if pi.kind == "at" || pi.kind == "or" {
                    for a in pi.args {
                        let mut row = Vec::new();
                        row.push(a);
                        chk_expand_row(info, chk_append_rest(row, r), out);
                    }
                    return;
                }
            }
            None => {}
        }
    }
    out.push(r);
}

// chk_exhaustive reports whether the pattern matrix covers every value of
// the column types.
fn chk_exhaustive(info: ChkInfo, rows0: Vec<Vec<AstPattern>>, tys: Vec<Ty>) -> Bool {
    let rows = chk_expand_rows(info, rows0);
    if tys.len() == 0 {
        return rows.len() > 0;
    }
    // A row of irrefutable patterns covers everything. Checking this first
    // also guarantees termination on recursive types.
    for r in rows {
        let mut all = true;
        for p in r {
            if chk_pat_tag(info, p).refutable {
                all = false;
                break;
            }
        }
        if all {
            return true;
        }
    }
    let t0 = chk_ty_at(tys, 0);
    let mut rest_tys = Vec::new();
    for i in 1..tys.len() {
        rest_tys.push(chk_ty_at(tys, i));
    }
    let cs = chk_ctors(t0);
    if !cs.finite {
        let mut def: Vec<Vec<AstPattern>> = Vec::new();
        for r in rows {
            if !chk_pat_tag(info, chk_pat_at(r, 0)).refutable {
                def.push(chk_append_rest(Vec::new(), r));
            }
        }
        return chk_exhaustive(info, def, rest_tys);
    }
    for tag in 0..cs.names.len() {
        let fields = cs.fields.get(tag).unwrap_or(Vec::new());
        let mut spec: Vec<Vec<AstPattern>> = Vec::new();
        for r in rows {
            let pt = chk_pat_tag(info, chk_pat_at(r, 0));
            if !pt.refutable {
                let mut row = Vec::new();
                for f in fields {
                    row.push(chk_wild_pat());
                }
                spec.push(chk_append_rest(row, r));
            } else if pt.tag == tag {
                let args = chk_pat_args(info, chk_pat_at(r, 0));
                if args.len() == fields.len() {
                    let mut row = Vec::new();
                    for a in args {
                        row.push(a);
                    }
                    spec.push(chk_append_rest(row, r));
                }
            }
        }
        let mut tys2 = Vec::new();
        for f in fields {
            tys2.push(f);
        }
        for t in rest_tys {
            tys2.push(t);
        }
        if !chk_exhaustive(info, spec, tys2) {
            return false;
        }
    }
    true
}

// chk_missing names the top-level constructors that are not fully covered.
fn chk_missing(info: ChkInfo, rows0: Vec<Vec<AstPattern>>, t: Ty) -> String {
    let rows = chk_expand_rows(info, rows0);
    let cs = chk_ctors(t);
    if !cs.finite {
        return ": add a `_` arm";
    }
    let mut miss = Vec::new();
    for tag in 0..cs.names.len() {
        let fields = cs.fields.get(tag).unwrap_or(Vec::new());
        let mut spec: Vec<Vec<AstPattern>> = Vec::new();
        for r in rows {
            let pt = chk_pat_tag(info, chk_pat_at(r, 0));
            if !pt.refutable {
                let mut row = Vec::new();
                for f in fields {
                    row.push(chk_wild_pat());
                }
                spec.push(row);
            } else if pt.tag == tag {
                let args = chk_pat_args(info, chk_pat_at(r, 0));
                if args.len() == fields.len() {
                    spec.push(args);
                }
            }
        }
        if !chk_exhaustive(info, spec, fields) {
            miss.push("`" + cs.names.get(tag).unwrap_or("") + "`");
        }
    }
    chk_sort_strings(miss);
    ": missing " + miss.join(", ")
}

// chk_sort_strings sorts in place (insertion sort; the lists are short).
fn chk_sort_strings(mut v: Vec<String>) {
    let n = v.len();
    for i in 1..n {
        let mut j = i;
        while j > 0 && ast_str_less(v.get(j).unwrap_or(""), v.get(j - 1).unwrap_or("")) {
            let a = v.get(j).unwrap_or("");
            v.set(j, v.get(j - 1).unwrap_or(""));
            v.set(j - 1, a);
            j = j - 1;
        }
    }
}

fn chk_subpatterns(c: Chk, p: AstPattern, mut pi: ChkPatInfo, fields: Vec<Ty>) {
    if p.args.len() != fields.len() {
        chk_errorf(
            c,
            p.pos,
            "pattern `"
                + p.ctor
                + "` expects "
                + fields.len().to_string()
                + " field(s), found "
                + p.args.len().to_string(),
        );
    }
    pi.args = p.args;
    let mut i = 0;
    for sub in p.args {
        let t = match fields.get(i) {
            Some(f) => f,
            None => ty_invalid(),
        };
        chk_pattern(c, sub, t);
        i = i + 1;
    }
}

fn chk_pattern(mut c: Chk, p: AstPattern, st0: Ty) {
    let st = ty_prune(st0);
    let mut pi = ChkPatInfo { kind: "wild", ty: st, tag: 0, bind: None, args: Vec::new() };
    c.info.patterns.insert(p.id, pi);
    if p.wildcard {
        pi.kind = "wild";
        return;
    }
    if p.alts.len() > 0 {
        chk_or_pattern(c, p, pi, st);
        return;
    }
    match p.at.get(0) {
        Some(sub) => {
            // `name @ sub`
            pi.kind = "at";
            pi.args = p.at;
            let mut b = chk_new_binding(c, p.bind, st, p.pos);
            b.mutable = p.mutable;
            chk_bind(c, b);
            pi.bind = Some(b);
            chk_pattern(c, sub, st);
            return;
        }
        None => {}
    }
    if p.range {
        chk_range_pattern(c, p, pi, st);
        return;
    }
    if p.tuple {
        chk_tuple_pattern(c, p, pi, st);
        return;
    }
    if p.int_value.is_some() {
        pi.kind = "int";
        if !ty_unify(st, ty_int()) {
            chk_errorf(c, p.pos, "integer pattern used on `" + ty_str(st) + "`");
        }
        return;
    }
    if p.bool_lit.is_some() {
        pi.kind = "bool";
        if !ty_unify(st, ty_bool()) {
            chk_errorf(c, p.pos, "boolean pattern used on `" + ty_str(st) + "`");
        }
        return;
    }
    if p.str_value.is_some() {
        pi.kind = "string";
        if !ty_unify(st, ty_string()) {
            chk_errorf(c, p.pos, "string pattern used on `" + ty_str(st) + "`");
        }
        return;
    }
    let mut ctor = p.ctor;
    if ctor == "" {
        ctor = p.bind;
    }
    match st {
        Ty::Result(ok, err) => {
            if p.ty == "" && (ctor == "Ok" || ctor == "Err") {
                pi.kind = "ctor";
                if ctor == "Ok" {
                    chk_subpatterns(c, p, pi, chk_tys1(ok));
                } else {
                    pi.tag = 1;
                    chk_subpatterns(c, p, pi, chk_tys1(err));
                }
                return;
            }
        }
        Ty::Option(el) => {
            if p.ty == "" && ctor == "Some" {
                pi.kind = "ctor";
                pi.tag = 1;
                chk_subpatterns(c, p, pi, chk_tys1(el));
                return;
            }
            if p.ty == "" && ctor == "None" {
                pi.kind = "ctor";
                pi.tag = 0;
                chk_subpatterns(c, p, pi, Vec::new());
                return;
            }
        }
        Ty::Enum(en, args) => {
            if p.ty != "" && p.ty != en.name && !(p.ty == "Self" && chk_self_is(c, en.name)) {
                chk_errorf(
                    c,
                    p.pos,
                    "expected a variant of `" + en.name + "`, found `" + p.ty + "::" + ctor + "`",
                );
                pi.kind = "wild";
                return;
            }
            let mut tag = 0;
            for v in en.variants {
                if v.name == ctor {
                    pi.kind = "ctor";
                    pi.tag = tag;
                    chk_subpatterns(c, p, pi, ty_variant_fields(en, args, v));
                    return;
                }
                tag = tag + 1;
            }
            if p.ty != "" {
                chk_errorf(c, p.pos, "no variant `" + ctor + "` in enum `" + en.name + "`");
                pi.kind = "wild";
                return;
            }
        }
        _ => {}
    }
    if p.ctor != "" {
        if !ty_is_prim(st, "<invalid>") {
            chk_errorf(c, p.pos, "pattern `" + ctor + "` does not match type `" + ty_str(st) + "`");
        }
        pi.kind = "wild";
        for sub in p.args {
            chk_pattern(c, sub, ty_invalid());
        }
        return;
    }
    pi.kind = "bind";
    let mut b = chk_new_binding(c, p.bind, st, p.pos);
    b.mutable = p.mutable;
    chk_bind(c, b);
    pi.bind = Some(b);
}

// chk_self_is reports whether `Self` names the type called name.
fn chk_self_is(c: Chk, name: String) -> Bool {
    match c.tscope.get("Self") {
        Some(t) => chk_recv_name(t) == name,
        None => false,
    }
}

// chk_tuple_pattern checks `(p, q, ...)` (`()` matches the unit value).
fn chk_tuple_pattern(c: Chk, p: AstPattern, mut pi: ChkPatInfo, st: Ty) {
    if p.args.len() == 0 {
        if !ty_unify(st, ty_unit()) {
            chk_errorf(c, p.pos, "pattern `()` does not match type `" + ty_str(st) + "`");
        }
        pi.kind = "wild";
        return;
    }
    if ty_is_var(st) {
        let mut ts = Vec::new();
        for a in p.args {
            ts.push(chk_new_var(c));
        }
        ty_unify(st, Ty::Tuple(ts));
    }
    match ty_prune(st) {
        Ty::Tuple(ts) => {
            if ts.len() == p.args.len() {
                pi.kind = "tuple";
                pi.ty = ty_prune(st);
                chk_subpatterns(c, p, pi, ts);
                return;
            }
            chk_errorf(
                c,
                p.pos,
                "mismatched types: expected a tuple with "
                    + ts.len().to_string()
                    + " element(s), found one with "
                    + p.args.len().to_string(),
            );
        }
        _ => {
            if !ty_is_prim(ty_prune(st), "<invalid>") {
                chk_errorf(c, p.pos, "tuple pattern used on `" + ty_str(st) + "`");
            }
        }
    }
    pi.kind = "wild";
    for sub in p.args {
        chk_pattern(c, sub, ty_invalid());
    }
}

// chk_range_pattern checks `lo..=hi`, `lo..hi`, `..=hi` and `lo..`.
fn chk_range_pattern(c: Chk, p: AstPattern, mut pi: ChkPatInfo, st: Ty) {
    pi.kind = "range";
    if !ty_unify(st, ty_int()) {
        chk_errorf(c, p.pos, "range pattern used on `" + ty_str(st) + "`");
        return;
    }
    let lo = p.range_lo.unwrap_or(0);
    let hi = p.range_hi.unwrap_or(0);
    if p.range_lo.is_some() && p.range_hi.is_some() {
        if p.range_incl && lo > hi {
            chk_errorf(c, p.pos, "lower range bound must be less than or equal to upper");
        } else if !p.range_incl && lo >= hi {
            chk_errorf(c, p.pos, "lower range bound must be less than upper");
        }
    }
}

// chk_or_pattern checks `p | q | ...`: every alternative is checked
// against st and must bind the same variables with the same types. The
// first alternative's bindings are in scope; the others' binding patterns
// are redirected to them, so each variable is one binding.
fn chk_or_pattern(c: Chk, p: AstPattern, mut pi: ChkPatInfo, st: Ty) {
    pi.kind = "or";
    pi.args = p.alts;
    let mut first: Vec<ChkBinding> = Vec::new();
    let mut i = 0;
    for alt in p.alts {
        if i == 0 {
            chk_pattern(c, alt, st);
            first = chk_pat_bindings(c.info, alt);
        } else {
            chk_push(c, false);
            chk_pattern(c, alt, st);
            chk_pop(c);
            let bs = chk_pat_bindings(c.info, alt);
            for b in bs {
                match chk_find_binding(first, b.name) {
                    Some(f) => {
                        if !ty_unify(f.ty, b.ty) {
                            chk_errorf(
                                c,
                                b.pos,
                                "mismatched types: variable `"
                                    + b.name
                                    + "` is `"
                                    + ty_str(ty_resolve(f.ty))
                                    + "` in the first alternative and `"
                                    + ty_str(ty_resolve(b.ty))
                                    + "` here",
                            );
                        } else if f.mutable != b.mutable {
                            chk_errorf(
                                c,
                                b.pos,
                                "variable `"
                                    + b.name
                                    + "` is bound with different mutability in the alternatives",
                            );
                        }
                        chk_share_binding(c.info, alt, f);
                    }
                    None => {
                        chk_errorf(
                            c,
                            b.pos,
                            "variable `" + b.name + "` is not bound in all patterns",
                        );
                    }
                }
            }
            for f in first {
                if chk_find_binding(bs, f.name).is_none() {
                    chk_errorf(c, alt.pos, "variable `" + f.name + "` is not bound in all patterns");
                }
            }
        }
        i = i + 1;
    }
}

fn chk_find_binding(bs: Vec<ChkBinding>, name: String) -> Option<ChkBinding> {
    for b in bs {
        if b.name == name {
            return Some(b);
        }
    }
    None
}

// chk_pat_bindings lists the variables a checked pattern binds (for an
// or-pattern, those of its first alternative).
fn chk_pat_bindings(info: ChkInfo, p: AstPattern) -> Vec<ChkBinding> {
    let mut out = Vec::new();
    chk_collect_bindings(info, p, out);
    out
}

fn chk_collect_bindings(info: ChkInfo, p: AstPattern, mut out: Vec<ChkBinding>) {
    match info.patterns.get(p.id) {
        Some(pi) => {
            match pi.bind {
                Some(b) => {
                    if b.name != "_" {
                        out.push(b);
                    }
                }
                None => {}
            }
            if pi.kind == "or" {
                match pi.args.get(0) {
                    Some(a) => chk_collect_bindings(info, a, out),
                    None => {}
                }
                return;
            }
            for a in pi.args {
                chk_collect_bindings(info, a, out);
            }
        }
        None => {}
    }
}

// chk_share_binding makes the binding patterns for f.name in p bind f.
fn chk_share_binding(info: ChkInfo, p: AstPattern, f: ChkBinding) {
    match info.patterns.get(p.id) {
        Some(mut pi) => {
            match pi.bind {
                Some(b) => {
                    if b.name == f.name {
                        pi.bind = Some(f);
                    }
                }
                None => {}
            }
            for a in pi.args {
                chk_share_binding(info, a, f);
            }
        }
        None => {}
    }
}
