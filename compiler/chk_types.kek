// Types and unification. Primitive, opaque, struct and enum types are
// unique per name, so they compare by name (and type arguments).

struct TyVar {
    id: Int,
    mut r: Option<Ty>,
}

// TyParam is a generic parameter: a rigid type inside the generic item,
// replaced by a type argument at each use (ids are unique per program).
// bounds are the traits it implements (filled in after creation).
struct TyParam {
    id: Int,
    name: String,
    bounds: Vec<TyBound>,
}

// TyBound is a trait bound `Trait<Args>` or `Trait<Args, Name = T, ...>`.
struct TyBound {
    trait_name: String,
    args: Vec<Ty>,
    assoc_names: Vec<String>,
    assoc_tys: Vec<Ty>,
}

struct TyField {
    name: String,
    ty: Ty,
    // declared `mut` (assignable)
    mutable: Bool,
}

// Field types of a generic struct mention its params; Ty::Struct carries
// the arguments (ty_struct_field substitutes them).
struct TyStruct {
    name: String,
    params: Vec<TyParam>,
    fields: Vec<TyField>,
}

// names are the field names of a struct-like variant `V { a: A }`
// (empty for `V(A)`).
struct TyVariant {
    name: String,
    fields: Vec<Ty>,
    names: Vec<String>,
}

struct TyEnum {
    name: String,
    params: Vec<TyParam>,
    variants: Vec<TyVariant>,
}

enum Ty {
    // "()", "Bool", "Int", "Float", "String", "!" (never), "<invalid>"
    Prim(String),
    // Request, Response, TxError, NetError, IoError
    Opaque(String),
    // a struct or enum with its type arguments (one per param)
    Struct(TyStruct, Vec<Ty>),
    Enum(TyEnum, Vec<Ty>),
    Param(TyParam),
    // the associated type `<T as Trait>::Name`, before normalization
    Assoc(Ty, String, String),
    // a closure or function value `fn(A, B) -> R`
    Fn(Vec<Ty>, Ty),
    Result(Ty, Ty),
    Option(Ty),
    Vec(Ty),
    // `(A, B, ...)` with at least one element
    Tuple(Vec<Ty>),
    // capability kind name, borrowed
    Cap(String, Bool),
    Var(TyVar),
}

fn ty_unit() -> Ty {
    Ty::Prim("()")
}

fn ty_bool() -> Ty {
    Ty::Prim("Bool")
}

fn ty_int() -> Ty {
    Ty::Prim("Int")
}

fn ty_float() -> Ty {
    Ty::Prim("Float")
}

fn ty_string() -> Ty {
    Ty::Prim("String")
}

fn ty_never() -> Ty {
    Ty::Prim("!")
}

fn ty_invalid() -> Ty {
    Ty::Prim("<invalid>")
}

// ty_is_prim reports whether t (unpruned) is the primitive `name`.
fn ty_is_prim(t: Ty, name: String) -> Bool {
    match t {
        Ty::Prim(n) => n == name,
        _ => false,
    }
}

fn ty_is_opaque(t: Ty, name: String) -> Bool {
    match t {
        Ty::Opaque(n) => n == name,
        _ => false,
    }
}

// ty_is_named reports whether t is the opaque type `name` or the prelude
// struct that implements it.
fn ty_is_named(t: Ty, name: String) -> Bool {
    match ty_prune(t) {
        Ty::Opaque(n) => n == name,
        Ty::Struct(s, _) => s.name == name,
        _ => false,
    }
}

fn ty_is_var(t: Ty) -> Bool {
    match t {
        Ty::Var(_) => true,
        _ => false,
    }
}

fn ty_cap_revocable(kind: String) -> Bool {
    kind == "Log" || kind == "Clock" || kind == "Random" || kind == "Tx"
}

fn ty_is_cap_name(name: String) -> Bool {
    name == "Log"
        || name == "Net"
        || name == "Db"
        || name == "Clock"
        || name == "Random"
        || name == "Tx"
        || name == "Fs"
}

fn ty_str(t: Ty) -> String {
    match t {
        Ty::Prim(n) => n,
        Ty::Opaque(n) => if n.starts_with("@") {
            ty_path_name(n)
        } else {
            n
        },
        Ty::Struct(s, args) => if s.name.starts_with("impl ") {
            // an opaque type `impl Trait` ("impl Trait#function#k")
            s.name.slice(0, s.name.index_of("#").unwrap_or(s.name.len()))
        } else if s.name.starts_with("dyn ") {
            ty_dyn_str(s, args)
        } else {
            s.name + ty_args_str(args)
        },
        Ty::Enum(e, args) => e.name + ty_args_str(args),
        Ty::Param(p) => p.name,
        Ty::Assoc(s, tr, n) => "<" + ty_str(s) + " as " + tr + ">::" + n,
        Ty::Fn(ps, r) => {
            let mut parts = Vec::new();
            for p in ps {
                parts.push(ty_str(p));
            }
            let mut s = "fn(" + parts.join(", ") + ")";
            if !ty_is_prim(ty_prune(r), "()") {
                s = s + " -> " + ty_str(r);
            }
            s
        }
        Ty::Result(a, b) => "Result<" + ty_str(a) + ", " + ty_str(b) + ">",
        Ty::Option(a) => "Option<" + ty_str(a) + ">",
        Ty::Vec(a) => "Vec<" + ty_str(a) + ">",
        Ty::Tuple(ts) => ty_tuple_str(ts),
        Ty::Cap(k, borrowed) => if borrowed { "&" + k } else { k },
        Ty::Var(v) => match v.r {
            Some(r) => ty_str(r),
            None => "?" + v.id.to_string(),
        },
    }
}

// ty_dyn_str renders a trait object type `dyn Trait<A, Name = T>`: its
// params are named after the associated types they bind ("" for the
// trait's own arguments).
fn ty_dyn_str(s: TyStruct, args: Vec<Ty>) -> String {
    if args.len() == 0 {
        return s.name;
    }
    let mut parts = Vec::new();
    for i in 0..args.len() {
        let t = ty_str(args.get(i).unwrap_or(ty_unit()));
        let n = match s.params.get(i) {
            Some(p) => p.name,
            None => "",
        };
        if n == "" {
            parts.push(t);
        } else {
            parts.push(n + " = " + t);
        }
    }
    s.name + "<" + parts.join(", ") + ">"
}

// ty_is_dyn reports whether t (pruned) is a trait object type `dyn Trait`.
fn ty_is_dyn(t: Ty) -> Bool {
    match t {
        Ty::Struct(s, _) => s.name.starts_with("dyn "),
        _ => false,
    }
}

// ty_is_opaque_impl reports whether t (pruned) is an opaque `impl Trait`
// result type.
fn ty_is_opaque_impl(t: Ty) -> Bool {
    match t {
        Ty::Struct(s, _) => s.name.starts_with("impl "),
        _ => false,
    }
}

fn ty_args_str(args: Vec<Ty>) -> String {
    if args.len() == 0 {
        return "";
    }
    let mut parts = Vec::new();
    for t in args {
        parts.push(ty_str(t));
    }
    "<" + parts.join(", ") + ">"
}

fn ty_tuple_str(ts: Vec<Ty>) -> String {
    let mut parts = Vec::new();
    for t in ts {
        parts.push(ty_str(t));
    }
    if parts.len() == 1 {
        return "(" + parts.join("") + ",)";
    }
    "(" + parts.join(", ") + ")"
}

// ty_prune follows bound inference variables.
fn ty_prune(t: Ty) -> Ty {
    match t {
        Ty::Var(v) => match v.r {
            Some(r) => ty_prune(r),
            None => t,
        },
        _ => t,
    }
}

// ty_resolve substitutes bound variables; unbound ones default to ().
fn ty_resolve(t0: Ty) -> Ty {
    let t = ty_prune(t0);
    match t {
        Ty::Var(mut v) => {
            v.r = Some(ty_unit());
            ty_unit()
        }
        Ty::Result(a, b) => {
            let ra = ty_resolve(a);
            Ty::Result(ra, ty_resolve(b))
        }
        Ty::Option(a) => Ty::Option(ty_resolve(a)),
        Ty::Vec(a) => Ty::Vec(ty_resolve(a)),
        Ty::Tuple(ts) => Ty::Tuple(ty_resolve_all(ts)),
        Ty::Struct(st, args) => Ty::Struct(st, ty_resolve_all(args)),
        Ty::Enum(en, args) => Ty::Enum(en, ty_resolve_all(args)),
        Ty::Assoc(s, tr, n) => Ty::Assoc(ty_resolve(s), tr, n),
        Ty::Fn(ps, r) => {
            let rps = ty_resolve_all(ps);
            Ty::Fn(rps, ty_resolve(r))
        }
        _ => t,
    }
}

fn ty_resolve_all(ts: Vec<Ty>) -> Vec<Ty> {
    let mut out = Vec::new();
    for e in ts {
        out.push(ty_resolve(e));
    }
    out
}

// ty_subst replaces the params ps by args in t.
fn ty_subst(t0: Ty, ps: Vec<TyParam>, args: Vec<Ty>) -> Ty {
    if ps.len() == 0 {
        return t0;
    }
    let t = ty_prune(t0);
    match t {
        Ty::Param(p) => {
            for i in 0..ps.len() {
                match ps.get(i) {
                    Some(q) => {
                        if q.id == p.id {
                            return args.get(i).unwrap_or(t);
                        }
                    }
                    None => {}
                }
            }
            t
        }
        Ty::Result(a, b) => {
            let ra = ty_subst(a, ps, args);
            Ty::Result(ra, ty_subst(b, ps, args))
        }
        Ty::Option(a) => Ty::Option(ty_subst(a, ps, args)),
        Ty::Vec(a) => Ty::Vec(ty_subst(a, ps, args)),
        Ty::Tuple(ts) => Ty::Tuple(ty_subst_all(ts, ps, args)),
        Ty::Struct(st, xs) => Ty::Struct(st, ty_subst_all(xs, ps, args)),
        Ty::Enum(en, xs) => Ty::Enum(en, ty_subst_all(xs, ps, args)),
        Ty::Assoc(s, tr, n) => Ty::Assoc(ty_subst(s, ps, args), tr, n),
        Ty::Fn(xs, r) => {
            let sxs = ty_subst_all(xs, ps, args);
            Ty::Fn(sxs, ty_subst(r, ps, args))
        }
        _ => t,
    }
}

fn ty_subst_all(ts: Vec<Ty>, ps: Vec<TyParam>, args: Vec<Ty>) -> Vec<Ty> {
    let mut out = Vec::new();
    for e in ts {
        out.push(ty_subst(e, ps, args));
    }
    out
}

// ty_struct_fields returns the field types of a struct instance.
fn ty_struct_fields(st: TyStruct, args: Vec<Ty>) -> Vec<Ty> {
    let mut out = Vec::new();
    for f in st.fields {
        out.push(ty_subst(f.ty, st.params, args));
    }
    out
}

// ty_variant_fields returns the field types of a variant of an enum
// instance.
fn ty_variant_fields(en: TyEnum, args: Vec<Ty>, v: TyVariant) -> Vec<Ty> {
    ty_subst_all(v.fields, en.params, args)
}

fn ty_is_cap(t: Ty) -> Bool {
    match ty_prune(t) {
        Ty::Cap(_, _) => true,
        _ => false,
    }
}

// ty_same compares already pruned types by name. An opaque type and the
// prelude struct implementing it are the same type.
fn ty_same(a: Ty, b: Ty) -> Bool {
    match a {
        Ty::Prim(x) => match b {
            Ty::Prim(y) => x == y,
            _ => false,
        },
        Ty::Opaque(x) => match b {
            Ty::Opaque(y) => x == y,
            Ty::Struct(y, _) => x == y.name,
            _ => false,
        },
        Ty::Struct(x, _) => match b {
            Ty::Opaque(y) => x.name == y,
            _ => false,
        },
        Ty::Param(x) => match b {
            Ty::Param(y) => x.id == y.id,
            _ => false,
        },
        Ty::Var(x) => match b {
            Ty::Var(y) => x.id == y.id,
            _ => false,
        },
        _ => false,
    }
}

fn ty_identical(a0: Ty, b0: Ty) -> Bool {
    let a = ty_prune(a0);
    let b = ty_prune(b0);
    match a {
        Ty::Result(ao, ae) => match b {
            Ty::Result(bo, be) => ty_identical(ao, bo) && ty_identical(ae, be),
            _ => false,
        },
        Ty::Option(ae) => match b {
            Ty::Option(be) => ty_identical(ae, be),
            _ => false,
        },
        Ty::Vec(ae) => match b {
            Ty::Vec(be) => ty_identical(ae, be),
            _ => false,
        },
        Ty::Tuple(xs) => match b {
            Ty::Tuple(ys) => ty_identical_all(xs, ys),
            _ => false,
        },
        Ty::Struct(x, xs) => match b {
            Ty::Struct(y, ys) => x.name == y.name && ty_identical_all(xs, ys),
            _ => ty_same(a, b),
        },
        Ty::Enum(x, xs) => match b {
            Ty::Enum(y, ys) => x.name == y.name && ty_identical_all(xs, ys),
            _ => false,
        },
        Ty::Assoc(xs, xt, xn) => match b {
            Ty::Assoc(ys, yt, yn) => xt == yt && xn == yn && ty_identical(xs, ys),
            _ => false,
        },
        Ty::Fn(xs, xr) => match b {
            Ty::Fn(ys, yr) => ty_identical_all(xs, ys) && ty_identical(xr, yr),
            _ => false,
        },
        Ty::Cap(ak, ab) => match b {
            Ty::Cap(bk, bb) => ak == bk && ab == bb,
            _ => false,
        },
        _ => ty_same(a, b),
    }
}

fn ty_identical_all(xs: Vec<Ty>, ys: Vec<Ty>) -> Bool {
    if xs.len() != ys.len() {
        return false;
    }
    for i in 0..xs.len() {
        if !ty_identical(xs.get(i).unwrap_or(ty_unit()), ys.get(i).unwrap_or(ty_unit())) {
            return false;
        }
    }
    true
}

// ty_key is the canonical string of a resolved type (used for layouts).
fn ty_key(t: Ty) -> String {
    let parts = Vec::new();
    ty_write_key(parts, ty_resolve(t));
    parts.join("")
}

fn ty_write_key(mut b: Vec<String>, t: Ty) {
    match t {
        Ty::Result(o, e) => {
            b.push("Result<");
            ty_write_key(b, o);
            b.push(",");
            ty_write_key(b, e);
            b.push(">");
        }
        Ty::Option(e) => {
            b.push("Option<");
            ty_write_key(b, e);
            b.push(">");
        }
        Ty::Vec(e) => {
            b.push("Vec<");
            ty_write_key(b, e);
            b.push(">");
        }
        Ty::Tuple(ts) => {
            b.push("(");
            ty_write_keys(b, ts);
            b.push(")");
        }
        Ty::Struct(st, args) => {
            b.push(st.name);
            if args.len() > 0 {
                b.push("<");
                ty_write_keys(b, args);
                b.push(">");
            }
        }
        Ty::Enum(en, args) => {
            b.push(en.name);
            if args.len() > 0 {
                b.push("<");
                ty_write_keys(b, args);
                b.push(">");
            }
        }
        Ty::Fn(ps, r) => {
            b.push("fn(");
            ty_write_keys(b, ps);
            b.push(")->");
            ty_write_key(b, r);
        }
        // the resource of a permission has no run-time representation
        Ty::Opaque(n) => b.push(if n.starts_with("@") { "@" } else { n }),
        _ => b.push(ty_str(t)),
    }
}

fn ty_write_keys(mut b: Vec<String>, ts: Vec<Ty>) {
    let mut i = 0;
    for e in ts {
        if i > 0 {
            b.push(",");
        }
        ty_write_key(b, e);
        i = i + 1;
    }
}

// ---- resource paths ----
//
// The resource of a permission `Can<A, d>` (docs/authz-flow.md) is a
// variable, written into the type as Ty::Opaque("@" + identity + ":" +
// name): the identity of a parameter is "f:<function>#<index>", that of a
// local variable "<binding id>". Two permissions are for the same
// resource when the identities match; at a call, the parameters of the
// callee are replaced by the arguments' paths (ty_subst_paths).

fn ty_is_path(t: Ty) -> Bool {
    match ty_prune(t) {
        Ty::Opaque(n) => n.starts_with("@"),
        _ => false,
    }
}

// ty_path_name is the variable name of a path ("@f:edit#0:d" -> "d").
fn ty_path_name(n: String) -> String {
    let parts = n.split(":");
    parts.get(parts.len() - 1).unwrap_or(n)
}

// ty_param_path is the path of parameter i (named name) of function fname.
fn ty_param_path(fname: String, i: Int, name: String) -> Ty {
    Ty::Opaque("@f:" + fname + "#" + i.to_string() + ":" + name)
}

// ty_path_param is the index of the parameter of fname that the path n
// names, or -1.
fn ty_path_param(n: String, fname: String) -> Int {
    let pre = "@f:" + fname + "#";
    if !n.starts_with(pre) {
        return -1;
    }
    let rest = n.slice(pre.len(), n.len());
    match rest.index_of(":") {
        Some(j) => rest.slice(0, j).parse_int().unwrap_or(-1),
        None => -1,
    }
}

// ty_mentions_path reports whether t contains a resource path.
fn ty_mentions_path(t0: Ty) -> Bool {
    let t = ty_prune(t0);
    match t {
        Ty::Opaque(n) => n.starts_with("@"),
        Ty::Result(a, b) => ty_mentions_path(a) || ty_mentions_path(b),
        Ty::Option(a) => ty_mentions_path(a),
        Ty::Vec(a) => ty_mentions_path(a),
        Ty::Tuple(ts) => ty_any_mentions_path(ts),
        Ty::Struct(_, xs) => ty_any_mentions_path(xs),
        Ty::Enum(_, xs) => ty_any_mentions_path(xs),
        Ty::Fn(xs, r) => ty_any_mentions_path(xs) || ty_mentions_path(r),
        _ => false,
    }
}

// ty_mentions_labeled reports whether t contains Labeled<_, _>.
fn ty_mentions_labeled(t0: Ty) -> Bool {
    let t = ty_prune(t0);
    match t {
        Ty::Struct(st, xs) => {
            if st.name == "Labeled" {
                return true;
            }
            for x in xs {
                if ty_mentions_labeled(x) {
                    return true;
                }
            }
            false
        }
        Ty::Enum(_, xs) => {
            for x in xs {
                if ty_mentions_labeled(x) {
                    return true;
                }
            }
            false
        }
        Ty::Result(a, b) => ty_mentions_labeled(a) || ty_mentions_labeled(b),
        Ty::Option(a) => ty_mentions_labeled(a),
        Ty::Vec(a) => ty_mentions_labeled(a),
        Ty::Tuple(ts) => {
            for x in ts {
                if ty_mentions_labeled(x) {
                    return true;
                }
            }
            false
        }
        _ => false,
    }
}

fn ty_any_mentions_path(ts: Vec<Ty>) -> Bool {
    for t in ts {
        if ty_mentions_path(t) {
            return true;
        }
    }
    false
}

// ty_subst_paths replaces the paths of the parameters of fname by paths
// (one per parameter; ty_invalid() where the argument is not a variable).
fn ty_subst_paths(t0: Ty, fname: String, paths: Vec<Ty>) -> Ty {
    let t = ty_prune(t0);
    match t {
        Ty::Opaque(n) => {
            let i = ty_path_param(n, fname);
            if i < 0 {
                return t;
            }
            paths.get(i).unwrap_or(t)
        }
        Ty::Result(a, b) => {
            let ra = ty_subst_paths(a, fname, paths);
            Ty::Result(ra, ty_subst_paths(b, fname, paths))
        }
        Ty::Option(a) => Ty::Option(ty_subst_paths(a, fname, paths)),
        Ty::Vec(a) => Ty::Vec(ty_subst_paths(a, fname, paths)),
        Ty::Tuple(ts) => Ty::Tuple(ty_subst_paths_all(ts, fname, paths)),
        Ty::Struct(st, xs) => Ty::Struct(st, ty_subst_paths_all(xs, fname, paths)),
        Ty::Enum(en, xs) => Ty::Enum(en, ty_subst_paths_all(xs, fname, paths)),
        Ty::Fn(xs, r) => {
            let sxs = ty_subst_paths_all(xs, fname, paths);
            Ty::Fn(sxs, ty_subst_paths(r, fname, paths))
        }
        _ => t,
    }
}

fn ty_subst_paths_all(ts: Vec<Ty>, fname: String, paths: Vec<Ty>) -> Vec<Ty> {
    let mut out = Vec::new();
    for e in ts {
        out.push(ty_subst_paths(e, fname, paths));
    }
    out
}

// ---- unification ----

fn ty_occurs(v: TyVar, t0: Ty) -> Bool {
    let t = ty_prune(t0);
    match t {
        Ty::Var(w) => w.id == v.id,
        Ty::Result(a, b) => ty_occurs(v, a) || ty_occurs(v, b),
        Ty::Option(a) => ty_occurs(v, a),
        Ty::Vec(a) => ty_occurs(v, a),
        Ty::Tuple(ts) => ty_occurs_any(v, ts),
        Ty::Struct(_, ts) => ty_occurs_any(v, ts),
        Ty::Enum(_, ts) => ty_occurs_any(v, ts),
        Ty::Assoc(s, _, _) => ty_occurs(v, s),
        Ty::Fn(ps, r) => ty_occurs_any(v, ps) || ty_occurs(v, r),
        _ => false,
    }
}

fn ty_occurs_any(v: TyVar, ts: Vec<Ty>) -> Bool {
    for e in ts {
        if ty_occurs(v, e) {
            return true;
        }
    }
    false
}

fn ty_unify_all(xs: Vec<Ty>, ys: Vec<Ty>) -> Bool {
    if xs.len() != ys.len() {
        return false;
    }
    let mut ok = true;
    for i in 0..xs.len() {
        if !ty_unify(xs.get(i).unwrap_or(ty_unit()), ys.get(i).unwrap_or(ty_unit())) {
            ok = false;
        }
    }
    ok
}

fn ty_unify(a0: Ty, b0: Ty) -> Bool {
    let a = ty_prune(a0);
    let b = ty_prune(b0);
    if ty_is_prim(a, "!")
        || ty_is_prim(b, "!")
        || ty_is_prim(a, "<invalid>")
        || ty_is_prim(b, "<invalid>") {
        return true;
    }
    match a {
        Ty::Var(mut va) => {
            match b {
                Ty::Var(vb) => {
                    if va.id == vb.id {
                        return true;
                    }
                }
                _ => {}
            }
            if ty_occurs(va, b) {
                return false;
            }
            va.r = Some(b);
            return true;
        }
        _ => {}
    }
    if ty_is_var(b) {
        return ty_unify(b, a);
    }
    match a {
        Ty::Result(ao, ae) => match b {
            Ty::Result(bo, be) => ty_unify(ao, bo) && ty_unify(ae, be),
            _ => false,
        },
        Ty::Option(ae) => match b {
            Ty::Option(be) => ty_unify(ae, be),
            _ => false,
        },
        Ty::Vec(ae) => match b {
            Ty::Vec(be) => ty_unify(ae, be),
            _ => false,
        },
        Ty::Tuple(xs) => match b {
            Ty::Tuple(ys) => ty_unify_all(xs, ys),
            _ => false,
        },
        Ty::Struct(x, xs) => match b {
            Ty::Struct(y, ys) => x.name == y.name && ty_unify_all(xs, ys),
            _ => ty_same(a, b),
        },
        Ty::Enum(x, xs) => match b {
            Ty::Enum(y, ys) => x.name == y.name && ty_unify_all(xs, ys),
            _ => false,
        },
        Ty::Assoc(xs, xt, xn) => match b {
            Ty::Assoc(ys, yt, yn) => xt == yt && xn == yn && ty_unify(xs, ys),
            _ => false,
        },
        Ty::Fn(xs, xr) => match b {
            Ty::Fn(ys, yr) => {
                let ok = ty_unify_all(xs, ys);
                ty_unify(xr, yr) && ok
            }
            _ => false,
        },
        Ty::Cap(ak, ab) => match b {
            Ty::Cap(bk, bb) => ak == bk && ab == bb,
            _ => false,
        },
        _ => ty_same(a, b),
    }
}

// ty_join is the type of two branches (Never is absorbed).
fn ty_join(a: Ty, b: Ty) -> Ty {
    if ty_is_prim(ty_prune(a), "!") {
        return b;
    }
    a
}
