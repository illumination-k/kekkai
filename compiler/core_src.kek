        "// BTreeMap and BTreeSet, with Rust's API (std::collections): maps and\n// sets kept sorted by the keys (`Ord`).\n//\n// The map is an AVL tree (not a B-tree: the name and the API are Rust's),\n// so insert, remove, get and the first / last operations are O(log n).\n// Iteration is a live view like HashMap's: an iterator remembers the last\n// key it returned and finds the next one from the root (O(log n) per\n// step), so it sees keys inserted after it was created and skips removed\n// ones. `range` is the same iterator with bounds.\n\n// ---- bounds (std::ops::Bound, RangeBounds) ----\n\n#[derive(PartialEq, Eq, Clone, Debug)]\nenum Bound<T> {\n    Included(T),\n    Excluded(T),\n    Unbounded,\n}\n\n// RangeBounds is what `range` accepts: `a..b` and `a..=b` (Int keys) and a\n// pair of bounds `(Bound::Excluded(lo), Bound::Unbounded)` (any key).\ntrait RangeBounds<T> {\n    fn start_bound(&self) -> Bound<T>;\n\n    fn end_bound(&self) -> Bound<T>;\n}\n\nimpl RangeBounds<Int> for Range {\n    fn start_bound(&self) -> Bound<Int> {\n        Bound::Included(self.start)\n    }\n\n    fn end_bound(&self) -> Bound<Int> {\n        Bound::Excluded(self.end)\n    }\n}\n\nimpl RangeBounds<Int> for RangeInclusive {\n    fn start_bound(&self) -> Bound<Int> {\n        Bound::Included(self.start)\n    }\n\n    fn end_bound(&self) -> Bound<Int> {\n        Bound::Included(self.end)\n    }\n}\n\nimpl<T> RangeBounds<T> for (Bound<T>, Bound<T>) {\n    fn start_bound(&self) -> Bound<T> {\n        self.0\n    }\n\n    fn end_bound(&self) -> Bound<T> {\n        self.1\n    }\n}\n\n// ---- the tree ----\n\nstruct __BNode<K, V> {\n    key: K,\n    mut value: V,\n    mut left: Option<__BNode<K, V>>,\n    mut right: Option<__BNode<K, V>>,\n    mut height: Int,\n}\n\nstruct BTreeMap<K, V> {\n    mut __root: Option<__BNode<K, V>>,\n    mut __len: Int,\n}\n\nfn __bt_height<K, V>(n: &Option<__BNode<K, V>>) -> Int {\n    match *n {\n        Some(x) => x.height,\n        None => 0,\n    }\n}\n\nfn __bt_fix<K, V>(mut n: __BNode<K, V>) {\n    n.height = 1 + __bt_height(&n.left).max(__bt_height(&n.right));\n}\n\n// __bt_rot_right lifts n's left child (which must exist).\nfn __bt_rot_right<K, V>(mut n: __BNode<K, V>) -> __BNode<K, V> {\n    match n.left {\n        Some(mut l) => {\n            n.left = l.right;\n            __bt_fix(n);\n            l.right = Some(n);\n            __bt_fix(l);\n            l\n        }\n        None => n,\n    }\n}\n\nfn __bt_rot_left<K, V>(mut n: __BNode<K, V>) -> __BNode<K, V> {\n    match n.right {\n        Some(mut r) => {\n            n.right = r.left;\n            __bt_fix(n);\n            r.left = Some(n);\n            __bt_fix(r);\n            r\n        }\n        None => n,\n    }\n}\n\n// __bt_balance restores the AVL invariant at n (its subtrees are balanced\n// and their heights differ by at most 2).\nfn __bt_balance<K, V>(mut n: __BNode<K, V>) -> __BNode<K, V> {\n    __bt_fix(n);\n    let bal = __bt_height(&n.left) - __bt_height(&n.right);\n    if bal > 1 {\n        match n.left {\n            Some(l) => {\n                if __bt_height(&l.left) < __bt_height(&l.right) {\n                    n.left = Some(__bt_rot_left(l));\n                }\n            }\n            None => {}\n        }\n        return __bt_rot_right(n);\n    }\n    if bal < -1 {\n        match n.right {\n            Some(r) => {\n                if __bt_height(&r.right) < __bt_height(&r.left) {\n                    n.right = Some(__bt_rot_right(r));\n                }\n            }\n            None => {}\n        }\n        return __bt_rot_left(n);\n    }\n    n\n}\n\n// __bt_insert inserts (k, v) below n, returning the new subtree and the\n// previous value of k.\nfn __bt_insert<K: Ord, V>(n: Option<__BNode<K, V>>, k: K, v: V) -> (__BNode<K, V>, Option<V>) {\n    match n {\n        None => (__BNode { key: k, value: v, left: None, right: None, height: 1 }, None),\n        Some(mut x) => match k.cmp(&x.key) {\n            Ordering::Equal => {\n                let old = x.value;\n                x.value = v;\n                (x, Some(old))\n            }\n            Ordering::Less => {\n                let (l, old) = __bt_insert(x.left, k, v);\n                x.left = Some(l);\n                (__bt_balance(x), old)\n            }\n            Ordering::Greater => {\n                let (r, old) = __bt_insert(x.right, k, v);\n                x.right = Some(r);\n                (__bt_balance(x), old)\n            }\n        },\n    }\n}\n\n// __bt_remove_min removes the smallest node of n, returning the new\n// subtree and that node.\nfn __bt_remove_min<K, V>(mut n: __BNode<K, V>) -> (Option<__BNode<K, V>>, __BNode<K, V>) {\n    match n.left {\n        None => (n.right, n),\n        Some(l) => {\n            let (nl, m) = __bt_remove_min(l);\n            n.left = nl;\n            (Some(__bt_balance(n)), m)\n        }\n    }\n}\n\nfn __bt_remove_max<K, V>(mut n: __BNode<K, V>) -> (Option<__BNode<K, V>>, __BNode<K, V>) {\n    match n.right {\n        None => (n.left, n),\n        Some(r) => {\n            let (nr, m) = __bt_remove_max(r);\n            n.right = nr;\n            (Some(__bt_balance(n)), m)\n        }\n    }\n}\n\n// __bt_remove removes k below n, returning the new subtree and the removed\n// node.\n#[owned]\nfn __bt_remove<K: Ord, V>(\n    n: Option<__BNode<K, V>>,\n    k: &K,\n) -> (Option<__BNode<K, V>>, Option<__BNode<K, V>>) {\n    match n {\n        None => (None, None),\n        Some(mut x) => match k.cmp(&x.key) {\n            Ordering::Less => {\n                let (l, gone) = __bt_remove(x.left, k);\n                x.left = l;\n                (Some(__bt_balance(x)), gone)\n            }\n            Ordering::Greater => {\n                let (r, gone) = __bt_remove(x.right, k);\n                x.right = r;\n                (Some(__bt_balance(x)), gone)\n            }\n            Ordering::Equal => match x.right {\n                None => (x.left, Some(x)),\n                Some(r) => {\n                    let (nr, mut m) = __bt_remove_min(r);\n                    m.left = x.left;\n                    m.right = nr;\n                    (Some(__bt_balance(m)), Some(x))\n                }\n            },\n        },\n    }\n}\n\n// __bt_lower is the node with the smallest key satisfying the lower bound\n// b (k >= x or k > x).\n#[owned]\nfn __bt_lower<K: Ord, V>(root: &Option<__BNode<K, V>>, b: &Bound<K>) -> Option<__BNode<K, V>> {\n    let mut best = None;\n    let mut cur = *root;\n    while let Some(x) = cur {\n        let ok = match *b {\n            Bound::Included(lo) => x.key >= lo,\n            Bound::Excluded(lo) => x.key > lo,\n            Bound::Unbounded => true,\n        };\n        if ok {\n            best = Some(x);\n            cur = x.left;\n        } else {\n            cur = x.right;\n        }\n    }\n    best\n}\n\n// __bt_upper is the node with the largest key satisfying the upper bound.\n#[owned]\nfn __bt_upper<K: Ord, V>(root: &Option<__BNode<K, V>>, b: &Bound<K>) -> Option<__BNode<K, V>> {\n    let mut best = None;\n    let mut cur = *root;\n    while let Some(x) = cur {\n        let ok = match *b {\n            Bound::Included(hi) => x.key <= hi,\n            Bound::Excluded(hi) => x.key < hi,\n            Bound::Unbounded => true,\n        };\n        if ok {\n            best = Some(x);\n            cur = x.right;\n        } else {\n            cur = x.left;\n        }\n    }\n    best\n}\n\nfn __bt_below<K: Ord>(k: &K, b: &Bound<K>) -> Bool {\n    match *b {\n        Bound::Included(hi) => *k <= hi,\n        Bound::Excluded(hi) => *k < hi,\n        Bound::Unbounded => true,\n    }\n}\n\nfn __bt_above<K: Ord>(k: &K, b: &Bound<K>) -> Bool {\n    match *b {\n        Bound::Included(lo) => *k >= lo,\n        Bound::Excluded(lo) => *k > lo,\n        Bound::Unbounded => true,\n    }\n}\n\nimpl<K, V> BTreeMap<K, V> {\n    fn new() -> BTreeMap<K, V> {\n        BTreeMap { __root: None, __len: 0 }\n    }\n\n    fn len(&self) -> Int {\n        self.__len\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.__len == 0\n    }\n\n    fn clear(&mut self) {\n        self.__root = None;\n        self.__len = 0;\n    }\n\n    // iter returns the (key, value) pairs in key order (both ends:\n    // `iter().rev()` is descending).\n    #[fresh]\n    fn iter(&self) -> BTreeMapIter<K, V> {\n        BTreeMapIter { __map: *self, __lo: Bound::Unbounded, __hi: Bound::Unbounded }\n    }\n\n    #[fresh]\n    fn keys(&self) -> BTreeMapKeys<K, V> {\n        BTreeMapKeys { __it: self.iter() }\n    }\n\n    #[fresh]\n    fn values(&self) -> BTreeMapValues<K, V> {\n        BTreeMapValues { __it: self.iter() }\n    }\n\n    #[fresh]\n    fn into_keys(self) -> BTreeMapKeys<K, V> {\n        self.keys()\n    }\n\n    #[fresh]\n    fn into_values(self) -> BTreeMapValues<K, V> {\n        self.values()\n    }\n\n    // first_key_value and last_key_value: the smallest and the largest key\n    // with its value.\n    fn first_key_value(&self) -> Option<(K, V)> {\n        let mut cur = self.__root;\n        let mut out = None;\n        while let Some(x) = cur {\n            out = Some((x.key, x.value));\n            cur = x.left;\n        }\n        out\n    }\n\n    fn last_key_value(&self) -> Option<(K, V)> {\n        let mut cur = self.__root;\n        let mut out = None;\n        while let Some(x) = cur {\n            out = Some((x.key, x.value));\n            cur = x.right;\n        }\n        out\n    }\n\n    // pop_first and pop_last remove and return the smallest / largest\n    // entry.\n    fn pop_first(&mut self) -> Option<(K, V)> {\n        match self.__root {\n            Some(r) => {\n                let (nr, m) = __bt_remove_min(r);\n                self.__root = nr;\n                self.__len = self.__len - 1;\n                Some((m.key, m.value))\n            }\n            None => None,\n        }\n    }\n\n    fn pop_last(&mut self) -> Option<(K, V)> {\n        match self.__root {\n            Some(r) => {\n                let (nr, m) = __bt_remove_max(r);\n                self.__root = nr;\n                self.__len = self.__len - 1;\n                Some((m.key, m.value))\n            }\n            None => None,\n        }\n    }\n}\n\nimpl<K: Ord, V> BTreeMap<K, V> {\n    fn __node(&self, k: &K) -> Option<__BNode<K, V>> {\n        let mut cur = self.__root;\n        while let Some(x) = cur {\n            match k.cmp(&x.key) {\n                Ordering::Less => {\n                    cur = x.left;\n                }\n                Ordering::Greater => {\n                    cur = x.right;\n                }\n                Ordering::Equal => {\n                    return Some(x);\n                }\n            }\n        }\n        None\n    }\n\n    fn get(&self, k: &K) -> Option<V> {\n        match self.__node(k) {\n            Some(x) => Some(x.value),\n            None => None,\n        }\n    }\n\n    fn get_key_value(&self, k: &K) -> Option<(K, V)> {\n        match self.__node(k) {\n            Some(x) => Some((x.key, x.value)),\n            None => None,\n        }\n    }\n\n    fn contains_key(&self, k: &K) -> Bool {\n        self.__node(k).is_some()\n    }\n\n    // insert sets the value of k, returning its previous value.\n    fn insert(&mut self, k: K, v: V) -> Option<V> {\n        let (root, old) = __bt_insert(self.__root, k, v);\n        self.__root = Some(root);\n        if old.is_none() {\n            self.__len = self.__len + 1;\n        }\n        old\n    }\n\n    // remove removes k, returning its value.\n    fn remove(&mut self, k: &K) -> Option<V> {\n        match self.remove_entry(k) {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n\n    fn remove_entry(&mut self, k: &K) -> Option<(K, V)> {\n        let (root, gone) = __bt_remove(self.__root, k);\n        self.__root = root;\n        match gone {\n            Some(x) => {\n                self.__len = self.__len - 1;\n                Some((x.key, x.value))\n            }\n            None => None,\n        }\n    }\n\n    // range iterates over the entries whose keys are in r, in order:\n    // `m.range(2..5)`, `m.range((Bound::Excluded(k), Bound::Unbounded))`.\n    #[fresh]\n    fn range<R: RangeBounds<K>>(&self, r: R) -> BTreeMapIter<K, V> {\n        BTreeMapIter { __map: *self, __lo: r.start_bound(), __hi: r.end_bound() }\n    }\n\n    fn entry(&mut self, k: K) -> Entry<BTreeMap<K, V>, K, V> {\n        __entry_of(*self, k)\n    }\n\n    fn retain(&mut self, f: impl Fn(K, V) -> Bool) {\n        let mut drop = Vec::new();\n        for (k, v) in self.iter() {\n            if !f(k, v) {\n                drop.push(k);\n            }\n        }\n        for k in drop {\n            self.remove(&k);\n        }\n    }\n\n    fn extend<I: Iterator<Item = (K, V)>>(&mut self, mut iter: I) {\n        while let Some((k, v)) = iter.next() {\n            self.insert(k, v);\n        }\n    }\n\n    // append moves the entries of other into self (other's values win) and\n    // leaves other empty.\n    fn append(&mut self, other: &mut BTreeMap<K, V>) {\n        while let Some((k, v)) = other.pop_first() {\n            self.insert(k, v);\n        }\n    }\n}\n\nimpl<K: Ord, V> __EntryMap<K, V> for BTreeMap<K, V> {\n    fn __entry_get(&self, k: &K) -> Option<V> {\n        self.get(k)\n    }\n\n    fn __entry_insert(&mut self, k: K, v: V) -> Option<V> {\n        self.insert(k, v)\n    }\n\n    fn __entry_remove(&mut self, k: &K) -> Option<V> {\n        self.remove(k)\n    }\n}\n\n// ---- iteration ----\n\nstruct BTreeMapIter<K, V> {\n    __map: BTreeMap<K, V>,\n    mut __lo: Bound<K>,\n    mut __hi: Bound<K>,\n}\n\nimpl<K: Ord, V> Iterator for BTreeMapIter<K, V> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        match __bt_lower(&self.__map.__root, &self.__lo) {\n            Some(x) => {\n                if !__bt_below(&x.key, &self.__hi) {\n                    return None;\n                }\n                self.__lo = Bound::Excluded(x.key);\n                Some((x.key, x.value))\n            }\n            None => None,\n        }\n    }\n}\n\nimpl<K: Ord, V> DoubleEndedIterator for BTreeMapIter<K, V> {\n    fn next_back(&mut self) -> Option<(K, V)> {\n        match __bt_upper(&self.__map.__root, &self.__hi) {\n            Some(x) => {\n                if !__bt_above(&x.key, &self.__lo) {\n                    return None;\n                }\n                self.__hi = Bound::Excluded(x.key);\n                Some((x.key, x.value))\n            }\n            None => None,\n        }\n    }\n}\n\nstruct BTreeMapKeys<K, V> {\n    __it: BTreeMapIter<K, V>,\n}\n\nimpl<K: Ord, V> Iterator for BTreeMapKeys<K, V> {\n    type Item = K;\n\n    fn next(&mut self) -> Option<K> {\n        match self.__it.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nimpl<K: Ord, V> DoubleEndedIterator for BTreeMapKeys<K, V> {\n    fn next_back(&mut self) -> Option<K> {\n        match self.__it.next_back() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nstruct BTreeMapValues<K, V> {\n    __it: BTreeMapIter<K, V>,\n}\n\nimpl<K: Ord, V> Iterator for BTreeMapValues<K, V> {\n    type Item = V;\n\n    fn next(&mut self) -> Option<V> {\n        match self.__it.next() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\nimpl<K: Ord, V> DoubleEndedIterator for BTreeMapValues<K, V> {\n    fn next_back(&mut self) -> Option<V> {\n        match self.__it.next_back() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\nimpl<K: Ord, V> IntoIterator for BTreeMap<K, V> {\n    type Item = (K, V);\n    type IntoIter = BTreeMapIter<K, V>;\n\n    fn into_iter(self) -> BTreeMapIter<K, V> {\n        self.iter()\n    }\n}\n\nimpl<K: Ord, V> FromIterator<(K, V)> for BTreeMap<K, V> {\n    fn from_iter<I: Iterator<Item = (K, V)>>(iter: I) -> BTreeMap<K, V> {\n        let mut m = BTreeMap::new();\n        m.extend(iter);\n        m\n    }\n}\n\nimpl<K: Ord + Clone, V: Clone> Clone for BTreeMap<K, V> {\n    fn clone(&self) -> BTreeMap<K, V> {\n        let mut m = BTreeMap::new();\n        for (k, v) in self.iter() {\n            m.insert(k.clone(), v.clone());\n        }\n        m\n    }\n}\n\nimpl<K: Ord, V: PartialEq> PartialEq for BTreeMap<K, V> {\n    fn eq(&self, other: &BTreeMap<K, V>) -> Bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        let mut a = self.iter();\n        let mut b = other.iter();\n        while let Some((k, v)) = a.next() {\n            match b.next() {\n                Some((k2, v2)) => {\n                    if k != k2 || v != v2 {\n                        return false;\n                    }\n                }\n                None => {\n                    return false;\n                }\n            }\n        }\n        true\n    }\n}\n\nimpl<K: Ord, V: Eq> Eq for BTreeMap<K, V> {}\n\nimpl<K, V> Default for BTreeMap<K, V> {\n    fn default() -> BTreeMap<K, V> {\n        BTreeMap::new()\n    }\n}\n\n// ---- BTreeSet ----\n\nstruct BTreeSet<T> {\n    __map: BTreeMap<T, ()>,\n}\n\nimpl<T> BTreeSet<T> {\n    fn new() -> BTreeSet<T> {\n        BTreeSet { __map: BTreeMap::new() }\n    }\n\n    fn len(&self) -> Int {\n        self.__map.len()\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.__map.is_empty()\n    }\n\n    fn clear(&mut self) {\n        self.__map.clear();\n    }\n\n    // iter returns the elements in order.\n    #[fresh]\n    fn iter(&self) -> BTreeMapKeys<T, ()> {\n        self.__map.keys()\n    }\n\n    fn first(&self) -> Option<T> {\n        match self.__map.first_key_value() {\n            Some((x, _)) => Some(x),\n            None => None,\n        }\n    }\n\n    fn last(&self) -> Option<T> {\n        match self.__map.last_key_value() {\n            Some((x, _)) => Some(x),\n            None => None,\n        }\n    }\n\n    fn pop_first(&mut self) -> Option<T> {\n        match self.__map.pop_first() {\n            Some((x, _)) => Some(x),\n            None => None,\n        }\n    }\n\n    fn pop_last(&mut self) -> Option<T> {\n        match self.__map.pop_last() {\n            Some((x, _)) => Some(x),\n            None => None,\n        }\n    }\n}\n\nimpl<T: Ord> BTreeSet<T> {\n    // insert adds x, reporting whether it was new.\n    fn insert(&mut self, x: T) -> Bool {\n        self.__map.insert(x, ()).is_none()\n    }\n\n    fn contains(&self, x: &T) -> Bool {\n        self.__map.contains_key(x)\n    }\n\n    // remove removes x, reporting whether it was present.\n    fn remove(&mut self, x: &T) -> Bool {\n        self.__map.remove(x).is_some()\n    }\n\n    #[fresh]\n    fn range<R: RangeBounds<T>>(&self, r: R) -> BTreeMapKeys<T, ()> {\n        BTreeMapKeys { __it: self.__map.range(r) }\n    }\n\n    fn extend<I: Iterator<Item = T>>(&mut self, mut iter: I) {\n        while let Some(x) = iter.next() {\n            self.insert(x);\n        }\n    }\n\n    fn append(&mut self, other: &mut BTreeSet<T>) {\n        while let Some(x) = other.pop_first() {\n            self.insert(x);\n        }\n    }\n\n    fn retain(&mut self, f: impl Fn(T) -> Bool) {\n        let mut drop = Vec::new();\n        for x in self.iter() {\n            if !f(x) {\n                drop.push(x);\n            }\n        }\n        for x in drop {\n            self.remove(&x);\n        }\n    }\n\n    fn is_subset(&self, other: &BTreeSet<T>) -> Bool {\n        for x in self.iter() {\n            if !other.contains(&x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    fn is_superset(&self, other: &BTreeSet<T>) -> Bool {\n        other.is_subset(self)\n    }\n\n    fn is_disjoint(&self, other: &BTreeSet<T>) -> Bool {\n        for x in self.iter() {\n            if other.contains(&x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // union, intersection, difference and symmetric_difference return the\n    // resulting elements in order.\n    #[fresh]\n    fn union(&self, other: &BTreeSet<T>) -> Vec<T> {\n        let mut s: BTreeSet<T> = self.iter().collect();\n        s.extend(other.iter());\n        s.iter().collect()\n    }\n\n    #[fresh]\n    fn intersection(&self, other: &BTreeSet<T>) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            if other.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    #[fresh]\n    fn difference(&self, other: &BTreeSet<T>) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            if !other.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    #[fresh]\n    fn symmetric_difference(&self, other: &BTreeSet<T>) -> Vec<T> {\n        let mut s: BTreeSet<T> = BTreeSet::new();\n        for x in self.iter() {\n            if !other.contains(&x) {\n                s.insert(x);\n            }\n        }\n        for x in other.iter() {\n            if !self.contains(&x) {\n                s.insert(x);\n            }\n        }\n        s.iter().collect()\n    }\n}\n\nimpl<T: Ord> IntoIterator for BTreeSet<T> {\n    type Item = T;\n    type IntoIter = BTreeMapKeys<T, ()>;\n\n    fn into_iter(self) -> BTreeMapKeys<T, ()> {\n        self.iter()\n    }\n}\n\nimpl<T: Ord> FromIterator<T> for BTreeSet<T> {\n    fn from_iter<I: Iterator<Item = T>>(iter: I) -> BTreeSet<T> {\n        let mut s = BTreeSet::new();\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T: Ord + Clone> Clone for BTreeSet<T> {\n    fn clone(&self) -> BTreeSet<T> {\n        let mut s = BTreeSet::new();\n        for x in self.iter() {\n            s.insert(x.clone());\n        }\n        s\n    }\n}\n\nimpl<T: Ord> PartialEq for BTreeSet<T> {\n    fn eq(&self, other: &BTreeSet<T>) -> Bool {\n        self.__map == other.__map\n    }\n}\n\nimpl<T: Ord> Eq for BTreeSet<T> {}\n\nimpl<T> Default for BTreeSet<T> {\n    fn default() -> BTreeSet<T> {\n        BTreeSet::new()\n    }\n}\n",
