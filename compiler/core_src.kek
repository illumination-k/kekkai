        "cmp.kek",
        "// Comparison: equality (`==`) and ordering (`<`), as in Rust's core::cmp.\n\n#[derive(PartialEq, Eq, Clone)]\nenum Ordering {\n    Less,\n    Equal,\n    Greater,\n}\n\nimpl Ordering {\n    fn is_eq(self) -> Bool {\n        match self {\n            Ordering::Equal => true,\n            _ => false,\n        }\n    }\n\n    fn is_lt(self) -> Bool {\n        match self {\n            Ordering::Less => true,\n            _ => false,\n        }\n    }\n\n    fn is_gt(self) -> Bool {\n        match self {\n            Ordering::Greater => true,\n            _ => false,\n        }\n    }\n\n    fn reverse(self) -> Ordering {\n        match self {\n            Ordering::Less => Ordering::Greater,\n            Ordering::Equal => Ordering::Equal,\n            Ordering::Greater => Ordering::Less,\n        }\n    }\n\n    // then is the lexicographic combination: self, or other when equal.\n    fn then(self, other: Ordering) -> Ordering {\n        match self {\n            Ordering::Equal => other,\n            _ => self,\n        }\n    }\n}\n\ntrait PartialEq {\n    fn eq(&self, other: &Self) -> Bool;\n\n    fn ne(&self, other: &Self) -> Bool {\n        !self.eq(other)\n    }\n}\n\ntrait Eq: PartialEq {}\n\ntrait PartialOrd: PartialEq {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering>;\n\n    fn lt(&self, other: &Self) -> Bool {\n        match self.partial_cmp(other) {\n            Some(Ordering::Less) => true,\n            _ => false,\n        }\n    }\n\n    fn le(&self, other: &Self) -> Bool {\n        match self.partial_cmp(other) {\n            Some(Ordering::Less) => true,\n            Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    fn gt(&self, other: &Self) -> Bool {\n        match self.partial_cmp(other) {\n            Some(Ordering::Greater) => true,\n            _ => false,\n        }\n    }\n\n    fn ge(&self, other: &Self) -> Bool {\n        match self.partial_cmp(other) {\n            Some(Ordering::Greater) => true,\n            Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n}\n\ntrait Ord: Eq + PartialOrd {\n    fn cmp(&self, other: &Self) -> Ordering;\n\n    fn max(self, other: Self) -> Self {\n        match self.cmp(&other) {\n            Ordering::Greater => self,\n            _ => other,\n        }\n    }\n\n    fn min(self, other: Self) -> Self {\n        match self.cmp(&other) {\n            Ordering::Greater => other,\n            _ => self,\n        }\n    }\n}\n\n// ---- primitive types ----\n\nimpl PartialEq for Int {\n    fn eq(&self, other: &Self) -> Bool {\n        self == other\n    }\n}\n\nimpl Eq for Int {}\n\nimpl PartialOrd for Int {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        Some(self.cmp(other))\n    }\n}\n\nimpl Ord for Int {\n    fn cmp(&self, other: &Self) -> Ordering {\n        if self < other {\n            Ordering::Less\n        } else if self > other {\n            Ordering::Greater\n        } else {\n            Ordering::Equal\n        }\n    }\n}\n\nimpl PartialEq for Bool {\n    fn eq(&self, other: &Self) -> Bool {\n        self == other\n    }\n}\n\nimpl Eq for Bool {}\n\nimpl PartialOrd for Bool {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        Some(self.cmp(other))\n    }\n}\n\nimpl Ord for Bool {\n    fn cmp(&self, other: &Self) -> Ordering {\n        // false < true\n        if self == other {\n            Ordering::Equal\n        } else if *other {\n            Ordering::Less\n        } else {\n            Ordering::Greater\n        }\n    }\n}\n\nimpl PartialEq for String {\n    fn eq(&self, other: &Self) -> Bool {\n        self == other\n    }\n}\n\nimpl Eq for String {}\n\nimpl PartialOrd for String {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        Some(self.cmp(other))\n    }\n}\n\n// Strings are ordered by their UTF-16 code units.\nimpl Ord for String {\n    fn cmp(&self, other: &Self) -> Ordering {\n        let n = self.len().min(other.len());\n        let mut i = 0;\n        while i < n {\n            let a = self.char_at(i).unwrap_or(0);\n            let b = other.char_at(i).unwrap_or(0);\n            if a != b {\n                return a.cmp(&b);\n            }\n            i = i + 1;\n        }\n        self.len().cmp(&other.len())\n    }\n}\n\nimpl PartialEq for () {\n    fn eq(&self, other: &Self) -> Bool {\n        true\n    }\n}\n\nimpl Eq for () {}\n\nimpl PartialOrd for () {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        Some(Ordering::Equal)\n    }\n}\n\nimpl Ord for () {\n    fn cmp(&self, other: &Self) -> Ordering {\n        Ordering::Equal\n    }\n}\n\n// ---- Option, Result and Vec ----\n\nimpl<T: PartialEq> PartialEq for Option<T> {\n    fn eq(&self, other: &Self) -> Bool {\n        match self {\n            Some(a) => match other {\n                Some(b) => a == b,\n                None => false,\n            },\n            None => other.is_none(),\n        }\n    }\n}\n\nimpl<T: Eq> Eq for Option<T> {}\n\nimpl<T: PartialOrd> PartialOrd for Option<T> {\n    // None < Some(_)\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        match self {\n            Some(a) => match other {\n                Some(b) => a.partial_cmp(b),\n                None => Some(Ordering::Greater),\n            },\n            None => match other {\n                Some(_) => Some(Ordering::Less),\n                None => Some(Ordering::Equal),\n            },\n        }\n    }\n}\n\nimpl<T: Ord> Ord for Option<T> {\n    fn cmp(&self, other: &Self) -> Ordering {\n        match self {\n            Some(a) => match other {\n                Some(b) => a.cmp(b),\n                None => Ordering::Greater,\n            },\n            None => match other {\n                Some(_) => Ordering::Less,\n                None => Ordering::Equal,\n            },\n        }\n    }\n}\n\nimpl<T: PartialEq, E: PartialEq> PartialEq for Result<T, E> {\n    fn eq(&self, other: &Self) -> Bool {\n        match self {\n            Ok(a) => match other {\n                Ok(b) => a == b,\n                Err(_) => false,\n            },\n            Err(a) => match other {\n                Ok(_) => false,\n                Err(b) => a == b,\n            },\n        }\n    }\n}\n\nimpl<T: Eq, E: Eq> Eq for Result<T, E> {}\n\nimpl<T: PartialEq> PartialEq for Vec<T> {\n    fn eq(&self, other: &Self) -> Bool {\n        let n = self.len();\n        if n != other.len() {\n            return false;\n        }\n        let mut i = 0;\n        while i < n {\n            match self.get(i) {\n                Some(a) => match other.get(i) {\n                    Some(b) => {\n                        if a != b {\n                            return false;\n                        }\n                    }\n                    None => {\n                        return false;\n                    }\n                },\n                None => {\n                    return false;\n                }\n            }\n            i = i + 1;\n        }\n        true\n    }\n}\n\nimpl<T: Eq> Eq for Vec<T> {}\n\nimpl<T: PartialOrd> PartialOrd for Vec<T> {\n    // lexicographic\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        let n = self.len().min(other.len());\n        let mut i = 0;\n        while i < n {\n            match self.get(i) {\n                Some(a) => match other.get(i) {\n                    Some(b) => match a.partial_cmp(b) {\n                        Some(Ordering::Equal) => {}\n                        o => {\n                            return o;\n                        }\n                    },\n                    None => {}\n                },\n                None => {}\n            }\n            i = i + 1;\n        }\n        Some(self.len().cmp(&other.len()))\n    }\n}\n\nimpl<T: Ord> Ord for Vec<T> {\n    fn cmp(&self, other: &Self) -> Ordering {\n        let n = self.len().min(other.len());\n        let mut i = 0;\n        while i < n {\n            match self.get(i) {\n                Some(a) => match other.get(i) {\n                    Some(b) => match a.cmp(b) {\n                        Ordering::Equal => {}\n                        o => {\n                            return o;\n                        }\n                    },\n                    None => {}\n                },\n                None => {}\n            }\n            i = i + 1;\n        }\n        self.len().cmp(&other.len())\n    }\n}\n",
