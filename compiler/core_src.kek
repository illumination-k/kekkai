    core_file(
        v,
        "hashmap.kek",
        "// HashMap and HashSet, with Rust's API (std::collections), iterating in\n// insertion order.\n//\n// Entries are kept in insertion order in `entries` (a removed entry stays\n// as a hole, `live` false, until the table is rebuilt). `buckets` holds,\n// per bucket, the first entry of a chain linked by `next`. The hash is\n// fixed (unseeded), so a bucket can be made to collide on purpose: when a\n// chain grows past TREEIFY entries it becomes an AVL tree ordered by the\n// keys (`Ord`), so that every operation stays O(log n) (this is why keys\n// must be Ord as well as Hash + Eq).\n//\n// Iteration is a live view: an iterator sees entries inserted after it was\n// created and skips removed ones. Rebuilding the table compacts the\n// entries; an iterator then finds its place again by the insertion\n// sequence number of the last entry it returned.\n\nstruct HashEntry<K, V> {\n    key: K,\n    mut value: V,\n    hash: Int,\n    seq: Int,\n    // chain: the next entry; tree: the left child (-1: none)\n    mut next: Int,\n    mut right: Int,\n    mut height: Int,\n}\n\nstruct HashMap<K, V> {\n    mut entries: Vec<HashEntry<K, V>>,\n    mut live: Vec<Bool>,\n    mut buckets: Vec<Int>,\n    mut tree: Vec<Bool>,\n    mut len: Int,\n    mut next_seq: Int,\n    // incremented when the entries are compacted\n    mut epoch: Int,\n}\n\nfn __hashmap_treeify_len() -> Int {\n    8\n}\n\n// __hash_of hashes a value with the default hasher.\nfn __hash_of<T: Hash>(x: &T) -> Int {\n    let mut h = DefaultHasher::new();\n    x.hash(&mut h);\n    h.finish()\n}\n\nimpl<K, V> HashMap<K, V> {\n    fn new() -> HashMap<K, V> {\n        HashMap::with_capacity(0)\n    }\n\n    fn with_capacity(n: Int) -> HashMap<K, V> {\n        let mut size = 8;\n        while size * 3 < n * 4 {\n            size = size * 2;\n        }\n        let mut m = HashMap {\n            entries: Vec::new(),\n            live: Vec::new(),\n            buckets: Vec::new(),\n            tree: Vec::new(),\n            len: 0,\n            next_seq: 0,\n            epoch: 0,\n        };\n        for i in 0..size {\n            m.buckets.push(-1);\n            m.tree.push(false);\n        }\n        m\n    }\n\n    fn len(&self) -> Int {\n        self.len\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.len == 0\n    }\n\n    fn clear(&mut self) {\n        self.entries = Vec::new();\n        self.live = Vec::new();\n        for i in 0..self.buckets.len() {\n            self.buckets.set(i, -1);\n            self.tree.set(i, false);\n        }\n        self.len = 0;\n        self.epoch = self.epoch + 1;\n    }\n\n    // iter returns the (key, value) pairs in insertion order.\n    #[fresh]\n    fn iter(&self) -> HashMapIter<K, V> {\n        HashMapIter { map: *self, i: 0, epoch: self.epoch, last_seq: -1 }\n    }\n\n    #[fresh]\n    fn keys(&self) -> Keys<K, V> {\n        Keys { it: self.iter() }\n    }\n\n    #[fresh]\n    fn values(&self) -> Values<K, V> {\n        Values { it: self.iter() }\n    }\n\n    fn bucket_of(&self, hash: Int) -> Int {\n        hash.bit_and(self.buckets.len() - 1)\n    }\n\n    fn is_live(&self, i: Int) -> Bool {\n        self.live.get(i).unwrap_or(false)\n    }\n\n    // ---- AVL trees of entry indices (left: next, right: right) ----\n\n    fn height(&self, i: Int) -> Int {\n        if i < 0 {\n            return 0;\n        }\n        match self.entries.get(i) {\n            Some(e) => e.height,\n            None => 0,\n        }\n    }\n\n    fn left(&self, i: Int) -> Int {\n        match self.entries.get(i) {\n            Some(e) => e.next,\n            None => -1,\n        }\n    }\n\n    fn right(&self, i: Int) -> Int {\n        match self.entries.get(i) {\n            Some(e) => e.right,\n            None => -1,\n        }\n    }\n\n    fn set_children(&mut self, i: Int, l: Int, r: Int) {\n        match self.entries.get(i) {\n            Some(mut e) => {\n                e.next = l;\n                e.right = r;\n                e.height = 1 + self.height(l).max(self.height(r));\n            }\n            None => {}\n        }\n    }\n\n    fn rebalance(&mut self, i: Int) -> Int {\n        let l = self.left(i);\n        let r = self.right(i);\n        let bal = self.height(l) - self.height(r);\n        if bal > 1 {\n            // left heavy\n            let ll = self.left(l);\n            let lr = self.right(l);\n            if self.height(ll) >= self.height(lr) {\n                self.set_children(i, lr, r);\n                self.set_children(l, ll, i);\n                return l;\n            }\n            self.set_children(l, ll, self.left(lr));\n            self.set_children(i, self.right(lr), r);\n            self.set_children(lr, l, i);\n            return lr;\n        }\n        if bal < -1 {\n            let rl = self.left(r);\n            let rr = self.right(r);\n            if self.height(rr) >= self.height(rl) {\n                self.set_children(i, l, rl);\n                self.set_children(r, i, rr);\n                return r;\n            }\n            self.set_children(r, self.right(rl), rr);\n            self.set_children(i, l, self.left(rl));\n            self.set_children(rl, i, r);\n            return rl;\n        }\n        self.set_children(i, l, r);\n        i\n    }\n\n    // tree_min_remove removes the leftmost node of the tree at root,\n    // returning (new root, removed node).\n    fn tree_min_remove(&mut self, root: Int) -> (Int, Int) {\n        let l = self.left(root);\n        if l < 0 {\n            return (self.right(root), root);\n        }\n        let (nl, m) = self.tree_min_remove(l);\n        self.set_children(root, nl, self.right(root));\n        (self.rebalance(root), m)\n    }\n}\n\nimpl<K: Hash + Eq + Ord, V> HashMap<K, V> {\n    fn key_at(&self, i: Int, k: &K) -> Bool {\n        match self.entries.get(i) {\n            Some(e) => e.key == *k,\n            None => false,\n        }\n    }\n\n    // find returns the index of the live entry with key k, or -1.\n    fn find(&self, k: &K, hash: Int) -> Int {\n        let b = self.bucket_of(hash);\n        let mut i = self.buckets.get(b).unwrap_or(-1);\n        if self.tree.get(b).unwrap_or(false) {\n            while i >= 0 {\n                match self.entries.get(i) {\n                    Some(e) => match k.cmp(&e.key) {\n                        Ordering::Less => {\n                            i = e.next;\n                        }\n                        Ordering::Greater => {\n                            i = e.right;\n                        }\n                        Ordering::Equal => {\n                            return i;\n                        }\n                    },\n                    None => {\n                        return -1;\n                    }\n                }\n            }\n            return -1;\n        }\n        while i >= 0 {\n            match self.entries.get(i) {\n                Some(e) => {\n                    if e.hash == hash && e.key == *k {\n                        return i;\n                    }\n                    i = e.next;\n                }\n                None => {\n                    return -1;\n                }\n            }\n        }\n        -1\n    }\n\n    fn get(&self, k: &K) -> Option<V> {\n        let i = self.find(k, __hash_of(k));\n        if i < 0 {\n            return None;\n        }\n        match self.entries.get(i) {\n            Some(e) => Some(e.value),\n            None => None,\n        }\n    }\n\n    fn contains_key(&self, k: &K) -> Bool {\n        self.find(k, __hash_of(k)) >= 0\n    }\n\n    // insert sets the value of k, returning its previous value.\n    fn insert(&mut self, k: K, v: V) -> Option<V> {\n        let hash = __hash_of(&k);\n        let i = self.find(&k, hash);\n        if i >= 0 {\n            match self.entries.get(i) {\n                Some(mut e) => {\n                    let old = e.value;\n                    e.value = v;\n                    return Some(old);\n                }\n                None => {}\n            }\n        }\n        if (self.entries.len() + 1) * 4 > self.buckets.len() * 3 {\n            self.rebuild(self.len + 1);\n        }\n        let e = HashEntry {\n            key: k,\n            value: v,\n            hash: hash,\n            seq: self.next_seq,\n            next: -1,\n            right: -1,\n            height: 1,\n        };\n        self.next_seq = self.next_seq + 1;\n        self.entries.push(e);\n        self.live.push(true);\n        self.len = self.len + 1;\n        self.link(self.entries.len() - 1);\n        None\n    }\n\n    // remove removes k, returning its value.\n    fn remove(&mut self, k: &K) -> Option<V> {\n        let hash = __hash_of(k);\n        let i = self.find(k, hash);\n        if i < 0 {\n            return None;\n        }\n        let b = self.bucket_of(hash);\n        if self.tree.get(b).unwrap_or(false) {\n            let root = self.tree_remove(self.buckets.get(b).unwrap_or(-1), k);\n            self.buckets.set(b, root);\n        } else {\n            let mut prev = -1;\n            let mut j = self.buckets.get(b).unwrap_or(-1);\n            while j >= 0 && j != i {\n                prev = j;\n                j = self.left(j);\n            }\n            let nx = self.left(i);\n            if prev < 0 {\n                self.buckets.set(b, nx);\n            } else {\n                match self.entries.get(prev) {\n                    Some(mut pe) => {\n                        pe.next = nx;\n                    }\n                    None => {}\n                }\n            }\n        }\n        self.live.set(i, false);\n        self.len = self.len - 1;\n        match self.entries.get(i) {\n            Some(e) => Some(e.value),\n            None => None,\n        }\n    }\n\n    // link adds entry i to its bucket.\n    fn link(&mut self, i: Int) {\n        let hash = match self.entries.get(i) {\n            Some(e) => e.hash,\n            None => 0,\n        };\n        let b = self.bucket_of(hash);\n        let head = self.buckets.get(b).unwrap_or(-1);\n        if self.tree.get(b).unwrap_or(false) {\n            self.buckets.set(b, self.tree_insert(head, i));\n            return;\n        }\n        // append to the chain, counting it\n        match self.entries.get(i) {\n            Some(mut e) => {\n                e.next = -1;\n                e.right = -1;\n                e.height = 1;\n            }\n            None => {}\n        }\n        if head < 0 {\n            self.buckets.set(b, i);\n            return;\n        }\n        let mut n = 1;\n        let mut j = head;\n        while self.left(j) >= 0 {\n            j = self.left(j);\n            n = n + 1;\n        }\n        match self.entries.get(j) {\n            Some(mut e) => {\n                e.next = i;\n            }\n            None => {}\n        }\n        if n + 1 > __hashmap_treeify_len() {\n            self.treeify(b);\n        }\n    }\n\n    // treeify turns bucket b's chain into a tree.\n    fn treeify(&mut self, b: Int) {\n        let mut j = self.buckets.get(b).unwrap_or(-1);\n        let mut root = -1;\n        while j >= 0 {\n            let nx = self.left(j);\n            root = self.tree_insert(root, j);\n            j = nx;\n        }\n        self.buckets.set(b, root);\n        self.tree.set(b, true);\n    }\n\n    fn tree_insert(&mut self, root: Int, i: Int) -> Int {\n        if root < 0 {\n            self.set_children(i, -1, -1);\n            return i;\n        }\n        let ki = match self.entries.get(i) {\n            Some(e) => e.key,\n            None => {\n                return root;\n            }\n        };\n        let less = match self.entries.get(root) {\n            Some(r) => ki < r.key,\n            None => false,\n        };\n        if less {\n            let l = self.tree_insert(self.left(root), i);\n            self.set_children(root, l, self.right(root));\n        } else {\n            let r = self.tree_insert(self.right(root), i);\n            self.set_children(root, self.left(root), r);\n        }\n        self.rebalance(root)\n    }\n\n    fn tree_remove(&mut self, root: Int, k: &K) -> Int {\n        if root < 0 {\n            return -1;\n        }\n        let o = match self.entries.get(root) {\n            Some(r) => k.cmp(&r.key),\n            None => Ordering::Equal,\n        };\n        match o {\n            Ordering::Less => {\n                let l = self.tree_remove(self.left(root), k);\n                self.set_children(root, l, self.right(root));\n                self.rebalance(root)\n            }\n            Ordering::Greater => {\n                let r = self.tree_remove(self.right(root), k);\n                self.set_children(root, self.left(root), r);\n                self.rebalance(root)\n            }\n            Ordering::Equal => {\n                let l = self.left(root);\n                let r = self.right(root);\n                if r < 0 {\n                    return l;\n                }\n                let (nr, m) = self.tree_min_remove(r);\n                self.set_children(m, l, nr);\n                self.rebalance(m)\n            }\n        }\n    }\n\n    // rebuild drops removed entries and rehashes into a table with room for\n    // at least want entries.\n    fn rebuild(&mut self, want: Int) {\n        let mut es = Vec::new();\n        let mut lv = Vec::new();\n        for i in 0..self.entries.len() {\n            if self.is_live(i) {\n                match self.entries.get(i) {\n                    Some(e) => {\n                        es.push(e);\n                        lv.push(true);\n                    }\n                    None => {}\n                }\n            }\n        }\n        if es.len() != self.entries.len() {\n            self.epoch = self.epoch + 1;\n        }\n        self.entries = es;\n        self.live = lv;\n        let mut size = 8;\n        while size * 3 < (want + 1) * 4 {\n            size = size * 2;\n        }\n        self.buckets = Vec::new();\n        self.tree = Vec::new();\n        for i in 0..size {\n            self.buckets.push(-1);\n            self.tree.push(false);\n        }\n        for i in 0..self.entries.len() {\n            self.link(i);\n        }\n    }\n\n    // get_or returns the value of k, or d.\n    fn get_or(&self, k: &K, d: V) -> V {\n        match self.get(k) {\n            Some(v) => v,\n            None => d,\n        }\n    }\n\n    fn retain(&mut self, f: impl Fn(K, V) -> Bool) {\n        let mut drop = Vec::new();\n        for (k, v) in self.iter() {\n            if !f(k, v) {\n                drop.push(k);\n            }\n        }\n        for k in drop {\n            self.remove(&k);\n        }\n    }\n\n    fn extend<I: Iterator<Item = (K, V)>>(&mut self, mut iter: I) {\n        while let Some((k, v)) = iter.next() {\n            self.insert(k, v);\n        }\n    }\n}\n\n// ---- iteration ----\n\nstruct HashMapIter<K, V> {\n    map: HashMap<K, V>,\n    mut i: Int,\n    mut epoch: Int,\n    mut last_seq: Int,\n}\n\nimpl<K, V> Iterator for HashMapIter<K, V> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        let m = self.map;\n        if self.epoch != m.epoch {\n            // the entries were compacted (order kept): continue after the\n            // last entry returned, by its sequence number\n            let mut lo = 0;\n            let mut hi = m.entries.len();\n            while lo < hi {\n                let mid = (lo + hi) / 2;\n                let s = match m.entries.get(mid) {\n                    Some(e) => e.seq,\n                    None => 0,\n                };\n                if s <= self.last_seq {\n                    lo = mid + 1;\n                } else {\n                    hi = mid;\n                }\n            }\n            self.i = lo;\n            self.epoch = m.epoch;\n        }\n        while self.i < m.entries.len() {\n            let i = self.i;\n            self.i = i + 1;\n            if m.is_live(i) {\n                match m.entries.get(i) {\n                    Some(e) => {\n                        self.last_seq = e.seq;\n                        return Some((e.key, e.value));\n                    }\n                    None => {}\n                }\n            }\n        }\n        None\n    }\n}\n\nstruct Keys<K, V> {\n    it: HashMapIter<K, V>,\n}\n\nimpl<K, V> Iterator for Keys<K, V> {\n    type Item = K;\n\n    fn next(&mut self) -> Option<K> {\n        match self.it.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nstruct Values<K, V> {\n    it: HashMapIter<K, V>,\n}\n\nimpl<K, V> Iterator for Values<K, V> {\n    type Item = V;\n\n    fn next(&mut self) -> Option<V> {\n        match self.it.next() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\nimpl<K, V> IntoIterator for HashMap<K, V> {\n    type Item = (K, V);\n    type IntoIter = HashMapIter<K, V>;\n\n    fn into_iter(self) -> HashMapIter<K, V> {\n        self.iter()\n    }\n}\n\nimpl<K: Hash + Eq + Ord, V> FromIterator<(K, V)> for HashMap<K, V> {\n    fn from_iter<I: Iterator<Item = (K, V)>>(iter: I) -> HashMap<K, V> {\n        let mut m = HashMap::new();\n        m.extend(iter);\n        m\n    }\n}\n\nimpl<K: Hash + Eq + Ord + Clone, V: Clone> Clone for HashMap<K, V> {\n    fn clone(&self) -> HashMap<K, V> {\n        let mut m = HashMap::with_capacity(self.len());\n        for (k, v) in self.iter() {\n            m.insert(k.clone(), v.clone());\n        }\n        m\n    }\n}\n\nimpl<K, V> Default for HashMap<K, V> {\n    fn default() -> HashMap<K, V> {\n        HashMap::new()\n    }\n}\n\n// ---- HashSet ----\n\nstruct HashSet<T> {\n    map: HashMap<T, ()>,\n}\n\nimpl<T> HashSet<T> {\n    fn new() -> HashSet<T> {\n        HashSet { map: HashMap::new() }\n    }\n\n    fn with_capacity(n: Int) -> HashSet<T> {\n        HashSet { map: HashMap::with_capacity(n) }\n    }\n\n    fn len(&self) -> Int {\n        self.map.len()\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.map.is_empty()\n    }\n\n    fn clear(&mut self) {\n        self.map.clear();\n    }\n\n    // iter returns the elements in insertion order.\n    #[fresh]\n    fn iter(&self) -> Keys<T, ()> {\n        self.map.keys()\n    }\n}\n\nimpl<T: Hash + Eq + Ord> HashSet<T> {\n    // insert adds x, reporting whether it was new.\n    fn insert(&mut self, x: T) -> Bool {\n        self.map.insert(x, ()).is_none()\n    }\n\n    fn contains(&self, x: &T) -> Bool {\n        self.map.contains_key(x)\n    }\n\n    // remove removes x, reporting whether it was present.\n    fn remove(&mut self, x: &T) -> Bool {\n        self.map.remove(x).is_some()\n    }\n\n    fn extend<I: Iterator<Item = T>>(&mut self, mut iter: I) {\n        while let Some(x) = iter.next() {\n            self.insert(x);\n        }\n    }\n\n    fn retain(&mut self, f: impl Fn(T) -> Bool) {\n        let mut drop = Vec::new();\n        for x in self.iter() {\n            if !f(x) {\n                drop.push(x);\n            }\n        }\n        for x in drop {\n            self.remove(&x);\n        }\n    }\n\n    fn is_subset(&self, other: &HashSet<T>) -> Bool {\n        for x in self.iter() {\n            if !other.contains(&x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // union, intersection and difference return the resulting elements in\n    // order (self's first).\n    #[fresh]\n    fn union(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out: Vec<T> = self.iter().collect();\n        for x in other.iter() {\n            if !self.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    #[fresh]\n    fn intersection(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            if other.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    #[fresh]\n    fn difference(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            if !other.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n}\n\nimpl<T> IntoIterator for HashSet<T> {\n    type Item = T;\n    type IntoIter = Keys<T, ()>;\n\n    fn into_iter(self) -> Keys<T, ()> {\n        self.iter()\n    }\n}\n\nimpl<T: Hash + Eq + Ord> FromIterator<T> for HashSet<T> {\n    fn from_iter<I: Iterator<Item = T>>(iter: I) -> HashSet<T> {\n        let mut s = HashSet::new();\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T: Hash + Eq + Ord + Clone> Clone for HashSet<T> {\n    fn clone(&self) -> HashSet<T> {\n        let mut s = HashSet::with_capacity(self.len());\n        for x in self.iter() {\n            s.insert(x.clone());\n        }\n        s\n    }\n}\n\nimpl<T> Default for HashSet<T> {\n    fn default() -> HashSet<T> {\n        HashSet::new()\n    }\n}\n",
    );
    core_file(
        v,
        "iter.kek",
        "// Iterators, as in Rust's core::iter: the Iterator trait with its adapters\n// and consumers, ranges, and the iterators of Vec.\n//\n// Closures are pure values here: an adapter keeps its closure in a field\n// of type `fn(A) -> B`.\n\ntrait Iterator {\n    type Item;\n\n    fn next(&mut self) -> Option<Self::Item>;\n\n    // ---- consumers ----\n\n    fn count(mut self) -> Int {\n        let mut n = 0;\n        while let Some(_) = self.next() {\n            n = n + 1;\n        }\n        n\n    }\n\n    fn last(mut self) -> Option<Self::Item> {\n        let mut last = None;\n        while let Some(x) = self.next() {\n            last = Some(x);\n        }\n        last\n    }\n\n    fn nth(&mut self, n: Int) -> Option<Self::Item> {\n        let mut i = 0;\n        while i < n {\n            if self.next().is_none() {\n                return None;\n            }\n            i = i + 1;\n        }\n        self.next()\n    }\n\n    fn fold<B>(mut self, init: B, f: impl Fn(B, Self::Item) -> B) -> B {\n        let mut acc = init;\n        while let Some(x) = self.next() {\n            acc = f(acc, x);\n        }\n        acc\n    }\n\n    fn for_each(mut self, f: impl Fn(Self::Item)) {\n        while let Some(x) = self.next() {\n            f(x);\n        }\n    }\n\n    fn any(&mut self, p: impl Fn(Self::Item) -> Bool) -> Bool {\n        while let Some(x) = self.next() {\n            if p(x) {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn all(&mut self, p: impl Fn(Self::Item) -> Bool) -> Bool {\n        while let Some(x) = self.next() {\n            if !p(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    fn find(&mut self, p: impl Fn(Self::Item) -> Bool) -> Option<Self::Item> {\n        while let Some(x) = self.next() {\n            if p(x) {\n                return Some(x);\n            }\n        }\n        None\n    }\n\n    fn find_map<B>(&mut self, f: impl Fn(Self::Item) -> Option<B>) -> Option<B> {\n        while let Some(x) = self.next() {\n            match f(x) {\n                Some(y) => {\n                    return Some(y);\n                }\n                None => {}\n            }\n        }\n        None\n    }\n\n    fn position(&mut self, p: impl Fn(Self::Item) -> Bool) -> Option<Int> {\n        let mut i = 0;\n        while let Some(x) = self.next() {\n            if p(x) {\n                return Some(i);\n            }\n            i = i + 1;\n        }\n        None\n    }\n\n    #[fresh]\n    fn collect<B: FromIterator<Self::Item>>(self) -> B {\n        B::from_iter(self)\n    }\n\n    fn sum<S: Sum<Self::Item>>(self) -> S {\n        S::sum(self)\n    }\n\n    fn product<P: Product<Self::Item>>(self) -> P {\n        P::product(self)\n    }\n\n    fn max(mut self) -> Option<Self::Item>\n    where\n        Self::Item: Ord,\n    {\n        let mut best = None;\n        while let Some(x) = self.next() {\n            best = match best {\n                Some(b) => if x >= b { Some(x) } else { Some(b) },\n                None => Some(x),\n            };\n        }\n        best\n    }\n\n    fn min(mut self) -> Option<Self::Item>\n    where\n        Self::Item: Ord,\n    {\n        let mut best = None;\n        while let Some(x) = self.next() {\n            best = match best {\n                Some(b) => if x < b { Some(x) } else { Some(b) },\n                None => Some(x),\n            };\n        }\n        best\n    }\n\n    fn max_by_key<B: Ord>(mut self, f: impl Fn(Self::Item) -> B) -> Option<Self::Item> {\n        let mut best = None;\n        let mut best_k = None;\n        while let Some(x) = self.next() {\n            let k = f(x);\n            let better = match best_k {\n                Some(bk) => k >= bk,\n                None => true,\n            };\n            if better {\n                best = Some(x);\n                best_k = Some(k);\n            }\n        }\n        best\n    }\n\n    fn min_by_key<B: Ord>(mut self, f: impl Fn(Self::Item) -> B) -> Option<Self::Item> {\n        let mut best = None;\n        let mut best_k = None;\n        while let Some(x) = self.next() {\n            let k = f(x);\n            let better = match best_k {\n                Some(bk) => k < bk,\n                None => true,\n            };\n            if better {\n                best = Some(x);\n                best_k = Some(k);\n            }\n        }\n        best\n    }\n\n    // ---- adapters ----\n\n    #[fresh]\n    fn map<B>(self, f: impl Fn(Self::Item) -> B) -> Map<Self, Self::Item, B> {\n        Map { iter: self, f: f }\n    }\n\n    #[fresh]\n    fn filter(self, p: impl Fn(Self::Item) -> Bool) -> Filter<Self, Self::Item> {\n        Filter { iter: self, p: p }\n    }\n\n    #[fresh]\n    fn filter_map<B>(self, f: impl Fn(Self::Item) -> Option<B>) -> FilterMap<Self, Self::Item, B> {\n        FilterMap { iter: self, f: f }\n    }\n\n    #[fresh]\n    fn enumerate(self) -> Enumerate<Self> {\n        Enumerate { iter: self, i: 0 }\n    }\n\n    #[fresh]\n    fn zip<U: Iterator>(self, other: U) -> Zip<Self, U> {\n        Zip { a: self, b: other }\n    }\n\n    #[fresh]\n    fn chain<U: Iterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U> {\n        Chain { a: self, b: other, first: true }\n    }\n\n    #[fresh]\n    fn take(self, n: Int) -> Take<Self> {\n        Take { iter: self, n: n }\n    }\n\n    #[fresh]\n    fn skip(self, n: Int) -> Skip<Self> {\n        Skip { iter: self, n: n }\n    }\n\n    #[fresh]\n    fn take_while(self, p: impl Fn(Self::Item) -> Bool) -> TakeWhile<Self, Self::Item> {\n        TakeWhile { iter: self, p: p, done: false }\n    }\n\n    #[fresh]\n    fn skip_while(self, p: impl Fn(Self::Item) -> Bool) -> SkipWhile<Self, Self::Item> {\n        SkipWhile { iter: self, p: p, started: false }\n    }\n\n    #[fresh]\n    fn step_by(self, step: Int) -> StepBy<Self> {\n        StepBy { iter: self, step: step, first: true }\n    }\n\n    #[fresh]\n    fn peekable(self) -> Peekable<Self, Self::Item> {\n        Peekable { iter: self, peeked: None, has: false }\n    }\n}\n\n// An iterator that can also produce its elements from the back.\ntrait DoubleEndedIterator: Iterator {\n    fn next_back(&mut self) -> Option<Self::Item>;\n\n    #[fresh]\n    fn rev(self) -> Rev<Self> {\n        Rev { iter: self }\n    }\n}\n\n// Conversion into an iterator (what a `for` loop iterates over).\ntrait IntoIterator {\n    type Item;\n    type IntoIter;\n\n    #[fresh]\n    fn into_iter(self) -> Self::IntoIter;\n}\n\n// Building a collection from an iterator (`collect`).\ntrait FromIterator<A> {\n    #[fresh]\n    fn from_iter<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\ntrait Sum<A> {\n    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\ntrait Product<A> {\n    fn product<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\n// ---- adapters ----\n\nstruct Map<I, A, B> {\n    iter: I,\n    f: fn(A) -> B,\n}\n\nimpl<I: Iterator<Item = A>, A, B> Iterator for Map<I, A, B> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        match self.iter.next() {\n            Some(x) => Some((self.f)(x)),\n            None => None,\n        }\n    }\n}\n\nstruct Filter<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for Filter<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        while let Some(x) = self.iter.next() {\n            if (self.p)(x) {\n                return Some(x);\n            }\n        }\n        None\n    }\n}\n\nstruct FilterMap<I, A, B> {\n    iter: I,\n    f: fn(A) -> Option<B>,\n}\n\nimpl<I: Iterator<Item = A>, A, B> Iterator for FilterMap<I, A, B> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        while let Some(x) = self.iter.next() {\n            match (self.f)(x) {\n                Some(y) => {\n                    return Some(y);\n                }\n                None => {}\n            }\n        }\n        None\n    }\n}\n\nstruct Enumerate<I> {\n    iter: I,\n    mut i: Int,\n}\n\nimpl<I: Iterator> Iterator for Enumerate<I> {\n    type Item = (Int, I::Item);\n\n    fn next(&mut self) -> Option<(Int, I::Item)> {\n        match self.iter.next() {\n            Some(x) => {\n                let i = self.i;\n                self.i = i + 1;\n                Some((i, x))\n            }\n            None => None,\n        }\n    }\n}\n\nstruct Zip<A, B> {\n    a: A,\n    b: B,\n}\n\nimpl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {\n    type Item = (A::Item, B::Item);\n\n    fn next(&mut self) -> Option<(A::Item, B::Item)> {\n        match self.a.next() {\n            Some(x) => match self.b.next() {\n                Some(y) => Some((x, y)),\n                None => None,\n            },\n            None => None,\n        }\n    }\n}\n\nstruct Chain<A, B> {\n    a: A,\n    b: B,\n    mut first: Bool,\n}\n\nimpl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {\n    type Item = A::Item;\n\n    fn next(&mut self) -> Option<A::Item> {\n        if self.first {\n            match self.a.next() {\n                Some(x) => {\n                    return Some(x);\n                }\n                None => {\n                    self.first = false;\n                }\n            }\n        }\n        self.b.next()\n    }\n}\n\nstruct Take<I> {\n    iter: I,\n    mut n: Int,\n}\n\nimpl<I: Iterator> Iterator for Take<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n <= 0 {\n            return None;\n        }\n        self.n = self.n - 1;\n        self.iter.next()\n    }\n}\n\nstruct Skip<I> {\n    iter: I,\n    mut n: Int,\n}\n\nimpl<I: Iterator> Iterator for Skip<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        while self.n > 0 {\n            self.n = self.n - 1;\n            if self.iter.next().is_none() {\n                return None;\n            }\n        }\n        self.iter.next()\n    }\n}\n\nstruct TakeWhile<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n    mut done: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for TakeWhile<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.done {\n            return None;\n        }\n        match self.iter.next() {\n            Some(x) => {\n                if (self.p)(x) {\n                    return Some(x);\n                }\n                self.done = true;\n                None\n            }\n            None => None,\n        }\n    }\n}\n\nstruct SkipWhile<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n    mut started: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for SkipWhile<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.started {\n            return self.iter.next();\n        }\n        while let Some(x) = self.iter.next() {\n            if !(self.p)(x) {\n                self.started = true;\n                return Some(x);\n            }\n        }\n        None\n    }\n}\n\nstruct StepBy<I> {\n    iter: I,\n    step: Int,\n    mut first: Bool,\n}\n\nimpl<I: Iterator> Iterator for StepBy<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.first {\n            self.first = false;\n            return self.iter.next();\n        }\n        self.iter.nth(self.step - 1)\n    }\n}\n\nstruct Peekable<I, A> {\n    iter: I,\n    mut peeked: Option<A>,\n    mut has: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Peekable<I, A> {\n    // peek returns the next element without consuming it.\n    fn peek(&mut self) -> Option<A> {\n        if !self.has {\n            self.peeked = self.iter.next();\n            self.has = true;\n        }\n        self.peeked\n    }\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for Peekable<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.has {\n            self.has = false;\n            return self.peeked;\n        }\n        self.iter.next()\n    }\n}\n\nstruct Rev<I> {\n    iter: I,\n}\n\nimpl<I: DoubleEndedIterator> Iterator for Rev<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        self.iter.next_back()\n    }\n}\n\n// ---- ranges ----\n\n// `start..end`: the integers from start up to (excluding) end.\nstruct Range {\n    mut start: Int,\n    mut end: Int,\n}\n\nimpl Range {\n    fn contains(&self, x: Int) -> Bool {\n        self.start <= x && x < self.end\n    }\n\n    fn len(&self) -> Int {\n        if self.end > self.start {\n            self.end - self.start\n        } else {\n            0\n        }\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.start >= self.end\n    }\n}\n\nimpl Iterator for Range {\n    type Item = Int;\n\n    fn next(&mut self) -> Option<Int> {\n        if self.start < self.end {\n            let x = self.start;\n            self.start = x + 1;\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\nimpl DoubleEndedIterator for Range {\n    fn next_back(&mut self) -> Option<Int> {\n        if self.start < self.end {\n            self.end = self.end - 1;\n            Some(self.end)\n        } else {\n            None\n        }\n    }\n}\n\n// `start..=end`: the integers from start up to (including) end.\nstruct RangeInclusive {\n    mut start: Int,\n    mut end: Int,\n}\n\nimpl RangeInclusive {\n    fn contains(&self, x: Int) -> Bool {\n        self.start <= x && x <= self.end\n    }\n}\n\nimpl Iterator for RangeInclusive {\n    type Item = Int;\n\n    fn next(&mut self) -> Option<Int> {\n        if self.start <= self.end {\n            let x = self.start;\n            if x == self.end {\n                // stop without overflowing at the largest Int\n                self.end = x - 1;\n                self.start = x;\n            } else {\n                self.start = x + 1;\n            }\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\nimpl DoubleEndedIterator for RangeInclusive {\n    fn next_back(&mut self) -> Option<Int> {\n        if self.start <= self.end {\n            let x = self.end;\n            if x == self.start {\n                self.start = x + 1;\n                self.end = x;\n            } else {\n                self.end = x - 1;\n            }\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\n// ---- Vec ----\n\n// Iter iterates over a Vec by index. Like a `for` loop over a Vec, it sees\n// elements pushed while iterating.\nstruct Iter<T> {\n    v: Vec<T>,\n    mut i: Int,\n    mut end: Int,\n}\n\nimpl<T> Vec<T> {\n    #[fresh]\n    fn iter(&self) -> Iter<T> {\n        Iter { v: *self, i: 0, end: -1 }\n    }\n}\n\nimpl<T> Iterator for Iter<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        let n = if self.end < 0 { self.v.len() } else { self.end };\n        if self.i < n {\n            let x = self.v.get(self.i);\n            self.i = self.i + 1;\n            x\n        } else {\n            None\n        }\n    }\n}\n\nimpl<T> DoubleEndedIterator for Iter<T> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.end < 0 {\n            self.end = self.v.len();\n        }\n        if self.i < self.end {\n            self.end = self.end - 1;\n            self.v.get(self.end)\n        } else {\n            None\n        }\n    }\n}\n\nimpl<T> IntoIterator for Vec<T> {\n    type Item = T;\n    type IntoIter = Iter<T>;\n\n    fn into_iter(self) -> Iter<T> {\n        self.iter()\n    }\n}\n\nimpl<T> FromIterator<T> for Vec<T> {\n    fn from_iter<I: Iterator<Item = T>>(mut iter: I) -> Vec<T> {\n        let mut v = Vec::new();\n        while let Some(x) = iter.next() {\n            v.push(x);\n        }\n        v\n    }\n}\n\nimpl FromIterator<String> for String {\n    fn from_iter<I: Iterator<Item = String>>(mut iter: I) -> String {\n        let mut parts = Vec::new();\n        while let Some(s) = iter.next() {\n            parts.push(s);\n        }\n        parts.join(\"\")\n    }\n}\n\nimpl Sum<Int> for Int {\n    fn sum<I: Iterator<Item = Int>>(mut iter: I) -> Int {\n        let mut s = 0;\n        while let Some(x) = iter.next() {\n            s = s + x;\n        }\n        s\n    }\n}\n\nimpl Product<Int> for Int {\n    fn product<I: Iterator<Item = Int>>(mut iter: I) -> Int {\n        let mut p = 1;\n        while let Some(x) = iter.next() {\n            p = p * x;\n        }\n        p\n    }\n}\n",
    );
    core_file(
        v,
        "json.kek",
        "// JSON (RFC 8259) for Value (lib/core/serde.kek).\n//\n//   Json::parse(s) -> Result<Value, SerdeError>\n//   Json::render(&v) / Json::render_pretty(&v) -> String\n//   Json::from_str::<T>(s) -> Result<T, SerdeError>\n//   Json::to_string(&x) / Json::to_string_pretty(&x) -> String\n//\n// Numbers with a fraction or an exponent become Value::Float (as written;\n// rendering writes TOML's inf and nan as null);\n// integers outside the 64-bit range are an error. Objects keep the order\n// of their keys; a repeated key is an error. Nesting is limited to 256\n// levels.\n\nstruct Json {}\n\nimpl Json {\n    fn parse(s: String) -> Result<Value, SerdeError> {\n        let mut p = __JsonParser { s: s, n: s.len(), i: 0 };\n        p.ws();\n        let v = p.value(0)?;\n        p.ws();\n        if p.i < p.n {\n            return Err(p.fail(\"unexpected data after the value\"));\n        }\n        Ok(v)\n    }\n\n    fn render(v: &Value) -> String {\n        let mut out = Vec::new();\n        __json_render(&mut out, v, -1, 0);\n        out.join(\"\")\n    }\n\n    // render_pretty indents by two spaces.\n    fn render_pretty(v: &Value) -> String {\n        let mut out = Vec::new();\n        __json_render(&mut out, v, 0, 0);\n        out.join(\"\")\n    }\n\n    fn from_str<T: Deserialize>(s: String) -> Result<T, SerdeError> {\n        T::from_value(&Json::parse(s)?)\n    }\n\n    fn to_string<T: Serialize>(x: &T) -> String {\n        Json::render(&x.to_value())\n    }\n\n    fn to_string_pretty<T: Serialize>(x: &T) -> String {\n        Json::render_pretty(&x.to_value())\n    }\n}\n\n// indent < 0 renders on one line.\nfn __json_render(mut out: Vec<String>, v: &Value, indent: Int, depth: Int) {\n    match v {\n        Value::Null => out.push(\"null\"),\n        Value::Bool(b) => out.push(if b { \"true\" } else { \"false\" }),\n        Value::Int(n) => out.push(n.to_string()),\n        Value::Float(f) => out.push(__json_float(f)),\n        Value::Str(s) => out.push(__serde_quote(s)),\n        Value::Seq(xs) => {\n            if xs.len() == 0 {\n                out.push(\"[]\");\n                return;\n            }\n            out.push(\"[\");\n            let mut first = true;\n            for x in xs.iter() {\n                if !first {\n                    out.push(\",\");\n                }\n                first = false;\n                __json_newline(out, indent, depth + 1);\n                __json_render(out, x, indent, depth + 1);\n            }\n            __json_newline(out, indent, depth);\n            out.push(\"]\");\n        }\n        Value::Map(es) => {\n            if es.len() == 0 {\n                out.push(\"{}\");\n                return;\n            }\n            out.push(\"{\");\n            let mut first = true;\n            for e in es.iter() {\n                if !first {\n                    out.push(\",\");\n                }\n                first = false;\n                __json_newline(out, indent, depth + 1);\n                out.push(__serde_quote(e.0));\n                out.push(if indent < 0 { \":\" } else { \": \" });\n                __json_render(out, &e.1, indent, depth + 1);\n            }\n            __json_newline(out, indent, depth);\n            out.push(\"}\");\n        }\n    }\n}\n\n// __json_float is a float in JSON's syntax: TOML's inf and nan have no\n// JSON form and become null (as in JavaScript), a leading `+` is dropped.\nfn __json_float(f: String) -> String {\n    let g = if f.starts_with(\"+\") {\n        f.slice(1, f.len())\n    } else {\n        f\n    };\n    if g == \"inf\" || g == \"-inf\" || g == \"nan\" || g == \"-nan\" {\n        return \"null\";\n    }\n    g\n}\n\nfn __json_newline(mut out: Vec<String>, indent: Int, depth: Int) {\n    if indent >= 0 {\n        out.push(\"\\n\");\n        for _ in 0..depth {\n            out.push(\"  \");\n        }\n    }\n}\n\nstruct __JsonParser {\n    s: String,\n    n: Int,\n    mut i: Int,\n}\n\nimpl __JsonParser {\n    fn peek(&self) -> Int {\n        if self.i < self.n {\n            self.s.char_at(self.i).unwrap_or(-1)\n        } else {\n            -1\n        }\n    }\n\n    fn fail(&self, msg: String) -> SerdeError {\n        __serde_at(self.s, self.i, msg)\n    }\n\n    fn ws(&mut self) {\n        while self.i < self.n {\n            let c = self.peek();\n            if c == 32 || c == 9 || c == 10 || c == 13 {\n                self.i = self.i + 1;\n            } else {\n                return;\n            }\n        }\n    }\n\n    fn word(&mut self, w: String, v: Value) -> Result<Value, SerdeError> {\n        if self.s.slice(self.i, self.i + w.len()) == w {\n            self.i = self.i + w.len();\n            Ok(v)\n        } else {\n            Err(self.fail(\"unexpected character\"))\n        }\n    }\n\n    fn value(&mut self, depth: Int) -> Result<Value, SerdeError> {\n        if depth > 256 {\n            return Err(self.fail(\"nested too deeply\"));\n        }\n        let c = self.peek();\n        if c == 123 {\n            return self.object(depth);\n        }\n        if c == 91 {\n            return self.array(depth);\n        }\n        if c == 34 {\n            return Ok(Value::Str(self.string()?));\n        }\n        if c == 116 {\n            return self.word(\"true\", Value::Bool(true));\n        }\n        if c == 102 {\n            return self.word(\"false\", Value::Bool(false));\n        }\n        if c == 110 {\n            return self.word(\"null\", Value::Null);\n        }\n        if c == 45 || (c >= 48 && c <= 57) {\n            return self.number();\n        }\n        if c < 0 {\n            return Err(self.fail(\"unexpected end of input\"));\n        }\n        Err(self.fail(\"unexpected character\"))\n    }\n\n    fn digits(&mut self) -> Int {\n        let start = self.i;\n        while self.peek() >= 48 && self.peek() <= 57 {\n            self.i = self.i + 1;\n        }\n        self.i - start\n    }\n\n    fn number(&mut self) -> Result<Value, SerdeError> {\n        let start = self.i;\n        if self.peek() == 45 {\n            self.i = self.i + 1;\n        }\n        let int_start = self.i;\n        let nd = self.digits();\n        if nd == 0 {\n            return Err(self.fail(\"expected a digit\"));\n        }\n        if nd > 1 && self.s.char_at(int_start).unwrap_or(0) == 48 {\n            return Err(__serde_at(self.s, int_start, \"leading zero in a number\"));\n        }\n        let mut float = false;\n        if self.peek() == 46 {\n            self.i = self.i + 1;\n            if self.digits() == 0 {\n                return Err(self.fail(\"expected a digit after the decimal point\"));\n            }\n            float = true;\n        }\n        if self.peek() == 101 || self.peek() == 69 {\n            self.i = self.i + 1;\n            if self.peek() == 43 || self.peek() == 45 {\n                self.i = self.i + 1;\n            }\n            if self.digits() == 0 {\n                return Err(self.fail(\"expected a digit in the exponent\"));\n            }\n            float = true;\n        }\n        let text = self.s.slice(start, self.i);\n        if float {\n            return Ok(Value::Float(text));\n        }\n        match text.parse_int() {\n            Some(n) => Ok(Value::Int(n)),\n            None => Err(__serde_at(self.s, start, \"integer out of range\")),\n        }\n    }\n\n    fn string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 1;\n        let mut parts = Vec::new();\n        let mut start = self.i;\n        while true {\n            if self.i >= self.n {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            let c = self.peek();\n            if c == 34 {\n                parts.push(self.s.slice(start, self.i));\n                self.i = self.i + 1;\n                return Ok(parts.join(\"\"));\n            }\n            if c < 32 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            if c == 92 {\n                parts.push(self.s.slice(start, self.i));\n                self.i = self.i + 1;\n                let e = self.peek();\n                if e == 34 {\n                    parts.push(\"\\\"\");\n                } else if e == 92 {\n                    parts.push(\"\\\\\");\n                } else if e == 47 {\n                    parts.push(\"/\");\n                } else if e == 98 {\n                    parts.push(String::from_char(8));\n                } else if e == 102 {\n                    parts.push(String::from_char(12));\n                } else if e == 110 {\n                    parts.push(\"\\n\");\n                } else if e == 114 {\n                    parts.push(\"\\r\");\n                } else if e == 116 {\n                    parts.push(\"\\t\");\n                } else if e == 117 {\n                    let mut x = 0;\n                    for k in 1..5 {\n                        let d = __serde_hex_value(self.s.char_at(self.i + k).unwrap_or(0));\n                        if d < 0 {\n                            return Err(self.fail(\"bad \\\\u escape\"));\n                        }\n                        x = x * 16 + d;\n                    }\n                    // surrogate halves are code units: two escapes make a pair\n                    parts.push(String::from_char(x));\n                    self.i = self.i + 4;\n                } else {\n                    return Err(self.fail(\"bad escape\"));\n                }\n                self.i = self.i + 1;\n                start = self.i;\n            } else {\n                self.i = self.i + 1;\n            }\n        }\n        Err(self.fail(\"unexpected end of input\"))\n    }\n\n    fn array(&mut self, depth: Int) -> Result<Value, SerdeError> {\n        self.i = self.i + 1;\n        let mut out = Vec::new();\n        self.ws();\n        if self.peek() == 93 {\n            self.i = self.i + 1;\n            return Ok(Value::Seq(out));\n        }\n        while true {\n            self.ws();\n            out.push(self.value(depth + 1)?);\n            self.ws();\n            let c = self.peek();\n            self.i = self.i + 1;\n            if c == 93 {\n                return Ok(Value::Seq(out));\n            }\n            if c != 44 {\n                self.i = self.i - 1;\n                return Err(self.fail(\"expected `,` or `]`\"));\n            }\n        }\n        Err(self.fail(\"unexpected end of input\"))\n    }\n\n    fn object(&mut self, depth: Int) -> Result<Value, SerdeError> {\n        self.i = self.i + 1;\n        let mut out = Vec::new();\n        let mut seen = HashSet::new();\n        self.ws();\n        if self.peek() == 125 {\n            self.i = self.i + 1;\n            return Ok(Value::Map(out));\n        }\n        while true {\n            self.ws();\n            if self.peek() != 34 {\n                return Err(self.fail(\"expected a string key\"));\n            }\n            let at = self.i;\n            let k = self.string()?;\n            if !seen.insert(k) {\n                return Err(__serde_at(self.s, at, \"duplicate key\"));\n            }\n            self.ws();\n            if self.peek() != 58 {\n                return Err(self.fail(\"expected `:`\"));\n            }\n            self.i = self.i + 1;\n            self.ws();\n            let v = self.value(depth + 1)?;\n            out.push((k, v));\n            self.ws();\n            let c = self.peek();\n            self.i = self.i + 1;\n            if c == 125 {\n                return Ok(Value::Map(out));\n            }\n            if c != 44 {\n                self.i = self.i - 1;\n                return Err(self.fail(\"expected `,` or `}`\"));\n            }\n        }\n        Err(self.fail(\"unexpected end of input\"))\n    }\n}\n",
    );
    core_file(
        v,
        "labeled.kek",
        "// Information flow (docs/authz-flow.md): a value labeled L, such as\n// personal data (`Labeled<PII, String>`), cannot reach an output that\n// takes plain values: a log, a response, the store, the network, an error\n// message.\n//\n// The field is private to the core library: identifiers starting with\n// `__` are reserved for the core library and the runtime prelude, so a\n// program can neither read `__value` nor build `Labeled { ... }`. Labeled\n// implements no trait that renders, compares, orders or hashes it, so it\n// cannot reach an output through `+`, `to_string`, `==`, a capability\n// argument or a generic function.\n//\n// Computing on the contents happens only inside the closures given to map,\n// zip and and_then, whose results are labeled again: a branch on a labeled\n// value can only be taken there (the \"program counter\" carries the label).\n// The type checker makes these closures unable to leak by side effects:\n// they take the contents as shared (read-only) values and capture no\n// mutable state and no function values (closures cannot capture\n// capabilities anyway). So a program that does not declassify satisfies\n// non-interference: its plain outputs do not depend on labeled inputs\n// (lean/Kekkai/Flow.lean).\n//\n// The only ways out are the declassifications below, which `kek caps`\n// lists and `kek assure` records (flow.declassify):\n//\n//   p.mask()              Labeled<L, String> -> String, for display\n//   p.hash()              a fixed (unseeded) hash as 16 hex digits\n//   p.expose_unchecked()  the value itself (the escape hatch)\n\n// PII labels personal data.\nstruct PII {}\n\nimpl PII {\n    // label labels x as personal data.\n    fn label<T>(x: T) -> Labeled<PII, T> {\n        Labeled { __value: x }\n    }\n}\n\nstruct Labeled<L, T> {\n    __value: T,\n}\n\nimpl<L, T> Labeled<L, T> {\n    // new labels x (the label comes from the expected type:\n    // `let e: Labeled<PII, String> = Labeled::new(s)`).\n    fn new(x: T) -> Labeled<L, T> {\n        Labeled { __value: x }\n    }\n\n    // map computes on the contents; the result keeps the label.\n    fn map<U>(&self, f: fn(&T) -> U) -> Labeled<L, U> {\n        Labeled { __value: f(&self.__value) }\n    }\n\n    // zip combines two values of the same label.\n    fn zip<U, V>(&self, other: &Labeled<L, U>, f: fn(&T, &U) -> V) -> Labeled<L, V> {\n        Labeled { __value: f(&self.__value, &other.__value) }\n    }\n\n    // and_then computes a labeled value from the contents.\n    fn and_then<U>(&self, f: fn(&T) -> Labeled<L, U>) -> Labeled<L, U> {\n        f(&self.__value)\n    }\n\n    // expose_unchecked returns the value: a declassification.\n    fn expose_unchecked(&self) -> T {\n        self.__value\n    }\n}\n\nimpl<L, T: Hash> Labeled<L, T> {\n    // hash is the default hasher's (fixed, unseeded) hash of the value, as\n    // 16 lowercase hex digits: a declassification that keeps equality (to\n    // join or count records) but not the value.\n    fn hash(&self) -> String {\n        let mut h = DefaultHasher::new();\n        self.__value.hash(&mut h);\n        __labeled_hex(h.finish())\n    }\n}\n\nimpl<L> Labeled<L, String> {\n    // mask keeps the first character and everything from the last `@` on\n    // (the domain of an e-mail address) and replaces every other\n    // character (code point) by `*`: \"alice@example.com\" ->\n    // \"a****@example.com\", \"bob\" -> \"b**\". When the part before the `@` is\n    // a single character it is masked too (\"a@x.com\" -> \"*@x.com\", \"x\" ->\n    // \"*\"), and \"\" stays \"\".\n    fn mask(&self) -> String {\n        let s = self.__value;\n        if s.len() == 0 {\n            return \"\";\n        }\n        let cs = s.split(\"\");\n        let n = cs.len();\n        let mut at = n;\n        let mut i = 0;\n        while i < n {\n            if cs.get(i).unwrap_or(\"\") == \"@\" {\n                at = i;\n            }\n            i = i + 1;\n        }\n        let mut parts = Vec::new();\n        for j in 0..at {\n            if j == 0 && at > 1 {\n                parts.push(cs.get(0).unwrap_or(\"\"));\n            } else {\n                parts.push(\"*\");\n            }\n        }\n        for j in at..n {\n            parts.push(cs.get(j).unwrap_or(\"\"));\n        }\n        parts.join(\"\")\n    }\n}\n\nimpl<L, T: Clone> Clone for Labeled<L, T> {\n    fn clone(&self) -> Labeled<L, T> {\n        Labeled { __value: self.__value.clone() }\n    }\n}\n\n// __labeled_hex renders x as 16 lowercase hex digits (two's complement).\nfn __labeled_hex(x: Int) -> String {\n    let digits = \"0123456789abcdef\";\n    let mut parts = Vec::new();\n    let mut i = 15;\n    while i >= 0 {\n        let d = x.ushr(i * 4).bit_and(15);\n        parts.push(digits.slice(d, d + 1));\n        i = i - 1;\n    }\n    parts.join(\"\")\n}\n",
    );
    core_file(
        v,
        "serde.kek",
        "// Serialization (docs/serde.md): a type converts to and from a Value, the\n// data model shared by every format; a format (Json, Toml) only converts\n// between a Value and text.\n//\n//   #[derive(Serialize, Deserialize)]\n//   struct Config { name: String, port: Port, tags: Vec<String> }\n//\n//   let c: Config = Toml::from_str(text)?;\n//   Json::to_string(&c)\n//\n// What may cross the boundary is decided here once, for every format:\n//\n//   - Labeled<L, T> implements Deserialize but not Serialize: input can be\n//     labeled as it is read (a password never exists as a plain String),\n//     and labeled data cannot be written out.\n//   - Can<A, r> and the capabilities implement neither: a permission cannot\n//     be forged from input.\n//   - a derived Deserialize checks the predicates of refined aliases\n//     (`type Port = Int where 0 < self && self < 65536`) of the fields.\n//\n// Error messages never contain the data, only its shape and where it is,\n// so a SerdeError may be logged or returned to a client.\n\n// Value is a parsed document. Map keeps the order of its keys (but `==`\n// ignores it); Float keeps the number as written (the language has no\n// floating point type).\n#[derive(Clone)]\nenum Value {\n    Null,\n    Bool(Bool),\n    Int(Int),\n    Float(String),\n    Str(String),\n    Seq(Vec<Value>),\n    Map(Vec<(String, Value)>),\n}\n\n// SerdeError is a parse error (line and column, 1-based) or a value of the\n// wrong shape (path, such as `servers[1].port`).\n#[derive(PartialEq, Clone)]\nstruct SerdeError {\n    path: String,\n    line: Int,\n    col: Int,\n    msg: String,\n}\n\ntrait Serialize {\n    fn to_value(&self) -> Value;\n}\n\n// from_value builds an owned value from what it reads (`#[owned]`: the\n// result is not borrowed from v, as with clone).\ntrait Deserialize {\n    #[owned]\n    fn from_value(v: &Value) -> Result<Self, SerdeError>;\n}\n\nimpl SerdeError {\n    fn new(msg: String) -> SerdeError {\n        SerdeError { path: \"\", line: 0, col: 0, msg: msg }\n    }\n\n    // in_field is the error inside the field (or map key) name.\n    fn in_field(&self, name: String) -> SerdeError {\n        let rest = if self.path == \"\" || self.path.starts_with(\"[\") {\n            self.path\n        } else {\n            \".\" + self.path\n        };\n        SerdeError { path: name + rest, line: self.line, col: self.col, msg: self.msg }\n    }\n\n    // in_index is the error inside element i of a sequence.\n    fn in_index(&self, i: Int) -> SerdeError {\n        let rest = if self.path == \"\" || self.path.starts_with(\"[\") {\n            self.path\n        } else {\n            \".\" + self.path\n        };\n        SerdeError {\n            path: \"[\" + i.to_string() + \"]\" + rest,\n            line: self.line,\n            col: self.col,\n            msg: self.msg,\n        }\n    }\n\n    fn message(&self) -> String {\n        let mut m = self.msg;\n        if self.path != \"\" {\n            m = self.path + \": \" + m;\n        }\n        if self.line > 0 {\n            m = \"line \" + self.line.to_string() + \", column \" + self.col.to_string() + \": \" + m;\n        }\n        m\n    }\n}\n\nimpl Value {\n    // kind names the shape of the value for messages.\n    fn kind(&self) -> String {\n        match self {\n            Value::Null => \"null\",\n            Value::Bool(_) => \"a boolean\",\n            Value::Int(_) => \"an integer\",\n            Value::Float(_) => \"a float\",\n            Value::Str(_) => \"a string\",\n            Value::Seq(_) => \"a sequence\",\n            Value::Map(_) => \"a map\",\n        }\n    }\n\n    // get is the value of key in a map.\n    fn get(&self, key: String) -> Option<&Value> {\n        match self {\n            Value::Map(es) => {\n                for e in es.iter() {\n                    if e.0 == key {\n                        return Some(&e.1);\n                    }\n                }\n                None\n            }\n            _ => None,\n        }\n    }\n\n    fn mismatch(&self, what: String) -> SerdeError {\n        SerdeError::new(\"expected \" + what + \", found \" + self.kind())\n    }\n\n    // tagged is the value of an enum variant with fields: `{\"name\": payload}`.\n    fn tagged(name: String, payload: Value) -> Value {\n        let mut es = Vec::new();\n        es.push((name, payload));\n        Value::Map(es)\n    }\n\n    // ---- used by #[derive(Deserialize)] ----\n\n    // expect_map checks that the value is a map (the fields of `ty`).\n    fn expect_map(&self, ty: String) -> Result<(), SerdeError> {\n        match self {\n            Value::Map(_) => Ok(()),\n            _ => Err(self.mismatch(\"a map (`\" + ty + \"`)\")),\n        }\n    }\n\n    // field decodes the field key of a map. A missing field reads as null,\n    // so an Option field may be left out.\n    #[owned]\n    fn field<T: Deserialize>(&self, key: String) -> Result<T, SerdeError> {\n        match self.get(key) {\n            Some(x) => match T::from_value(x) {\n                Ok(t) => Ok(t),\n                Err(e) => Err(e.in_field(key)),\n            },\n            None => match T::from_value(&Value::Null) {\n                Ok(t) => Ok(t),\n                Err(_) => Err(SerdeError::new(\"missing field `\" + key + \"`\")),\n            },\n        }\n    }\n\n    // decode_in decodes the value, reporting errors inside path.\n    #[owned]\n    fn decode_in<T: Deserialize>(&self, path: String) -> Result<T, SerdeError> {\n        match T::from_value(self) {\n            Ok(t) => Ok(t),\n            Err(e) => Err(e.in_field(path)),\n        }\n    }\n\n    // element decodes element i of a sequence of n elements (a tuple\n    // variant's fields), reporting errors inside path.\n    #[owned]\n    fn element<T: Deserialize>(&self, path: String, i: Int, n: Int) -> Result<T, SerdeError> {\n        match self {\n            Value::Seq(xs) => {\n                if xs.len() != n {\n                    return Err(\n                        SerdeError::new(\n                            \"expected \" + n.to_string() + \" elements, found \" + xs.len().to_string(),\n                        ).in_field(path),\n                    );\n                }\n                match xs.get(i) {\n                    Some(x) => match T::from_value(x) {\n                        Ok(t) => Ok(t),\n                        Err(e) => Err(e.in_index(i).in_field(path)),\n                    },\n                    None => Err(SerdeError::new(\"missing element\").in_field(path)),\n                }\n            }\n            _ => Err(self.mismatch(\"a sequence\").in_field(path)),\n        }\n    }\n\n    // variant_name is the variant of an enum value: `\"Name\"` for a variant\n    // without fields, `{\"Name\": payload}` otherwise.\n    fn variant_name(&self, ty: String) -> Result<String, SerdeError> {\n        match self {\n            Value::Str(s) => Ok(s),\n            Value::Map(es) => {\n                if es.len() != 1 {\n                    return Err(SerdeError::new(\"expected one variant of `\" + ty + \"`\"));\n                }\n                match es.get(0) {\n                    Some(e) => Ok(e.0),\n                    None => Err(SerdeError::new(\"expected one variant of `\" + ty + \"`\")),\n                }\n            }\n            _ => Err(self.mismatch(\"a variant of `\" + ty + \"`\")),\n        }\n    }\n\n    // variant_payload is the payload of an enum value (null for `\"Name\"`).\n    fn variant_payload(&self) -> &Value {\n        match self {\n            Value::Map(es) => match es.get(0) {\n                Some(e) => &e.1,\n                None => &Value::Null,\n            },\n            _ => &Value::Null,\n        }\n    }\n\n    fn unknown_variant(&self, ty: String, name: String) -> SerdeError {\n        SerdeError::new(\"unknown variant `\" + name + \"` of `\" + ty + \"`\")\n    }\n\n    // refused is the error for a field whose refined type does not hold.\n    fn refused(&self, path: String, ty: String) -> SerdeError {\n        SerdeError::new(\"the value is not a valid `\" + ty + \"`\").in_field(path)\n    }\n}\n\n// Maps are equal when they have the same keys with equal values, in any\n// order (the parsers refuse repeated keys).\nimpl PartialEq for Value {\n    fn eq(&self, other: &Value) -> Bool {\n        match self {\n            Value::Map(a) => match other {\n                Value::Map(b) => {\n                    if a.len() != b.len() {\n                        return false;\n                    }\n                    for e in a.iter() {\n                        match other.get(e.0) {\n                            Some(x) => {\n                                if !(e.1 == *x) {\n                                    return false;\n                                }\n                            }\n                            None => {\n                                return false;\n                            }\n                        }\n                    }\n                    true\n                }\n                _ => false,\n            },\n            Value::Null => match other {\n                Value::Null => true,\n                _ => false,\n            },\n            Value::Bool(x) => match other {\n                Value::Bool(y) => x == y,\n                _ => false,\n            },\n            Value::Int(x) => match other {\n                Value::Int(y) => x == y,\n                _ => false,\n            },\n            Value::Float(x) => match other {\n                Value::Float(y) => x == y,\n                _ => false,\n            },\n            Value::Str(x) => match other {\n                Value::Str(y) => x == y,\n                _ => false,\n            },\n            Value::Seq(xs) => match other {\n                Value::Seq(ys) => xs == ys,\n                _ => false,\n            },\n        }\n    }\n}\n\nimpl Eq for Value {}\n\n// ---- the core types ----\n\nimpl Serialize for Value {\n    fn to_value(&self) -> Value {\n        self.clone()\n    }\n}\n\nimpl Deserialize for Value {\n    fn from_value(v: &Value) -> Result<Value, SerdeError> {\n        Ok(v.clone())\n    }\n}\n\nimpl Serialize for Int {\n    fn to_value(&self) -> Value {\n        Value::Int(*self)\n    }\n}\n\nimpl Deserialize for Int {\n    fn from_value(v: &Value) -> Result<Int, SerdeError> {\n        match v {\n            Value::Int(n) => Ok(n),\n            _ => Err(v.mismatch(\"an integer\")),\n        }\n    }\n}\n\nimpl Serialize for Bool {\n    fn to_value(&self) -> Value {\n        Value::Bool(*self)\n    }\n}\n\nimpl Deserialize for Bool {\n    fn from_value(v: &Value) -> Result<Bool, SerdeError> {\n        match v {\n            Value::Bool(b) => Ok(b),\n            _ => Err(v.mismatch(\"a boolean\")),\n        }\n    }\n}\n\nimpl Serialize for String {\n    fn to_value(&self) -> Value {\n        Value::Str(*self)\n    }\n}\n\nimpl Deserialize for String {\n    fn from_value(v: &Value) -> Result<String, SerdeError> {\n        match v {\n            Value::Str(s) => Ok(s),\n            _ => Err(v.mismatch(\"a string\")),\n        }\n    }\n}\n\nimpl Serialize for () {\n    fn to_value(&self) -> Value {\n        Value::Null\n    }\n}\n\nimpl Deserialize for () {\n    fn from_value(v: &Value) -> Result<(), SerdeError> {\n        match v {\n            Value::Null => Ok(()),\n            _ => Err(v.mismatch(\"null\")),\n        }\n    }\n}\n\nimpl<T: Serialize> Serialize for Option<T> {\n    fn to_value(&self) -> Value {\n        match self {\n            Some(x) => x.to_value(),\n            None => Value::Null,\n        }\n    }\n}\n\nimpl<T: Deserialize> Deserialize for Option<T> {\n    fn from_value(v: &Value) -> Result<Option<T>, SerdeError> {\n        match v {\n            Value::Null => Ok(None),\n            _ => Ok(Some(T::from_value(v)?)),\n        }\n    }\n}\n\nimpl<T: Serialize> Serialize for Vec<T> {\n    fn to_value(&self) -> Value {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            out.push(x.to_value());\n        }\n        Value::Seq(out)\n    }\n}\n\nimpl<T: Deserialize> Deserialize for Vec<T> {\n    fn from_value(v: &Value) -> Result<Vec<T>, SerdeError> {\n        match v {\n            Value::Seq(xs) => {\n                let mut out = Vec::new();\n                let mut i = 0;\n                for x in xs.iter() {\n                    match T::from_value(x) {\n                        Ok(t) => out.push(t),\n                        Err(e) => {\n                            return Err(e.in_index(i));\n                        }\n                    }\n                    i = i + 1;\n                }\n                Ok(out)\n            }\n            _ => Err(v.mismatch(\"a sequence\")),\n        }\n    }\n}\n\nimpl<V: Serialize> Serialize for HashMap<String, V> {\n    fn to_value(&self) -> Value {\n        let mut out = Vec::new();\n        for (k, x) in self.iter() {\n            out.push((k, x.to_value()));\n        }\n        Value::Map(out)\n    }\n}\n\nimpl<V: Deserialize> Deserialize for HashMap<String, V> {\n    fn from_value(v: &Value) -> Result<HashMap<String, V>, SerdeError> {\n        match v {\n            Value::Map(es) => {\n                let mut out = HashMap::new();\n                for e in es.iter() {\n                    match V::from_value(&e.1) {\n                        Ok(x) => {\n                            out.insert(e.0, x);\n                        }\n                        Err(err) => {\n                            return Err(err.in_field(e.0));\n                        }\n                    }\n                }\n                Ok(out)\n            }\n            _ => Err(v.mismatch(\"a map\")),\n        }\n    }\n}\n\n// Labeled data is read already labeled, and never written: there is no\n// Serialize. The error of a failed read says only what shape was expected.\nimpl<L, T: Deserialize> Deserialize for Labeled<L, T> {\n    fn from_value(v: &Value) -> Result<Labeled<L, T>, SerdeError> {\n        Ok(Labeled::new(T::from_value(v)?))\n    }\n}\n\n// ---- helpers of the formats ----\n\n// __serde_at is a parse error at offset i of s.\nfn __serde_at(s: String, i: Int, msg: String) -> SerdeError {\n    let mut line = 1;\n    let mut col = 1;\n    let mut j = 0;\n    while j < i && j < s.len() {\n        if s.char_at(j).unwrap_or(0) == 10 {\n            line = line + 1;\n            col = 1;\n        } else {\n            col = col + 1;\n        }\n        j = j + 1;\n    }\n    SerdeError { path: \"\", line: line, col: col, msg: msg }\n}\n\nfn __serde_hex(d: Int) -> String {\n    \"0123456789abcdef\".slice(d, d + 1)\n}\n\n// __serde_quote is s as a double-quoted string with JSON escapes (also\n// valid in TOML). Lone surrogates are escaped too.\nfn __serde_quote(s: String) -> String {\n    let mut parts = Vec::new();\n    parts.push(\"\\\"\");\n    let n = s.len();\n    let mut start = 0;\n    let mut i = 0;\n    while i < n {\n        let c = s.char_at(i).unwrap_or(0);\n        let lone = (c >= 55296\n            && c <= 56319\n            && !(i + 1 < n && __serde_low(s.char_at(i + 1).unwrap_or(0))))\n            || (__serde_low(c) && !(i > 0 && __serde_high(s.char_at(i - 1).unwrap_or(0))));\n        if c == 34 || c == 92 || c < 32 || c == 127 || lone {\n            parts.push(s.slice(start, i));\n            if c == 34 {\n                parts.push(\"\\\\\\\"\");\n            } else if c == 92 {\n                parts.push(\"\\\\\\\\\");\n            } else if c == 10 {\n                parts.push(\"\\\\n\");\n            } else if c == 13 {\n                parts.push(\"\\\\r\");\n            } else if c == 9 {\n                parts.push(\"\\\\t\");\n            } else {\n                parts.push(\n                    \"\\\\u\"\n                        + __serde_hex(c.shr(12).bit_and(15))\n                        + __serde_hex(c.shr(8).bit_and(15))\n                        + __serde_hex(c.shr(4).bit_and(15))\n                        + __serde_hex(c.bit_and(15)),\n                );\n            }\n            start = i + 1;\n        }\n        i = i + 1;\n    }\n    parts.push(s.slice(start, n));\n    parts.push(\"\\\"\");\n    parts.join(\"\")\n}\n\nfn __serde_high(c: Int) -> Bool {\n    c >= 55296 && c <= 56319\n}\n\nfn __serde_low(c: Int) -> Bool {\n    c >= 56320 && c <= 57343\n}\n\n// __serde_code_point appends code point cp as UTF-16 to parts.\nfn __serde_code_point(mut parts: Vec<String>, cp: Int) {\n    if cp >= 65536 {\n        let x = cp - 65536;\n        parts.push(String::from_char(55296 + x.shr(10)));\n        parts.push(String::from_char(56320 + x.bit_and(1023)));\n    } else {\n        parts.push(String::from_char(cp));\n    }\n}\n\nfn __serde_hex_value(c: Int) -> Int {\n    if c >= 48 && c <= 57 {\n        c - 48\n    } else if c >= 97 && c <= 102 {\n        c - 87\n    } else if c >= 65 && c <= 70 { c - 55 } else { -1 }\n}\n",
    );
    core_file(
        v,
        "toml.kek",
        "// TOML (v1.0.0) for Value (lib/core/serde.kek).\n//\n//   Toml::parse(s) -> Result<Value, SerdeError>          the document is a Map\n//   Toml::render(&v) -> Result<String, SerdeError>       v must be a Map\n//   Toml::from_str::<T>(s) -> Result<T, SerdeError>\n//   Toml::to_string(&x) -> Result<String, SerdeError>\n//\n// Floats (also inf and nan) become Value::Float as written (without `_`);\n// dates and times become Value::Str as written. TOML has no null: render\n// leaves out the keys whose value is null and refuses null elsewhere.\n// Tables keep the order in which their keys first appear.\n\nstruct Toml {}\n\nimpl Toml {\n    fn parse(s: String) -> Result<Value, SerdeError> {\n        let root = __toml_table(false);\n        let mut p = __TomlParser { s: s, n: s.len(), i: 0 };\n        let mut cur = root;\n        while true {\n            p.blank();\n            if p.i >= p.n {\n                break;\n            }\n            let c = p.peek();\n            if c == 10 || c == 13 || c == 35 {\n                p.end_of_line()?;\n                continue;\n            }\n            if c == 91 {\n                cur = p.header(root)?;\n            } else {\n                p.key_value(cur)?;\n            }\n            p.end_of_line()?;\n        }\n        Ok(__toml_value(root))\n    }\n\n    fn render(v: &Value) -> Result<String, SerdeError> {\n        match v {\n            Value::Map(es) => {\n                let mut out = Vec::new();\n                __toml_render_table(&mut out, \"\", es)?;\n                Ok(out.join(\"\"))\n            }\n            _ => Err(v.mismatch(\"a map (a TOML document is a table)\")),\n        }\n    }\n\n    fn from_str<T: Deserialize>(s: String) -> Result<T, SerdeError> {\n        T::from_value(&Toml::parse(s)?)\n    }\n\n    fn to_string<T: Serialize>(x: &T) -> Result<String, SerdeError> {\n        Toml::render(&x.to_value())\n    }\n}\n\n// ---- the document while it is parsed ----\n\n// A table: header is set once a `[header]` defined it, dotted when dotted\n// keys created it, closed for an inline table (it cannot be extended).\nstruct __TomlTable {\n    keys: Vec<String>,\n    items: HashMap<String, __TomlItem>,\n    mut header: Bool,\n    mut dotted: Bool,\n    mut closed: Bool,\n}\n\nenum __TomlItem {\n    Val(Value),\n    Table(__TomlTable),\n    // `[[name]]`\n    Tables(Vec<__TomlTable>),\n}\n\nfn __toml_table(dotted: Bool) -> __TomlTable {\n    __TomlTable {\n        keys: Vec::new(),\n        items: HashMap::new(),\n        header: false,\n        dotted: dotted,\n        closed: false,\n    }\n}\n\nfn __toml_put(mut t: __TomlTable, k: String, it: __TomlItem) {\n    if !t.items.contains_key(k) {\n        t.keys.push(k);\n    }\n    t.items.insert(k, it);\n}\n\nfn __toml_value(t: __TomlTable) -> Value {\n    let mut es = Vec::new();\n    for k in t.keys.iter() {\n        match t.items.get(k) {\n            Some(__TomlItem::Val(v)) => es.push((k, v)),\n            Some(__TomlItem::Table(x)) => es.push((k, __toml_value(x))),\n            Some(__TomlItem::Tables(xs)) => {\n                let mut seq = Vec::new();\n                for x in xs.iter() {\n                    seq.push(__toml_value(x));\n                }\n                es.push((k, Value::Seq(seq)));\n            }\n            None => {}\n        }\n    }\n    Value::Map(es)\n}\n\nstruct __TomlParser {\n    s: String,\n    n: Int,\n    mut i: Int,\n}\n\nimpl __TomlParser {\n    fn peek(&self) -> Int {\n        self.at(self.i)\n    }\n\n    fn at(&self, j: Int) -> Int {\n        if j < self.n {\n            self.s.char_at(j).unwrap_or(-1)\n        } else {\n            -1\n        }\n    }\n\n    fn fail(&self, msg: String) -> SerdeError {\n        __serde_at(self.s, self.i, msg)\n    }\n\n    fn fail_at(&self, j: Int, msg: String) -> SerdeError {\n        __serde_at(self.s, j, msg)\n    }\n\n    // blank skips spaces and tabs.\n    fn blank(&mut self) {\n        while self.peek() == 32 || self.peek() == 9 {\n            self.i = self.i + 1;\n        }\n    }\n\n    // end_of_line accepts blanks, a comment and the end of the line.\n    fn end_of_line(&mut self) -> Result<(), SerdeError> {\n        self.blank();\n        if self.peek() == 35 {\n            while self.i < self.n && self.peek() != 10 {\n                let c = self.peek();\n                if (c < 32 && c != 9) || c == 127 {\n                    if !(c == 13 && self.at(self.i + 1) == 10) {\n                        return Err(self.fail(\"control character in a comment\"));\n                    }\n                }\n                self.i = self.i + 1;\n            }\n        }\n        if self.peek() == 13 && self.at(self.i + 1) == 10 {\n            self.i = self.i + 2;\n            return Ok(());\n        }\n        if self.peek() == 10 {\n            self.i = self.i + 1;\n            return Ok(());\n        }\n        if self.i >= self.n {\n            return Ok(());\n        }\n        Err(self.fail(\"expected the end of the line\"))\n    }\n\n    // skip_ws skips blanks, newlines and comments (inside arrays).\n    fn skip_ws(&mut self) -> Result<(), SerdeError> {\n        while true {\n            self.blank();\n            let c = self.peek();\n            if c == 10 || c == 35 || (c == 13 && self.at(self.i + 1) == 10) {\n                self.end_of_line()?;\n            } else {\n                return Ok(());\n            }\n        }\n        Ok(())\n    }\n\n    // ---- keys ----\n\n    fn simple_key(&mut self) -> Result<String, SerdeError> {\n        let c = self.peek();\n        if c == 34 {\n            if self.at(self.i + 1) == 34 && self.at(self.i + 2) == 34 {\n                return Err(self.fail(\"a key cannot be a multi-line string\"));\n            }\n            return self.basic_string();\n        }\n        if c == 39 {\n            if self.at(self.i + 1) == 39 && self.at(self.i + 2) == 39 {\n                return Err(self.fail(\"a key cannot be a multi-line string\"));\n            }\n            return self.literal_string();\n        }\n        let start = self.i;\n        while __toml_bare(self.peek()) {\n            self.i = self.i + 1;\n        }\n        if self.i == start {\n            return Err(self.fail(\"expected a key\"));\n        }\n        Ok(self.s.slice(start, self.i))\n    }\n\n    // key is a dotted key `a.b.\"c\"`.\n    fn key(&mut self) -> Result<Vec<String>, SerdeError> {\n        let mut parts = Vec::new();\n        while true {\n            self.blank();\n            parts.push(self.simple_key()?);\n            self.blank();\n            if self.peek() != 46 {\n                return Ok(parts);\n            }\n            self.i = self.i + 1;\n        }\n        Ok(parts)\n    }\n\n    // ---- tables ----\n\n    // header parses `[a.b]` or `[[a.b]]` and returns the table that the\n    // following keys go to.\n    fn header(&mut self, root: __TomlTable) -> Result<__TomlTable, SerdeError> {\n        let start = self.i;\n        let array = self.at(self.i + 1) == 91;\n        self.i = self.i + if array { 2 } else { 1 };\n        let path = self.key()?;\n        if array {\n            if !(self.peek() == 93 && self.at(self.i + 1) == 93) {\n                return Err(self.fail(\"expected `]]`\"));\n            }\n            self.i = self.i + 2;\n        } else {\n            if self.peek() != 93 {\n                return Err(self.fail(\"expected `]`\"));\n            }\n            self.i = self.i + 1;\n        }\n        let mut t = root;\n        let last = path.len() - 1;\n        let mut k = 0;\n        for name in path.iter() {\n            if k == last {\n                break;\n            }\n            t = self.descend(t, name, start)?;\n            k = k + 1;\n        }\n        let name = path.get(last).unwrap_or(\"\");\n        if array {\n            let mut fresh = __toml_table(false);\n            fresh.header = true;\n            match t.items.get(name) {\n                None => {\n                    if t.closed {\n                        return Err(self.fail_at(start, \"cannot extend an inline table\"));\n                    }\n                    let mut xs = Vec::new();\n                    xs.push(fresh);\n                    __toml_put(t, name, __TomlItem::Tables(xs));\n                }\n                Some(__TomlItem::Tables(xs)) => {\n                    let mut ys = xs;\n                    ys.push(fresh);\n                }\n                Some(_) => {\n                    return Err(\n                        self.fail_at(\n                            start,\n                            \"`\" + name + \"` is already defined and not an array of tables\",\n                        ),\n                    );\n                }\n            }\n            return Ok(fresh);\n        }\n        match t.items.get(name) {\n            None => {\n                if t.closed {\n                    return Err(self.fail_at(start, \"cannot extend an inline table\"));\n                }\n                let mut fresh = __toml_table(false);\n                fresh.header = true;\n                __toml_put(t, name, __TomlItem::Table(fresh));\n                Ok(fresh)\n            }\n            Some(__TomlItem::Table(x)) => {\n                if x.header || x.dotted || x.closed {\n                    return Err(self.fail_at(start, \"table `\" + name + \"` is defined twice\"));\n                }\n                let mut y = x;\n                y.header = true;\n                Ok(y)\n            }\n            Some(_) => Err(self.fail_at(start, \"`\" + name + \"` is already defined and not a table\")),\n        }\n    }\n\n    // descend is the table name inside t on the path of a header: created\n    // if missing, the last one of an array of tables.\n    fn descend(\n        &self,\n        mut t: __TomlTable,\n        name: String,\n        at: Int,\n    ) -> Result<__TomlTable, SerdeError> {\n        match t.items.get(name) {\n            None => {\n                if t.closed {\n                    return Err(self.fail_at(at, \"cannot extend an inline table\"));\n                }\n                let fresh = __toml_table(false);\n                __toml_put(t, name, __TomlItem::Table(fresh));\n                Ok(fresh)\n            }\n            Some(__TomlItem::Table(x)) => {\n                if x.closed {\n                    return Err(self.fail_at(at, \"cannot extend an inline table\"));\n                }\n                Ok(x)\n            }\n            Some(__TomlItem::Tables(xs)) => match xs.get(xs.len() - 1) {\n                Some(x) => Ok(x),\n                None => Err(self.fail_at(at, \"empty array of tables\")),\n            },\n            Some(__TomlItem::Val(_)) => Err(self.fail_at(at, \"`\" + name + \"` is not a table\")),\n        }\n    }\n\n    // key_value parses `a.b = v` into t.\n    fn key_value(&mut self, t: __TomlTable) -> Result<(), SerdeError> {\n        let start = self.i;\n        let path = self.key()?;\n        if self.peek() != 61 {\n            return Err(self.fail(\"expected `=` after a key\"));\n        }\n        self.i = self.i + 1;\n        self.blank();\n        let v = self.value(0)?;\n        let mut cur = t;\n        let last = path.len() - 1;\n        let mut k = 0;\n        for name in path.iter() {\n            if k == last {\n                break;\n            }\n            match cur.items.get(name) {\n                None => {\n                    let fresh = __toml_table(true);\n                    __toml_put(cur, name, __TomlItem::Table(fresh));\n                    cur = fresh;\n                }\n                Some(__TomlItem::Table(x)) => {\n                    if !x.dotted || x.closed {\n                        return Err(\n                            self.fail_at(\n                                start,\n                                \"cannot add to table `\" + name + \"` with a dotted key\",\n                            ),\n                        );\n                    }\n                    cur = x;\n                }\n                Some(_) => {\n                    return Err(self.fail_at(start, \"`\" + name + \"` is not a table\"));\n                }\n            }\n            k = k + 1;\n        }\n        let name = path.get(last).unwrap_or(\"\");\n        if cur.items.contains_key(name) {\n            return Err(self.fail_at(start, \"duplicate key `\" + name + \"`\"));\n        }\n        __toml_put(cur, name, v);\n        Ok(())\n    }\n\n    // ---- values ----\n\n    fn value(&mut self, depth: Int) -> Result<__TomlItem, SerdeError> {\n        if depth > 128 {\n            return Err(self.fail(\"nested too deeply\"));\n        }\n        let c = self.peek();\n        if c == 34 {\n            if self.at(self.i + 1) == 34 && self.at(self.i + 2) == 34 {\n                return Ok(__TomlItem::Val(Value::Str(self.ml_basic_string()?)));\n            }\n            return Ok(__TomlItem::Val(Value::Str(self.basic_string()?)));\n        }\n        if c == 39 {\n            if self.at(self.i + 1) == 39 && self.at(self.i + 2) == 39 {\n                return Ok(__TomlItem::Val(Value::Str(self.ml_literal_string()?)));\n            }\n            return Ok(__TomlItem::Val(Value::Str(self.literal_string()?)));\n        }\n        if c == 91 {\n            return self.array(depth);\n        }\n        if c == 123 {\n            return self.inline_table(depth);\n        }\n        Ok(__TomlItem::Val(self.scalar()?))\n    }\n\n    fn array(&mut self, depth: Int) -> Result<__TomlItem, SerdeError> {\n        self.i = self.i + 1;\n        let mut out = Vec::new();\n        while true {\n            self.skip_ws()?;\n            if self.peek() == 93 {\n                self.i = self.i + 1;\n                return Ok(__TomlItem::Val(Value::Seq(out)));\n            }\n            out.push(__toml_item_value(self.value(depth + 1)?));\n            self.skip_ws()?;\n            let c = self.peek();\n            if c == 44 {\n                self.i = self.i + 1;\n            } else if c == 93 {\n                self.i = self.i + 1;\n                return Ok(__TomlItem::Val(Value::Seq(out)));\n            } else {\n                return Err(self.fail(\"expected `,` or `]` in an array\"));\n            }\n        }\n        Err(self.fail(\"unterminated array\"))\n    }\n\n    fn inline_table(&mut self, depth: Int) -> Result<__TomlItem, SerdeError> {\n        self.i = self.i + 1;\n        let mut t = __toml_table(false);\n        self.blank();\n        if self.peek() == 125 {\n            self.i = self.i + 1;\n            t.closed = true;\n            return Ok(__TomlItem::Table(t));\n        }\n        while true {\n            self.blank();\n            let start = self.i;\n            let path = self.key()?;\n            if self.peek() != 61 {\n                return Err(self.fail(\"expected `=` after a key\"));\n            }\n            self.i = self.i + 1;\n            self.blank();\n            let v = self.value(depth + 1)?;\n            let mut cur = t;\n            let last = path.len() - 1;\n            let mut k = 0;\n            for name in path.iter() {\n                if k == last {\n                    break;\n                }\n                match cur.items.get(name) {\n                    None => {\n                        let fresh = __toml_table(true);\n                        __toml_put(cur, name, __TomlItem::Table(fresh));\n                        cur = fresh;\n                    }\n                    Some(__TomlItem::Table(x)) => {\n                        if !x.dotted {\n                            return Err(self.fail_at(start, \"`\" + name + \"` is already defined\"));\n                        }\n                        cur = x;\n                    }\n                    Some(_) => {\n                        return Err(self.fail_at(start, \"`\" + name + \"` is not a table\"));\n                    }\n                }\n                k = k + 1;\n            }\n            let name = path.get(last).unwrap_or(\"\");\n            if cur.items.contains_key(name) {\n                return Err(self.fail_at(start, \"duplicate key `\" + name + \"`\"));\n            }\n            __toml_put(cur, name, v);\n            self.blank();\n            let c = self.peek();\n            if c == 44 {\n                self.i = self.i + 1;\n            } else if c == 125 {\n                self.i = self.i + 1;\n                __toml_close(t);\n                return Ok(__TomlItem::Table(t));\n            } else {\n                return Err(self.fail(\"expected `,` or `}` in an inline table\"));\n            }\n        }\n        Err(self.fail(\"unterminated inline table\"))\n    }\n\n    // ---- strings ----\n\n    fn basic_string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 1;\n        let mut parts = Vec::new();\n        let mut start = self.i;\n        while true {\n            let c = self.peek();\n            if c == 34 {\n                parts.push(self.s.slice(start, self.i));\n                self.i = self.i + 1;\n                return Ok(parts.join(\"\"));\n            }\n            if c < 0 || c == 10 || c == 13 {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            if (c < 32 && c != 9) || c == 127 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            if c == 92 {\n                parts.push(self.s.slice(start, self.i));\n                self.escape(&mut parts)?;\n                start = self.i;\n            } else {\n                self.i = self.i + 1;\n            }\n        }\n        Err(self.fail(\"unterminated string\"))\n    }\n\n    // escape reads the escape at self.i (a backslash) into parts.\n    fn escape(&mut self, mut parts: Vec<String>) -> Result<(), SerdeError> {\n        let e = self.at(self.i + 1);\n        let mut len = 2;\n        if e == 34 {\n            parts.push(\"\\\"\");\n        } else if e == 92 {\n            parts.push(\"\\\\\");\n        } else if e == 98 {\n            parts.push(String::from_char(8));\n        } else if e == 116 {\n            parts.push(\"\\t\");\n        } else if e == 110 {\n            parts.push(\"\\n\");\n        } else if e == 102 {\n            parts.push(String::from_char(12));\n        } else if e == 114 {\n            parts.push(\"\\r\");\n        } else if e == 117 || e == 85 {\n            let nd = if e == 117 { 4 } else { 8 };\n            let mut x = 0;\n            for k in 0..nd {\n                let d = __serde_hex_value(self.at(self.i + 2 + k));\n                if d < 0 {\n                    return Err(self.fail(\"bad unicode escape\"));\n                }\n                x = x * 16 + d;\n            }\n            if x > 1114111 || (x >= 55296 && x <= 57343) {\n                return Err(self.fail(\"the escape is not a Unicode scalar value\"));\n            }\n            __serde_code_point(parts, x);\n            len = 2 + nd;\n        } else {\n            return Err(self.fail(\"bad escape\"));\n        }\n        self.i = self.i + len;\n        Ok(())\n    }\n\n    // newline_at is the length of the newline at j (0 if none).\n    fn newline_at(&self, j: Int) -> Int {\n        if self.at(j) == 10 {\n            1\n        } else if self.at(j) == 13 && self.at(j + 1) == 10 {\n            2\n        } else {\n            0\n        }\n    }\n\n    fn ml_basic_string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 3;\n        self.i = self.i + self.newline_at(self.i);\n        let mut parts = Vec::new();\n        let mut start = self.i;\n        while true {\n            let c = self.peek();\n            if c < 0 {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            if c == 34 && self.at(self.i + 1) == 34 && self.at(self.i + 2) == 34 {\n                // up to two more quotes belong to the string\n                let mut end = self.i;\n                while self.at(end + 3) == 34 && end < self.i + 2 {\n                    end = end + 1;\n                }\n                parts.push(self.s.slice(start, end));\n                self.i = end + 3;\n                return Ok(parts.join(\"\"));\n            }\n            if c == 92 {\n                parts.push(self.s.slice(start, self.i));\n                // a backslash at the end of a line trims the whitespace\n                let mut j = self.i + 1;\n                while self.at(j) == 32 || self.at(j) == 9 {\n                    j = j + 1;\n                }\n                if self.newline_at(j) > 0 {\n                    while self.at(j) == 32 || self.at(j) == 9 || self.newline_at(j) > 0 {\n                        j = j + if self.newline_at(j) > 0 {\n                            self.newline_at(j)\n                        } else {\n                            1\n                        };\n                    }\n                    self.i = j;\n                } else {\n                    self.escape(&mut parts)?;\n                }\n                start = self.i;\n                continue;\n            }\n            if (c < 32 && c != 9 && c != 10 && c != 13) || c == 127 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            if c == 13 && self.at(self.i + 1) != 10 {\n                return Err(self.fail(\"bare carriage return in a string\"));\n            }\n            self.i = self.i + 1;\n        }\n        Err(self.fail(\"unterminated string\"))\n    }\n\n    fn literal_string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 1;\n        let start = self.i;\n        while true {\n            let c = self.peek();\n            if c == 39 {\n                let s = self.s.slice(start, self.i);\n                self.i = self.i + 1;\n                return Ok(s);\n            }\n            if c < 0 || c == 10 || c == 13 {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            if (c < 32 && c != 9) || c == 127 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            self.i = self.i + 1;\n        }\n        Err(self.fail(\"unterminated string\"))\n    }\n\n    fn ml_literal_string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 3;\n        self.i = self.i + self.newline_at(self.i);\n        let start = self.i;\n        while true {\n            let c = self.peek();\n            if c < 0 {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            if c == 39 && self.at(self.i + 1) == 39 && self.at(self.i + 2) == 39 {\n                let mut end = self.i;\n                while self.at(end + 3) == 39 && end < self.i + 2 {\n                    end = end + 1;\n                }\n                let s = self.s.slice(start, end);\n                self.i = end + 3;\n                return Ok(s);\n            }\n            if (c < 32 && c != 9 && c != 10 && c != 13) || c == 127 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            self.i = self.i + 1;\n        }\n        Err(self.fail(\"unterminated string\"))\n    }\n\n    // ---- numbers, booleans, dates ----\n\n    fn scalar(&mut self) -> Result<Value, SerdeError> {\n        let start = self.i;\n        while __toml_scalar_char(self.peek()) {\n            self.i = self.i + 1;\n        }\n        // `1979-05-27 07:32:00`: a space may separate a date and a time\n        if self.peek() == 32\n            && self.i - start == 10\n            && __toml_is_date(self.s.slice(start, self.i))\n            && __toml_digit(self.at(self.i + 1))\n            && __toml_digit(self.at(self.i + 2))\n            && self.at(self.i + 3) == 58 {\n            self.i = self.i + 1;\n            while __toml_scalar_char(self.peek()) {\n                self.i = self.i + 1;\n            }\n        }\n        let t = self.s.slice(start, self.i);\n        if t == \"\" {\n            return Err(self.fail(\"expected a value\"));\n        }\n        if t == \"true\" {\n            return Ok(Value::Bool(true));\n        }\n        if t == \"false\" {\n            return Ok(Value::Bool(false));\n        }\n        if t == \"inf\" || t == \"+inf\" || t == \"-inf\" || t == \"nan\" || t == \"+nan\" || t == \"-nan\" {\n            return Ok(Value::Float(t));\n        }\n        if __toml_is_date(t.slice(0, 10)) || (t.len() >= 8 && t.char_at(2).unwrap_or(0) == 58) {\n            if __toml_datetime_ok(t) {\n                return Ok(Value::Str(t));\n            }\n            return Err(self.fail_at(start, \"bad date or time\"));\n        }\n        match __toml_number(t) {\n            Some(v) => Ok(v),\n            None => Err(self.fail_at(start, \"bad value `\" + t + \"`\")),\n        }\n    }\n}\n\nfn __toml_close(mut t: __TomlTable) {\n    t.closed = true;\n    for k in t.keys.iter() {\n        match t.items.get(k) {\n            Some(__TomlItem::Table(x)) => __toml_close(x),\n            _ => {}\n        }\n    }\n}\n\nfn __toml_item_value(it: __TomlItem) -> Value {\n    match it {\n        __TomlItem::Val(v) => v,\n        __TomlItem::Table(t) => __toml_value(t),\n        __TomlItem::Tables(xs) => {\n            let mut seq = Vec::new();\n            for x in xs.iter() {\n                seq.push(__toml_value(x));\n            }\n            Value::Seq(seq)\n        }\n    }\n}\n\nfn __toml_bare(c: Int) -> Bool {\n    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45\n}\n\nfn __toml_digit(c: Int) -> Bool {\n    c >= 48 && c <= 57\n}\n\nfn __toml_scalar_char(c: Int) -> Bool {\n    __toml_bare(c) || c == 43 || c == 46 || c == 58\n}\n\nfn __toml_digits(s: String, a: Int, b: Int) -> Bool {\n    if a >= b || b > s.len() {\n        return false;\n    }\n    for j in a..b {\n        if !__toml_digit(s.char_at(j).unwrap_or(0)) {\n            return false;\n        }\n    }\n    true\n}\n\n// __toml_is_date: `YYYY-MM-DD`.\nfn __toml_is_date(s: String) -> Bool {\n    s.len() == 10\n        && __toml_digits(s, 0, 4)\n        && s.char_at(4).unwrap_or(0) == 45\n        && __toml_digits(s, 5, 7)\n        && s.char_at(7).unwrap_or(0) == 45\n        && __toml_digits(s, 8, 10)\n}\n\n// __toml_is_time: `HH:MM:SS` with an optional fraction.\nfn __toml_is_time(s: String) -> Bool {\n    if s.len() < 8 {\n        return false;\n    }\n    if !(__toml_digits(s, 0, 2)\n        && s.char_at(2).unwrap_or(0) == 58\n        && __toml_digits(s, 3, 5)\n        && s.char_at(5).unwrap_or(0) == 58\n        && __toml_digits(s, 6, 8)) {\n        return false;\n    }\n    if s.len() == 8 {\n        return true;\n    }\n    s.char_at(8).unwrap_or(0) == 46 && __toml_digits(s, 9, s.len())\n}\n\n// __toml_datetime_ok accepts the four date and time forms.\nfn __toml_datetime_ok(t: String) -> Bool {\n    if __toml_is_time(t) {\n        return true;\n    }\n    if !__toml_is_date(t.slice(0, 10)) {\n        return false;\n    }\n    if t.len() == 10 {\n        return true;\n    }\n    let sep = t.char_at(10).unwrap_or(0);\n    if !(sep == 84 || sep == 116 || sep == 32) {\n        return false;\n    }\n    let rest = t.slice(11, t.len());\n    // an offset: Z, or +HH:MM / -HH:MM\n    let n = rest.len();\n    let mut time = rest;\n    if n > 0 && (rest.char_at(n - 1).unwrap_or(0) == 90 || rest.char_at(n - 1).unwrap_or(0) == 122) {\n        time = rest.slice(0, n - 1);\n    } else if n >= 6 {\n        let o = rest.char_at(n - 6).unwrap_or(0);\n        if (o == 43 || o == 45)\n            && __toml_digits(rest, n - 5, n - 3)\n            && rest.char_at(n - 3).unwrap_or(0) == 58\n            && __toml_digits(rest, n - 2, n) {\n            time = rest.slice(0, n - 6);\n        }\n    }\n    __toml_is_time(time)\n}\n\n// __toml_clean checks that every `_` in s is between two digits of the\n// given base and removes them; \"\" if s is not well formed.\nfn __toml_clean(s: String, base: Int) -> String {\n    let mut parts = Vec::new();\n    let mut start = 0;\n    let n = s.len();\n    for j in 0..n {\n        if s.char_at(j).unwrap_or(0) == 95 {\n            if j == 0 || j == n - 1 {\n                return \"\";\n            }\n            if __toml_digit_value(s.char_at(j - 1).unwrap_or(0)) < 0\n                || __toml_digit_value(s.char_at(j + 1).unwrap_or(0)) < 0 {\n                return \"\";\n            }\n            parts.push(s.slice(start, j));\n            start = j + 1;\n        }\n    }\n    parts.push(s.slice(start, n));\n    let out = parts.join(\"\");\n    if base == 16 {\n        for j in 0..out.len() {\n            if __serde_hex_value(out.char_at(j).unwrap_or(0)) < 0 {\n                return \"\";\n            }\n        }\n    }\n    out\n}\n\nfn __toml_digit_value(c: Int) -> Int {\n    __serde_hex_value(c)\n}\n\n// __toml_radix parses the digits of s in base b (no sign).\nfn __toml_radix(s: String, b: Int) -> Option<Int> {\n    if s == \"\" {\n        return None;\n    }\n    let mut x = 0;\n    for j in 0..s.len() {\n        let d = __serde_hex_value(s.char_at(j).unwrap_or(0));\n        if d < 0 || d >= b {\n            return None;\n        }\n        // overflow: x * b + d must stay below 2^63\n        if x > (9223372036854775807 - d) / b {\n            return None;\n        }\n        x = x * b + d;\n    }\n    Some(x)\n}\n\nfn __toml_number(t: String) -> Option<Value> {\n    if t.starts_with(\"0x\") || t.starts_with(\"0o\") || t.starts_with(\"0b\") {\n        let b = if t.starts_with(\"0x\") {\n            16\n        } else if t.starts_with(\"0o\") { 8 } else { 2 };\n        let digits = __toml_clean(t.slice(2, t.len()), b);\n        return match __toml_radix(digits, b) {\n            Some(x) => Some(Value::Int(x)),\n            None => None,\n        };\n    }\n    let mut body = t;\n    if t.starts_with(\"+\") || t.starts_with(\"-\") {\n        body = t.slice(1, t.len());\n    }\n    if body == \"\" || !__toml_digit(body.char_at(0).unwrap_or(0)) {\n        return None;\n    }\n    let float = body.contains(\".\") || body.contains(\"e\") || body.contains(\"E\");\n    // no leading zeros in the integer part\n    let int_end = match body.index_of(\".\") {\n        Some(k) => k,\n        None => match body.index_of(\"e\") {\n            Some(k) => k,\n            None => match body.index_of(\"E\") {\n                Some(k) => k,\n                None => body.len(),\n            },\n        },\n    };\n    if int_end > 1 && body.char_at(0).unwrap_or(0) == 48 {\n        return None;\n    }\n    if !float {\n        let d = __toml_clean(body, 10);\n        if !__toml_digits(d, 0, d.len()) {\n            return None;\n        }\n        let sign = if t.starts_with(\"-\") { \"-\" } else { \"\" };\n        return match (sign + d).parse_int() {\n            Some(x) => Some(Value::Int(x)),\n            None => None,\n        };\n    }\n    // a float: int [. digits] [e [+-] digits], `_` between digits\n    let mut clean = Vec::new();\n    let mut j = 0;\n    let n = body.len();\n    let mut start = 0;\n    while j < n {\n        let c = body.char_at(j).unwrap_or(0);\n        if c == 95 {\n            if !(j > 0\n                && __toml_digit(body.char_at(j - 1).unwrap_or(0))\n                && __toml_digit(body.char_at(j + 1).unwrap_or(0))) {\n                return None;\n            }\n            clean.push(body.slice(start, j));\n            start = j + 1;\n        }\n        j = j + 1;\n    }\n    clean.push(body.slice(start, n));\n    let f = clean.join(\"\");\n    if !__toml_float_ok(f) {\n        return None;\n    }\n    let sign = if t.starts_with(\"-\") {\n        \"-\"\n    } else if t.starts_with(\"+\") { \"+\" } else { \"\" };\n    Some(Value::Float(sign + f))\n}\n\nfn __toml_float_ok(f: String) -> Bool {\n    let mut j = 0;\n    let n = f.len();\n    while j < n && __toml_digit(f.char_at(j).unwrap_or(0)) {\n        j = j + 1;\n    }\n    if j == 0 {\n        return false;\n    }\n    if j < n && f.char_at(j).unwrap_or(0) == 46 {\n        j = j + 1;\n        let a = j;\n        while j < n && __toml_digit(f.char_at(j).unwrap_or(0)) {\n            j = j + 1;\n        }\n        if j == a {\n            return false;\n        }\n    }\n    if j < n && (f.char_at(j).unwrap_or(0) == 101 || f.char_at(j).unwrap_or(0) == 69) {\n        j = j + 1;\n        if j < n && (f.char_at(j).unwrap_or(0) == 43 || f.char_at(j).unwrap_or(0) == 45) {\n            j = j + 1;\n        }\n        let a = j;\n        while j < n && __toml_digit(f.char_at(j).unwrap_or(0)) {\n            j = j + 1;\n        }\n        if j == a {\n            return false;\n        }\n    }\n    j == n\n}\n\n// ---- rendering ----\n\nfn __toml_key(k: String) -> String {\n    if k == \"\" {\n        return \"\\\"\\\"\";\n    }\n    for j in 0..k.len() {\n        if !__toml_bare(k.char_at(j).unwrap_or(0)) {\n            return __serde_quote(k);\n        }\n    }\n    k\n}\n\n// __toml_tables reports whether v is rendered as `[[name]]` sections: a\n// non-empty sequence of maps.\nfn __toml_tables(v: &Value) -> Bool {\n    match v {\n        Value::Seq(xs) => {\n            if xs.len() == 0 {\n                return false;\n            }\n            for x in xs.iter() {\n                match x {\n                    Value::Map(_) => {}\n                    _ => {\n                        return false;\n                    }\n                }\n            }\n            true\n        }\n        _ => false,\n    }\n}\n\n// __toml_render_table writes the entries of the table at path (dotted,\n// \"\" for the document): plain keys first, then sub-tables and arrays of\n// tables.\nfn __toml_render_table(\n    mut out: Vec<String>,\n    path: String,\n    es: &Vec<(String, Value)>,\n) -> Result<(), SerdeError> {\n    for e in es.iter() {\n        match &e.1 {\n            Value::Null => {}\n            Value::Map(_) => {}\n            v => {\n                if !__toml_tables(v) {\n                    out.push(__toml_key(e.0) + \" = \");\n                    match __toml_inline(&mut out, v) {\n                        Ok(_) => {}\n                        Err(err) => {\n                            return Err(err.in_field(e.0));\n                        }\n                    }\n                    out.push(\"\\n\");\n                }\n            }\n        }\n    }\n    for e in es.iter() {\n        let sub = if path == \"\" {\n            __toml_key(e.0)\n        } else {\n            path + \".\" + __toml_key(e.0)\n        };\n        match &e.1 {\n            Value::Map(inner) => {\n                // a table of tables only needs the headers of its tables\n                if __toml_has_plain(inner) || !__toml_has_tables(inner) {\n                    if out.len() > 0 {\n                        out.push(\"\\n\");\n                    }\n                    out.push(\"[\" + sub + \"]\\n\");\n                }\n                match __toml_render_table(out, sub, inner) {\n                    Ok(_) => {}\n                    Err(err) => {\n                        return Err(err.in_field(e.0));\n                    }\n                }\n            }\n            Value::Seq(xs) => {\n                if __toml_tables(&e.1) {\n                    let mut i = 0;\n                    for x in xs.iter() {\n                        match x {\n                            Value::Map(inner) => {\n                                if out.len() > 0 {\n                                    out.push(\"\\n\");\n                                }\n                                out.push(\"[[\" + sub + \"]]\\n\");\n                                match __toml_render_table(out, sub, inner) {\n                                    Ok(_) => {}\n                                    Err(err) => {\n                                        return Err(err.in_index(i).in_field(e.0));\n                                    }\n                                }\n                            }\n                            _ => {}\n                        }\n                        i = i + 1;\n                    }\n                }\n            }\n            _ => {}\n        }\n    }\n    Ok(())\n}\n\nfn __toml_has_plain(es: &Vec<(String, Value)>) -> Bool {\n    for e in es.iter() {\n        match &e.1 {\n            Value::Null => {}\n            Value::Map(_) => {}\n            v => {\n                if !__toml_tables(v) {\n                    return true;\n                }\n            }\n        }\n    }\n    false\n}\n\nfn __toml_has_tables(es: &Vec<(String, Value)>) -> Bool {\n    for e in es.iter() {\n        match &e.1 {\n            Value::Map(_) => {\n                return true;\n            }\n            v => {\n                if __toml_tables(v) {\n                    return true;\n                }\n            }\n        }\n    }\n    false\n}\n\n// __toml_inline writes v as an inline value (arrays and inline tables).\nfn __toml_inline(mut out: Vec<String>, v: &Value) -> Result<(), SerdeError> {\n    match v {\n        Value::Null => {\n            return Err(SerdeError::new(\"TOML has no null\"));\n        }\n        Value::Bool(b) => out.push(if b { \"true\" } else { \"false\" }),\n        Value::Int(n) => out.push(n.to_string()),\n        Value::Float(f) => out.push(f),\n        Value::Str(s) => out.push(__serde_quote(s)),\n        Value::Seq(xs) => {\n            out.push(\"[\");\n            let mut i = 0;\n            for x in xs.iter() {\n                if i > 0 {\n                    out.push(\", \");\n                }\n                match __toml_inline(out, x) {\n                    Ok(_) => {}\n                    Err(err) => {\n                        return Err(err.in_index(i));\n                    }\n                }\n                i = i + 1;\n            }\n            out.push(\"]\");\n        }\n        Value::Map(es) => {\n            out.push(\"{\");\n            let mut first = true;\n            for e in es.iter() {\n                match &e.1 {\n                    Value::Null => {}\n                    x => {\n                        out.push(if first { \" \" } else { \", \" });\n                        first = false;\n                        out.push(__toml_key(e.0) + \" = \");\n                        match __toml_inline(out, x) {\n                            Ok(_) => {}\n                            Err(err) => {\n                                return Err(err.in_field(e.0));\n                            }\n                        }\n                    }\n                }\n            }\n            out.push(if first { \"}\" } else { \" }\" });\n        }\n    }\n    Ok(())\n}\n",
    );
    v
}
