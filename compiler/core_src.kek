    core_file(
        v,
        "hashmap.kek",
        "// HashMap and HashSet, with Rust's API (std::collections), iterating in\n// insertion order.\n//\n// Entries are kept in insertion order in `entries` (a removed entry stays\n// as a hole, `live` false, until the table is rebuilt). `buckets` holds,\n// per bucket, the first entry of a chain linked by `next`. The hash is\n// fixed (unseeded), so a bucket can be made to collide on purpose: when a\n// chain grows past TREEIFY entries it becomes an AVL tree ordered by the\n// keys (`Ord`), so that every operation stays O(log n) (this is why keys\n// must be Ord as well as Hash + Eq).\n//\n// Iteration is a live view: an iterator sees entries inserted after it was\n// created and skips removed ones. Rebuilding the table compacts the\n// entries; an iterator then finds its place again by the insertion\n// sequence number of the last entry it returned.\n\nstruct HashEntry<K, V> {\n    key: K,\n    mut value: V,\n    hash: Int,\n    seq: Int,\n    // chain: the next entry; tree: the left child (-1: none)\n    mut next: Int,\n    mut right: Int,\n    mut height: Int,\n}\n\nstruct HashMap<K, V> {\n    mut entries: Vec<HashEntry<K, V>>,\n    mut live: Vec<Bool>,\n    mut buckets: Vec<Int>,\n    mut tree: Vec<Bool>,\n    mut len: Int,\n    mut next_seq: Int,\n    // incremented when the entries are compacted\n    mut epoch: Int,\n}\n\nfn __hashmap_treeify_len() -> Int {\n    8\n}\n\n// __hash_of hashes a value with the default hasher.\nfn __hash_of<T: Hash>(x: &T) -> Int {\n    let mut h = DefaultHasher::new();\n    x.hash(&mut h);\n    h.finish()\n}\n\nimpl<K, V> HashMap<K, V> {\n    fn new() -> HashMap<K, V> {\n        HashMap::with_capacity(0)\n    }\n\n    fn with_capacity(n: Int) -> HashMap<K, V> {\n        let mut size = 8;\n        while size * 3 < n * 4 {\n            size = size * 2;\n        }\n        let mut m = HashMap {\n            entries: Vec::new(),\n            live: Vec::new(),\n            buckets: Vec::new(),\n            tree: Vec::new(),\n            len: 0,\n            next_seq: 0,\n            epoch: 0,\n        };\n        for i in 0..size {\n            m.buckets.push(-1);\n            m.tree.push(false);\n        }\n        m\n    }\n\n    fn len(&self) -> Int {\n        self.len\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.len == 0\n    }\n\n    fn clear(&mut self) {\n        self.entries = Vec::new();\n        self.live = Vec::new();\n        for i in 0..self.buckets.len() {\n            self.buckets.set(i, -1);\n            self.tree.set(i, false);\n        }\n        self.len = 0;\n        self.epoch = self.epoch + 1;\n    }\n\n    // iter returns the (key, value) pairs in insertion order.\n    #[fresh]\n    fn iter(&self) -> HashMapIter<K, V> {\n        HashMapIter { map: *self, i: 0, epoch: self.epoch, last_seq: -1 }\n    }\n\n    #[fresh]\n    fn keys(&self) -> Keys<K, V> {\n        Keys { it: self.iter() }\n    }\n\n    #[fresh]\n    fn values(&self) -> Values<K, V> {\n        Values { it: self.iter() }\n    }\n\n    fn bucket_of(&self, hash: Int) -> Int {\n        hash.bit_and(self.buckets.len() - 1)\n    }\n\n    fn is_live(&self, i: Int) -> Bool {\n        self.live.get(i).unwrap_or(false)\n    }\n\n    // ---- AVL trees of entry indices (left: next, right: right) ----\n\n    fn height(&self, i: Int) -> Int {\n        if i < 0 {\n            return 0;\n        }\n        match self.entries.get(i) {\n            Some(e) => e.height,\n            None => 0,\n        }\n    }\n\n    fn left(&self, i: Int) -> Int {\n        match self.entries.get(i) {\n            Some(e) => e.next,\n            None => -1,\n        }\n    }\n\n    fn right(&self, i: Int) -> Int {\n        match self.entries.get(i) {\n            Some(e) => e.right,\n            None => -1,\n        }\n    }\n\n    fn set_children(&mut self, i: Int, l: Int, r: Int) {\n        match self.entries.get(i) {\n            Some(mut e) => {\n                e.next = l;\n                e.right = r;\n                e.height = 1 + self.height(l).max(self.height(r));\n            }\n            None => {}\n        }\n    }\n\n    fn rebalance(&mut self, i: Int) -> Int {\n        let l = self.left(i);\n        let r = self.right(i);\n        let bal = self.height(l) - self.height(r);\n        if bal > 1 {\n            // left heavy\n            let ll = self.left(l);\n            let lr = self.right(l);\n            if self.height(ll) >= self.height(lr) {\n                self.set_children(i, lr, r);\n                self.set_children(l, ll, i);\n                return l;\n            }\n            self.set_children(l, ll, self.left(lr));\n            self.set_children(i, self.right(lr), r);\n            self.set_children(lr, l, i);\n            return lr;\n        }\n        if bal < -1 {\n            let rl = self.left(r);\n            let rr = self.right(r);\n            if self.height(rr) >= self.height(rl) {\n                self.set_children(i, l, rl);\n                self.set_children(r, i, rr);\n                return r;\n            }\n            self.set_children(r, self.right(rl), rr);\n            self.set_children(i, l, self.left(rl));\n            self.set_children(rl, i, r);\n            return rl;\n        }\n        self.set_children(i, l, r);\n        i\n    }\n\n    // tree_min_remove removes the leftmost node of the tree at root,\n    // returning (new root, removed node).\n    fn tree_min_remove(&mut self, root: Int) -> (Int, Int) {\n        let l = self.left(root);\n        if l < 0 {\n            return (self.right(root), root);\n        }\n        let (nl, m) = self.tree_min_remove(l);\n        self.set_children(root, nl, self.right(root));\n        (self.rebalance(root), m)\n    }\n}\n\nimpl<K: Hash + Eq + Ord, V> HashMap<K, V> {\n    fn key_at(&self, i: Int, k: &K) -> Bool {\n        match self.entries.get(i) {\n            Some(e) => e.key == *k,\n            None => false,\n        }\n    }\n\n    // find returns the index of the live entry with key k, or -1.\n    fn find(&self, k: &K, hash: Int) -> Int {\n        let b = self.bucket_of(hash);\n        let mut i = self.buckets.get(b).unwrap_or(-1);\n        if self.tree.get(b).unwrap_or(false) {\n            while i >= 0 {\n                match self.entries.get(i) {\n                    Some(e) => match k.cmp(&e.key) {\n                        Ordering::Less => {\n                            i = e.next;\n                        }\n                        Ordering::Greater => {\n                            i = e.right;\n                        }\n                        Ordering::Equal => {\n                            return i;\n                        }\n                    },\n                    None => {\n                        return -1;\n                    }\n                }\n            }\n            return -1;\n        }\n        while i >= 0 {\n            match self.entries.get(i) {\n                Some(e) => {\n                    if e.hash == hash && e.key == *k {\n                        return i;\n                    }\n                    i = e.next;\n                }\n                None => {\n                    return -1;\n                }\n            }\n        }\n        -1\n    }\n\n    fn get(&self, k: &K) -> Option<V> {\n        let i = self.find(k, __hash_of(k));\n        if i < 0 {\n            return None;\n        }\n        match self.entries.get(i) {\n            Some(e) => Some(e.value),\n            None => None,\n        }\n    }\n\n    fn contains_key(&self, k: &K) -> Bool {\n        self.find(k, __hash_of(k)) >= 0\n    }\n\n    // insert sets the value of k, returning its previous value.\n    fn insert(&mut self, k: K, v: V) -> Option<V> {\n        let hash = __hash_of(&k);\n        let i = self.find(&k, hash);\n        if i >= 0 {\n            match self.entries.get(i) {\n                Some(mut e) => {\n                    let old = e.value;\n                    e.value = v;\n                    return Some(old);\n                }\n                None => {}\n            }\n        }\n        if (self.entries.len() + 1) * 4 > self.buckets.len() * 3 {\n            self.rebuild(self.len + 1);\n        }\n        let e = HashEntry {\n            key: k,\n            value: v,\n            hash: hash,\n            seq: self.next_seq,\n            next: -1,\n            right: -1,\n            height: 1,\n        };\n        self.next_seq = self.next_seq + 1;\n        self.entries.push(e);\n        self.live.push(true);\n        self.len = self.len + 1;\n        self.link(self.entries.len() - 1);\n        None\n    }\n\n    // remove removes k, returning its value.\n    fn remove(&mut self, k: &K) -> Option<V> {\n        let hash = __hash_of(k);\n        let i = self.find(k, hash);\n        if i < 0 {\n            return None;\n        }\n        let b = self.bucket_of(hash);\n        if self.tree.get(b).unwrap_or(false) {\n            let root = self.tree_remove(self.buckets.get(b).unwrap_or(-1), k);\n            self.buckets.set(b, root);\n        } else {\n            let mut prev = -1;\n            let mut j = self.buckets.get(b).unwrap_or(-1);\n            while j >= 0 && j != i {\n                prev = j;\n                j = self.left(j);\n            }\n            let nx = self.left(i);\n            if prev < 0 {\n                self.buckets.set(b, nx);\n            } else {\n                match self.entries.get(prev) {\n                    Some(mut pe) => {\n                        pe.next = nx;\n                    }\n                    None => {}\n                }\n            }\n        }\n        self.live.set(i, false);\n        self.len = self.len - 1;\n        match self.entries.get(i) {\n            Some(e) => Some(e.value),\n            None => None,\n        }\n    }\n\n    // link adds entry i to its bucket.\n    fn link(&mut self, i: Int) {\n        let hash = match self.entries.get(i) {\n            Some(e) => e.hash,\n            None => 0,\n        };\n        let b = self.bucket_of(hash);\n        let head = self.buckets.get(b).unwrap_or(-1);\n        if self.tree.get(b).unwrap_or(false) {\n            self.buckets.set(b, self.tree_insert(head, i));\n            return;\n        }\n        // append to the chain, counting it\n        match self.entries.get(i) {\n            Some(mut e) => {\n                e.next = -1;\n                e.right = -1;\n                e.height = 1;\n            }\n            None => {}\n        }\n        if head < 0 {\n            self.buckets.set(b, i);\n            return;\n        }\n        let mut n = 1;\n        let mut j = head;\n        while self.left(j) >= 0 {\n            j = self.left(j);\n            n = n + 1;\n        }\n        match self.entries.get(j) {\n            Some(mut e) => {\n                e.next = i;\n            }\n            None => {}\n        }\n        if n + 1 > __hashmap_treeify_len() {\n            self.treeify(b);\n        }\n    }\n\n    // treeify turns bucket b's chain into a tree.\n    fn treeify(&mut self, b: Int) {\n        let mut j = self.buckets.get(b).unwrap_or(-1);\n        let mut root = -1;\n        while j >= 0 {\n            let nx = self.left(j);\n            root = self.tree_insert(root, j);\n            j = nx;\n        }\n        self.buckets.set(b, root);\n        self.tree.set(b, true);\n    }\n\n    fn tree_insert(&mut self, root: Int, i: Int) -> Int {\n        if root < 0 {\n            self.set_children(i, -1, -1);\n            return i;\n        }\n        let ki = match self.entries.get(i) {\n            Some(e) => e.key,\n            None => {\n                return root;\n            }\n        };\n        let less = match self.entries.get(root) {\n            Some(r) => ki < r.key,\n            None => false,\n        };\n        if less {\n            let l = self.tree_insert(self.left(root), i);\n            self.set_children(root, l, self.right(root));\n        } else {\n            let r = self.tree_insert(self.right(root), i);\n            self.set_children(root, self.left(root), r);\n        }\n        self.rebalance(root)\n    }\n\n    fn tree_remove(&mut self, root: Int, k: &K) -> Int {\n        if root < 0 {\n            return -1;\n        }\n        let o = match self.entries.get(root) {\n            Some(r) => k.cmp(&r.key),\n            None => Ordering::Equal,\n        };\n        match o {\n            Ordering::Less => {\n                let l = self.tree_remove(self.left(root), k);\n                self.set_children(root, l, self.right(root));\n                self.rebalance(root)\n            }\n            Ordering::Greater => {\n                let r = self.tree_remove(self.right(root), k);\n                self.set_children(root, self.left(root), r);\n                self.rebalance(root)\n            }\n            Ordering::Equal => {\n                let l = self.left(root);\n                let r = self.right(root);\n                if r < 0 {\n                    return l;\n                }\n                let (nr, m) = self.tree_min_remove(r);\n                self.set_children(m, l, nr);\n                self.rebalance(m)\n            }\n        }\n    }\n\n    // rebuild drops removed entries and rehashes into a table with room for\n    // at least want entries.\n    fn rebuild(&mut self, want: Int) {\n        let mut es = Vec::new();\n        let mut lv = Vec::new();\n        for i in 0..self.entries.len() {\n            if self.is_live(i) {\n                match self.entries.get(i) {\n                    Some(e) => {\n                        es.push(e);\n                        lv.push(true);\n                    }\n                    None => {}\n                }\n            }\n        }\n        if es.len() != self.entries.len() {\n            self.epoch = self.epoch + 1;\n        }\n        self.entries = es;\n        self.live = lv;\n        let mut size = 8;\n        while size * 3 < (want + 1) * 4 {\n            size = size * 2;\n        }\n        self.buckets = Vec::new();\n        self.tree = Vec::new();\n        for i in 0..size {\n            self.buckets.push(-1);\n            self.tree.push(false);\n        }\n        for i in 0..self.entries.len() {\n            self.link(i);\n        }\n    }\n\n    // get_or returns the value of k, or d.\n    fn get_or(&self, k: &K, d: V) -> V {\n        match self.get(k) {\n            Some(v) => v,\n            None => d,\n        }\n    }\n\n    fn retain(&mut self, f: impl Fn(K, V) -> Bool) {\n        let mut drop = Vec::new();\n        for (k, v) in self.iter() {\n            if !f(k, v) {\n                drop.push(k);\n            }\n        }\n        for k in drop {\n            self.remove(&k);\n        }\n    }\n\n    fn extend<I: Iterator<Item = (K, V)>>(&mut self, mut iter: I) {\n        while let Some((k, v)) = iter.next() {\n            self.insert(k, v);\n        }\n    }\n}\n\n// ---- iteration ----\n\nstruct HashMapIter<K, V> {\n    map: HashMap<K, V>,\n    mut i: Int,\n    mut epoch: Int,\n    mut last_seq: Int,\n}\n\nimpl<K, V> Iterator for HashMapIter<K, V> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        let m = self.map;\n        if self.epoch != m.epoch {\n            // the entries were compacted (order kept): continue after the\n            // last entry returned, by its sequence number\n            let mut lo = 0;\n            let mut hi = m.entries.len();\n            while lo < hi {\n                let mid = (lo + hi) / 2;\n                let s = match m.entries.get(mid) {\n                    Some(e) => e.seq,\n                    None => 0,\n                };\n                if s <= self.last_seq {\n                    lo = mid + 1;\n                } else {\n                    hi = mid;\n                }\n            }\n            self.i = lo;\n            self.epoch = m.epoch;\n        }\n        while self.i < m.entries.len() {\n            let i = self.i;\n            self.i = i + 1;\n            if m.is_live(i) {\n                match m.entries.get(i) {\n                    Some(e) => {\n                        self.last_seq = e.seq;\n                        return Some((e.key, e.value));\n                    }\n                    None => {}\n                }\n            }\n        }\n        None\n    }\n}\n\nstruct Keys<K, V> {\n    it: HashMapIter<K, V>,\n}\n\nimpl<K, V> Iterator for Keys<K, V> {\n    type Item = K;\n\n    fn next(&mut self) -> Option<K> {\n        match self.it.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nstruct Values<K, V> {\n    it: HashMapIter<K, V>,\n}\n\nimpl<K, V> Iterator for Values<K, V> {\n    type Item = V;\n\n    fn next(&mut self) -> Option<V> {\n        match self.it.next() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\nimpl<K, V> IntoIterator for HashMap<K, V> {\n    type Item = (K, V);\n    type IntoIter = HashMapIter<K, V>;\n\n    fn into_iter(self) -> HashMapIter<K, V> {\n        self.iter()\n    }\n}\n\nimpl<K: Hash + Eq + Ord, V> FromIterator<(K, V)> for HashMap<K, V> {\n    fn from_iter<I: Iterator<Item = (K, V)>>(iter: I) -> HashMap<K, V> {\n        let mut m = HashMap::new();\n        m.extend(iter);\n        m\n    }\n}\n\nimpl<K: Hash + Eq + Ord + Clone, V: Clone> Clone for HashMap<K, V> {\n    fn clone(&self) -> HashMap<K, V> {\n        let mut m = HashMap::with_capacity(self.len());\n        for (k, v) in self.iter() {\n            m.insert(k.clone(), v.clone());\n        }\n        m\n    }\n}\n\nimpl<K, V> Default for HashMap<K, V> {\n    fn default() -> HashMap<K, V> {\n        HashMap::new()\n    }\n}\n\n// ---- HashSet ----\n\nstruct HashSet<T> {\n    map: HashMap<T, ()>,\n}\n\nimpl<T> HashSet<T> {\n    fn new() -> HashSet<T> {\n        HashSet { map: HashMap::new() }\n    }\n\n    fn with_capacity(n: Int) -> HashSet<T> {\n        HashSet { map: HashMap::with_capacity(n) }\n    }\n\n    fn len(&self) -> Int {\n        self.map.len()\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.map.is_empty()\n    }\n\n    fn clear(&mut self) {\n        self.map.clear();\n    }\n\n    // iter returns the elements in insertion order.\n    #[fresh]\n    fn iter(&self) -> Keys<T, ()> {\n        self.map.keys()\n    }\n}\n\nimpl<T: Hash + Eq + Ord> HashSet<T> {\n    // insert adds x, reporting whether it was new.\n    fn insert(&mut self, x: T) -> Bool {\n        self.map.insert(x, ()).is_none()\n    }\n\n    fn contains(&self, x: &T) -> Bool {\n        self.map.contains_key(x)\n    }\n\n    // remove removes x, reporting whether it was present.\n    fn remove(&mut self, x: &T) -> Bool {\n        self.map.remove(x).is_some()\n    }\n\n    fn extend<I: Iterator<Item = T>>(&mut self, mut iter: I) {\n        while let Some(x) = iter.next() {\n            self.insert(x);\n        }\n    }\n\n    fn retain(&mut self, f: impl Fn(T) -> Bool) {\n        let mut drop = Vec::new();\n        for x in self.iter() {\n            if !f(x) {\n                drop.push(x);\n            }\n        }\n        for x in drop {\n            self.remove(&x);\n        }\n    }\n\n    fn is_subset(&self, other: &HashSet<T>) -> Bool {\n        for x in self.iter() {\n            if !other.contains(&x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // union, intersection and difference return the resulting elements in\n    // order (self's first).\n    #[fresh]\n    fn union(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out: Vec<T> = self.iter().collect();\n        for x in other.iter() {\n            if !self.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    #[fresh]\n    fn intersection(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            if other.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    #[fresh]\n    fn difference(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            if !other.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n}\n\nimpl<T> IntoIterator for HashSet<T> {\n    type Item = T;\n    type IntoIter = Keys<T, ()>;\n\n    fn into_iter(self) -> Keys<T, ()> {\n        self.iter()\n    }\n}\n\nimpl<T: Hash + Eq + Ord> FromIterator<T> for HashSet<T> {\n    fn from_iter<I: Iterator<Item = T>>(iter: I) -> HashSet<T> {\n        let mut s = HashSet::new();\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T: Hash + Eq + Ord + Clone> Clone for HashSet<T> {\n    fn clone(&self) -> HashSet<T> {\n        let mut s = HashSet::with_capacity(self.len());\n        for x in self.iter() {\n            s.insert(x.clone());\n        }\n        s\n    }\n}\n\nimpl<T> Default for HashSet<T> {\n    fn default() -> HashSet<T> {\n        HashSet::new()\n    }\n}\n",
    );
    core_file(
        v,
        "iter.kek",
        "// Iterators, as in Rust's core::iter: the Iterator trait with its adapters\n// and consumers, ranges, and the iterators of Vec.\n//\n// Closures are pure values here: an adapter keeps its closure in a field\n// of type `fn(A) -> B`.\n\ntrait Iterator {\n    type Item;\n\n    fn next(&mut self) -> Option<Self::Item>;\n\n    // ---- consumers ----\n\n    fn count(mut self) -> Int {\n        let mut n = 0;\n        while let Some(_) = self.next() {\n            n = n + 1;\n        }\n        n\n    }\n\n    fn last(mut self) -> Option<Self::Item> {\n        let mut last = None;\n        while let Some(x) = self.next() {\n            last = Some(x);\n        }\n        last\n    }\n\n    fn nth(&mut self, n: Int) -> Option<Self::Item> {\n        let mut i = 0;\n        while i < n {\n            if self.next().is_none() {\n                return None;\n            }\n            i = i + 1;\n        }\n        self.next()\n    }\n\n    fn fold<B>(mut self, init: B, f: impl Fn(B, Self::Item) -> B) -> B {\n        let mut acc = init;\n        while let Some(x) = self.next() {\n            acc = f(acc, x);\n        }\n        acc\n    }\n\n    fn for_each(mut self, f: impl Fn(Self::Item)) {\n        while let Some(x) = self.next() {\n            f(x);\n        }\n    }\n\n    fn any(&mut self, p: impl Fn(Self::Item) -> Bool) -> Bool {\n        while let Some(x) = self.next() {\n            if p(x) {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn all(&mut self, p: impl Fn(Self::Item) -> Bool) -> Bool {\n        while let Some(x) = self.next() {\n            if !p(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    fn find(&mut self, p: impl Fn(Self::Item) -> Bool) -> Option<Self::Item> {\n        while let Some(x) = self.next() {\n            if p(x) {\n                return Some(x);\n            }\n        }\n        None\n    }\n\n    fn find_map<B>(&mut self, f: impl Fn(Self::Item) -> Option<B>) -> Option<B> {\n        while let Some(x) = self.next() {\n            match f(x) {\n                Some(y) => {\n                    return Some(y);\n                }\n                None => {}\n            }\n        }\n        None\n    }\n\n    fn position(&mut self, p: impl Fn(Self::Item) -> Bool) -> Option<Int> {\n        let mut i = 0;\n        while let Some(x) = self.next() {\n            if p(x) {\n                return Some(i);\n            }\n            i = i + 1;\n        }\n        None\n    }\n\n    #[fresh]\n    fn collect<B: FromIterator<Self::Item>>(self) -> B {\n        B::from_iter(self)\n    }\n\n    fn sum<S: Sum<Self::Item>>(self) -> S {\n        S::sum(self)\n    }\n\n    fn product<P: Product<Self::Item>>(self) -> P {\n        P::product(self)\n    }\n\n    fn max(mut self) -> Option<Self::Item>\n    where\n        Self::Item: Ord,\n    {\n        let mut best = None;\n        while let Some(x) = self.next() {\n            best = match best {\n                Some(b) => if x >= b { Some(x) } else { Some(b) },\n                None => Some(x),\n            };\n        }\n        best\n    }\n\n    fn min(mut self) -> Option<Self::Item>\n    where\n        Self::Item: Ord,\n    {\n        let mut best = None;\n        while let Some(x) = self.next() {\n            best = match best {\n                Some(b) => if x < b { Some(x) } else { Some(b) },\n                None => Some(x),\n            };\n        }\n        best\n    }\n\n    fn max_by_key<B: Ord>(mut self, f: impl Fn(Self::Item) -> B) -> Option<Self::Item> {\n        let mut best = None;\n        let mut best_k = None;\n        while let Some(x) = self.next() {\n            let k = f(x);\n            let better = match best_k {\n                Some(bk) => k >= bk,\n                None => true,\n            };\n            if better {\n                best = Some(x);\n                best_k = Some(k);\n            }\n        }\n        best\n    }\n\n    fn min_by_key<B: Ord>(mut self, f: impl Fn(Self::Item) -> B) -> Option<Self::Item> {\n        let mut best = None;\n        let mut best_k = None;\n        while let Some(x) = self.next() {\n            let k = f(x);\n            let better = match best_k {\n                Some(bk) => k < bk,\n                None => true,\n            };\n            if better {\n                best = Some(x);\n                best_k = Some(k);\n            }\n        }\n        best\n    }\n\n    // ---- adapters ----\n\n    #[fresh]\n    fn map<B>(self, f: impl Fn(Self::Item) -> B) -> Map<Self, Self::Item, B> {\n        Map { iter: self, f: f }\n    }\n\n    #[fresh]\n    fn filter(self, p: impl Fn(Self::Item) -> Bool) -> Filter<Self, Self::Item> {\n        Filter { iter: self, p: p }\n    }\n\n    #[fresh]\n    fn filter_map<B>(self, f: impl Fn(Self::Item) -> Option<B>) -> FilterMap<Self, Self::Item, B> {\n        FilterMap { iter: self, f: f }\n    }\n\n    #[fresh]\n    fn enumerate(self) -> Enumerate<Self> {\n        Enumerate { iter: self, i: 0 }\n    }\n\n    #[fresh]\n    fn zip<U: Iterator>(self, other: U) -> Zip<Self, U> {\n        Zip { a: self, b: other }\n    }\n\n    #[fresh]\n    fn chain<U: Iterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U> {\n        Chain { a: self, b: other, first: true }\n    }\n\n    #[fresh]\n    fn take(self, n: Int) -> Take<Self> {\n        Take { iter: self, n: n }\n    }\n\n    #[fresh]\n    fn skip(self, n: Int) -> Skip<Self> {\n        Skip { iter: self, n: n }\n    }\n\n    #[fresh]\n    fn take_while(self, p: impl Fn(Self::Item) -> Bool) -> TakeWhile<Self, Self::Item> {\n        TakeWhile { iter: self, p: p, done: false }\n    }\n\n    #[fresh]\n    fn skip_while(self, p: impl Fn(Self::Item) -> Bool) -> SkipWhile<Self, Self::Item> {\n        SkipWhile { iter: self, p: p, started: false }\n    }\n\n    #[fresh]\n    fn step_by(self, step: Int) -> StepBy<Self> {\n        StepBy { iter: self, step: step, first: true }\n    }\n\n    #[fresh]\n    fn peekable(self) -> Peekable<Self, Self::Item> {\n        Peekable { iter: self, peeked: None, has: false }\n    }\n}\n\n// An iterator that can also produce its elements from the back.\ntrait DoubleEndedIterator: Iterator {\n    fn next_back(&mut self) -> Option<Self::Item>;\n\n    #[fresh]\n    fn rev(self) -> Rev<Self> {\n        Rev { iter: self }\n    }\n}\n\n// Conversion into an iterator (what a `for` loop iterates over).\ntrait IntoIterator {\n    type Item;\n    type IntoIter;\n\n    #[fresh]\n    fn into_iter(self) -> Self::IntoIter;\n}\n\n// Building a collection from an iterator (`collect`).\ntrait FromIterator<A> {\n    #[fresh]\n    fn from_iter<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\ntrait Sum<A> {\n    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\ntrait Product<A> {\n    fn product<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\n// ---- adapters ----\n\nstruct Map<I, A, B> {\n    iter: I,\n    f: fn(A) -> B,\n}\n\nimpl<I: Iterator<Item = A>, A, B> Iterator for Map<I, A, B> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        match self.iter.next() {\n            Some(x) => Some((self.f)(x)),\n            None => None,\n        }\n    }\n}\n\nstruct Filter<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for Filter<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        while let Some(x) = self.iter.next() {\n            if (self.p)(x) {\n                return Some(x);\n            }\n        }\n        None\n    }\n}\n\nstruct FilterMap<I, A, B> {\n    iter: I,\n    f: fn(A) -> Option<B>,\n}\n\nimpl<I: Iterator<Item = A>, A, B> Iterator for FilterMap<I, A, B> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        while let Some(x) = self.iter.next() {\n            match (self.f)(x) {\n                Some(y) => {\n                    return Some(y);\n                }\n                None => {}\n            }\n        }\n        None\n    }\n}\n\nstruct Enumerate<I> {\n    iter: I,\n    mut i: Int,\n}\n\nimpl<I: Iterator> Iterator for Enumerate<I> {\n    type Item = (Int, I::Item);\n\n    fn next(&mut self) -> Option<(Int, I::Item)> {\n        match self.iter.next() {\n            Some(x) => {\n                let i = self.i;\n                self.i = i + 1;\n                Some((i, x))\n            }\n            None => None,\n        }\n    }\n}\n\nstruct Zip<A, B> {\n    a: A,\n    b: B,\n}\n\nimpl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {\n    type Item = (A::Item, B::Item);\n\n    fn next(&mut self) -> Option<(A::Item, B::Item)> {\n        match self.a.next() {\n            Some(x) => match self.b.next() {\n                Some(y) => Some((x, y)),\n                None => None,\n            },\n            None => None,\n        }\n    }\n}\n\nstruct Chain<A, B> {\n    a: A,\n    b: B,\n    mut first: Bool,\n}\n\nimpl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {\n    type Item = A::Item;\n\n    fn next(&mut self) -> Option<A::Item> {\n        if self.first {\n            match self.a.next() {\n                Some(x) => {\n                    return Some(x);\n                }\n                None => {\n                    self.first = false;\n                }\n            }\n        }\n        self.b.next()\n    }\n}\n\nstruct Take<I> {\n    iter: I,\n    mut n: Int,\n}\n\nimpl<I: Iterator> Iterator for Take<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n <= 0 {\n            return None;\n        }\n        self.n = self.n - 1;\n        self.iter.next()\n    }\n}\n\nstruct Skip<I> {\n    iter: I,\n    mut n: Int,\n}\n\nimpl<I: Iterator> Iterator for Skip<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        while self.n > 0 {\n            self.n = self.n - 1;\n            if self.iter.next().is_none() {\n                return None;\n            }\n        }\n        self.iter.next()\n    }\n}\n\nstruct TakeWhile<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n    mut done: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for TakeWhile<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.done {\n            return None;\n        }\n        match self.iter.next() {\n            Some(x) => {\n                if (self.p)(x) {\n                    return Some(x);\n                }\n                self.done = true;\n                None\n            }\n            None => None,\n        }\n    }\n}\n\nstruct SkipWhile<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n    mut started: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for SkipWhile<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.started {\n            return self.iter.next();\n        }\n        while let Some(x) = self.iter.next() {\n            if !(self.p)(x) {\n                self.started = true;\n                return Some(x);\n            }\n        }\n        None\n    }\n}\n\nstruct StepBy<I> {\n    iter: I,\n    step: Int,\n    mut first: Bool,\n}\n\nimpl<I: Iterator> Iterator for StepBy<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.first {\n            self.first = false;\n            return self.iter.next();\n        }\n        self.iter.nth(self.step - 1)\n    }\n}\n\nstruct Peekable<I, A> {\n    iter: I,\n    mut peeked: Option<A>,\n    mut has: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Peekable<I, A> {\n    // peek returns the next element without consuming it.\n    fn peek(&mut self) -> Option<A> {\n        if !self.has {\n            self.peeked = self.iter.next();\n            self.has = true;\n        }\n        self.peeked\n    }\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for Peekable<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.has {\n            self.has = false;\n            return self.peeked;\n        }\n        self.iter.next()\n    }\n}\n\nstruct Rev<I> {\n    iter: I,\n}\n\nimpl<I: DoubleEndedIterator> Iterator for Rev<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        self.iter.next_back()\n    }\n}\n\n// ---- ranges ----\n\n// `start..end`: the integers from start up to (excluding) end.\nstruct Range {\n    mut start: Int,\n    mut end: Int,\n}\n\nimpl Range {\n    fn contains(&self, x: Int) -> Bool {\n        self.start <= x && x < self.end\n    }\n\n    fn len(&self) -> Int {\n        if self.end > self.start {\n            self.end - self.start\n        } else {\n            0\n        }\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.start >= self.end\n    }\n}\n\nimpl Iterator for Range {\n    type Item = Int;\n\n    fn next(&mut self) -> Option<Int> {\n        if self.start < self.end {\n            let x = self.start;\n            self.start = x + 1;\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\nimpl DoubleEndedIterator for Range {\n    fn next_back(&mut self) -> Option<Int> {\n        if self.start < self.end {\n            self.end = self.end - 1;\n            Some(self.end)\n        } else {\n            None\n        }\n    }\n}\n\n// `start..=end`: the integers from start up to (including) end.\nstruct RangeInclusive {\n    mut start: Int,\n    mut end: Int,\n}\n\nimpl RangeInclusive {\n    fn contains(&self, x: Int) -> Bool {\n        self.start <= x && x <= self.end\n    }\n}\n\nimpl Iterator for RangeInclusive {\n    type Item = Int;\n\n    fn next(&mut self) -> Option<Int> {\n        if self.start <= self.end {\n            let x = self.start;\n            if x == self.end {\n                // stop without overflowing at the largest Int\n                self.end = x - 1;\n                self.start = x;\n            } else {\n                self.start = x + 1;\n            }\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\nimpl DoubleEndedIterator for RangeInclusive {\n    fn next_back(&mut self) -> Option<Int> {\n        if self.start <= self.end {\n            let x = self.end;\n            if x == self.start {\n                self.start = x + 1;\n                self.end = x;\n            } else {\n                self.end = x - 1;\n            }\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\n// ---- Vec ----\n\n// Iter iterates over a Vec by index. Like a `for` loop over a Vec, it sees\n// elements pushed while iterating.\nstruct Iter<T> {\n    v: Vec<T>,\n    mut i: Int,\n    mut end: Int,\n}\n\nimpl<T> Vec<T> {\n    #[fresh]\n    fn iter(&self) -> Iter<T> {\n        Iter { v: *self, i: 0, end: -1 }\n    }\n}\n\nimpl<T> Iterator for Iter<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        let n = if self.end < 0 { self.v.len() } else { self.end };\n        if self.i < n {\n            let x = self.v.get(self.i);\n            self.i = self.i + 1;\n            x\n        } else {\n            None\n        }\n    }\n}\n\nimpl<T> DoubleEndedIterator for Iter<T> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.end < 0 {\n            self.end = self.v.len();\n        }\n        if self.i < self.end {\n            self.end = self.end - 1;\n            self.v.get(self.end)\n        } else {\n            None\n        }\n    }\n}\n\nimpl<T> IntoIterator for Vec<T> {\n    type Item = T;\n    type IntoIter = Iter<T>;\n\n    fn into_iter(self) -> Iter<T> {\n        self.iter()\n    }\n}\n\nimpl<T> FromIterator<T> for Vec<T> {\n    fn from_iter<I: Iterator<Item = T>>(mut iter: I) -> Vec<T> {\n        let mut v = Vec::new();\n        while let Some(x) = iter.next() {\n            v.push(x);\n        }\n        v\n    }\n}\n\nimpl FromIterator<String> for String {\n    fn from_iter<I: Iterator<Item = String>>(mut iter: I) -> String {\n        let mut parts = Vec::new();\n        while let Some(s) = iter.next() {\n            parts.push(s);\n        }\n        parts.join(\"\")\n    }\n}\n\nimpl Sum<Int> for Int {\n    fn sum<I: Iterator<Item = Int>>(mut iter: I) -> Int {\n        let mut s = 0;\n        while let Some(x) = iter.next() {\n            s = s + x;\n        }\n        s\n    }\n}\n\nimpl Product<Int> for Int {\n    fn product<I: Iterator<Item = Int>>(mut iter: I) -> Int {\n        let mut p = 1;\n        while let Some(x) = iter.next() {\n            p = p * x;\n        }\n        p\n    }\n}\n",
    );
    core_file(
        v,
        "labeled.kek",
        "// Information flow (docs/authz-flow.md): a value labeled L, such as\n// personal data (`Labeled<PII, String>`), cannot reach an output that\n// takes plain values: a log, a response, the store, the network, an error\n// message.\n//\n// The field is private to the core library: identifiers starting with\n// `__` are reserved for the core library and the runtime prelude, so a\n// program can neither read `__value` nor build `Labeled { ... }`. Labeled\n// implements no trait that renders, compares, orders or hashes it, so it\n// cannot reach an output through `+`, `to_string`, `==`, a capability\n// argument or a generic function.\n//\n// Computing on the contents happens only inside the closures given to map,\n// zip and and_then, whose results are labeled again: a branch on a labeled\n// value can only be taken there (the \"program counter\" carries the label).\n// The type checker makes these closures unable to leak by side effects:\n// they take the contents as shared (read-only) values and capture no\n// mutable state and no function values (closures cannot capture\n// capabilities anyway). So a program that does not declassify satisfies\n// non-interference: its plain outputs do not depend on labeled inputs\n// (lean/Kekkai/Flow.lean).\n//\n// The only ways out are the declassifications below, which `kek caps`\n// lists and `kek assure` records (flow.declassify):\n//\n//   p.mask()              Labeled<L, String> -> String, for display\n//   p.hash()              a fixed (unseeded) hash as 16 hex digits\n//   p.expose_unchecked()  the value itself (the escape hatch)\n\n// PII labels personal data.\nstruct PII {}\n\nimpl PII {\n    // label labels x as personal data.\n    fn label<T>(x: T) -> Labeled<PII, T> {\n        Labeled { __value: x }\n    }\n}\n\nstruct Labeled<L, T> {\n    __value: T,\n}\n\nimpl<L, T> Labeled<L, T> {\n    // new labels x (the label comes from the expected type:\n    // `let e: Labeled<PII, String> = Labeled::new(s)`).\n    fn new(x: T) -> Labeled<L, T> {\n        Labeled { __value: x }\n    }\n\n    // map computes on the contents; the result keeps the label.\n    fn map<U>(&self, f: fn(&T) -> U) -> Labeled<L, U> {\n        Labeled { __value: f(&self.__value) }\n    }\n\n    // zip combines two values of the same label.\n    fn zip<U, V>(&self, other: &Labeled<L, U>, f: fn(&T, &U) -> V) -> Labeled<L, V> {\n        Labeled { __value: f(&self.__value, &other.__value) }\n    }\n\n    // and_then computes a labeled value from the contents.\n    fn and_then<U>(&self, f: fn(&T) -> Labeled<L, U>) -> Labeled<L, U> {\n        f(&self.__value)\n    }\n\n    // expose_unchecked returns the value: a declassification.\n    fn expose_unchecked(&self) -> T {\n        self.__value\n    }\n}\n\nimpl<L, T: Hash> Labeled<L, T> {\n    // hash is the default hasher's (fixed, unseeded) hash of the value, as\n    // 16 lowercase hex digits: a declassification that keeps equality (to\n    // join or count records) but not the value.\n    fn hash(&self) -> String {\n        let mut h = DefaultHasher::new();\n        self.__value.hash(&mut h);\n        __labeled_hex(h.finish())\n    }\n}\n\nimpl<L> Labeled<L, String> {\n    // mask keeps the first character and everything from the last `@` on\n    // (the domain of an e-mail address) and replaces every other\n    // character (code point) by `*`: \"alice@example.com\" ->\n    // \"a****@example.com\", \"bob\" -> \"b**\". When the part before the `@` is\n    // a single character it is masked too (\"a@x.com\" -> \"*@x.com\", \"x\" ->\n    // \"*\"), and \"\" stays \"\".\n    fn mask(&self) -> String {\n        let s = self.__value;\n        if s.len() == 0 {\n            return \"\";\n        }\n        let cs = s.split(\"\");\n        let n = cs.len();\n        let mut at = n;\n        let mut i = 0;\n        while i < n {\n            if cs.get(i).unwrap_or(\"\") == \"@\" {\n                at = i;\n            }\n            i = i + 1;\n        }\n        let mut parts = Vec::new();\n        for j in 0..at {\n            if j == 0 && at > 1 {\n                parts.push(cs.get(0).unwrap_or(\"\"));\n            } else {\n                parts.push(\"*\");\n            }\n        }\n        for j in at..n {\n            parts.push(cs.get(j).unwrap_or(\"\"));\n        }\n        parts.join(\"\")\n    }\n}\n\nimpl<L, T: Clone> Clone for Labeled<L, T> {\n    fn clone(&self) -> Labeled<L, T> {\n        Labeled { __value: self.__value.clone() }\n    }\n}\n\n// __labeled_hex renders x as 16 lowercase hex digits (two's complement).\nfn __labeled_hex(x: Int) -> String {\n    let digits = \"0123456789abcdef\";\n    let mut parts = Vec::new();\n    let mut i = 15;\n    while i >= 0 {\n        let d = x.ushr(i * 4).bit_and(15);\n        parts.push(digits.slice(d, d + 1));\n        i = i - 1;\n    }\n    parts.join(\"\")\n}\n",
    );
    v
}
