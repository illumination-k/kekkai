        v,
        "can.kek",
        "// Authorization (docs/authz-flow.md): `Can<A, r>` is the permission to do\n// the action A (a type, such as `struct Edit {}`) on the resource r, an\n// immutable variable or parameter: `fn edit(d: Doc, cap: Can<Edit, d>)`.\n// The resource is part of the type, so a permission for one document\n// cannot be used for another (`edit(other, cap)` is a type error), and a\n// function's signature says which of its arguments a permission refers\n// to (at a call, `d` becomes the argument passed for it).\n//\n// Only a `#[policy]` function can grant a permission, so every call of a\n// function that takes one went through a policy check:\n//\n//   #[policy]\n//   fn authorize(u: User, d: Doc) -> Option<Can<Edit, d>> {\n//       if d.owner == u.id { Some(Can::grant()) } else { None }\n//   }\n//\n// The field is private to the core library (`__` is reserved), so a\n// program cannot build `Can { ... }` either. `kek caps` lists the policies\n// and the permissions each function requires; `kek assure` records them.\n\nstruct Can<A, R> {\n    __granted: Bool,\n}\n\nimpl<A, R> Can<A, R> {\n    // grant is the permission itself; only a #[policy] function can call it.\n    fn grant() -> Can<A, R> {\n        Can { __granted: true }\n    }\n}\n",
    );
    core_file(
        v,
        "clone.kek",
        "// Cloning, as in Rust's core::clone. A value reached through a shared\n// reference (`&T`, `&self`, an element of a shared collection) cannot be\n// mutated or kept in an owning place; `x.clone()` is an owned deep copy\n// of it that can (docs/mutability.md). `#[derive(Clone)]` clones every\n// field; HashMap, HashSet and Labeled implement it in their files, tuples\n// with the other derived traits.\n\ntrait Clone {\n    fn clone(&self) -> Self;\n}\n\nimpl Clone for Int {\n    fn clone(&self) -> Int {\n        *self\n    }\n}\n\nimpl Clone for Bool {\n    fn clone(&self) -> Bool {\n        *self\n    }\n}\n\nimpl Clone for String {\n    fn clone(&self) -> String {\n        *self\n    }\n}\n\nimpl Clone for () {\n    fn clone(&self) -> () {\n        ()\n    }\n}\n\nimpl<T: Clone> Clone for Option<T> {\n    fn clone(&self) -> Option<T> {\n        match self {\n            Some(x) => Some(x.clone()),\n            None => None,\n        }\n    }\n}\n\nimpl<T: Clone, E: Clone> Clone for Result<T, E> {\n    fn clone(&self) -> Result<T, E> {\n        match self {\n            Ok(x) => Ok(x.clone()),\n            Err(e) => Err(e.clone()),\n        }\n    }\n}\n\nimpl<T: Clone> Clone for Vec<T> {\n    fn clone(&self) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            out.push(x.clone());\n        }\n        out\n    }\n}\n",
    );
    core_file(
        v,
        "cmp.kek",
        "// Comparison: equality (`==`) and ordering (`<`), as in Rust's core::cmp.\n\n#[derive(PartialEq, Eq, Clone, Debug)]\nenum Ordering {\n    Less,\n    Equal,\n    Greater,\n}\n\nimpl Ordering {\n    fn is_eq(self) -> Bool {\n        match self {\n            Ordering::Equal => true,\n            _ => false,\n        }\n    }\n\n    fn is_lt(self) -> Bool {\n        match self {\n            Ordering::Less => true,\n            _ => false,\n        }\n    }\n\n    fn is_gt(self) -> Bool {\n        match self {\n            Ordering::Greater => true,\n            _ => false,\n        }\n    }\n\n    fn reverse(self) -> Ordering {\n        match self {\n            Ordering::Less => Ordering::Greater,\n            Ordering::Equal => Ordering::Equal,\n            Ordering::Greater => Ordering::Less,\n        }\n    }\n\n    // then is the lexicographic combination: self, or other when equal.\n    fn then(self, other: Ordering) -> Ordering {\n        match self {\n            Ordering::Equal => other,\n            _ => self,\n        }\n    }\n}\n\ntrait PartialEq {\n    fn eq(&self, other: &Self) -> Bool;\n\n    fn ne(&self, other: &Self) -> Bool {\n        !self.eq(other)\n    }\n}\n\ntrait Eq: PartialEq {}\n\ntrait PartialOrd: PartialEq {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering>;\n\n    fn lt(&self, other: &Self) -> Bool {\n        match self.partial_cmp(other) {\n            Some(Ordering::Less) => true,\n            _ => false,\n        }\n    }\n\n    fn le(&self, other: &Self) -> Bool {\n        match self.partial_cmp(other) {\n            Some(Ordering::Less) => true,\n            Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n\n    fn gt(&self, other: &Self) -> Bool {\n        match self.partial_cmp(other) {\n            Some(Ordering::Greater) => true,\n            _ => false,\n        }\n    }\n\n    fn ge(&self, other: &Self) -> Bool {\n        match self.partial_cmp(other) {\n            Some(Ordering::Greater) => true,\n            Some(Ordering::Equal) => true,\n            _ => false,\n        }\n    }\n}\n\ntrait Ord: Eq + PartialOrd {\n    fn cmp(&self, other: &Self) -> Ordering;\n\n    fn max(self, other: Self) -> Self {\n        match self.cmp(&other) {\n            Ordering::Greater => self,\n            _ => other,\n        }\n    }\n\n    fn min(self, other: Self) -> Self {\n        match self.cmp(&other) {\n            Ordering::Greater => other,\n            _ => self,\n        }\n    }\n}\n\n// ---- primitive types ----\n\nimpl Int {\n    const MAX: Int = 9223372036854775807;\n    // (-9223372036854775808 is out of the range of a literal)\n    const MIN: Int = -Self::MAX - 1;\n}\n\nimpl PartialEq for Int {\n    fn eq(&self, other: &Self) -> Bool {\n        self == other\n    }\n}\n\nimpl Eq for Int {}\n\nimpl PartialOrd for Int {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        Some(self.cmp(other))\n    }\n}\n\nimpl Ord for Int {\n    fn cmp(&self, other: &Self) -> Ordering {\n        if self < other {\n            Ordering::Less\n        } else if self > other {\n            Ordering::Greater\n        } else {\n            Ordering::Equal\n        }\n    }\n}\n\nimpl PartialEq for Bool {\n    fn eq(&self, other: &Self) -> Bool {\n        self == other\n    }\n}\n\nimpl Eq for Bool {}\n\nimpl PartialOrd for Bool {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        Some(self.cmp(other))\n    }\n}\n\nimpl Ord for Bool {\n    fn cmp(&self, other: &Self) -> Ordering {\n        // false < true\n        if self == other {\n            Ordering::Equal\n        } else if *other {\n            Ordering::Less\n        } else {\n            Ordering::Greater\n        }\n    }\n}\n\nimpl PartialEq for String {\n    fn eq(&self, other: &Self) -> Bool {\n        self == other\n    }\n}\n\nimpl Eq for String {}\n\nimpl PartialOrd for String {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        Some(self.cmp(other))\n    }\n}\n\n// Strings are ordered by their UTF-16 code units.\nimpl Ord for String {\n    fn cmp(&self, other: &Self) -> Ordering {\n        let n = self.len().min(other.len());\n        let mut i = 0;\n        while i < n {\n            let a = self.char_at(i).unwrap_or(0);\n            let b = other.char_at(i).unwrap_or(0);\n            if a != b {\n                return a.cmp(&b);\n            }\n            i = i + 1;\n        }\n        self.len().cmp(&other.len())\n    }\n}\n\nimpl PartialEq for () {\n    fn eq(&self, other: &Self) -> Bool {\n        true\n    }\n}\n\nimpl Eq for () {}\n\nimpl PartialOrd for () {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        Some(Ordering::Equal)\n    }\n}\n\nimpl Ord for () {\n    fn cmp(&self, other: &Self) -> Ordering {\n        Ordering::Equal\n    }\n}\n\n// ---- Option, Result and Vec ----\n\nimpl<T: PartialEq> PartialEq for Option<T> {\n    fn eq(&self, other: &Self) -> Bool {\n        match self {\n            Some(a) => match other {\n                Some(b) => a == b,\n                None => false,\n            },\n            None => other.is_none(),\n        }\n    }\n}\n\nimpl<T: Eq> Eq for Option<T> {}\n\nimpl<T: PartialOrd> PartialOrd for Option<T> {\n    // None < Some(_)\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        match self {\n            Some(a) => match other {\n                Some(b) => a.partial_cmp(b),\n                None => Some(Ordering::Greater),\n            },\n            None => match other {\n                Some(_) => Some(Ordering::Less),\n                None => Some(Ordering::Equal),\n            },\n        }\n    }\n}\n\nimpl<T: Ord> Ord for Option<T> {\n    fn cmp(&self, other: &Self) -> Ordering {\n        match self {\n            Some(a) => match other {\n                Some(b) => a.cmp(b),\n                None => Ordering::Greater,\n            },\n            None => match other {\n                Some(_) => Ordering::Less,\n                None => Ordering::Equal,\n            },\n        }\n    }\n}\n\nimpl<T: PartialEq, E: PartialEq> PartialEq for Result<T, E> {\n    fn eq(&self, other: &Self) -> Bool {\n        match self {\n            Ok(a) => match other {\n                Ok(b) => a == b,\n                Err(_) => false,\n            },\n            Err(a) => match other {\n                Ok(_) => false,\n                Err(b) => a == b,\n            },\n        }\n    }\n}\n\nimpl<T: Eq, E: Eq> Eq for Result<T, E> {}\n\nimpl<T: PartialEq> PartialEq for Vec<T> {\n    fn eq(&self, other: &Self) -> Bool {\n        let n = self.len();\n        if n != other.len() {\n            return false;\n        }\n        let mut i = 0;\n        while i < n {\n            match self.get(i) {\n                Some(a) => match other.get(i) {\n                    Some(b) => {\n                        if a != b {\n                            return false;\n                        }\n                    }\n                    None => {\n                        return false;\n                    }\n                },\n                None => {\n                    return false;\n                }\n            }\n            i = i + 1;\n        }\n        true\n    }\n}\n\nimpl<T: Eq> Eq for Vec<T> {}\n\nimpl<T: PartialOrd> PartialOrd for Vec<T> {\n    // lexicographic\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        let n = self.len().min(other.len());\n        let mut i = 0;\n        while i < n {\n            match self.get(i) {\n                Some(a) => match other.get(i) {\n                    Some(b) => match a.partial_cmp(b) {\n                        Some(Ordering::Equal) => {}\n                        o => {\n                            return o;\n                        }\n                    },\n                    None => {}\n                },\n                None => {}\n            }\n            i = i + 1;\n        }\n        Some(self.len().cmp(&other.len()))\n    }\n}\n\nimpl<T: Ord> Ord for Vec<T> {\n    fn cmp(&self, other: &Self) -> Ordering {\n        let n = self.len().min(other.len());\n        let mut i = 0;\n        while i < n {\n            match self.get(i) {\n                Some(a) => match other.get(i) {\n                    Some(b) => match a.cmp(b) {\n                        Ordering::Equal => {}\n                        o => {\n                            return o;\n                        }\n                    },\n                    None => {}\n                },\n                None => {}\n            }\n            i = i + 1;\n        }\n        self.len().cmp(&other.len())\n    }\n}\n",
    );
    core_file(
        v,
        "convert.kek",
        "// Conversions, as in Rust's core::convert. `e?` on a `Result` converts\n// its error into the function's error type with `From::from` when the two\n// differ (`impl From<ParseError> for AppError`).\n\ntrait From<T> {\n    fn from(value: T) -> Self;\n}\n",
    );
    core_file(
        v,
        "default.kek",
        "// Default values, as in Rust's core::default.\n\ntrait Default {\n    fn default() -> Self;\n}\n\nimpl Default for Int {\n    fn default() -> Int {\n        0\n    }\n}\n\nimpl Default for Bool {\n    fn default() -> Bool {\n        false\n    }\n}\n\nimpl Default for String {\n    fn default() -> String {\n        \"\"\n    }\n}\n\nimpl Default for () {\n    fn default() -> () {\n        ()\n    }\n}\n\nimpl<T> Default for Option<T> {\n    fn default() -> Option<T> {\n        None\n    }\n}\n\nimpl<T> Default for Vec<T> {\n    fn default() -> Vec<T> {\n        Vec::new()\n    }\n}\n",
    );
    core_file(
        v,
        "entry.kek",
        "// The entry API of HashMap and BTreeMap (Rust's `map.entry(k)`), shared\n// by both maps through __EntryMap.\n//\n// Values are not borrowed in Kekkai, so where Rust hands out `&mut V` the\n// methods here return the value V (for a struct or a Vec that is the very\n// value in the map, so `m.entry(k).or_insert(Vec::new()).push(x)` adds to\n// the stored Vec), and `and_modify` takes `fn(V) -> V` instead of\n// `FnMut(&mut V)`: `m.entry(w).and_modify(|n| n + 1).or_insert(1)`.\n\n// __EntryMap is what an entry needs of its map.\ntrait __EntryMap<K, V> {\n    fn __entry_get(&self, k: &K) -> Option<V>;\n\n    fn __entry_insert(&mut self, k: K, v: V) -> Option<V>;\n\n    fn __entry_remove(&mut self, k: &K) -> Option<V>;\n}\n\nenum Entry<M, K, V> {\n    Occupied(OccupiedEntry<M, K, V>),\n    Vacant(VacantEntry<M, K, V>),\n}\n\n// An entry whose key is in the map.\nstruct OccupiedEntry<M, K, V> {\n    __map: M,\n    __key: K,\n    mut __value: V,\n}\n\n// An entry whose key is not in the map.\nstruct VacantEntry<M, K, V> {\n    __map: M,\n    __key: K,\n    __value: Option<V>,\n}\n\nfn __entry_of<M: __EntryMap<K, V>, K, V>(m: M, k: K) -> Entry<M, K, V> {\n    match m.__entry_get(&k) {\n        Some(v) => Entry::Occupied(OccupiedEntry { __map: m, __key: k, __value: v }),\n        None => Entry::Vacant(VacantEntry { __map: m, __key: k, __value: None }),\n    }\n}\n\nimpl<M: __EntryMap<K, V>, K, V> Entry<M, K, V> {\n    fn key(&self) -> K {\n        match *self {\n            Entry::Occupied(e) => e.__key,\n            Entry::Vacant(e) => e.__key,\n        }\n    }\n\n    // or_insert returns the value of the key, first inserting d if the key\n    // is absent.\n    fn or_insert(self, d: V) -> V {\n        match self {\n            Entry::Occupied(e) => e.__value,\n            Entry::Vacant(e) => e.insert(d),\n        }\n    }\n\n    fn or_insert_with(self, f: impl Fn() -> V) -> V {\n        match self {\n            Entry::Occupied(e) => e.__value,\n            Entry::Vacant(e) => e.insert(f()),\n        }\n    }\n\n    fn or_insert_with_key(self, f: impl Fn(K) -> V) -> V {\n        match self {\n            Entry::Occupied(e) => e.__value,\n            Entry::Vacant(e) => {\n                let v = f(e.__key);\n                e.insert(v)\n            }\n        }\n    }\n\n    // and_modify replaces the value of a present key by f(value).\n    fn and_modify(self, f: impl Fn(V) -> V) -> Entry<M, K, V> {\n        match self {\n            Entry::Occupied(mut e) => {\n                e.insert(f(e.__value));\n                Entry::Occupied(e)\n            }\n            Entry::Vacant(e) => Entry::Vacant(e),\n        }\n    }\n\n    // insert_entry sets the value (present or not).\n    fn insert_entry(self, v: V) -> OccupiedEntry<M, K, V> {\n        match self {\n            Entry::Occupied(mut e) => {\n                e.insert(v);\n                e\n            }\n            Entry::Vacant(mut e) => {\n                e.__map.__entry_insert(e.__key, v);\n                OccupiedEntry { __map: e.__map, __key: e.__key, __value: v }\n            }\n        }\n    }\n}\n\nimpl<M: __EntryMap<K, V>, K, V: Default> Entry<M, K, V> {\n    fn or_default(self) -> V {\n        match self {\n            Entry::Occupied(e) => e.__value,\n            Entry::Vacant(e) => e.insert(V::default()),\n        }\n    }\n}\n\nimpl<M: __EntryMap<K, V>, K, V> OccupiedEntry<M, K, V> {\n    fn key(&self) -> K {\n        self.__key\n    }\n\n    fn get(&self) -> V {\n        self.__value\n    }\n\n    // insert sets the value, returning the old one.\n    fn insert(&mut self, v: V) -> V {\n        let old = self.__value;\n        self.__map.__entry_insert(self.__key, v);\n        self.__value = v;\n        old\n    }\n\n    // remove removes the entry from the map, returning its value.\n    fn remove(mut self) -> V {\n        let _old: Option<V> = self.__map.__entry_remove(&self.__key);\n        self.__value\n    }\n\n    fn remove_entry(mut self) -> (K, V) {\n        let _old: Option<V> = self.__map.__entry_remove(&self.__key);\n        (self.__key, self.__value)\n    }\n}\n\nimpl<M: __EntryMap<K, V>, K, V> VacantEntry<M, K, V> {\n    fn key(&self) -> K {\n        self.__key\n    }\n\n    fn into_key(self) -> K {\n        self.__key\n    }\n\n    // insert adds the key with value v, returning v.\n    fn insert(mut self, v: V) -> V {\n        self.__map.__entry_insert(self.__key, v);\n        v\n    }\n}\n",
    );
    core_file(
        v,
        "float.kek",
        "// Float: a 64-bit IEEE 754 binary64 floating-point number, Rust's f64\n// (Go's float64). The name follows Int (there is one integer and one\n// floating-point type, so no width in the name).\n//\n// Literals are `1.5`, `0.1`, `1e10`, `2.5e-3`, `1_000.5`. Arithmetic\n// `+ - * /`, unary `-` and the comparisons are IEEE operations (wasm's\n// f64 instructions); `%` is the remainder of truncated division, as C's\n// fmod and Rust's `%` on f64 (Rem below). There is no implicit conversion\n// between Int and Float: `i.to_float()` / `Float::from_int(i)`, and\n// `f.trunc_to_int()` / `f.round_to_int()` (saturating, NaN gives 0, as\n// Rust's `as i64`).\n//\n// Float implements PartialEq and PartialOrd but not Eq, Ord or Hash (NaN\n// is not equal to itself), so it cannot be a HashMap key or be sorted with\n// `sort()`, as in Rust.\n//\n// NaN payloads and the sign of a NaN are not observable: `to_bits()` maps\n// every NaN to the canonical quiet NaN 0x7ff8000000000000 (wasm and other\n// hosts may produce different NaN bit patterns).\n//\n// The builtins (compiler/chk_builtins.kek) are `to_bits`, `from_bits`,\n// `from_int`, `Int::to_float`, `trunc_to_int`, `sqrt`, `floor`, `ceil`,\n// `trunc` and `abs`. Text conversion (shortest round-trip output, `{:.2}`,\n// `parse_float`) and fmod are exact algorithms on the bit patterns in\n// lib/core/flt.kek, so every host prints the same digits.\n\nimpl Float {\n    const NAN: Float = 0.0 / 0.0;\n    const INFINITY: Float = 1.0 / 0.0;\n    const NEG_INFINITY: Float = -1.0 / 0.0;\n    // the largest finite value, and its negation\n    const MAX: Float = 1.7976931348623157e308;\n    const MIN: Float = -1.7976931348623157e308;\n    // the smallest positive normal value\n    const MIN_POSITIVE: Float = 2.2250738585072014e-308;\n    // the difference between 1.0 and the next larger value\n    const EPSILON: Float = 2.220446049250313e-16;\n    const PI: Float = 3.141592653589793;\n    const TAU: Float = 6.283185307179586;\n    const E: Float = 2.718281828459045;\n    const SQRT_2: Float = 1.4142135623730951;\n    const LN_2: Float = 0.6931471805599453;\n    const LN_10: Float = 2.302585092994046;\n\n    fn is_nan(self) -> Bool {\n        self != self\n    }\n\n    fn is_infinite(self) -> Bool {\n        self == Float::INFINITY || self == Float::NEG_INFINITY\n    }\n\n    // is_finite: neither infinite nor NaN.\n    fn is_finite(self) -> Bool {\n        self - self == 0.0\n    }\n\n    // is_normal: finite, nonzero and not subnormal.\n    fn is_normal(self) -> Bool {\n        let e = self.to_bits().ushr(52).bit_and(2047);\n        e != 0 && e != 2047\n    }\n\n    // is_sign_negative: the sign bit is set (-0.0 too; never for NaN,\n    // whose sign is not observable).\n    fn is_sign_negative(self) -> Bool {\n        self.to_bits() < 0\n    }\n\n    fn is_sign_positive(self) -> Bool {\n        !self.is_sign_negative()\n    }\n\n    // round is the nearest integer, halfway cases away from zero (Rust's\n    // round; -0.3 gives -0.0).\n    fn round(self) -> Float {\n        let t = self.trunc();\n        if (self - t).abs() >= 0.5 {\n            if self > 0.0 { t + 1.0 } else { t - 1.0 }\n        } else {\n            t\n        }\n    }\n\n    // round_ties_even is the nearest integer, halfway cases to even.\n    fn round_ties_even(self) -> Float {\n        let r = self.round();\n        if (r - self).abs() == 0.5 && r % 2.0 != 0.0 {\n            if r > self { r - 1.0 } else { r + 1.0 }\n        } else {\n            r\n        }\n    }\n\n    // fract is self - self.trunc().\n    fn fract(self) -> Float {\n        self - self.trunc()\n    }\n\n    // round_to_int is round() converted to Int (saturating, NaN gives 0).\n    fn round_to_int(self) -> Int {\n        self.round().trunc_to_int()\n    }\n\n    // floor_to_int / ceil_to_int likewise.\n    fn floor_to_int(self) -> Int {\n        self.floor().trunc_to_int()\n    }\n\n    fn ceil_to_int(self) -> Int {\n        self.ceil().trunc_to_int()\n    }\n\n    // signum is 1.0 for +0.0 and positive values, -1.0 for -0.0 and\n    // negative values, NaN for NaN.\n    fn signum(self) -> Float {\n        if self.is_nan() {\n            self\n        } else if self.is_sign_negative() { -1.0 } else { 1.0 }\n    }\n\n    // copysign is the magnitude of self with the sign of sign.\n    fn copysign(self, sign: Float) -> Float {\n        let m = self.to_bits().bit_and(Int::MAX);\n        Float::from_bits(m.bit_or(sign.to_bits().bit_and(Int::MIN)))\n    }\n\n    // min and max ignore a NaN argument (NaN only when both are NaN), as\n    // Rust's f64::min / f64::max.\n    fn min(self, other: Float) -> Float {\n        if self.is_nan() {\n            other\n        } else if other.is_nan() {\n            self\n        } else if other < self { other } else { self }\n    }\n\n    fn max(self, other: Float) -> Float {\n        if self.is_nan() {\n            other\n        } else if other.is_nan() {\n            self\n        } else if other > self { other } else { self }\n    }\n\n    // clamp restricts self to [min, max] (NaN stays NaN; unlike Rust it\n    // does not panic when min > max: the result is then max).\n    fn clamp(self, min: Float, max: Float) -> Float {\n        let mut x = self;\n        if x < min {\n            x = min;\n        }\n        if x > max {\n            x = max;\n        }\n        x\n    }\n\n    fn recip(self) -> Float {\n        1.0 / self\n    }\n\n    fn to_degrees(self) -> Float {\n        self * (180.0 / Float::PI)\n    }\n\n    fn to_radians(self) -> Float {\n        self * (Float::PI / 180.0)\n    }\n\n    // powi is self raised to the integer power n, by repeated squaring\n    // (like Rust's powi, not always correctly rounded; the same result on\n    // every host).\n    fn powi(self, n: Int) -> Float {\n        let mut k = n;\n        if k < 0 {\n            k = -k;\n        }\n        let mut base = self;\n        let mut r = 1.0;\n        while k != 0 {\n            if k.bit_and(1) == 1 {\n                r = r * base;\n            }\n            k = k.ushr(1);\n            if k != 0 {\n                base = base * base;\n            }\n        }\n        if n < 0 { 1.0 / r } else { r }\n    }\n\n    // hypot is sqrt(self² + other²) without intermediate overflow for\n    // large arguments.\n    fn hypot(self, other: Float) -> Float {\n        let a = self.abs();\n        let b = other.abs();\n        if a.is_infinite() || b.is_infinite() {\n            return Float::INFINITY;\n        }\n        let m = a.max(b);\n        if m == 0.0 || m.is_nan() {\n            return a + b;\n        }\n        let x = a / m;\n        let y = b / m;\n        m * (x * x + y * y).sqrt()\n    }\n\n    // total_cmp is IEEE 754's totalOrder: -NaN < -inf < ... < -0.0 < +0.0\n    // < ... < inf < NaN (NaN has no sign here, so every NaN is last).\n    fn total_cmp(&self, other: &Float) -> Ordering {\n        let a = __flt_total_key(self.to_bits());\n        let b = __flt_total_key(other.to_bits());\n        a.cmp(&b)\n    }\n}\n\n// __flt_total_key maps bit patterns to Ints ordered as totalOrder.\nfn __flt_total_key(b: Int) -> Int {\n    if b < 0 { b.bit_xor(Int::MAX) } else { b }\n}\n\nimpl PartialEq for Float {\n    fn eq(&self, other: &Self) -> Bool {\n        self == other\n    }\n}\n\n// The order of the numbers; NaN is unordered (None).\nimpl PartialOrd for Float {\n    fn partial_cmp(&self, other: &Self) -> Option<Ordering> {\n        if self < other {\n            Some(Ordering::Less)\n        } else if self > other {\n            Some(Ordering::Greater)\n        } else if self == other {\n            Some(Ordering::Equal)\n        } else {\n            None\n        }\n    }\n}\n\nimpl Clone for Float {\n    fn clone(&self) -> Float {\n        *self\n    }\n}\n\nimpl Default for Float {\n    fn default() -> Float {\n        0.0\n    }\n}\n\nimpl Add<Float> for Float {\n    type Output = Float;\n\n    fn add(self, rhs: Float) -> Float {\n        self + rhs\n    }\n}\n\nimpl Sub<Float> for Float {\n    type Output = Float;\n\n    fn sub(self, rhs: Float) -> Float {\n        self - rhs\n    }\n}\n\nimpl Mul<Float> for Float {\n    type Output = Float;\n\n    fn mul(self, rhs: Float) -> Float {\n        self * rhs\n    }\n}\n\nimpl Div<Float> for Float {\n    type Output = Float;\n\n    fn div(self, rhs: Float) -> Float {\n        self / rhs\n    }\n}\n\n// `%`: the remainder of truncated division, exact, with the sign of self\n// (C's fmod): x % 0.0 and inf % y are NaN, x % inf is x.\nimpl Rem<Float> for Float {\n    type Output = Float;\n\n    fn rem(self, rhs: Float) -> Float {\n        Float::from_bits(__flt_fmod(self.to_bits(), rhs.to_bits()))\n    }\n}\n\nimpl Neg for Float {\n    type Output = Float;\n\n    fn neg(self) -> Float {\n        -self\n    }\n}\n\n// Display is Rust's: the shortest digits that read back as the same\n// value, never in exponent notation (1.0 is \"1\", 1e21 is\n// \"1000000000000000000000\", -0.0 is \"-0\", \"NaN\", \"inf\", \"-inf\").\n// `{:.n}` rounds the exact value half to even at n fractional digits.\nimpl Display for Float {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(__flt_display(self.to_bits()));\n    }\n\n    fn __fmt_numeric(&self) -> Bool {\n        true\n    }\n\n    fn __fmt_precision(&self, n: Int) -> String {\n        __flt_fixed(self.to_bits(), n)\n    }\n}\n\n// Debug always shows a fraction or an exponent: \"1.0\", \"0.1\", \"-0.0\",\n// \"1e16\", \"1.5e-7\" (exponent notation below 1e-4 and from 1e16 on).\nimpl Debug for Float {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(__flt_debug(self.to_bits()));\n    }\n}\n\nimpl String {\n    // parse_float reads a Float as Rust's f64::from_str: an optional sign,\n    // digits with an optional fraction (`1.`, `.5`), an optional exponent\n    // (`e-3`), or `inf` / `infinity` / `nan` in any case. The result is\n    // correctly rounded (any number of digits). No `_` or spaces.\n    fn parse_float(&self) -> Option<Float> {\n        match __flt_parse(*self) {\n            Some(b) => Some(Float::from_bits(b)),\n            None => None,\n        }\n    }\n}\n\n// The sum starts from -0.0 (the identity of `+`, as Rust since 1.82: the\n// sum of [-0.0] is -0.0 and of [] is -0.0).\nimpl Sum<Float> for Float {\n    fn sum<I: Iterator<Item = Float>>(mut iter: I) -> Float {\n        let mut s = -0.0;\n        while let Some(x) = iter.next() {\n            s = s + x;\n        }\n        s\n    }\n}\n\nimpl Product<Float> for Float {\n    fn product<I: Iterator<Item = Float>>(mut iter: I) -> Float {\n        let mut p = 1.0;\n        while let Some(x) = iter.next() {\n            p = p * x;\n        }\n        p\n    }\n}\n",
