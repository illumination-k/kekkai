    core_file(
        v,
        "flt.kek",
        "// Floating point algorithms on IEEE 754 binary64 bit patterns (held in an\n// Int), used by Float (lib/core/float.kek): decimal parsing (correctly\n// rounded), shortest round-trip printing (Rust's Display / Debug), fixed\n// precision printing (`{:.N}`, exact round-half-to-even) and fmod (`%`).\n// Everything is integer arithmetic, so the WasmGC build and the Lean\n// reference interpreter compute the same strings. Big integers are\n// Vec<Int> of base 2^30 limbs, least significant first, without leading\n// zero limbs (zero is the empty Vec).\n//\n// NaN results are the canonical quiet NaN 0x7ff8000000000000.\n\nfn __flt_nan() -> Int {\n    9221120237041090560\n}\n\nfn __flt_inf() -> Int {\n    9218868437227405312\n}\n\nfn __flt_sign() -> Int {\n    -9223372036854775807 - 1\n}\n\nfn __flt_hidden() -> Int {\n    4503599627370496\n}\n\n// ---- big integers ----\n\nfn __flt_limb() -> Int {\n    1073741824\n}\n\nfn __flt_mask() -> Int {\n    1073741823\n}\n\nfn __flt_ibits(x: Int) -> Int {\n    let mut n = 0;\n    let mut v = x;\n    while v > 0 {\n        v = v.shr(1);\n        n = n + 1;\n    }\n    n\n}\n\nfn __flt_big_norm(mut a: Vec<Int>) -> Vec<Int> {\n    while a.len() > 0 && a.get(a.len() - 1).unwrap_or(1) == 0 {\n        a.pop();\n    }\n    a\n}\n\n// x >= 0\nfn __flt_big(x: Int) -> Vec<Int> {\n    let mut r = Vec::new();\n    let mut v = x;\n    while v > 0 {\n        r.push(v.bit_and(__flt_mask()));\n        v = v.shr(30);\n    }\n    r\n}\n\n// the value of a, which must fit in 62 bits\nfn __flt_big_int(a: Vec<Int>) -> Int {\n    let mut r = 0;\n    let mut i = a.len() - 1;\n    while i >= 0 {\n        r = r.shl(30).bit_or(a.get(i).unwrap_or(0));\n        i = i - 1;\n    }\n    r\n}\n\nfn __flt_big_bits(a: Vec<Int>) -> Int {\n    let n = a.len();\n    if n == 0 {\n        return 0;\n    }\n    30 * (n - 1) + __flt_ibits(a.get(n - 1).unwrap_or(0))\n}\n\nfn __flt_big_cmp(a: Vec<Int>, b: Vec<Int>) -> Int {\n    let na = a.len();\n    let nb = b.len();\n    if na != nb {\n        return if na < nb { -1 } else { 1 };\n    }\n    let mut i = na - 1;\n    while i >= 0 {\n        let x = a.get(i).unwrap_or(0);\n        let y = b.get(i).unwrap_or(0);\n        if x != y {\n            return if x < y { -1 } else { 1 };\n        }\n        i = i - 1;\n    }\n    0\n}\n\nfn __flt_big_add(a: Vec<Int>, b: Vec<Int>) -> Vec<Int> {\n    let n = if a.len() > b.len() { a.len() } else { b.len() };\n    let mut r = Vec::new();\n    let mut carry = 0;\n    let mut i = 0;\n    while i < n {\n        let s = a.get(i).unwrap_or(0) + b.get(i).unwrap_or(0) + carry;\n        r.push(s.bit_and(__flt_mask()));\n        carry = s.shr(30);\n        i = i + 1;\n    }\n    if carry > 0 {\n        r.push(carry);\n    }\n    r\n}\n\n// a - b for a >= b\nfn __flt_big_sub(a: Vec<Int>, b: Vec<Int>) -> Vec<Int> {\n    let mut r = Vec::new();\n    let mut borrow = 0;\n    let mut i = 0;\n    let n = a.len();\n    while i < n {\n        let mut s = a.get(i).unwrap_or(0) - b.get(i).unwrap_or(0) - borrow;\n        if s < 0 {\n            s = s + __flt_limb();\n            borrow = 1;\n        } else {\n            borrow = 0;\n        }\n        r.push(s);\n        i = i + 1;\n    }\n    __flt_big_norm(r)\n}\n\n// a * m for 0 <= m < 2^32\nfn __flt_big_mul_small(a: Vec<Int>, m: Int) -> Vec<Int> {\n    if m == 0 {\n        return Vec::new();\n    }\n    let mut r = Vec::new();\n    let mut carry = 0;\n    for x in a {\n        let p = x * m + carry;\n        r.push(p.bit_and(__flt_mask()));\n        carry = p.shr(30);\n    }\n    while carry > 0 {\n        r.push(carry.bit_and(__flt_mask()));\n        carry = carry.shr(30);\n    }\n    r\n}\n\nfn __flt_big_shl(a: Vec<Int>, n: Int) -> Vec<Int> {\n    if a.len() == 0 {\n        return a;\n    }\n    let q = n / 30;\n    let s = n % 30;\n    let mut r = Vec::new();\n    for k in 0..q {\n        r.push(0);\n    }\n    if s == 0 {\n        for x in a {\n            r.push(x);\n        }\n        return r;\n    }\n    let mut carry = 0;\n    for x in a {\n        r.push(x.shl(s).bit_and(__flt_mask()).bit_or(carry));\n        carry = x.shr(30 - s);\n    }\n    if carry > 0 {\n        r.push(carry);\n    }\n    r\n}\n\nfn __flt_big_shr(a: Vec<Int>, n: Int) -> Vec<Int> {\n    let q = n / 30;\n    let s = n % 30;\n    let len = a.len();\n    let mut r = Vec::new();\n    let mut i = q;\n    while i < len {\n        let lo = a.get(i).unwrap_or(0).shr(s);\n        let hi = if s == 0 {\n            0\n        } else {\n            a.get(i + 1).unwrap_or(0).shl(30 - s).bit_and(__flt_mask())\n        };\n        r.push(lo.bit_or(hi));\n        i = i + 1;\n    }\n    __flt_big_norm(r)\n}\n\nfn __flt_pow10_small(k: Int) -> Int {\n    let mut r = 1;\n    for i in 0..k {\n        r = r * 10;\n    }\n    r\n}\n\n// a * 10^k for k >= 0\nfn __flt_big_mul_pow10(a: Vec<Int>, k: Int) -> Vec<Int> {\n    let mut r = a;\n    let mut n = k;\n    while n >= 9 {\n        r = __flt_big_mul_small(r, 1000000000);\n        n = n - 9;\n    }\n    if n > 0 {\n        r = __flt_big_mul_small(r, __flt_pow10_small(n));\n    }\n    r\n}\n\n// (a / d, a % d) for 0 < d < 2^31\nfn __flt_big_divmod_small(a: Vec<Int>, d: Int) -> (Vec<Int>, Int) {\n    let n = a.len();\n    let mut q = Vec::new();\n    for k in 0..n {\n        q.push(0);\n    }\n    let mut rem = 0;\n    let mut i = n - 1;\n    while i >= 0 {\n        let cur = rem.shl(30).bit_or(a.get(i).unwrap_or(0));\n        q.set(i, cur / d);\n        rem = cur % d;\n        i = i - 1;\n    }\n    (__flt_big_norm(q), rem)\n}\n\n// a / 2^k when that fits in 62 bits\nfn __flt_big_top(a: Vec<Int>, k: Int) -> Int {\n    let q = k / 30;\n    let sh = k % 30;\n    let mut r = 0;\n    let mut i = a.len() - 1;\n    while i > q {\n        r = r.shl(30).bit_or(a.get(i).unwrap_or(0));\n        i = i - 1;\n    }\n    r.shl(30 - sh).bit_or(a.get(q).unwrap_or(0).shr(sh))\n}\n\n// (a / s, a % s) for s > 0 when the quotient fits in 62 bits.\nfn __flt_big_divmod(a: Vec<Int>, s: Vec<Int>) -> (Int, Vec<Int>) {\n    let mut q = 0;\n    let mut r = a;\n    let bs = __flt_big_bits(s);\n    let ks = if bs > 31 { bs - 31 } else { 0 };\n    let shi = __flt_big_top(s, ks) + 1;\n    while __flt_big_cmp(r, s) >= 0 {\n        let br = __flt_big_bits(r);\n        if br <= 62 {\n            let ri = __flt_big_int(r);\n            let si = __flt_big_int(s);\n            q = q + ri / si;\n            return (q, __flt_big(ri % si));\n        }\n        let ka = br - 61;\n        let ahi = __flt_big_top(r, ka);\n        let qe = ahi / shi;\n        let sh = ka - ks;\n        if sh >= 0 {\n            r = __flt_big_sub(r, __flt_big_shl(__flt_big_mul_small(s, qe), sh));\n            q = q + qe.shl(sh);\n        } else {\n            let qq = qe.shr(0 - sh);\n            if qq == 0 {\n                r = __flt_big_sub(r, s);\n                q = q + 1;\n            } else {\n                r = __flt_big_sub(r, __flt_big_mul_small(s, qq));\n                q = q + qq;\n            }\n        }\n    }\n    (q, r)\n}\n\n// the decimal digits of a\nfn __flt_big_dec(a: Vec<Int>) -> String {\n    if a.len() == 0 {\n        return \"0\";\n    }\n    if a.len() <= 2 {\n        return __flt_big_int(a).to_string();\n    }\n    let mut chunks = Vec::new();\n    let mut x = a;\n    while x.len() > 0 {\n        let (q, r) = __flt_big_divmod_small(x, 1000000000);\n        chunks.push(r);\n        x = q;\n    }\n    let mut s = \"\";\n    let mut i = chunks.len() - 1;\n    let mut first = true;\n    while i >= 0 {\n        let c = chunks.get(i).unwrap_or(0).to_string();\n        if first {\n            s = c;\n            first = false;\n        } else {\n            s = s + \"000000000\".slice(0, 9 - c.len()) + c;\n        }\n        i = i - 1;\n    }\n    s\n}\n\n// ---- parsing ----\n\n// __flt_finish assembles the bits of q * 2^b (q < 2^53, b >= -1074)\n// rounded by half: the sign of (remainder - divisor / 2).\nfn __flt_finish(neg: Bool, q0: Int, half: Int, b0: Int) -> Int {\n    let mut q = q0;\n    let mut b = b0;\n    if half > 0 || (half == 0 && q.bit_and(1) == 1) {\n        q = q + 1;\n    }\n    if q == 2 * __flt_hidden() {\n        q = __flt_hidden();\n        b = b + 1;\n    }\n    let sign = if neg { __flt_sign() } else { 0 };\n    if b > 971 {\n        return sign.bit_or(__flt_inf());\n    }\n    if q < __flt_hidden() {\n        return sign.bit_or(q);\n    }\n    sign.bit_or((b + 1075).shl(52)).bit_or(q - __flt_hidden())\n}\n\nfn __flt_digit(c: Int) -> Int {\n    if c >= 48 && c <= 57 { c - 48 } else { -1 }\n}\n\n// __flt_parse reads a decimal floating point number (Rust's f64 grammar:\n// `[+-](digits[.digits]|.digits)[(e|E)[+-]digits]`, `inf`, `infinity`,\n// `nan`, case-insensitive) as correctly rounded bits.\nfn __flt_parse(s: String) -> Option<Int> {\n    let n = s.len();\n    let mut i = 0;\n    let mut neg = false;\n    let c0 = s.char_at(0).unwrap_or(-1);\n    if c0 == 43 || c0 == 45 {\n        neg = c0 == 45;\n        i = 1;\n    }\n    let sign = if neg { __flt_sign() } else { 0 };\n    let rest = s.slice(i, n).to_lower();\n    if rest == \"inf\" || rest == \"infinity\" {\n        return Some(sign.bit_or(__flt_inf()));\n    }\n    if rest == \"nan\" {\n        return Some(__flt_nan());\n    }\n    let mut digits = Vec::new();\n    let mut nd = 0; // digits seen (including leading zeros)\n    let mut frac = 0;\n    let mut dot = false;\n    let mut done = false;\n    while i < n && !done {\n        let c = s.char_at(i).unwrap_or(0);\n        let d = __flt_digit(c);\n        if d >= 0 {\n            nd = nd + 1;\n            if dot {\n                frac = frac + 1;\n            }\n            if d != 0 || digits.len() > 0 {\n                digits.push(d);\n            }\n            i = i + 1;\n        } else if c == 46 && !dot {\n            dot = true;\n            i = i + 1;\n        } else {\n            done = true;\n        }\n    }\n    if nd == 0 {\n        return None;\n    }\n    let mut exp = 0;\n    if i < n {\n        let c = s.char_at(i).unwrap_or(0);\n        if c != 101 && c != 69 {\n            return None;\n        }\n        i = i + 1;\n        let mut eneg = false;\n        let ce = s.char_at(i).unwrap_or(-1);\n        if ce == 43 || ce == 45 {\n            eneg = ce == 45;\n            i = i + 1;\n        }\n        if i >= n {\n            return None;\n        }\n        while i < n {\n            let d = __flt_digit(s.char_at(i).unwrap_or(0));\n            if d < 0 {\n                return None;\n            }\n            if exp < 100000000 {\n                exp = exp * 10 + d;\n            }\n            i = i + 1;\n        }\n        if eneg {\n            exp = 0 - exp;\n        }\n    }\n    // value = digits * 10^e10\n    let mut e10 = exp - frac;\n    while digits.len() > 0 && digits.get(digits.len() - 1).unwrap_or(1) == 0 {\n        digits.pop();\n        e10 = e10 + 1;\n    }\n    let m = digits.len();\n    if m == 0 {\n        return Some(sign);\n    }\n    if m + e10 > 310 {\n        return Some(sign.bit_or(__flt_inf()));\n    }\n    if m + e10 < -326 {\n        return Some(sign);\n    }\n    if m <= 18 {\n        let mut d = 0;\n        for x in digits {\n            d = d * 10 + x;\n        }\n        if e10 >= 0 && e10 <= 18 {\n            let p = __flt_pow10_small(e10);\n            if d <= 9223372036854775807 / p {\n                return Some(__flt_from_ratio_int(neg, d * p, 1));\n            }\n        } else if e10 < 0 && e10 >= -18 {\n            let p = __flt_pow10_small(0 - e10);\n            let b = __flt_ibits(d) - __flt_ibits(p) - 53;\n            if b < 0 && __flt_ibits(d) - b <= 62 {\n                return Some(__flt_from_ratio_int(neg, d, p));\n            }\n        }\n    }\n    let mut big = Vec::new();\n    let mut k = 0;\n    while k < m {\n        let take = if m - k >= 9 { 9 } else { m - k };\n        let mut chunk = 0;\n        for j in 0..take {\n            chunk = chunk * 10 + digits.get(k + j).unwrap_or(0);\n        }\n        big = __flt_big_add(__flt_big_mul_small(big, __flt_pow10_small(take)), __flt_big(chunk));\n        k = k + take;\n    }\n    if e10 >= 0 {\n        Some(__flt_from_ratio(neg, __flt_big_mul_pow10(big, e10), __flt_big(1)))\n    } else {\n        Some(__flt_from_ratio(neg, big, __flt_big_mul_pow10(__flt_big(1), 0 - e10)))\n    }\n}\n\n// the bits of n / s rounded to nearest (n, s > 0, n < 2^62, s < 2^61)\nfn __flt_from_ratio_int(neg: Bool, n: Int, s: Int) -> Int {\n    let mut b = __flt_ibits(n) - __flt_ibits(s) - 53;\n    let mut a = n;\n    let mut sd = s;\n    if b >= 0 {\n        if __flt_ibits(s) + b > 61 {\n            return __flt_from_ratio(neg, __flt_big(n), __flt_big(s));\n        }\n        sd = s.shl(b);\n    } else {\n        if __flt_ibits(n) - b > 62 {\n            return __flt_from_ratio(neg, __flt_big(n), __flt_big(s));\n        }\n        a = n.shl(0 - b);\n    }\n    let mut q = a / sd;\n    let mut r = a % sd;\n    if q >= 2 * __flt_hidden() {\n        // halve the quotient: the dropped bit joins the remainder\n        if __flt_ibits(sd) > 60 {\n            return __flt_from_ratio(neg, __flt_big(n), __flt_big(s));\n        }\n        r = r + q.bit_and(1) * sd;\n        sd = sd * 2;\n        q = q.shr(1);\n        b = b + 1;\n    }\n    let tr = 2 * r;\n    let half = if tr > sd {\n        1\n    } else if tr < sd { -1 } else { 0 };\n    __flt_finish(neg, q, half, b)\n}\n\n// the bits of n / s rounded to nearest (big integers, n, s > 0)\nfn __flt_from_ratio(neg: Bool, n: Vec<Int>, s: Vec<Int>) -> Int {\n    let mut b = __flt_big_bits(n) - __flt_big_bits(s) - 53;\n    if b < -1074 {\n        b = -1074;\n    }\n    if b > 1000 {\n        return if neg { __flt_sign() } else { 0 }.bit_or(__flt_inf());\n    }\n    let mut a = n;\n    let mut sd = s;\n    if b >= 0 {\n        sd = __flt_big_shl(s, b);\n    } else {\n        a = __flt_big_shl(n, 0 - b);\n    }\n    let (q0, r0) = __flt_big_divmod(a, sd);\n    let mut q = q0;\n    let mut r = r0;\n    if q >= 2 * __flt_hidden() {\n        if q.bit_and(1) == 1 {\n            r = __flt_big_add(r, sd);\n        }\n        sd = __flt_big_shl(sd, 1);\n        q = q.shr(1);\n        b = b + 1;\n    }\n    let half = __flt_big_cmp(__flt_big_shl(r, 1), sd);\n    __flt_finish(neg, q, half, b)\n}\n\n// ---- shortest digits ----\n\n// __flt_shortest is the shortest decimal digits that read back as the\n// finite nonzero |x|: (digits, k) with x = 0.digits * 10^k.\nfn __flt_shortest(bits: Int) -> (Vec<Int>, Int) {\n    let ex = bits.shr(52).bit_and(2047);\n    let fm = bits.bit_and(__flt_hidden() - 1);\n    let f = if ex == 0 {\n        fm\n    } else {\n        fm.bit_or(__flt_hidden())\n    };\n    let e = if ex == 0 { -1074 } else { ex - 1075 };\n    let even = f.bit_and(1) == 0;\n    // fast path: an integer below 2^53 prints as itself\n    if e <= 0 && e > -53 && f.bit_and(1.shl(0 - e) - 1) == 0 {\n        return __flt_int_digits(f.shr(0 - e));\n    }\n    let mut r = Vec::new();\n    let mut s = Vec::new();\n    let mut mp = Vec::new();\n    let mut mm = Vec::new();\n    let lopsided = f == __flt_hidden() && ex > 1;\n    if e >= 0 {\n        if !lopsided {\n            r = __flt_big_shl(__flt_big(f), e + 1);\n            s = __flt_big(2);\n            mp = __flt_big_shl(__flt_big(1), e);\n            mm = mp;\n        } else {\n            r = __flt_big_shl(__flt_big(f), e + 2);\n            s = __flt_big(4);\n            mp = __flt_big_shl(__flt_big(1), e + 1);\n            mm = __flt_big_shl(__flt_big(1), e);\n        }\n    } else {\n        if !lopsided {\n            r = __flt_big(f * 2);\n            s = __flt_big_shl(__flt_big(1), 1 - e);\n            mp = __flt_big(1);\n            mm = mp;\n        } else {\n            r = __flt_big(f * 4);\n            s = __flt_big_shl(__flt_big(1), 2 - e);\n            mp = __flt_big(2);\n            mm = __flt_big(1);\n        }\n    }\n    // k estimate: floor((bits(f) + e - 1) * log10(2)), then fixed up\n    let lg = __flt_ibits(f) + e - 1;\n    let mut k = if lg >= 0 {\n        (lg * 1233).shr(12)\n    } else {\n        0 - ((0 - lg) * 1233).shr(12) - 1\n    };\n    if k >= 0 {\n        s = __flt_big_mul_pow10(s, k);\n    } else {\n        r = __flt_big_mul_pow10(r, 0 - k);\n        mp = __flt_big_mul_pow10(mp, 0 - k);\n        mm = __flt_big_mul_pow10(mm, 0 - k);\n    }\n    let mut fixing = true;\n    while fixing {\n        let c = __flt_big_cmp(__flt_big_add(r, mp), s);\n        if c > 0 || (even && c == 0) {\n            s = __flt_big_mul_small(s, 10);\n            k = k + 1;\n        } else {\n            fixing = false;\n        }\n    }\n    fixing = true;\n    while fixing {\n        let c = __flt_big_cmp(__flt_big_mul_small(__flt_big_add(r, mp), 10), s);\n        if c < 0 || (!even && c == 0) {\n            r = __flt_big_mul_small(r, 10);\n            mp = __flt_big_mul_small(mp, 10);\n            mm = __flt_big_mul_small(mm, 10);\n            k = k - 1;\n        } else {\n            fixing = false;\n        }\n    }\n    if __flt_big_bits(s) <= 59 {\n        return (\n            __flt_gen_int(\n                __flt_big_int(r),\n                __flt_big_int(s),\n                __flt_big_int(mp),\n                __flt_big_int(mm),\n                even,\n            ),\n            k,\n        );\n    }\n    (__flt_gen_big(r, s, mp, mm, even), k)\n}\n\nfn __flt_int_digits(n: Int) -> (Vec<Int>, Int) {\n    let t = n.to_string();\n    let mut ds = Vec::new();\n    let mut last = 0;\n    let mut i = 0;\n    for c in t.chars() {\n        ds.push(c - 48);\n        i = i + 1;\n        if c != 48 {\n            last = i;\n        }\n    }\n    ds.truncate(last);\n    (ds, t.len())\n}\n\n// digit generation (Steele & White / Burger & Dybvig) on Ints, s < 2^59\nfn __flt_gen_int(r0: Int, s: Int, mp0: Int, mm0: Int, even: Bool) -> Vec<Int> {\n    let mut ds = Vec::new();\n    let mut r = r0;\n    let mut mp = mp0;\n    let mut mm = mm0;\n    while true {\n        r = r * 10;\n        mp = mp * 10;\n        mm = mm * 10;\n        let d = r / s;\n        r = r % s;\n        let tc1 = if even { r <= mm } else { r < mm };\n        let tc2 = if even { r + mp >= s } else { r + mp > s };\n        if !tc1 && !tc2 {\n            ds.push(d);\n        } else {\n            if tc1 && !tc2 {\n                ds.push(d);\n            } else if !tc1 && tc2 {\n                ds.push(d + 1);\n            } else if 2 * r < s {\n                ds.push(d);\n            } else {\n                ds.push(d + 1);\n            }\n            return ds;\n        }\n    }\n    ds\n}\n\nfn __flt_gen_big(r0: Vec<Int>, s: Vec<Int>, mp0: Vec<Int>, mm0: Vec<Int>, even: Bool) -> Vec<Int> {\n    let mut ds = Vec::new();\n    let mut r = r0;\n    let mut mp = mp0;\n    let mut mm = mm0;\n    // the digit is estimated from the top bits (low by at most one)\n    let ks = __flt_big_bits(s) - 31;\n    let shi = __flt_big_top(s, ks) + 1;\n    while true {\n        r = __flt_big_mul_small(r, 10);\n        mp = __flt_big_mul_small(mp, 10);\n        mm = __flt_big_mul_small(mm, 10);\n        let mut d = __flt_big_top(r, ks) / shi;\n        if d > 0 {\n            r = __flt_big_sub(r, __flt_big_mul_small(s, d));\n        }\n        while __flt_big_cmp(r, s) >= 0 {\n            r = __flt_big_sub(r, s);\n            d = d + 1;\n        }\n        let c1 = __flt_big_cmp(r, mm);\n        let c2 = __flt_big_cmp(__flt_big_add(r, mp), s);\n        let tc1 = if even { c1 <= 0 } else { c1 < 0 };\n        let tc2 = if even { c2 >= 0 } else { c2 > 0 };\n        if !tc1 && !tc2 {\n            ds.push(d);\n        } else {\n            if tc1 && !tc2 {\n                ds.push(d);\n            } else if !tc1 && tc2 {\n                ds.push(d + 1);\n            } else if __flt_big_cmp(__flt_big_shl(r, 1), s) < 0 {\n                ds.push(d);\n            } else {\n                ds.push(d + 1);\n            }\n            return ds;\n        }\n    }\n    ds\n}\n\nfn __flt_digits_str(ds: Vec<Int>, from: Int, to: Int) -> String {\n    let mut s = \"\";\n    let mut i = from;\n    while i < to {\n        s = s + String::from_char(48 + ds.get(i).unwrap_or(0));\n        i = i + 1;\n    }\n    s\n}\n\nfn __flt_zeros(n: Int) -> String {\n    \"0\".repeat(n)\n}\n\n// __flt_special is the text of NaN, ±inf and ±0 (\"\" otherwise).\nfn __flt_special(bits: Int, zero: String) -> String {\n    let ex = bits.shr(52).bit_and(2047);\n    let fm = bits.bit_and(__flt_hidden() - 1);\n    let sg = if bits < 0 { \"-\" } else { \"\" };\n    if ex == 2047 {\n        return if fm != 0 { \"NaN\" } else { sg + \"inf\" };\n    }\n    if ex == 0 && fm == 0 {\n        return sg + zero;\n    }\n    \"\"\n}\n\n// __flt_plain writes 0.ds * 10^k without an exponent.\nfn __flt_plain(ds: Vec<Int>, k: Int, frac_min: Bool) -> String {\n    let n = ds.len();\n    if k <= 0 {\n        return \"0.\" + __flt_zeros(0 - k) + __flt_digits_str(ds, 0, n);\n    }\n    if k >= n {\n        let t = __flt_digits_str(ds, 0, n) + __flt_zeros(k - n);\n        return if frac_min { t + \".0\" } else { t };\n    }\n    __flt_digits_str(ds, 0, k) + \".\" + __flt_digits_str(ds, k, n)\n}\n\n// __flt_display is Rust's `{}` of an f64: the shortest digits that read\n// back as x, never in exponential notation.\nfn __flt_display(bits: Int) -> String {\n    let sp = __flt_special(bits, \"0\");\n    if sp != \"\" {\n        return sp;\n    }\n    let (ds, k) = __flt_shortest(bits);\n    let sg = if bits < 0 { \"-\" } else { \"\" };\n    sg + __flt_plain(ds, k, false)\n}\n\n// __flt_debug is Rust's `{:?}` of an f64: like Display with at least one\n// fractional digit for 1e-4 <= |x| < 1e16, exponential (`1e16`,\n// `1.5e-7`) otherwise.\nfn __flt_debug(bits: Int) -> String {\n    let sp = __flt_special(bits, \"0.0\");\n    if sp != \"\" {\n        return sp;\n    }\n    let (ds, k) = __flt_shortest(bits);\n    let sg = if bits < 0 { \"-\" } else { \"\" };\n    let sci = k - 1;\n    if sci >= -4 && sci < 16 {\n        return sg + __flt_plain(ds, k, true);\n    }\n    let n = ds.len();\n    let mut t = __flt_digits_str(ds, 0, 1);\n    if n > 1 {\n        t = t + \".\" + __flt_digits_str(ds, 1, n);\n    }\n    sg + t + \"e\" + sci.to_string()\n}\n\n// ---- fixed precision ----\n\n// __flt_fixed is Rust's `{:.prec}` of an f64: the exact value rounded\n// half to even at prec fractional digits.\nfn __flt_fixed(bits: Int, prec: Int) -> String {\n    let p = if prec < 0 { 0 } else { prec };\n    let ex = bits.shr(52).bit_and(2047);\n    let fm = bits.bit_and(__flt_hidden() - 1);\n    let sg = if bits < 0 { \"-\" } else { \"\" };\n    if ex == 2047 {\n        return if fm != 0 { \"NaN\" } else { sg + \"inf\" };\n    }\n    let f = if ex == 0 {\n        fm\n    } else {\n        fm.bit_or(__flt_hidden())\n    };\n    let e = if ex == 0 { -1074 } else { ex - 1075 };\n    let mut digits = \"\";\n    if f == 0 {\n        digits = \"0\";\n    } else if e >= 0 {\n        digits = __flt_big_dec(__flt_big_mul_pow10(__flt_big_shl(__flt_big(f), e), p));\n    } else if p <= 18 && __flt_ibits(f) + __flt_ibits(__flt_pow10_small(p)) <= 62 && 0 - e <= 61 {\n        let num = f * __flt_pow10_small(p);\n        let sh = 0 - e;\n        let mut q = num.shr(sh);\n        let rem = num.bit_and(1.shl(sh) - 1);\n        let half = 1.shl(sh - 1);\n        if rem > half || (rem == half && q.bit_and(1) == 1) {\n            q = q + 1;\n        }\n        digits = q.to_string();\n    } else {\n        let num = __flt_big_mul_pow10(__flt_big(f), p);\n        let sh = 0 - e;\n        let mut q = __flt_big_shr(num, sh);\n        let rem = __flt_big_sub(num, __flt_big_shl(q, sh));\n        let c = __flt_big_cmp(__flt_big_shl(rem, 1), __flt_big_shl(__flt_big(1), sh));\n        let odd = q.get(0).unwrap_or(0).bit_and(1) == 1;\n        if c > 0 || (c == 0 && odd) {\n            q = __flt_big_add(q, __flt_big(1));\n        }\n        digits = __flt_big_dec(q);\n    }\n    if p == 0 {\n        return sg + digits;\n    }\n    if digits.len() <= p {\n        digits = __flt_zeros(p + 1 - digits.len()) + digits;\n    }\n    let cut = digits.len() - p;\n    sg + digits.slice(0, cut) + \".\" + digits.slice(cut, digits.len())\n}\n\n// ---- fmod ----\n\n// __flt_fmod is C's fmod (Rust's `%` on f64): x - trunc(x / y) * y computed\n// exactly, with the sign of x (after musl).\nfn __flt_fmod(x: Int, y: Int) -> Int {\n    let all = 9223372036854775807;\n    let ax = x.bit_and(all);\n    let ay = y.bit_and(all);\n    let mut ex = x.shr(52).bit_and(2047);\n    let mut ey = y.shr(52).bit_and(2047);\n    let sx = x.bit_and(__flt_sign());\n    if ay == 0 || ay > __flt_inf() || ex == 2047 {\n        return __flt_nan();\n    }\n    if ax <= ay {\n        if ax == ay {\n            return sx;\n        }\n        return x;\n    }\n    let mut ux = 0;\n    let mut uy = 0;\n    if ex == 0 {\n        ux = ax;\n        while ux < __flt_hidden() {\n            ux = ux.shl(1);\n            ex = ex - 1;\n        }\n        ex = ex + 1;\n    } else {\n        ux = ax.bit_and(__flt_hidden() - 1).bit_or(__flt_hidden());\n    }\n    if ey == 0 {\n        uy = ay;\n        while uy < __flt_hidden() {\n            uy = uy.shl(1);\n            ey = ey - 1;\n        }\n        ey = ey + 1;\n    } else {\n        uy = ay.bit_and(__flt_hidden() - 1).bit_or(__flt_hidden());\n    }\n    while ex > ey {\n        let i = ux - uy;\n        if i >= 0 {\n            if i == 0 {\n                return sx;\n            }\n            ux = i;\n        }\n        ux = ux.shl(1);\n        ex = ex - 1;\n    }\n    let i = ux - uy;\n    if i >= 0 {\n        if i == 0 {\n            return sx;\n        }\n        ux = i;\n    }\n    while ux < __flt_hidden() {\n        ux = ux.shl(1);\n        ex = ex - 1;\n    }\n    if ex > 0 {\n        ux = (ux - __flt_hidden()).bit_or(ex.shl(52));\n    } else {\n        ux = ux.shr(1 - ex);\n    }\n    ux.bit_or(sx)\n}\n",
    );
    core_file(
        v,
        "fmt.kek",
        "// Formatting, as in Rust's core::fmt: `Display` (`{}`, `to_string()`) is\n// the text for people, `Debug` (`{:?}`, `#[derive(Debug)]`) the text for\n// programmers. Both write into a Formatter, a string builder:\n//\n//   impl Display for Point {\n//       fn fmt(&self, f: &mut Formatter) {\n//           write!(f, \"({}, {})\", self.x, self.y)\n//       }\n//   }\n//\n// Unlike Rust, `fmt` returns nothing (writing cannot fail), so `write!`\n// is a plain statement. `format!` and friends (compiler/macro.kek) expand\n// to the `__fmt_*` helpers below. `Labeled` implements neither trait:\n// labeled data cannot become text without declassifying it.\n\nstruct Formatter {\n    parts: Vec<String>,\n}\n\nimpl Formatter {\n    fn __new() -> Formatter {\n        Formatter { parts: Vec::new() }\n    }\n\n    fn __finish(&self) -> String {\n        self.parts.join(\"\")\n    }\n\n    // write_str appends s.\n    fn write_str(&mut self, s: String) {\n        self.parts.push(s);\n    }\n\n    // write_display appends x as `{}` would.\n    fn write_display<T: Display>(&mut self, x: &T) {\n        x.fmt(self);\n    }\n\n    // write_debug appends x as `{:?}` would.\n    fn write_debug<T: Debug>(&mut self, x: &T) {\n        x.fmt(self);\n    }\n}\n\ntrait Display {\n    fn fmt(&self, f: &mut Formatter);\n\n    fn to_string(&self) -> String {\n        __fmt_display(self)\n    }\n\n    // whether `{:5}` aligns the text to the right (numbers do)\n    fn __fmt_numeric(&self) -> Bool {\n        false\n    }\n\n    // `{:.n}`: the first n characters (Float: n fractional digits; Int\n    // ignores the precision, as in Rust)\n    fn __fmt_precision(&self, n: Int) -> String {\n        __fmt_trunc(&__fmt_display(self), n)\n    }\n}\n\ntrait Debug {\n    fn fmt(&self, f: &mut Formatter);\n}\n\n// ---- Display ----\n\nimpl Display for Int {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_string());\n    }\n\n    fn __fmt_numeric(&self) -> Bool {\n        true\n    }\n\n    fn __fmt_precision(&self, n: Int) -> String {\n        self.to_string()\n    }\n}\n\nimpl Display for Bool {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(if *self { \"true\" } else { \"false\" });\n    }\n}\n\nimpl Display for String {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(*self);\n    }\n}\n\nimpl Display for () {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(\"()\");\n    }\n}\n\n// ---- Debug ----\n\nimpl Debug for Int {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_string());\n    }\n}\n\nimpl Debug for Bool {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(if *self { \"true\" } else { \"false\" });\n    }\n}\n\n// A string is quoted, with `\"`, `\\` and control characters escaped.\nimpl Debug for String {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(__fmt_escape(self));\n    }\n}\n\nimpl Debug for () {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(\"()\");\n    }\n}\n\nimpl<T: Debug> Debug for Option<T> {\n    fn fmt(&self, f: &mut Formatter) {\n        match self {\n            Some(x) => {\n                f.write_str(\"Some(\");\n                x.fmt(f);\n                f.write_str(\")\");\n            }\n            None => f.write_str(\"None\"),\n        }\n    }\n}\n\nimpl<T: Debug, E: Debug> Debug for Result<T, E> {\n    fn fmt(&self, f: &mut Formatter) {\n        match self {\n            Ok(x) => {\n                f.write_str(\"Ok(\");\n                f.write_debug(x);\n                f.write_str(\")\");\n            }\n            Err(e) => {\n                f.write_str(\"Err(\");\n                f.write_debug(e);\n                f.write_str(\")\");\n            }\n        }\n    }\n}\n\nimpl<T: Debug> Debug for Vec<T> {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(\"[\");\n        let mut first = true;\n        for x in self.iter() {\n            if !first {\n                f.write_str(\", \");\n            }\n            first = false;\n            x.fmt(f);\n        }\n        f.write_str(\"]\");\n    }\n}\n\nimpl<K: Debug, V: Debug> Debug for HashMap<K, V> {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(\"{\");\n        let mut first = true;\n        for (k, v) in self.iter() {\n            if !first {\n                f.write_str(\", \");\n            }\n            first = false;\n            f.write_debug(&k);\n            f.write_str(\": \");\n            f.write_debug(&v);\n        }\n        f.write_str(\"}\");\n    }\n}\n\nimpl<T: Debug> Debug for HashSet<T> {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(\"{\");\n        let mut first = true;\n        for x in self.iter() {\n            if !first {\n                f.write_str(\", \");\n            }\n            first = false;\n            f.write_debug(&x);\n        }\n        f.write_str(\"}\");\n    }\n}\n\nimpl<K: Debug + Ord, V: Debug> Debug for BTreeMap<K, V> {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(\"{\");\n        let mut first = true;\n        for (k, v) in self.iter() {\n            if !first {\n                f.write_str(\", \");\n            }\n            first = false;\n            f.write_debug(&k);\n            f.write_str(\": \");\n            f.write_debug(&v);\n        }\n        f.write_str(\"}\");\n    }\n}\n\nimpl<T: Debug + Ord> Debug for BTreeSet<T> {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(\"{\");\n        let mut first = true;\n        for x in self.iter() {\n            if !first {\n                f.write_str(\", \");\n            }\n            first = false;\n            f.write_debug(&x);\n        }\n        f.write_str(\"}\");\n    }\n}\n\nimpl<T: Debug> Debug for VecDeque<T> {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(\"[\");\n        let mut first = true;\n        for x in self.iter() {\n            if !first {\n                f.write_str(\", \");\n            }\n            first = false;\n            f.write_debug(&x);\n        }\n        f.write_str(\"]\");\n    }\n}\n\n// ---- helpers of the macros (compiler/macro.kek) ----\n\nfn __fmt_display<T: Display>(x: &T) -> String {\n    let mut f = Formatter::__new();\n    x.fmt(&mut f);\n    f.__finish()\n}\n\nfn __fmt_debug<T: Debug>(x: &T) -> String {\n    let mut f = Formatter::__new();\n    x.fmt(&mut f);\n    f.__finish()\n}\n\n// __fmt_chars counts the characters (code points) of s.\nfn __fmt_chars(s: String) -> Int {\n    let mut n = 0;\n    for i in 0..s.len() {\n        let c = s.char_at(i).unwrap_or(0);\n        if c < 56320 || c > 57343 {\n            n = n + 1;\n        }\n    }\n    n\n}\n\n// __fmt_pad pads s with fill to width characters: align 0 left, 1 center\n// (extra fill on the right), 2 right.\nfn __fmt_pad(s: String, width: Int, align: Int, fill: String) -> String {\n    let n = __fmt_chars(s);\n    if n >= width {\n        return s;\n    }\n    let total = width - n;\n    let mut left = 0;\n    if align == 2 {\n        left = total;\n    } else if align == 1 {\n        left = total / 2;\n    }\n    let mut parts = Vec::new();\n    for i in 0..left {\n        parts.push(fill);\n    }\n    parts.push(s);\n    for i in left..total {\n        parts.push(fill);\n    }\n    parts.join(\"\")\n}\n\n// __fmt_pad_auto is `{:width}`: numbers to the right, the rest to the left.\nfn __fmt_pad_auto<T: Display>(x: &T, width: Int, fill: String) -> String {\n    let align = if x.__fmt_numeric() { 2 } else { 0 };\n    __fmt_pad(__fmt_display(x), width, align, fill)\n}\n\n// __fmt_prec is `{:.n}` (Display::__fmt_precision).\nfn __fmt_prec<T: Display>(x: &T, n: Int) -> String {\n    x.__fmt_precision(n)\n}\n\n// __fmt_prec_auto is `{:width.n}` with the default alignment (numbers to\n// the right).\nfn __fmt_prec_auto<T: Display>(x: &T, n: Int, width: Int, fill: String) -> String {\n    let align = if x.__fmt_numeric() { 2 } else { 0 };\n    __fmt_pad(x.__fmt_precision(n), width, align, fill)\n}\n\n// __fmt_trunc is the first n characters of s.\nfn __fmt_trunc(s: &String, n: Int) -> String {\n    let mut seen = 0;\n    for i in 0..s.len() {\n        let c = s.char_at(i).unwrap_or(0);\n        if c < 56320 || c > 57343 {\n            if seen == n {\n                return s.slice(0, i);\n            }\n            seen = seen + 1;\n        }\n    }\n    *s\n}\n\n// __fmt_int formats n in radix 10, 16, 8 or 2 (`{:x}` and friends: a\n// negative number in two's complement, as Rust prints an i64), with a\n// `+` (plus), a `0x`/`0o`/`0b` prefix (alt) and zeros after the sign and\n// prefix up to zero_width characters (`{:08}`).\nfn __fmt_int(n: Int, radix: Int, upper: Bool, plus: Bool, alt: Bool, zero_width: Int) -> String {\n    let mut digits = \"\";\n    let mut sign = \"\";\n    if radix == 10 {\n        digits = n.to_string();\n        if n < 0 {\n            digits = digits.slice(1, digits.len());\n            sign = \"-\";\n        }\n    } else {\n        let bits = if radix == 16 {\n            4\n        } else if radix == 8 { 3 } else { 1 };\n        let mut ds = Vec::new();\n        let mut x = n;\n        if x == 0 {\n            ds.push(\"0\");\n        }\n        while x != 0 {\n            let d = x.bit_and(radix - 1);\n            let c = if d < 10 {\n                48 + d\n            } else if upper { 55 + d } else { 87 + d };\n            ds.push(String::from_char(c));\n            x = x.ushr(bits);\n        }\n        let mut rev = Vec::new();\n        let mut i = ds.len() - 1;\n        while i >= 0 {\n            rev.push(ds.get(i).unwrap_or(\"\"));\n            i = i - 1;\n        }\n        digits = rev.join(\"\");\n    }\n    if plus && sign == \"\" {\n        sign = \"+\";\n    }\n    let mut prefix = \"\";\n    if alt {\n        if radix == 16 {\n            prefix = \"0x\";\n        } else if radix == 8 {\n            prefix = \"0o\";\n        } else if radix == 2 {\n            prefix = \"0b\";\n        }\n    }\n    let mut zeros = Vec::new();\n    for i in sign.len() + prefix.len() + digits.len()..zero_width {\n        zeros.push(\"0\");\n    }\n    sign + prefix + zeros.join(\"\") + digits\n}\n\n// __fmt_escape quotes s as Rust's `{:?}` of a str does.\nfn __fmt_escape(s: &String) -> String {\n    let mut parts = Vec::new();\n    parts.push(\"\\\"\");\n    let n = s.len();\n    let mut start = 0;\n    for i in 0..n {\n        let c = s.char_at(i).unwrap_or(0);\n        let mut esc = \"\";\n        if c == 92 {\n            esc = \"\\\\\\\\\";\n        } else if c == 34 {\n            esc = \"\\\\\\\"\";\n        } else if c == 10 {\n            esc = \"\\\\n\";\n        } else if c == 9 {\n            esc = \"\\\\t\";\n        } else if c == 13 {\n            esc = \"\\\\r\";\n        } else if c == 0 {\n            esc = \"\\\\0\";\n        } else if c < 32 || c == 127 {\n            esc = \"\\\\u{\" + __fmt_int(c, 16, false, false, false, 0) + \"}\";\n        }\n        if esc != \"\" {\n            parts.push(s.slice(start, i));\n            parts.push(esc);\n            start = i + 1;\n        }\n    }\n    parts.push(s.slice(start, n));\n    parts.push(\"\\\"\");\n    parts.join(\"\")\n}\n\n// __fmt_assert_failed is the message of a failed assert_eq! / assert_ne!.\nfn __fmt_assert_failed(op: String, left: String, right: String, msg: String) -> String {\n    let mut head = \"assertion `left \" + op + \" right` failed\";\n    if msg != \"\" {\n        head = head + \": \" + msg;\n    }\n    head + \"\\n  left: \" + left + \"\\n right: \" + right\n}\n\n// __vec_from_elem is `vec![x; n]`: n clones of x.\nfn __vec_from_elem<T: Clone>(x: T, n: Int) -> Vec<T> {\n    let mut v = Vec::new();\n    for i in 0..n {\n        v.push(x.clone());\n    }\n    v\n}\n",
    );
    core_file(
        v,
        "hash.kek",
        "// Hashing, as in Rust's core::hash: a type implements Hash by feeding its\n// parts to a Hasher.\n\ntrait Hasher {\n    fn finish(&self) -> Int;\n\n    fn write_i64(&mut self, i: Int);\n\n    fn write_str(&mut self, s: String) {\n        let n = s.len();\n        let mut i = 0;\n        while i < n {\n            self.write_i64(s.char_at(i).unwrap_or(0));\n            i = i + 1;\n        }\n        // a terminator, so that (\"ab\", \"c\") and (\"a\", \"bc\") differ\n        self.write_i64(-1);\n    }\n}\n\ntrait Hash {\n    fn hash<H: Hasher>(&self, state: &mut H);\n}\n\n// DefaultHasher is a fixed (unseeded) 64-bit FNV-1a-style hasher, so that\n// hashes are deterministic.\nstruct DefaultHasher {\n    mut state: Int,\n}\n\nimpl DefaultHasher {\n    fn new() -> DefaultHasher {\n        DefaultHasher { state: -3750763034362895579 }\n    }\n}\n\nimpl Hasher for DefaultHasher {\n    fn finish(&self) -> Int {\n        let h = self.state;\n        let h2 = h.bit_xor(h.ushr(33)) * -49064778989728563;\n        h2.bit_xor(h2.ushr(33))\n    }\n\n    fn write_i64(&mut self, i: Int) {\n        self.state = self.state.bit_xor(i) * 1099511628211;\n    }\n\n    // the same steps as Hasher::write_str, done by the runtime\n    fn write_str(&mut self, s: String) {\n        self.state = s.__hash(self.state);\n    }\n}\n\nimpl Hash for Int {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_i64(*self);\n    }\n}\n\nimpl Hash for Bool {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_i64(if *self { 1 } else { 0 });\n    }\n}\n\nimpl Hash for String {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_str(*self);\n    }\n}\n\nimpl Hash for () {\n    fn hash<H: Hasher>(&self, state: &mut H) {}\n}\n\nimpl<T: Hash> Hash for Option<T> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        match self {\n            None => state.write_i64(0),\n            Some(x) => {\n                state.write_i64(1);\n                x.hash(state);\n            }\n        }\n    }\n}\n\nimpl<T: Hash, E: Hash> Hash for Result<T, E> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        match self {\n            Ok(x) => {\n                state.write_i64(0);\n                x.hash(state);\n            }\n            Err(e) => {\n                state.write_i64(1);\n                e.hash(state);\n            }\n        }\n    }\n}\n\nimpl<T: Hash> Hash for Vec<T> {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        state.write_i64(self.len());\n        for x in *self {\n            x.hash(state);\n        }\n    }\n}\n",
    );
    core_file(
        v,
        "hashmap.kek",
        "// HashMap and HashSet, with Rust's API (std::collections), iterating in\n// insertion order.\n//\n// Entries are kept in insertion order in `entries` (a removed entry stays\n// as a hole, `live` false, until the table is rebuilt). `buckets` holds,\n// per bucket, the first entry of a chain linked by `next`. The hash is\n// fixed (unseeded), so a bucket can be made to collide on purpose: when a\n// chain grows past TREEIFY entries it becomes an AVL tree ordered by the\n// keys (`Ord`), so that every operation stays O(log n) (this is why keys\n// must be Ord as well as Hash + Eq).\n//\n// Iteration is a live view: an iterator sees entries inserted after it was\n// created and skips removed ones. Rebuilding the table compacts the\n// entries; an iterator then finds its place again by the insertion\n// sequence number of the last entry it returned.\n\nstruct HashEntry<K, V> {\n    key: K,\n    mut value: V,\n    hash: Int,\n    seq: Int,\n    // chain: the next entry; tree: the left child (-1: none)\n    mut next: Int,\n    mut right: Int,\n    mut height: Int,\n}\n\nstruct HashMap<K, V> {\n    mut entries: Vec<HashEntry<K, V>>,\n    mut live: Vec<Bool>,\n    mut buckets: Vec<Int>,\n    mut tree: Vec<Bool>,\n    mut len: Int,\n    mut next_seq: Int,\n    // incremented when the entries are compacted\n    mut epoch: Int,\n}\n\nfn __hashmap_treeify_len() -> Int {\n    8\n}\n\n// __hash_of hashes a value with the default hasher.\nfn __hash_of<T: Hash>(x: &T) -> Int {\n    let mut h = DefaultHasher::new();\n    x.hash(&mut h);\n    h.finish()\n}\n\nimpl<K, V> HashMap<K, V> {\n    fn new() -> HashMap<K, V> {\n        HashMap::with_capacity(0)\n    }\n\n    fn with_capacity(n: Int) -> HashMap<K, V> {\n        let mut size = 8;\n        while size * 3 < n * 4 {\n            size = size * 2;\n        }\n        let mut m = HashMap {\n            entries: Vec::new(),\n            live: Vec::new(),\n            buckets: Vec::new(),\n            tree: Vec::new(),\n            len: 0,\n            next_seq: 0,\n            epoch: 0,\n        };\n        for i in 0..size {\n            m.buckets.push(-1);\n            m.tree.push(false);\n        }\n        m\n    }\n\n    fn len(&self) -> Int {\n        self.len\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.len == 0\n    }\n\n    fn clear(&mut self) {\n        self.entries = Vec::new();\n        self.live = Vec::new();\n        for i in 0..self.buckets.len() {\n            self.buckets.set(i, -1);\n            self.tree.set(i, false);\n        }\n        self.len = 0;\n        self.epoch = self.epoch + 1;\n    }\n\n    // iter returns the (key, value) pairs in insertion order.\n    #[fresh]\n    fn iter(&self) -> HashMapIter<K, V> {\n        HashMapIter { map: *self, i: 0, epoch: self.epoch, last_seq: -1 }\n    }\n\n    #[fresh]\n    fn keys(&self) -> Keys<K, V> {\n        Keys { it: self.iter() }\n    }\n\n    #[fresh]\n    fn values(&self) -> Values<K, V> {\n        Values { it: self.iter() }\n    }\n\n    // into_keys and into_values are keys and values (the map is not\n    // consumed: there is no ownership).\n    #[fresh]\n    fn into_keys(self) -> Keys<K, V> {\n        self.keys()\n    }\n\n    #[fresh]\n    fn into_values(self) -> Values<K, V> {\n        self.values()\n    }\n\n    fn bucket_of(&self, hash: Int) -> Int {\n        hash.bit_and(self.buckets.len() - 1)\n    }\n\n    fn is_live(&self, i: Int) -> Bool {\n        self.live.get(i).unwrap_or(false)\n    }\n\n    // ---- AVL trees of entry indices (left: next, right: right) ----\n\n    fn height(&self, i: Int) -> Int {\n        if i < 0 {\n            return 0;\n        }\n        match self.entries.get(i) {\n            Some(e) => e.height,\n            None => 0,\n        }\n    }\n\n    fn left(&self, i: Int) -> Int {\n        match self.entries.get(i) {\n            Some(e) => e.next,\n            None => -1,\n        }\n    }\n\n    fn right(&self, i: Int) -> Int {\n        match self.entries.get(i) {\n            Some(e) => e.right,\n            None => -1,\n        }\n    }\n\n    fn set_children(&mut self, i: Int, l: Int, r: Int) {\n        match self.entries.get(i) {\n            Some(mut e) => {\n                e.next = l;\n                e.right = r;\n                e.height = 1 + self.height(l).max(self.height(r));\n            }\n            None => {}\n        }\n    }\n\n    fn rebalance(&mut self, i: Int) -> Int {\n        let l = self.left(i);\n        let r = self.right(i);\n        let bal = self.height(l) - self.height(r);\n        if bal > 1 {\n            // left heavy\n            let ll = self.left(l);\n            let lr = self.right(l);\n            if self.height(ll) >= self.height(lr) {\n                self.set_children(i, lr, r);\n                self.set_children(l, ll, i);\n                return l;\n            }\n            self.set_children(l, ll, self.left(lr));\n            self.set_children(i, self.right(lr), r);\n            self.set_children(lr, l, i);\n            return lr;\n        }\n        if bal < -1 {\n            let rl = self.left(r);\n            let rr = self.right(r);\n            if self.height(rr) >= self.height(rl) {\n                self.set_children(i, l, rl);\n                self.set_children(r, i, rr);\n                return r;\n            }\n            self.set_children(r, self.right(rl), rr);\n            self.set_children(i, l, self.left(rl));\n            self.set_children(rl, i, r);\n            return rl;\n        }\n        self.set_children(i, l, r);\n        i\n    }\n\n    // tree_min_remove removes the leftmost node of the tree at root,\n    // returning (new root, removed node).\n    fn tree_min_remove(&mut self, root: Int) -> (Int, Int) {\n        let l = self.left(root);\n        if l < 0 {\n            return (self.right(root), root);\n        }\n        let (nl, m) = self.tree_min_remove(l);\n        self.set_children(root, nl, self.right(root));\n        (self.rebalance(root), m)\n    }\n}\n\nimpl<K: Hash + Eq + Ord, V> HashMap<K, V> {\n    fn key_at(&self, i: Int, k: &K) -> Bool {\n        match self.entries.get(i) {\n            Some(e) => e.key == *k,\n            None => false,\n        }\n    }\n\n    // find returns the index of the live entry with key k, or -1.\n    fn find(&self, k: &K, hash: Int) -> Int {\n        let b = self.bucket_of(hash);\n        let mut i = self.buckets.get(b).unwrap_or(-1);\n        if self.tree.get(b).unwrap_or(false) {\n            while i >= 0 {\n                match self.entries.get(i) {\n                    Some(e) => match k.cmp(&e.key) {\n                        Ordering::Less => {\n                            i = e.next;\n                        }\n                        Ordering::Greater => {\n                            i = e.right;\n                        }\n                        Ordering::Equal => {\n                            return i;\n                        }\n                    },\n                    None => {\n                        return -1;\n                    }\n                }\n            }\n            return -1;\n        }\n        while i >= 0 {\n            match self.entries.get(i) {\n                Some(e) => {\n                    if e.hash == hash && e.key == *k {\n                        return i;\n                    }\n                    i = e.next;\n                }\n                None => {\n                    return -1;\n                }\n            }\n        }\n        -1\n    }\n\n    fn get(&self, k: &K) -> Option<V> {\n        let i = self.find(k, __hash_of(k));\n        if i < 0 {\n            return None;\n        }\n        match self.entries.get(i) {\n            Some(e) => Some(e.value),\n            None => None,\n        }\n    }\n\n    fn contains_key(&self, k: &K) -> Bool {\n        self.find(k, __hash_of(k)) >= 0\n    }\n\n    // insert sets the value of k, returning its previous value.\n    fn insert(&mut self, k: K, v: V) -> Option<V> {\n        let hash = __hash_of(&k);\n        let i = self.find(&k, hash);\n        if i >= 0 {\n            match self.entries.get(i) {\n                Some(mut e) => {\n                    let old = e.value;\n                    e.value = v;\n                    return Some(old);\n                }\n                None => {}\n            }\n        }\n        if (self.entries.len() + 1) * 4 > self.buckets.len() * 3 {\n            self.rebuild(self.len + 1);\n        }\n        let e = HashEntry {\n            key: k,\n            value: v,\n            hash: hash,\n            seq: self.next_seq,\n            next: -1,\n            right: -1,\n            height: 1,\n        };\n        self.next_seq = self.next_seq + 1;\n        self.entries.push(e);\n        self.live.push(true);\n        self.len = self.len + 1;\n        self.link(self.entries.len() - 1);\n        None\n    }\n\n    // remove removes k, returning its value.\n    fn remove(&mut self, k: &K) -> Option<V> {\n        let hash = __hash_of(k);\n        let i = self.find(k, hash);\n        if i < 0 {\n            return None;\n        }\n        let b = self.bucket_of(hash);\n        if self.tree.get(b).unwrap_or(false) {\n            let root = self.tree_remove(self.buckets.get(b).unwrap_or(-1), k);\n            self.buckets.set(b, root);\n        } else {\n            let mut prev = -1;\n            let mut j = self.buckets.get(b).unwrap_or(-1);\n            while j >= 0 && j != i {\n                prev = j;\n                j = self.left(j);\n            }\n            let nx = self.left(i);\n            if prev < 0 {\n                self.buckets.set(b, nx);\n            } else {\n                match self.entries.get(prev) {\n                    Some(mut pe) => {\n                        pe.next = nx;\n                    }\n                    None => {}\n                }\n            }\n        }\n        self.live.set(i, false);\n        self.len = self.len - 1;\n        match self.entries.get(i) {\n            Some(e) => Some(e.value),\n            None => None,\n        }\n    }\n\n    // link adds entry i to its bucket.\n    fn link(&mut self, i: Int) {\n        let hash = match self.entries.get(i) {\n            Some(e) => e.hash,\n            None => 0,\n        };\n        let b = self.bucket_of(hash);\n        let head = self.buckets.get(b).unwrap_or(-1);\n        if self.tree.get(b).unwrap_or(false) {\n            self.buckets.set(b, self.tree_insert(head, i));\n            return;\n        }\n        // append to the chain, counting it\n        match self.entries.get(i) {\n            Some(mut e) => {\n                e.next = -1;\n                e.right = -1;\n                e.height = 1;\n            }\n            None => {}\n        }\n        if head < 0 {\n            self.buckets.set(b, i);\n            return;\n        }\n        let mut n = 1;\n        let mut j = head;\n        while self.left(j) >= 0 {\n            j = self.left(j);\n            n = n + 1;\n        }\n        match self.entries.get(j) {\n            Some(mut e) => {\n                e.next = i;\n            }\n            None => {}\n        }\n        if n + 1 > __hashmap_treeify_len() {\n            self.treeify(b);\n        }\n    }\n\n    // treeify turns bucket b's chain into a tree.\n    fn treeify(&mut self, b: Int) {\n        let mut j = self.buckets.get(b).unwrap_or(-1);\n        let mut root = -1;\n        while j >= 0 {\n            let nx = self.left(j);\n            root = self.tree_insert(root, j);\n            j = nx;\n        }\n        self.buckets.set(b, root);\n        self.tree.set(b, true);\n    }\n\n    fn tree_insert(&mut self, root: Int, i: Int) -> Int {\n        if root < 0 {\n            self.set_children(i, -1, -1);\n            return i;\n        }\n        let ki = match self.entries.get(i) {\n            Some(e) => e.key,\n            None => {\n                return root;\n            }\n        };\n        let less = match self.entries.get(root) {\n            Some(r) => ki < r.key,\n            None => false,\n        };\n        if less {\n            let l = self.tree_insert(self.left(root), i);\n            self.set_children(root, l, self.right(root));\n        } else {\n            let r = self.tree_insert(self.right(root), i);\n            self.set_children(root, self.left(root), r);\n        }\n        self.rebalance(root)\n    }\n\n    fn tree_remove(&mut self, root: Int, k: &K) -> Int {\n        if root < 0 {\n            return -1;\n        }\n        let o = match self.entries.get(root) {\n            Some(r) => k.cmp(&r.key),\n            None => Ordering::Equal,\n        };\n        match o {\n            Ordering::Less => {\n                let l = self.tree_remove(self.left(root), k);\n                self.set_children(root, l, self.right(root));\n                self.rebalance(root)\n            }\n            Ordering::Greater => {\n                let r = self.tree_remove(self.right(root), k);\n                self.set_children(root, self.left(root), r);\n                self.rebalance(root)\n            }\n            Ordering::Equal => {\n                let l = self.left(root);\n                let r = self.right(root);\n                if r < 0 {\n                    return l;\n                }\n                let (nr, m) = self.tree_min_remove(r);\n                self.set_children(m, l, nr);\n                self.rebalance(m)\n            }\n        }\n    }\n\n    // rebuild drops removed entries and rehashes into a table with room for\n    // at least want entries.\n    fn rebuild(&mut self, want: Int) {\n        let mut es = Vec::new();\n        let mut lv = Vec::new();\n        for i in 0..self.entries.len() {\n            if self.is_live(i) {\n                match self.entries.get(i) {\n                    Some(e) => {\n                        es.push(e);\n                        lv.push(true);\n                    }\n                    None => {}\n                }\n            }\n        }\n        if es.len() != self.entries.len() {\n            self.epoch = self.epoch + 1;\n        }\n        self.entries = es;\n        self.live = lv;\n        let mut size = 8;\n        while size * 3 < (want + 1) * 4 {\n            size = size * 2;\n        }\n        self.buckets = Vec::new();\n        self.tree = Vec::new();\n        for i in 0..size {\n            self.buckets.push(-1);\n            self.tree.push(false);\n        }\n        for i in 0..self.entries.len() {\n            self.link(i);\n        }\n    }\n\n    // get_or returns the value of k, or d.\n    fn get_or(&self, k: &K, d: V) -> V {\n        match self.get(k) {\n            Some(v) => v,\n            None => d,\n        }\n    }\n\n    fn retain(&mut self, f: impl Fn(K, V) -> Bool) {\n        let mut drop = Vec::new();\n        for (k, v) in self.iter() {\n            if !f(k, v) {\n                drop.push(k);\n            }\n        }\n        for k in drop {\n            self.remove(&k);\n        }\n    }\n\n    fn extend<I: Iterator<Item = (K, V)>>(&mut self, mut iter: I) {\n        while let Some((k, v)) = iter.next() {\n            self.insert(k, v);\n        }\n    }\n\n    // entry is the entry of k, for in-place updates (lib/core/entry.kek):\n    // `m.entry(w).and_modify(|n| n + 1).or_insert(1)`.\n    fn entry(&mut self, k: K) -> Entry<HashMap<K, V>, K, V> {\n        __entry_of(*self, k)\n    }\n\n    fn get_key_value(&self, k: &K) -> Option<(K, V)> {\n        let i = self.find(k, __hash_of(k));\n        if i < 0 {\n            return None;\n        }\n        match self.entries.get(i) {\n            Some(e) => Some((e.key, e.value)),\n            None => None,\n        }\n    }\n\n    // remove_entry removes k, returning the stored key and its value.\n    fn remove_entry(&mut self, k: &K) -> Option<(K, V)> {\n        match self.get_key_value(k) {\n            Some((sk, v)) => {\n                self.remove(k);\n                Some((sk, v))\n            }\n            None => None,\n        }\n    }\n}\n\nimpl<K: Hash + Eq + Ord, V> __EntryMap<K, V> for HashMap<K, V> {\n    fn __entry_get(&self, k: &K) -> Option<V> {\n        self.get(k)\n    }\n\n    fn __entry_insert(&mut self, k: K, v: V) -> Option<V> {\n        self.insert(k, v)\n    }\n\n    fn __entry_remove(&mut self, k: &K) -> Option<V> {\n        self.remove(k)\n    }\n}\n\n// ---- iteration ----\n\nstruct HashMapIter<K, V> {\n    map: HashMap<K, V>,\n    mut i: Int,\n    mut epoch: Int,\n    mut last_seq: Int,\n}\n\nimpl<K, V> Iterator for HashMapIter<K, V> {\n    type Item = (K, V);\n\n    fn next(&mut self) -> Option<(K, V)> {\n        let m = self.map;\n        if self.epoch != m.epoch {\n            // the entries were compacted (order kept): continue after the\n            // last entry returned, by its sequence number\n            let mut lo = 0;\n            let mut hi = m.entries.len();\n            while lo < hi {\n                let mid = (lo + hi) / 2;\n                let s = match m.entries.get(mid) {\n                    Some(e) => e.seq,\n                    None => 0,\n                };\n                if s <= self.last_seq {\n                    lo = mid + 1;\n                } else {\n                    hi = mid;\n                }\n            }\n            self.i = lo;\n            self.epoch = m.epoch;\n        }\n        while self.i < m.entries.len() {\n            let i = self.i;\n            self.i = i + 1;\n            if m.is_live(i) {\n                match m.entries.get(i) {\n                    Some(e) => {\n                        self.last_seq = e.seq;\n                        return Some((e.key, e.value));\n                    }\n                    None => {}\n                }\n            }\n        }\n        None\n    }\n}\n\nstruct Keys<K, V> {\n    it: HashMapIter<K, V>,\n}\n\nimpl<K, V> Iterator for Keys<K, V> {\n    type Item = K;\n\n    fn next(&mut self) -> Option<K> {\n        match self.it.next() {\n            Some((k, _)) => Some(k),\n            None => None,\n        }\n    }\n}\n\nstruct Values<K, V> {\n    it: HashMapIter<K, V>,\n}\n\nimpl<K, V> Iterator for Values<K, V> {\n    type Item = V;\n\n    fn next(&mut self) -> Option<V> {\n        match self.it.next() {\n            Some((_, v)) => Some(v),\n            None => None,\n        }\n    }\n}\n\nimpl<K, V> IntoIterator for HashMap<K, V> {\n    type Item = (K, V);\n    type IntoIter = HashMapIter<K, V>;\n\n    fn into_iter(self) -> HashMapIter<K, V> {\n        self.iter()\n    }\n}\n\nimpl<K: Hash + Eq + Ord, V> FromIterator<(K, V)> for HashMap<K, V> {\n    fn from_iter<I: Iterator<Item = (K, V)>>(iter: I) -> HashMap<K, V> {\n        let mut m = HashMap::new();\n        m.extend(iter);\n        m\n    }\n}\n\nimpl<K: Hash + Eq + Ord + Clone, V: Clone> Clone for HashMap<K, V> {\n    fn clone(&self) -> HashMap<K, V> {\n        let mut m = HashMap::with_capacity(self.len());\n        for (k, v) in self.iter() {\n            m.insert(k.clone(), v.clone());\n        }\n        m\n    }\n}\n\n// Maps are equal when they have the same keys with equal values (in any\n// order).\nimpl<K: Hash + Eq + Ord, V: PartialEq> PartialEq for HashMap<K, V> {\n    fn eq(&self, other: &HashMap<K, V>) -> Bool {\n        if self.len() != other.len() {\n            return false;\n        }\n        for (k, v) in self.iter() {\n            match other.get(&k) {\n                Some(w) => {\n                    if v != w {\n                        return false;\n                    }\n                }\n                None => {\n                    return false;\n                }\n            }\n        }\n        true\n    }\n}\n\nimpl<K: Hash + Eq + Ord, V: Eq> Eq for HashMap<K, V> {}\n\nimpl<K, V> Default for HashMap<K, V> {\n    fn default() -> HashMap<K, V> {\n        HashMap::new()\n    }\n}\n\n// ---- HashSet ----\n\nstruct HashSet<T> {\n    map: HashMap<T, ()>,\n}\n\nimpl<T> HashSet<T> {\n    fn new() -> HashSet<T> {\n        HashSet { map: HashMap::new() }\n    }\n\n    fn with_capacity(n: Int) -> HashSet<T> {\n        HashSet { map: HashMap::with_capacity(n) }\n    }\n\n    fn len(&self) -> Int {\n        self.map.len()\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.map.is_empty()\n    }\n\n    fn clear(&mut self) {\n        self.map.clear();\n    }\n\n    // iter returns the elements in insertion order.\n    #[fresh]\n    fn iter(&self) -> Keys<T, ()> {\n        self.map.keys()\n    }\n}\n\nimpl<T: Hash + Eq + Ord> HashSet<T> {\n    // insert adds x, reporting whether it was new.\n    fn insert(&mut self, x: T) -> Bool {\n        self.map.insert(x, ()).is_none()\n    }\n\n    fn contains(&self, x: &T) -> Bool {\n        self.map.contains_key(x)\n    }\n\n    // remove removes x, reporting whether it was present.\n    fn remove(&mut self, x: &T) -> Bool {\n        self.map.remove(x).is_some()\n    }\n\n    fn extend<I: Iterator<Item = T>>(&mut self, mut iter: I) {\n        while let Some(x) = iter.next() {\n            self.insert(x);\n        }\n    }\n\n    fn retain(&mut self, f: impl Fn(T) -> Bool) {\n        let mut drop = Vec::new();\n        for x in self.iter() {\n            if !f(x) {\n                drop.push(x);\n            }\n        }\n        for x in drop {\n            self.remove(&x);\n        }\n    }\n\n    fn is_subset(&self, other: &HashSet<T>) -> Bool {\n        for x in self.iter() {\n            if !other.contains(&x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    // union, intersection and difference return the resulting elements in\n    // order (self's first).\n    #[fresh]\n    fn union(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out: Vec<T> = self.iter().collect();\n        for x in other.iter() {\n            if !self.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    #[fresh]\n    fn intersection(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            if other.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    #[fresh]\n    fn difference(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            if !other.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    // symmetric_difference: the elements in exactly one of the sets\n    // (self's first).\n    #[fresh]\n    fn symmetric_difference(&self, other: &HashSet<T>) -> Vec<T> {\n        let mut out = self.difference(other);\n        for x in other.iter() {\n            if !self.contains(&x) {\n                out.push(x);\n            }\n        }\n        out\n    }\n\n    fn is_superset(&self, other: &HashSet<T>) -> Bool {\n        other.is_subset(self)\n    }\n\n    // is_disjoint: no element in common.\n    fn is_disjoint(&self, other: &HashSet<T>) -> Bool {\n        for x in self.iter() {\n            if other.contains(&x) {\n                return false;\n            }\n        }\n        true\n    }\n}\n\nimpl<T> IntoIterator for HashSet<T> {\n    type Item = T;\n    type IntoIter = Keys<T, ()>;\n\n    fn into_iter(self) -> Keys<T, ()> {\n        self.iter()\n    }\n}\n\nimpl<T: Hash + Eq + Ord> FromIterator<T> for HashSet<T> {\n    fn from_iter<I: Iterator<Item = T>>(iter: I) -> HashSet<T> {\n        let mut s = HashSet::new();\n        s.extend(iter);\n        s\n    }\n}\n\nimpl<T: Hash + Eq + Ord + Clone> Clone for HashSet<T> {\n    fn clone(&self) -> HashSet<T> {\n        let mut s = HashSet::with_capacity(self.len());\n        for x in self.iter() {\n            s.insert(x.clone());\n        }\n        s\n    }\n}\n\nimpl<T: Hash + Eq + Ord> PartialEq for HashSet<T> {\n    fn eq(&self, other: &HashSet<T>) -> Bool {\n        self.len() == other.len() && self.is_subset(other)\n    }\n}\n\nimpl<T: Hash + Eq + Ord> Eq for HashSet<T> {}\n\nimpl<T> Default for HashSet<T> {\n    fn default() -> HashSet<T> {\n        HashSet::new()\n    }\n}\n",
    );
    core_file(
        v,
        "int.kek",
        "// Methods of Int, as in Rust's i64 (`to_string`, `abs`, `min`, `max` and\n// the bit operations are builtins). Arithmetic wraps around and nothing\n// panics: `checked_*` reports overflow and division by zero as None,\n// `saturating_*` stops at the bounds, and `wrapping_*` is the plain\n// operator. There are no associated constants yet, so Int::MAX and\n// Int::MIN are the functions Int::max_value() and Int::min_value().\n\nimpl Int {\n    fn max_value() -> Int {\n        9223372036854775807\n    }\n\n    fn min_value() -> Int {\n        -9223372036854775807 - 1\n    }\n\n    fn is_positive(self) -> Bool {\n        self > 0\n    }\n\n    fn is_negative(self) -> Bool {\n        self < 0\n    }\n\n    // signum is -1, 0 or 1.\n    fn signum(self) -> Int {\n        if self > 0 {\n            1\n        } else if self < 0 { -1 } else { 0 }\n    }\n\n    // pow is self raised to e, wrapping around on overflow. A negative e\n    // gives the truncated result as integer division does: 1 for 1, ±1 for\n    // -1 and 0 otherwise.\n    fn pow(self, e: Int) -> Int {\n        if e < 0 {\n            if self == 1 {\n                return 1;\n            }\n            if self == -1 {\n                return if e % 2 == 0 { 1 } else { -1 };\n            }\n            return 0;\n        }\n        let mut base = self;\n        let mut k = e;\n        let mut r = 1;\n        while k > 0 {\n            if k % 2 == 1 {\n                r = r * base;\n            }\n            k = k / 2;\n            if k > 0 {\n                base = base * base;\n            }\n        }\n        r\n    }\n\n    // ---- checked ----\n\n    fn checked_add(self, b: Int) -> Option<Int> {\n        let r = self + b;\n        if (self >= 0) == (b >= 0) && (r >= 0) != (self >= 0) {\n            None\n        } else {\n            Some(r)\n        }\n    }\n\n    fn checked_sub(self, b: Int) -> Option<Int> {\n        let r = self - b;\n        if (self >= 0) != (b >= 0) && (r >= 0) != (self >= 0) {\n            None\n        } else {\n            Some(r)\n        }\n    }\n\n    fn checked_mul(self, b: Int) -> Option<Int> {\n        if self == 0 || b == 0 {\n            return Some(0);\n        }\n        let min = Int::min_value();\n        if (self == -1 && b == min) || (b == -1 && self == min) {\n            return None;\n        }\n        let r = self * b;\n        if r / b != self { None } else { Some(r) }\n    }\n\n    // checked_div is None for a zero divisor and for MIN / -1.\n    fn checked_div(self, b: Int) -> Option<Int> {\n        if b == 0 || (b == -1 && self == Int::min_value()) {\n            None\n        } else {\n            Some(self / b)\n        }\n    }\n\n    fn checked_rem(self, b: Int) -> Option<Int> {\n        if b == 0 || (b == -1 && self == Int::min_value()) {\n            None\n        } else {\n            Some(self % b)\n        }\n    }\n\n    // checked_pow is None on overflow and for a negative exponent.\n    fn checked_pow(self, e: Int) -> Option<Int> {\n        if e < 0 {\n            return None;\n        }\n        let mut base = self;\n        let mut k = e;\n        let mut r = 1;\n        while k > 0 {\n            if k % 2 == 1 {\n                match r.checked_mul(base) {\n                    Some(x) => {\n                        r = x;\n                    }\n                    None => {\n                        return None;\n                    }\n                }\n            }\n            k = k / 2;\n            if k > 0 {\n                match base.checked_mul(base) {\n                    Some(x) => {\n                        base = x;\n                    }\n                    None => {\n                        return None;\n                    }\n                }\n            }\n        }\n        Some(r)\n    }\n\n    fn checked_neg(self) -> Option<Int> {\n        if self == Int::min_value() {\n            None\n        } else {\n            Some(0 - self)\n        }\n    }\n\n    fn checked_abs(self) -> Option<Int> {\n        if self == Int::min_value() {\n            None\n        } else {\n            Some(self.abs())\n        }\n    }\n\n    // ---- wrapping (the operators already wrap) ----\n\n    fn wrapping_add(self, b: Int) -> Int {\n        self + b\n    }\n\n    fn wrapping_sub(self, b: Int) -> Int {\n        self - b\n    }\n\n    fn wrapping_mul(self, b: Int) -> Int {\n        self * b\n    }\n\n    fn wrapping_neg(self) -> Int {\n        0 - self\n    }\n\n    // ---- saturating ----\n\n    fn saturating_add(self, b: Int) -> Int {\n        match self.checked_add(b) {\n            Some(r) => r,\n            None => if b > 0 {\n                Int::max_value()\n            } else {\n                Int::min_value()\n            },\n        }\n    }\n\n    fn saturating_sub(self, b: Int) -> Int {\n        match self.checked_sub(b) {\n            Some(r) => r,\n            None => if b < 0 {\n                Int::max_value()\n            } else {\n                Int::min_value()\n            },\n        }\n    }\n\n    fn saturating_mul(self, b: Int) -> Int {\n        match self.checked_mul(b) {\n            Some(r) => r,\n            None => if (self < 0) == (b < 0) {\n                Int::max_value()\n            } else {\n                Int::min_value()\n            },\n        }\n    }\n\n    fn saturating_pow(self, e: Int) -> Int {\n        match self.checked_pow(e) {\n            Some(r) => r,\n            None => {\n                if e < 0 {\n                    self.pow(e)\n                } else if self < 0 && e % 2 == 1 {\n                    Int::min_value()\n                } else {\n                    Int::max_value()\n                }\n            }\n        }\n    }\n\n    // ---- euclidean division ----\n\n    // rem_euclid is the remainder in [0, |b|). As with `%`, a zero divisor\n    // gives self back.\n    fn rem_euclid(self, b: Int) -> Int {\n        let r = self % b;\n        if r < 0 {\n            if b < 0 { r - b } else { r + b }\n        } else {\n            r\n        }\n    }\n\n    // div_euclid is the quotient q with self == q * b + self.rem_euclid(b).\n    // As with `/`, a zero divisor gives 0.\n    fn div_euclid(self, b: Int) -> Int {\n        let q = self / b;\n        if b != 0 && self % b < 0 {\n            if b > 0 { q - 1 } else { q + 1 }\n        } else {\n            q\n        }\n    }\n\n    // clamp restricts self to [lo, hi]; when lo > hi it gives hi (Rust\n    // panics).\n    fn clamp(self, lo: Int, hi: Int) -> Int {\n        if self < lo {\n            if lo > hi { hi } else { lo }\n        } else if self > hi { hi } else { self }\n    }\n\n    // abs_diff is |self - b|, wrapping around when that exceeds Int::MAX\n    // (Rust returns an unsigned integer).\n    fn abs_diff(self, b: Int) -> Int {\n        if self > b { self - b } else { b - self }\n    }\n\n    // ---- bits (of the 64-bit two's complement) ----\n\n    fn count_ones(self) -> Int {\n        let mut x = self;\n        let mut n = 0;\n        while x != 0 {\n            x = x.bit_and(x - 1);\n            n = n + 1;\n        }\n        n\n    }\n\n    fn count_zeros(self) -> Int {\n        64 - self.count_ones()\n    }\n\n    fn leading_zeros(self) -> Int {\n        if self == 0 {\n            return 64;\n        }\n        let mut x = self;\n        let mut n = 0;\n        while x > 0 {\n            x = x.shl(1);\n            n = n + 1;\n        }\n        n\n    }\n\n    fn trailing_zeros(self) -> Int {\n        if self == 0 {\n            return 64;\n        }\n        let mut x = self;\n        let mut n = 0;\n        while x.bit_and(1) == 0 {\n            x = x.ushr(1);\n            n = n + 1;\n        }\n        n\n    }\n\n    fn is_power_of_two(self) -> Bool {\n        self > 0 && self.bit_and(self - 1) == 0\n    }\n}\n",
    );
    core_file(
        v,
        "iter.kek",
        "// Iterators, as in Rust's core::iter: the Iterator trait with its adapters\n// and consumers, ranges, and the iterators of Vec.\n//\n// Closures are pure values here: an adapter keeps its closure in a field\n// of type `fn(A) -> B`.\n\ntrait Iterator {\n    type Item;\n\n    fn next(&mut self) -> Option<Self::Item>;\n\n    // ---- consumers ----\n\n    fn count(mut self) -> Int {\n        let mut n = 0;\n        while let Some(_) = self.next() {\n            n = n + 1;\n        }\n        n\n    }\n\n    fn last(mut self) -> Option<Self::Item> {\n        let mut last = None;\n        while let Some(x) = self.next() {\n            last = Some(x);\n        }\n        last\n    }\n\n    fn nth(&mut self, n: Int) -> Option<Self::Item> {\n        let mut i = 0;\n        while i < n {\n            if self.next().is_none() {\n                return None;\n            }\n            i = i + 1;\n        }\n        self.next()\n    }\n\n    fn fold<B>(mut self, init: B, f: impl Fn(B, Self::Item) -> B) -> B {\n        let mut acc = init;\n        while let Some(x) = self.next() {\n            acc = f(acc, x);\n        }\n        acc\n    }\n\n    fn for_each(mut self, f: impl Fn(Self::Item)) {\n        while let Some(x) = self.next() {\n            f(x);\n        }\n    }\n\n    fn any(&mut self, p: impl Fn(Self::Item) -> Bool) -> Bool {\n        while let Some(x) = self.next() {\n            if p(x) {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn all(&mut self, p: impl Fn(Self::Item) -> Bool) -> Bool {\n        while let Some(x) = self.next() {\n            if !p(x) {\n                return false;\n            }\n        }\n        true\n    }\n\n    fn find(&mut self, p: impl Fn(Self::Item) -> Bool) -> Option<Self::Item> {\n        while let Some(x) = self.next() {\n            if p(x) {\n                return Some(x);\n            }\n        }\n        None\n    }\n\n    fn find_map<B>(&mut self, f: impl Fn(Self::Item) -> Option<B>) -> Option<B> {\n        while let Some(x) = self.next() {\n            match f(x) {\n                Some(y) => {\n                    return Some(y);\n                }\n                None => {}\n            }\n        }\n        None\n    }\n\n    fn position(&mut self, p: impl Fn(Self::Item) -> Bool) -> Option<Int> {\n        let mut i = 0;\n        while let Some(x) = self.next() {\n            if p(x) {\n                return Some(i);\n            }\n            i = i + 1;\n        }\n        None\n    }\n\n    #[fresh]\n    fn collect<B: FromIterator<Self::Item>>(self) -> B {\n        B::from_iter(self)\n    }\n\n    fn sum<S: Sum<Self::Item>>(self) -> S {\n        S::sum(self)\n    }\n\n    fn product<P: Product<Self::Item>>(self) -> P {\n        P::product(self)\n    }\n\n    fn max(mut self) -> Option<Self::Item>\n    where\n        Self::Item: Ord,\n    {\n        let mut best = None;\n        while let Some(x) = self.next() {\n            best = match best {\n                Some(b) => if x >= b { Some(x) } else { Some(b) },\n                None => Some(x),\n            };\n        }\n        best\n    }\n\n    fn min(mut self) -> Option<Self::Item>\n    where\n        Self::Item: Ord,\n    {\n        let mut best = None;\n        while let Some(x) = self.next() {\n            best = match best {\n                Some(b) => if x < b { Some(x) } else { Some(b) },\n                None => Some(x),\n            };\n        }\n        best\n    }\n\n    fn max_by_key<B: Ord>(mut self, f: impl Fn(Self::Item) -> B) -> Option<Self::Item> {\n        let mut best = None;\n        let mut best_k = None;\n        while let Some(x) = self.next() {\n            let k = f(x);\n            let better = match best_k {\n                Some(bk) => k >= bk,\n                None => true,\n            };\n            if better {\n                best = Some(x);\n                best_k = Some(k);\n            }\n        }\n        best\n    }\n\n    fn min_by_key<B: Ord>(mut self, f: impl Fn(Self::Item) -> B) -> Option<Self::Item> {\n        let mut best = None;\n        let mut best_k = None;\n        while let Some(x) = self.next() {\n            let k = f(x);\n            let better = match best_k {\n                Some(bk) => k < bk,\n                None => true,\n            };\n            if better {\n                best = Some(x);\n                best_k = Some(k);\n            }\n        }\n        best\n    }\n\n    // max_by and min_by compare with a function; max_by returns the last of\n    // equal maxima and min_by the first of equal minima (as Rust's).\n    fn max_by(mut self, f: impl Fn(Self::Item, Self::Item) -> Ordering) -> Option<Self::Item> {\n        let mut best = None;\n        while let Some(x) = self.next() {\n            best = match best {\n                Some(b) => match f(x, b) {\n                    Ordering::Less => Some(b),\n                    _ => Some(x),\n                },\n                None => Some(x),\n            };\n        }\n        best\n    }\n\n    fn min_by(mut self, f: impl Fn(Self::Item, Self::Item) -> Ordering) -> Option<Self::Item> {\n        let mut best = None;\n        while let Some(x) = self.next() {\n            best = match best {\n                Some(b) => match f(x, b) {\n                    Ordering::Less => Some(x),\n                    _ => Some(b),\n                },\n                None => Some(x),\n            };\n        }\n        best\n    }\n\n    // reduce folds with the first element as the initial value (None when\n    // empty).\n    fn reduce(mut self, f: impl Fn(Self::Item, Self::Item) -> Self::Item) -> Option<Self::Item> {\n        match self.next() {\n            Some(first) => {\n                let mut acc = first;\n                while let Some(x) = self.next() {\n                    acc = f(acc, x);\n                }\n                Some(acc)\n            }\n            None => None,\n        }\n    }\n\n    // try_fold folds while f returns Some / Ok, stopping at the first None /\n    // Err (which it returns).\n    fn try_fold<B, R: __Try<Output = B>>(&mut self, init: B, f: impl Fn(B, Self::Item) -> R) -> R {\n        let mut acc = init;\n        while let Some(x) = self.next() {\n            let r = f(acc, x);\n            match r.__output() {\n                Some(b) => {\n                    acc = b;\n                }\n                None => {\n                    return r;\n                }\n            }\n        }\n        R::__from_output(acc)\n    }\n\n    // try_for_each calls f until it returns None / Err.\n    fn try_for_each<R: __Try<Output = ()>>(&mut self, f: impl Fn(Self::Item) -> R) -> R {\n        while let Some(x) = self.next() {\n            let r = f(x);\n            if r.__output().is_none() {\n                return r;\n            }\n        }\n        R::__from_output(())\n    }\n\n    // partition splits the elements into those satisfying p and the rest.\n    #[fresh]\n    fn partition(mut self, p: impl Fn(Self::Item) -> Bool) -> (Vec<Self::Item>, Vec<Self::Item>) {\n        let mut yes = Vec::new();\n        let mut no = Vec::new();\n        while let Some(x) = self.next() {\n            if p(x) {\n                yes.push(x);\n            } else {\n                no.push(x);\n            }\n        }\n        (yes, no)\n    }\n\n    #[fresh]\n    fn unzip<A, B>(mut self) -> (Vec<A>, Vec<B>)\n    where\n        Self::Item: __Pair<First = A, Second = B>,\n    {\n        let mut va = Vec::new();\n        let mut vb = Vec::new();\n        while let Some(p) = self.next() {\n            let (a, b) = p.__split();\n            va.push(a);\n            vb.push(b);\n        }\n        (va, vb)\n    }\n\n    fn is_sorted(mut self) -> Bool\n    where\n        Self::Item: Ord,\n    {\n        self.is_sorted_by(|a, b| a <= b)\n    }\n\n    // is_sorted_by checks f(a, b) for every adjacent pair.\n    fn is_sorted_by(mut self, f: impl Fn(Self::Item, Self::Item) -> Bool) -> Bool {\n        match self.next() {\n            Some(first) => {\n                let mut prev = first;\n                while let Some(x) = self.next() {\n                    if !f(prev, x) {\n                        return false;\n                    }\n                    prev = x;\n                }\n                true\n            }\n            None => true,\n        }\n    }\n\n    fn is_sorted_by_key<K: Ord>(mut self, f: impl Fn(Self::Item) -> K) -> Bool {\n        self.map(f).is_sorted()\n    }\n\n    // cmp compares two iterators lexicographically.\n    fn cmp<J: Iterator<Item = Self::Item>>(mut self, mut other: J) -> Ordering\n    where\n        Self::Item: Ord,\n    {\n        loop {\n            match self.next() {\n                Some(x) => match other.next() {\n                    Some(y) => match x.cmp(&y) {\n                        Ordering::Equal => {}\n                        o => {\n                            return o;\n                        }\n                    },\n                    None => {\n                        return Ordering::Greater;\n                    }\n                },\n                None => {\n                    if other.next().is_none() {\n                        return Ordering::Equal;\n                    }\n                    return Ordering::Less;\n                }\n            }\n        }\n    }\n\n    fn eq<J: Iterator<Item = Self::Item>>(mut self, mut other: J) -> Bool\n    where\n        Self::Item: PartialEq,\n    {\n        loop {\n            match self.next() {\n                Some(x) => match other.next() {\n                    Some(y) => {\n                        if x != y {\n                            return false;\n                        }\n                    }\n                    None => {\n                        return false;\n                    }\n                },\n                None => {\n                    return other.next().is_none();\n                }\n            }\n        }\n    }\n\n    fn ne<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool\n    where\n        Self::Item: PartialEq,\n    {\n        !self.eq(other)\n    }\n\n    fn lt<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool\n    where\n        Self::Item: Ord,\n    {\n        self.cmp(other) == Ordering::Less\n    }\n\n    fn le<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool\n    where\n        Self::Item: Ord,\n    {\n        self.cmp(other) != Ordering::Greater\n    }\n\n    fn gt<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool\n    where\n        Self::Item: Ord,\n    {\n        self.cmp(other) == Ordering::Greater\n    }\n\n    fn ge<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool\n    where\n        Self::Item: Ord,\n    {\n        self.cmp(other) != Ordering::Less\n    }\n\n    // ---- adapters ----\n\n    #[fresh]\n    fn map<B>(self, f: impl Fn(Self::Item) -> B) -> Map<Self, Self::Item, B> {\n        Map { iter: self, f: f }\n    }\n\n    #[fresh]\n    fn filter(self, p: impl Fn(Self::Item) -> Bool) -> Filter<Self, Self::Item> {\n        Filter { iter: self, p: p }\n    }\n\n    #[fresh]\n    fn filter_map<B>(self, f: impl Fn(Self::Item) -> Option<B>) -> FilterMap<Self, Self::Item, B> {\n        FilterMap { iter: self, f: f }\n    }\n\n    #[fresh]\n    fn enumerate(self) -> Enumerate<Self> {\n        Enumerate { iter: self, i: 0 }\n    }\n\n    #[fresh]\n    fn zip<U: Iterator>(self, other: U) -> Zip<Self, U> {\n        Zip { a: self, b: other }\n    }\n\n    #[fresh]\n    fn chain<U: Iterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U> {\n        Chain { a: self, b: other, first: true }\n    }\n\n    #[fresh]\n    fn take(self, n: Int) -> Take<Self> {\n        Take { iter: self, n: n }\n    }\n\n    #[fresh]\n    fn skip(self, n: Int) -> Skip<Self> {\n        Skip { iter: self, n: n }\n    }\n\n    #[fresh]\n    fn take_while(self, p: impl Fn(Self::Item) -> Bool) -> TakeWhile<Self, Self::Item> {\n        TakeWhile { iter: self, p: p, done: false }\n    }\n\n    #[fresh]\n    fn skip_while(self, p: impl Fn(Self::Item) -> Bool) -> SkipWhile<Self, Self::Item> {\n        SkipWhile { iter: self, p: p, started: false }\n    }\n\n    #[fresh]\n    fn step_by(self, step: Int) -> StepBy<Self> {\n        StepBy { iter: self, step: step, first: true }\n    }\n\n    #[fresh]\n    fn peekable(self) -> Peekable<Self, Self::Item> {\n        Peekable { iter: self, peeked: None, has: false }\n    }\n\n    // flat_map maps each element to something iterable (Vec, Option,\n    // HashMap, ...) and yields its elements in turn.\n    #[fresh]\n    fn flat_map<U: IntoIterator>(\n        self,\n        f: impl Fn(Self::Item) -> U,\n    ) -> FlatMap<Self, Self::Item, U, U::IntoIter> {\n        FlatMap { iter: self, f: f, cur: None }\n    }\n\n    // flatten yields the elements of each element (an iterator of Vec,\n    // Option, ...).\n    #[fresh]\n    fn flatten<J>(self) -> FlatMap<Self, Self::Item, Self::Item, J>\n    where\n        Self::Item: IntoIterator<IntoIter = J>,\n    {\n        FlatMap { iter: self, f: |x| x, cur: None }\n    }\n\n    // scan threads a state through the elements: f(state, x) returns the\n    // next state and the element to yield, or None to stop (Rust's closure\n    // takes `&mut St` and returns Option<B>).\n    #[fresh]\n    fn scan<St, B>(\n        self,\n        init: St,\n        f: impl Fn(St, Self::Item) -> Option<(St, B)>,\n    ) -> Scan<Self, Self::Item, St, B> {\n        Scan { iter: self, state: init, f: f, done: false }\n    }\n\n    // inspect calls f on each element as it passes.\n    #[fresh]\n    fn inspect(self, f: impl Fn(Self::Item)) -> Inspect<Self, Self::Item> {\n        Inspect { iter: self, f: f }\n    }\n\n    // map_while maps while f returns Some, and stops at the first None.\n    #[fresh]\n    fn map_while<B>(self, f: impl Fn(Self::Item) -> Option<B>) -> MapWhile<Self, Self::Item, B> {\n        MapWhile { iter: self, f: f, done: false }\n    }\n\n    // fuse stops for good after the first None.\n    #[fresh]\n    fn fuse(self) -> Fuse<Self> {\n        Fuse { iter: self, done: false }\n    }\n\n    // cycle repeats the elements forever (nothing if there are none). The\n    // elements of the first pass are remembered and replayed; since\n    // closures are pure this is the same as restarting a clone.\n    #[fresh]\n    fn cycle(self) -> Cycle<Self, Self::Item> {\n        Cycle { iter: self, buf: Vec::new(), first: true, i: 0 }\n    }\n\n    // copied and cloned: copied yields the elements as they are (values are\n    // never borrowed in Kekkai); cloned yields clone() of each, so its\n    // elements are owned even when the collection is borrowed (#[owned]:\n    // the iterator it wraps is reachable only through a `__` field).\n    #[fresh]\n    fn copied(self) -> Self {\n        self\n    }\n\n    #[owned]\n    fn cloned(self) -> Cloned<Self, Self::Item>\n    where\n        Self::Item: Clone,\n    {\n        Cloned { __iter: self, __item: None }\n    }\n}\n\n// An iterator that can also produce its elements from the back.\ntrait DoubleEndedIterator: Iterator {\n    fn next_back(&mut self) -> Option<Self::Item>;\n\n    #[fresh]\n    fn rev(self) -> Rev<Self> {\n        Rev { iter: self }\n    }\n}\n\n// Conversion into an iterator (what a `for` loop iterates over).\ntrait IntoIterator {\n    type Item;\n    type IntoIter;\n\n    #[fresh]\n    fn into_iter(self) -> Self::IntoIter;\n}\n\n// Building a collection from an iterator (`collect`).\ntrait FromIterator<A> {\n    #[fresh]\n    fn from_iter<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\ntrait Sum<A> {\n    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\ntrait Product<A> {\n    fn product<I: Iterator<Item = A>>(iter: I) -> Self;\n}\n\n// __Pair is what unzip accepts: a pair (A, B).\ntrait __Pair {\n    type First;\n    type Second;\n\n    fn __split(self) -> (Self::First, Self::Second);\n}\n\nimpl<A, B> __Pair for (A, B) {\n    type First = A;\n    type Second = B;\n\n    fn __split(self) -> (A, B) {\n        self\n    }\n}\n\n// __Try is what try_fold and try_for_each accept from their closure:\n// Option and Result (Rust's unstable Try trait). __output is the value to\n// continue with, or None to stop and return the value itself.\ntrait __Try {\n    type Output;\n\n    fn __output(&self) -> Option<Self::Output>;\n\n    fn __from_output(x: Self::Output) -> Self;\n}\n\nimpl<T> __Try for Option<T> {\n    type Output = T;\n\n    fn __output(&self) -> Option<T> {\n        *self\n    }\n\n    fn __from_output(x: T) -> Option<T> {\n        Some(x)\n    }\n}\n\nimpl<T, E> __Try for Result<T, E> {\n    type Output = T;\n\n    fn __output(&self) -> Option<T> {\n        match *self {\n            Ok(x) => Some(x),\n            Err(_) => None,\n        }\n    }\n\n    fn __from_output(x: T) -> Result<T, E> {\n        Ok(x)\n    }\n}\n\n// ---- adapters ----\n\nstruct Map<I, A, B> {\n    iter: I,\n    f: fn(A) -> B,\n}\n\nimpl<I: Iterator<Item = A>, A, B> Iterator for Map<I, A, B> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        match self.iter.next() {\n            Some(x) => Some((self.f)(x)),\n            None => None,\n        }\n    }\n}\n\nstruct Filter<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for Filter<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        while let Some(x) = self.iter.next() {\n            if (self.p)(x) {\n                return Some(x);\n            }\n        }\n        None\n    }\n}\n\nstruct FilterMap<I, A, B> {\n    iter: I,\n    f: fn(A) -> Option<B>,\n}\n\nimpl<I: Iterator<Item = A>, A, B> Iterator for FilterMap<I, A, B> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        while let Some(x) = self.iter.next() {\n            match (self.f)(x) {\n                Some(y) => {\n                    return Some(y);\n                }\n                None => {}\n            }\n        }\n        None\n    }\n}\n\nstruct Enumerate<I> {\n    iter: I,\n    mut i: Int,\n}\n\nimpl<I: Iterator> Iterator for Enumerate<I> {\n    type Item = (Int, I::Item);\n\n    fn next(&mut self) -> Option<(Int, I::Item)> {\n        match self.iter.next() {\n            Some(x) => {\n                let i = self.i;\n                self.i = i + 1;\n                Some((i, x))\n            }\n            None => None,\n        }\n    }\n}\n\nstruct Zip<A, B> {\n    a: A,\n    b: B,\n}\n\nimpl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {\n    type Item = (A::Item, B::Item);\n\n    fn next(&mut self) -> Option<(A::Item, B::Item)> {\n        match self.a.next() {\n            Some(x) => match self.b.next() {\n                Some(y) => Some((x, y)),\n                None => None,\n            },\n            None => None,\n        }\n    }\n}\n\nstruct Chain<A, B> {\n    a: A,\n    b: B,\n    mut first: Bool,\n}\n\nimpl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {\n    type Item = A::Item;\n\n    fn next(&mut self) -> Option<A::Item> {\n        if self.first {\n            match self.a.next() {\n                Some(x) => {\n                    return Some(x);\n                }\n                None => {\n                    self.first = false;\n                }\n            }\n        }\n        self.b.next()\n    }\n}\n\nstruct Take<I> {\n    iter: I,\n    mut n: Int,\n}\n\nimpl<I: Iterator> Iterator for Take<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.n <= 0 {\n            return None;\n        }\n        self.n = self.n - 1;\n        self.iter.next()\n    }\n}\n\nstruct Skip<I> {\n    iter: I,\n    mut n: Int,\n}\n\nimpl<I: Iterator> Iterator for Skip<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        while self.n > 0 {\n            self.n = self.n - 1;\n            if self.iter.next().is_none() {\n                return None;\n            }\n        }\n        self.iter.next()\n    }\n}\n\nstruct TakeWhile<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n    mut done: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for TakeWhile<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.done {\n            return None;\n        }\n        match self.iter.next() {\n            Some(x) => {\n                if (self.p)(x) {\n                    return Some(x);\n                }\n                self.done = true;\n                None\n            }\n            None => None,\n        }\n    }\n}\n\nstruct SkipWhile<I, A> {\n    iter: I,\n    p: fn(A) -> Bool,\n    mut started: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for SkipWhile<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.started {\n            return self.iter.next();\n        }\n        while let Some(x) = self.iter.next() {\n            if !(self.p)(x) {\n                self.started = true;\n                return Some(x);\n            }\n        }\n        None\n    }\n}\n\nstruct StepBy<I> {\n    iter: I,\n    step: Int,\n    mut first: Bool,\n}\n\nimpl<I: Iterator> Iterator for StepBy<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.first {\n            self.first = false;\n            return self.iter.next();\n        }\n        self.iter.nth(self.step - 1)\n    }\n}\n\nstruct Peekable<I, A> {\n    iter: I,\n    mut peeked: Option<A>,\n    mut has: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A> Peekable<I, A> {\n    // peek returns the next element without consuming it.\n    fn peek(&mut self) -> Option<A> {\n        if !self.has {\n            self.peeked = self.iter.next();\n            self.has = true;\n        }\n        self.peeked\n    }\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for Peekable<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.has {\n            self.has = false;\n            return self.peeked;\n        }\n        self.iter.next()\n    }\n}\n\nstruct FlatMap<I, A, U, J> {\n    iter: I,\n    f: fn(A) -> U,\n    mut cur: Option<J>,\n}\n\nimpl<I: Iterator<Item = A>, A, U: IntoIterator<IntoIter = J>, J: Iterator> Iterator for FlatMap<I, A, U, J> {\n    type Item = J::Item;\n\n    fn next(&mut self) -> Option<J::Item> {\n        loop {\n            match self.cur {\n                Some(mut inner) => match inner.next() {\n                    Some(x) => {\n                        return Some(x);\n                    }\n                    None => {\n                        self.cur = None;\n                    }\n                },\n                None => {}\n            }\n            match self.iter.next() {\n                Some(x) => {\n                    self.cur = Some((self.f)(x).into_iter());\n                }\n                None => {\n                    return None;\n                }\n            }\n        }\n    }\n}\n\nstruct Scan<I, A, St, B> {\n    iter: I,\n    mut state: St,\n    f: fn(St, A) -> Option<(St, B)>,\n    mut done: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A, St, B> Iterator for Scan<I, A, St, B> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        if self.done {\n            return None;\n        }\n        match self.iter.next() {\n            Some(x) => match (self.f)(self.state, x) {\n                Some((st, y)) => {\n                    self.state = st;\n                    Some(y)\n                }\n                None => {\n                    self.done = true;\n                    None\n                }\n            },\n            None => None,\n        }\n    }\n}\n\nstruct Inspect<I, A> {\n    iter: I,\n    f: fn(A),\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for Inspect<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        match self.iter.next() {\n            Some(x) => {\n                (self.f)(x);\n                Some(x)\n            }\n            None => None,\n        }\n    }\n}\n\nstruct MapWhile<I, A, B> {\n    iter: I,\n    f: fn(A) -> Option<B>,\n    mut done: Bool,\n}\n\nimpl<I: Iterator<Item = A>, A, B> Iterator for MapWhile<I, A, B> {\n    type Item = B;\n\n    fn next(&mut self) -> Option<B> {\n        if self.done {\n            return None;\n        }\n        match self.iter.next() {\n            Some(x) => {\n                let y = (self.f)(x);\n                if y.is_none() {\n                    self.done = true;\n                }\n                y\n            }\n            None => None,\n        }\n    }\n}\n\nstruct Fuse<I> {\n    iter: I,\n    mut done: Bool,\n}\n\nimpl<I: Iterator> Iterator for Fuse<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        if self.done {\n            return None;\n        }\n        let x = self.iter.next();\n        if x.is_none() {\n            self.done = true;\n        }\n        x\n    }\n}\n\nstruct Cycle<I, A> {\n    iter: I,\n    mut buf: Vec<A>,\n    mut first: Bool,\n    mut i: Int,\n}\n\nimpl<I: Iterator<Item = A>, A> Iterator for Cycle<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        if self.first {\n            match self.iter.next() {\n                Some(x) => {\n                    self.buf.push(x);\n                    return Some(x);\n                }\n                None => {\n                    self.first = false;\n                }\n            }\n        }\n        let n = self.buf.len();\n        if n == 0 {\n            return None;\n        }\n        if self.i >= n {\n            self.i = 0;\n        }\n        let x = self.buf.get(self.i);\n        self.i = self.i + 1;\n        x\n    }\n}\n\nstruct Cloned<I, A> {\n    __iter: I,\n    __item: Option<A>,\n}\n\nimpl<I: Iterator<Item = A>, A: Clone> Iterator for Cloned<I, A> {\n    type Item = A;\n\n    fn next(&mut self) -> Option<A> {\n        match self.__iter.next() {\n            Some(x) => Some(x.clone()),\n            None => None,\n        }\n    }\n}\n\nstruct Rev<I> {\n    iter: I,\n}\n\nimpl<I: DoubleEndedIterator> Iterator for Rev<I> {\n    type Item = I::Item;\n\n    fn next(&mut self) -> Option<I::Item> {\n        self.iter.next_back()\n    }\n}\n\n// ---- ranges ----\n\n// `start..end`: the integers from start up to (excluding) end.\nstruct Range {\n    mut start: Int,\n    mut end: Int,\n}\n\nimpl Range {\n    fn contains(&self, x: Int) -> Bool {\n        self.start <= x && x < self.end\n    }\n\n    fn len(&self) -> Int {\n        if self.end > self.start {\n            self.end - self.start\n        } else {\n            0\n        }\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.start >= self.end\n    }\n}\n\nimpl Iterator for Range {\n    type Item = Int;\n\n    fn next(&mut self) -> Option<Int> {\n        if self.start < self.end {\n            let x = self.start;\n            self.start = x + 1;\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\nimpl DoubleEndedIterator for Range {\n    fn next_back(&mut self) -> Option<Int> {\n        if self.start < self.end {\n            self.end = self.end - 1;\n            Some(self.end)\n        } else {\n            None\n        }\n    }\n}\n\n// `start..=end`: the integers from start up to (including) end.\nstruct RangeInclusive {\n    mut start: Int,\n    mut end: Int,\n}\n\nimpl RangeInclusive {\n    fn contains(&self, x: Int) -> Bool {\n        self.start <= x && x <= self.end\n    }\n}\n\nimpl Iterator for RangeInclusive {\n    type Item = Int;\n\n    fn next(&mut self) -> Option<Int> {\n        if self.start <= self.end {\n            let x = self.start;\n            if x == self.end {\n                // stop without overflowing at the largest Int\n                self.end = x - 1;\n                self.start = x;\n            } else {\n                self.start = x + 1;\n            }\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\nimpl DoubleEndedIterator for RangeInclusive {\n    fn next_back(&mut self) -> Option<Int> {\n        if self.start <= self.end {\n            let x = self.end;\n            if x == self.start {\n                self.start = x + 1;\n                self.end = x;\n            } else {\n                self.end = x - 1;\n            }\n            Some(x)\n        } else {\n            None\n        }\n    }\n}\n\n// ---- Vec ----\n\n// Iter iterates over a Vec by index. Like a `for` loop over a Vec, it sees\n// elements pushed while iterating.\nstruct Iter<T> {\n    v: Vec<T>,\n    mut i: Int,\n    mut end: Int,\n}\n\nimpl<T> Vec<T> {\n    #[fresh]\n    fn iter(&self) -> Iter<T> {\n        Iter { v: *self, i: 0, end: -1 }\n    }\n\n    // `v[i] = x` is `v.__index_set(i, x)`: the bounds are proved as for\n    // reading `v[i]` (and checked at run time: out of bounds traps).\n    fn __index_set(&mut self, i: Int, x: T)\n    where\n        0 <= i,\n        i < self.len(),\n    {\n        if !self.set(i, x) {\n            let _ = self[i];\n        }\n    }\n}\n\nimpl<T> Iterator for Iter<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        let n = if self.end < 0 { self.v.len() } else { self.end };\n        if self.i < n {\n            let x = self.v.get(self.i);\n            self.i = self.i + 1;\n            x\n        } else {\n            None\n        }\n    }\n}\n\nimpl<T> DoubleEndedIterator for Iter<T> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.end < 0 {\n            self.end = self.v.len();\n        }\n        if self.i < self.end {\n            self.end = self.end - 1;\n            self.v.get(self.end)\n        } else {\n            None\n        }\n    }\n}\n\nimpl<T> IntoIterator for Vec<T> {\n    type Item = T;\n    type IntoIter = Iter<T>;\n\n    fn into_iter(self) -> Iter<T> {\n        self.iter()\n    }\n}\n\nimpl<T> FromIterator<T> for Vec<T> {\n    fn from_iter<I: Iterator<Item = T>>(mut iter: I) -> Vec<T> {\n        let mut v = Vec::new();\n        while let Some(x) = iter.next() {\n            v.push(x);\n        }\n        v\n    }\n}\n\nimpl FromIterator<String> for String {\n    fn from_iter<I: Iterator<Item = String>>(mut iter: I) -> String {\n        let mut parts = Vec::new();\n        while let Some(s) = iter.next() {\n            parts.push(s);\n        }\n        parts.join(\"\")\n    }\n}\n\nimpl Sum<Int> for Int {\n    fn sum<I: Iterator<Item = Int>>(mut iter: I) -> Int {\n        let mut s = 0;\n        while let Some(x) = iter.next() {\n            s = s + x;\n        }\n        s\n    }\n}\n\nimpl Product<Int> for Int {\n    fn product<I: Iterator<Item = Int>>(mut iter: I) -> Int {\n        let mut p = 1;\n        while let Some(x) = iter.next() {\n            p = p * x;\n        }\n        p\n    }\n}\n\n// collect of code points (`Int`, what `chars()` yields) into a String.\n// Code points above U+FFFF become surrogate pairs; what is not a Unicode\n// scalar value (negative, a surrogate, above U+10FFFF) becomes U+FFFD.\nimpl FromIterator<Int> for String {\n    fn from_iter<I: Iterator<Item = Int>>(mut iter: I) -> String {\n        let mut parts = Vec::new();\n        while let Some(c) = iter.next() {\n            if c < 0 || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF) {\n                parts.push(String::from_char(0xFFFD));\n            } else if c >= 0x10000 {\n                let u = c - 0x10000;\n                parts.push(String::from_char(0xD800 + (u >> 10)));\n                parts.push(String::from_char(0xDC00 + (u & 0x3FF)));\n            } else {\n                parts.push(String::from_char(c));\n            }\n        }\n        parts.join(\"\")\n    }\n}\n\n// collect into Option<C>: None at the first None, else Some of the\n// collection of the values.\nimpl<A, C: FromIterator<A>> FromIterator<Option<A>> for Option<C> {\n    fn from_iter<I: Iterator<Item = Option<A>>>(mut iter: I) -> Option<C> {\n        let mut v = Vec::new();\n        while let Some(x) = iter.next() {\n            match x {\n                Some(a) => v.push(a),\n                None => {\n                    return None;\n                }\n            }\n        }\n        Some(C::from_iter(v.iter()))\n    }\n}\n\n// collect into Result<C, E>: the first Err, else Ok of the collection.\nimpl<A, E, C: FromIterator<A>> FromIterator<Result<A, E>> for Result<C, E> {\n    fn from_iter<I: Iterator<Item = Result<A, E>>>(mut iter: I) -> Result<C, E> {\n        let mut v = Vec::new();\n        while let Some(x) = iter.next() {\n            match x {\n                Ok(a) => v.push(a),\n                Err(e) => {\n                    return Err(e);\n                }\n            }\n        }\n        Ok(C::from_iter(v.iter()))\n    }\n}\n\nimpl<A, S: Sum<A>> Sum<Option<A>> for Option<S> {\n    fn sum<I: Iterator<Item = Option<A>>>(iter: I) -> Option<S> {\n        let o: Option<Vec<A>> = iter.collect();\n        match o {\n            Some(v) => Some(S::sum(v.iter())),\n            None => None,\n        }\n    }\n}\n\nimpl<A, E, S: Sum<A>> Sum<Result<A, E>> for Result<S, E> {\n    fn sum<I: Iterator<Item = Result<A, E>>>(iter: I) -> Result<S, E> {\n        let r: Result<Vec<A>, E> = iter.collect();\n        match r {\n            Ok(v) => Ok(S::sum(v.iter())),\n            Err(e) => Err(e),\n        }\n    }\n}\n\nimpl<A, P: Product<A>> Product<Option<A>> for Option<P> {\n    fn product<I: Iterator<Item = Option<A>>>(iter: I) -> Option<P> {\n        let o: Option<Vec<A>> = iter.collect();\n        match o {\n            Some(v) => Some(P::product(v.iter())),\n            None => None,\n        }\n    }\n}\n\nimpl<A, E, P: Product<A>> Product<Result<A, E>> for Result<P, E> {\n    fn product<I: Iterator<Item = Result<A, E>>>(iter: I) -> Result<P, E> {\n        let r: Result<Vec<A>, E> = iter.collect();\n        match r {\n            Ok(v) => Ok(P::product(v.iter())),\n            Err(e) => Err(e),\n        }\n    }\n}\n\n// Option iterates over its value (if any), so that flatten and flat_map\n// accept it.\nimpl<T> IntoIterator for Option<T> {\n    type Item = T;\n    type IntoIter = Iter<T>;\n\n    fn into_iter(self) -> Iter<T> {\n        self.iter()\n    }\n}\n\nimpl<T, E> IntoIterator for Result<T, E> {\n    type Item = T;\n    type IntoIter = Iter<T>;\n\n    fn into_iter(self) -> Iter<T> {\n        self.iter()\n    }\n}\n",
    );
    core_file(
        v,
        "json.kek",
        "// JSON (RFC 8259) for Value (lib/core/serde.kek).\n//\n//   Json::parse(s) -> Result<Value, SerdeError>\n//   Json::render(&v) / Json::render_pretty(&v) -> String\n//   Json::from_str::<T>(s) -> Result<T, SerdeError>\n//   Json::to_string(&x) / Json::to_string_pretty(&x) -> String\n//\n// Numbers with a fraction or an exponent become Value::Float (correctly\n// rounded; out of range is an error), the others Value::Int. A Float is\n// written with the shortest digits that read back the same, always with a\n// fraction or an exponent (`1.0`, `0.1`, `1e21`), and NaN and the\n// infinities (which JSON lacks) as null, like JavaScript;\n// integers outside the 64-bit range are an error. Objects keep the order\n// of their keys; a repeated key is an error. Nesting is limited to 256\n// levels.\n\nstruct Json {}\n\nimpl Json {\n    fn parse(s: String) -> Result<Value, SerdeError> {\n        let mut p = __JsonParser { s: s, n: s.len(), i: 0 };\n        p.ws();\n        let v = p.value(0)?;\n        p.ws();\n        if p.i < p.n {\n            return Err(p.fail(\"unexpected data after the value\"));\n        }\n        Ok(v)\n    }\n\n    fn render(v: &Value) -> String {\n        let mut out = Vec::new();\n        __json_render(&mut out, v, -1, 0);\n        out.join(\"\")\n    }\n\n    // render_pretty indents by two spaces.\n    fn render_pretty(v: &Value) -> String {\n        let mut out = Vec::new();\n        __json_render(&mut out, v, 0, 0);\n        out.join(\"\")\n    }\n\n    fn from_str<T: Deserialize>(s: String) -> Result<T, SerdeError> {\n        T::from_value(&Json::parse(s)?)\n    }\n\n    fn to_string<T: Serialize>(x: &T) -> String {\n        Json::render(&x.to_value())\n    }\n\n    fn to_string_pretty<T: Serialize>(x: &T) -> String {\n        Json::render_pretty(&x.to_value())\n    }\n}\n\n// indent < 0 renders on one line.\nfn __json_render(mut out: Vec<String>, v: &Value, indent: Int, depth: Int) {\n    match v {\n        Value::Null => out.push(\"null\"),\n        Value::Bool(b) => out.push(if b { \"true\" } else { \"false\" }),\n        Value::Int(n) => out.push(n.to_string()),\n        Value::Float(f) => out.push(__json_float(f)),\n        Value::Str(s) => out.push(__serde_quote(s)),\n        Value::Seq(xs) => {\n            if xs.len() == 0 {\n                out.push(\"[]\");\n                return;\n            }\n            out.push(\"[\");\n            let mut first = true;\n            for x in xs.iter() {\n                if !first {\n                    out.push(\",\");\n                }\n                first = false;\n                __json_newline(out, indent, depth + 1);\n                __json_render(out, x, indent, depth + 1);\n            }\n            __json_newline(out, indent, depth);\n            out.push(\"]\");\n        }\n        Value::Map(es) => {\n            if es.len() == 0 {\n                out.push(\"{}\");\n                return;\n            }\n            out.push(\"{\");\n            let mut first = true;\n            for e in es.iter() {\n                if !first {\n                    out.push(\",\");\n                }\n                first = false;\n                __json_newline(out, indent, depth + 1);\n                out.push(__serde_quote(e.0));\n                out.push(if indent < 0 { \":\" } else { \": \" });\n                __json_render(out, &e.1, indent, depth + 1);\n            }\n            __json_newline(out, indent, depth);\n            out.push(\"}\");\n        }\n    }\n}\n\n// __json_float is a float in JSON's syntax: TOML's inf and nan have no\n// JSON form and become null (as in JavaScript), a leading `+` is dropped.\nfn __json_float(f: Float) -> String {\n    if !f.is_finite() {\n        return \"null\";\n    }\n    __flt_debug(f.to_bits())\n}\n\nfn __json_newline(mut out: Vec<String>, indent: Int, depth: Int) {\n    if indent >= 0 {\n        out.push(\"\\n\");\n        for _ in 0..depth {\n            out.push(\"  \");\n        }\n    }\n}\n\nstruct __JsonParser {\n    s: String,\n    n: Int,\n    mut i: Int,\n}\n\nimpl __JsonParser {\n    fn peek(&self) -> Int {\n        if self.i < self.n {\n            self.s.char_at(self.i).unwrap_or(-1)\n        } else {\n            -1\n        }\n    }\n\n    fn fail(&self, msg: String) -> SerdeError {\n        __serde_at(self.s, self.i, msg)\n    }\n\n    fn ws(&mut self) {\n        while self.i < self.n {\n            let c = self.peek();\n            if c == 32 || c == 9 || c == 10 || c == 13 {\n                self.i = self.i + 1;\n            } else {\n                return;\n            }\n        }\n    }\n\n    fn word(&mut self, w: String, v: Value) -> Result<Value, SerdeError> {\n        if self.s.slice(self.i, self.i + w.len()) == w {\n            self.i = self.i + w.len();\n            Ok(v)\n        } else {\n            Err(self.fail(\"unexpected character\"))\n        }\n    }\n\n    fn value(&mut self, depth: Int) -> Result<Value, SerdeError> {\n        if depth > 256 {\n            return Err(self.fail(\"nested too deeply\"));\n        }\n        let c = self.peek();\n        if c == 123 {\n            return self.object(depth);\n        }\n        if c == 91 {\n            return self.array(depth);\n        }\n        if c == 34 {\n            return Ok(Value::Str(self.string()?));\n        }\n        if c == 116 {\n            return self.word(\"true\", Value::Bool(true));\n        }\n        if c == 102 {\n            return self.word(\"false\", Value::Bool(false));\n        }\n        if c == 110 {\n            return self.word(\"null\", Value::Null);\n        }\n        if c == 45 || (c >= 48 && c <= 57) {\n            return self.number();\n        }\n        if c < 0 {\n            return Err(self.fail(\"unexpected end of input\"));\n        }\n        Err(self.fail(\"unexpected character\"))\n    }\n\n    fn digits(&mut self) -> Int {\n        let start = self.i;\n        while self.peek() >= 48 && self.peek() <= 57 {\n            self.i = self.i + 1;\n        }\n        self.i - start\n    }\n\n    fn number(&mut self) -> Result<Value, SerdeError> {\n        let start = self.i;\n        if self.peek() == 45 {\n            self.i = self.i + 1;\n        }\n        let int_start = self.i;\n        let nd = self.digits();\n        if nd == 0 {\n            return Err(self.fail(\"expected a digit\"));\n        }\n        if nd > 1 && self.s.char_at(int_start).unwrap_or(0) == 48 {\n            return Err(__serde_at(self.s, int_start, \"leading zero in a number\"));\n        }\n        let mut float = false;\n        if self.peek() == 46 {\n            self.i = self.i + 1;\n            if self.digits() == 0 {\n                return Err(self.fail(\"expected a digit after the decimal point\"));\n            }\n            float = true;\n        }\n        if self.peek() == 101 || self.peek() == 69 {\n            self.i = self.i + 1;\n            if self.peek() == 43 || self.peek() == 45 {\n                self.i = self.i + 1;\n            }\n            if self.digits() == 0 {\n                return Err(self.fail(\"expected a digit in the exponent\"));\n            }\n            float = true;\n        }\n        let text = self.s.slice(start, self.i);\n        if float {\n            return match __flt_parse(text) {\n                Some(b) => {\n                    if b.bit_and(9223372036854775807) == 9218868437227405312 {\n                        Err(__serde_at(self.s, start, \"number out of range\"))\n                    } else {\n                        Ok(Value::Float(Float::from_bits(b)))\n                    }\n                }\n                None => Err(__serde_at(self.s, start, \"invalid number\")),\n            };\n        }\n        match text.parse_int() {\n            Some(n) => Ok(Value::Int(n)),\n            None => Err(__serde_at(self.s, start, \"integer out of range\")),\n        }\n    }\n\n    fn string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 1;\n        let mut parts = Vec::new();\n        let mut start = self.i;\n        while true {\n            if self.i >= self.n {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            let c = self.peek();\n            if c == 34 {\n                parts.push(self.s.slice(start, self.i));\n                self.i = self.i + 1;\n                return Ok(parts.join(\"\"));\n            }\n            if c < 32 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            if c == 92 {\n                parts.push(self.s.slice(start, self.i));\n                self.i = self.i + 1;\n                let e = self.peek();\n                if e == 34 {\n                    parts.push(\"\\\"\");\n                } else if e == 92 {\n                    parts.push(\"\\\\\");\n                } else if e == 47 {\n                    parts.push(\"/\");\n                } else if e == 98 {\n                    parts.push(String::from_char(8));\n                } else if e == 102 {\n                    parts.push(String::from_char(12));\n                } else if e == 110 {\n                    parts.push(\"\\n\");\n                } else if e == 114 {\n                    parts.push(\"\\r\");\n                } else if e == 116 {\n                    parts.push(\"\\t\");\n                } else if e == 117 {\n                    let mut x = 0;\n                    for k in 1..5 {\n                        let d = __serde_hex_value(self.s.char_at(self.i + k).unwrap_or(0));\n                        if d < 0 {\n                            return Err(self.fail(\"bad \\\\u escape\"));\n                        }\n                        x = x * 16 + d;\n                    }\n                    // surrogate halves are code units: two escapes make a pair\n                    parts.push(String::from_char(x));\n                    self.i = self.i + 4;\n                } else {\n                    return Err(self.fail(\"bad escape\"));\n                }\n                self.i = self.i + 1;\n                start = self.i;\n            } else {\n                self.i = self.i + 1;\n            }\n        }\n        Err(self.fail(\"unexpected end of input\"))\n    }\n\n    fn array(&mut self, depth: Int) -> Result<Value, SerdeError> {\n        self.i = self.i + 1;\n        let mut out = Vec::new();\n        self.ws();\n        if self.peek() == 93 {\n            self.i = self.i + 1;\n            return Ok(Value::Seq(out));\n        }\n        while true {\n            self.ws();\n            out.push(self.value(depth + 1)?);\n            self.ws();\n            let c = self.peek();\n            self.i = self.i + 1;\n            if c == 93 {\n                return Ok(Value::Seq(out));\n            }\n            if c != 44 {\n                self.i = self.i - 1;\n                return Err(self.fail(\"expected `,` or `]`\"));\n            }\n        }\n        Err(self.fail(\"unexpected end of input\"))\n    }\n\n    fn object(&mut self, depth: Int) -> Result<Value, SerdeError> {\n        self.i = self.i + 1;\n        let mut out = Vec::new();\n        let mut seen = HashSet::new();\n        self.ws();\n        if self.peek() == 125 {\n            self.i = self.i + 1;\n            return Ok(Value::Map(out));\n        }\n        while true {\n            self.ws();\n            if self.peek() != 34 {\n                return Err(self.fail(\"expected a string key\"));\n            }\n            let at = self.i;\n            let k = self.string()?;\n            if !seen.insert(k) {\n                return Err(__serde_at(self.s, at, \"duplicate key\"));\n            }\n            self.ws();\n            if self.peek() != 58 {\n                return Err(self.fail(\"expected `:`\"));\n            }\n            self.i = self.i + 1;\n            self.ws();\n            let v = self.value(depth + 1)?;\n            out.push((k, v));\n            self.ws();\n            let c = self.peek();\n            self.i = self.i + 1;\n            if c == 125 {\n                return Ok(Value::Map(out));\n            }\n            if c != 44 {\n                self.i = self.i - 1;\n                return Err(self.fail(\"expected `,` or `}`\"));\n            }\n        }\n        Err(self.fail(\"unexpected end of input\"))\n    }\n}\n",
    );
    core_file(
        v,
        "labeled.kek",
        "// Information flow (docs/authz-flow.md): a value labeled L, such as\n// personal data (`Labeled<PII, String>`), cannot reach an output that\n// takes plain values: a log, a response, the store, the network, an error\n// message.\n//\n// The field is private to the core library: identifiers starting with\n// `__` are reserved for the core library and the runtime prelude, so a\n// program can neither read `__value` nor build `Labeled { ... }`. Labeled\n// implements no trait that renders, compares, orders or hashes it, so it\n// cannot reach an output through `+`, `to_string`, `==`, a capability\n// argument or a generic function.\n//\n// Computing on the contents happens only inside the closures given to map,\n// zip and and_then, whose results are labeled again: a branch on a labeled\n// value can only be taken there (the \"program counter\" carries the label).\n// The type checker makes these closures unable to leak by side effects:\n// they take the contents as shared (read-only) values and capture no\n// mutable state and no function values (closures cannot capture\n// capabilities anyway). So a program that does not declassify satisfies\n// non-interference: its plain outputs do not depend on labeled inputs\n// (lean/Kekkai/Flow.lean).\n//\n// The only ways out are the declassifications below, which `kek caps`\n// lists and `kek assure` records (flow.declassify):\n//\n//   p.mask()              Labeled<L, String> -> String, for display\n//   p.hash()              a fixed (unseeded) hash as 16 hex digits\n//   p.expose_unchecked()  the value itself (the escape hatch)\n\n// PII labels personal data.\nstruct PII {}\n\nimpl PII {\n    // label labels x as personal data.\n    fn label<T>(x: T) -> Labeled<PII, T> {\n        Labeled { __value: x }\n    }\n}\n\nstruct Labeled<L, T> {\n    __value: T,\n}\n\nimpl<L, T> Labeled<L, T> {\n    // new labels x (the label comes from the expected type:\n    // `let e: Labeled<PII, String> = Labeled::new(s)`).\n    fn new(x: T) -> Labeled<L, T> {\n        Labeled { __value: x }\n    }\n\n    // map computes on the contents; the result keeps the label.\n    fn map<U>(&self, f: fn(&T) -> U) -> Labeled<L, U> {\n        Labeled { __value: f(&self.__value) }\n    }\n\n    // zip combines two values of the same label.\n    fn zip<U, V>(&self, other: &Labeled<L, U>, f: fn(&T, &U) -> V) -> Labeled<L, V> {\n        Labeled { __value: f(&self.__value, &other.__value) }\n    }\n\n    // and_then computes a labeled value from the contents.\n    fn and_then<U>(&self, f: fn(&T) -> Labeled<L, U>) -> Labeled<L, U> {\n        f(&self.__value)\n    }\n\n    // expose_unchecked returns the value: a declassification.\n    fn expose_unchecked(&self) -> T {\n        self.__value\n    }\n}\n\nimpl<L, T: Hash> Labeled<L, T> {\n    // hash is the default hasher's (fixed, unseeded) hash of the value, as\n    // 16 lowercase hex digits: a declassification that keeps equality (to\n    // join or count records) but not the value.\n    fn hash(&self) -> String {\n        let mut h = DefaultHasher::new();\n        self.__value.hash(&mut h);\n        __labeled_hex(h.finish())\n    }\n}\n\nimpl<L> Labeled<L, String> {\n    // mask keeps the first character and everything from the last `@` on\n    // (the domain of an e-mail address) and replaces every other\n    // character (code point) by `*`: \"alice@example.com\" ->\n    // \"a****@example.com\", \"bob\" -> \"b**\". When the part before the `@` is\n    // a single character it is masked too (\"a@x.com\" -> \"*@x.com\", \"x\" ->\n    // \"*\"), and \"\" stays \"\".\n    fn mask(&self) -> String {\n        let s = self.__value;\n        if s.len() == 0 {\n            return \"\";\n        }\n        let cs = s.split(\"\");\n        let n = cs.len();\n        let mut at = n;\n        let mut i = 0;\n        while i < n {\n            if cs.get(i).unwrap_or(\"\") == \"@\" {\n                at = i;\n            }\n            i = i + 1;\n        }\n        let mut parts = Vec::new();\n        for j in 0..at {\n            if j == 0 && at > 1 {\n                parts.push(cs.get(0).unwrap_or(\"\"));\n            } else {\n                parts.push(\"*\");\n            }\n        }\n        for j in at..n {\n            parts.push(cs.get(j).unwrap_or(\"\"));\n        }\n        parts.join(\"\")\n    }\n}\n\nimpl<L, T: Clone> Clone for Labeled<L, T> {\n    fn clone(&self) -> Labeled<L, T> {\n        Labeled { __value: self.__value.clone() }\n    }\n}\n\n// __labeled_hex renders x as 16 lowercase hex digits (two's complement).\nfn __labeled_hex(x: Int) -> String {\n    let digits = \"0123456789abcdef\";\n    let mut parts = Vec::new();\n    let mut i = 15;\n    while i >= 0 {\n        let d = x.ushr(i * 4).bit_and(15);\n        parts.push(digits.slice(d, d + 1));\n        i = i - 1;\n    }\n    parts.join(\"\")\n}\n",
    );
    core_file(
        v,
        "ops.kek",
        "// Operator overloading, as in Rust's core::ops: `a + b` on a type that is\n// not Int (or String for `+`) calls `Add::add(a, b)`, and likewise `-`\n// (Sub), `*` (Mul), `/` (Div), `%` (Rem) and unary `-` (Neg). The\n// right-hand side type is the trait's parameter; written without it\n// (`impl Add for Point`, `T: Add<Output = T>`) it is Self, as Rust's\n// default `Rhs = Self`.\n//\n//   impl Add for Point {\n//       type Output = Point;\n//       fn add(self, rhs: Point) -> Point { Point { x: self.x + rhs.x, y: self.y + rhs.y } }\n//   }\n//\n// Int implements them all (Add also String), so generic code can use them.\n\ntrait Add<Rhs> {\n    type Output;\n    fn add(self, rhs: Rhs) -> Self::Output;\n}\n\ntrait Sub<Rhs> {\n    type Output;\n    fn sub(self, rhs: Rhs) -> Self::Output;\n}\n\ntrait Mul<Rhs> {\n    type Output;\n    fn mul(self, rhs: Rhs) -> Self::Output;\n}\n\ntrait Div<Rhs> {\n    type Output;\n    fn div(self, rhs: Rhs) -> Self::Output;\n}\n\ntrait Rem<Rhs> {\n    type Output;\n    fn rem(self, rhs: Rhs) -> Self::Output;\n}\n\ntrait Neg {\n    type Output;\n    fn neg(self) -> Self::Output;\n}\n\nimpl Add<Int> for Int {\n    type Output = Int;\n\n    fn add(self, rhs: Int) -> Int {\n        self + rhs\n    }\n}\n\nimpl Sub<Int> for Int {\n    type Output = Int;\n\n    fn sub(self, rhs: Int) -> Int {\n        self - rhs\n    }\n}\n\nimpl Mul<Int> for Int {\n    type Output = Int;\n\n    fn mul(self, rhs: Int) -> Int {\n        self * rhs\n    }\n}\n\nimpl Div<Int> for Int {\n    type Output = Int;\n\n    fn div(self, rhs: Int) -> Int {\n        self / rhs\n    }\n}\n\nimpl Rem<Int> for Int {\n    type Output = Int;\n\n    fn rem(self, rhs: Int) -> Int {\n        self % rhs\n    }\n}\n\nimpl Neg for Int {\n    type Output = Int;\n\n    fn neg(self) -> Int {\n        -self\n    }\n}\n\nimpl Add<String> for String {\n    type Output = String;\n\n    fn add(self, rhs: String) -> String {\n        self + rhs\n    }\n}\n",
    );
    core_file(
        v,
        "option.kek",
        "// Methods of Option and Result, as in Rust's core::option and\n// core::result (`is_some`, `is_ok` and `unwrap_or` are builtins). There is\n// no `unwrap` or `expect`: a missing value is handled, not a panic.\n\nimpl<T> Option<T> {\n    fn map<U>(self, f: impl Fn(T) -> U) -> Option<U> {\n        match self {\n            Some(x) => Some(f(x)),\n            None => None,\n        }\n    }\n\n    fn and_then<U>(self, f: impl Fn(T) -> Option<U>) -> Option<U> {\n        match self {\n            Some(x) => f(x),\n            None => None,\n        }\n    }\n\n    fn and<U>(self, other: Option<U>) -> Option<U> {\n        match self {\n            Some(_) => other,\n            None => None,\n        }\n    }\n\n    fn or(self, other: Option<T>) -> Option<T> {\n        match self {\n            Some(x) => Some(x),\n            None => other,\n        }\n    }\n\n    fn or_else(self, f: impl Fn() -> Option<T>) -> Option<T> {\n        match self {\n            Some(x) => Some(x),\n            None => f(),\n        }\n    }\n\n    fn xor(self, other: Option<T>) -> Option<T> {\n        match self {\n            Some(x) => match other {\n                Some(_) => None,\n                None => Some(x),\n            },\n            None => other,\n        }\n    }\n\n    fn filter(self, p: impl Fn(&T) -> Bool) -> Option<T> {\n        match self {\n            Some(x) => if p(&x) { Some(x) } else { None },\n            None => None,\n        }\n    }\n\n    fn unwrap_or_else(self, f: impl Fn() -> T) -> T {\n        match self {\n            Some(x) => x,\n            None => f(),\n        }\n    }\n\n    fn map_or<U>(self, default: U, f: impl Fn(T) -> U) -> U {\n        match self {\n            Some(x) => f(x),\n            None => default,\n        }\n    }\n\n    fn map_or_else<U>(self, default: impl Fn() -> U, f: impl Fn(T) -> U) -> U {\n        match self {\n            Some(x) => f(x),\n            None => default(),\n        }\n    }\n\n    fn ok_or<E>(self, err: E) -> Result<T, E> {\n        match self {\n            Some(x) => Ok(x),\n            None => Err(err),\n        }\n    }\n\n    fn ok_or_else<E>(self, f: impl Fn() -> E) -> Result<T, E> {\n        match self {\n            Some(x) => Ok(x),\n            None => Err(f()),\n        }\n    }\n\n    fn is_some_and(self, p: impl Fn(T) -> Bool) -> Bool {\n        match self {\n            Some(x) => p(x),\n            None => false,\n        }\n    }\n\n    fn is_none_or(self, p: impl Fn(T) -> Bool) -> Bool {\n        match self {\n            Some(x) => p(x),\n            None => true,\n        }\n    }\n\n    fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {\n        match self {\n            Some(x) => match other {\n                Some(y) => Some((x, y)),\n                None => None,\n            },\n            None => None,\n        }\n    }\n\n    fn inspect(self, f: impl Fn(&T)) -> Option<T> {\n        match self {\n            Some(x) => {\n                f(&x);\n                Some(x)\n            }\n            None => None,\n        }\n    }\n\n    // iter yields the value once, or nothing.\n    #[fresh]\n    fn iter(&self) -> Iter<T> {\n        let mut v = Vec::new();\n        match *self {\n            Some(x) => v.push(x),\n            None => {}\n        }\n        v.iter()\n    }\n}\n\nimpl<T: Default> Option<T> {\n    fn unwrap_or_default(self) -> T {\n        match self {\n            Some(x) => x,\n            None => T::default(),\n        }\n    }\n}\n\nimpl<T> Option<Option<T>> {\n    fn flatten(self) -> Option<T> {\n        match self {\n            Some(x) => x,\n            None => None,\n        }\n    }\n}\n\nimpl<T, E> Option<Result<T, E>> {\n    // transpose turns `Option<Result<T, E>>` into `Result<Option<T>, E>`.\n    fn transpose(self) -> Result<Option<T>, E> {\n        match self {\n            Some(Ok(x)) => Ok(Some(x)),\n            Some(Err(e)) => Err(e),\n            None => Ok(None),\n        }\n    }\n}\n\nimpl<T, E> Result<T, E> {\n    fn map<U>(self, f: impl Fn(T) -> U) -> Result<U, E> {\n        match self {\n            Ok(x) => Ok(f(x)),\n            Err(e) => Err(e),\n        }\n    }\n\n    fn map_err<F>(self, f: impl Fn(E) -> F) -> Result<T, F> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => Err(f(e)),\n        }\n    }\n\n    fn and_then<U>(self, f: impl Fn(T) -> Result<U, E>) -> Result<U, E> {\n        match self {\n            Ok(x) => f(x),\n            Err(e) => Err(e),\n        }\n    }\n\n    fn and<U>(self, other: Result<U, E>) -> Result<U, E> {\n        match self {\n            Ok(_) => other,\n            Err(e) => Err(e),\n        }\n    }\n\n    fn or<F>(self, other: Result<T, F>) -> Result<T, F> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(_) => other,\n        }\n    }\n\n    fn or_else<F>(self, f: impl Fn(E) -> Result<T, F>) -> Result<T, F> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => f(e),\n        }\n    }\n\n    fn ok(self) -> Option<T> {\n        match self {\n            Ok(x) => Some(x),\n            Err(_) => None,\n        }\n    }\n\n    fn err(self) -> Option<E> {\n        match self {\n            Ok(_) => None,\n            Err(e) => Some(e),\n        }\n    }\n\n    fn unwrap_or_else(self, f: impl Fn(E) -> T) -> T {\n        match self {\n            Ok(x) => x,\n            Err(e) => f(e),\n        }\n    }\n\n    fn map_or<U>(self, default: U, f: impl Fn(T) -> U) -> U {\n        match self {\n            Ok(x) => f(x),\n            Err(_) => default,\n        }\n    }\n\n    fn map_or_else<U>(self, default: impl Fn(E) -> U, f: impl Fn(T) -> U) -> U {\n        match self {\n            Ok(x) => f(x),\n            Err(e) => default(e),\n        }\n    }\n\n    fn is_ok_and(self, p: impl Fn(T) -> Bool) -> Bool {\n        match self {\n            Ok(x) => p(x),\n            Err(_) => false,\n        }\n    }\n\n    fn is_err_and(self, p: impl Fn(E) -> Bool) -> Bool {\n        match self {\n            Ok(_) => false,\n            Err(e) => p(e),\n        }\n    }\n\n    fn inspect(self, f: impl Fn(&T)) -> Result<T, E> {\n        match self {\n            Ok(x) => {\n                f(&x);\n                Ok(x)\n            }\n            Err(e) => Err(e),\n        }\n    }\n\n    fn inspect_err(self, f: impl Fn(&E)) -> Result<T, E> {\n        match self {\n            Ok(x) => Ok(x),\n            Err(e) => {\n                f(&e);\n                Err(e)\n            }\n        }\n    }\n\n    // iter yields the Ok value once, or nothing.\n    #[fresh]\n    fn iter(&self) -> Iter<T> {\n        let mut v = Vec::new();\n        match *self {\n            Ok(x) => v.push(x),\n            Err(_) => {}\n        }\n        v.iter()\n    }\n}\n\nimpl<T: Default, E> Result<T, E> {\n    fn unwrap_or_default(self) -> T {\n        match self {\n            Ok(x) => x,\n            Err(_) => T::default(),\n        }\n    }\n}\n\nimpl<T, E> Result<Option<T>, E> {\n    // transpose turns `Result<Option<T>, E>` into `Option<Result<T, E>>`.\n    fn transpose(self) -> Option<Result<T, E>> {\n        match self {\n            Ok(Some(x)) => Some(Ok(x)),\n            Ok(None) => None,\n            Err(e) => Some(Err(e)),\n        }\n    }\n}\n\nimpl<T, E> Result<Result<T, E>, E> {\n    fn flatten(self) -> Result<T, E> {\n        match self {\n            Ok(x) => x,\n            Err(e) => Err(e),\n        }\n    }\n}\n\nimpl Bool {\n    // then is `Some(f())` when true.\n    fn then<T>(self, f: impl Fn() -> T) -> Option<T> {\n        if self { Some(f()) } else { None }\n    }\n\n    fn then_some<T>(self, x: T) -> Option<T> {\n        if self { Some(x) } else { None }\n    }\n}\n",
    );
    core_file(
        v,
        "serde.kek",
        "// Serialization (docs/serde.md): a type converts to and from a Value, the\n// data model shared by every format; a format (Json, Toml) only converts\n// between a Value and text.\n//\n//   #[derive(Serialize, Deserialize)]\n//   struct Config { name: String, port: Port, tags: Vec<String> }\n//\n//   let c: Config = Toml::from_str(text)?;\n//   Json::to_string(&c)\n//\n// What may cross the boundary is decided here once, for every format:\n//\n//   - Labeled<L, T> implements Deserialize but not Serialize: input can be\n//     labeled as it is read (a password never exists as a plain String),\n//     and labeled data cannot be written out.\n//   - Can<A, r> and the capabilities implement neither: a permission cannot\n//     be forged from input.\n//   - a derived Deserialize checks the predicates of refined aliases\n//     (`type Port = Int where 0 < self && self < 65536`) of the fields.\n//\n// Error messages never contain the data, only its shape and where it is,\n// so a SerdeError may be logged or returned to a client.\n\n// Value is a parsed document. Map keeps the order of its keys (but `==`\n// ignores it); Float keeps the number as written (the language has no\n// floating point type).\n#[derive(Clone)]\nenum Value {\n    Null,\n    Bool(Bool),\n    Int(Int),\n    Float(Float),\n    Str(String),\n    Seq(Vec<Value>),\n    Map(Vec<(String, Value)>),\n}\n\n// SerdeError is a parse error (line and column, 1-based) or a value of the\n// wrong shape (path, such as `servers[1].port`).\n#[derive(PartialEq, Clone)]\nstruct SerdeError {\n    path: String,\n    line: Int,\n    col: Int,\n    msg: String,\n}\n\ntrait Serialize {\n    fn to_value(&self) -> Value;\n}\n\n// from_value builds an owned value from what it reads (`#[owned]`: the\n// result is not borrowed from v, as with clone).\ntrait Deserialize {\n    #[owned]\n    fn from_value(v: &Value) -> Result<Self, SerdeError>;\n}\n\nimpl SerdeError {\n    fn new(msg: String) -> SerdeError {\n        SerdeError { path: \"\", line: 0, col: 0, msg: msg }\n    }\n\n    // in_field is the error inside the field (or map key) name.\n    fn in_field(&self, name: String) -> SerdeError {\n        let rest = if self.path == \"\" || self.path.starts_with(\"[\") {\n            self.path\n        } else {\n            \".\" + self.path\n        };\n        SerdeError { path: name + rest, line: self.line, col: self.col, msg: self.msg }\n    }\n\n    // in_index is the error inside element i of a sequence.\n    fn in_index(&self, i: Int) -> SerdeError {\n        let rest = if self.path == \"\" || self.path.starts_with(\"[\") {\n            self.path\n        } else {\n            \".\" + self.path\n        };\n        SerdeError {\n            path: \"[\" + i.to_string() + \"]\" + rest,\n            line: self.line,\n            col: self.col,\n            msg: self.msg,\n        }\n    }\n\n    fn message(&self) -> String {\n        let mut m = self.msg;\n        if self.path != \"\" {\n            m = self.path + \": \" + m;\n        }\n        if self.line > 0 {\n            m = \"line \" + self.line.to_string() + \", column \" + self.col.to_string() + \": \" + m;\n        }\n        m\n    }\n}\n\nimpl Value {\n    // kind names the shape of the value for messages.\n    fn kind(&self) -> String {\n        match self {\n            Value::Null => \"null\",\n            Value::Bool(_) => \"a boolean\",\n            Value::Int(_) => \"an integer\",\n            Value::Float(_) => \"a float\",\n            Value::Str(_) => \"a string\",\n            Value::Seq(_) => \"a sequence\",\n            Value::Map(_) => \"a map\",\n        }\n    }\n\n    // get is the value of key in a map.\n    fn get(&self, key: String) -> Option<&Value> {\n        match self {\n            Value::Map(es) => {\n                for e in es.iter() {\n                    if e.0 == key {\n                        return Some(&e.1);\n                    }\n                }\n                None\n            }\n            _ => None,\n        }\n    }\n\n    fn mismatch(&self, what: String) -> SerdeError {\n        SerdeError::new(\"expected \" + what + \", found \" + self.kind())\n    }\n\n    // tagged is the value of an enum variant with fields: `{\"name\": payload}`.\n    fn tagged(name: String, payload: Value) -> Value {\n        let mut es = Vec::new();\n        es.push((name, payload));\n        Value::Map(es)\n    }\n\n    // ---- used by #[derive(Deserialize)] ----\n\n    // expect_map checks that the value is a map (the fields of `ty`).\n    fn expect_map(&self, ty: String) -> Result<(), SerdeError> {\n        match self {\n            Value::Map(_) => Ok(()),\n            _ => Err(self.mismatch(\"a map (`\" + ty + \"`)\")),\n        }\n    }\n\n    // field decodes the field key of a map. A missing field reads as null,\n    // so an Option field may be left out.\n    #[owned]\n    fn field<T: Deserialize>(&self, key: String) -> Result<T, SerdeError> {\n        match self.get(key) {\n            Some(x) => match T::from_value(x) {\n                Ok(t) => Ok(t),\n                Err(e) => Err(e.in_field(key)),\n            },\n            None => match T::from_value(&Value::Null) {\n                Ok(t) => Ok(t),\n                Err(_) => Err(SerdeError::new(\"missing field `\" + key + \"`\")),\n            },\n        }\n    }\n\n    // decode_in decodes the value, reporting errors inside path.\n    #[owned]\n    fn decode_in<T: Deserialize>(&self, path: String) -> Result<T, SerdeError> {\n        match T::from_value(self) {\n            Ok(t) => Ok(t),\n            Err(e) => Err(e.in_field(path)),\n        }\n    }\n\n    // element decodes element i of a sequence of n elements (a tuple\n    // variant's fields), reporting errors inside path.\n    #[owned]\n    fn element<T: Deserialize>(&self, path: String, i: Int, n: Int) -> Result<T, SerdeError> {\n        match self {\n            Value::Seq(xs) => {\n                if xs.len() != n {\n                    return Err(\n                        SerdeError::new(\n                            \"expected \" + n.to_string() + \" elements, found \" + xs.len().to_string(),\n                        ).in_field(path),\n                    );\n                }\n                match xs.get(i) {\n                    Some(x) => match T::from_value(x) {\n                        Ok(t) => Ok(t),\n                        Err(e) => Err(e.in_index(i).in_field(path)),\n                    },\n                    None => Err(SerdeError::new(\"missing element\").in_field(path)),\n                }\n            }\n            _ => Err(self.mismatch(\"a sequence\").in_field(path)),\n        }\n    }\n\n    // variant_name is the variant of an enum value: `\"Name\"` for a variant\n    // without fields, `{\"Name\": payload}` otherwise.\n    fn variant_name(&self, ty: String) -> Result<String, SerdeError> {\n        match self {\n            Value::Str(s) => Ok(s),\n            Value::Map(es) => {\n                if es.len() != 1 {\n                    return Err(SerdeError::new(\"expected one variant of `\" + ty + \"`\"));\n                }\n                match es.get(0) {\n                    Some(e) => Ok(e.0),\n                    None => Err(SerdeError::new(\"expected one variant of `\" + ty + \"`\")),\n                }\n            }\n            _ => Err(self.mismatch(\"a variant of `\" + ty + \"`\")),\n        }\n    }\n\n    // variant_payload is the payload of an enum value (null for `\"Name\"`).\n    fn variant_payload(&self) -> &Value {\n        match self {\n            Value::Map(es) => match es.get(0) {\n                Some(e) => &e.1,\n                None => &Value::Null,\n            },\n            _ => &Value::Null,\n        }\n    }\n\n    fn unknown_variant(&self, ty: String, name: String) -> SerdeError {\n        SerdeError::new(\"unknown variant `\" + name + \"` of `\" + ty + \"`\")\n    }\n\n    // refused is the error for a field whose refined type does not hold.\n    fn refused(&self, path: String, ty: String) -> SerdeError {\n        SerdeError::new(\"the value is not a valid `\" + ty + \"`\").in_field(path)\n    }\n}\n\n// Maps are equal when they have the same keys with equal values, in any\n// order (the parsers refuse repeated keys).\nimpl PartialEq for Value {\n    fn eq(&self, other: &Value) -> Bool {\n        match self {\n            Value::Map(a) => match other {\n                Value::Map(b) => {\n                    if a.len() != b.len() {\n                        return false;\n                    }\n                    for e in a.iter() {\n                        match other.get(e.0) {\n                            Some(x) => {\n                                if !(e.1 == *x) {\n                                    return false;\n                                }\n                            }\n                            None => {\n                                return false;\n                            }\n                        }\n                    }\n                    true\n                }\n                _ => false,\n            },\n            Value::Null => match other {\n                Value::Null => true,\n                _ => false,\n            },\n            Value::Bool(x) => match other {\n                Value::Bool(y) => x == y,\n                _ => false,\n            },\n            Value::Int(x) => match other {\n                Value::Int(y) => x == y,\n                _ => false,\n            },\n            // (NaN equals NaN here, so that Value's Eq is an equivalence:\n            // a document with `nan` equals itself after a round trip)\n            Value::Float(x) => match other {\n                Value::Float(y) => x == y || (x.is_nan() && y.is_nan()),\n                _ => false,\n            },\n            Value::Str(x) => match other {\n                Value::Str(y) => x == y,\n                _ => false,\n            },\n            Value::Seq(xs) => match other {\n                Value::Seq(ys) => xs == ys,\n                _ => false,\n            },\n        }\n    }\n}\n\nimpl Eq for Value {}\n\n// ---- the core types ----\n\nimpl Serialize for Value {\n    fn to_value(&self) -> Value {\n        self.clone()\n    }\n}\n\nimpl Deserialize for Value {\n    fn from_value(v: &Value) -> Result<Value, SerdeError> {\n        Ok(v.clone())\n    }\n}\n\nimpl Serialize for Int {\n    fn to_value(&self) -> Value {\n        Value::Int(*self)\n    }\n}\n\nimpl Deserialize for Int {\n    fn from_value(v: &Value) -> Result<Int, SerdeError> {\n        match v {\n            Value::Int(n) => Ok(n),\n            _ => Err(v.mismatch(\"an integer\")),\n        }\n    }\n}\n\nimpl Serialize for Float {\n    fn to_value(&self) -> Value {\n        Value::Float(*self)\n    }\n}\n\n// A Float also reads an integer (JSON `1` is Value::Int).\nimpl Deserialize for Float {\n    fn from_value(v: &Value) -> Result<Float, SerdeError> {\n        match v {\n            Value::Float(x) => Ok(x),\n            Value::Int(n) => Ok(n.to_float()),\n            _ => Err(v.mismatch(\"a float\")),\n        }\n    }\n}\n\nimpl Serialize for Bool {\n    fn to_value(&self) -> Value {\n        Value::Bool(*self)\n    }\n}\n\nimpl Deserialize for Bool {\n    fn from_value(v: &Value) -> Result<Bool, SerdeError> {\n        match v {\n            Value::Bool(b) => Ok(b),\n            _ => Err(v.mismatch(\"a boolean\")),\n        }\n    }\n}\n\nimpl Serialize for String {\n    fn to_value(&self) -> Value {\n        Value::Str(*self)\n    }\n}\n\nimpl Deserialize for String {\n    fn from_value(v: &Value) -> Result<String, SerdeError> {\n        match v {\n            Value::Str(s) => Ok(s),\n            _ => Err(v.mismatch(\"a string\")),\n        }\n    }\n}\n\nimpl Serialize for () {\n    fn to_value(&self) -> Value {\n        Value::Null\n    }\n}\n\nimpl Deserialize for () {\n    fn from_value(v: &Value) -> Result<(), SerdeError> {\n        match v {\n            Value::Null => Ok(()),\n            _ => Err(v.mismatch(\"null\")),\n        }\n    }\n}\n\nimpl<T: Serialize> Serialize for Option<T> {\n    fn to_value(&self) -> Value {\n        match self {\n            Some(x) => x.to_value(),\n            None => Value::Null,\n        }\n    }\n}\n\nimpl<T: Deserialize> Deserialize for Option<T> {\n    fn from_value(v: &Value) -> Result<Option<T>, SerdeError> {\n        match v {\n            Value::Null => Ok(None),\n            _ => Ok(Some(T::from_value(v)?)),\n        }\n    }\n}\n\nimpl<T: Serialize> Serialize for Vec<T> {\n    fn to_value(&self) -> Value {\n        let mut out = Vec::new();\n        for x in self.iter() {\n            out.push(x.to_value());\n        }\n        Value::Seq(out)\n    }\n}\n\nimpl<T: Deserialize> Deserialize for Vec<T> {\n    fn from_value(v: &Value) -> Result<Vec<T>, SerdeError> {\n        match v {\n            Value::Seq(xs) => {\n                let mut out = Vec::new();\n                let mut i = 0;\n                for x in xs.iter() {\n                    match T::from_value(x) {\n                        Ok(t) => out.push(t),\n                        Err(e) => {\n                            return Err(e.in_index(i));\n                        }\n                    }\n                    i = i + 1;\n                }\n                Ok(out)\n            }\n            _ => Err(v.mismatch(\"a sequence\")),\n        }\n    }\n}\n\nimpl<V: Serialize> Serialize for HashMap<String, V> {\n    fn to_value(&self) -> Value {\n        let mut out = Vec::new();\n        for (k, x) in self.iter() {\n            out.push((k, x.to_value()));\n        }\n        Value::Map(out)\n    }\n}\n\nimpl<V: Deserialize> Deserialize for HashMap<String, V> {\n    fn from_value(v: &Value) -> Result<HashMap<String, V>, SerdeError> {\n        match v {\n            Value::Map(es) => {\n                let mut out = HashMap::new();\n                for e in es.iter() {\n                    match V::from_value(&e.1) {\n                        Ok(x) => {\n                            out.insert(e.0, x);\n                        }\n                        Err(err) => {\n                            return Err(err.in_field(e.0));\n                        }\n                    }\n                }\n                Ok(out)\n            }\n            _ => Err(v.mismatch(\"a map\")),\n        }\n    }\n}\n\n// Labeled data is read already labeled, and never written: there is no\n// Serialize. The error of a failed read says only what shape was expected.\nimpl<L, T: Deserialize> Deserialize for Labeled<L, T> {\n    fn from_value(v: &Value) -> Result<Labeled<L, T>, SerdeError> {\n        Ok(Labeled::new(T::from_value(v)?))\n    }\n}\n\n// ---- helpers of the formats ----\n\n// __serde_at is a parse error at offset i of s.\nfn __serde_at(s: String, i: Int, msg: String) -> SerdeError {\n    let mut line = 1;\n    let mut col = 1;\n    let mut j = 0;\n    while j < i && j < s.len() {\n        if s.char_at(j).unwrap_or(0) == 10 {\n            line = line + 1;\n            col = 1;\n        } else {\n            col = col + 1;\n        }\n        j = j + 1;\n    }\n    SerdeError { path: \"\", line: line, col: col, msg: msg }\n}\n\nfn __serde_hex(d: Int) -> String {\n    \"0123456789abcdef\".slice(d, d + 1)\n}\n\n// __serde_quote is s as a double-quoted string with JSON escapes (also\n// valid in TOML). Lone surrogates are escaped too.\nfn __serde_quote(s: String) -> String {\n    let mut parts = Vec::new();\n    parts.push(\"\\\"\");\n    let n = s.len();\n    let mut start = 0;\n    let mut i = 0;\n    while i < n {\n        let c = s.char_at(i).unwrap_or(0);\n        let lone = (c >= 55296\n            && c <= 56319\n            && !(i + 1 < n && __serde_low(s.char_at(i + 1).unwrap_or(0))))\n            || (__serde_low(c) && !(i > 0 && __serde_high(s.char_at(i - 1).unwrap_or(0))));\n        if c == 34 || c == 92 || c < 32 || c == 127 || lone {\n            parts.push(s.slice(start, i));\n            if c == 34 {\n                parts.push(\"\\\\\\\"\");\n            } else if c == 92 {\n                parts.push(\"\\\\\\\\\");\n            } else if c == 10 {\n                parts.push(\"\\\\n\");\n            } else if c == 13 {\n                parts.push(\"\\\\r\");\n            } else if c == 9 {\n                parts.push(\"\\\\t\");\n            } else {\n                parts.push(\n                    \"\\\\u\"\n                        + __serde_hex(c.shr(12).bit_and(15))\n                        + __serde_hex(c.shr(8).bit_and(15))\n                        + __serde_hex(c.shr(4).bit_and(15))\n                        + __serde_hex(c.bit_and(15)),\n                );\n            }\n            start = i + 1;\n        }\n        i = i + 1;\n    }\n    parts.push(s.slice(start, n));\n    parts.push(\"\\\"\");\n    parts.join(\"\")\n}\n\nfn __serde_high(c: Int) -> Bool {\n    c >= 55296 && c <= 56319\n}\n\nfn __serde_low(c: Int) -> Bool {\n    c >= 56320 && c <= 57343\n}\n\n// __serde_code_point appends code point cp as UTF-16 to parts.\nfn __serde_code_point(mut parts: Vec<String>, cp: Int) {\n    if cp >= 65536 {\n        let x = cp - 65536;\n        parts.push(String::from_char(55296 + x.shr(10)));\n        parts.push(String::from_char(56320 + x.bit_and(1023)));\n    } else {\n        parts.push(String::from_char(cp));\n    }\n}\n\nfn __serde_hex_value(c: Int) -> Int {\n    if c >= 48 && c <= 57 {\n        c - 48\n    } else if c >= 97 && c <= 102 {\n        c - 87\n    } else if c >= 65 && c <= 70 { c - 55 } else { -1 }\n}\n",
    );
    core_file(
        v,
        "string.kek",
        "// Methods of String, as in Rust's str and String (`len`, `char_at`,\n// `slice`, `index_of`, `contains`, `starts_with`, `ends_with`, `split`,\n// `replace`, `trim`, `to_upper`, `to_lower`, `parse_int` and `to_bytes`\n// are builtins). Strings are UTF-16: indices count code units, and a code\n// point (Rust's char) is an Int.\n\nimpl String {\n    fn new() -> String {\n        \"\"\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.len() == 0\n    }\n\n    fn to_string(&self) -> String {\n        *self\n    }\n\n    fn to_owned(&self) -> String {\n        *self\n    }\n\n    fn as_str(&self) -> String {\n        *self\n    }\n\n    // chars iterates over the code points; a surrogate pair is one code\n    // point and a lone surrogate is U+FFFD (as in to_bytes).\n    fn chars(&self) -> Chars {\n        Chars { s: *self, i: 0, end: self.len() }\n    }\n\n    // char_indices iterates over (index of the first code unit, code point).\n    fn char_indices(&self) -> CharIndices {\n        CharIndices { chars: self.chars() }\n    }\n\n    // bytes iterates over the UTF-8 encoding (to_bytes is the Vec).\n    fn bytes(&self) -> Iter<Int> {\n        self.to_bytes().iter()\n    }\n\n    // repeat is n copies of self (\"\" when n <= 0).\n    fn repeat(&self, n: Int) -> String {\n        let mut out = \"\";\n        let mut part = *self;\n        let mut k = n;\n        while k > 0 {\n            if k % 2 == 1 {\n                out = out + part;\n            }\n            k = k / 2;\n            if k > 0 {\n                part = part + part;\n            }\n        }\n        out\n    }\n\n    // lines splits at \"\\n\" and \"\\r\\n\"; a final line ending does not start\n    // another (empty) line.\n    fn lines(&self) -> Vec<String> {\n        let mut out = Vec::new();\n        if self.len() == 0 {\n            return out;\n        }\n        let parts = self.split(\"\\n\");\n        let n = parts.len();\n        let mut i = 0;\n        while i < n {\n            match parts.get(i) {\n                Some(p) => {\n                    if !(i == n - 1 && p == \"\") {\n                        if p.ends_with(\"\\r\") {\n                            out.push(p.slice(0, p.len() - 1));\n                        } else {\n                            out.push(p);\n                        }\n                    }\n                }\n                None => {}\n            }\n            i = i + 1;\n        }\n        out\n    }\n\n    // find is the index of the first occurrence of pat (= index_of).\n    fn find(&self, pat: String) -> Option<Int> {\n        self.index_of(pat)\n    }\n\n    // rfind is the index of the last occurrence of pat.\n    fn rfind(&self, pat: String) -> Option<Int> {\n        let k = pat.len();\n        let mut i = self.len() - k;\n        while i >= 0 {\n            if self.slice(i, i + k) == pat {\n                return Some(i);\n            }\n            i = i - 1;\n        }\n        None\n    }\n\n    fn strip_prefix(&self, prefix: String) -> Option<String> {\n        if self.starts_with(prefix) {\n            Some(self.slice(prefix.len(), self.len()))\n        } else {\n            None\n        }\n    }\n\n    fn strip_suffix(&self, suffix: String) -> Option<String> {\n        if self.ends_with(suffix) {\n            Some(self.slice(0, self.len() - suffix.len()))\n        } else {\n            None\n        }\n    }\n\n    // trim_start and trim_end remove the white space that trim removes.\n    fn trim_start(&self) -> String {\n        let n = self.len();\n        let mut a = 0;\n        while a < n && __is_white_space(self.char_at(a)) {\n            a = a + 1;\n        }\n        self.slice(a, n)\n    }\n\n    fn trim_end(&self) -> String {\n        let mut b = self.len();\n        while b > 0 && __is_white_space(self.char_at(b - 1)) {\n            b = b - 1;\n        }\n        self.slice(0, b)\n    }\n\n    fn trim_start_matches(&self, pat: String) -> String {\n        let k = pat.len();\n        if k == 0 {\n            return *self;\n        }\n        let mut s = *self;\n        while s.starts_with(pat) {\n            s = s.slice(k, s.len());\n        }\n        s\n    }\n\n    fn trim_end_matches(&self, pat: String) -> String {\n        let k = pat.len();\n        if k == 0 {\n            return *self;\n        }\n        let mut s = *self;\n        while s.ends_with(pat) {\n            s = s.slice(0, s.len() - k);\n        }\n        s\n    }\n\n    // split_once splits at the first occurrence of sep.\n    fn split_once(&self, sep: String) -> Option<(String, String)> {\n        match self.index_of(sep) {\n            Some(i) => Some((self.slice(0, i), self.slice(i + sep.len(), self.len()))),\n            None => None,\n        }\n    }\n\n    // rsplit_once splits at the last occurrence of sep.\n    fn rsplit_once(&self, sep: String) -> Option<(String, String)> {\n        match self.rfind(sep) {\n            Some(i) => Some((self.slice(0, i), self.slice(i + sep.len(), self.len()))),\n            None => None,\n        }\n    }\n\n    // splitn splits at sep into at most n pieces (the last one holds the\n    // rest; none when n <= 0).\n    fn splitn(&self, n: Int, sep: String) -> Vec<String> {\n        let mut out = Vec::new();\n        if n <= 0 {\n            return out;\n        }\n        let mut rest = *self;\n        while out.len() < n - 1 {\n            match rest.split_once(sep) {\n                Some((a, b)) => {\n                    out.push(a);\n                    rest = b;\n                }\n                None => {\n                    break;\n                }\n            }\n        }\n        out.push(rest);\n        out\n    }\n\n    // split_whitespace splits at runs of white space, dropping empty pieces.\n    fn split_whitespace(&self) -> Vec<String> {\n        let mut out = Vec::new();\n        let n = self.len();\n        let mut i = 0;\n        while i < n {\n            while i < n && __is_white_space(self.char_at(i)) {\n                i = i + 1;\n            }\n            let start = i;\n            while i < n && !__is_white_space(self.char_at(i)) {\n                i = i + 1;\n            }\n            if i > start {\n                out.push(self.slice(start, i));\n            }\n        }\n        out\n    }\n\n    // eq_ignore_ascii_case compares with ASCII letters case-folded.\n    fn eq_ignore_ascii_case(&self, other: String) -> Bool {\n        self.len() == other.len() && self.to_lower() == other.to_lower()\n    }\n}\n\n// The white space of trim: U+0009–000D, U+0020, U+00A0, U+1680,\n// U+2000–200A, U+2028, U+2029, U+202F, U+205F, U+3000, U+FEFF.\nfn __is_white_space(c: Option<Int>) -> Bool {\n    match c {\n        Some(x) => (x >= 9 && x <= 13)\n            || x == 32\n            || x == 160\n            || x == 5760\n            || (x >= 8192 && x <= 8202)\n            || x == 8232\n            || x == 8233\n            || x == 8239\n            || x == 8287\n            || x == 12288\n            || x == 65279,\n        None => false,\n    }\n}\n\n// Chars iterates over the code points of a string (String::chars).\nstruct Chars {\n    s: String,\n    mut i: Int,\n    mut end: Int,\n}\n\nimpl Iterator for Chars {\n    type Item = Int;\n\n    fn next(&mut self) -> Option<Int> {\n        if self.i >= self.end {\n            return None;\n        }\n        let c = self.s.char_at(self.i).unwrap_or(0);\n        self.i = self.i + 1;\n        if c >= 55296 && c < 56320 {\n            if self.i < self.end {\n                let d = self.s.char_at(self.i).unwrap_or(0);\n                if d >= 56320 && d < 57344 {\n                    self.i = self.i + 1;\n                    return Some(65536 + (c - 55296) * 1024 + (d - 56320));\n                }\n            }\n            return Some(65533);\n        }\n        if c >= 56320 && c < 57344 {\n            return Some(65533);\n        }\n        Some(c)\n    }\n}\n\nimpl DoubleEndedIterator for Chars {\n    fn next_back(&mut self) -> Option<Int> {\n        if self.i >= self.end {\n            return None;\n        }\n        self.end = self.end - 1;\n        let d = self.s.char_at(self.end).unwrap_or(0);\n        if d >= 56320 && d < 57344 {\n            if self.end > self.i {\n                let c = self.s.char_at(self.end - 1).unwrap_or(0);\n                if c >= 55296 && c < 56320 {\n                    self.end = self.end - 1;\n                    return Some(65536 + (c - 55296) * 1024 + (d - 56320));\n                }\n            }\n            return Some(65533);\n        }\n        if d >= 55296 && d < 56320 {\n            return Some(65533);\n        }\n        Some(d)\n    }\n}\n\n// CharIndices iterates over (index, code point) (String::char_indices).\nstruct CharIndices {\n    chars: Chars,\n}\n\nimpl Iterator for CharIndices {\n    type Item = (Int, Int);\n\n    fn next(&mut self) -> Option<(Int, Int)> {\n        let i = self.chars.i;\n        match self.chars.next() {\n            Some(c) => Some((i, c)),\n            None => None,\n        }\n    }\n}\n",
    );
    core_file(
        v,
        "time.kek",
        "// Time (docs/time.md): instants, durations and calendar dates, computed in\n// plain Kekkai. Reading the clock is the only effect, and it takes the\n// capability: `Timestamp::now(clock)`.\n//\n//   let expires = Timestamp::now(clock).add(Duration::days(7));\n//   expires.to_rfc3339()                  // \"2026-10-12T09:30:00Z\"\n//   Timestamp::parse(\"2026-10-05T18:30:00+09:00\")\n//   Date::parse(\"2026-10-05\")?.weekday()  // Weekday::Mon\n//\n// Times are UTC or a fixed offset from it: there is no time zone database\n// (no daylight saving rules) and no leap seconds. The proleptic Gregorian\n// calendar is used for every year, 0000 to 9999 in text.\n\n#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Clone)]\nstruct Timestamp {\n    __ms: Int,\n}\n\n#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Clone)]\nstruct Duration {\n    __ms: Int,\n}\n\n// A calendar date. Built by Date::new or Date::parse, so it is always valid.\n#[derive(PartialEq, Eq, PartialOrd, Ord, Hash, Clone)]\nstruct Date {\n    __y: Int,\n    __m: Int,\n    __d: Int,\n}\n\n#[derive(PartialEq, Eq, Clone, Debug)]\nenum Weekday {\n    Mon,\n    Tue,\n    Wed,\n    Thu,\n    Fri,\n    Sat,\n    Sun,\n}\n\n// A date and a time of day at a fixed offset from UTC (minutes east):\n// what an RFC 3339 timestamp writes.\n#[derive(PartialEq, Eq, Clone)]\nstruct DateTime {\n    date: Date,\n    hour: Int,\n    minute: Int,\n    second: Int,\n    millis: Int,\n    offset_minutes: Int,\n}\n\n// ---- Duration ----\n\nimpl Duration {\n    fn ms(n: Int) -> Duration {\n        Duration { __ms: n }\n    }\n\n    fn seconds(n: Int) -> Duration {\n        Duration { __ms: n * 1000 }\n    }\n\n    fn minutes(n: Int) -> Duration {\n        Duration { __ms: n * 60000 }\n    }\n\n    fn hours(n: Int) -> Duration {\n        Duration { __ms: n * 3600000 }\n    }\n\n    fn days(n: Int) -> Duration {\n        Duration { __ms: n * 86400000 }\n    }\n\n    fn as_ms(&self) -> Int {\n        self.__ms\n    }\n\n    // as_seconds rounds toward negative infinity.\n    fn as_seconds(&self) -> Int {\n        __time_floor_div(self.__ms, 1000)\n    }\n\n    fn add(&self, other: Duration) -> Duration {\n        Duration { __ms: self.__ms + other.__ms }\n    }\n\n    fn sub(&self, other: Duration) -> Duration {\n        Duration { __ms: self.__ms - other.__ms }\n    }\n\n    fn mul(&self, k: Int) -> Duration {\n        Duration { __ms: self.__ms * k }\n    }\n\n    fn is_negative(&self) -> Bool {\n        self.__ms < 0\n    }\n\n    // to_string is the duration in units: \"1d2h3m4s5ms\", \"-90s\", \"0s\".\n    fn to_string(&self) -> String {\n        if self.__ms == 0 {\n            return \"0s\";\n        }\n        let mut rest = self.__ms;\n        let mut sign = \"\";\n        if rest < 0 {\n            sign = \"-\";\n            rest = 0 - rest;\n        }\n        let mut parts = Vec::new();\n        parts.push(sign);\n        let units = __time_units();\n        for u in units.iter() {\n            let n = rest / u.1;\n            if n > 0 {\n                parts.push(n.to_string() + u.0);\n                rest = rest - n * u.1;\n            }\n        }\n        parts.join(\"\")\n    }\n\n    // parse reads what to_string writes: a sequence of `<n><unit>` with the\n    // units d, h, m, s and ms, optionally signed (\"1h30m\", \"-500ms\").\n    fn parse(s: String) -> Result<Duration, SerdeError> {\n        let mut i = 0;\n        let n = s.len();\n        let mut neg = false;\n        if n > 0 && (s.char_at(0).unwrap_or(0) == 45 || s.char_at(0).unwrap_or(0) == 43) {\n            neg = s.char_at(0).unwrap_or(0) == 45;\n            i = 1;\n        }\n        if i >= n {\n            return Err(SerdeError::new(\"expected a duration such as 1h30m\"));\n        }\n        let mut total = 0;\n        while i < n {\n            let start = i;\n            while i < n && __time_digit(s.char_at(i).unwrap_or(0)) {\n                i = i + 1;\n            }\n            if i == start {\n                return Err(SerdeError::new(\"expected a duration such as 1h30m\"));\n            }\n            let k = s.slice(start, i).parse_int().unwrap_or(-1);\n            let ustart = i;\n            while i < n && !__time_digit(s.char_at(i).unwrap_or(0)) {\n                i = i + 1;\n            }\n            let unit = s.slice(ustart, i);\n            let mut scale = 0;\n            for u in __time_units().iter() {\n                if u.0 == unit {\n                    scale = u.1;\n                }\n            }\n            if scale == 0 || k < 0 || k > 9223372036854775807 / scale {\n                return Err(SerdeError::new(\"expected a duration such as 1h30m\"));\n            }\n            total = total + k * scale;\n        }\n        Ok(Duration { __ms: if neg { 0 - total } else { total } })\n    }\n}\n\nfn __time_units() -> Vec<(String, Int)> {\n    let mut v = Vec::new();\n    v.push((\"d\", 86400000));\n    v.push((\"h\", 3600000));\n    v.push((\"m\", 60000));\n    v.push((\"s\", 1000));\n    v.push((\"ms\", 1));\n    v\n}\n\n// ---- Timestamp ----\n\nimpl Timestamp {\n    // now reads the clock.\n    fn now(clock: &Clock) -> Timestamp {\n        Timestamp { __ms: clock.now_ms() }\n    }\n\n    fn from_unix_ms(ms: Int) -> Timestamp {\n        Timestamp { __ms: ms }\n    }\n\n    fn from_unix_seconds(s: Int) -> Timestamp {\n        Timestamp { __ms: s * 1000 }\n    }\n\n    fn unix_ms(&self) -> Int {\n        self.__ms\n    }\n\n    // unix_seconds rounds toward negative infinity.\n    fn unix_seconds(&self) -> Int {\n        __time_floor_div(self.__ms, 1000)\n    }\n\n    fn add(&self, d: Duration) -> Timestamp {\n        Timestamp { __ms: self.__ms + d.__ms }\n    }\n\n    fn sub(&self, d: Duration) -> Timestamp {\n        Timestamp { __ms: self.__ms - d.__ms }\n    }\n\n    // since is the time from earlier to self (negative if earlier is later).\n    fn since(&self, earlier: &Timestamp) -> Duration {\n        Duration { __ms: self.__ms - earlier.__ms }\n    }\n\n    fn is_before(&self, other: &Timestamp) -> Bool {\n        self.__ms < other.__ms\n    }\n\n    fn is_after(&self, other: &Timestamp) -> Bool {\n        self.__ms > other.__ms\n    }\n\n    // date is the UTC calendar date.\n    fn date(&self) -> Date {\n        self.at_offset(0).date\n    }\n\n    // at_offset is the date and time at offset_minutes east of UTC.\n    fn at_offset(&self, offset_minutes: Int) -> DateTime {\n        let local = self.__ms + offset_minutes * 60000;\n        let days = __time_floor_div(local, 86400000);\n        let in_day = local - days * 86400000;\n        DateTime {\n            date: __date_from_days(days),\n            hour: in_day / 3600000,\n            minute: in_day / 60000 % 60,\n            second: in_day / 1000 % 60,\n            millis: in_day % 1000,\n            offset_minutes: offset_minutes,\n        }\n    }\n\n    // to_rfc3339 is the UTC time: \"2026-10-05T09:30:00Z\", with \".123\" when\n    // the milliseconds are not zero.\n    fn to_rfc3339(&self) -> String {\n        self.at_offset(0).to_rfc3339()\n    }\n\n    // parse reads an RFC 3339 date-time with an offset (\"Z\" or \"+09:00\";\n    // \"t\", \"z\" and a space for \"T\" are accepted, as in TOML).\n    fn parse(s: String) -> Result<Timestamp, SerdeError> {\n        Ok(DateTime::parse(s)?.timestamp())\n    }\n}\n\n// ---- Date ----\n\nimpl Date {\n    // new is the date, if it exists (month 1-12, day within the month).\n    fn new(year: Int, month: Int, day: Int) -> Option<Date> {\n        if month < 1 || month > 12 || day < 1 || day > __days_in_month(year, month) {\n            return None;\n        }\n        Some(Date { __y: year, __m: month, __d: day })\n    }\n\n    fn year(&self) -> Int {\n        self.__y\n    }\n\n    fn month(&self) -> Int {\n        self.__m\n    }\n\n    fn day(&self) -> Int {\n        self.__d\n    }\n\n    fn is_leap_year(&self) -> Bool {\n        __is_leap(self.__y)\n    }\n\n    // days_since_epoch counts days from 1970-01-01.\n    fn days_since_epoch(&self) -> Int {\n        __days_from_civil(self.__y, self.__m, self.__d)\n    }\n\n    fn from_days_since_epoch(days: Int) -> Date {\n        __date_from_days(days)\n    }\n\n    fn add_days(&self, n: Int) -> Date {\n        __date_from_days(self.days_since_epoch() + n)\n    }\n\n    // days_until is the number of days from self to other.\n    fn days_until(&self, other: &Date) -> Int {\n        other.days_since_epoch() - self.days_since_epoch()\n    }\n\n    fn weekday(&self) -> Weekday {\n        // 1970-01-01 was a Thursday\n        match __time_floor_mod(self.days_since_epoch() + 3, 7) {\n            0 => Weekday::Mon,\n            1 => Weekday::Tue,\n            2 => Weekday::Wed,\n            3 => Weekday::Thu,\n            4 => Weekday::Fri,\n            5 => Weekday::Sat,\n            _ => Weekday::Sun,\n        }\n    }\n\n    // start_of_day is midnight at the start of the date, UTC.\n    fn start_of_day(&self) -> Timestamp {\n        Timestamp { __ms: self.days_since_epoch() * 86400000 }\n    }\n\n    // to_string is \"YYYY-MM-DD\".\n    fn to_string(&self) -> String {\n        __time_pad(self.__y, 4) + \"-\" + __time_pad(self.__m, 2) + \"-\" + __time_pad(self.__d, 2)\n    }\n\n    fn parse(s: String) -> Result<Date, SerdeError> {\n        if s.len() != 10 || s.char_at(4).unwrap_or(0) != 45 || s.char_at(7).unwrap_or(0) != 45 {\n            return Err(SerdeError::new(\"expected a date YYYY-MM-DD\"));\n        }\n        let y = __time_num(s, 0, 4);\n        let m = __time_num(s, 5, 7);\n        let d = __time_num(s, 8, 10);\n        if y < 0 || m < 0 || d < 0 {\n            return Err(SerdeError::new(\"expected a date YYYY-MM-DD\"));\n        }\n        match Date::new(y, m, d) {\n            Some(x) => Ok(x),\n            None => Err(SerdeError::new(\"no such date\")),\n        }\n    }\n}\n\nimpl Weekday {\n    // number is 1 for Monday to 7 for Sunday (ISO 8601).\n    fn number(&self) -> Int {\n        match self {\n            Weekday::Mon => 1,\n            Weekday::Tue => 2,\n            Weekday::Wed => 3,\n            Weekday::Thu => 4,\n            Weekday::Fri => 5,\n            Weekday::Sat => 6,\n            Weekday::Sun => 7,\n        }\n    }\n}\n\n// ---- DateTime ----\n\nimpl DateTime {\n    // timestamp is the instant the date and time at the offset stand for.\n    fn timestamp(&self) -> Timestamp {\n        Timestamp {\n            __ms: self.date.days_since_epoch() * 86400000\n                + self.hour * 3600000\n                + self.minute * 60000\n                + self.second * 1000\n                + self.millis\n                - self.offset_minutes * 60000,\n        }\n    }\n\n    fn to_rfc3339(&self) -> String {\n        let mut s = self.date.to_string()\n            + \"T\"\n            + __time_pad(self.hour, 2)\n            + \":\"\n            + __time_pad(self.minute, 2)\n            + \":\"\n            + __time_pad(self.second, 2);\n        if self.millis != 0 {\n            s = s + \".\" + __time_pad(self.millis, 3);\n        }\n        if self.offset_minutes == 0 {\n            return s + \"Z\";\n        }\n        let mut o = self.offset_minutes;\n        let mut sign = \"+\";\n        if o < 0 {\n            sign = \"-\";\n            o = 0 - o;\n        }\n        s + sign + __time_pad(o / 60, 2) + \":\" + __time_pad(o % 60, 2)\n    }\n\n    // parse reads an RFC 3339 date-time. Fractions of a second beyond\n    // milliseconds are truncated.\n    fn parse(s: String) -> Result<DateTime, SerdeError> {\n        let bad = SerdeError::new(\"expected a date-time such as 2026-10-05T09:30:00Z\");\n        if s.len() < 20 {\n            return Err(bad);\n        }\n        let date = Date::parse(s.slice(0, 10))?;\n        let t = s.char_at(10).unwrap_or(0);\n        if !(t == 84 || t == 116 || t == 32)\n            || s.char_at(13).unwrap_or(0) != 58\n            || s.char_at(16).unwrap_or(0) != 58 {\n            return Err(bad);\n        }\n        let hour = __time_num(s, 11, 13);\n        let minute = __time_num(s, 14, 16);\n        let second = __time_num(s, 17, 19);\n        if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 59 {\n            return Err(SerdeError::new(\"no such time of day\"));\n        }\n        let mut i = 19;\n        let mut millis = 0;\n        if s.char_at(i).unwrap_or(0) == 46 {\n            i = i + 1;\n            let start = i;\n            while i < s.len() && __time_digit(s.char_at(i).unwrap_or(0)) {\n                i = i + 1;\n            }\n            if i == start {\n                return Err(bad);\n            }\n            let frac = s.slice(start, i) + \"00\";\n            millis = __time_num(frac, 0, 3);\n        }\n        let rest = s.slice(i, s.len());\n        let mut offset = 0;\n        if rest == \"Z\" || rest == \"z\" {\n            offset = 0;\n        } else if rest.len() == 6\n            && (rest.char_at(0).unwrap_or(0) == 43 || rest.char_at(0).unwrap_or(0) == 45)\n            && rest.char_at(3).unwrap_or(0) == 58 {\n            let oh = __time_num(rest, 1, 3);\n            let om = __time_num(rest, 4, 6);\n            if oh < 0 || oh > 23 || om < 0 || om > 59 {\n                return Err(bad);\n            }\n            offset = oh * 60 + om;\n            if rest.char_at(0).unwrap_or(0) == 45 {\n                offset = 0 - offset;\n            }\n        } else {\n            return Err(bad);\n        }\n        Ok(DateTime {\n            date: date,\n            hour: hour,\n            minute: minute,\n            second: second,\n            millis: millis,\n            offset_minutes: offset,\n        })\n    }\n}\n\n// ---- formatting and operators ----\n//\n// `{}` and `{:?}` are the text forms: RFC 3339 for Timestamp (UTC) and\n// DateTime, `YYYY-MM-DD` for Date, \"1h30m\" for Duration. Durations add,\n// subtract, negate and scale by an Int; a Timestamp moves by a Duration\n// (`t.since(&earlier)` is the Duration between two).\n\nimpl Display for Timestamp {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_rfc3339());\n    }\n}\n\nimpl Debug for Timestamp {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_rfc3339());\n    }\n}\n\nimpl Display for Duration {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_string());\n    }\n}\n\nimpl Debug for Duration {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_string());\n    }\n}\n\nimpl Display for Date {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_string());\n    }\n}\n\nimpl Debug for Date {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_string());\n    }\n}\n\nimpl Display for DateTime {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_rfc3339());\n    }\n}\n\nimpl Debug for DateTime {\n    fn fmt(&self, f: &mut Formatter) {\n        f.write_str(self.to_rfc3339());\n    }\n}\n\nimpl Add<Duration> for Duration {\n    type Output = Duration;\n\n    fn add(self, rhs: Duration) -> Duration {\n        Duration { __ms: self.__ms + rhs.__ms }\n    }\n}\n\nimpl Sub<Duration> for Duration {\n    type Output = Duration;\n\n    fn sub(self, rhs: Duration) -> Duration {\n        Duration { __ms: self.__ms - rhs.__ms }\n    }\n}\n\nimpl Mul<Int> for Duration {\n    type Output = Duration;\n\n    fn mul(self, rhs: Int) -> Duration {\n        Duration { __ms: self.__ms * rhs }\n    }\n}\n\nimpl Neg for Duration {\n    type Output = Duration;\n\n    fn neg(self) -> Duration {\n        Duration { __ms: 0 - self.__ms }\n    }\n}\n\nimpl Add<Duration> for Timestamp {\n    type Output = Timestamp;\n\n    fn add(self, rhs: Duration) -> Timestamp {\n        Timestamp { __ms: self.__ms + rhs.__ms }\n    }\n}\n\nimpl Sub<Duration> for Timestamp {\n    type Output = Timestamp;\n\n    fn sub(self, rhs: Duration) -> Timestamp {\n        Timestamp { __ms: self.__ms - rhs.__ms }\n    }\n}\n\n// ---- serialization ----\n\nimpl Serialize for Timestamp {\n    fn to_value(&self) -> Value {\n        Value::Str(self.to_rfc3339())\n    }\n}\n\nimpl Deserialize for Timestamp {\n    fn from_value(v: &Value) -> Result<Timestamp, SerdeError> {\n        match v {\n            Value::Str(s) => Timestamp::parse(s),\n            _ => Err(v.mismatch(\"a date-time string\")),\n        }\n    }\n}\n\nimpl Serialize for Date {\n    fn to_value(&self) -> Value {\n        Value::Str(self.to_string())\n    }\n}\n\nimpl Deserialize for Date {\n    fn from_value(v: &Value) -> Result<Date, SerdeError> {\n        match v {\n            Value::Str(s) => Date::parse(s),\n            _ => Err(v.mismatch(\"a date string\")),\n        }\n    }\n}\n\nimpl Serialize for Duration {\n    fn to_value(&self) -> Value {\n        Value::Str(self.to_string())\n    }\n}\n\n// A duration is read from a string with units (\"1h30m\") or from an\n// integer number of milliseconds.\nimpl Deserialize for Duration {\n    fn from_value(v: &Value) -> Result<Duration, SerdeError> {\n        match v {\n            Value::Str(s) => Duration::parse(s),\n            Value::Int(n) => Ok(Duration::ms(n)),\n            _ => Err(v.mismatch(\"a duration such as \\\"1h30m\\\"\")),\n        }\n    }\n}\n\n// ---- calendar arithmetic ----\n\nfn __time_floor_div(a: Int, b: Int) -> Int {\n    let q = a / b;\n    if a % b != 0 && (a < 0) != (b < 0) {\n        q - 1\n    } else {\n        q\n    }\n}\n\nfn __time_floor_mod(a: Int, b: Int) -> Int {\n    a - __time_floor_div(a, b) * b\n}\n\nfn __is_leap(y: Int) -> Bool {\n    (y % 4 == 0 && y % 100 != 0) || y % 400 == 0\n}\n\nfn __days_in_month(y: Int, m: Int) -> Int {\n    if m == 2 {\n        if __is_leap(y) { 29 } else { 28 }\n    } else if m == 4 || m == 6 || m == 9 || m == 11 {\n        30\n    } else {\n        31\n    }\n}\n\n// __days_from_civil and __date_from_days: Howard Hinnant's algorithms\n// (days since 1970-01-01 in the proleptic Gregorian calendar).\nfn __days_from_civil(y0: Int, m: Int, d: Int) -> Int {\n    let y = if m <= 2 { y0 - 1 } else { y0 };\n    let era = __time_floor_div(y, 400);\n    let yoe = y - era * 400;\n    let mp = if m > 2 { m - 3 } else { m + 9 };\n    let doy = (153 * mp + 2) / 5 + d - 1;\n    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy;\n    era * 146097 + doe - 719468\n}\n\nfn __date_from_days(z0: Int) -> Date {\n    let z = z0 + 719468;\n    let era = __time_floor_div(z, 146097);\n    let doe = z - era * 146097;\n    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;\n    let doy = doe - (365 * yoe + yoe / 4 - yoe / 100);\n    let mp = (5 * doy + 2) / 153;\n    let d = doy - (153 * mp + 2) / 5 + 1;\n    let m = if mp < 10 { mp + 3 } else { mp - 9 };\n    let y = yoe + era * 400 + if m <= 2 { 1 } else { 0 };\n    Date { __y: y, __m: m, __d: d }\n}\n\nfn __time_digit(c: Int) -> Bool {\n    c >= 48 && c <= 57\n}\n\n// __time_num is the decimal number in s[a..b] (-1 if not all digits).\nfn __time_num(s: String, a: Int, b: Int) -> Int {\n    if b > s.len() {\n        return -1;\n    }\n    let mut x = 0;\n    for j in a..b {\n        let c = s.char_at(j).unwrap_or(0);\n        if !__time_digit(c) {\n            return -1;\n        }\n        x = x * 10 + c - 48;\n    }\n    x\n}\n\n// __time_pad is n with zeros in front to width digits (\"-\" first if\n// negative).\nfn __time_pad(n: Int, width: Int) -> String {\n    let neg = n < 0;\n    let mut s = if neg {\n        (0 - n).to_string()\n    } else {\n        n.to_string()\n    };\n    while s.len() < width {\n        s = \"0\" + s;\n    }\n    if neg { \"-\" + s } else { s }\n}\n",
    );
    core_file(
        v,
        "toml.kek",
        "// TOML (v1.0.0) for Value (lib/core/serde.kek).\n//\n//   Toml::parse(s) -> Result<Value, SerdeError>          the document is a Map\n//   Toml::render(&v) -> Result<String, SerdeError>       v must be a Map\n//   Toml::from_str::<T>(s) -> Result<T, SerdeError>\n//   Toml::to_string(&x) -> Result<String, SerdeError>\n//\n// Floats (also inf and nan) become Value::Float (correctly rounded) and\n// are written with the shortest digits that read back the same (`1.0`,\n// `1e21`, `inf`, `nan`);\n// dates and times become Value::Str as written. TOML has no null: render\n// leaves out the keys whose value is null and refuses null elsewhere.\n// Tables keep the order in which their keys first appear.\n\nstruct Toml {}\n\nimpl Toml {\n    fn parse(s: String) -> Result<Value, SerdeError> {\n        let root = __toml_table(false);\n        let mut p = __TomlParser { s: s, n: s.len(), i: 0 };\n        let mut cur = root;\n        while true {\n            p.blank();\n            if p.i >= p.n {\n                break;\n            }\n            let c = p.peek();\n            if c == 10 || c == 13 || c == 35 {\n                p.end_of_line()?;\n                continue;\n            }\n            if c == 91 {\n                cur = p.header(root)?;\n            } else {\n                p.key_value(cur)?;\n            }\n            p.end_of_line()?;\n        }\n        Ok(__toml_value(root))\n    }\n\n    fn render(v: &Value) -> Result<String, SerdeError> {\n        match v {\n            Value::Map(es) => {\n                let mut out = Vec::new();\n                __toml_render_table(&mut out, \"\", es)?;\n                Ok(out.join(\"\"))\n            }\n            _ => Err(v.mismatch(\"a map (a TOML document is a table)\")),\n        }\n    }\n\n    fn from_str<T: Deserialize>(s: String) -> Result<T, SerdeError> {\n        T::from_value(&Toml::parse(s)?)\n    }\n\n    fn to_string<T: Serialize>(x: &T) -> Result<String, SerdeError> {\n        Toml::render(&x.to_value())\n    }\n}\n\n// ---- the document while it is parsed ----\n\n// A table: header is set once a `[header]` defined it, dotted when dotted\n// keys created it, closed for an inline table (it cannot be extended).\nstruct __TomlTable {\n    keys: Vec<String>,\n    items: HashMap<String, __TomlItem>,\n    mut header: Bool,\n    mut dotted: Bool,\n    mut closed: Bool,\n}\n\nenum __TomlItem {\n    Val(Value),\n    Table(__TomlTable),\n    // `[[name]]`\n    Tables(Vec<__TomlTable>),\n}\n\nfn __toml_table(dotted: Bool) -> __TomlTable {\n    __TomlTable {\n        keys: Vec::new(),\n        items: HashMap::new(),\n        header: false,\n        dotted: dotted,\n        closed: false,\n    }\n}\n\nfn __toml_put(mut t: __TomlTable, k: String, it: __TomlItem) {\n    if !t.items.contains_key(k) {\n        t.keys.push(k);\n    }\n    t.items.insert(k, it);\n}\n\nfn __toml_value(t: __TomlTable) -> Value {\n    let mut es = Vec::new();\n    for k in t.keys.iter() {\n        match t.items.get(k) {\n            Some(__TomlItem::Val(v)) => es.push((k, v)),\n            Some(__TomlItem::Table(x)) => es.push((k, __toml_value(x))),\n            Some(__TomlItem::Tables(xs)) => {\n                let mut seq = Vec::new();\n                for x in xs.iter() {\n                    seq.push(__toml_value(x));\n                }\n                es.push((k, Value::Seq(seq)));\n            }\n            None => {}\n        }\n    }\n    Value::Map(es)\n}\n\nstruct __TomlParser {\n    s: String,\n    n: Int,\n    mut i: Int,\n}\n\nimpl __TomlParser {\n    fn peek(&self) -> Int {\n        self.at(self.i)\n    }\n\n    fn at(&self, j: Int) -> Int {\n        if j < self.n {\n            self.s.char_at(j).unwrap_or(-1)\n        } else {\n            -1\n        }\n    }\n\n    fn fail(&self, msg: String) -> SerdeError {\n        __serde_at(self.s, self.i, msg)\n    }\n\n    fn fail_at(&self, j: Int, msg: String) -> SerdeError {\n        __serde_at(self.s, j, msg)\n    }\n\n    // blank skips spaces and tabs.\n    fn blank(&mut self) {\n        while self.peek() == 32 || self.peek() == 9 {\n            self.i = self.i + 1;\n        }\n    }\n\n    // end_of_line accepts blanks, a comment and the end of the line.\n    fn end_of_line(&mut self) -> Result<(), SerdeError> {\n        self.blank();\n        if self.peek() == 35 {\n            while self.i < self.n && self.peek() != 10 {\n                let c = self.peek();\n                if (c < 32 && c != 9) || c == 127 {\n                    if !(c == 13 && self.at(self.i + 1) == 10) {\n                        return Err(self.fail(\"control character in a comment\"));\n                    }\n                }\n                self.i = self.i + 1;\n            }\n        }\n        if self.peek() == 13 && self.at(self.i + 1) == 10 {\n            self.i = self.i + 2;\n            return Ok(());\n        }\n        if self.peek() == 10 {\n            self.i = self.i + 1;\n            return Ok(());\n        }\n        if self.i >= self.n {\n            return Ok(());\n        }\n        Err(self.fail(\"expected the end of the line\"))\n    }\n\n    // skip_ws skips blanks, newlines and comments (inside arrays).\n    fn skip_ws(&mut self) -> Result<(), SerdeError> {\n        while true {\n            self.blank();\n            let c = self.peek();\n            if c == 10 || c == 35 || (c == 13 && self.at(self.i + 1) == 10) {\n                self.end_of_line()?;\n            } else {\n                return Ok(());\n            }\n        }\n        Ok(())\n    }\n\n    // ---- keys ----\n\n    fn simple_key(&mut self) -> Result<String, SerdeError> {\n        let c = self.peek();\n        if c == 34 {\n            if self.at(self.i + 1) == 34 && self.at(self.i + 2) == 34 {\n                return Err(self.fail(\"a key cannot be a multi-line string\"));\n            }\n            return self.basic_string();\n        }\n        if c == 39 {\n            if self.at(self.i + 1) == 39 && self.at(self.i + 2) == 39 {\n                return Err(self.fail(\"a key cannot be a multi-line string\"));\n            }\n            return self.literal_string();\n        }\n        let start = self.i;\n        while __toml_bare(self.peek()) {\n            self.i = self.i + 1;\n        }\n        if self.i == start {\n            return Err(self.fail(\"expected a key\"));\n        }\n        Ok(self.s.slice(start, self.i))\n    }\n\n    // key is a dotted key `a.b.\"c\"`.\n    fn key(&mut self) -> Result<Vec<String>, SerdeError> {\n        let mut parts = Vec::new();\n        while true {\n            self.blank();\n            parts.push(self.simple_key()?);\n            self.blank();\n            if self.peek() != 46 {\n                return Ok(parts);\n            }\n            self.i = self.i + 1;\n        }\n        Ok(parts)\n    }\n\n    // ---- tables ----\n\n    // header parses `[a.b]` or `[[a.b]]` and returns the table that the\n    // following keys go to.\n    fn header(&mut self, root: __TomlTable) -> Result<__TomlTable, SerdeError> {\n        let start = self.i;\n        let array = self.at(self.i + 1) == 91;\n        self.i = self.i + if array { 2 } else { 1 };\n        let path = self.key()?;\n        if array {\n            if !(self.peek() == 93 && self.at(self.i + 1) == 93) {\n                return Err(self.fail(\"expected `]]`\"));\n            }\n            self.i = self.i + 2;\n        } else {\n            if self.peek() != 93 {\n                return Err(self.fail(\"expected `]`\"));\n            }\n            self.i = self.i + 1;\n        }\n        let mut t = root;\n        let last = path.len() - 1;\n        let mut k = 0;\n        for name in path.iter() {\n            if k == last {\n                break;\n            }\n            t = self.descend(t, name, start)?;\n            k = k + 1;\n        }\n        let name = path.get(last).unwrap_or(\"\");\n        if array {\n            let mut fresh = __toml_table(false);\n            fresh.header = true;\n            match t.items.get(name) {\n                None => {\n                    if t.closed {\n                        return Err(self.fail_at(start, \"cannot extend an inline table\"));\n                    }\n                    let mut xs = Vec::new();\n                    xs.push(fresh);\n                    __toml_put(t, name, __TomlItem::Tables(xs));\n                }\n                Some(__TomlItem::Tables(xs)) => {\n                    let mut ys = xs;\n                    ys.push(fresh);\n                }\n                Some(_) => {\n                    return Err(\n                        self.fail_at(\n                            start,\n                            \"`\" + name + \"` is already defined and not an array of tables\",\n                        ),\n                    );\n                }\n            }\n            return Ok(fresh);\n        }\n        match t.items.get(name) {\n            None => {\n                if t.closed {\n                    return Err(self.fail_at(start, \"cannot extend an inline table\"));\n                }\n                let mut fresh = __toml_table(false);\n                fresh.header = true;\n                __toml_put(t, name, __TomlItem::Table(fresh));\n                Ok(fresh)\n            }\n            Some(__TomlItem::Table(x)) => {\n                if x.header || x.dotted || x.closed {\n                    return Err(self.fail_at(start, \"table `\" + name + \"` is defined twice\"));\n                }\n                let mut y = x;\n                y.header = true;\n                Ok(y)\n            }\n            Some(_) => Err(self.fail_at(start, \"`\" + name + \"` is already defined and not a table\")),\n        }\n    }\n\n    // descend is the table name inside t on the path of a header: created\n    // if missing, the last one of an array of tables.\n    fn descend(\n        &self,\n        mut t: __TomlTable,\n        name: String,\n        at: Int,\n    ) -> Result<__TomlTable, SerdeError> {\n        match t.items.get(name) {\n            None => {\n                if t.closed {\n                    return Err(self.fail_at(at, \"cannot extend an inline table\"));\n                }\n                let fresh = __toml_table(false);\n                __toml_put(t, name, __TomlItem::Table(fresh));\n                Ok(fresh)\n            }\n            Some(__TomlItem::Table(x)) => {\n                if x.closed {\n                    return Err(self.fail_at(at, \"cannot extend an inline table\"));\n                }\n                Ok(x)\n            }\n            Some(__TomlItem::Tables(xs)) => match xs.get(xs.len() - 1) {\n                Some(x) => Ok(x),\n                None => Err(self.fail_at(at, \"empty array of tables\")),\n            },\n            Some(__TomlItem::Val(_)) => Err(self.fail_at(at, \"`\" + name + \"` is not a table\")),\n        }\n    }\n\n    // key_value parses `a.b = v` into t.\n    fn key_value(&mut self, t: __TomlTable) -> Result<(), SerdeError> {\n        let start = self.i;\n        let path = self.key()?;\n        if self.peek() != 61 {\n            return Err(self.fail(\"expected `=` after a key\"));\n        }\n        self.i = self.i + 1;\n        self.blank();\n        let v = self.value(0)?;\n        let mut cur = t;\n        let last = path.len() - 1;\n        let mut k = 0;\n        for name in path.iter() {\n            if k == last {\n                break;\n            }\n            match cur.items.get(name) {\n                None => {\n                    let fresh = __toml_table(true);\n                    __toml_put(cur, name, __TomlItem::Table(fresh));\n                    cur = fresh;\n                }\n                Some(__TomlItem::Table(x)) => {\n                    if !x.dotted || x.closed {\n                        return Err(\n                            self.fail_at(\n                                start,\n                                \"cannot add to table `\" + name + \"` with a dotted key\",\n                            ),\n                        );\n                    }\n                    cur = x;\n                }\n                Some(_) => {\n                    return Err(self.fail_at(start, \"`\" + name + \"` is not a table\"));\n                }\n            }\n            k = k + 1;\n        }\n        let name = path.get(last).unwrap_or(\"\");\n        if cur.items.contains_key(name) {\n            return Err(self.fail_at(start, \"duplicate key `\" + name + \"`\"));\n        }\n        __toml_put(cur, name, v);\n        Ok(())\n    }\n\n    // ---- values ----\n\n    fn value(&mut self, depth: Int) -> Result<__TomlItem, SerdeError> {\n        if depth > 128 {\n            return Err(self.fail(\"nested too deeply\"));\n        }\n        let c = self.peek();\n        if c == 34 {\n            if self.at(self.i + 1) == 34 && self.at(self.i + 2) == 34 {\n                return Ok(__TomlItem::Val(Value::Str(self.ml_basic_string()?)));\n            }\n            return Ok(__TomlItem::Val(Value::Str(self.basic_string()?)));\n        }\n        if c == 39 {\n            if self.at(self.i + 1) == 39 && self.at(self.i + 2) == 39 {\n                return Ok(__TomlItem::Val(Value::Str(self.ml_literal_string()?)));\n            }\n            return Ok(__TomlItem::Val(Value::Str(self.literal_string()?)));\n        }\n        if c == 91 {\n            return self.array(depth);\n        }\n        if c == 123 {\n            return self.inline_table(depth);\n        }\n        Ok(__TomlItem::Val(self.scalar()?))\n    }\n\n    fn array(&mut self, depth: Int) -> Result<__TomlItem, SerdeError> {\n        self.i = self.i + 1;\n        let mut out = Vec::new();\n        while true {\n            self.skip_ws()?;\n            if self.peek() == 93 {\n                self.i = self.i + 1;\n                return Ok(__TomlItem::Val(Value::Seq(out)));\n            }\n            out.push(__toml_item_value(self.value(depth + 1)?));\n            self.skip_ws()?;\n            let c = self.peek();\n            if c == 44 {\n                self.i = self.i + 1;\n            } else if c == 93 {\n                self.i = self.i + 1;\n                return Ok(__TomlItem::Val(Value::Seq(out)));\n            } else {\n                return Err(self.fail(\"expected `,` or `]` in an array\"));\n            }\n        }\n        Err(self.fail(\"unterminated array\"))\n    }\n\n    fn inline_table(&mut self, depth: Int) -> Result<__TomlItem, SerdeError> {\n        self.i = self.i + 1;\n        let mut t = __toml_table(false);\n        self.blank();\n        if self.peek() == 125 {\n            self.i = self.i + 1;\n            t.closed = true;\n            return Ok(__TomlItem::Table(t));\n        }\n        while true {\n            self.blank();\n            let start = self.i;\n            let path = self.key()?;\n            if self.peek() != 61 {\n                return Err(self.fail(\"expected `=` after a key\"));\n            }\n            self.i = self.i + 1;\n            self.blank();\n            let v = self.value(depth + 1)?;\n            let mut cur = t;\n            let last = path.len() - 1;\n            let mut k = 0;\n            for name in path.iter() {\n                if k == last {\n                    break;\n                }\n                match cur.items.get(name) {\n                    None => {\n                        let fresh = __toml_table(true);\n                        __toml_put(cur, name, __TomlItem::Table(fresh));\n                        cur = fresh;\n                    }\n                    Some(__TomlItem::Table(x)) => {\n                        if !x.dotted {\n                            return Err(self.fail_at(start, \"`\" + name + \"` is already defined\"));\n                        }\n                        cur = x;\n                    }\n                    Some(_) => {\n                        return Err(self.fail_at(start, \"`\" + name + \"` is not a table\"));\n                    }\n                }\n                k = k + 1;\n            }\n            let name = path.get(last).unwrap_or(\"\");\n            if cur.items.contains_key(name) {\n                return Err(self.fail_at(start, \"duplicate key `\" + name + \"`\"));\n            }\n            __toml_put(cur, name, v);\n            self.blank();\n            let c = self.peek();\n            if c == 44 {\n                self.i = self.i + 1;\n            } else if c == 125 {\n                self.i = self.i + 1;\n                __toml_close(t);\n                return Ok(__TomlItem::Table(t));\n            } else {\n                return Err(self.fail(\"expected `,` or `}` in an inline table\"));\n            }\n        }\n        Err(self.fail(\"unterminated inline table\"))\n    }\n\n    // ---- strings ----\n\n    fn basic_string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 1;\n        let mut parts = Vec::new();\n        let mut start = self.i;\n        while true {\n            let c = self.peek();\n            if c == 34 {\n                parts.push(self.s.slice(start, self.i));\n                self.i = self.i + 1;\n                return Ok(parts.join(\"\"));\n            }\n            if c < 0 || c == 10 || c == 13 {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            if (c < 32 && c != 9) || c == 127 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            if c == 92 {\n                parts.push(self.s.slice(start, self.i));\n                self.escape(&mut parts)?;\n                start = self.i;\n            } else {\n                self.i = self.i + 1;\n            }\n        }\n        Err(self.fail(\"unterminated string\"))\n    }\n\n    // escape reads the escape at self.i (a backslash) into parts.\n    fn escape(&mut self, mut parts: Vec<String>) -> Result<(), SerdeError> {\n        let e = self.at(self.i + 1);\n        let mut len = 2;\n        if e == 34 {\n            parts.push(\"\\\"\");\n        } else if e == 92 {\n            parts.push(\"\\\\\");\n        } else if e == 98 {\n            parts.push(String::from_char(8));\n        } else if e == 116 {\n            parts.push(\"\\t\");\n        } else if e == 110 {\n            parts.push(\"\\n\");\n        } else if e == 102 {\n            parts.push(String::from_char(12));\n        } else if e == 114 {\n            parts.push(\"\\r\");\n        } else if e == 117 || e == 85 {\n            let nd = if e == 117 { 4 } else { 8 };\n            let mut x = 0;\n            for k in 0..nd {\n                let d = __serde_hex_value(self.at(self.i + 2 + k));\n                if d < 0 {\n                    return Err(self.fail(\"bad unicode escape\"));\n                }\n                x = x * 16 + d;\n            }\n            if x > 1114111 || (x >= 55296 && x <= 57343) {\n                return Err(self.fail(\"the escape is not a Unicode scalar value\"));\n            }\n            __serde_code_point(parts, x);\n            len = 2 + nd;\n        } else {\n            return Err(self.fail(\"bad escape\"));\n        }\n        self.i = self.i + len;\n        Ok(())\n    }\n\n    // newline_at is the length of the newline at j (0 if none).\n    fn newline_at(&self, j: Int) -> Int {\n        if self.at(j) == 10 {\n            1\n        } else if self.at(j) == 13 && self.at(j + 1) == 10 {\n            2\n        } else {\n            0\n        }\n    }\n\n    fn ml_basic_string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 3;\n        self.i = self.i + self.newline_at(self.i);\n        let mut parts = Vec::new();\n        let mut start = self.i;\n        while true {\n            let c = self.peek();\n            if c < 0 {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            if c == 34 && self.at(self.i + 1) == 34 && self.at(self.i + 2) == 34 {\n                // up to two more quotes belong to the string\n                let mut end = self.i;\n                while self.at(end + 3) == 34 && end < self.i + 2 {\n                    end = end + 1;\n                }\n                parts.push(self.s.slice(start, end));\n                self.i = end + 3;\n                return Ok(parts.join(\"\"));\n            }\n            if c == 92 {\n                parts.push(self.s.slice(start, self.i));\n                // a backslash at the end of a line trims the whitespace\n                let mut j = self.i + 1;\n                while self.at(j) == 32 || self.at(j) == 9 {\n                    j = j + 1;\n                }\n                if self.newline_at(j) > 0 {\n                    while self.at(j) == 32 || self.at(j) == 9 || self.newline_at(j) > 0 {\n                        j = j + if self.newline_at(j) > 0 {\n                            self.newline_at(j)\n                        } else {\n                            1\n                        };\n                    }\n                    self.i = j;\n                } else {\n                    self.escape(&mut parts)?;\n                }\n                start = self.i;\n                continue;\n            }\n            if (c < 32 && c != 9 && c != 10 && c != 13) || c == 127 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            if c == 13 && self.at(self.i + 1) != 10 {\n                return Err(self.fail(\"bare carriage return in a string\"));\n            }\n            self.i = self.i + 1;\n        }\n        Err(self.fail(\"unterminated string\"))\n    }\n\n    fn literal_string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 1;\n        let start = self.i;\n        while true {\n            let c = self.peek();\n            if c == 39 {\n                let s = self.s.slice(start, self.i);\n                self.i = self.i + 1;\n                return Ok(s);\n            }\n            if c < 0 || c == 10 || c == 13 {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            if (c < 32 && c != 9) || c == 127 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            self.i = self.i + 1;\n        }\n        Err(self.fail(\"unterminated string\"))\n    }\n\n    fn ml_literal_string(&mut self) -> Result<String, SerdeError> {\n        self.i = self.i + 3;\n        self.i = self.i + self.newline_at(self.i);\n        let start = self.i;\n        while true {\n            let c = self.peek();\n            if c < 0 {\n                return Err(self.fail(\"unterminated string\"));\n            }\n            if c == 39 && self.at(self.i + 1) == 39 && self.at(self.i + 2) == 39 {\n                let mut end = self.i;\n                while self.at(end + 3) == 39 && end < self.i + 2 {\n                    end = end + 1;\n                }\n                let s = self.s.slice(start, end);\n                self.i = end + 3;\n                return Ok(s);\n            }\n            if (c < 32 && c != 9 && c != 10 && c != 13) || c == 127 {\n                return Err(self.fail(\"control character in a string\"));\n            }\n            self.i = self.i + 1;\n        }\n        Err(self.fail(\"unterminated string\"))\n    }\n\n    // ---- numbers, booleans, dates ----\n\n    fn scalar(&mut self) -> Result<Value, SerdeError> {\n        let start = self.i;\n        while __toml_scalar_char(self.peek()) {\n            self.i = self.i + 1;\n        }\n        // `1979-05-27 07:32:00`: a space may separate a date and a time\n        if self.peek() == 32\n            && self.i - start == 10\n            && __toml_is_date(self.s.slice(start, self.i))\n            && __toml_digit(self.at(self.i + 1))\n            && __toml_digit(self.at(self.i + 2))\n            && self.at(self.i + 3) == 58 {\n            self.i = self.i + 1;\n            while __toml_scalar_char(self.peek()) {\n                self.i = self.i + 1;\n            }\n        }\n        let t = self.s.slice(start, self.i);\n        if t == \"\" {\n            return Err(self.fail(\"expected a value\"));\n        }\n        if t == \"true\" {\n            return Ok(Value::Bool(true));\n        }\n        if t == \"false\" {\n            return Ok(Value::Bool(false));\n        }\n        if t == \"inf\" || t == \"+inf\" || t == \"-inf\" || t == \"nan\" || t == \"+nan\" || t == \"-nan\" {\n            let x = if t.ends_with(\"nan\") {\n                Float::NAN\n            } else if t == \"-inf\" {\n                Float::NEG_INFINITY\n            } else {\n                Float::INFINITY\n            };\n            return Ok(Value::Float(x));\n        }\n        if __toml_is_date(t.slice(0, 10)) || (t.len() >= 8 && t.char_at(2).unwrap_or(0) == 58) {\n            if __toml_datetime_ok(t) {\n                return Ok(Value::Str(t));\n            }\n            return Err(self.fail_at(start, \"bad date or time\"));\n        }\n        match __toml_number(t) {\n            Some(v) => Ok(v),\n            None => Err(self.fail_at(start, \"bad value `\" + t + \"`\")),\n        }\n    }\n}\n\nfn __toml_close(mut t: __TomlTable) {\n    t.closed = true;\n    for k in t.keys.iter() {\n        match t.items.get(k) {\n            Some(__TomlItem::Table(x)) => __toml_close(x),\n            _ => {}\n        }\n    }\n}\n\nfn __toml_item_value(it: __TomlItem) -> Value {\n    match it {\n        __TomlItem::Val(v) => v,\n        __TomlItem::Table(t) => __toml_value(t),\n        __TomlItem::Tables(xs) => {\n            let mut seq = Vec::new();\n            for x in xs.iter() {\n                seq.push(__toml_value(x));\n            }\n            Value::Seq(seq)\n        }\n    }\n}\n\nfn __toml_bare(c: Int) -> Bool {\n    (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95 || c == 45\n}\n\nfn __toml_digit(c: Int) -> Bool {\n    c >= 48 && c <= 57\n}\n\nfn __toml_scalar_char(c: Int) -> Bool {\n    __toml_bare(c) || c == 43 || c == 46 || c == 58\n}\n\nfn __toml_digits(s: String, a: Int, b: Int) -> Bool {\n    if a >= b || b > s.len() {\n        return false;\n    }\n    for j in a..b {\n        if !__toml_digit(s.char_at(j).unwrap_or(0)) {\n            return false;\n        }\n    }\n    true\n}\n\n// __toml_is_date: `YYYY-MM-DD`.\nfn __toml_is_date(s: String) -> Bool {\n    s.len() == 10\n        && __toml_digits(s, 0, 4)\n        && s.char_at(4).unwrap_or(0) == 45\n        && __toml_digits(s, 5, 7)\n        && s.char_at(7).unwrap_or(0) == 45\n        && __toml_digits(s, 8, 10)\n}\n\n// __toml_is_time: `HH:MM:SS` with an optional fraction.\nfn __toml_is_time(s: String) -> Bool {\n    if s.len() < 8 {\n        return false;\n    }\n    if !(__toml_digits(s, 0, 2)\n        && s.char_at(2).unwrap_or(0) == 58\n        && __toml_digits(s, 3, 5)\n        && s.char_at(5).unwrap_or(0) == 58\n        && __toml_digits(s, 6, 8)) {\n        return false;\n    }\n    // TOML allows a leap second (60); Timestamp does not\n    if __time_num(s, 0, 2) > 23 || __time_num(s, 3, 5) > 59 || __time_num(s, 6, 8) > 60 {\n        return false;\n    }\n    if s.len() == 8 {\n        return true;\n    }\n    s.char_at(8).unwrap_or(0) == 46 && __toml_digits(s, 9, s.len())\n}\n\n// __toml_datetime_ok accepts the four date and time forms.\nfn __toml_datetime_ok(t: String) -> Bool {\n    if __toml_is_time(t) {\n        return true;\n    }\n    if !__toml_is_date(t.slice(0, 10)) || Date::parse(t.slice(0, 10)).is_err() {\n        return false;\n    }\n    if t.len() == 10 {\n        return true;\n    }\n    let sep = t.char_at(10).unwrap_or(0);\n    if !(sep == 84 || sep == 116 || sep == 32) {\n        return false;\n    }\n    let rest = t.slice(11, t.len());\n    // an offset: Z, or +HH:MM / -HH:MM\n    let n = rest.len();\n    let mut time = rest;\n    if n > 0 && (rest.char_at(n - 1).unwrap_or(0) == 90 || rest.char_at(n - 1).unwrap_or(0) == 122) {\n        time = rest.slice(0, n - 1);\n    } else if n >= 6 {\n        let o = rest.char_at(n - 6).unwrap_or(0);\n        if (o == 43 || o == 45)\n            && __toml_digits(rest, n - 5, n - 3)\n            && rest.char_at(n - 3).unwrap_or(0) == 58\n            && __toml_digits(rest, n - 2, n) {\n            time = rest.slice(0, n - 6);\n        }\n    }\n    __toml_is_time(time)\n}\n\n// __toml_clean checks that every `_` in s is between two digits of the\n// given base and removes them; \"\" if s is not well formed.\nfn __toml_clean(s: String, base: Int) -> String {\n    let mut parts = Vec::new();\n    let mut start = 0;\n    let n = s.len();\n    for j in 0..n {\n        if s.char_at(j).unwrap_or(0) == 95 {\n            if j == 0 || j == n - 1 {\n                return \"\";\n            }\n            if __toml_digit_value(s.char_at(j - 1).unwrap_or(0)) < 0\n                || __toml_digit_value(s.char_at(j + 1).unwrap_or(0)) < 0 {\n                return \"\";\n            }\n            parts.push(s.slice(start, j));\n            start = j + 1;\n        }\n    }\n    parts.push(s.slice(start, n));\n    let out = parts.join(\"\");\n    if base == 16 {\n        for j in 0..out.len() {\n            if __serde_hex_value(out.char_at(j).unwrap_or(0)) < 0 {\n                return \"\";\n            }\n        }\n    }\n    out\n}\n\nfn __toml_digit_value(c: Int) -> Int {\n    __serde_hex_value(c)\n}\n\n// __toml_radix parses the digits of s in base b (no sign).\nfn __toml_radix(s: String, b: Int) -> Option<Int> {\n    if s == \"\" {\n        return None;\n    }\n    let mut x = 0;\n    for j in 0..s.len() {\n        let d = __serde_hex_value(s.char_at(j).unwrap_or(0));\n        if d < 0 || d >= b {\n            return None;\n        }\n        // overflow: x * b + d must stay below 2^63\n        if x > (9223372036854775807 - d) / b {\n            return None;\n        }\n        x = x * b + d;\n    }\n    Some(x)\n}\n\nfn __toml_number(t: String) -> Option<Value> {\n    if t.starts_with(\"0x\") || t.starts_with(\"0o\") || t.starts_with(\"0b\") {\n        let b = if t.starts_with(\"0x\") {\n            16\n        } else if t.starts_with(\"0o\") { 8 } else { 2 };\n        let digits = __toml_clean(t.slice(2, t.len()), b);\n        return match __toml_radix(digits, b) {\n            Some(x) => Some(Value::Int(x)),\n            None => None,\n        };\n    }\n    let mut body = t;\n    if t.starts_with(\"+\") || t.starts_with(\"-\") {\n        body = t.slice(1, t.len());\n    }\n    if body == \"\" || !__toml_digit(body.char_at(0).unwrap_or(0)) {\n        return None;\n    }\n    let float = body.contains(\".\") || body.contains(\"e\") || body.contains(\"E\");\n    // no leading zeros in the integer part\n    let int_end = match body.index_of(\".\") {\n        Some(k) => k,\n        None => match body.index_of(\"e\") {\n            Some(k) => k,\n            None => match body.index_of(\"E\") {\n                Some(k) => k,\n                None => body.len(),\n            },\n        },\n    };\n    if int_end > 1 && body.char_at(0).unwrap_or(0) == 48 {\n        return None;\n    }\n    if !float {\n        let d = __toml_clean(body, 10);\n        if !__toml_digits(d, 0, d.len()) {\n            return None;\n        }\n        let sign = if t.starts_with(\"-\") { \"-\" } else { \"\" };\n        return match (sign + d).parse_int() {\n            Some(x) => Some(Value::Int(x)),\n            None => None,\n        };\n    }\n    // a float: int [. digits] [e [+-] digits], `_` between digits\n    let mut clean = Vec::new();\n    let mut j = 0;\n    let n = body.len();\n    let mut start = 0;\n    while j < n {\n        let c = body.char_at(j).unwrap_or(0);\n        if c == 95 {\n            if !(j > 0\n                && __toml_digit(body.char_at(j - 1).unwrap_or(0))\n                && __toml_digit(body.char_at(j + 1).unwrap_or(0))) {\n                return None;\n            }\n            clean.push(body.slice(start, j));\n            start = j + 1;\n        }\n        j = j + 1;\n    }\n    clean.push(body.slice(start, n));\n    let f = clean.join(\"\");\n    if !__toml_float_ok(f) {\n        return None;\n    }\n    let sign = if t.starts_with(\"-\") {\n        \"-\"\n    } else if t.starts_with(\"+\") { \"+\" } else { \"\" };\n    match __flt_parse(sign + f) {\n        Some(b) => {\n            if b.bit_and(9223372036854775807) == 9218868437227405312 {\n                // out of range\n                None\n            } else {\n                Some(Value::Float(Float::from_bits(b)))\n            }\n        }\n        None => None,\n    }\n}\n\nfn __toml_float_ok(f: String) -> Bool {\n    let mut j = 0;\n    let n = f.len();\n    while j < n && __toml_digit(f.char_at(j).unwrap_or(0)) {\n        j = j + 1;\n    }\n    if j == 0 {\n        return false;\n    }\n    if j < n && f.char_at(j).unwrap_or(0) == 46 {\n        j = j + 1;\n        let a = j;\n        while j < n && __toml_digit(f.char_at(j).unwrap_or(0)) {\n            j = j + 1;\n        }\n        if j == a {\n            return false;\n        }\n    }\n    if j < n && (f.char_at(j).unwrap_or(0) == 101 || f.char_at(j).unwrap_or(0) == 69) {\n        j = j + 1;\n        if j < n && (f.char_at(j).unwrap_or(0) == 43 || f.char_at(j).unwrap_or(0) == 45) {\n            j = j + 1;\n        }\n        let a = j;\n        while j < n && __toml_digit(f.char_at(j).unwrap_or(0)) {\n            j = j + 1;\n        }\n        if j == a {\n            return false;\n        }\n    }\n    j == n\n}\n\n// ---- rendering ----\n\nfn __toml_key(k: String) -> String {\n    if k == \"\" {\n        return \"\\\"\\\"\";\n    }\n    for j in 0..k.len() {\n        if !__toml_bare(k.char_at(j).unwrap_or(0)) {\n            return __serde_quote(k);\n        }\n    }\n    k\n}\n\n// __toml_tables reports whether v is rendered as `[[name]]` sections: a\n// non-empty sequence of maps.\nfn __toml_tables(v: &Value) -> Bool {\n    match v {\n        Value::Seq(xs) => {\n            if xs.len() == 0 {\n                return false;\n            }\n            for x in xs.iter() {\n                match x {\n                    Value::Map(_) => {}\n                    _ => {\n                        return false;\n                    }\n                }\n            }\n            true\n        }\n        _ => false,\n    }\n}\n\n// __toml_render_table writes the entries of the table at path (dotted,\n// \"\" for the document): plain keys first, then sub-tables and arrays of\n// tables.\nfn __toml_render_table(\n    mut out: Vec<String>,\n    path: String,\n    es: &Vec<(String, Value)>,\n) -> Result<(), SerdeError> {\n    for e in es.iter() {\n        match &e.1 {\n            Value::Null => {}\n            Value::Map(_) => {}\n            v => {\n                if !__toml_tables(v) {\n                    out.push(__toml_key(e.0) + \" = \");\n                    match __toml_inline(&mut out, v) {\n                        Ok(_) => {}\n                        Err(err) => {\n                            return Err(err.in_field(e.0));\n                        }\n                    }\n                    out.push(\"\\n\");\n                }\n            }\n        }\n    }\n    for e in es.iter() {\n        let sub = if path == \"\" {\n            __toml_key(e.0)\n        } else {\n            path + \".\" + __toml_key(e.0)\n        };\n        match &e.1 {\n            Value::Map(inner) => {\n                // a table of tables only needs the headers of its tables\n                if __toml_has_plain(inner) || !__toml_has_tables(inner) {\n                    if out.len() > 0 {\n                        out.push(\"\\n\");\n                    }\n                    out.push(\"[\" + sub + \"]\\n\");\n                }\n                match __toml_render_table(out, sub, inner) {\n                    Ok(_) => {}\n                    Err(err) => {\n                        return Err(err.in_field(e.0));\n                    }\n                }\n            }\n            Value::Seq(xs) => {\n                if __toml_tables(&e.1) {\n                    let mut i = 0;\n                    for x in xs.iter() {\n                        match x {\n                            Value::Map(inner) => {\n                                if out.len() > 0 {\n                                    out.push(\"\\n\");\n                                }\n                                out.push(\"[[\" + sub + \"]]\\n\");\n                                match __toml_render_table(out, sub, inner) {\n                                    Ok(_) => {}\n                                    Err(err) => {\n                                        return Err(err.in_index(i).in_field(e.0));\n                                    }\n                                }\n                            }\n                            _ => {}\n                        }\n                        i = i + 1;\n                    }\n                }\n            }\n            _ => {}\n        }\n    }\n    Ok(())\n}\n\nfn __toml_has_plain(es: &Vec<(String, Value)>) -> Bool {\n    for e in es.iter() {\n        match &e.1 {\n            Value::Null => {}\n            Value::Map(_) => {}\n            v => {\n                if !__toml_tables(v) {\n                    return true;\n                }\n            }\n        }\n    }\n    false\n}\n\nfn __toml_has_tables(es: &Vec<(String, Value)>) -> Bool {\n    for e in es.iter() {\n        match &e.1 {\n            Value::Map(_) => {\n                return true;\n            }\n            v => {\n                if __toml_tables(v) {\n                    return true;\n                }\n            }\n        }\n    }\n    false\n}\n\n// __toml_float writes a float: shortest digits with a fraction or an\n// exponent, `inf`, `-inf`, `nan`.\nfn __toml_float(f: Float) -> String {\n    if f.is_nan() {\n        return \"nan\";\n    }\n    if f.is_infinite() {\n        return if f > 0.0 { \"inf\" } else { \"-inf\" };\n    }\n    __flt_debug(f.to_bits())\n}\n\n// __toml_inline writes v as an inline value (arrays and inline tables).\nfn __toml_inline(mut out: Vec<String>, v: &Value) -> Result<(), SerdeError> {\n    match v {\n        Value::Null => {\n            return Err(SerdeError::new(\"TOML has no null\"));\n        }\n        Value::Bool(b) => out.push(if b { \"true\" } else { \"false\" }),\n        Value::Int(n) => out.push(n.to_string()),\n        Value::Float(f) => out.push(__toml_float(f)),\n        Value::Str(s) => {\n            // dates and times read as strings, so they are written back\n            // as TOML dates and times (Timestamp, Date)\n            if __toml_datetime_ok(s) && s.len() >= 10 {\n                out.push(s);\n            } else {\n                out.push(__serde_quote(s));\n            }\n        }\n        Value::Seq(xs) => {\n            out.push(\"[\");\n            let mut i = 0;\n            for x in xs.iter() {\n                if i > 0 {\n                    out.push(\", \");\n                }\n                match __toml_inline(out, x) {\n                    Ok(_) => {}\n                    Err(err) => {\n                        return Err(err.in_index(i));\n                    }\n                }\n                i = i + 1;\n            }\n            out.push(\"]\");\n        }\n        Value::Map(es) => {\n            out.push(\"{\");\n            let mut first = true;\n            for e in es.iter() {\n                match &e.1 {\n                    Value::Null => {}\n                    x => {\n                        out.push(if first { \" \" } else { \", \" });\n                        first = false;\n                        out.push(__toml_key(e.0) + \" = \");\n                        match __toml_inline(out, x) {\n                            Ok(_) => {}\n                            Err(err) => {\n                                return Err(err.in_field(e.0));\n                            }\n                        }\n                    }\n                }\n            }\n            out.push(if first { \"}\" } else { \" }\" });\n        }\n    }\n    Ok(())\n}\n",
    );
    core_file(
        v,
        "vec.kek",
        "// Methods of Vec, as in Rust's Vec and slice (`push`, `get`, `set`, `pop`,\n// `len` and `join` are builtins, `iter` is in iter.kek).\n//\n// Nothing panics. A position between elements (`insert`, `split_off`,\n// `truncate`, `resize`, the bounds of `slice`) is clamped to [0, len]; an\n// element index (`remove`, `swap`) that is out of range gives None or does\n// nothing. A chunk or window size below 1 gives no chunks.\n\nimpl<T> Vec<T> {\n    fn with_capacity(n: Int) -> Vec<T> {\n        Vec::new()\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.len() == 0\n    }\n\n    fn first(&self) -> Option<T> {\n        self.get(0)\n    }\n\n    fn last(&self) -> Option<T> {\n        self.get(self.len() - 1)\n    }\n\n    // insert puts x at index i, shifting the later elements right; i is\n    // clamped to [0, len] (Rust panics when i > len).\n    fn insert(&mut self, i: Int, x: T) {\n        let n = self.len();\n        let at = if i < 0 {\n            0\n        } else if i > n { n } else { i };\n        self.push(x);\n        let mut j = n;\n        while j > at {\n            match self.get(j - 1) {\n                Some(y) => {\n                    self.set(j, y);\n                }\n                None => {}\n            }\n            j = j - 1;\n        }\n        self.set(at, x);\n    }\n\n    // remove takes out the element at i, shifting the later elements left.\n    fn remove(&mut self, i: Int) -> Option<T> {\n        let n = self.len();\n        if i < 0 || i >= n {\n            return None;\n        }\n        let x = self.get(i);\n        let mut j = i;\n        while j + 1 < n {\n            match self.get(j + 1) {\n                Some(y) => {\n                    self.set(j, y);\n                }\n                None => {}\n            }\n            j = j + 1;\n        }\n        self.pop();\n        x\n    }\n\n    // swap_remove takes out the element at i, putting the last element in\n    // its place (O(1), does not keep the order).\n    fn swap_remove(&mut self, i: Int) -> Option<T> {\n        let n = self.len();\n        if i < 0 || i >= n {\n            return None;\n        }\n        let x = self.get(i);\n        match self.pop() {\n            Some(y) => {\n                if i < n - 1 {\n                    self.set(i, y);\n                }\n            }\n            None => {}\n        }\n        x\n    }\n\n    // swap exchanges the elements at i and j (nothing when either is out of\n    // range).\n    fn swap(&mut self, i: Int, j: Int) {\n        match self.get(i) {\n            Some(a) => match self.get(j) {\n                Some(b) => {\n                    self.set(i, b);\n                    self.set(j, a);\n                }\n                None => {}\n            },\n            None => {}\n        }\n    }\n\n    fn reverse(&mut self) {\n        let mut i = 0;\n        let mut j = self.len() - 1;\n        while i < j {\n            self.swap(i, j);\n            i = i + 1;\n            j = j - 1;\n        }\n    }\n\n    // truncate keeps the first n elements.\n    fn truncate(&mut self, n: Int) {\n        let keep = if n < 0 { 0 } else { n };\n        while self.len() > keep {\n            self.pop();\n        }\n    }\n\n    fn clear(&mut self) {\n        self.truncate(0);\n    }\n\n    fn extend<I: Iterator<Item = T>>(&mut self, mut iter: I) {\n        while let Some(x) = iter.next() {\n            self.push(x);\n        }\n    }\n\n    // append moves the elements of other to the end of self, leaving other\n    // empty.\n    fn append(&mut self, other: &mut Vec<T>) {\n        let n = other.len();\n        let mut i = 0;\n        while i < n {\n            match other.get(i) {\n                Some(x) => self.push(x),\n                None => {}\n            }\n            i = i + 1;\n        }\n        other.truncate(0);\n    }\n\n    // split_off returns the elements from index at on, leaving the first\n    // `at` in self; at is clamped to [0, len].\n    #[fresh]\n    fn split_off(&mut self, at: Int) -> Vec<T> {\n        let tail = self.slice(at, self.len());\n        let n = self.len() - tail.len();\n        self.truncate(n);\n        tail\n    }\n\n    // slice returns a new Vec of the elements in [a, b), like\n    // `v[a..b].to_vec()` in Rust; the bounds are clamped to [0, len] (as\n    // String::slice).\n    #[fresh]\n    fn slice(&self, a: Int, b: Int) -> Vec<T> {\n        let n = self.len();\n        let lo = if a < 0 {\n            0\n        } else if a > n { n } else { a };\n        let hi = if b < 0 {\n            0\n        } else if b > n { n } else { b };\n        let mut out = Vec::new();\n        let mut i = lo;\n        while i < hi {\n            match self.get(i) {\n                Some(x) => out.push(x),\n                None => {}\n            }\n            i = i + 1;\n        }\n        out\n    }\n\n    fn retain(&mut self, f: impl Fn(&T) -> Bool) {\n        let n = self.len();\n        let mut k = 0;\n        let mut i = 0;\n        while i < n {\n            match self.get(i) {\n                Some(x) => {\n                    if f(&x) {\n                        self.set(k, x);\n                        k = k + 1;\n                    }\n                }\n                None => {}\n            }\n            i = i + 1;\n        }\n        self.truncate(k);\n    }\n\n    // dedup_by_key removes consecutive elements with the same key.\n    fn dedup_by_key<K: PartialEq>(&mut self, f: impl Fn(&T) -> K) {\n        self.dedup_by(|a, b| f(a) == f(b));\n    }\n\n    // dedup_by removes each element for which same(x, previous kept) holds.\n    fn dedup_by(&mut self, same: impl Fn(&T, &T) -> Bool) {\n        let n = self.len();\n        if n <= 1 {\n            return;\n        }\n        let mut k = 1;\n        let mut i = 1;\n        while i < n {\n            match self.get(i) {\n                Some(x) => match self.get(k - 1) {\n                    Some(prev) => {\n                        if !same(&x, &prev) {\n                            self.set(k, x);\n                            k = k + 1;\n                        }\n                    }\n                    None => {}\n                },\n                None => {}\n            }\n            i = i + 1;\n        }\n        self.truncate(k);\n    }\n\n    // sort_by sorts with a comparison, keeping the order of equal elements\n    // (a merge sort: O(n log n)).\n    fn sort_by(&mut self, cmp: impl Fn(&T, &T) -> Ordering) {\n        let n = self.len();\n        if n <= 1 {\n            return;\n        }\n        let mut src = self.slice(0, n);\n        let mut dst = self.slice(0, n);\n        let mut width = 1;\n        while width < n {\n            let mut lo = 0;\n            while lo < n {\n                let mid = if lo + width < n { lo + width } else { n };\n                let hi = if mid + width < n { mid + width } else { n };\n                let mut i = lo;\n                let mut j = mid;\n                let mut k = lo;\n                while k < hi {\n                    let take_left = if i >= mid {\n                        false\n                    } else if j >= hi {\n                        true\n                    } else {\n                        match src.get(i) {\n                            Some(a) => match src.get(j) {\n                                Some(b) => !cmp(&b, &a).is_lt(),\n                                None => true,\n                            },\n                            None => false,\n                        }\n                    };\n                    let from = if take_left { i } else { j };\n                    match src.get(from) {\n                        Some(x) => {\n                            dst.set(k, x);\n                        }\n                        None => {}\n                    }\n                    if take_left {\n                        i = i + 1;\n                    } else {\n                        j = j + 1;\n                    }\n                    k = k + 1;\n                }\n                lo = hi;\n            }\n            let t = src;\n            src = dst;\n            dst = t;\n            width = width * 2;\n        }\n        let mut i = 0;\n        while i < n {\n            match src.get(i) {\n                Some(x) => {\n                    self.set(i, x);\n                }\n                None => {}\n            }\n            i = i + 1;\n        }\n    }\n\n    // sort_by_key sorts by a key, keeping the order of equal keys (the key\n    // is computed for each comparison, as in Rust).\n    fn sort_by_key<K: Ord>(&mut self, f: impl Fn(&T) -> K) {\n        self.sort_by(|a, b| f(a).cmp(&f(b)));\n    }\n\n    // The unstable sorts are the stable ones.\n    fn sort_unstable_by(&mut self, cmp: impl Fn(&T, &T) -> Ordering) {\n        self.sort_by(cmp);\n    }\n\n    fn sort_unstable_by_key<K: Ord>(&mut self, f: impl Fn(&T) -> K) {\n        self.sort_by(|a, b| f(a).cmp(&f(b)));\n    }\n\n    // binary_search_by searches a Vec sorted consistently with f, which\n    // compares an element with the target: Ok(index of a match) or\n    // Err(the index where it could be inserted keeping the order).\n    fn binary_search_by(&self, f: impl Fn(&T) -> Ordering) -> Result<Int, Int> {\n        let mut lo = 0;\n        let mut hi = self.len();\n        while lo < hi {\n            let mid = lo + (hi - lo) / 2;\n            match self.get(mid) {\n                Some(x) => match f(&x) {\n                    Ordering::Less => {\n                        lo = mid + 1;\n                    }\n                    Ordering::Greater => {\n                        hi = mid;\n                    }\n                    Ordering::Equal => {\n                        return Ok(mid);\n                    }\n                },\n                None => {\n                    return Err(lo);\n                }\n            }\n        }\n        Err(lo)\n    }\n\n    fn binary_search_by_key<K: Ord>(&self, key: &K, f: impl Fn(&T) -> K) -> Result<Int, Int> {\n        self.binary_search_by(|x| f(x).cmp(key))\n    }\n\n    // partition_point returns the index of the first element for which p is\n    // false (the Vec is partitioned: all true, then all false).\n    fn partition_point(&self, p: impl Fn(&T) -> Bool) -> Int {\n        let mut lo = 0;\n        let mut hi = self.len();\n        while lo < hi {\n            let mid = lo + (hi - lo) / 2;\n            match self.get(mid) {\n                Some(x) => {\n                    if p(&x) {\n                        lo = mid + 1;\n                    } else {\n                        hi = mid;\n                    }\n                }\n                None => {\n                    return lo;\n                }\n            }\n        }\n        lo\n    }\n\n    // chunks splits into Vecs of n elements (the last may be shorter).\n    #[fresh]\n    fn chunks(&self, n: Int) -> Vec<Vec<T>> {\n        let mut out = Vec::new();\n        if n < 1 {\n            return out;\n        }\n        let len = self.len();\n        let mut i = 0;\n        while i < len {\n            out.push(self.slice(i, i + n));\n            i = i + n;\n        }\n        out\n    }\n\n    // windows returns every run of n consecutive elements.\n    #[fresh]\n    fn windows(&self, n: Int) -> Vec<Vec<T>> {\n        let mut out = Vec::new();\n        if n < 1 {\n            return out;\n        }\n        let len = self.len();\n        let mut i = 0;\n        while i + n <= len {\n            out.push(self.slice(i, i + n));\n            i = i + 1;\n        }\n        out\n    }\n\n    // rotate_left moves the first k elements to the end (k is taken modulo\n    // len, so a negative k rotates right).\n    fn rotate_left(&mut self, k: Int) {\n        let n = self.len();\n        if n <= 1 {\n            return;\n        }\n        let r = k.rem_euclid(n);\n        if r == 0 {\n            return;\n        }\n        let mut rotated = self.slice(r, n);\n        let mut head = self.slice(0, r);\n        rotated.append(&mut head);\n        let mut i = 0;\n        while i < n {\n            match rotated.get(i) {\n                Some(x) => {\n                    self.set(i, x);\n                }\n                None => {}\n            }\n            i = i + 1;\n        }\n    }\n\n    fn rotate_right(&mut self, k: Int) {\n        self.rotate_left(0 - k.rem_euclid(self.len().max(1)));\n    }\n}\n\nimpl<T: Clone> Vec<T> {\n    // extend_from_slice pushes copies of the elements of other.\n    fn extend_from_slice(&mut self, other: &Vec<T>) {\n        for x in other.iter() {\n            self.push(x.clone());\n        }\n    }\n\n    // fill sets every element to a copy of x.\n    fn fill(&mut self, x: T) {\n        let n = self.len();\n        let mut i = 0;\n        while i < n {\n            self.set(i, x.clone());\n            i = i + 1;\n        }\n    }\n\n    // resize truncates to n elements or pushes copies of x up to n.\n    fn resize(&mut self, n: Int, x: T) {\n        self.truncate(n);\n        while self.len() < n {\n            self.push(x.clone());\n        }\n    }\n\n    // repeat returns n copies of the elements one after another.\n    fn repeat(&self, n: Int) -> Vec<T> {\n        let mut out = Vec::new();\n        let mut k = 0;\n        while k < n {\n            for x in self.iter() {\n                out.push(x.clone());\n            }\n            k = k + 1;\n        }\n        out\n    }\n}\n\nimpl<T: PartialEq> Vec<T> {\n    fn contains(&self, x: &T) -> Bool {\n        for y in self.iter() {\n            if y == x {\n                return true;\n            }\n        }\n        false\n    }\n\n    fn starts_with(&self, prefix: &Vec<T>) -> Bool {\n        let k = prefix.len();\n        if k > self.len() {\n            return false;\n        }\n        self.slice(0, k) == prefix\n    }\n\n    fn ends_with(&self, suffix: &Vec<T>) -> Bool {\n        let n = self.len();\n        let k = suffix.len();\n        if k > n {\n            return false;\n        }\n        self.slice(n - k, n) == suffix\n    }\n\n    // dedup removes consecutive equal elements.\n    fn dedup(&mut self) {\n        self.dedup_by(|a, b| a == b);\n    }\n}\n\nimpl<T: Ord> Vec<T> {\n    // sort sorts in ascending order, keeping the order of equal elements.\n    fn sort(&mut self) {\n        self.sort_by(|a, b| a.cmp(b));\n    }\n\n    fn sort_unstable(&mut self) {\n        self.sort_by(|a, b| a.cmp(b));\n    }\n\n    // binary_search searches a sorted Vec: Ok(index of a match) or Err(the\n    // index where x could be inserted keeping the order).\n    fn binary_search(&self, x: &T) -> Result<Int, Int> {\n        self.binary_search_by(|y| y.cmp(x))\n    }\n}\n\nimpl<T> Vec<Vec<T>> {\n    // concat joins the Vecs into one.\n    #[fresh]\n    fn concat(&self) -> Vec<T> {\n        let mut out = Vec::new();\n        for v in self.iter() {\n            for x in v.iter() {\n                out.push(x);\n            }\n        }\n        out\n    }\n}\n",
    );
    core_file(
        v,
        "vecdeque.kek",
        "// VecDeque, with Rust's API (std::collections): a double-ended queue in a\n// ring buffer. push and pop at both ends are amortized O(1), get(i) is\n// O(1). Like Vec, nothing panics: an index out of range gives None or does\n// nothing.\n\nstruct VecDeque<T> {\n    // slots of the ring (None: free); its length is the capacity\n    mut __buf: Vec<Option<T>>,\n    // the slot of the front element\n    mut __head: Int,\n    mut __len: Int,\n}\n\nimpl<T> VecDeque<T> {\n    fn new() -> VecDeque<T> {\n        VecDeque { __buf: Vec::new(), __head: 0, __len: 0 }\n    }\n\n    fn with_capacity(n: Int) -> VecDeque<T> {\n        let mut d = VecDeque::new();\n        d.__grow_to(n);\n        d\n    }\n\n    fn len(&self) -> Int {\n        self.__len\n    }\n\n    fn is_empty(&self) -> Bool {\n        self.__len == 0\n    }\n\n    fn capacity(&self) -> Int {\n        self.__buf.len()\n    }\n\n    // __slot is the buffer slot of element i (0 <= i < capacity).\n    fn __slot(&self, i: Int) -> Int {\n        let cap = self.__buf.len();\n        let j = self.__head + i;\n        if j >= cap { j - cap } else { j }\n    }\n\n    // __grow_to makes room for n elements, moving them to the start.\n    fn __grow_to(&mut self, n: Int) {\n        let cap = self.__buf.len();\n        if n <= cap {\n            return;\n        }\n        let mut ncap = if cap < 4 { 4 } else { cap };\n        while ncap < n {\n            ncap = ncap * 2;\n        }\n        let mut nb = Vec::new();\n        for i in 0..self.__len {\n            nb.push(self.__buf.get(self.__slot(i)).unwrap_or(None));\n        }\n        while nb.len() < ncap {\n            nb.push(None);\n        }\n        self.__buf = nb;\n        self.__head = 0;\n    }\n\n    fn push_back(&mut self, x: T) {\n        self.__grow_to(self.__len + 1);\n        let s = self.__slot(self.__len);\n        self.__buf.set(s, Some(x));\n        self.__len = self.__len + 1;\n    }\n\n    fn push_front(&mut self, x: T) {\n        self.__grow_to(self.__len + 1);\n        let cap = self.__buf.len();\n        self.__head = if self.__head == 0 {\n            cap - 1\n        } else {\n            self.__head - 1\n        };\n        self.__buf.set(self.__head, Some(x));\n        self.__len = self.__len + 1;\n    }\n\n    fn pop_front(&mut self) -> Option<T> {\n        if self.__len == 0 {\n            return None;\n        }\n        let x = self.__buf.get(self.__head).unwrap_or(None);\n        self.__buf.set(self.__head, None);\n        self.__head = self.__slot(1);\n        self.__len = self.__len - 1;\n        if self.__len == 0 {\n            self.__head = 0;\n        }\n        x\n    }\n\n    fn pop_back(&mut self) -> Option<T> {\n        if self.__len == 0 {\n            return None;\n        }\n        let s = self.__slot(self.__len - 1);\n        let x = self.__buf.get(s).unwrap_or(None);\n        self.__buf.set(s, None);\n        self.__len = self.__len - 1;\n        x\n    }\n\n    // get returns element i from the front.\n    fn get(&self, i: Int) -> Option<T> {\n        if i < 0 || i >= self.__len {\n            return None;\n        }\n        self.__buf.get(self.__slot(i)).unwrap_or(None)\n    }\n\n    // set replaces element i, reporting whether it exists (Vec::set).\n    fn set(&mut self, i: Int, x: T) -> Bool {\n        if i < 0 || i >= self.__len {\n            return false;\n        }\n        self.__buf.set(self.__slot(i), Some(x))\n    }\n\n    fn front(&self) -> Option<T> {\n        self.get(0)\n    }\n\n    fn back(&self) -> Option<T> {\n        self.get(self.__len - 1)\n    }\n\n    fn clear(&mut self) {\n        self.__buf = Vec::new();\n        self.__head = 0;\n        self.__len = 0;\n    }\n\n    // swap exchanges elements i and j (nothing if either is out of range).\n    fn swap(&mut self, i: Int, j: Int) {\n        match self.get(i) {\n            Some(a) => match self.get(j) {\n                Some(b) => {\n                    self.set(i, b);\n                    self.set(j, a);\n                }\n                None => {}\n            },\n            None => {}\n        }\n    }\n\n    // truncate keeps the first n elements.\n    fn truncate(&mut self, n: Int) {\n        while self.__len > n && self.__len > 0 {\n            self.pop_back();\n        }\n    }\n\n    // insert puts x at position i (clamped to [0, len]), shifting the\n    // following elements back.\n    fn insert(&mut self, i: Int, x: T) {\n        let at = if i < 0 {\n            0\n        } else if i > self.__len { self.__len } else { i };\n        self.push_back(x);\n        let mut j = self.__len - 1;\n        while j > at {\n            self.swap(j - 1, j);\n            j = j - 1;\n        }\n    }\n\n    // remove removes and returns element i.\n    fn remove(&mut self, i: Int) -> Option<T> {\n        if i < 0 || i >= self.__len {\n            return None;\n        }\n        let mut j = i;\n        while j + 1 < self.__len {\n            self.swap(j, j + 1);\n            j = j + 1;\n        }\n        self.pop_back()\n    }\n\n    fn retain(&mut self, f: impl Fn(T) -> Bool) {\n        let mut keep = Vec::new();\n        while let Some(x) = self.pop_front() {\n            if f(x) {\n                keep.push(x);\n            }\n        }\n        for x in keep {\n            self.push_back(x);\n        }\n    }\n\n    // rotate_left moves the first k elements to the back (k is taken\n    // modulo len).\n    fn rotate_left(&mut self, k: Int) {\n        if self.__len == 0 {\n            return;\n        }\n        let mut n = k.rem_euclid(self.__len);\n        while n > 0 {\n            match self.pop_front() {\n                Some(x) => self.push_back(x),\n                None => {}\n            }\n            n = n - 1;\n        }\n    }\n\n    fn rotate_right(&mut self, k: Int) {\n        if self.__len == 0 {\n            return;\n        }\n        let mut n = k.rem_euclid(self.__len);\n        while n > 0 {\n            match self.pop_back() {\n                Some(x) => self.push_front(x),\n                None => {}\n            }\n            n = n - 1;\n        }\n    }\n\n    fn append(&mut self, other: &mut VecDeque<T>) {\n        while let Some(x) = other.pop_front() {\n            self.push_back(x);\n        }\n    }\n\n    fn extend<I: Iterator<Item = T>>(&mut self, mut iter: I) {\n        while let Some(x) = iter.next() {\n            self.push_back(x);\n        }\n    }\n\n    // iter returns the elements from front to back (both ends). Like Vec's,\n    // it sees elements pushed at the back while iterating.\n    #[fresh]\n    fn iter(&self) -> VecDequeIter<T> {\n        VecDequeIter { __dq: *self, __i: 0, __end: -1 }\n    }\n\n    // make_contiguous returns the elements as a Vec (front first).\n    #[fresh]\n    fn make_contiguous(&self) -> Vec<T> {\n        self.iter().collect()\n    }\n}\n\nimpl<T: PartialEq> VecDeque<T> {\n    fn contains(&self, x: &T) -> Bool {\n        for y in self.iter() {\n            if y == *x {\n                return true;\n            }\n        }\n        false\n    }\n}\n\nstruct VecDequeIter<T> {\n    __dq: VecDeque<T>,\n    mut __i: Int,\n    mut __end: Int,\n}\n\nimpl<T> Iterator for VecDequeIter<T> {\n    type Item = T;\n\n    fn next(&mut self) -> Option<T> {\n        let n = if self.__end < 0 {\n            self.__dq.len()\n        } else {\n            self.__end\n        };\n        if self.__i < n {\n            let x = self.__dq.get(self.__i);\n            self.__i = self.__i + 1;\n            x\n        } else {\n            None\n        }\n    }\n}\n\nimpl<T> DoubleEndedIterator for VecDequeIter<T> {\n    fn next_back(&mut self) -> Option<T> {\n        if self.__end < 0 {\n            self.__end = self.__dq.len();\n        }\n        if self.__i < self.__end {\n            self.__end = self.__end - 1;\n            self.__dq.get(self.__end)\n        } else {\n            None\n        }\n    }\n}\n\nimpl<T> IntoIterator for VecDeque<T> {\n    type Item = T;\n    type IntoIter = VecDequeIter<T>;\n\n    fn into_iter(self) -> VecDequeIter<T> {\n        self.iter()\n    }\n}\n\nimpl<T> FromIterator<T> for VecDeque<T> {\n    fn from_iter<I: Iterator<Item = T>>(iter: I) -> VecDeque<T> {\n        let mut d = VecDeque::new();\n        d.extend(iter);\n        d\n    }\n}\n\nimpl<T: Clone> Clone for VecDeque<T> {\n    fn clone(&self) -> VecDeque<T> {\n        let mut d = VecDeque::with_capacity(self.len());\n        for x in self.iter() {\n            d.push_back(x.clone());\n        }\n        d\n    }\n}\n\nimpl<T: PartialEq> PartialEq for VecDeque<T> {\n    fn eq(&self, other: &VecDeque<T>) -> Bool {\n        self.len() == other.len() && self.iter().eq(other.iter())\n    }\n}\n\nimpl<T: Eq> Eq for VecDeque<T> {}\n\nimpl<T> Default for VecDeque<T> {\n    fn default() -> VecDeque<T> {\n        VecDeque::new()\n    }\n}\n",
    );
    v
}
