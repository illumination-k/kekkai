// Definition hashes (prefix dh_ / Dh*): the identity of every user
// function, shared by `kek hash`, `similar`, the test and build caches,
// `cover`, `mutate` and `assure`.
//
// A definition is walked into a sequence of labels (its normalized syntax
// tree in preorder). Local variables are numbered in declaration order, so
// the hash does not depend on their names (alpha-equivalence); a
// definition's own name is replaced by "self" so that renamed recursive
// functions also hash alike.
//
//   hash        the labels and the signature types
//   hash_lits   the same with the values of literals abstracted
//               (definitions that differ only in constants share it)
//   depths      the depth of each label in the syntax tree (preorder
//               labels + depths give the tree, for tree edit distances)
//   lits        where the literal labels come from
//   trans       hash plus the hashes of every user definition it can reach
//               (calls, methods, trait implementations) and of the type
//               declarations: equal trans means equal behaviour, so it keys
//               the caches

struct DhDef {
    name: String,
    fun: ChkFunc,
    pos: AstPos,
    // the signature without parameter names: "(Int, &Log) -> String"
    sig: String,
    caps: Vec<String>,
    labels: Vec<String>,
    // depth of each label (the root `fn<..>` is 0): labels[i] is a child of
    // the nearest earlier label with depth depths[i] - 1
    depths: Vec<Int>,
    // the literal labels and their source positions
    lits: Vec<DhLit>,
    hash: String,
    hash_lits: String,
    // user definitions referenced directly (sorted, no duplicates)
    deps: Vec<String>,
    mut trans: String,
}

struct DhProgram {
    defs: Vec<DhDef>,
    by_name: HashMap<String, DhDef>,
    types_hash: String,
    // hash of the whole program (every definition's trans hash)
    hash: String,
}

// A literal label: labels[index] comes from the literal at pos.
struct DhLit {
    index: Int,
    pos: AstPos,
}

// Walker state of one definition.
struct DhWalk {
    info: ChkInfo,
    // `Trait::m` -> the user implementations `<T as Trait>::m`
    impls: HashMap<String, Vec<String>>,
    self_name: String,
    labels: Vec<String>,
    depths: Vec<Int>,
    lits: Vec<DhLit>,
    // depth of the next label; node is set when the next label starts a
    // syntax node (the labels after it are its children)
    mut depth: Int,
    mut node: Bool,
    // in-scope locals: name -> declaration number (stack, innermost last)
    scope_names: Vec<String>,
    scope_nums: Vec<Int>,
    mut next_local: Int,
    deps: HashMap<String, Bool>,
}

// ---- hashing ----

// dh_hash_strs hashes a sequence of strings into 32 hex digits (two
// independent 64-bit FNV-1a lanes).
fn dh_hash_strs(xs: Vec<String>) -> String {
    let mut a = DefaultHasher::new();
    let mut b = DefaultHasher::new();
    b.write_i64(-7046029254386353131);
    for s in xs {
        a.write_str(s);
        b.write_str(s);
        b.write_i64(7);
    }
    dh_hex(dh_mix(a.finish())) + dh_hex(dh_mix(b.finish()))
}

fn dh_hash_str(s: String) -> String {
    let mut v = Vec::new();
    v.push(s);
    dh_hash_strs(v)
}

fn dh_mix(h: Int) -> Int {
    let h2 = h.bit_xor(h.ushr(33)) * -49064778989728563;
    let h3 = h2.bit_xor(h2.ushr(33)) * -4265267296055464877;
    h3.bit_xor(h3.ushr(33))
}

// dh_hex renders 64 bits as 16 hex digits.
fn dh_hex(h: Int) -> String {
    let digits = "0123456789abcdef";
    let mut parts = Vec::new();
    let mut i = 60;
    while i >= 0 {
        let d = h.ushr(i).bit_and(15);
        parts.push(digits.slice(d, d + 1));
        i = i - 4;
    }
    parts.join("")
}

// dh_short is the abbreviated form of a hash for human-readable output.
fn dh_short(h: String) -> String {
    h.slice(0, 12)
}

// ---- labels ----

fn dh_emit(mut w: DhWalk, l: String) {
    w.labels.push(l);
    w.depths.push(w.depth);
    if w.node {
        w.node = false;
        w.depth = w.depth + 1;
    }
}

fn dh_lit(mut w: DhWalk, pos: AstPos, l: String) {
    w.lits.push(DhLit { index: w.labels.len(), pos: pos });
    dh_emit(w, l);
}

// dh_enter starts a syntax node: its first label is at the current depth
// and the following ones below it until dh_leave.
fn dh_enter(mut w: DhWalk) -> Int {
    w.node = true;
    w.depth
}

fn dh_leave(mut w: DhWalk, d: Int) {
    w.depth = d;
    w.node = false;
}

fn dh_declare(mut w: DhWalk, name: String) {
    w.scope_names.push(name);
    w.scope_nums.push(w.next_local);
    dh_emit(w, "bind#" + w.next_local.to_string());
    w.next_local = w.next_local + 1;
}

// dh_declare_label numbers a loop label like a local (labels start with
// `'`, so they never meet a variable): renamed labels hash alike.
fn dh_declare_label(w: DhWalk, label: String) {
    if label != "" {
        dh_declare(w, label);
    }
}

// dh_label emits the loop a `break` / `continue` names.
fn dh_label(w: DhWalk, label: String) {
    if label != "" {
        dh_emit(w, "label#" + dh_lookup(w, label).to_string());
    }
}

fn dh_scope_mark(w: DhWalk) -> Int {
    w.scope_names.len()
}

fn dh_scope_reset(mut w: DhWalk, mark: Int) {
    while w.scope_names.len() > mark {
        w.scope_names.pop();
        w.scope_nums.pop();
    }
}

fn dh_lookup(w: DhWalk, name: String) -> Int {
    let mut i = w.scope_names.len() - 1;
    while i >= 0 {
        if w.scope_names.get(i).unwrap_or("") == name {
            return w.scope_nums.get(i).unwrap_or(-1);
        }
        i = i - 1;
    }
    -1
}

fn dh_dep(mut w: DhWalk, name: String) {
    if name != w.self_name {
        w.deps.insert(name, true);
    }
}

fn dh_global(w: DhWalk, name: String) -> String {
    if name == w.self_name {
        return "self";
    }
    name
}

// dh_type renders a syntactic type (generic parameter names included).
fn dh_type(t: AstType) -> String {
    match t {
        AstType::Named(n) => {
            if n.args.len() == 0 {
                return n.name;
            }
            let mut xs = Vec::new();
            for a in n.args {
                xs.push(dh_type(a));
            }
            n.name + "<" + xs.join(",") + ">"
        }
        AstType::Ref(r) => {
            if r.mutable {
                return "&mut " + dh_type(r.elem);
            }
            "&" + dh_type(r.elem)
        }
        AstType::Unit(_) => "()",
        AstType::Tuple(t) => {
            let mut xs = Vec::new();
            for e in t.elems {
                xs.push(dh_type(e));
            }
            "(" + xs.join(",") + ",)"
        }
        AstType::Fn(f) => {
            let mut xs = Vec::new();
            for p in f.params {
                xs.push(dh_type(p));
            }
            let r = match f.result {
                Some(t) => dh_type(t),
                None => "()",
            };
            f.kind + "(" + xs.join(",") + ")->" + r
        }
    }
}

fn dh_opt_type(t: Option<AstType>) -> String {
    match t {
        Some(x) => dh_type(x),
        None => "_",
    }
}

fn dh_pattern(w: DhWalk, p: AstPattern) {
    let d = dh_enter(w);
    dh_pattern_node(w, p);
    dh_leave(w, d);
}

fn dh_pattern_node(w: DhWalk, p: AstPattern) {
    if p.wildcard {
        dh_emit(w, "p_");
        return;
    }
    if p.alts.len() > 0 {
        dh_emit(w, "por/" + p.alts.len().to_string());
        for a in p.alts {
            dh_pattern(w, a);
        }
        return;
    }
    match p.at.get(0) {
        Some(sub) => {
            dh_emit(w, "pat");
            dh_declare(w, p.bind);
            dh_pattern(w, sub);
            return;
        }
        None => {}
    }
    if p.range {
        let mut r = "";
        match p.range_lo {
            Some(n) => {
                r = n.to_string();
            }
            None => {}
        }
        r = r + if p.range_incl { "..=" } else { ".." };
        match p.range_hi {
            Some(n) => {
                r = r + n.to_string();
            }
            None => {}
        }
        dh_lit(w, p.pos, "lit:range=" + r);
        return;
    }
    if p.tuple {
        dh_emit(w, "ptuple/" + p.args.len().to_string());
        for a in p.args {
            dh_pattern(w, a);
        }
        return;
    }
    match p.int_value {
        Some(n) => {
            dh_lit(w, p.pos, "lit:int=" + n.to_string());
            return;
        }
        None => {}
    }
    match p.bool_lit {
        Some(b) => {
            dh_lit(w, p.pos, "lit:bool=" + b.to_string());
            return;
        }
        None => {}
    }
    match p.str_value {
        Some(s) => {
            dh_lit(w, p.pos, "lit:str=" + s);
            return;
        }
        None => {}
    }
    if p.ctor != "" {
        let mut c = p.ctor;
        if p.ty != "" {
            c = p.ty + "::" + p.ctor;
        }
        dh_emit(w, "pctor:" + c + "/" + p.args.len().to_string());
        for a in p.args {
            dh_pattern(w, a);
        }
        return;
    }
    if p.bind != "" {
        dh_declare(w, p.bind);
        return;
    }
    dh_emit(w, "p?");
}

fn dh_block(w: DhWalk, b: AstBlock) {
    let d = dh_enter(w);
    dh_block_node(w, b);
    dh_leave(w, d);
}

fn dh_block_node(w: DhWalk, b: AstBlock) {
    let mark = dh_scope_mark(w);
    dh_emit(w, "{" + b.stmts.len().to_string());
    for s in b.stmts {
        dh_stmt(w, s);
    }
    match b.tail {
        Some(e) => {
            dh_emit(w, "tail");
            dh_expr(w, e);
        }
        None => {}
    }
    dh_emit(w, "}");
    dh_scope_reset(w, mark);
}

fn dh_stmt(w: DhWalk, s: AstStmt) {
    let d = dh_enter(w);
    dh_stmt_node(w, s);
    dh_leave(w, d);
}

fn dh_stmt_node(w: DhWalk, s: AstStmt) {
    match s {
        AstStmt::Let(l) => {
            dh_emit(w, "let:" + dh_opt_type(l.ty));
            // the initializer sees the outer scope
            dh_expr(w, l.init);
            match l.pat {
                Some(p) => dh_pattern(w, p),
                None => dh_declare(w, l.name),
            }
        }
        AstStmt::Assign(a) => {
            dh_emit(w, "assign");
            dh_ident(w, a.name, a.id);
            dh_expr(w, a.value);
        }
        AstStmt::FieldAssign(a) => {
            dh_emit(w, "setfield:" + a.target.name);
            dh_expr(w, a.target.x);
            dh_expr(w, a.value);
        }
        AstStmt::Break(b) => {
            dh_emit(w, "break");
            dh_label(w, b.label);
            match b.value {
                Some(v) => dh_expr(w, v),
                None => {}
            }
        }
        AstStmt::Continue(c) => {
            dh_emit(w, "continue");
            dh_label(w, c.label);
        }
        AstStmt::While(s) => {
            let mark = dh_scope_mark(w);
            dh_emit(w, if s.is_loop { "loop" } else { "while" });
            dh_declare_label(w, s.label);
            dh_expr(w, s.cond);
            match s.pat {
                Some(p) => {
                    dh_emit(w, "let");
                    dh_pattern(w, p);
                }
                None => {}
            }
            dh_block(w, s.body);
            dh_scope_reset(w, mark);
        }
        AstStmt::For(s) => {
            let mark = dh_scope_mark(w);
            dh_emit(w, "for");
            dh_declare_label(w, s.label);
            dh_expr(w, s.iter);
            match s.end {
                Some(e) => {
                    dh_emit(w, "..");
                    dh_expr(w, e);
                }
                None => {}
            }
            match s.pat {
                Some(p) => dh_pattern(w, p),
                None => dh_declare(w, s.var),
            }
            dh_block(w, s.body);
            dh_scope_reset(w, mark);
        }
        AstStmt::Return(r) => {
            dh_emit(w, "return");
            match r.value {
                Some(e) => dh_expr(w, e),
                None => {}
            }
        }
        AstStmt::Expr(e) => {
            dh_emit(w, if e.semi { "stmt;" } else { "stmt" });
            dh_expr(w, e.x);
        }
    }
}

fn dh_ident(w: DhWalk, name: String, id: Int) {
    let n = dh_lookup(w, name);
    if n >= 0 {
        dh_emit(w, "local#" + n.to_string());
        return;
    }
    if w.info.funcs.contains_key(name) {
        dh_dep(w, name);
    }
    dh_emit(w, "g:" + dh_global(w, name));
}

fn dh_targs(w: DhWalk, ts: Vec<AstType>) {
    if ts.len() == 0 {
        return;
    }
    let mut xs = Vec::new();
    for t in ts {
        xs.push(dh_type(t));
    }
    dh_emit(w, "targs:" + xs.join(","));
}

fn dh_func_dep(w: DhWalk, f: Option<ChkFunc>) {
    match f {
        Some(fun) => {
            if !chk_is_lib(fun) {
                dh_dep(w, fun.name);
            }
            // a call through a trait reaches every implementation
            dh_trait_impls(w, fun.name);
        }
        None => {}
    }
}

// dh_trait_impls adds the implementations of the trait method name
// (`Trait::m`) as dependencies.
fn dh_trait_impls(w: DhWalk, name: String) {
    let sep = match name.index_of("::") {
        Some(i) => i,
        None => {
            return;
        }
    };
    let tr = name.slice(0, sep);
    if !w.info.traits.contains_key(tr) {
        return;
    }
    match w.impls.get(name) {
        Some(ns) => {
            for n in ns {
                dh_dep(w, n);
            }
        }
        None => {}
    }
}

// dh_impl_index maps every trait method `Trait::m` to its user
// implementations (`<T as Trait>::m`), so that a call through a trait does
// not scan every function.
fn dh_impl_index(info: ChkInfo) -> HashMap<String, Vec<String>> {
    let mut idx: HashMap<String, Vec<String>> = HashMap::new();
    for fun in info.func_list {
        if chk_is_lib(fun) || !fun.name.starts_with("<") {
            continue;
        }
        let close = match fun.name.index_of(">::") {
            Some(i) => i,
            None => {
                continue;
            }
        };
        let head = fun.name.slice(1, close);
        let mut tr = "";
        let parts = head.split(" as ");
        if parts.len() >= 2 {
            tr = parts.get(parts.len() - 1).unwrap_or("");
        }
        if tr == "" {
            continue;
        }
        let key = tr + "::" + fun.name.slice(close + 3, fun.name.len());
        match idx.get(key) {
            Some(mut v) => v.push(fun.name),
            None => {
                let mut v = Vec::new();
                v.push(fun.name);
                idx.insert(key, v);
            }
        }
    }
    idx
}

fn dh_expr(w: DhWalk, e: AstExpr) {
    let d = dh_enter(w);
    dh_expr_node(w, e);
    dh_leave(w, d);
}

fn dh_expr_node(w: DhWalk, e: AstExpr) {
    match e {
        AstExpr::IntLit(x) => dh_lit(w, x.pos, "lit:int=" + x.value.to_string()),
        AstExpr::BoolLit(x) => dh_lit(w, x.pos, "lit:bool=" + x.value.to_string()),
        AstExpr::StrLit(x) => dh_lit(w, x.pos, "lit:str=" + x.value),
        AstExpr::UnitLit(_) => dh_emit(w, "()"),
        AstExpr::Ident(x) => {
            dh_ident(w, x.name, x.id);
            dh_targs(w, x.targs);
        }
        AstExpr::Binary(x) => {
            dh_emit(w, "bin:" + x.op);
            match w.info.binops.get(x.id) {
                Some(m) => dh_func_dep(w, m.func),
                None => {}
            }
            dh_expr(w, x.x);
            dh_expr(w, x.y);
        }
        AstExpr::Unary(x) => {
            // `&`, `&mut ` and `*` do nothing
            if x.op == "-" || x.op == "!" {
                dh_emit(w, "un:" + x.op);
            }
            match w.info.binops.get(x.id) {
                // `-x` through Neg
                Some(m) => dh_func_dep(w, m.func),
                None => {}
            }
            dh_expr(w, x.x);
        }
        AstExpr::Call(x) => {
            dh_emit(w, "call/" + x.args.len().to_string());
            match w.info.calls.get(x.id) {
                Some(ci) => dh_func_dep(w, ci.func),
                None => {}
            }
            dh_expr(w, x.func);
            for a in x.args {
                dh_expr(w, a);
            }
        }
        AstExpr::Method(x) => {
            dh_emit(w, "method:" + x.name + "/" + x.args.len().to_string());
            match w.info.methods.get(x.id) {
                Some(m) => dh_func_dep(w, m.func),
                None => {}
            }
            dh_targs(w, x.targs);
            dh_expr(w, x.recv);
            for a in x.args {
                dh_expr(w, a);
            }
        }
        AstExpr::Field(x) => {
            dh_emit(w, "field:" + x.name);
            dh_expr(w, x.x);
        }
        AstExpr::Path(x) => {
            let full = x.ty + "::" + x.name;
            if w.info.funcs.contains_key(full) {
                dh_dep(w, full);
                dh_trait_impls(w, full);
            }
            dh_emit(w, "path:" + dh_global(w, full));
            dh_targs(w, x.ty_args);
            dh_targs(w, x.targs);
        }
        AstExpr::StructLit(x) => {
            dh_emit(w, "struct:" + x.name + "/" + x.fields.len().to_string());
            for f in x.fields {
                dh_emit(w, "init:" + f.name);
                dh_expr(w, f.value);
            }
        }
        AstExpr::If(x) => {
            let mark = dh_scope_mark(w);
            dh_emit(w, "if");
            dh_expr(w, x.cond);
            match x.pat {
                Some(p) => {
                    dh_emit(w, "let");
                    dh_pattern(w, p);
                }
                None => {}
            }
            dh_block(w, x.then);
            dh_scope_reset(w, mark);
            match x.els {
                Some(e) => {
                    dh_emit(w, "else");
                    dh_expr(w, e);
                }
                None => {}
            }
        }
        AstExpr::Match(x) => {
            dh_emit(w, "match/" + x.arms.len().to_string());
            dh_expr(w, x.x);
            for arm in x.arms {
                let mark = dh_scope_mark(w);
                dh_emit(w, "arm");
                dh_pattern(w, arm.pat);
                match arm.guard {
                    Some(g) => {
                        dh_emit(w, "guard");
                        dh_expr(w, g);
                    }
                    None => {}
                }
                dh_expr(w, arm.body);
                dh_scope_reset(w, mark);
            }
        }
        AstExpr::Block(b) => dh_block(w, b),
        AstExpr::Try(x) => {
            dh_emit(w, "try");
            match w.info.tries.get(x.id) {
                // the error converted with `From::from`
                Some(ti) => match ti.conv {
                    Some(mi) => {
                        dh_emit(w, "from");
                        dh_func_dep(w, mi.func);
                    }
                    None => {}
                },
                None => {}
            }
            dh_expr(w, x.x);
        }
        AstExpr::Closure(x) => {
            let mark = dh_scope_mark(w);
            dh_emit(w, "closure/" + x.params.len().to_string() + ":" + dh_opt_type(x.result));
            for p in x.params {
                dh_emit(w, "param:" + dh_opt_type(p.ty));
                dh_declare(w, p.name);
            }
            dh_expr(w, x.body);
            dh_scope_reset(w, mark);
        }
        AstExpr::Tuple(x) => {
            dh_emit(w, "tuple/" + x.elems.len().to_string());
            for a in x.elems {
                dh_expr(w, a);
            }
        }
        AstExpr::Range(x) => {
            dh_emit(w, if x.inclusive { "range=" } else { "range" });
            dh_expr(w, x.start);
            dh_expr(w, x.end);
        }
        AstExpr::Index(x) => {
            dh_emit(w, "index");
            dh_expr(w, x.x);
            dh_expr(w, x.index);
        }
        AstExpr::Macro(x) => dh_expr_node(w, x.expansion),
    }
}

// dh_abstract_lits drops the values of literal labels.
fn dh_abstract_lits(labels: Vec<String>) -> Vec<String> {
    let mut out = Vec::new();
    for l in labels {
        if l.starts_with("lit:") {
            match l.index_of("=") {
                Some(i) => out.push(l.slice(0, i)),
                None => out.push(l),
            }
        } else {
            out.push(l);
        }
    }
    out
}

// dh_sig renders a signature without names: "(Int, &Log) -> String".
fn dh_sig(fun: ChkFunc) -> String {
    let mut ps = Vec::new();
    for p in fun.params {
        ps.push(ty_str(p.ty));
    }
    "(" + ps.join(", ") + ") -> " + ty_str(ty_prune(fun.result))
}

fn dh_caps(fun: ChkFunc) -> Vec<String> {
    let mut out = Vec::new();
    for p in fun.params {
        match p.ty {
            Ty::Cap(k, _) => out.push(k),
            _ => {}
        }
    }
    out
}

// dh_def walks one function.
fn dh_def(info: ChkInfo, impls: HashMap<String, Vec<String>>, fun: ChkFunc) -> DhDef {
    let w = DhWalk {
        info: info,
        impls: impls,
        self_name: fun.name,
        labels: Vec::new(),
        depths: Vec::new(),
        lits: Vec::new(),
        depth: 0,
        node: true,
        scope_names: Vec::new(),
        scope_nums: Vec::new(),
        next_local: 0,
        deps: HashMap::new(),
    };
    let d = fun.decl;
    let mut gs = Vec::new();
    for g in d.generics {
        let mut bs = Vec::new();
        for b in g.bounds {
            bs.push(dh_type(b));
        }
        gs.push(g.name + ":" + bs.join("+"));
    }
    dh_emit(w, "fn<" + gs.join(",") + ">");
    for wh in d.wheres {
        let mut bs = Vec::new();
        for b in wh.bounds {
            bs.push(dh_type(b));
        }
        dh_emit(w, "where:" + dh_type(wh.ty) + ":" + bs.join("+"));
    }
    for p in d.params {
        dh_emit(w, "param:" + dh_opt_type(p.ty));
        dh_declare(w, p.name);
    }
    dh_emit(w, "result:" + dh_opt_type(d.result));
    for e in d.preds {
        dh_emit(w, "pred");
        dh_expr(w, e);
    }
    for a in d.attrs {
        if a.name == "handler" || a.name == "main" || a.name == "test" {
            dh_emit(w, "attr:" + a.name + "(" + a.args.join(",") + ")");
        }
    }
    if d.has_body {
        dh_block(w, d.body);
    } else {
        dh_emit(w, "nobody");
    }
    let deps: Vec<String> = w.deps.keys().collect();
    chk_sort_strings(deps);
    DhDef {
        name: fun.name,
        fun: fun,
        pos: d.pos,
        sig: dh_sig(fun),
        caps: dh_caps(fun),
        labels: w.labels,
        depths: w.depths,
        lits: w.lits,
        hash: dh_hash_strs(w.labels),
        hash_lits: dh_hash_strs(dh_abstract_lits(w.labels)),
        deps: deps,
        trans: "",
    }
}

// dh_types_hash hashes the user type declarations (structs, enums, traits
// and impl headers). A change to any of them changes every trans hash.
fn dh_types_hash(f: AstFile) -> String {
    let mut xs = Vec::new();
    for s in f.structs {
        if dh_is_lib_pos(s.pos) {
            continue;
        }
        let mut fs = Vec::new();
        for fld in s.fields {
            let mut m = "";
            if fld.mutable {
                m = "mut ";
            }
            fs.push(m + fld.name + ":" + dh_type(fld.ty));
        }
        let mut attrs = Vec::new();
        for a in s.attrs {
            attrs.push(a.name + "(" + a.args.join(",") + ")");
        }
        xs.push(
            "struct "
                + s.name
                + s.kind
                + "/"
                + s.generics.len().to_string()
                + "["
                + attrs.join(",")
                + "]{"
                + fs.join(",")
                + "}",
        );
    }
    for e in f.enums {
        if dh_is_lib_pos(e.pos) {
            continue;
        }
        let mut vs = Vec::new();
        for v in e.variants {
            let mut ts = Vec::new();
            for t in v.fields {
                ts.push(dh_type(t));
            }
            if v.named {
                vs.push(v.name + "{" + v.names.join(",") + ":" + ts.join(",") + "}");
            } else {
                vs.push(v.name + "(" + ts.join(",") + ")");
            }
        }
        let mut attrs = Vec::new();
        for a in e.attrs {
            attrs.push(a.name + "(" + a.args.join(",") + ")");
        }
        xs.push(
            "enum "
                + e.name
                + "/"
                + e.generics.len().to_string()
                + "["
                + attrs.join(",")
                + "]{"
                + vs.join(",")
                + "}",
        );
    }
    for t in f.traits {
        if dh_is_lib_pos(t.pos) {
            continue;
        }
        let mut ss = Vec::new();
        for s in t.supers {
            ss.push(dh_type(s));
        }
        let mut assoc = Vec::new();
        for a in t.assoc {
            assoc.push(a.name);
        }
        xs.push("trait " + t.name + ":" + ss.join("+") + "{" + assoc.join(",") + "}");
    }
    for im in f.impls {
        if dh_is_lib_pos(im.pos) {
            continue;
        }
        let mut assoc = Vec::new();
        for a in im.assoc {
            assoc.push(a.name + "=" + dh_opt_type(a.ty));
        }
        xs.push(
            "impl "
                + dh_opt_type(im.trait_ty)
                + " for "
                + dh_type(im.target)
                + "{"
                + assoc.join(",")
                + "}",
        );
    }
    for a in f.aliases {
        if dh_is_lib_pos(a.pos) {
            continue;
        }
        let pred = match a.pred {
            Some(e) => " where " + ref_show(e),
            None => "",
        };
        xs.push("type " + a.name + "=" + dh_type(a.ty) + pred);
    }
    chk_sort_strings(xs);
    dh_hash_strs(xs)
}

fn dh_is_lib_pos(p: AstPos) -> Bool {
    p.file.starts_with("<core>/") || p.file.starts_with("<prelude>/")
}

// dh_program hashes every user function of a checked program.
fn dh_program(file: AstFile, info: ChkInfo) -> DhProgram {
    let mut defs = Vec::new();
    let mut by_name: HashMap<String, DhDef> = HashMap::new();
    let impls = dh_impl_index(info);
    for fun in info.func_list {
        if chk_is_lib(fun) {
            continue;
        }
        let d = dh_def(info, impls, fun);
        defs.push(d);
        by_name.insert(d.name, d);
    }
    let th = dh_types_hash(file);
    dh_trans(defs, by_name, th);
    let mut all = Vec::new();
    for d in defs {
        all.push(d.name + "=" + d.trans);
    }
    chk_sort_strings(all);
    all.push("types=" + th);
    DhProgram { defs: defs, by_name: by_name, types_hash: th, hash: dh_hash_strs(all) }
}

// dh_trans sets the trans hash of every definition. The call graph is
// split into strongly connected components (iterative Tarjan); a
// component's hash covers its members' (name, hash) and the hashes of the
// components it calls, which Tarjan has finished before it. So trans
// covers everything reachable, in O(definitions + calls) instead of one
// traversal per definition.
fn dh_trans(defs: Vec<DhDef>, by_name: HashMap<String, DhDef>, th: String) {
    let n = defs.len();
    let mut index_of: HashMap<String, Int> = HashMap::new();
    let mut k = 0;
    for d in defs {
        index_of.insert(d.name, k);
        k = k + 1;
    }
    let mut adj: Vec<Vec<Int>> = Vec::new();
    let mut idx = Vec::new();
    let mut low = Vec::new();
    let mut on = Vec::new();
    let mut comp = Vec::new();
    for d in defs {
        let mut es = Vec::new();
        for dep in d.deps {
            match index_of.get(dep) {
                Some(j) => es.push(j),
                None => {}
            }
        }
        adj.push(es);
        idx.push(-1);
        low.push(0);
        on.push(false);
        comp.push(-1);
    }
    let mut comp_hash: Vec<String> = Vec::new();
    let mut stack = Vec::new();
    let mut fv = Vec::new();
    let mut fi = Vec::new();
    let mut counter = 0;
    for root in 0..n {
        if idx.get(root).unwrap_or(0) != -1 {
            continue;
        }
        idx.set(root, counter);
        low.set(root, counter);
        counter = counter + 1;
        stack.push(root);
        on.set(root, true);
        fv.push(root);
        fi.push(0);
        while fv.len() > 0 {
            let top = fv.len() - 1;
            let v = fv.get(top).unwrap_or(0);
            let i = fi.get(top).unwrap_or(0);
            let es = adj.get(v).unwrap_or(Vec::new());
            if i < es.len() {
                fi.set(top, i + 1);
                let w = es.get(i).unwrap_or(0);
                if idx.get(w).unwrap_or(0) == -1 {
                    idx.set(w, counter);
                    low.set(w, counter);
                    counter = counter + 1;
                    stack.push(w);
                    on.set(w, true);
                    fv.push(w);
                    fi.push(0);
                } else if on.get(w).unwrap_or(false) {
                    low.set(v, low.get(v).unwrap_or(0).min(idx.get(w).unwrap_or(0)));
                }
                continue;
            }
            if low.get(v).unwrap_or(0) == idx.get(v).unwrap_or(0) {
                // v roots a component: its callees' components are done
                let c = comp_hash.len();
                let mut members = Vec::new();
                let mut more = true;
                while more {
                    let x = stack.pop().unwrap_or(v);
                    on.set(x, false);
                    comp.set(x, c);
                    members.push(x);
                    more = x != v;
                }
                let mut parts = Vec::new();
                let mut ext: HashSet<String> = HashSet::new();
                for x in members {
                    match defs.get(x) {
                        Some(d) => parts.push(d.name + "=" + d.hash),
                        None => {}
                    }
                    for w in adj.get(x).unwrap_or(Vec::new()) {
                        let cw = comp.get(w).unwrap_or(-1);
                        if cw != c && cw >= 0 {
                            ext.insert(comp_hash.get(cw).unwrap_or(""));
                        }
                    }
                }
                chk_sort_strings(parts);
                let deps: Vec<String> = ext.iter().collect();
                chk_sort_strings(deps);
                for h in deps {
                    parts.push("calls=" + h);
                }
                comp_hash.push(dh_hash_strs(parts));
            }
            fv.pop();
            fi.pop();
            if fv.len() > 0 {
                let u = fv.get(fv.len() - 1).unwrap_or(0);
                low.set(u, low.get(u).unwrap_or(0).min(low.get(v).unwrap_or(0)));
            }
        }
    }
    let mut j = 0;
    for mut d in defs {
        let mut parts = Vec::new();
        parts.push("self=" + d.name + "=" + d.hash);
        parts.push("scc=" + comp_hash.get(comp.get(j).unwrap_or(0)).unwrap_or(""));
        parts.push("types=" + th);
        d.trans = dh_hash_strs(parts);
        j = j + 1;
    }
}

// dh_load parses and checks a program (diagnostics are printed) and
// hashes it.
fn dh_load(path: String, fs: &Fs, log: &Log) -> Option<DhLoaded> {
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return None;
        }
    };
    let prog = frontend_parse_all(srcs);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return None;
    }
    let res = chk_check(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return None;
    }
    Some(DhLoaded { srcs: srcs, file: prog.file, res: res, prog: dh_program(prog.file, res.info) })
}

struct DhLoaded {
    srcs: Vec<FeSource>,
    file: AstFile,
    res: ChkResult,
    prog: DhProgram,
}

// `hash [-json] <file|dir>`: the definition hashes of a program.
fn dh_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    let fl = tool_flags(args, 1, "json");
    if fl.err != "" {
        return tool_flag_error(fl, "hash [-json] <file|dir>", log);
    }
    if fl.rest.len() != 1 {
        log.error("usage: kek hash [-json] <file|dir>");
        return 2;
    }
    let path = fl.rest.get(0).unwrap_or("");
    let l = match dh_load(path, fs, log) {
        Some(l) => l,
        None => {
            return 1;
        }
    };
    if tool_flag_bool(fl, "json") {
        let mut fns = Vec::new();
        for d in l.prog.defs {
            let o = irjson_obj();
            irjson_set(o, "name", IrjVal::Str(ast_display_name(d.name)));
            irjson_set(o, "file", IrjVal::Str(d.pos.file));
            irjson_set(o, "line", irjson_int(d.pos.line));
            irjson_set(o, "sig", IrjVal::Str(ast_display_name(d.sig)));
            irjson_set(o, "caps", irjson_strs(d.caps));
            irjson_set(o, "hash", IrjVal::Str(d.hash));
            irjson_set(o, "hash_lits", IrjVal::Str(d.hash_lits));
            irjson_set(o, "trans", IrjVal::Str(d.trans));
            let mut deps = Vec::new();
            for x in d.deps {
                deps.push(ast_display_name(x));
            }
            irjson_set(o, "deps", irjson_strs(deps));
            fns.push(irjson_val(o));
        }
        let o = irjson_obj();
        irjson_set(o, "path", IrjVal::Str(path));
        irjson_set(o, "hash", IrjVal::Str(l.prog.hash));
        irjson_set(o, "types", IrjVal::Str(l.prog.types_hash));
        irjson_set(o, "functions", IrjVal::Arr(fns));
        log.info(irjson_encode(irjson_val(o), false));
        return 0;
    }
    let mut lines = Vec::new();
    lines.push("program " + l.prog.hash);
    for d in l.prog.defs {
        lines.push(dh_short(d.hash) + " " + dh_short(d.trans) + " " + ast_display_name(d.name));
    }
    frontend_print(log, lines);
    0
}
