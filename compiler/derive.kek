// `#[derive(...)]` (prefix derive_): the implementations of PartialEq, Eq,
// PartialOrd, Ord, Hash and Default for a struct or enum, generated as
// source text and parsed with every position at the attribute (so that
// errors in them point at the derive). The core library also gets these
// traits for tuples this way.

fn derive_traits() -> Vec<String> {
    "PartialEq Eq PartialOrd Ord Hash Default".split(" ")
}

// derive_items adds the derived implementations of f's structs and enums
// to f.
fn derive_items(f: AstFile, ids: AstIds, errs: Vec<AstError>) {
    let srcs = Vec::new();
    let poss = Vec::new();
    for sd in f.structs {
        for a in sd.attrs {
            if a.name != "derive" {
                errs.push(AstError { pos: a.pos, msg: "unknown attribute `#[" + a.name + "]`" });
                continue;
            }
            for tr in a.args {
                if !derive_known(tr, errs, a.pos) {
                    continue;
                }
                let pii = derive_pii_struct(sd);
                if pii != "" && !derive_pii_ok(tr) {
                    errs.push(derive_pii_error(a.pos, tr, sd.name, "field `" + pii + "`"));
                    continue;
                }
                if tr == "Hash" {
                    // a key must not change while it is in a HashMap
                    let mut bad = "";
                    for f in sd.fields {
                        if f.mutable && bad == "" {
                            bad = f.name;
                        }
                    }
                    if bad != "" {
                        errs.push(AstError {
                            pos: a.pos,
                            msg: "cannot derive `Hash` for `"
                                + sd.name
                                + "`: field `"
                                + bad
                                + "` is `mut` (a hashed value must be immutable)",
                        });
                        continue;
                    }
                }
                srcs.push(derive_struct(sd, tr));
                poss.push(a.pos);
            }
        }
    }
    for ed in f.enums {
        for a in ed.attrs {
            if a.name != "derive" {
                errs.push(AstError { pos: a.pos, msg: "unknown attribute `#[" + a.name + "]`" });
                continue;
            }
            for tr in a.args {
                if !derive_known(tr, errs, a.pos) {
                    continue;
                }
                let pii = derive_pii_enum(ed);
                if pii != "" && !derive_pii_ok(tr) {
                    errs.push(derive_pii_error(a.pos, tr, ed.name, "variant `" + pii + "`"));
                    continue;
                }
                if tr == "Default" {
                    errs.push(AstError {
                        pos: a.pos,
                        msg: "`#[derive(Default)]` is only supported on structs",
                    });
                    continue;
                }
                srcs.push(derive_enum(ed, tr));
                poss.push(a.pos);
            }
        }
    }
    for i in 0..srcs.len() {
        let pos = poss.get(i).unwrap_or(AstPos { file: "", line: 0, col: 0 });
        let pr = parse_file_at(pos.file, srcs.get(i).unwrap_or(""), ids, Some(pos));
        for e in pr.errs {
            errs.push(e);
        }
        for im in pr.file.impls {
            f.impls.push(im);
        }
    }
}

// Personal data: Pii (lib/core/pii.kek) implements only PartialEq and Eq,
// so only these can be derived for a type that holds one (a derived Hash,
// order or default would need the same of Pii).

fn derive_pii_ok(tr: String) -> Bool {
    tr == "PartialEq" || tr == "Eq"
}

fn derive_pii_error(pos: AstPos, tr: String, name: String, what: String) -> AstError {
    AstError {
        pos: pos,
        msg: "cannot derive `"
            + tr
            + "` for `"
            + name
            + "`: "
            + what
            + " holds personal data (`Pii`), which has no `"
            + tr
            + "` (only `PartialEq` and `Eq` can be derived)",
    }
}

// derive_mentions reports whether type t mentions the type name n.
fn derive_mentions(t: AstType, n: String) -> Bool {
    match t {
        AstType::Named(x) => {
            if x.name == n {
                return true;
            }
            for a in x.args {
                if derive_mentions(a, n) {
                    return true;
                }
            }
            false
        }
        AstType::Ref(x) => derive_mentions(x.elem, n),
        AstType::Unit(_) => false,
        AstType::Tuple(x) => {
            for a in x.elems {
                if derive_mentions(a, n) {
                    return true;
                }
            }
            false
        }
        AstType::Fn(_) => false,
    }
}

// derive_pii_struct is the first field of sd that holds a Pii ("" if none).
fn derive_pii_struct(sd: AstStructDecl) -> String {
    for f in sd.fields {
        if derive_mentions(f.ty, "Pii") {
            return f.name;
        }
    }
    ""
}

fn derive_pii_enum(ed: AstEnumDecl) -> String {
    for v in ed.variants {
        for t in v.fields {
            if derive_mentions(t, "Pii") {
                return v.name;
            }
        }
    }
    ""
}

fn derive_known(tr: String, errs: Vec<AstError>, pos: AstPos) -> Bool {
    for t in derive_traits() {
        if t == tr {
            return true;
        }
    }
    errs.push(AstError {
        pos: pos,
        msg: "cannot derive `" + tr + "` (derivable: " + derive_traits().join(", ") + ")",
    });
    false
}

// derive_header is `impl<T: Tr, ...> Tr for Name<T, ...>`.
fn derive_header(tr: String, name: String, gs: Vec<AstGeneric>) -> String {
    if gs.len() == 0 {
        return "impl " + tr + " for " + name;
    }
    let ps = Vec::new();
    let ns = Vec::new();
    for g in gs {
        ps.push(g.name + ": " + tr);
        ns.push(g.name);
    }
    "impl<" + ps.join(", ") + "> " + tr + " for " + name + "<" + ns.join(", ") + ">"
}

fn derive_struct(sd: AstStructDecl, tr: String) -> String {
    let h = derive_header(tr, sd.name, sd.generics);
    let fields = Vec::new();
    for f in sd.fields {
        fields.push(f.name);
    }
    derive_body(h, tr, fields, sd.name)
}

// derive_body is the implementation for a struct or tuple whose fields
// (names or indices) are compared in order.
fn derive_body(h: String, tr: String, fields: Vec<String>, lit: String) -> String {
    if tr == "Eq" {
        return h + " {}\n";
    }
    if tr == "PartialEq" {
        let parts = Vec::new();
        for f in fields {
            parts.push("self." + f + " == other." + f);
        }
        if parts.len() == 0 {
            parts.push("true");
        }
        return h
            + " {\n    fn eq(&self, other: &Self) -> Bool {\n        "
            + parts.join(" && ")
            + "\n    }\n}\n";
    }
    if tr == "PartialOrd" || tr == "Ord" {
        let m = if tr == "Ord" { "cmp" } else { "partial_cmp" };
        let eq = if tr == "Ord" {
            "Ordering::Equal"
        } else {
            "Some(Ordering::Equal)"
        };
        let res = if tr == "Ord" {
            "Ordering"
        } else {
            "Option<Ordering>"
        };
        let mut body = "";
        for f in fields {
            body = body
                + "        match self."
                + f
                + "."
                + m
                + "(&other."
                + f
                + ") {\n            "
                + eq
                + " => {}\n            o => {\n                return o;\n            }\n        }\n";
        }
        return h
            + " {\n    fn "
            + m
            + "(&self, other: &Self) -> "
            + res
            + " {\n"
            + body
            + "        "
            + eq
            + "\n    }\n}\n";
    }
    if tr == "Hash" {
        let mut body = "";
        for f in fields {
            body = body + "        self." + f + ".hash(state);\n";
        }
        return h + " {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n" + body + "    }\n}\n";
    }
    // Default (structs only)
    let inits = Vec::new();
    for f in fields {
        inits.push(f + ": Default::default()");
    }
    h
        + " {\n    fn default() -> Self {\n        "
        + lit
        + " { "
        + inits.join(", ")
        + " }\n    }\n}\n"
}

// derive_pat is the pattern `E::V(p0, p1)` binding the fields as
// prefix0, prefix1, ... (`E::V` without fields).
fn derive_pat(en: String, v: AstVariant, prefix: String) -> String {
    if v.fields.len() == 0 {
        return en + "::" + v.name;
    }
    let ps = Vec::new();
    for i in 0..v.fields.len() {
        ps.push(prefix + i.to_string());
    }
    en + "::" + v.name + "(" + ps.join(", ") + ")"
}

fn derive_enum(ed: AstEnumDecl, tr: String) -> String {
    let h = derive_header(tr, ed.name, ed.generics);
    if tr == "Eq" {
        return h + " {}\n";
    }
    let n = ed.variants.len();
    if tr == "PartialEq" {
        let arms = Vec::new();
        for v in ed.variants {
            let parts = Vec::new();
            for i in 0..v.fields.len() {
                parts.push("a" + i.to_string() + " == b" + i.to_string());
            }
            if parts.len() == 0 {
                parts.push("true");
            }
            let mut inner = "match other {\n                "
                + derive_pat(ed.name, v, "b")
                + " => "
                + parts.join(" && ")
                + ",\n";
            if n > 1 {
                inner = inner + "                _ => false,\n";
            }
            inner = inner + "            }";
            arms.push("            " + derive_pat(ed.name, v, "a") + " => " + inner + ",\n");
        }
        return h
            + " {\n    fn eq(&self, other: &Self) -> Bool {\n        match self {\n"
            + arms.join("")
            + "        }\n    }\n}\n";
    }
    if tr == "PartialOrd" || tr == "Ord" {
        let m = if tr == "Ord" { "cmp" } else { "partial_cmp" };
        let res = if tr == "Ord" {
            "Ordering"
        } else {
            "Option<Ordering>"
        };
        let wrap_l = if tr == "Ord" { "" } else { "Some(" };
        let wrap_r = if tr == "Ord" { "" } else { ")" };
        let eq = if tr == "Ord" {
            "Ordering::Equal"
        } else {
            "Some(Ordering::Equal)"
        };
        let arms = Vec::new();
        let mut i = 0;
        for v in ed.variants {
            let inner = Vec::new();
            let mut j = 0;
            for w in ed.variants {
                let mut r = "";
                if j < i {
                    r = wrap_l + "Ordering::Greater" + wrap_r;
                } else if j > i {
                    r = wrap_l + "Ordering::Less" + wrap_r;
                } else {
                    let mut body = "{\n";
                    for k in 0..v.fields.len() {
                        body = body
                            + "                    match a"
                            + k.to_string()
                            + "."
                            + m
                            + "(&b"
                            + k.to_string()
                            + ") {\n                        "
                            + eq
                            + " => {}\n                        o => {\n                            return o;\n                        }\n                    }\n";
                    }
                    r = body + "                    " + eq + "\n                }";
                }
                let pat = if j == i {
                    derive_pat(ed.name, w, "b")
                } else {
                    derive_wild_pat(ed.name, w)
                };
                inner.push("                " + pat + " => " + r + ",\n");
                j = j + 1;
            }
            arms.push(
                "            "
                    + derive_pat(ed.name, v, "a")
                    + " => match other {\n"
                    + inner.join("")
                    + "            },\n",
            );
            i = i + 1;
        }
        return h
            + " {\n    fn "
            + m
            + "(&self, other: &Self) -> "
            + res
            + " {\n        match self {\n"
            + arms.join("")
            + "        }\n    }\n}\n";
    }
    // Hash: the variant index, then the fields
    let arms = Vec::new();
    let mut i = 0;
    for v in ed.variants {
        let mut body = "{\n                state.write_i64(" + i.to_string() + ");\n";
        for k in 0..v.fields.len() {
            body = body + "                a" + k.to_string() + ".hash(state);\n";
        }
        arms.push("            " + derive_pat(ed.name, v, "a") + " => " + body + "            }\n");
        i = i + 1;
    }
    h
        + " {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        match self {\n"
        + arms.join("")
        + "        }\n    }\n}\n"
}

fn derive_wild_pat(en: String, v: AstVariant) -> String {
    if v.fields.len() == 0 {
        return en + "::" + v.name;
    }
    let ps = Vec::new();
    for f in v.fields {
        ps.push("_");
    }
    en + "::" + v.name + "(" + ps.join(", ") + ")"
}

// derive_tuples is the core library's implementations of the derivable
// traits (but Default) for tuples of 1 to 8 elements.
fn derive_tuples() -> String {
    let names = "T0 T1 T2 T3 T4 T5 T6 T7".split(" ");
    let mut out = "";
    for n in 1..9 {
        let ns = Vec::new();
        let fields = Vec::new();
        for i in 0..n {
            ns.push(names.get(i).unwrap_or("A"));
            fields.push(i.to_string());
        }
        let ty = if n == 1 {
            "(T0,)"
        } else {
            "(" + ns.join(", ") + ")"
        };
        for tr in "PartialEq Eq PartialOrd Ord Hash".split(" ") {
            let ps = Vec::new();
            for x in ns {
                ps.push(x + ": " + tr);
            }
            let h = "impl<" + ps.join(", ") + "> " + tr + " for " + ty;
            out = out + derive_body(h, tr, fields, "") + "\n";
        }
    }
    out
}
