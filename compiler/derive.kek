// `#[derive(...)]` (prefix derive_): the implementations of PartialEq, Eq,
// PartialOrd, Ord, Hash, Default, Clone, Debug, Serialize and Deserialize for a
// struct or enum, generated as source text and parsed with every position
// at the attribute (so that errors in them point at the derive). The core
// library also gets these traits for tuples this way.

fn derive_traits() -> Vec<String> {
    "PartialEq Eq PartialOrd Ord Hash Default Clone Debug Serialize Deserialize".split(" ")
}

// derive_items adds the derived implementations of f's structs and enums
// to f.
fn derive_items(mut f: AstFile, ids: AstIds, mut errs: Vec<AstError>) {
    let mut srcs = Vec::new();
    let mut poss = Vec::new();
    for sd in f.structs {
        for a in sd.attrs {
            if a.name.starts_with("__") {
                // added by compiler/modres.kek
                continue;
            }
            if a.name != "derive" {
                errs.push(AstError { pos: a.pos, msg: "unknown attribute `#[" + a.name + "]`" });
                continue;
            }
            for tr in a.args {
                if !derive_known(tr, errs, a.pos) {
                    continue;
                }
                let pii = derive_pii_struct(sd);
                if pii != "" && !derive_pii_ok(tr) {
                    errs.push(derive_pii_error(a.pos, tr, sd.name, "field `" + pii + "`"));
                    continue;
                }
                if tr == "Hash" {
                    // a key must not change while it is in a HashMap
                    let mut bad = "";
                    for f in sd.fields {
                        if f.mutable && bad == "" {
                            bad = f.name;
                        }
                    }
                    if bad != "" {
                        errs.push(AstError {
                            pos: a.pos,
                            msg: "cannot derive `Hash` for `"
                                + sd.name
                                + "`: field `"
                                + bad
                                + "` is `mut` (a hashed value must be immutable)",
                        });
                        continue;
                    }
                }
                if tr == "Serialize" || tr == "Deserialize" {
                    srcs.push(derive_serde_struct(sd, tr, f.aliases));
                } else {
                    srcs.push(derive_struct(sd, tr));
                }
                poss.push(a.pos);
            }
        }
    }
    for ed in f.enums {
        for a in ed.attrs {
            if a.name.starts_with("__") {
                // added by compiler/modres.kek
                continue;
            }
            if a.name != "derive" {
                errs.push(AstError { pos: a.pos, msg: "unknown attribute `#[" + a.name + "]`" });
                continue;
            }
            for tr in a.args {
                if !derive_known(tr, errs, a.pos) {
                    continue;
                }
                let pii = derive_pii_enum(ed);
                if pii != "" && !derive_pii_ok(tr) {
                    errs.push(derive_pii_error(a.pos, tr, ed.name, "variant `" + pii + "`"));
                    continue;
                }
                if tr == "Default" {
                    errs.push(AstError {
                        pos: a.pos,
                        msg: "`#[derive(Default)]` is only supported on structs",
                    });
                    continue;
                }
                if tr == "Serialize" || tr == "Deserialize" {
                    srcs.push(derive_serde_enum(ed, tr, f.aliases));
                } else {
                    srcs.push(derive_enum(ed, tr));
                }
                poss.push(a.pos);
            }
        }
    }
    for i in 0..srcs.len() {
        let pos = poss.get(i).unwrap_or(AstPos { file: "", line: 0, col: 0 });
        let pr = parse_file_at(pos.file, srcs.get(i).unwrap_or(""), ids, Some(pos));
        for e in pr.errs {
            errs.push(e);
        }
        for im in pr.file.impls {
            f.impls.push(im);
        }
    }
}

// Labeled data: Labeled (lib/core/labeled.kek) implements only Clone and
// Deserialize (lib/core/serde.kek), so only these can be derived for a type
// that holds one (a derived equality, Hash, order, default or Serialize
// would need the same of Labeled, and would leak it).

fn derive_pii_ok(tr: String) -> Bool {
    tr == "Clone" || tr == "Deserialize"
}

fn derive_pii_error(pos: AstPos, tr: String, name: String, what: String) -> AstError {
    AstError {
        pos: pos,
        msg: "cannot derive `"
            + tr
            + "` for `"
            + name
            + "`: "
            + what
            + " holds labeled data (`Labeled`), which has no `"
            + tr
            + "` (only `Clone` and `Deserialize` can be derived)",
    }
}

// derive_mentions reports whether type t mentions the type name n.
fn derive_mentions(t: AstType, n: String) -> Bool {
    match t {
        AstType::Named(x) => {
            if x.name == n {
                return true;
            }
            for a in x.args {
                if derive_mentions(a, n) {
                    return true;
                }
            }
            false
        }
        AstType::Ref(x) => derive_mentions(x.elem, n),
        AstType::Unit(_) => false,
        AstType::Tuple(x) => {
            for a in x.elems {
                if derive_mentions(a, n) {
                    return true;
                }
            }
            false
        }
        AstType::Fn(_) => false,
    }
}

// derive_pii_struct is the first field of sd that holds a Labeled ("" if
// none).
fn derive_pii_struct(sd: AstStructDecl) -> String {
    for f in sd.fields {
        if derive_mentions(f.ty, "Labeled") {
            return f.name;
        }
    }
    ""
}

fn derive_pii_enum(ed: AstEnumDecl) -> String {
    for v in ed.variants {
        for t in v.fields {
            if derive_mentions(t, "Labeled") {
                return v.name;
            }
        }
    }
    ""
}

fn derive_known(tr: String, mut errs: Vec<AstError>, pos: AstPos) -> Bool {
    for t in derive_traits() {
        if t == tr {
            return true;
        }
    }
    errs.push(AstError {
        pos: pos,
        msg: "cannot derive `" + tr + "` (derivable: " + derive_traits().join(", ") + ")",
    });
    false
}

// derive_base_name is a type's name without its module (`Point` for the
// global name `geometry$Point`: compiler/modres.kek), as Debug shows it.
fn derive_base_name(name: String) -> String {
    let parts = name.split("$");
    parts.get(parts.len() - 1).unwrap_or(name)
}

// derive_header is `impl<T: Tr, ...> Tr for Name<T, ...>`.
fn derive_header(tr: String, name: String, gs: Vec<AstGeneric>) -> String {
    if gs.len() == 0 {
        return "impl " + tr + " for " + name;
    }
    let mut ps = Vec::new();
    let mut ns = Vec::new();
    for g in gs {
        ps.push(g.name + ": " + tr);
        ns.push(g.name);
    }
    "impl<" + ps.join(", ") + "> " + tr + " for " + name + "<" + ns.join(", ") + ">"
}

fn derive_struct(sd: AstStructDecl, tr: String) -> String {
    let h = derive_header(tr, sd.name, sd.generics);
    let mut fields = Vec::new();
    for f in sd.fields {
        fields.push(f.name);
    }
    let lit = if sd.kind == "tuple" {
        sd.name + "("
    } else {
        sd.name
    };
    derive_body(h, tr, fields, lit)
}

// derive_body is the implementation for a struct or tuple whose fields
// (names or indices) are compared in order. lit is the struct's name
// ("" for a tuple type, "Name(" for a tuple struct).
fn derive_body(h: String, tr: String, fields: Vec<String>, lit: String) -> String {
    if tr == "Eq" {
        return h + " {}\n";
    }
    if tr == "PartialEq" {
        let mut parts = Vec::new();
        for f in fields {
            parts.push("self." + f + " == other." + f);
        }
        if parts.len() == 0 {
            parts.push("true");
        }
        return h
            + " {\n    fn eq(&self, other: &Self) -> Bool {\n        "
            + parts.join(" && ")
            + "\n    }\n}\n";
    }
    if tr == "PartialOrd" || tr == "Ord" {
        let m = if tr == "Ord" { "cmp" } else { "partial_cmp" };
        let eq = if tr == "Ord" {
            "Ordering::Equal"
        } else {
            "Some(Ordering::Equal)"
        };
        let res = if tr == "Ord" {
            "Ordering"
        } else {
            "Option<Ordering>"
        };
        let mut body = "";
        for f in fields {
            body = body
                + "        match self."
                + f
                + "."
                + m
                + "(&other."
                + f
                + ") {\n            "
                + eq
                + " => {}\n            o => {\n                return o;\n            }\n        }\n";
        }
        return h
            + " {\n    fn "
            + m
            + "(&self, other: &Self) -> "
            + res
            + " {\n"
            + body
            + "        "
            + eq
            + "\n    }\n}\n";
    }
    if tr == "Hash" {
        let mut body = "";
        for f in fields {
            body = body + "        self." + f + ".hash(state);\n";
        }
        return h + " {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n" + body + "    }\n}\n";
    }
    if tr == "Debug" {
        // Rust's format: `Point { x: 1, y: 2 }`, `Empty`, `(1, "a")`
        let mut body = "";
        if lit.ends_with("(") {
            // a tuple struct: `Meters(3)`
            body = "        f.write_str(\"" + derive_base_name(lit) + "\");\n";
            let mut k = 0;
            for f in fields {
                if k > 0 {
                    body = body + "        f.write_str(\", \");\n";
                }
                body = body + "        f.write_debug(&self." + f + ");\n";
                k = k + 1;
            }
            body = body + "        f.write_str(\")\");\n";
        } else if lit == "" {
            body = "        f.write_str(\"(\");\n";
            let mut k = 0;
            for f in fields {
                if k > 0 {
                    body = body + "        f.write_str(\", \");\n";
                }
                body = body + "        f.write_debug(&self." + f + ");\n";
                k = k + 1;
            }
            let close = if fields.len() == 1 { ",)" } else { ")" };
            body = body + "        f.write_str(\"" + close + "\");\n";
        } else if fields.len() == 0 {
            body = "        f.write_str(\"" + derive_base_name(lit) + "\");\n";
        } else {
            let mut k = 0;
            for f in fields {
                let sep = if k == 0 {
                    derive_base_name(lit) + " { "
                } else {
                    ", "
                };
                body = body + "        f.write_str(\"" + sep + f + ": \");\n";
                body = body + "        f.write_debug(&self." + f + ");\n";
                k = k + 1;
            }
            body = body + "        f.write_str(\" }\");\n";
        }
        return h + " {\n    fn fmt(&self, f: &mut Formatter) {\n" + body + "    }\n}\n";
    }
    if tr == "Clone" {
        // an owned deep copy: every field cloned
        let mut lit_s = "";
        if lit == "" {
            let mut es = Vec::new();
            for f in fields {
                es.push("self." + f + ".clone()");
            }
            lit_s = "(" + es.join(", ");
            if fields.len() == 1 {
                lit_s = lit_s + ",";
            }
            lit_s = lit_s + ")";
        } else if lit.ends_with("(") {
            let mut es = Vec::new();
            for f in fields {
                es.push("self." + f + ".clone()");
            }
            lit_s = lit + es.join(", ") + ")";
        } else {
            let mut inits = Vec::new();
            for f in fields {
                inits.push(f + ": self." + f + ".clone()");
            }
            lit_s = lit + " { " + inits.join(", ") + " }";
        }
        return h + " {\n    fn clone(&self) -> Self {\n        " + lit_s + "\n    }\n}\n";
    }
    // Default (structs only)
    if lit.ends_with("(") {
        let mut es = Vec::new();
        for f in fields {
            es.push("Default::default()");
        }
        return h
            + " {\n    fn default() -> Self {\n        "
            + lit
            + es.join(", ")
            + ")\n    }\n}\n";
    }
    let mut inits = Vec::new();
    for f in fields {
        inits.push(f + ": Default::default()");
    }
    h
        + " {\n    fn default() -> Self {\n        "
        + lit
        + " { "
        + inits.join(", ")
        + " }\n    }\n}\n"
}

// derive_pat is the pattern `E::V(p0, p1)` binding the fields as
// prefix0, prefix1, ... (`E::V` without fields).
fn derive_pat(en: String, v: AstVariant, prefix: String) -> String {
    if v.named {
        let mut fs = Vec::new();
        let mut i = 0;
        for n in v.names {
            fs.push(n + ": " + prefix + i.to_string());
            i = i + 1;
        }
        return en + "::" + v.name + " { " + fs.join(", ") + " }";
    }
    if v.fields.len() == 0 {
        return en + "::" + v.name;
    }
    let mut ps = Vec::new();
    for i in 0..v.fields.len() {
        ps.push(prefix + i.to_string());
    }
    en + "::" + v.name + "(" + ps.join(", ") + ")"
}

fn derive_enum(ed: AstEnumDecl, tr: String) -> String {
    let h = derive_header(tr, ed.name, ed.generics);
    if tr == "Eq" {
        return h + " {}\n";
    }
    let n = ed.variants.len();
    if tr == "PartialEq" {
        let mut arms = Vec::new();
        for v in ed.variants {
            let mut parts = Vec::new();
            for i in 0..v.fields.len() {
                parts.push("a" + i.to_string() + " == b" + i.to_string());
            }
            if parts.len() == 0 {
                parts.push("true");
            }
            let mut inner = "match other {\n                "
                + derive_pat(ed.name, v, "b")
                + " => "
                + parts.join(" && ")
                + ",\n";
            if n > 1 {
                inner = inner + "                _ => false,\n";
            }
            inner = inner + "            }";
            arms.push("            " + derive_pat(ed.name, v, "a") + " => " + inner + ",\n");
        }
        return h
            + " {\n    fn eq(&self, other: &Self) -> Bool {\n        match self {\n"
            + arms.join("")
            + "        }\n    }\n}\n";
    }
    if tr == "PartialOrd" || tr == "Ord" {
        let m = if tr == "Ord" { "cmp" } else { "partial_cmp" };
        let res = if tr == "Ord" {
            "Ordering"
        } else {
            "Option<Ordering>"
        };
        let wrap_l = if tr == "Ord" { "" } else { "Some(" };
        let wrap_r = if tr == "Ord" { "" } else { ")" };
        let eq = if tr == "Ord" {
            "Ordering::Equal"
        } else {
            "Some(Ordering::Equal)"
        };
        let mut arms = Vec::new();
        let mut i = 0;
        for v in ed.variants {
            let mut inner = Vec::new();
            let mut j = 0;
            for w in ed.variants {
                let mut r = "";
                if j < i {
                    r = wrap_l + "Ordering::Greater" + wrap_r;
                } else if j > i {
                    r = wrap_l + "Ordering::Less" + wrap_r;
                } else {
                    let mut body = "{\n";
                    for k in 0..v.fields.len() {
                        body = body
                            + "                    match a"
                            + k.to_string()
                            + "."
                            + m
                            + "(&b"
                            + k.to_string()
                            + ") {\n                        "
                            + eq
                            + " => {}\n                        o => {\n                            return o;\n                        }\n                    }\n";
                    }
                    r = body + "                    " + eq + "\n                }";
                }
                let pat = if j == i {
                    derive_pat(ed.name, w, "b")
                } else {
                    derive_wild_pat(ed.name, w)
                };
                inner.push("                " + pat + " => " + r + ",\n");
                j = j + 1;
            }
            arms.push(
                "            "
                    + derive_pat(ed.name, v, "a")
                    + " => match other {\n"
                    + inner.join("")
                    + "            },\n",
            );
            i = i + 1;
        }
        return h
            + " {\n    fn "
            + m
            + "(&self, other: &Self) -> "
            + res
            + " {\n        match self {\n"
            + arms.join("")
            + "        }\n    }\n}\n";
    }
    if tr == "Debug" {
        // `V`, `V(1, "a")` (Rust's format, without the enum's name)
        let mut arms = Vec::new();
        for v in ed.variants {
            let mut body = "{\n                f.write_str(\"" + v.name;
            if v.fields.len() > 0 {
                body = body + if v.named { " { " } else { "(" };
            }
            body = body + "\");\n";
            for i in 0..v.fields.len() {
                if i > 0 {
                    body = body + "                f.write_str(\", \");\n";
                }
                if v.named {
                    body = body
                        + "                f.write_str(\""
                        + v.names.get(i).unwrap_or("")
                        + ": \");\n";
                }
                body = body + "                f.write_debug(a" + i.to_string() + ");\n";
            }
            if v.fields.len() > 0 {
                body = body
                    + "                f.write_str(\""
                    + if v.named { " }" } else { ")" }
                    + "\");\n";
            }
            arms.push(
                "            " + derive_pat(ed.name, v, "a") + " => " + body + "            }\n",
            );
        }
        return h
            + " {\n    fn fmt(&self, f: &mut Formatter) {\n        match self {\n"
            + arms.join("")
            + "        }\n    }\n}\n";
    }
    if tr == "Clone" {
        let mut arms = Vec::new();
        for v in ed.variants {
            let mut r = ed.name + "::" + v.name;
            if v.named {
                let mut fs = Vec::new();
                let mut i = 0;
                for n in v.names {
                    fs.push(n + ": a" + i.to_string() + ".clone()");
                    i = i + 1;
                }
                r = r + " { " + fs.join(", ") + " }";
            } else if v.fields.len() > 0 {
                let mut es = Vec::new();
                for i in 0..v.fields.len() {
                    es.push("a" + i.to_string() + ".clone()");
                }
                r = r + "(" + es.join(", ") + ")";
            }
            arms.push("            " + derive_pat(ed.name, v, "a") + " => " + r + ",\n");
        }
        return h
            + " {\n    fn clone(&self) -> Self {\n        match self {\n"
            + arms.join("")
            + "        }\n    }\n}\n";
    }
    // Hash: the variant index, then the fields
    let mut arms = Vec::new();
    let mut i = 0;
    for v in ed.variants {
        let mut body = "{\n                state.write_i64(" + i.to_string() + ");\n";
        for k in 0..v.fields.len() {
            body = body + "                a" + k.to_string() + ".hash(state);\n";
        }
        arms.push("            " + derive_pat(ed.name, v, "a") + " => " + body + "            }\n");
        i = i + 1;
    }
    h
        + " {\n    fn hash<H: Hasher>(&self, state: &mut H) {\n        match self {\n"
        + arms.join("")
        + "        }\n    }\n}\n"
}

fn derive_wild_pat(en: String, v: AstVariant) -> String {
    if v.named {
        return en + "::" + v.name + " { .. }";
    }
    if v.fields.len() == 0 {
        return en + "::" + v.name;
    }
    let mut ps = Vec::new();
    for f in v.fields {
        ps.push("_");
    }
    en + "::" + v.name + "(" + ps.join(", ") + ")"
}

// derive_tuples is the core library's implementations of the derivable
// traits (but Default) for tuples of 1 to 8 elements.
fn derive_tuples() -> String {
    let names = "T0 T1 T2 T3 T4 T5 T6 T7".split(" ");
    let mut out = "";
    for n in 1..9 {
        let mut ns = Vec::new();
        let mut fields = Vec::new();
        for i in 0..n {
            ns.push(names.get(i).unwrap_or("A"));
            fields.push(i.to_string());
        }
        let ty = if n == 1 {
            "(T0,)"
        } else {
            "(" + ns.join(", ") + ")"
        };
        for tr in "PartialEq Eq PartialOrd Ord Hash Clone Debug".split(" ") {
            let mut ps = Vec::new();
            for x in ns {
                ps.push(x + ": " + tr);
            }
            let h = "impl<" + ps.join(", ") + "> " + tr + " for " + ty;
            out = out + derive_body(h, tr, fields, "") + "\n";
        }
    }
    out
}

// ---- Serialize and Deserialize (lib/core/serde.kek) ----
//
// A struct is a map of its fields in order; an enum variant is externally
// tagged: `"V"` without fields, `{"V": x}` with one, `{"V": [x, y]}` with
// more. Deserialize reads every field into a local of the field's type with
// the aliases resolved, checks the predicates of the refined aliases in it
// (which also gives the refinement checker the facts to build the value),
// and builds the value.

fn derive_serde_struct(sd: AstStructDecl, tr: String, aliases: Vec<AstTypeAlias>) -> String {
    let h = derive_header(tr, sd.name, sd.generics);
    if sd.kind != "" {
        return derive_serde_tuple_struct(sd, tr, h, aliases);
    }
    if tr == "Serialize" {
        let mut body = "        let mut fields = Vec::new();\n";
        for f in sd.fields {
            body = body
                + "        fields.push((\""
                + f.name
                + "\", self."
                + f.name
                + ".to_value()));\n";
        }
        return h
            + " {\n    fn to_value(&self) -> Value {\n"
            + body
            + "        Value::Map(fields)\n    }\n}\n";
    }
    let mut body = "        v.expect_map(\"" + ast_display_name(sd.name) + "\")?;\n";
    let mut inits = Vec::new();
    let mut i = 0;
    for f in sd.fields {
        let x = "f" + i.to_string();
        body = body
            + "        let "
            + x
            + ": "
            + derive_ty(f.ty, aliases)
            + " = v.field(\""
            + f.name
            + "\")?;\n"
            + derive_checks(f.ty, x, "\"" + f.name + "\"", aliases, 0, "        ");
        inits.push(f.name + ": " + x);
        i = i + 1;
    }
    h
        + " {\n    fn from_value(v: &Value) -> Result<Self, SerdeError> {\n"
        + body
        + "        Ok("
        + sd.name
        + " { "
        + inits.join(", ")
        + " })\n    }\n}\n"
}

// derive_serde_tuple_struct: like serde, a unit struct is null, a newtype
// `S(T)` is its field and a tuple struct with more fields is a sequence.
fn derive_serde_tuple_struct(
    sd: AstStructDecl,
    tr: String,
    h: String,
    aliases: Vec<AstTypeAlias>,
) -> String {
    let n = sd.fields.len();
    if tr == "Serialize" {
        let mut r = "Value::Null";
        if n == 1 {
            r = "self.0.to_value()";
        } else if n > 1 {
            r = "let mut xs = Vec::new();\n";
            for k in 0..n {
                r = r + "        xs.push(self." + k.to_string() + ".to_value());\n";
            }
            r = r + "        Value::Seq(xs)";
        }
        return h + " {\n    fn to_value(&self) -> Value {\n        " + r + "\n    }\n}\n";
    }
    let mut body = "";
    let mut args = Vec::new();
    if n == 0 {
        body = "        let u: () = Deserialize::from_value(v)?;\n";
    }
    let mut k = 0;
    for f in sd.fields {
        let x = "f" + k.to_string();
        let read = if n == 1 {
            "Deserialize::from_value(v)?"
        } else {
            "v.element(\""
                + ast_display_name(sd.name)
                + "\", "
                + k.to_string()
                + ", "
                + n.to_string()
                + ")?"
        };
        body = body
            + "        let "
            + x
            + ": "
            + derive_ty(f.ty, aliases)
            + " = "
            + read
            + ";\n"
            + derive_checks(
                f.ty,
                x,
                "\"" + ast_display_name(sd.name) + "\"",
                aliases,
                0,
                "        ",
            );
        args.push(x);
        k = k + 1;
    }
    let built = if sd.kind == "unit" {
        sd.name
    } else {
        sd.name + "(" + args.join(", ") + ")"
    };
    h
        + " {\n    fn from_value(v: &Value) -> Result<Self, SerdeError> {\n"
        + body
        + "        Ok("
        + built
        + ")\n    }\n}\n"
}

fn derive_serde_enum(ed: AstEnumDecl, tr: String, aliases: Vec<AstTypeAlias>) -> String {
    let h = derive_header(tr, ed.name, ed.generics);
    if tr == "Serialize" {
        let mut arms = Vec::new();
        for v in ed.variants {
            let tag = "\"" + v.name + "\"";
            let n = v.fields.len();
            let mut r = "Value::Str(" + tag + ")";
            if v.named {
                // `{"V": {"a": x, "b": y}}`
                let mut pushes = "";
                let mut k = 0;
                for name in v.names {
                    pushes = pushes
                        + "                fs.push((\""
                        + name
                        + "\", a"
                        + k.to_string()
                        + ".to_value()));\n";
                    k = k + 1;
                }
                r = "{\n                let mut fs = Vec::new();\n"
                    + pushes
                    + "                Value::tagged("
                    + tag
                    + ", Value::Map(fs))\n            }";
            } else if n == 1 {
                r = "Value::tagged(" + tag + ", a0.to_value())";
            } else if n > 1 {
                let mut pushes = "";
                for k in 0..n {
                    pushes = pushes
                        + "                xs.push(a"
                        + k.to_string()
                        + ".to_value());\n";
                }
                r = "{\n                let mut xs = Vec::new();\n"
                    + pushes
                    + "                Value::tagged("
                    + tag
                    + ", Value::Seq(xs))\n            }";
            }
            arms.push("            " + derive_pat(ed.name, v, "a") + " => " + r + ",\n");
        }
        return h
            + " {\n    fn to_value(&self) -> Value {\n        match self {\n"
            + arms.join("")
            + "        }\n    }\n}\n";
    }
    let mut body = "        let tag = v.variant_name(\""
        + ed.name
        + "\")?;\n        let p = v.variant_payload();\n";
    for v in ed.variants {
        let n = v.fields.len();
        let mut inner = "";
        if v.named {
            inner = "            p.expect_map(\""
                + ast_display_name(ed.name)
                + "::"
                + v.name
                + "\")?;\n";
        }
        let mut args = Vec::new();
        for k in 0..n {
            let x = "a" + k.to_string();
            let t = v.fields.get(k).unwrap_or(
                AstType::Unit(AstUnitType { id: 0, pos: AstPos { file: "", line: 0, col: 0 } }),
            );
            let read = if v.named {
                "p.field(\"" + v.names.get(k).unwrap_or("") + "\")?"
            } else if n == 1 {
                "p.decode_in(\"" + v.name + "\")?"
            } else {
                "p.element(\"" + v.name + "\", " + k.to_string() + ", " + n.to_string() + ")?"
            };
            let path = if v.named {
                "\"" + v.name + "." + v.names.get(k).unwrap_or("") + "\""
            } else {
                "\"" + v.name + "\""
            };
            inner = inner
                + "            let "
                + x
                + ": "
                + derive_ty(t, aliases)
                + " = "
                + read
                + ";\n"
                + derive_checks(t, x, path, aliases, 0, "            ");
            args.push(x);
        }
        let built = if v.named {
            derive_pat(ed.name, v, "a")
        } else if n == 0 {
            ed.name + "::" + v.name
        } else {
            ed.name + "::" + v.name + "(" + args.join(", ") + ")"
        };
        body = body
            + "        if tag == \""
            + v.name
            + "\" {\n"
            + inner
            + "            return Ok("
            + built
            + ");\n        }\n";
    }
    h
        + " {\n    fn from_value(v: &Value) -> Result<Self, SerdeError> {\n"
        + body
        + "        Err(v.unknown_variant(\""
        + ed.name
        + "\", tag))\n    }\n}\n"
}

fn derive_alias(name: String, aliases: Vec<AstTypeAlias>) -> Option<AstTypeAlias> {
    for a in aliases {
        if a.name == name {
            return Some(a);
        }
    }
    None
}

// derive_ty is the source of type t with the aliases resolved (so that a
// local of a refined type can be bound before its predicate is checked).
fn derive_ty(t: AstType, aliases: Vec<AstTypeAlias>) -> String {
    match t {
        AstType::Named(x) => {
            if x.args.len() == 0 {
                match derive_alias(x.name, aliases) {
                    Some(a) => {
                        return derive_ty(a.ty, aliases);
                    }
                    None => {}
                }
            }
            if x.args.len() == 0 {
                return x.name;
            }
            let mut args = Vec::new();
            for a in x.args {
                args.push(derive_ty(a, aliases));
            }
            x.name + "<" + args.join(", ") + ">"
        }
        AstType::Ref(x) => {
            let m = if x.mutable { "&mut " } else { "&" };
            m + derive_ty(x.elem, aliases)
        }
        AstType::Unit(_) => "()",
        AstType::Tuple(x) => {
            let mut es = Vec::new();
            for e in x.elems {
                es.push(derive_ty(e, aliases));
            }
            if es.len() == 1 {
                "(" + es.join("") + ",)"
            } else {
                "(" + es.join(", ") + ")"
            }
        }
        AstType::Fn(_) => fmt_typ(t),
    }
}

// derive_checks is the code that returns an error unless the value x of
// type t satisfies the predicates of the refined aliases in t (directly,
// or in the elements of an Option or a Vec). path is an expression: the
// field's name, with the index of each Vec element.
fn derive_checks(
    t: AstType,
    x: String,
    path: String,
    aliases: Vec<AstTypeAlias>,
    depth: Int,
    ind: String,
) -> String {
    match t {
        AstType::Named(n) => {
            if n.args.len() == 0 {
                return match derive_alias(n.name, aliases) {
                    Some(a) => {
                        let inner = derive_checks(a.ty, x, path, aliases, depth, ind);
                        match a.pred {
                            Some(p) => inner
                                + ind
                                + "if !("
                                + derive_pred(p, x)
                                + ") {\n"
                                + ind
                                + "    return Err(v.refused("
                                + path
                                + ", \""
                                + n.name
                                + "\"));\n"
                                + ind
                                + "}\n",
                            None => inner,
                        }
                    }
                    None => "",
                };
            }
            if n.args.len() == 1 && (n.name == "Option" || n.name == "Vec") {
                let y = "e" + depth.to_string();
                let i = "i" + depth.to_string();
                let inner_path = if n.name == "Vec" {
                    path + " + \"[\" + " + i + ".to_string() + \"]\""
                } else {
                    path
                };
                let inner = derive_checks(
                    n.args.get(0).unwrap_or(t),
                    y,
                    inner_path,
                    aliases,
                    depth + 1,
                    ind + "        ",
                );
                if inner == "" {
                    return "";
                }
                if n.name == "Option" {
                    return ind
                        + "match "
                        + x
                        + " {\n"
                        + ind
                        + "    Some("
                        + y
                        + ") => {\n"
                        + inner
                        + ind
                        + "    }\n"
                        + ind
                        + "    None => {}\n"
                        + ind
                        + "}\n";
                }
                return ind
                    + "for ("
                    + i
                    + ", "
                    + y
                    + ") in "
                    + x
                    + ".iter().enumerate() {\n"
                    + inner
                    + ind
                    + "}\n";
            }
            ""
        }
        AstType::Ref(r) => derive_checks(r.elem, x, path, aliases, depth, ind),
        _ => "",
    }
}

// derive_pred is the source of the predicate e of a refined alias with
// `self` replaced by x (predicates are linear: literals, variables, fields,
// `len()`, arithmetic, comparisons and connectives).
fn derive_pred(e: AstExpr, x: String) -> String {
    match e {
        AstExpr::IntLit(n) => if n.value < 0 {
            "(" + n.value.to_string() + ")"
        } else {
            n.value.to_string()
        },
        AstExpr::BoolLit(b) => if b.value { "true" } else { "false" },
        AstExpr::Ident(i) => if i.name == "self" { x } else { i.name },
        AstExpr::Binary(b) => "("
            + derive_pred(b.x, x)
            + " "
            + b.op
            + " "
            + derive_pred(b.y, x)
            + ")",
        AstExpr::Unary(u) => u.op + "(" + derive_pred(u.x, x) + ")",
        AstExpr::Field(f) => derive_pred(f.x, x) + "." + f.name,
        AstExpr::Method(m) => {
            let mut args = Vec::new();
            for a in m.args {
                args.push(derive_pred(a, x));
            }
            derive_pred(m.recv, x) + "." + m.name + "(" + args.join(", ") + ")"
        }
        _ => "true",
    }
}
