// Float literals: the correctly rounded IEEE 754 binary64 bits of a
// decimal literal. A copy of the parser in lib/core/flt.kek (the compiler
// is built by the bootstrap compiler, which has no Float), with the prefix
// flit_ instead of __flt_.

// flit_bits is the bits of a literal as written (`1_000.5`, `2.5e-3`,
// `1e10`): `_` separators are dropped; overflow gives infinity.
fn flit_bits(text: String) -> Option<Int> {
    flit_parse(text.replace("_", ""))
}

fn flit_nan() -> Int {
    9221120237041090560
}

fn flit_inf() -> Int {
    9218868437227405312
}

fn flit_sign() -> Int {
    -9223372036854775807 - 1
}

fn flit_hidden() -> Int {
    4503599627370496
}

// ---- big integers ----

fn flit_limb() -> Int {
    1073741824
}

fn flit_mask() -> Int {
    1073741823
}

fn flit_ibits(x: Int) -> Int {
    let mut n = 0;
    let mut v = x;
    while v > 0 {
        v = v.shr(1);
        n = n + 1;
    }
    n
}

fn flit_big_norm(mut a: Vec<Int>) -> Vec<Int> {
    while a.len() > 0 && a.get(a.len() - 1).unwrap_or(1) == 0 {
        a.pop();
    }
    a
}

// x >= 0
fn flit_big(x: Int) -> Vec<Int> {
    let mut r = Vec::new();
    let mut v = x;
    while v > 0 {
        r.push(v.bit_and(flit_mask()));
        v = v.shr(30);
    }
    r
}

// the value of a, which must fit in 62 bits
fn flit_big_int(a: Vec<Int>) -> Int {
    let mut r = 0;
    let mut i = a.len() - 1;
    while i >= 0 {
        r = r.shl(30).bit_or(a.get(i).unwrap_or(0));
        i = i - 1;
    }
    r
}

fn flit_big_bits(a: Vec<Int>) -> Int {
    let n = a.len();
    if n == 0 {
        return 0;
    }
    30 * (n - 1) + flit_ibits(a.get(n - 1).unwrap_or(0))
}

fn flit_big_cmp(a: Vec<Int>, b: Vec<Int>) -> Int {
    let na = a.len();
    let nb = b.len();
    if na != nb {
        return if na < nb { -1 } else { 1 };
    }
    let mut i = na - 1;
    while i >= 0 {
        let x = a.get(i).unwrap_or(0);
        let y = b.get(i).unwrap_or(0);
        if x != y {
            return if x < y { -1 } else { 1 };
        }
        i = i - 1;
    }
    0
}

fn flit_big_add(a: Vec<Int>, b: Vec<Int>) -> Vec<Int> {
    let n = if a.len() > b.len() { a.len() } else { b.len() };
    let mut r = Vec::new();
    let mut carry = 0;
    let mut i = 0;
    while i < n {
        let s = a.get(i).unwrap_or(0) + b.get(i).unwrap_or(0) + carry;
        r.push(s.bit_and(flit_mask()));
        carry = s.shr(30);
        i = i + 1;
    }
    if carry > 0 {
        r.push(carry);
    }
    r
}

// a - b for a >= b
fn flit_big_sub(a: Vec<Int>, b: Vec<Int>) -> Vec<Int> {
    let mut r = Vec::new();
    let mut borrow = 0;
    let mut i = 0;
    let n = a.len();
    while i < n {
        let mut s = a.get(i).unwrap_or(0) - b.get(i).unwrap_or(0) - borrow;
        if s < 0 {
            s = s + flit_limb();
            borrow = 1;
        } else {
            borrow = 0;
        }
        r.push(s);
        i = i + 1;
    }
    flit_big_norm(r)
}

// a * m for 0 <= m < 2^32
fn flit_big_mul_small(a: Vec<Int>, m: Int) -> Vec<Int> {
    if m == 0 {
        return Vec::new();
    }
    let mut r = Vec::new();
    let mut carry = 0;
    for x in a {
        let p = x * m + carry;
        r.push(p.bit_and(flit_mask()));
        carry = p.shr(30);
    }
    while carry > 0 {
        r.push(carry.bit_and(flit_mask()));
        carry = carry.shr(30);
    }
    r
}

fn flit_big_shl(a: Vec<Int>, n: Int) -> Vec<Int> {
    if a.len() == 0 {
        return a;
    }
    let q = n / 30;
    let s = n % 30;
    let mut r = Vec::new();
    for k in 0..q {
        r.push(0);
    }
    if s == 0 {
        for x in a {
            r.push(x);
        }
        return r;
    }
    let mut carry = 0;
    for x in a {
        r.push(x.shl(s).bit_and(flit_mask()).bit_or(carry));
        carry = x.shr(30 - s);
    }
    if carry > 0 {
        r.push(carry);
    }
    r
}

fn flit_big_shr(a: Vec<Int>, n: Int) -> Vec<Int> {
    let q = n / 30;
    let s = n % 30;
    let len = a.len();
    let mut r = Vec::new();
    let mut i = q;
    while i < len {
        let lo = a.get(i).unwrap_or(0).shr(s);
        let hi = if s == 0 {
            0
        } else {
            a.get(i + 1).unwrap_or(0).shl(30 - s).bit_and(flit_mask())
        };
        r.push(lo.bit_or(hi));
        i = i + 1;
    }
    flit_big_norm(r)
}

fn flit_pow10_small(k: Int) -> Int {
    let mut r = 1;
    for i in 0..k {
        r = r * 10;
    }
    r
}

// a * 10^k for k >= 0
fn flit_big_mul_pow10(a: Vec<Int>, k: Int) -> Vec<Int> {
    let mut r = a;
    let mut n = k;
    while n >= 9 {
        r = flit_big_mul_small(r, 1000000000);
        n = n - 9;
    }
    if n > 0 {
        r = flit_big_mul_small(r, flit_pow10_small(n));
    }
    r
}

// (a / d, a % d) for 0 < d < 2^31
fn flit_big_divmod_small(a: Vec<Int>, d: Int) -> (Vec<Int>, Int) {
    let n = a.len();
    let mut q = Vec::new();
    for k in 0..n {
        q.push(0);
    }
    let mut rem = 0;
    let mut i = n - 1;
    while i >= 0 {
        let cur = rem.shl(30).bit_or(a.get(i).unwrap_or(0));
        q.set(i, cur / d);
        rem = cur % d;
        i = i - 1;
    }
    (flit_big_norm(q), rem)
}

// a / 2^k when that fits in 62 bits
fn flit_big_top(a: Vec<Int>, k: Int) -> Int {
    let q = k / 30;
    let sh = k % 30;
    let mut r = 0;
    let mut i = a.len() - 1;
    while i > q {
        r = r.shl(30).bit_or(a.get(i).unwrap_or(0));
        i = i - 1;
    }
    r.shl(30 - sh).bit_or(a.get(q).unwrap_or(0).shr(sh))
}

// (a / s, a % s) for s > 0 when the quotient fits in 62 bits.
fn flit_big_divmod(a: Vec<Int>, s: Vec<Int>) -> (Int, Vec<Int>) {
    let mut q = 0;
    let mut r = a;
    let bs = flit_big_bits(s);
    let ks = if bs > 31 { bs - 31 } else { 0 };
    let shi = flit_big_top(s, ks) + 1;
    while flit_big_cmp(r, s) >= 0 {
        let br = flit_big_bits(r);
        if br <= 62 {
            let ri = flit_big_int(r);
            let si = flit_big_int(s);
            q = q + ri / si;
            return (q, flit_big(ri % si));
        }
        let ka = br - 61;
        let ahi = flit_big_top(r, ka);
        let qe = ahi / shi;
        let sh = ka - ks;
        if sh >= 0 {
            r = flit_big_sub(r, flit_big_shl(flit_big_mul_small(s, qe), sh));
            q = q + qe.shl(sh);
        } else {
            let qq = qe.shr(0 - sh);
            if qq == 0 {
                r = flit_big_sub(r, s);
                q = q + 1;
            } else {
                r = flit_big_sub(r, flit_big_mul_small(s, qq));
                q = q + qq;
            }
        }
    }
    (q, r)
}

// the decimal digits of a
fn flit_big_dec(a: Vec<Int>) -> String {
    if a.len() == 0 {
        return "0";
    }
    if a.len() <= 2 {
        return flit_big_int(a).to_string();
    }
    let mut chunks = Vec::new();
    let mut x = a;
    while x.len() > 0 {
        let (q, r) = flit_big_divmod_small(x, 1000000000);
        chunks.push(r);
        x = q;
    }
    let mut s = "";
    let mut i = chunks.len() - 1;
    let mut first = true;
    while i >= 0 {
        let c = chunks.get(i).unwrap_or(0).to_string();
        if first {
            s = c;
            first = false;
        } else {
            s = s + "000000000".slice(0, 9 - c.len()) + c;
        }
        i = i - 1;
    }
    s
}

// ---- parsing ----

// flit_finish assembles the bits of q * 2^b (q < 2^53, b >= -1074)
// rounded by half: the sign of (remainder - divisor / 2).
fn flit_finish(neg: Bool, q0: Int, half: Int, b0: Int) -> Int {
    let mut q = q0;
    let mut b = b0;
    if half > 0 || (half == 0 && q.bit_and(1) == 1) {
        q = q + 1;
    }
    if q == 2 * flit_hidden() {
        q = flit_hidden();
        b = b + 1;
    }
    let sign = if neg { flit_sign() } else { 0 };
    if b > 971 {
        return sign.bit_or(flit_inf());
    }
    if q < flit_hidden() {
        return sign.bit_or(q);
    }
    sign.bit_or((b + 1075).shl(52)).bit_or(q - flit_hidden())
}

fn flit_digit(c: Int) -> Int {
    if c >= 48 && c <= 57 { c - 48 } else { -1 }
}

// flit_parse reads a decimal floating point number (Rust's f64 grammar:
// `[+-](digits[.digits]|.digits)[(e|E)[+-]digits]`, `inf`, `infinity`,
// `nan`, case-insensitive) as correctly rounded bits.
fn flit_parse(s: String) -> Option<Int> {
    let n = s.len();
    let mut i = 0;
    let mut neg = false;
    let c0 = s.char_at(0).unwrap_or(-1);
    if c0 == 43 || c0 == 45 {
        neg = c0 == 45;
        i = 1;
    }
    let sign = if neg { flit_sign() } else { 0 };
    let rest = s.slice(i, n).to_lower();
    if rest == "inf" || rest == "infinity" {
        return Some(sign.bit_or(flit_inf()));
    }
    if rest == "nan" {
        return Some(flit_nan());
    }
    let mut digits = Vec::new();
    let mut nd = 0; // digits seen (including leading zeros)
    let mut frac = 0;
    let mut dot = false;
    let mut done = false;
    while i < n && !done {
        let c = s.char_at(i).unwrap_or(0);
        let d = flit_digit(c);
        if d >= 0 {
            nd = nd + 1;
            if dot {
                frac = frac + 1;
            }
            if d != 0 || digits.len() > 0 {
                digits.push(d);
            }
            i = i + 1;
        } else if c == 46 && !dot {
            dot = true;
            i = i + 1;
        } else {
            done = true;
        }
    }
    if nd == 0 {
        return None;
    }
    let mut exp = 0;
    if i < n {
        let c = s.char_at(i).unwrap_or(0);
        if c != 101 && c != 69 {
            return None;
        }
        i = i + 1;
        let mut eneg = false;
        let ce = s.char_at(i).unwrap_or(-1);
        if ce == 43 || ce == 45 {
            eneg = ce == 45;
            i = i + 1;
        }
        if i >= n {
            return None;
        }
        while i < n {
            let d = flit_digit(s.char_at(i).unwrap_or(0));
            if d < 0 {
                return None;
            }
            if exp < 100000000 {
                exp = exp * 10 + d;
            }
            i = i + 1;
        }
        if eneg {
            exp = 0 - exp;
        }
    }
    // value = digits * 10^e10
    let mut e10 = exp - frac;
    while digits.len() > 0 && digits.get(digits.len() - 1).unwrap_or(1) == 0 {
        digits.pop();
        e10 = e10 + 1;
    }
    let m = digits.len();
    if m == 0 {
        return Some(sign);
    }
    if m + e10 > 310 {
        return Some(sign.bit_or(flit_inf()));
    }
    if m + e10 < -326 {
        return Some(sign);
    }
    if m <= 18 {
        let mut d = 0;
        for x in digits {
            d = d * 10 + x;
        }
        if e10 >= 0 && e10 <= 18 {
            let p = flit_pow10_small(e10);
            if d <= 9223372036854775807 / p {
                return Some(flit_from_ratio_int(neg, d * p, 1));
            }
        } else if e10 < 0 && e10 >= -18 {
            let p = flit_pow10_small(0 - e10);
            let b = flit_ibits(d) - flit_ibits(p) - 53;
            if b < 0 && flit_ibits(d) - b <= 62 {
                return Some(flit_from_ratio_int(neg, d, p));
            }
        }
    }
    let mut big = Vec::new();
    let mut k = 0;
    while k < m {
        let take = if m - k >= 9 { 9 } else { m - k };
        let mut chunk = 0;
        for j in 0..take {
            chunk = chunk * 10 + digits.get(k + j).unwrap_or(0);
        }
        big = flit_big_add(flit_big_mul_small(big, flit_pow10_small(take)), flit_big(chunk));
        k = k + take;
    }
    if e10 >= 0 {
        Some(flit_from_ratio(neg, flit_big_mul_pow10(big, e10), flit_big(1)))
    } else {
        Some(flit_from_ratio(neg, big, flit_big_mul_pow10(flit_big(1), 0 - e10)))
    }
}

// the bits of n / s rounded to nearest (n, s > 0, n < 2^62, s < 2^61)
fn flit_from_ratio_int(neg: Bool, n: Int, s: Int) -> Int {
    let mut b = flit_ibits(n) - flit_ibits(s) - 53;
    let mut a = n;
    let mut sd = s;
    if b >= 0 {
        if flit_ibits(s) + b > 61 {
            return flit_from_ratio(neg, flit_big(n), flit_big(s));
        }
        sd = s.shl(b);
    } else {
        if flit_ibits(n) - b > 62 {
            return flit_from_ratio(neg, flit_big(n), flit_big(s));
        }
        a = n.shl(0 - b);
    }
    let mut q = a / sd;
    let mut r = a % sd;
    if q >= 2 * flit_hidden() {
        // halve the quotient: the dropped bit joins the remainder
        if flit_ibits(sd) > 60 {
            return flit_from_ratio(neg, flit_big(n), flit_big(s));
        }
        r = r + q.bit_and(1) * sd;
        sd = sd * 2;
        q = q.shr(1);
        b = b + 1;
    }
    let tr = 2 * r;
    let half = if tr > sd {
        1
    } else if tr < sd { -1 } else { 0 };
    flit_finish(neg, q, half, b)
}

// the bits of n / s rounded to nearest (big integers, n, s > 0)
fn flit_from_ratio(neg: Bool, n: Vec<Int>, s: Vec<Int>) -> Int {
    let mut b = flit_big_bits(n) - flit_big_bits(s) - 53;
    if b < -1074 {
        b = -1074;
    }
    if b > 1000 {
        return if neg { flit_sign() } else { 0 }.bit_or(flit_inf());
    }
    let mut a = n;
    let mut sd = s;
    if b >= 0 {
        sd = flit_big_shl(s, b);
    } else {
        a = flit_big_shl(n, 0 - b);
    }
    let (q0, r0) = flit_big_divmod(a, sd);
    let mut q = q0;
    let mut r = r0;
    if q >= 2 * flit_hidden() {
        if q.bit_and(1) == 1 {
            r = flit_big_add(r, sd);
        }
        sd = flit_big_shl(sd, 1);
        q = q.shr(1);
        b = b + 1;
    }
    let half = flit_big_cmp(flit_big_shl(r, 1), sd);
    flit_finish(neg, q, half, b)
}
