// `fmt [-w] [-check] <paths...>`. Directories are searched recursively
// for *.kek (skipping `.*` below the root); without -w or -check the
// formatted sources are printed.

struct FmtFile {
    path: String,
    text: String,
}

// fmt_join joins a directory that fmt walks and an entry name.
fn fmt_join(dir: String, name: String) -> String {
    let d = frontend_clean_dir(dir);
    if d == "." {
        return name;
    }
    if d.ends_with("/") {
        return d + name;
    }
    d + "/" + name
}

// fmt_walk appends the .kek files below dir (whose sorted entries are
// names) in lexical order, depth first. A path is a directory iff Fs.list
// succeeds on it.
fn fmt_walk(dir: String, names: Vec<String>, fs: &Fs, files: Vec<String>) {
    for name in names {
        let path = fmt_join(dir, name);
        match fs.list(path) {
            Ok(sub) => {
                if !name.starts_with(".") {
                    fmt_walk(path, sub, fs, files);
                }
            }
            Err(_) => {
                if path.ends_with(".kek") {
                    files.push(path);
                }
            }
        }
    }
}

fn fmt_usage(log: &Log) {
    log.error("usage: kek fmt [-w|-check] <paths>  (directories are searched for *.kek)");
}

fn fmt_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    let mut write = false;
    let mut check = false;
    let paths = Vec::new();
    let mut flags = true;
    let n = args.len();
    for i in 1..n {
        let a = args.get(i).unwrap_or("");
        if flags && a == "--" {
            flags = false;
        } else if flags && a.starts_with("-") && a != "-" {
            let mut f = a.slice(1, a.len());
            if f.starts_with("-") {
                f = f.slice(1, f.len());
            }
            if f == "w" || f == "w=true" {
                write = true;
            } else if f == "w=false" {
                write = false;
            } else if f == "check" || f == "check=true" {
                check = true;
            } else if f == "check=false" {
                check = false;
            } else if f == "h" || f == "help" {
                fmt_usage(log);
                return 0;
            } else {
                log.error("flag provided but not defined: " + a);
                fmt_usage(log);
                return 2;
            }
        } else {
            flags = false;
            paths.push(a);
        }
    }
    if paths.len() == 0 {
        log.error("kek fmt: expected .kek files or directories");
        return 1;
    }
    let files = Vec::new();
    for arg in paths {
        match fs.list(arg) {
            Ok(names) => fmt_walk(arg, names, fs, files),
            Err(_) => match fs.read(arg) {
                Ok(_) => files.push(arg),
                Err(e) => {
                    log.error(arg + ": " + e.message());
                    return 1;
                }
            },
        }
    }
    let unformatted = Vec::new();
    let mut failed = false;
    for path in files {
        let src = match fs.read(path) {
            Ok(s) => s,
            Err(e) => {
                log.error(path + ": " + e.message());
                return 1;
            }
        };
        let res = fmt_source(src);
        if res.errs.len() > 0 {
            failed = true;
            let lines = Vec::new();
            for e in res.errs {
                lines.push(path + ":" + ast_error_string(e));
            }
            log.error(lines.join("\n"));
            continue;
        }
        let out = res.out;
        if check {
            if src != out {
                unformatted.push(path);
            }
        } else if write {
            if src != out {
                match fs.write(path, out) {
                    Ok(_) => {}
                    Err(e) => {
                        log.error(path + ": " + e.message());
                        return 1;
                    }
                }
            }
        } else if out.ends_with("\n") {
            log.info(out.slice(0, out.len() - 1));
        } else if out != "" {
            log.info(out);
        }
    }
    if unformatted.len() > 0 {
        log.info(unformatted.join("\n"));
        log.error(
            "kek fmt: "
                + unformatted.len().to_string()
                + " file(s) need formatting (run `kek fmt -w`)",
        );
        return 1;
    }
    if failed {
        log.error("kek fmt: some files could not be parsed");
        return 1;
    }
    0
}
