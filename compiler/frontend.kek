// Front-end entry: `lex <file>`, `ast <file>`, `check <file-or-dir>`,
// `ir <file-or-dir>`, `build <file-or-dir> <outdir>`.

struct FeSource {
    name: String,
    text: String,
}

struct FeProgram {
    file: AstFile,
    errs: Vec<AstError>,
}

fn frontend_print(log: &Log, lines: Vec<String>) {
    if lines.len() > 0 {
        log.info(lines.join("\n"));
    }
}

fn frontend_print_errors(log: &Log, errs: Vec<AstError>) {
    let lines = Vec::new();
    for e in errs {
        lines.push(ast_error_string(e));
    }
    if lines.len() > 0 {
        log.error(lines.join("\n"));
    }
}

// frontend_clean_dir approximates filepath.Clean for directory arguments.
fn frontend_clean_dir(d: String) -> String {
    let mut s = d;
    while s.starts_with("./") && s.len() > 2 {
        s = s.slice(2, s.len());
    }
    while s.ends_with("/") && s.len() > 1 {
        s = s.slice(0, s.len() - 1);
    }
    s
}

// frontend_read_sources reads a .kek file, or every .kek file of a
// directory sorted by name (driver.ReadSources). Errors are reported.
fn frontend_read_sources(path: String, fs: &Fs, log: &Log) -> Option<Vec<FeSource>> {
    let srcs = Vec::new();
    let names = Vec::new();
    match fs.list(path) {
        Ok(entries) => {
            let dir = frontend_clean_dir(path);
            for n in entries {
                if n.ends_with(".kek") {
                    if dir == "." {
                        names.push(n);
                    } else {
                        names.push(dir + "/" + n);
                    }
                }
            }
            if names.len() == 0 {
                log.error(path + ": no .kek files");
                return None;
            }
        }
        Err(_) => names.push(path),
    }
    for n in names {
        match fs.read(n) {
            Ok(text) => srcs.push(FeSource { name: n, text: text }),
            Err(e) => {
                log.error(n + ": " + e.message());
                return None;
            }
        }
    }
    Some(srcs)
}

// frontend_parse_all parses the files of one program into a single AstFile
// (syntax.ParseFiles).
fn frontend_parse_all(srcs: Vec<FeSource>) -> FeProgram {
    let ids = AstIds { next: 0 };
    let out = AstFile { structs: Vec::new(), enums: Vec::new(), funcs: Vec::new() };
    let errs = Vec::new();
    for s in srcs {
        let pr = parse_file(s.name, s.text, ids);
        for e in pr.errs {
            errs.push(e);
        }
        for x in pr.file.structs {
            out.structs.push(x);
        }
        for x in pr.file.enums {
            out.enums.push(x);
        }
        for x in pr.file.funcs {
            out.funcs.push(x);
        }
    }
    FeProgram { file: out, errs: ast_sort_errors(errs) }
}

// frontend_load parses and type-checks a program, printing diagnostics
// like `kek check`.
fn frontend_load(path: String, fs: &Fs, log: &Log) -> Option<ChkResult> {
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return None;
        }
    };
    let prog = frontend_parse_all(srcs);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return None;
    }
    let res = chk_check(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return None;
    }
    Some(res)
}

// frontend_check_prelude checks srcs together with the runtime prelude.
fn frontend_check_prelude(srcs: Vec<FeSource>, log: &Log) -> Option<ChkResult> {
    let all = Vec::new();
    for s in srcs {
        all.push(s);
    }
    for s in prelude_sources() {
        all.push(s);
    }
    let prog = frontend_parse_all(all);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return None;
    }
    let res = chk_check_prelude(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return None;
    }
    Some(res)
}

// frontend_load_prelude is frontend_load for `build`: the program is
// checked again together with the prelude.
fn frontend_load_prelude(path: String, fs: &Fs, log: &Log) -> Option<ChkResult> {
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return None;
        }
    };
    match frontend_load(path, fs, log) {
        Some(_) => {}
        None => {
            return None;
        }
    }
    frontend_check_prelude(srcs, log)
}

fn frontend_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    let cmd = args.get(0).unwrap_or("");
    if cmd == "prelude-check" {
        match frontend_check_prelude(Vec::new(), log) {
            Some(_) => {
                return 0;
            }
            None => {
                return 1;
            }
        }
    }
    if args.len() < 2 {
        log.error("usage: " + cmd + " <file.kek>");
        return 2;
    }
    let path = args.get(1).unwrap_or("");
    if cmd == "check" {
        match frontend_load(path, fs, log) {
            Some(_) => {
                log.info(path + ": ok");
                return 0;
            }
            None => {
                return 1;
            }
        }
    }
    if cmd == "ir" {
        match frontend_load(path, fs, log) {
            Some(res) => {
                let text = lower_program_text(lower_lower(res.info));
                if text.ends_with("\n") {
                    log.info(text.slice(0, text.len() - 1));
                } else if text != "" {
                    log.info(text);
                }
                return 0;
            }
            None => {
                return 1;
            }
        }
    }
    if cmd == "build" {
        return frontend_build(args, fs, log);
    }
    let src = match fs.read(path) {
        Ok(s) => s,
        Err(e) => {
            log.error(path + ": " + e.message());
            return 1;
        }
    };
    if cmd == "lex" {
        let lr = lex_file("", src);
        frontend_print(log, ast_dump_tokens(lr.toks, lr.errs));
        if lr.errs.len() > 0 {
            return 1;
        }
        return 0;
    }
    if cmd == "ast" {
        let pr = parse_file("", src, AstIds { next: 0 });
        if pr.errs.len() > 0 {
            let lines = Vec::new();
            for e in pr.errs {
                lines.push(ast_error_string(e));
            }
            frontend_print(log, lines);
            return 1;
        }
        frontend_print(log, ast_dump_file(pr.file));
        return 0;
    }
    log.error(cmd + ": unknown command");
    2
}

// frontend_build implements `build <file-or-dir> <outdir>`: module.wasm
// (a WASI command for #[main] programs), plus kekkai_meta.js, worker.js
// and wrangler.toml for #[handler] programs.
fn frontend_build(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 3 {
        log.error("usage: build <file-or-dir> <outdir>");
        return 2;
    }
    let path = args.get(1).unwrap_or("");
    let out_dir = frontend_clean_dir(args.get(2).unwrap_or(""));
    let res = match frontend_load_prelude(path, fs, log) {
        Some(r) => r,
        None => {
            return 1;
        }
    };
    let prog = lower_lower(res.info);
    let out = wasm_compile(prog);
    if out.err != "" {
        log.error(out.err);
        return 1;
    }
    if glue_emit(args, path, out_dir, prog, fs, log) != 0 {
        return 1;
    }
    let wasm_path = out_dir + "/module.wasm";
    match fs.write_bytes(wasm_path, out.wasm) {
        Ok(_) => {}
        Err(e) => {
            log.error(wasm_path + ": " + e.message());
            return 1;
        }
    }
    if prog.entry != "handler" {
        return 0;
    }
    let meta_path = out_dir + "/kekkai_meta.js";
    let meta = "// Generated by kek. Do not edit.\nexport default "
        + frontend_meta_json(prog.handler_params)
        + ";\n";
    match fs.write(meta_path, meta) {
        Ok(_) => {}
        Err(e) => {
            log.error(meta_path + ": " + e.message());
            return 1;
        }
    }
    0
}

// frontend_meta_json renders the program metadata for the JS runtime.
fn frontend_meta_json(params: Vec<IrHandlerParam>) -> String {
    let items = Vec::new();
    for p in params {
        items.push(
            "\n    {\n      \"kind\": "
                + json_quote(p.kind)
                + ",\n      \"name\": "
                + json_quote(p.name)
                + "\n    }",
        );
    }
    "{\n  \"handlerParams\": [" + items.join(",") + "\n  ]\n}"
}
