// Front-end entry: `lex <file>`, `ast <file>`, `check <file-or-dir>`,
// `ir <file-or-dir>`, `build <file-or-dir> <outdir>`.

struct FeSource {
    name: String,
    text: String,
}

struct FeProgram {
    file: AstFile,
    errs: Vec<AstError>,
}

fn frontend_print(log: &Log, lines: Vec<String>) {
    if lines.len() > 0 {
        log.info(lines.join("\n"));
    }
}

fn frontend_print_errors(log: &Log, errs: Vec<AstError>) {
    let mut lines = Vec::new();
    for e in errs {
        lines.push(ast_error_string(e));
    }
    if lines.len() > 0 {
        log.error(lines.join("\n"));
    }
}

// frontend_clean_dir drops leading "./" and trailing "/" of a directory
// argument.
fn frontend_clean_dir(d: String) -> String {
    let mut s = d;
    while s.starts_with("./") && s.len() > 2 {
        s = s.slice(2, s.len());
    }
    while s.ends_with("/") && s.len() > 1 {
        s = s.slice(0, s.len() - 1);
    }
    s
}

// frontend_read_sources reads a .kek file, or every .kek file of a
// directory sorted by name. Errors are reported.
fn frontend_read_sources(path: String, fs: &Fs, log: &Log) -> Option<Vec<FeSource>> {
    let mut srcs = Vec::new();
    let mut names = Vec::new();
    match fs.list(path) {
        Ok(entries) => {
            let dir = frontend_clean_dir(path);
            for n in entries {
                if n.ends_with(".kek") {
                    if dir == "." {
                        names.push(n);
                    } else {
                        names.push(dir + "/" + n);
                    }
                }
            }
            if names.len() == 0 {
                log.error(path + ": no .kek files");
                return None;
            }
        }
        Err(_) => names.push(path),
    }
    for n in names {
        match fs.read(n) {
            Ok(text) => srcs.push(FeSource { name: n, text: text }),
            Err(e) => {
                log.error(n + ": " + e.message());
                return None;
            }
        }
    }
    Some(srcs)
}

// frontend_parse_all parses the files of one program into a single AstFile.
fn frontend_parse_all(srcs: Vec<FeSource>) -> FeProgram {
    let ids = AstIds { next: 0 };
    let mut out = AstFile {
        structs: Vec::new(),
        enums: Vec::new(),
        funcs: Vec::new(),
        impls: Vec::new(),
        traits: Vec::new(),
        aliases: Vec::new(),
    };
    let mut errs = Vec::new();
    for s in srcs {
        let pr = parse_file(s.name, s.text, ids);
        for e in pr.errs {
            errs.push(e);
        }
        for x in pr.file.structs {
            out.structs.push(x);
        }
        for x in pr.file.enums {
            out.enums.push(x);
        }
        for x in pr.file.funcs {
            out.funcs.push(x);
        }
        for x in pr.file.impls {
            out.impls.push(x);
        }
        for x in pr.file.traits {
            out.traits.push(x);
        }
        for x in pr.file.aliases {
            out.aliases.push(x);
        }
    }
    FeProgram { file: out, errs: ast_sort_errors(errs) }
}

// frontend_load parses and type-checks a program, printing diagnostics
// like `kek check`. The `[refine]` section of ./kekkai.toml configures
// the refinement checks.
fn frontend_load(path: String, fs: &Fs, log: &Log) -> Option<ChkResult> {
    frontend_load_v(path, fs, log, false, false)
}

// frontend_load_v is frontend_load; warn also prints the warnings (lints)
// and verbose the facts of every refinement diagnostic and the proved VCs
// (`kek check -v`).
fn frontend_load_v(
    path: String,
    fs: &Fs,
    log: &Log,
    warn: Bool,
    verbose: Bool,
) -> Option<ChkResult> {
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return None;
        }
    };
    let mut cfg = match ref_config_load(fs, log) {
        Some(c) => c,
        None => {
            return None;
        }
    };
    cfg.verbose = verbose;
    let prog = frontend_parse_all(srcs);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return None;
    }
    let res = chk_check_cfg(prog.file, false, chk_parse_core(), cfg);
    if !frontend_report(log, res, warn, verbose) {
        return None;
    }
    Some(res)
}

// frontend_report prints the diagnostics of a check (errors, and with warn
// the warnings; with verbose the facts of the refinement diagnostics and
// the proved VCs as notes), sorted by position. Returns whether there were
// no errors.
fn frontend_report(log: &Log, res: ChkResult, warn: Bool, verbose: Bool) -> Bool {
    if res.errs.len() == 0 && (!warn || res.refine.diags.len() == 0) {
        return true;
    }
    let mut facts: HashMap<String, Vec<RefFactUse>> = HashMap::new();
    let mut all = Vec::new();
    for e in res.errs {
        all.push(e);
    }
    for d in res.refine.diags {
        if d.severity != "error" {
            if !warn {
                continue;
            }
            all.push(AstError { pos: d.pos, msg: d.severity + ": " + d.msg });
        }
        if verbose {
            let key = ast_pos_string(d.pos) + "\t" + if d.severity == "error" {
                d.msg
            } else {
                d.severity + ": " + d.msg
            };
            facts.insert(key, d.facts);
        }
    }
    let mut errs = Vec::new();
    let mut notes = Vec::new();
    for e in ast_sort_errors(all) {
        let line = ast_error_string(e);
        let mut more = "";
        match facts.get(ast_pos_string(e.pos) + "\t" + e.msg) {
            Some(fs) => {
                for u in fs {
                    more = more + "\n    fact: " + ast_pos_string(u.pos) + ": " + u.text;
                }
            }
            None => {}
        }
        if e.msg.starts_with("note: ") {
            notes.push(line + more);
        } else {
            errs.push(line + more);
        }
    }
    if notes.len() > 0 {
        log.info(notes.join("\n"));
    }
    if errs.len() > 0 {
        log.error(errs.join("\n"));
    }
    res.errs.len() == 0
}

// frontend_check_prelude checks srcs together with the runtime prelude.
fn frontend_check_prelude(srcs: Vec<FeSource>, log: &Log) -> Option<ChkResult> {
    let mut all = Vec::new();
    for s in srcs {
        all.push(s);
    }
    for s in prelude_sources() {
        all.push(s);
    }
    let prog = frontend_parse_all(all);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return None;
    }
    let res = chk_check_prelude(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return None;
    }
    Some(res)
}

// frontend_load_prelude is frontend_load for `build`: the program is
// checked again together with the prelude.
fn frontend_load_prelude(path: String, fs: &Fs, log: &Log) -> Option<ChkResult> {
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return None;
        }
    };
    match frontend_load(path, fs, log) {
        Some(_) => {}
        None => {
            return None;
        }
    }
    frontend_check_prelude(srcs, log)
}

fn frontend_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    let cmd = args.get(0).unwrap_or("");
    if cmd == "prelude-check" {
        match frontend_check_prelude(Vec::new(), log) {
            Some(_) => {
                return 0;
            }
            None => {
                return 1;
            }
        }
    }
    if args.len() < 2 {
        log.error("usage: " + cmd + " <file.kek>");
        return 2;
    }
    let path = args.get(1).unwrap_or("");
    if cmd == "check" || cmd == "check-v" {
        match frontend_load_v(path, fs, log, true, cmd == "check-v") {
            Some(_) => {
                log.info(path + ": ok");
                return 0;
            }
            None => {
                return 1;
            }
        }
    }
    if cmd == "ir" {
        match frontend_load(path, fs, log) {
            Some(res) => {
                let text = lower_program_text(lower_lower(res.info));
                if text.ends_with("\n") {
                    log.info(text.slice(0, text.len() - 1));
                } else if text != "" {
                    log.info(text);
                }
                return 0;
            }
            None => {
                return 1;
            }
        }
    }
    if cmd == "build" {
        return frontend_build(args, fs, log);
    }
    let src = match fs.read(path) {
        Ok(s) => s,
        Err(e) => {
            log.error(path + ": " + e.message());
            return 1;
        }
    };
    if cmd == "lex" {
        let lr = lex_file("", src);
        frontend_print(log, ast_dump_tokens(lr.toks, lr.errs));
        if lr.errs.len() > 0 {
            return 1;
        }
        return 0;
    }
    if cmd == "ast" {
        let pr = parse_file("", src, AstIds { next: 0 });
        if pr.errs.len() > 0 {
            let mut lines = Vec::new();
            for e in pr.errs {
                lines.push(ast_error_string(e));
            }
            frontend_print(log, lines);
            return 1;
        }
        frontend_print(log, ast_dump_file(pr.file));
        return 0;
    }
    log.error(cmd + ": unknown command");
    2
}

// frontend_build implements `build <file-or-dir> <outdir>`: module.wasm
// (a WASI command for #[main] programs), plus kekkai_meta.js, worker.js
// and wrangler.toml for #[handler] programs.
//
// With `-cache <dir>` (the launcher's build cache of the current
// compiler), module.wasm is keyed by the program's definition hash
// (compiler/defhash.kek), its entry kind and its handler parameters: when
// <dir>/<key>/ok exists, only the glue files are written and the launcher
// copies <dir>/<key>/module.wasm. Either way the last line printed is
// `kek-build-cache: hit|miss <key> <entry>` (entry: "handler", "main" or "").
fn frontend_build(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 3 {
        log.error("usage: build <file-or-dir> <outdir>");
        return 2;
    }
    let path = args.get(1).unwrap_or("");
    let out_dir = frontend_clean_dir(args.get(2).unwrap_or(""));
    let cache_dir = frontend_opt(args, "-cache");
    let mut key = "";
    let mut prog = lower_lower_none();
    if cache_dir != "" {
        // one check with the prelude: its info gives the definition hashes
        // (the cache keys) and is lowered
        let srcs = match frontend_read_sources(path, fs, log) {
            Some(s) => s,
            None => {
                return 1;
            }
        };
        let mut all = Vec::new();
        for s in srcs {
            all.push(s);
        }
        for s in prelude_sources() {
            all.push(s);
        }
        let parsed = frontend_parse_all(all);
        if parsed.errs.len() > 0 {
            frontend_print_errors(log, parsed.errs);
            return 1;
        }
        let cfg = match ref_config_load(fs, log) {
            Some(c) => c,
            None => {
                return 1;
            }
        };
        let res = chk_check_cfg(parsed.file, true, chk_parse_core(), cfg);
        if res.errs.len() > 0 {
            // the diagnostics of the program alone, as `kek check` reports them
            match frontend_load(path, fs, log) {
                Some(_) => frontend_print_errors(log, res.errs),
                None => {}
            }
            return 1;
        }
        let dh = dh_program(parsed.file, res.info);
        let entry = lower_entry_kind(res.info);
        let params = match res.info.handler {
            Some(h) => lower_handler_params(h),
            None => Vec::new(),
        };
        {
            let mut parts = Vec::new();
            parts.push("build-2");
            parts.push(dh.hash);
            parts.push(entry);
            for p in params {
                parts.push(p.kind + ":" + p.name);
            }
            key = dh_hash_strs(parts);
            if glue_exists(cache_dir + "/" + key + "/ok", fs) {
                if frontend_emit_glue(args, path, out_dir, entry, params, fs, log) != 0 {
                    return 1;
                }
                log.info("kek-build-cache: hit " + key + " " + entry);
                return 0;
            }
        }
        prog = lower_lower(res.info);
    } else {
        let res = match frontend_load_prelude(path, fs, log) {
            Some(r) => r,
            None => {
                return 1;
            }
        };
        prog = lower_lower(res.info);
    }
    let out = wasm_compile(prog);
    if out.err != "" {
        log.error(out.err);
        return 1;
    }
    let wasm_path = out_dir + "/module.wasm";
    if frontend_emit_glue(args, path, out_dir, prog.entry, prog.handler_params, fs, log) != 0 {
        return 1;
    }
    match fs.write_bytes(wasm_path, out.wasm) {
        Ok(_) => {}
        Err(e) => {
            log.error(wasm_path + ": " + e.message());
            return 1;
        }
    }
    if key != "" {
        log.info("kek-build-cache: miss " + key + " " + prog.entry);
    }
    0
}

fn lower_lower_none() -> IrProgram {
    IrProgram {
        types: Vec::new(),
        funcs: Vec::new(),
        handler: "",
        entry: "",
        handler_params: Vec::new(),
    }
}

// frontend_opt returns the value of `name value` in args ("" if absent).
fn frontend_opt(args: Vec<String>, name: String) -> String {
    let mut i = 0;
    while i + 1 < args.len() {
        if args.get(i).unwrap_or("") == name {
            return args.get(i + 1).unwrap_or("");
        }
        i = i + 1;
    }
    ""
}

// frontend_emit_glue writes the files next to module.wasm: worker.js,
// wrangler.toml (unless it exists) and kekkai_meta.js for a #[handler].
fn frontend_emit_glue(
    args: Vec<String>,
    path: String,
    out_dir: String,
    entry: String,
    params: Vec<IrHandlerParam>,
    fs: &Fs,
    log: &Log,
) -> Int {
    if glue_emit_for(args, path, out_dir, entry, params, fs, log) != 0 {
        return 1;
    }
    if entry != "handler" {
        return 0;
    }
    let meta_path = out_dir + "/kekkai_meta.js";
    let meta = "// Generated by kek. Do not edit.\nexport default "
        + frontend_meta_json(params)
        + ";\n";
    match fs.write(meta_path, meta) {
        Ok(_) => {}
        Err(e) => {
            log.error(meta_path + ": " + e.message());
            return 1;
        }
    }
    0
}

// frontend_meta_json renders the program metadata for the JS runtime.
fn frontend_meta_json(params: Vec<IrHandlerParam>) -> String {
    let mut items = Vec::new();
    for p in params {
        items.push(
            "\n    {\n      \"kind\": "
                + json_quote(p.kind)
                + ",\n      \"name\": "
                + json_quote(p.name)
                + "\n    }",
        );
    }
    "{\n  \"handlerParams\": [" + items.join(",") + "\n  ]\n}"
}

// `build-timings <file|dir>`: the time of each phase of a build (no
// output is written), for profiling the compiler.
fn frontend_timings(args: Vec<String>, fs: &Fs, log: &Log, clock: &Clock) -> Int {
    let path = args.get(1).unwrap_or("");
    let mut lines = Vec::new();
    let mut t = clock.now_ms();
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return 1;
        }
    };
    let mut all = Vec::new();
    for s in srcs {
        all.push(s);
    }
    for s in prelude_sources() {
        all.push(s);
    }
    lines.push("read      " + (clock.now_ms() - t).to_string() + "ms");
    t = clock.now_ms();
    let prog = frontend_parse_all(all);
    lines.push("parse     " + (clock.now_ms() - t).to_string() + "ms");
    t = clock.now_ms();
    let res = chk_check_prelude(prog.file);
    lines.push("check     " + (clock.now_ms() - t).to_string() + "ms");
    t = clock.now_ms();
    let ir = lower_lower(res.info);
    lines.push(
        "lower     "
            + (clock.now_ms() - t).to_string()
            + "ms ("
            + ir.funcs.len().to_string()
            + " functions)",
    );
    t = clock.now_ms();
    let out = wasm_compile(ir);
    lines.push(
        "codegen   "
            + (clock.now_ms() - t).to_string()
            + "ms ("
            + out.wasm.len().to_string()
            + " bytes)",
    );
    t = clock.now_ms();
    let wout = frontend_opt(args, "-o");
    if wout != "" {
        match fs.write_bytes(wout, out.wasm) {
            Ok(_) => {}
            Err(e) => log.error(e.message()),
        }
        lines.push("write     " + (clock.now_ms() - t).to_string() + "ms");
    }
    t = clock.now_ms();
    let l = dh_program(prog.file, res.info);
    lines.push(
        "defhash   "
            + (clock.now_ms() - t).to_string()
            + "ms ("
            + l.defs.len().to_string()
            + " definitions)",
    );
    frontend_print(log, lines);
    0
}

// ---- the in-memory cache of a long-running compiler (serve.kek) ----

// FeCache keeps the parse of every source file (by name, valid while its
// text is the same) and of the core library across requests. Node ids
// keep increasing, so files parsed at different times never share one.
struct FeCache {
    files: HashMap<String, FeParsed>,
    ids: AstIds,
    core: ChkCore,
    mut hits: Int,
    mut misses: Int,
}

struct FeParsed {
    text: String,
    pr: ParseResult,
}

fn fe_cache_new() -> FeCache {
    FeCache {
        files: HashMap::new(),
        ids: AstIds { next: 0 },
        core: chk_parse_core(),
        hits: 0,
        misses: 0,
    }
}

// frontend_parse_cached is frontend_parse_all with the parses of unchanged
// files taken from the cache.
fn frontend_parse_cached(mut c: FeCache, srcs: Vec<FeSource>) -> FeProgram {
    let out = AstFile {
        structs: Vec::new(),
        enums: Vec::new(),
        funcs: Vec::new(),
        impls: Vec::new(),
        traits: Vec::new(),
        aliases: Vec::new(),
    };
    let mut errs = Vec::new();
    for s in srcs {
        let mut pr = parse_file_dummy();
        let mut found = false;
        match c.files.get(s.name) {
            Some(p) => {
                if p.text == s.text {
                    pr = p.pr;
                    found = true;
                }
            }
            None => {}
        }
        if found {
            c.hits = c.hits + 1;
        } else {
            c.misses = c.misses + 1;
            pr = parse_file(s.name, s.text, c.ids);
            // a long-running compiler sees many programs: start over
            // rather than keep every file it ever parsed
            if c.files.len() >= 4000 {
                c.files.clear();
            }
            c.files.insert(s.name, FeParsed { text: s.text, pr: pr });
        }
        for e in pr.errs {
            errs.push(e);
        }
        chk_append_file(out, pr.file);
    }
    FeProgram { file: out, errs: ast_sort_errors(errs) }
}

fn parse_file_dummy() -> ParseResult {
    ParseResult {
        file: AstFile {
            structs: Vec::new(),
            enums: Vec::new(),
            funcs: Vec::new(),
            impls: Vec::new(),
            traits: Vec::new(),
            aliases: Vec::new(),
        },
        errs: Vec::new(),
    }
}

// frontend_build_c is `build <path> <out> -cache <dir>` with the cache.
fn frontend_build_c(c: FeCache, args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 3 {
        log.error("usage: build <file-or-dir> <outdir>");
        return 2;
    }
    let path = args.get(1).unwrap_or("");
    let out_dir = frontend_clean_dir(args.get(2).unwrap_or(""));
    let cache_dir = frontend_opt(args, "-cache");
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return 1;
        }
    };
    let mut all = Vec::new();
    for s in srcs {
        all.push(s);
    }
    for s in prelude_sources() {
        all.push(s);
    }
    let parsed = frontend_parse_cached(c, all);
    if parsed.errs.len() > 0 {
        frontend_print_errors(log, parsed.errs);
        return 1;
    }
    let cfg = match ref_config_load(fs, log) {
        Some(x) => x,
        None => {
            return 1;
        }
    };
    let res = chk_check_cfg(parsed.file, true, c.core, cfg);
    if res.errs.len() > 0 {
        match frontend_check_c(c, path, fs, log, false) {
            0 => frontend_print_errors(log, res.errs),
            _ => {}
        }
        return 1;
    }
    let dh = dh_program(parsed.file, res.info);
    let entry = lower_entry_kind(res.info);
    let params = match res.info.handler {
        Some(h) => lower_handler_params(h),
        None => Vec::new(),
    };
    let mut key = "";
    if cache_dir != "" {
        let mut parts = Vec::new();
        parts.push("build-2");
        parts.push(dh.hash);
        parts.push(entry);
        for p in params {
            parts.push(p.kind + ":" + p.name);
        }
        key = dh_hash_strs(parts);
        if glue_exists(cache_dir + "/" + key + "/ok", fs) {
            if frontend_emit_glue(args, path, out_dir, entry, params, fs, log) != 0 {
                return 1;
            }
            log.info("kek-build-cache: hit " + key + " " + entry);
            return 0;
        }
    }
    let prog = lower_lower(res.info);
    let out = wasm_compile(prog);
    if out.err != "" {
        log.error(out.err);
        return 1;
    }
    if frontend_emit_glue(args, path, out_dir, prog.entry, prog.handler_params, fs, log) != 0 {
        return 1;
    }
    let wasm_path = out_dir + "/module.wasm";
    match fs.write_bytes(wasm_path, out.wasm) {
        Ok(_) => {}
        Err(e) => {
            log.error(wasm_path + ": " + e.message());
            return 1;
        }
    }
    if key != "" {
        log.info("kek-build-cache: miss " + key + " " + prog.entry);
    }
    0
}

// frontend_check_c is `check <path>` with the cache (diagnostics are
// printed, warnings too with warn; 0 when the program checks, without
// printing "ok").
fn frontend_check_c(c: FeCache, path: String, fs: &Fs, log: &Log, warn: Bool) -> Int {
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return 1;
        }
    };
    let prog = frontend_parse_cached(c, srcs);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return 1;
    }
    let cfg = match ref_config_load(fs, log) {
        Some(x) => x,
        None => {
            return 1;
        }
    };
    let res = chk_check_cfg(prog.file, false, c.core, cfg);
    if !frontend_report(log, res, warn, false) {
        return 1;
    }
    0
}
