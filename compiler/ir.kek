// IR data types (prefix Ir* / ir_).
//
// IR nodes are identified by position: aggregates by their index in
// IrProgram.types, functions by name, blocks by index in IrFunc.blocks and
// locals by index in IrFunc.locals (params first).
//
// Optional fields are always present; their meaning is decided by the
// owner (`coll` for elem/key, op == "const" for cst), and `ir_ty_none()`
// is used as the placeholder.

// IrTy is a representation type. kind: unit bool int float string ext agg
// (float: IEEE 754 binary64; its constants carry the bit pattern in
// IrConst.int_val, and binop / unop "neg" act on f64 when the operands
// are float).
struct IrTy {
    kind: String,
    agg: Int, // aggregate index (kind == "agg")
    ext: String, // host type name (kind == "ext")
}

// IrTypeDef is an aggregate layout: a struct (fields), a variant
// (variants) or a collection (coll = "vec": Vec<elem>).
struct IrTypeDef {
    name: String,
    mut is_variant: Bool,
    fields: Vec<IrTy>,
    variants: Vec<Vec<IrTy>>,
    mut coll: String,
    mut elem: IrTy,
}

// IrConst is a literal; kind selects the payload.
struct IrConst {
    kind: String,
    int_val: Int,
    bool_val: Bool,
    str_val: String,
}

// IrInstr is one instruction.
struct IrInstr {
    op: String,
    mut dst: Int,
    mut args: Vec<Int>,
    mut name: String,
    mut ty: Int, // aggregate index ("type" in JSON)
    mut tag: Int,
    mut index: Int,
    mut cst: IrConst, // op == "const"
}

// IrTerm ends a block: jump br switch ret unreachable.
struct IrTerm {
    op: String,
    args: Vec<Int>,
    targets: Vec<Int>,
}

struct IrBlock {
    instrs: Vec<IrInstr>,
    mut term: IrTerm,
}

struct IrFunc {
    name: String,
    nparams: Int,
    locals: Vec<IrTy>, // params first
    names: Vec<String>, // debug names of locals
    result: IrTy,
    is_async: Bool,
    mut blocks: Vec<IrBlock>, // entry is block 0
}

// IrHandlerParam: kind is "request", "args" or a capability name.
struct IrHandlerParam {
    kind: String,
    name: String,
}

struct IrProgram {
    types: Vec<IrTypeDef>,
    funcs: Vec<IrFunc>,
    mut handler: String,
    mut entry: String, // "handler", "main" or ""
    handler_params: Vec<IrHandlerParam>,
}

fn ir_ty(kind: String) -> IrTy {
    IrTy { kind: kind, agg: 0, ext: "" }
}

fn ir_ty_agg(agg: Int) -> IrTy {
    IrTy { kind: "agg", agg: agg, ext: "" }
}

fn ir_ty_none() -> IrTy {
    IrTy { kind: "", agg: 0, ext: "" }
}

fn ir_const_none() -> IrConst {
    IrConst { kind: "", int_val: 0, bool_val: false, str_val: "" }
}

// ir_func_index returns the index of the function named name, or -1.
fn ir_func_index(p: IrProgram, name: String) -> Int {
    let mut i = 0;
    for f in p.funcs {
        if f.name == name {
            return i;
        }
        i = i + 1;
    }
    -1
}
