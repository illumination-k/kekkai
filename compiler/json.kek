// JSON reader and writer (prefix json_ / Json*).
//
// The reader handles the subset used for the IR
// (objects, arrays, strings with escapes, integers, true/false/null).
// Numbers are parsed as 64-bit integers (fractions/exponents are rejected).
// The writer produces indented JSON with HTML-safe string escaping.

enum JsonVal {
    Null,
    Bool(Bool),
    Num(Int),
    Str(String),
    Arr(Vec<JsonVal>),
    // keys in source order, and the key -> value table
    Obj(Vec<String>, Map<String, JsonVal>),
}

struct JsonParser {
    src: String,
    pos: Int,
    n: Int,
    err: String,
}

fn json_peek(p: JsonParser) -> Int {
    p.src.char_at(p.pos).unwrap_or(-1)
}

fn json_fail(p: JsonParser, msg: String) {
    if p.err == "" {
        p.err = "json: " + msg + " at offset " + p.pos.to_string();
    }
    p.pos = p.n;
}

fn json_skip_ws(p: JsonParser) {
    while p.pos < p.n {
        let c = json_peek(p);
        if c == 32 || c == 10 || c == 13 || c == 9 {
            p.pos = p.pos + 1;
        } else {
            break;
        }
    }
}

// json_parse parses a whole document.
fn json_parse(src: String) -> Result<JsonVal, String> {
    let p = JsonParser { src: src, pos: 0, n: src.len(), err: "" };
    let v = json_value(p);
    json_skip_ws(p);
    if p.err == "" && p.pos < p.n {
        json_fail(p, "trailing characters");
    }
    if p.err != "" {
        return Err(p.err);
    }
    Ok(v)
}

fn json_expect_word(p: JsonParser, w: String) {
    if p.src.slice(p.pos, p.pos + w.len()) == w {
        p.pos = p.pos + w.len();
    } else {
        json_fail(p, "unexpected token");
    }
}

fn json_value(p: JsonParser) -> JsonVal {
    json_skip_ws(p);
    let c = json_peek(p);
    if c == 123 {
        return json_object(p);
    }
    if c == 91 {
        return json_array(p);
    }
    if c == 34 {
        return JsonVal::Str(json_string(p));
    }
    if c == 116 {
        json_expect_word(p, "true");
        return JsonVal::Bool(true);
    }
    if c == 102 {
        json_expect_word(p, "false");
        return JsonVal::Bool(false);
    }
    if c == 110 {
        json_expect_word(p, "null");
        return JsonVal::Null;
    }
    if c == 45 || (c >= 48 && c <= 57) {
        return JsonVal::Num(json_number(p));
    }
    json_fail(p, "unexpected character");
    JsonVal::Null
}

fn json_number(p: JsonParser) -> Int {
    let mut neg = false;
    if json_peek(p) == 45 {
        neg = true;
        p.pos = p.pos + 1;
    }
    let start = p.pos;
    let mut v = 0;
    while p.pos < p.n {
        let c = json_peek(p);
        if c >= 48 && c <= 57 {
            v = v * 10 + (c - 48);
            p.pos = p.pos + 1;
        } else {
            break;
        }
    }
    if p.pos == start {
        json_fail(p, "bad number");
    }
    let c = json_peek(p);
    if c == 46 || c == 101 || c == 69 {
        json_fail(p, "non-integer number");
    }
    if neg { 0 - v } else { v }
}

fn json_hex(c: Int) -> Int {
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    if c >= 97 && c <= 102 {
        return c - 87;
    }
    if c >= 65 && c <= 70 {
        return c - 55;
    }
    -1
}

// json_string parses a string literal (p.pos at the opening quote).
fn json_string(p: JsonParser) -> String {
    p.pos = p.pos + 1;
    let parts = Vec::new();
    let mut start = p.pos;
    while true {
        if p.pos >= p.n {
            json_fail(p, "unterminated string");
            return "";
        }
        let c = json_peek(p);
        if c == 34 {
            parts.push(p.src.slice(start, p.pos));
            p.pos = p.pos + 1;
            break;
        }
        if c == 92 {
            parts.push(p.src.slice(start, p.pos));
            let e = p.src.char_at(p.pos + 1).unwrap_or(-1);
            p.pos = p.pos + 2;
            if e == 110 {
                parts.push("\n");
            } else if e == 116 {
                parts.push("\t");
            } else if e == 114 {
                parts.push("\r");
            } else if e == 98 {
                parts.push(String::from_char(8));
            } else if e == 102 {
                parts.push(String::from_char(12));
            } else if e == 34 || e == 92 || e == 47 {
                parts.push(String::from_char(e));
            } else if e == 117 {
                let mut u = 0;
                for k in 0..4 {
                    let h = json_hex(p.src.char_at(p.pos + k).unwrap_or(-1));
                    if h < 0 {
                        json_fail(p, "bad \\u escape");
                        return "";
                    }
                    u = u * 16 + h;
                }
                p.pos = p.pos + 4;
                // surrogate halves are kept as UTF-16 code units, so pairs
                // recombine naturally in the string
                parts.push(String::from_char(u));
            } else {
                json_fail(p, "bad escape");
                return "";
            }
            start = p.pos;
        } else {
            p.pos = p.pos + 1;
        }
    }
    if parts.len() == 1 {
        return parts.get(0).unwrap_or("");
    }
    parts.join("")
}

fn json_array(p: JsonParser) -> JsonVal {
    p.pos = p.pos + 1;
    let items = Vec::new();
    json_skip_ws(p);
    if json_peek(p) == 93 {
        p.pos = p.pos + 1;
        return JsonVal::Arr(items);
    }
    while p.pos < p.n {
        items.push(json_value(p));
        json_skip_ws(p);
        let c = json_peek(p);
        p.pos = p.pos + 1;
        if c == 93 {
            return JsonVal::Arr(items);
        }
        if c != 44 {
            p.pos = p.pos - 1;
            json_fail(p, "expected , or ]");
        }
    }
    json_fail(p, "unterminated array");
    JsonVal::Arr(items)
}

fn json_object(p: JsonParser) -> JsonVal {
    p.pos = p.pos + 1;
    let keys = Vec::new();
    let tbl: Map<String, JsonVal> = Map::new();
    json_skip_ws(p);
    if json_peek(p) == 125 {
        p.pos = p.pos + 1;
        return JsonVal::Obj(keys, tbl);
    }
    while p.pos < p.n {
        json_skip_ws(p);
        if json_peek(p) != 34 {
            json_fail(p, "expected object key");
            break;
        }
        let k = json_string(p);
        json_skip_ws(p);
        if json_peek(p) != 58 {
            json_fail(p, "expected :");
            break;
        }
        p.pos = p.pos + 1;
        let v = json_value(p);
        if !tbl.contains(k) {
            keys.push(k);
        }
        tbl.insert(k, v);
        json_skip_ws(p);
        let c = json_peek(p);
        p.pos = p.pos + 1;
        if c == 125 {
            return JsonVal::Obj(keys, tbl);
        }
        if c != 44 {
            p.pos = p.pos - 1;
            json_fail(p, "expected , or }");
        }
    }
    json_fail(p, "unterminated object");
    JsonVal::Obj(keys, tbl)
}

// ---- accessors (missing fields read as zero values) ----

fn json_field(v: JsonVal, key: String) -> JsonVal {
    match v {
        JsonVal::Obj(_, tbl) => tbl.get(key).unwrap_or(JsonVal::Null),
        _ => JsonVal::Null,
    }
}

fn json_has(v: JsonVal, key: String) -> Bool {
    match v {
        JsonVal::Obj(_, tbl) => match tbl.get(key) {
            Some(JsonVal::Null) => false,
            Some(_) => true,
            None => false,
        },
        _ => false,
    }
}

fn json_int(v: JsonVal) -> Int {
    match v {
        JsonVal::Num(n) => n,
        _ => 0,
    }
}

fn json_bool(v: JsonVal) -> Bool {
    match v {
        JsonVal::Bool(b) => b,
        _ => false,
    }
}

fn json_str(v: JsonVal) -> String {
    match v {
        JsonVal::Str(s) => s,
        _ => "",
    }
}

fn json_items(v: JsonVal) -> Vec<JsonVal> {
    match v {
        JsonVal::Arr(xs) => xs,
        _ => Vec::new(),
    }
}

fn json_get_int(v: JsonVal, key: String) -> Int {
    json_int(json_field(v, key))
}

fn json_get_bool(v: JsonVal, key: String) -> Bool {
    json_bool(json_field(v, key))
}

fn json_get_str(v: JsonVal, key: String) -> String {
    json_str(json_field(v, key))
}

fn json_get_items(v: JsonVal, key: String) -> Vec<JsonVal> {
    json_items(json_field(v, key))
}

// ---- writer ----

fn json_hex_digit(d: Int) -> String {
    "0123456789abcdef".slice(d, d + 1)
}

// json_quote renders a JSON string literal
// (HTML-safe: <, > and & are escaped; U+2028/U+2029 are escaped).
fn json_quote(s: String) -> String {
    let parts = Vec::new();
    parts.push("\"");
    let n = s.len();
    let mut start = 0;
    let mut i = 0;
    while i < n {
        let c = s.char_at(i).unwrap_or(0);
        let mut esc = "";
        if c == 34 {
            esc = "\\\"";
        } else if c == 92 {
            esc = "\\\\";
        } else if c == 10 {
            esc = "\\n";
        } else if c == 13 {
            esc = "\\r";
        } else if c == 9 {
            esc = "\\t";
        } else if c == 8 {
            esc = "\\b";
        } else if c == 12 {
            esc = "\\f";
        } else if c < 32 || c == 60 || c == 62 || c == 38 || c == 8232 || c == 8233 {
            esc = "\\u"
                + json_hex_digit(c.shr(12).bit_and(15))
                + json_hex_digit(c.shr(8).bit_and(15))
                + json_hex_digit(c.shr(4).bit_and(15))
                + json_hex_digit(c.bit_and(15));
        } else if c >= 55296 && c <= 57343 {
            // surrogates: a valid pair passes through, a lone half becomes
            // U+FFFD
            let d = s.char_at(i + 1).unwrap_or(0);
            if c <= 56319 && d >= 56320 && d <= 57343 {
                i = i + 1;
            } else {
                esc = "\\ufffd";
            }
        }
        if esc != "" {
            parts.push(s.slice(start, i));
            parts.push(esc);
            start = i + 1;
        }
        i = i + 1;
    }
    parts.push(s.slice(start, n));
    parts.push("\"");
    parts.join("")
}
