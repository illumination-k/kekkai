// Kekkai compiler written in Kekkai (stage1). See docs/selfhost.md.
#[main]
fn main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    let cmd = args.get(0).unwrap_or("");
    if (cmd == "check" || cmd == "ir") && diag_json_requested(args) {
        return diag_json_main(args, fs, log);
    }
    if cmd == "caps" {
        return caps_main(args, fs, log);
    }
    if cmd == "search" {
        return search_main(args, fs, log);
    }
    if cmd == "lex" || cmd == "ast" || cmd == "check" || cmd == "ir" || cmd == "build" {
        return frontend_main(args, fs, log);
    }
    if cmd == "test-build" {
        return testrun_main(args, fs, log);
    }
    if cmd == "fmt" {
        return fmt_main(args, fs, log);
    }
    if cmd == "ir2wasm" {
        return backend_main(args, fs, log);
    }
    log.error("usage: kek-stage1 (lex|ast|check|ir|build|ir2wasm|test-build|fmt) ...");
    2
}
