// Kekkai compiler written in Kekkai (stage1). See docs/selfhost.md.
#[main]
fn main(args: Vec<String>, fs: &Fs, log: &Log, clock: &Clock) -> Int {
    if args.get(0).unwrap_or("") == "serve" {
        return serve_main(args, fs, log, clock);
    }
    kek_dispatch(args, fs, log, clock)
}

// kek_dispatch runs one command (also for each request of `serve`).
fn kek_dispatch(args: Vec<String>, fs: &Fs, log: &Log, clock: &Clock) -> Int {
    let cmd = args.get(0).unwrap_or("");
    if cmd == "build-timings" {
        return frontend_timings(args, fs, log, clock);
    }
    if (cmd == "check" || cmd == "ir") && diag_json_requested(args) {
        return diag_json_main(args, fs, log);
    }
    if cmd == "caps" {
        return caps_main(args, fs, log);
    }
    if cmd == "search" {
        return search_main(args, fs, log);
    }
    if cmd == "config" {
        return tool_config_main(fs, log);
    }
    if cmd == "affected" {
        return aff_main(args, fs, log);
    }
    if cmd == "hash" {
        return dh_main(args, fs, log);
    }
    if cmd == "assure" {
        return asr_main(args, fs, log);
    }
    if cmd == "smt" {
        return smt_main(args, fs, log);
    }
    if cmd == "similar" {
        return sim_main(args, fs, log);
    }
    if cmd == "prelude-check"
        || cmd == "lex"
        || cmd == "ast"
        || cmd == "check"
        || cmd == "ir"
        || cmd == "build" {
        return frontend_main(args, fs, log);
    }
    if cmd == "test-build" {
        return testrun_main(args, fs, log);
    }
    if cmd == "cover-build" {
        return cov_build_main(args, fs, log);
    }
    if cmd == "cover-report" {
        return cov_report_main(args, fs, log);
    }
    if cmd == "mutate-build" {
        return mut_build_main(args, fs, log);
    }
    if cmd == "mutate-report" {
        return mut_report_main(args, fs, log);
    }
    if cmd == "fmt" {
        return fmt_main(args, fs, log);
    }
    if cmd == "embed-prelude" {
        return prelude_embed_main(args, fs, log);
    }
    log.error(
        "usage: kek (lex|ast|check|ir|build|test-build|fmt|caps|search|hash|config|similar|assure|cover-build|cover-report|mutate-build|mutate-report|embed-prelude) ...",
    );
    2
}
