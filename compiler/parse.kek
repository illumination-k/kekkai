// Parser.
//
// The parser stops at the first syntax error: a failure sets `failed`;
// from then on the parser sees only EOF (so every loop terminates
// quickly) and further errors are suppressed.

struct AstIds {
    mut next: Int,
}

struct ParseState {
    toks: Vec<Tok>,
    mut pos: Int,
    eof: Tok,
    errs: Vec<AstError>,
    mut no_struct: Bool,
    mut failed: Bool,
    ids: AstIds,
    // nesting of macro invocations being parsed (compiler/macro.kek)
    mut mac_depth: Int,
}

struct ParseResult {
    file: AstFile,
    errs: Vec<AstError>,
}

fn parse_id(mut p: ParseState) -> Int {
    p.ids.next = p.ids.next + 1;
    p.ids.next
}

fn parse_tok(p: ParseState) -> Tok {
    if p.failed {
        return p.eof;
    }
    match p.toks.get(p.pos) {
        Some(t) => t,
        None => p.eof,
    }
}

fn parse_at(p: ParseState, k: String) -> Bool {
    parse_tok(p).kind == k
}

// parse_peek_at reports whether the token after the current one is k.
// parse_peek_text is the text of the token after the current one.
fn parse_peek_text(p: ParseState) -> String {
    match p.toks.get(p.pos + 1) {
        Some(t) => t.text,
        None => "",
    }
}

fn parse_peek_at(p: ParseState, k: String) -> Bool {
    if p.failed {
        return false;
    }
    match p.toks.get(p.pos + 1) {
        Some(t) => t.kind == k,
        None => false,
    }
}

fn parse_next(mut p: ParseState) -> Tok {
    let t = parse_tok(p);
    if t.kind != "EOF" {
        p.pos = p.pos + 1;
    }
    t
}

fn parse_accept(p: ParseState, k: String) -> Bool {
    if parse_at(p, k) {
        parse_next(p);
        return true;
    }
    false
}

fn parse_fail(mut p: ParseState, pos: AstPos, msg: String) {
    if !p.failed {
        p.errs.push(AstError { pos: pos, msg: msg });
        p.failed = true;
    }
}

fn parse_expect(p: ParseState, k: String) -> Tok {
    let t = parse_tok(p);
    if t.kind != k {
        parse_fail(p, t.pos, "expected " + lex_kind_name(k) + ", found " + parse_describe(t));
    }
    parse_next(p)
}

fn parse_describe(t: Tok) -> String {
    if t.kind == "IDENT" {
        return "identifier `" + t.text + "`";
    }
    if t.kind == "INT" {
        return "integer `" + t.text + "`";
    }
    if t.kind == "STRING" {
        return "string literal";
    }
    lex_kind_name(t.kind)
}

// parse_file parses one source file: lexer errors plus at
// most one syntax error, sorted by position.
fn parse_file(name: String, src: String, ids: AstIds) -> ParseResult {
    parse_file_at(name, src, ids, None)
}

// parse_file_at is parse_file with every position replaced by at (when
// set): for generated code.
fn parse_file_at(name: String, src: String, ids: AstIds, at: Option<AstPos>) -> ParseResult {
    let lr = lex_file(name, src);
    match at {
        Some(pos) => {
            for mut t in lr.toks {
                t.pos = pos;
            }
        }
        None => {}
    }
    let eof = match lr.toks.get(lr.toks.len() - 1) {
        Some(t) => t,
        None => Tok { kind: "EOF", text: "", pos: AstPos { file: name, line: 1, col: 1 } },
    };
    let p = ParseState {
        toks: lr.toks,
        pos: 0,
        eof: eof,
        errs: lr.errs,
        no_struct: false,
        failed: false,
        ids: ids,
        mac_depth: 0,
    };
    let f = parse_items(p);
    ParseResult { file: f, errs: ast_sort_errors(p.errs) }
}

fn parse_items(p: ParseState) -> AstFile {
    let mut f = AstFile {
        structs: Vec::new(),
        enums: Vec::new(),
        funcs: Vec::new(),
        impls: Vec::new(),
        traits: Vec::new(),
        aliases: Vec::new(),
        consts: Vec::new(),
    };
    while !parse_at(p, "EOF") {
        let attrs = parse_attrs(p);
        let k = parse_tok(p).kind;
        if k == "fn" {
            let mut fd = parse_func(p, false);
            fd.attrs = attrs;
            if !p.failed {
                f.funcs.push(fd);
            }
        } else if k == "struct" {
            let mut sd = parse_struct(p);
            sd.attrs = attrs;
            if !p.failed {
                f.structs.push(sd);
            }
        } else if k == "enum" {
            let mut ed = parse_enum(p);
            ed.attrs = attrs;
            if !p.failed {
                f.enums.push(ed);
            }
        } else if k == "impl" {
            let id = parse_impl(p);
            if !p.failed {
                f.impls.push(id);
            }
        } else if k == "trait" {
            let td = parse_trait(p);
            if !p.failed {
                f.traits.push(td);
            }
        } else if k == "type" {
            let ad = parse_type_alias(p);
            if !p.failed {
                f.aliases.push(ad);
            }
        } else if parse_at_const(p) {
            let cd = parse_const(p);
            if !p.failed {
                f.consts.push(cd);
            }
        } else {
            parse_fail(
                p,
                parse_tok(p).pos,
                "expected item (`fn`, `struct`, `enum`, `trait`, `impl`, `type` or `const`), found "
                    + parse_describe(parse_tok(p)),
            );
        }
        if attrs.len() > 0 && (k == "impl" || k == "trait" || k == "type" || k == "const") {
            match attrs.get(0) {
                Some(a) => parse_fail(p, a.pos, "attributes are not allowed on `" + k + "` items"),
                None => {}
            }
        }
    }
    f
}

// parse_at_const reports whether a `const NAME` item starts here (`const`
// is not a keyword).
fn parse_at_const(p: ParseState) -> Bool {
    let t = parse_tok(p);
    t.kind == "IDENT" && t.text == "const" && parse_peek_at(p, "IDENT")
}

// parse_const parses `const NAME: T = value;`.
fn parse_const(p: ParseState) -> AstConstDecl {
    let pos = parse_next(p).pos;
    let name = parse_expect(p, "IDENT").text;
    parse_expect(p, ":");
    let ty = parse_type(p);
    parse_expect(p, "=");
    let value = parse_expr(p);
    parse_expect(p, ";");
    AstConstDecl { id: parse_id(p), pos: pos, name: name, ty: ty, value: value }
}

// parse_attrs parses attributes `#[name]` / `#[name(arg, ...)]`.
fn parse_attrs(p: ParseState) -> Vec<AstAttr> {
    let mut attrs = Vec::new();
    while parse_at(p, "#") {
        let pos = parse_next(p).pos;
        parse_expect(p, "[");
        let name = parse_expect(p, "IDENT");
        let mut a = AstAttr { pos: pos, name: name.text, args: Vec::new() };
        if parse_accept(p, "(") {
            while !parse_at(p, ")") {
                // `name` or `name = "text"` / `name = 12`, kept as
                // source text (ast_attr_value reads the value)
                let mut arg = parse_expect(p, "IDENT").text;
                if parse_accept(p, "=") {
                    let v = parse_tok(p);
                    if v.kind == "STRING" {
                        parse_next(p);
                        arg = arg + " = " + ast_quote(v.text);
                    } else if v.kind == "INT" {
                        parse_next(p);
                        arg = arg + " = " + v.text;
                    } else {
                        parse_fail(
                            p,
                            v.pos,
                            "expected a string or integer literal, found " + parse_describe(v),
                        );
                    }
                }
                a.args.push(arg);
                if !parse_accept(p, ",") {
                    break;
                }
            }
            parse_expect(p, ")");
        }
        parse_expect(p, "]");
        attrs.push(a);
    }
    attrs
}

// parse_type_alias parses `type Name = T;` and `type Name = T where pred;`.
fn parse_type_alias(p: ParseState) -> AstTypeAlias {
    let pos = parse_expect(p, "type").pos;
    let name = parse_expect(p, "IDENT").text;
    let id = parse_id(p);
    parse_expect(p, "=");
    let ty = parse_type(p);
    let mut a = AstTypeAlias { id: id, pos: pos, name: name, ty: ty, pred: None };
    if parse_accept(p, "where") {
        a.pred = Some(parse_expr(p));
    }
    parse_expect(p, ";");
    a
}

// parse_assoc_type parses `type Name;` or `type Name = T;`.
fn parse_assoc_type(p: ParseState) -> AstAssocType {
    let pos = parse_expect(p, "type").pos;
    let name = parse_expect(p, "IDENT").text;
    let mut a = AstAssocType { id: parse_id(p), pos: pos, name: name, ty: None };
    if parse_accept(p, "=") {
        a.ty = Some(parse_type(p));
    }
    parse_expect(p, ";");
    a
}

// parse_trait parses `trait Name: Super + Super { type A; fn f(&self); ... }`.
fn parse_trait(p: ParseState) -> AstTraitDecl {
    let pos = parse_expect(p, "trait").pos;
    let name = parse_expect(p, "IDENT").text;
    let generics = parse_generics(p);
    let mut d = AstTraitDecl {
        id: parse_id(p),
        pos: pos,
        name: name,
        generics: generics,
        supers: Vec::new(),
        assoc: Vec::new(),
        funcs: Vec::new(),
    };
    if parse_accept(p, ":") {
        d.supers.push(parse_type(p));
        while parse_accept(p, "+") {
            d.supers.push(parse_type(p));
        }
    }
    parse_expect(p, "{");
    while !parse_at(p, "}") && !parse_at(p, "EOF") {
        let attrs = parse_attrs(p);
        if parse_at(p, "type") {
            d.assoc.push(parse_assoc_type(p));
        } else if parse_at_const(p) {
            parse_fail(p, parse_tok(p).pos, "constants in traits are not supported");
        } else {
            let mut fd = parse_func(p, true);
            fd.attrs = attrs;
            d.funcs.push(fd);
        }
    }
    parse_expect(p, "}");
    d
}

// parse_generics parses `<T, U: Bound + Bound>` (nothing when absent).
fn parse_generics(p: ParseState) -> Vec<AstGeneric> {
    let mut gs = Vec::new();
    if !parse_accept(p, "<") {
        return gs;
    }
    while !parse_at(p, ">") {
        let t = parse_expect(p, "IDENT");
        let mut g = AstGeneric { id: parse_id(p), pos: t.pos, name: t.text, bounds: Vec::new() };
        if parse_accept(p, ":") {
            g.bounds.push(parse_type(p));
            while parse_accept(p, "+") {
                g.bounds.push(parse_type(p));
            }
        }
        gs.push(g);
        if !parse_accept(p, ",") {
            break;
        }
    }
    parse_expect(p, ">");
    gs
}

// parse_wheres parses `where T: A + B, U: C` (nothing when absent). With
// preds set, items that are not trait bounds are refinement predicates
// (`0 <= i`, `result <= hi`) and are added to preds.
fn parse_wheres(mut p: ParseState, preds: Option<Vec<AstExpr>>) -> Vec<AstWhere> {
    let mut ws = Vec::new();
    if !parse_accept(p, "where") {
        return ws;
    }
    while !parse_at(p, "{") && !parse_at(p, ";") && !parse_at(p, "EOF") {
        let pos = parse_tok(p).pos;
        if !parse_where_is_bound(p) {
            match preds {
                Some(mut ps) => {
                    let saved = p.no_struct;
                    p.no_struct = true;
                    ps.push(parse_expr(p));
                    p.no_struct = saved;
                }
                None => {
                    parse_fail(p, pos, "refinement predicates are only allowed on functions");
                }
            }
            if !parse_accept(p, ",") {
                break;
            }
            continue;
        }
        let ty = parse_type(p);
        parse_expect(p, ":");
        let mut w = AstWhere { id: parse_id(p), pos: pos, ty: ty, bounds: Vec::new() };
        w.bounds.push(parse_type(p));
        while parse_accept(p, "+") {
            w.bounds.push(parse_type(p));
        }
        ws.push(w);
        if !parse_accept(p, ",") {
            break;
        }
    }
    ws
}

// parse_where_is_bound reports whether the `where` item at the current
// token is a trait bound `Type: Bound`: a type (identifiers, `::`, `<>`,
// `&`, `mut`, parentheses, `,` inside brackets) followed by a single `:`.
// Anything else is a refinement predicate.
fn parse_where_is_bound(p: ParseState) -> Bool {
    if p.failed {
        return false;
    }
    let mut i = p.pos;
    let mut depth = 0;
    while i < p.toks.len() {
        let t = p.toks.get(i).unwrap_or(p.eof);
        let k = t.kind;
        if k == ":" {
            return depth == 0;
        }
        if k == "<" || k == "(" {
            depth = depth + 1;
        } else if k == ">" || k == ")" {
            depth = depth - 1;
            if depth < 0 {
                return false;
            }
        } else if k == "," {
            if depth == 0 {
                return false;
            }
        } else if !(k == "IDENT" || k == "::" || k == "&" || k == "mut" || k == "fn" || k == "->") {
            return false;
        }
        i = i + 1;
    }
    false
}

// parse_impl parses `impl<T> Target<T> { fn ... }` and
// `impl<T> Trait for Target<T> { ... }`.
fn parse_impl(p: ParseState) -> AstImplDecl {
    let pos = parse_expect(p, "impl").pos;
    let generics = parse_generics(p);
    let first = parse_type(p);
    let mut d = AstImplDecl {
        id: parse_id(p),
        pos: pos,
        generics: generics,
        trait_ty: None,
        target: first,
        wheres: Vec::new(),
        assoc: Vec::new(),
        funcs: Vec::new(),
        consts: Vec::new(),
    };
    if parse_at(p, "for") {
        parse_next(p);
        d.trait_ty = Some(first);
        d.target = parse_type(p);
    }
    d.wheres = parse_wheres(p, None);
    parse_expect(p, "{");
    while !parse_at(p, "}") && !parse_at(p, "EOF") {
        let attrs = parse_attrs(p);
        if parse_at(p, "type") {
            d.assoc.push(parse_assoc_type(p));
        } else if parse_at_const(p) {
            match attrs.get(0) {
                Some(a) => parse_fail(p, a.pos, "attributes are not allowed on `const` items"),
                None => {}
            }
            d.consts.push(parse_const(p));
        } else {
            let mut fd = parse_func(p, false);
            fd.attrs = attrs;
            d.funcs.push(fd);
        }
    }
    parse_expect(p, "}");
    d
}

fn parse_struct(p: ParseState) -> AstStructDecl {
    let pos = parse_expect(p, "struct").pos;
    let name = parse_expect(p, "IDENT").text;
    let generics = parse_generics(p);
    let mut d = AstStructDecl {
        id: parse_id(p),
        pos: pos,
        attrs: Vec::new(),
        name: name,
        generics: generics,
        fields: Vec::new(),
        kind: "",
    };
    if parse_accept(p, ";") {
        // unit struct `struct S;`
        d.kind = "unit";
        return d;
    }
    if parse_accept(p, "(") {
        // tuple struct `struct S(A, mut B);`
        d.kind = "tuple";
        while !parse_at(p, ")") {
            let fp = parse_tok(p).pos;
            let mutable = parse_accept(p, "mut");
            let ty = parse_type(p);
            let fname = d.fields.len().to_string();
            d.fields.push(AstField {
                id: parse_id(p),
                pos: fp,
                mutable: mutable,
                name: fname,
                ty: ty,
            });
            if !parse_accept(p, ",") {
                break;
            }
        }
        parse_expect(p, ")");
        parse_expect(p, ";");
        return d;
    }
    parse_expect(p, "{");
    while !parse_at(p, "}") {
        let fp = parse_tok(p).pos;
        let mutable = parse_accept(p, "mut");
        let fname = parse_expect(p, "IDENT").text;
        parse_expect(p, ":");
        let ty = parse_type(p);
        d.fields.push(AstField { id: parse_id(p), pos: fp, mutable: mutable, name: fname, ty: ty });
        if !parse_accept(p, ",") {
            break;
        }
    }
    parse_expect(p, "}");
    d
}

fn parse_enum(p: ParseState) -> AstEnumDecl {
    let pos = parse_expect(p, "enum").pos;
    let name = parse_expect(p, "IDENT").text;
    let generics = parse_generics(p);
    let mut d = AstEnumDecl {
        id: parse_id(p),
        pos: pos,
        attrs: Vec::new(),
        name: name,
        generics: generics,
        variants: Vec::new(),
    };
    parse_expect(p, "{");
    while !parse_at(p, "}") {
        let vp = parse_tok(p).pos;
        let vname = parse_expect(p, "IDENT").text;
        let mut v = AstVariant {
            id: parse_id(p),
            pos: vp,
            name: vname,
            fields: Vec::new(),
            named: false,
            names: Vec::new(),
        };
        if parse_accept(p, "{") {
            // struct-like variant `V { a: A, b: B }`
            v.named = true;
            while !parse_at(p, "}") {
                v.names.push(parse_expect(p, "IDENT").text);
                parse_expect(p, ":");
                v.fields.push(parse_type(p));
                if !parse_accept(p, ",") {
                    break;
                }
            }
            parse_expect(p, "}");
        } else if parse_accept(p, "(") {
            while !parse_at(p, ")") {
                v.fields.push(parse_type(p));
                if !parse_accept(p, ",") {
                    break;
                }
            }
            parse_expect(p, ")");
        }
        d.variants.push(v);
        if !parse_accept(p, ",") {
            break;
        }
    }
    parse_expect(p, "}");
    d
}

// parse_func parses a function; in a trait (in_trait) the body may be
// replaced by `;`.
fn parse_func(p: ParseState, in_trait: Bool) -> AstFuncDecl {
    let pos = parse_expect(p, "fn").pos;
    let name = parse_expect(p, "IDENT").text;
    let id = parse_id(p);
    let generics = parse_generics(p);
    let mut params = Vec::new();
    let mut self_kind = "";
    parse_expect(p, "(");
    // receiver: `self`, `mut self`, `&self` or `&mut self`
    let sp = parse_tok(p).pos;
    if parse_at(p, "IDENT") && parse_tok(p).text == "self" {
        parse_next(p);
        self_kind = "self";
    } else if parse_at(p, "mut") && parse_peek_text(p) == "self" {
        parse_next(p);
        parse_next(p);
        self_kind = "mut self";
    } else if parse_at(p, "&") {
        parse_next(p);
        self_kind = if parse_accept(p, "mut") {
            "&mut self"
        } else {
            "&self"
        };
        let t = parse_expect(p, "IDENT");
        if t.text != "self" {
            parse_fail(p, t.pos, "expected `self`, found " + parse_describe(t));
        }
    }
    if self_kind != "" {
        params.push(AstParam {
            id: parse_id(p),
            pos: sp,
            mutable: self_kind == "mut self" || self_kind == "&mut self",
            name: "self",
            ty: None,
        });
        if !parse_accept(p, ",") && !parse_at(p, ")") {
            parse_fail(
                p,
                parse_tok(p).pos,
                "expected `,` or `)`, found " + parse_describe(parse_tok(p)),
            );
        }
    }
    while !parse_at(p, ")") {
        let pp = parse_tok(p).pos;
        let pmut = parse_accept(p, "mut");
        let mut pname = "_";
        if parse_at(p, "_") {
            parse_next(p);
        } else {
            pname = parse_expect(p, "IDENT").text;
        }
        parse_expect(p, ":");
        let ty = parse_type(p);
        params.push(AstParam { id: parse_id(p), pos: pp, mutable: pmut, name: pname, ty: Some(ty) });
        if !parse_accept(p, ",") {
            break;
        }
    }
    parse_expect(p, ")");
    let mut result = None;
    if parse_accept(p, "->") {
        result = Some(parse_type(p));
    }
    let preds = Vec::new();
    let wheres = parse_wheres(p, Some(preds));
    let mut has_body = true;
    let mut body = AstBlock { id: parse_id(p), pos: pos, stmts: Vec::new(), tail: None, end: pos };
    if in_trait && parse_at(p, ";") {
        parse_next(p);
        has_body = false;
    } else {
        body = parse_block(p);
    }
    AstFuncDecl {
        id: id,
        pos: pos,
        attrs: Vec::new(),
        name: name,
        generics: generics,
        self_kind: self_kind,
        params: params,
        result: result,
        wheres: wheres,
        preds: preds,
        has_body: has_body,
        body: body,
    }
}

fn parse_dummy_pos(p: ParseState) -> AstPos {
    p.eof.pos
}

fn parse_type(p: ParseState) -> AstType {
    let t = parse_tok(p);
    if t.kind == "&" {
        parse_next(p);
        let id = parse_id(p);
        let mutable = parse_accept(p, "mut");
        let elem = parse_type(p);
        return AstType::Ref(AstRefType { id: id, pos: t.pos, mutable: mutable, elem: elem });
    }
    if t.kind == "(" {
        parse_next(p);
        if parse_accept(p, ")") {
            return AstType::Unit(AstUnitType { id: parse_id(p), pos: t.pos });
        }
        let mut elems = Vec::new();
        let mut trailing = false;
        while !parse_at(p, ")") {
            elems.push(parse_type(p));
            trailing = parse_accept(p, ",");
            if !trailing {
                break;
            }
        }
        parse_expect(p, ")");
        if elems.len() == 1 && !trailing {
            return elems.get(0).unwrap_or(AstType::Unit(AstUnitType { id: 0, pos: t.pos }));
        }
        return AstType::Tuple(AstTupleType { id: parse_id(p), pos: t.pos, elems: elems });
    }
    if t.kind == "fn" || t.kind == "impl" || (t.kind == "IDENT" && t.text == "dyn") {
        return parse_fn_type(p);
    }
    if t.kind == "IDENT"
        && (t.text == "Fn" || t.text == "FnMut" || t.text == "FnOnce")
        && parse_peek_at(p, "(") {
        return parse_fn_type(p);
    }
    if t.kind == "IDENT" {
        parse_next(p);
        let mut nt = AstNamedType { id: parse_id(p), pos: t.pos, name: t.text, args: Vec::new() };
        if parse_at(p, "::") && parse_peek_at(p, "IDENT") {
            // an associated type `T::Item`
            parse_next(p);
            nt.name = t.text + "::" + parse_expect(p, "IDENT").text;
            return AstType::Named(nt);
        }
        if parse_at(p, "<") {
            nt.args = parse_type_args(p);
        }
        return AstType::Named(nt);
    }
    if t.kind == "_" {
        // a type left to inference
        parse_next(p);
        return AstType::Named(AstNamedType {
            id: parse_id(p),
            pos: t.pos,
            name: "_",
            args: Vec::new(),
        });
    }
    parse_fail(p, t.pos, "expected type, found " + parse_describe(t));
    AstType::Unit(AstUnitType { id: parse_id(p), pos: t.pos })
}

// parse_fn_type parses `fn(A) -> R`, `Fn(A) -> R` (FnMut, FnOnce) and
// `impl Fn(A) -> R` / `dyn Fn(A) -> R`.
fn parse_fn_type(p: ParseState) -> AstType {
    let t = parse_next(p);
    let mut kind = t.text;
    if t.kind == "fn" {
        kind = "fn";
    } else if t.kind == "impl" || t.text == "dyn" {
        let prefix = if t.kind == "impl" { "impl " } else { "dyn " };
        let n = parse_expect(p, "IDENT");
        if n.text != "Fn" && n.text != "FnMut" && n.text != "FnOnce" {
            parse_fail(
                p,
                n.pos,
                "only `" + prefix + "Fn(...)` is supported, found `" + prefix + n.text + "`",
            );
        }
        kind = prefix + n.text;
    }
    let mut ft = AstFnType {
        id: parse_id(p),
        pos: t.pos,
        kind: kind,
        params: Vec::new(),
        result: None,
    };
    parse_expect(p, "(");
    while !parse_at(p, ")") {
        ft.params.push(parse_type(p));
        if !parse_accept(p, ",") {
            break;
        }
    }
    parse_expect(p, ")");
    if parse_accept(p, "->") {
        ft.result = Some(parse_type(p));
    }
    AstType::Fn(ft)
}

// parse_type_args parses `<A, B>`.
fn parse_type_args(p: ParseState) -> Vec<AstType> {
    let mut args = Vec::new();
    parse_expect(p, "<");
    while !parse_at(p, ">") {
        if parse_at(p, "IDENT") && parse_peek_at(p, "=") {
            // an associated type binding `Item = T` (in a trait bound)
            let t = parse_next(p);
            parse_next(p);
            let mut b = AstNamedType {
                id: parse_id(p),
                pos: t.pos,
                name: "=" + t.text,
                args: Vec::new(),
            };
            b.args.push(parse_type(p));
            args.push(AstType::Named(b));
        } else {
            args.push(parse_type(p));
        }
        if !parse_accept(p, ",") {
            break;
        }
    }
    parse_expect(p, ">");
    args
}

// parse_turbofish parses `::<A, B>` when present.
fn parse_turbofish(p: ParseState) -> Vec<AstType> {
    if parse_at(p, "::") && parse_peek_at(p, "<") {
        parse_next(p);
        return parse_type_args(p);
    }
    Vec::new()
}

fn parse_block(mut p: ParseState) -> AstBlock {
    let pos = parse_expect(p, "{").pos;
    let saved = p.no_struct;
    p.no_struct = false;
    let mut b = AstBlock { id: parse_id(p), pos: pos, stmts: Vec::new(), tail: None, end: pos };
    while !parse_at(p, "}") && !parse_at(p, "EOF") {
        let sp = parse_tok(p).pos;
        let k = parse_tok(p).kind;
        if k == ";" {
            parse_next(p);
            continue;
        }
        if k == "let" {
            parse_next(p);
            let mut mutable = false;
            let mut name = "_";
            let mut pat = None;
            if parse_at(p, "(")
                || (parse_at(p, "IDENT")
                    && (parse_peek_at(p, "(") || parse_peek_at(p, "::") || parse_peek_at(p, "{"))) {
                pat = Some(parse_pattern(p));
            } else {
                mutable = parse_accept(p, "mut");
                if parse_at(p, "_") {
                    parse_next(p);
                } else {
                    name = parse_expect(p, "IDENT").text;
                }
            }
            let mut ty = None;
            if parse_accept(p, ":") {
                ty = Some(parse_type(p));
            }
            parse_expect(p, "=");
            let init = parse_expr(p);
            parse_expect(p, ";");
            b.stmts.push(
                AstStmt::Let(AstLetStmt {
                    id: parse_id(p),
                    pos: sp,
                    mutable: mutable,
                    name: name,
                    pat: pat,
                    ty: ty,
                    init: init,
                }),
            );
            continue;
        }
        if k == "while" {
            parse_next(p);
            let mut pat = None;
            if parse_accept(p, "let") {
                pat = Some(parse_top_pattern(p));
                parse_expect(p, "=");
            }
            p.no_struct = true;
            let cond = parse_expr(p);
            p.no_struct = false;
            let body = parse_block(p);
            b.stmts.push(
                AstStmt::While(AstWhileStmt {
                    id: parse_id(p),
                    pos: sp,
                    pat: pat,
                    cond: cond,
                    body: body,
                }),
            );
            continue;
        }
        if k == "for" {
            parse_next(p);
            let mut var = "_";
            let mut pat = None;
            if parse_at(p, "(")
                || parse_at(p, "mut")
                || (parse_at(p, "IDENT")
                    && (parse_peek_at(p, "(") || parse_peek_at(p, "::") || parse_peek_at(p, "{"))) {
                pat = Some(parse_pattern(p));
            } else if !parse_accept(p, "_") {
                var = parse_expect(p, "IDENT").text;
            }
            parse_expect(p, "in");
            p.no_struct = true;
            let mut iter = parse_expr(p);
            let mut end = None;
            match iter {
                AstExpr::Range(r) => {
                    if !r.inclusive {
                        iter = r.start;
                        end = Some(r.end);
                    }
                }
                _ => {}
            }
            p.no_struct = false;
            let body = parse_block(p);
            b.stmts.push(
                AstStmt::For(AstForStmt {
                    id: parse_id(p),
                    pos: sp,
                    var: var,
                    pat: pat,
                    iter: iter,
                    end: end,
                    body: body,
                }),
            );
            continue;
        }
        if k == "return" {
            parse_next(p);
            let mut value = None;
            if !parse_at(p, ";") && !parse_at(p, "}") {
                value = Some(parse_expr(p));
            }
            if !parse_accept(p, ";") && !parse_at(p, "}") {
                parse_fail(
                    p,
                    parse_tok(p).pos,
                    "expected `;` after return, found " + parse_describe(parse_tok(p)),
                );
            }
            b.stmts.push(AstStmt::Return(AstReturnStmt { id: parse_id(p), pos: sp, value: value }));
            continue;
        }
        if k == "break" || k == "continue" {
            parse_next(p);
            if !parse_accept(p, ";") && !parse_at(p, "}") {
                parse_fail(
                    p,
                    parse_tok(p).pos,
                    "expected `;`, found " + parse_describe(parse_tok(p)),
                );
            }
            if k == "break" {
                b.stmts.push(AstStmt::Break(AstBreakStmt { id: parse_id(p), pos: sp }));
            } else {
                b.stmts.push(AstStmt::Continue(AstContinueStmt { id: parse_id(p), pos: sp }));
            }
            continue;
        }
        let mut e = AstExpr::UnitLit(AstUnitLit { id: 0, pos: sp });
        if k == "if" || k == "match" || k == "{" {
            // A block-like expression in statement position ends the
            // statement unless it is followed by a method call or `?`.
            e = parse_primary(p);
            if parse_at(p, ".") || parse_at(p, "?") {
                e = parse_binary_rest(p, parse_postfix(p, e), 0);
            }
        } else {
            e = parse_expr(p);
        }
        if parse_accept(p, "=") {
            let val = parse_expr(p);
            parse_expect(p, ";");
            match e {
                AstExpr::Ident(t) => b.stmts.push(
                    AstStmt::Assign(AstAssignStmt {
                        id: parse_id(p),
                        pos: sp,
                        name: t.name,
                        value: val,
                    }),
                ),
                AstExpr::Field(t) => b.stmts.push(
                    AstStmt::FieldAssign(AstFieldAssignStmt {
                        id: parse_id(p),
                        pos: sp,
                        target: t,
                        value: val,
                    }),
                ),
                _ => parse_fail(p, sp, "invalid assignment target"),
            }
            continue;
        }
        if parse_accept(p, ";") {
            b.stmts.push(AstStmt::Expr(AstExprStmt { id: parse_id(p), pos: sp, x: e, semi: true }));
            continue;
        }
        if parse_at(p, "}") {
            b.tail = Some(e);
            break;
        }
        if parse_block_like(e) {
            b.stmts.push(AstStmt::Expr(AstExprStmt { id: parse_id(p), pos: sp, x: e, semi: false }));
            continue;
        }
        parse_fail(
            p,
            parse_tok(p).pos,
            "expected `;` or `}`, found " + parse_describe(parse_tok(p)),
        );
    }
    b.end = parse_expect(p, "}").pos;
    p.no_struct = saved;
    b
}

fn parse_block_like(e: AstExpr) -> Bool {
    match e {
        AstExpr::If(_) => true,
        AstExpr::Match(_) => true,
        AstExpr::Block(_) => true,
        _ => false,
    }
}

fn parse_expr(p: ParseState) -> AstExpr {
    let x = parse_binary(p, 0);
    if parse_at(p, "..") || parse_at(p, "..=") {
        let t = parse_next(p);
        let y = parse_binary(p, 0);
        return AstExpr::Range(AstRange {
            id: parse_id(p),
            pos: t.pos,
            start: x,
            end: y,
            inclusive: t.kind == "..=",
        });
    }
    x
}

fn parse_prec(k: String) -> Int {
    if k == "||" {
        return 1;
    }
    if k == "&&" {
        return 2;
    }
    if k == "==" || k == "!=" || k == "<" || k == "<=" || k == ">" || k == ">=" {
        return 3;
    }
    if k == "+" || k == "-" {
        return 4;
    }
    if k == "*" || k == "/" || k == "%" {
        return 5;
    }
    0
}

fn parse_binary(p: ParseState, min_prec: Int) -> AstExpr {
    let x = parse_unary(p);
    parse_binary_rest(p, x, min_prec)
}

fn parse_binary_rest(p: ParseState, x0: AstExpr, min_prec: Int) -> AstExpr {
    let mut x = x0;
    while true {
        let op = parse_tok(p).kind;
        let prec = parse_prec(op);
        if prec == 0 || prec <= min_prec {
            return x;
        }
        let pos = parse_next(p).pos;
        let y = parse_binary(p, prec);
        if prec == 3 && parse_prec(parse_tok(p).kind) == 3 {
            // comparisons are non-associative
            parse_fail(p, parse_tok(p).pos, "comparison operators cannot be chained");
        }
        x = AstExpr::Binary(AstBinary { id: parse_id(p), pos: pos, op: op, x: x, y: y });
    }
    x
}

fn parse_unary(p: ParseState) -> AstExpr {
    let t = parse_tok(p);
    if t.kind == "-" || t.kind == "!" || t.kind == "*" || t.kind == "&" {
        parse_next(p);
        let mut op = t.kind;
        if op == "&" && parse_accept(p, "mut") {
            op = "&mut ";
        }
        let x = parse_unary(p);
        return AstExpr::Unary(AstUnary { id: parse_id(p), pos: t.pos, op: op, x: x });
    }
    let e = parse_primary(p);
    parse_postfix(p, e)
}

fn parse_args(mut p: ParseState) -> Vec<AstExpr> {
    parse_expect(p, "(");
    let saved = p.no_struct;
    p.no_struct = false;
    let mut args = Vec::new();
    while !parse_at(p, ")") {
        args.push(parse_expr(p));
        if !parse_accept(p, ",") {
            break;
        }
    }
    parse_expect(p, ")");
    p.no_struct = saved;
    args
}

fn parse_postfix(mut p: ParseState, x0: AstExpr) -> AstExpr {
    let mut x = x0;
    while true {
        let t = parse_tok(p);
        if t.kind == "(" {
            let args = parse_args(p);
            x = AstExpr::Call(
                AstCall { id: parse_id(p), pos: ast_expr_pos(x), func: x, args: args },
            );
        } else if t.kind == "." {
            parse_next(p);
            if parse_at(p, "INT") {
                // tuple element `x.0`
                let it = parse_next(p);
                x = AstExpr::Field(AstFieldExpr {
                    id: parse_id(p),
                    pos: it.pos,
                    x: x,
                    name: it.text,
                });
                continue;
            }
            let name = parse_expect(p, "IDENT");
            let targs = parse_turbofish(p);
            if parse_at(p, "(") || targs.len() > 0 {
                let args = parse_args(p);
                x = AstExpr::Method(AstMethodCall {
                    id: parse_id(p),
                    pos: name.pos,
                    recv: x,
                    name: name.text,
                    targs: targs,
                    args: args,
                });
            } else {
                x = AstExpr::Field(AstFieldExpr {
                    id: parse_id(p),
                    pos: name.pos,
                    x: x,
                    name: name.text,
                });
            }
        } else if t.kind == "[" {
            parse_next(p);
            let saved = p.no_struct;
            p.no_struct = false;
            let ix = parse_expr(p);
            p.no_struct = saved;
            parse_expect(p, "]");
            x = AstExpr::Index(AstIndex { id: parse_id(p), pos: t.pos, x: x, index: ix });
        } else if t.kind == "?" {
            parse_next(p);
            x = AstExpr::Try(AstTry { id: parse_id(p), pos: t.pos, x: x });
        } else {
            return x;
        }
    }
    x
}

fn parse_is_upper(s: String) -> Bool {
    // runtime prelude types are spelled `__Name`
    let t = if s.starts_with("__") {
        s.slice(2, s.len())
    } else {
        s
    };
    let c = t.char_at(0).unwrap_or(0);
    c >= 65 && c <= 90
}

// parse_int_text parses a string of decimal digits as an Int (None when
// out of range).
fn parse_int_text(s: String) -> Option<Int> {
    let n = s.len();
    if n == 0 {
        return None;
    }
    let mut v = 0;
    for i in 0..n {
        let d = s.char_at(i).unwrap_or(0) - 48;
        if v > (9223372036854775807 - d) / 10 {
            return None;
        }
        v = v * 10 + d;
    }
    Some(v)
}

fn parse_primary(mut p: ParseState) -> AstExpr {
    let t = parse_tok(p);
    let k = t.kind;
    if k == "INT" {
        parse_next(p);
        let mut v = 0;
        match parse_int_text(t.text) {
            Some(n) => {
                v = n;
            }
            None => parse_fail(p, t.pos, "integer literal out of range"),
        }
        return AstExpr::IntLit(AstIntLit { id: parse_id(p), pos: t.pos, value: v });
    }
    if k == "STRING" {
        parse_next(p);
        return AstExpr::StrLit(AstStringLit { id: parse_id(p), pos: t.pos, value: t.text });
    }
    if k == "true" || k == "false" {
        parse_next(p);
        return AstExpr::BoolLit(AstBoolLit { id: parse_id(p), pos: t.pos, value: k == "true" });
    }
    if k == "(" {
        parse_next(p);
        if parse_accept(p, ")") {
            return AstExpr::UnitLit(AstUnitLit { id: parse_id(p), pos: t.pos });
        }
        let saved = p.no_struct;
        p.no_struct = false;
        let e = parse_expr(p);
        if parse_at(p, ",") {
            // tuple `(a, b)` or `(a,)`
            let mut elems = Vec::new();
            elems.push(e);
            while parse_accept(p, ",") {
                if parse_at(p, ")") {
                    break;
                }
                elems.push(parse_expr(p));
            }
            p.no_struct = saved;
            parse_expect(p, ")");
            return AstExpr::Tuple(AstTupleLit { id: parse_id(p), pos: t.pos, elems: elems });
        }
        p.no_struct = saved;
        parse_expect(p, ")");
        return e;
    }
    if k == "{" {
        return AstExpr::Block(parse_block(p));
    }
    if k == "if" {
        return AstExpr::If(parse_if(p));
    }
    if k == "match" {
        return parse_match(p);
    }
    if k == "|"
        || k == "||"
        || (k == "IDENT" && t.text == "move" && (parse_peek_at(p, "|") || parse_peek_at(p, "||"))) {
        return parse_closure(p);
    }
    if k == "IDENT" {
        parse_next(p);
        if parse_at(p, "!") && (parse_peek_at(p, "(") || parse_peek_at(p, "[")) {
            return mac_parse(p, t);
        }
        let ty_args = parse_turbofish(p);
        if parse_at(p, "::") {
            parse_next(p);
            let name = parse_expect(p, "IDENT");
            let targs = parse_turbofish(p);
            if ty_args.len() == 0
                && targs.len() == 0
                && parse_at(p, "{")
                && !p.no_struct
                && parse_is_upper(name.text) {
                // struct-like variant `E::V { f: e }`
                return parse_struct_lit(p, Tok {
                    kind: "IDENT",
                    text: t.text + "::" + name.text,
                    pos: t.pos,
                });
            }
            return AstExpr::Path(AstPathExpr {
                id: parse_id(p),
                pos: t.pos,
                ty: t.text,
                ty_args: ty_args,
                name: name.text,
                targs: targs,
            });
        }
        if ty_args.len() == 0 && parse_at(p, "{") && !p.no_struct && parse_is_upper(t.text) {
            return parse_struct_lit(p, t);
        }
        return AstExpr::Ident(
            AstIdent { id: parse_id(p), pos: t.pos, name: t.text, targs: ty_args },
        );
    }
    parse_fail(p, t.pos, "expected expression, found " + parse_describe(t));
    AstExpr::UnitLit(AstUnitLit { id: parse_id(p), pos: t.pos })
}

fn parse_struct_lit(p: ParseState, name: Tok) -> AstExpr {
    parse_expect(p, "{");
    let mut lit = AstStructLit {
        id: parse_id(p),
        pos: name.pos,
        name: name.text,
        fields: Vec::new(),
    };
    while !parse_at(p, "}") {
        let ft = parse_expect(p, "IDENT");
        let mut value = AstExpr::UnitLit(AstUnitLit { id: 0, pos: ft.pos });
        if parse_accept(p, ":") {
            value = parse_expr(p);
        } else {
            // shorthand `Point { x, y }`
            value = AstExpr::Ident(AstIdent {
                id: parse_id(p),
                pos: ft.pos,
                name: ft.text,
                targs: Vec::new(),
            });
        }
        lit.fields.push(AstFieldInit { id: parse_id(p), pos: ft.pos, name: ft.text, value: value });
        if !parse_accept(p, ",") {
            break;
        }
    }
    parse_expect(p, "}");
    AstExpr::StructLit(lit)
}

fn parse_closure(p: ParseState) -> AstExpr {
    let pos = parse_tok(p).pos;
    let is_move = parse_at(p, "IDENT");
    if is_move {
        parse_next(p);
    }
    let id = parse_id(p);
    let mut params = Vec::new();
    if !parse_accept(p, "||") {
        parse_expect(p, "|");
        while !parse_at(p, "|") {
            let pp = parse_tok(p).pos;
            let pmut = parse_accept(p, "mut");
            let name = parse_expect(p, "IDENT").text;
            let mut ty = None;
            if parse_accept(p, ":") {
                ty = Some(parse_type(p));
            }
            params.push(AstParam { id: parse_id(p), pos: pp, mutable: pmut, name: name, ty: ty });
            if !parse_accept(p, ",") {
                break;
            }
        }
        parse_expect(p, "|");
    }
    let mut result = None;
    if parse_accept(p, "->") {
        // with a return type, the body must be a block
        result = Some(parse_type(p));
        let b = parse_block(p);
        return AstExpr::Closure(AstClosure {
            id: id,
            pos: pos,
            is_move: is_move,
            params: params,
            result: result,
            body: AstExpr::Block(b),
        });
    }
    let body = parse_expr(p);
    AstExpr::Closure(AstClosure {
        id: id,
        pos: pos,
        is_move: is_move,
        params: params,
        result: result,
        body: body,
    })
}

fn parse_if(mut p: ParseState) -> AstIf {
    let pos = parse_expect(p, "if").pos;
    let mut pat = None;
    if parse_accept(p, "let") {
        pat = Some(parse_top_pattern(p));
        parse_expect(p, "=");
    }
    let saved = p.no_struct;
    p.no_struct = true;
    let cond = parse_expr(p);
    p.no_struct = saved;
    let then = parse_block(p);
    let mut e = AstIf { id: parse_id(p), pos: pos, pat: pat, cond: cond, then: then, els: None };
    if parse_accept(p, "else") {
        if parse_at(p, "if") {
            e.els = Some(AstExpr::If(parse_if(p)));
        } else {
            e.els = Some(AstExpr::Block(parse_block(p)));
        }
    }
    e
}

fn parse_match(mut p: ParseState) -> AstExpr {
    let pos = parse_expect(p, "match").pos;
    let saved = p.no_struct;
    p.no_struct = true;
    let x = parse_expr(p);
    p.no_struct = saved;
    let mut m = AstMatch { id: parse_id(p), pos: pos, x: x, arms: Vec::new() };
    parse_expect(p, "{");
    while !parse_at(p, "}") {
        let ap = parse_tok(p).pos;
        let pat = parse_top_pattern(p);
        let mut guard = None;
        if parse_accept(p, "if") {
            guard = Some(parse_expr(p));
        }
        parse_expect(p, "=>");
        let body = parse_expr(p);
        m.arms.push(AstMatchArm { id: parse_id(p), pos: ap, pat: pat, guard: guard, body: body });
        if !parse_accept(p, ",") {
            if parse_block_like(body) && !p.failed {
                continue;
            }
            break;
        }
    }
    parse_expect(p, "}");
    AstExpr::Match(m)
}

// parse_top_pattern parses the pattern of a match arm, `if let` or
// `while let`, which may start with `|`.
fn parse_top_pattern(p: ParseState) -> AstPattern {
    parse_accept(p, "|");
    parse_pattern(p)
}

// parse_pattern parses a pattern, an or-pattern `p | q | ...` included.
fn parse_pattern(p: ParseState) -> AstPattern {
    let pos = parse_tok(p).pos;
    let first = parse_pattern_no_alt(p);
    if !parse_at(p, "|") {
        return first;
    }
    let mut pat = ast_new_pattern(parse_id(p), pos);
    pat.alts.push(first);
    while parse_accept(p, "|") {
        pat.alts.push(parse_pattern_no_alt(p));
    }
    pat
}

// parse_kind_ahead is the kind of the token n places after the current one.
fn parse_kind_ahead(p: ParseState, n: Int) -> String {
    if p.failed {
        return "";
    }
    match p.toks.get(p.pos + n) {
        Some(t) => t.kind,
        None => "",
    }
}

// parse_pattern_int parses an integer literal pattern, optionally negated.
fn parse_pattern_int(p: ParseState) -> Int {
    let neg = parse_accept(p, "-");
    let it = parse_expect(p, "INT");
    let mut v = 0;
    match parse_int_text(it.text) {
        Some(n) => {
            v = n;
        }
        None => parse_fail(p, it.pos, "integer literal out of range"),
    }
    if neg {
        v = -v;
    }
    v
}

// parse_pattern_no_alt parses a pattern other than an or-pattern (one
// alternative of it).
fn parse_pattern_no_alt(p: ParseState) -> AstPattern {
    let t = parse_tok(p);
    let mut pat = ast_new_pattern(parse_id(p), t.pos);
    let k = t.kind;
    if k == "_" {
        parse_next(p);
        pat.wildcard = true;
        return pat;
    }
    if k == "(" {
        parse_next(p);
        let mut trailing = false;
        while !parse_at(p, ")") {
            pat.args.push(parse_pattern(p));
            trailing = parse_accept(p, ",");
            if !trailing {
                break;
            }
        }
        parse_expect(p, ")");
        if pat.args.len() == 1 && !trailing {
            // parenthesized pattern
            return pat.args.get(0).unwrap_or(pat);
        }
        pat.tuple = true;
        return pat;
    }
    if (k == "IDENT" && parse_peek_at(p, "@"))
        || (k == "mut" && parse_peek_at(p, "IDENT") && parse_kind_ahead(p, 2) == "@") {
        // `name @ p`
        pat.mutable = parse_accept(p, "mut");
        pat.bind = parse_expect(p, "IDENT").text;
        parse_expect(p, "@");
        pat.at.push(parse_pattern_no_alt(p));
        return pat;
    }
    if k == "..=" {
        parse_next(p);
        pat.range = true;
        pat.range_incl = true;
        pat.range_hi = Some(parse_pattern_int(p));
        return pat;
    }
    if k == "mut" {
        parse_next(p);
        let it = parse_expect(p, "IDENT");
        pat.bind = it.text;
        pat.mutable = true;
        return pat;
    }
    if k == "INT" || k == "-" {
        let v = parse_pattern_int(p);
        if parse_at(p, "..=") || parse_at(p, "..") {
            // `lo..=hi`, `lo..hi` or `lo..`
            pat.range = true;
            pat.range_lo = Some(v);
            pat.range_incl = parse_at(p, "..=");
            parse_next(p);
            if parse_at(p, "INT") || parse_at(p, "-") {
                pat.range_hi = Some(parse_pattern_int(p));
            } else if pat.range_incl {
                parse_fail(p, parse_tok(p).pos, "expected the end of the range pattern");
            }
            return pat;
        }
        pat.int_value = Some(v);
        return pat;
    }
    if k == "true" || k == "false" {
        parse_next(p);
        pat.bool_lit = Some(k == "true");
        return pat;
    }
    if k == "STRING" {
        parse_next(p);
        pat.str_value = Some(t.text);
        return pat;
    }
    if k == "IDENT" {
        parse_next(p);
        let mut name = t.text;
        if parse_accept(p, "::") {
            pat.ty = name;
            name = parse_expect(p, "IDENT").text;
            pat.ctor = name;
        }
        if parse_accept(p, "(") {
            pat.ctor = name;
            while !parse_at(p, ")") {
                pat.args.push(parse_pattern(p));
                if !parse_accept(p, ",") {
                    break;
                }
            }
            parse_expect(p, ")");
            return pat;
        }
        if parse_at(p, "{") && parse_is_upper(name) {
            // struct pattern `S { a, b: p, mut c, .. }`
            parse_next(p);
            pat.ctor = name;
            pat.brace = true;
            while !parse_at(p, "}") {
                if parse_accept(p, "..") {
                    pat.rest = true;
                    break;
                }
                let ft = parse_tok(p);
                let fmut = parse_accept(p, "mut");
                let fname = parse_expect(p, "IDENT").text;
                if !fmut && parse_accept(p, ":") {
                    pat.args.push(parse_pattern(p));
                } else {
                    let mut fp = ast_new_pattern(parse_id(p), ft.pos);
                    fp.mutable = fmut;
                    fp.bind = fname;
                    pat.args.push(fp);
                }
                pat.fields.push(fname);
                if !parse_accept(p, ",") {
                    break;
                }
            }
            parse_expect(p, "}");
            return pat;
        }
        if pat.ctor == "" {
            // resolved by the checker: binding or nullary constructor
            pat.bind = name;
        }
        return pat;
    }
    parse_fail(p, t.pos, "expected pattern, found " + parse_describe(t));
    pat
}
