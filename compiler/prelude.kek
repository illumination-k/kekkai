// The runtime prelude (lib/prelude) is embedded in the compiler as
// compiler/prelude_src.kek, generated by
//
//   kek embed-prelude lib/prelude compiler/prelude_src.kek [-check]

fn prelude_file(v: Vec<FeSource>, name: String, text: String) {
    v.push(FeSource { name: "<prelude>/" + name, text: text });
}

fn prelude_escape(s: String) -> String {
    s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace(
        "\r",
        "\\r",
    )
}

fn prelude_embed_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 3 {
        log.error("usage: embed-prelude <dir> <out.kek> [-check]");
        return 2;
    }
    let dir = frontend_clean_dir(args.get(1).unwrap_or(""));
    let out_path = args.get(2).unwrap_or("");
    let check = args.get(3).unwrap_or("") == "-check";
    let names = match fs.list(dir) {
        Ok(ns) => ns,
        Err(e) => {
            log.error(dir + ": " + e.message());
            return 1;
        }
    };
    let mut src = "// Generated by `kek embed-prelude "
        + dir
        + " "
        + out_path
        + "` from the files of "
        + dir
        + ". Do not edit.\n\nfn prelude_sources() -> Vec<FeSource> {\n    let v = Vec::new();\n";
    for n in names {
        if !n.ends_with(".kek") {
            continue;
        }
        let text = match fs.read(dir + "/" + n) {
            Ok(t) => t,
            Err(e) => {
                log.error(dir + "/" + n + ": " + e.message());
                return 1;
            }
        };
        src = src + "    prelude_file(v, \"" + n + "\", \"" + prelude_escape(text) + "\");\n";
    }
    src = src + "    v\n}\n";
    let res = fmt_source(src);
    if res.errs.len() > 0 {
        log.error("embed-prelude: generated source does not parse");
        return 1;
    }
    let out = res.out;
    if check {
        match fs.read(out_path) {
            Ok(cur) => {
                if cur == out {
                    return 0;
                }
            }
            Err(_) => {}
        }
        log.error(out_path + " is out of date: run `kek embed-prelude " + dir + " " + out_path + "`");
        return 1;
    }
    match fs.write(out_path, out) {
        Ok(_) => 0,
        Err(e) => {
            log.error(out_path + ": " + e.message());
            1
        }
    }
}
