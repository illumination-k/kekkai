// The runtime prelude (lib/prelude) and the core library (lib/core) are
// embedded in the compiler as compiler/prelude_src.kek and
// compiler/core_src.kek, generated by
//
//   kek embed-prelude lib/prelude compiler/prelude_src.kek [-check]
//   kek embed-prelude lib/core compiler/core_src.kek -as core [-check]

fn prelude_file(mut v: Vec<FeSource>, name: String, text: String) {
    v.push(FeSource { name: "<prelude>/" + name, text: text });
}

fn core_file(mut v: Vec<FeSource>, name: String, text: String) {
    v.push(FeSource { name: "<core>/" + name, text: text });
}

fn prelude_escape(s: String) -> String {
    s.replace("\\", "\\\\").replace("\"", "\\\"").replace("\n", "\\n").replace("\t", "\\t").replace(
        "\r",
        "\\r",
    )
}

fn prelude_embed_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 3 {
        log.error("usage: embed-prelude <dir> <out.kek> [-check] [-as core]");
        return 2;
    }
    let dir = frontend_clean_dir(args.get(1).unwrap_or(""));
    let out_path = args.get(2).unwrap_or("");
    let mut check = false;
    let mut kind = "prelude";
    let mut i = 3;
    while i < args.len() {
        let a = args.get(i).unwrap_or("");
        if a == "-check" {
            check = true;
        } else if a == "-as" && i + 1 < args.len() {
            kind = args.get(i + 1).unwrap_or("");
            i = i + 1;
        } else {
            log.error("embed-prelude: unknown argument " + a);
            return 2;
        }
        i = i + 1;
    }
    let mut flags = "";
    if kind != "prelude" {
        flags = " -as " + kind;
    }
    let names = match fs.list(dir) {
        Ok(ns) => ns,
        Err(e) => {
            log.error(dir + ": " + e.message());
            return 1;
        }
    };
    let mut src = "// Generated by `kek embed-prelude "
        + dir
        + " "
        + out_path
        + flags
        + "` from the files of "
        + dir
        + ". Do not edit.\n\nfn "
        + kind
        + "_sources() -> Vec<FeSource> {\n    let v = Vec::new();\n";
    for n in names {
        if !n.ends_with(".kek") {
            continue;
        }
        let text = match fs.read(dir + "/" + n) {
            Ok(t) => t,
            Err(e) => {
                log.error(dir + "/" + n + ": " + e.message());
                return 1;
            }
        };
        // the shape `kek fmt` gives to a call with a long string argument
        src = src
            + "    "
            + kind
            + "_file(\n        v,\n        \""
            + n
            + "\",\n        \""
            + prelude_escape(text)
            + "\",\n    );\n";
    }
    src = src + "    v\n}\n";
    let out = src;
    if check {
        match fs.read(out_path) {
            Ok(cur) => {
                if cur == out {
                    return 0;
                }
            }
            Err(_) => {}
        }
        log.error(
            out_path
                + " is out of date: run `kek embed-prelude "
                + dir
                + " "
                + out_path
                + flags
                + "`",
        );
        return 1;
    }
    match fs.write(out_path, out) {
        Ok(_) => 0,
        Err(e) => {
            log.error(out_path + ": " + e.message());
            1
        }
    }
}
