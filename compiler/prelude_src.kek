        "// Response values (see js/kekkai_runtime.js for how Workers send them).\n\nfn __resp(status: Int, body: String, has_body: Bool, content_type: String) -> Response {\n    let h = Vec::new();\n    if content_type != \"\" {\n        h.push(\"content-type\");\n        h.push(content_type);\n    }\n    Response { status: status, body: body, has_body: has_body, headers: h }\n}\n\nfn __response_text(status: Int, body: String) -> Response {\n    __resp(status, body, true, \"text/plain; charset=utf-8\")\n}\n\nfn __response_json(status: Int, body: String) -> Response {\n    __resp(status, body, true, \"application/json\")\n}\n\nfn __response_empty(status: Int) -> Response {\n    __resp(status, \"\", false, \"\")\n}\n\nfn __response_no_content() -> Response {\n    __resp(204, \"\", false, \"\")\n}\n\nfn __response_not_found() -> Response {\n    __resp(404, \"not found\", true, \"text/plain; charset=utf-8\")\n}\n\nfn __response_bad_request(m: String) -> Response {\n    __resp(400, m, true, \"text/plain; charset=utf-8\")\n}\n\n// A copy of r with header k set to v (an existing header of the same name\n// keeps its position).\nfn __response_with_header(r: Response, k: String, v: String) -> Response {\n    let h = Vec::new();\n    let mut found = false;\n    let n = r.headers.len() / 2;\n    for i in 0..n {\n        let name = r.headers.get(i * 2).unwrap_or(\"\");\n        h.push(name);\n        if name == k {\n            h.push(v);\n            found = true;\n        } else {\n            h.push(r.headers.get(i * 2 + 1).unwrap_or(\"\"));\n        }\n    }\n    if !found {\n        h.push(k);\n        h.push(v);\n    }\n    Response { status: r.status, body: r.body, has_body: r.has_body, headers: h }\n}\n",
