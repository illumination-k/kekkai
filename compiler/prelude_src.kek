        v,
        "string.kek",
        "// Strings are immutable arrays of UTF-16 code units (`__Chars` is the same\n// array, used for building). Lengths and indices count code units.\n\n// ---- building ----\n\nstruct __Sb {\n    buf: __Chars,\n    n: Int,\n}\n\nfn __sb_new(cap: Int) -> __Sb {\n    __Sb { buf: __Chars::new(if cap < 8 { 8 } else { cap }), n: 0 }\n}\n\nfn __sb_reserve(b: __Sb, extra: Int) {\n    let need = b.n + extra;\n    let cap = b.buf.len();\n    if need <= cap {\n        return;\n    }\n    let mut c = cap * 2;\n    if c < need {\n        c = need;\n    }\n    let nb = __Chars::new(c);\n    nb.copy(0, b.buf, 0, b.n);\n    b.buf = nb;\n}\n\nfn __sb_char(b: __Sb, c: Int) {\n    __sb_reserve(b, 1);\n    b.buf.set(b.n, c);\n    b.n = b.n + 1;\n}\n\nfn __sb_str(b: __Sb, s: String) {\n    let x = __Chars::of(s);\n    let k = x.len();\n    __sb_reserve(b, k);\n    b.buf.copy(b.n, x, 0, k);\n    b.n = b.n + k;\n}\n\nfn __sb_ascii(b: __Sb, s: String) {\n    __sb_str(b, s)\n}\n\nfn __sb_finish(b: __Sb) -> String {\n    __chars_prefix(b.buf, b.n)\n}\n\n// __chars_prefix returns the first n code units of c as a new string.\nfn __chars_prefix(c: __Chars, n: Int) -> String {\n    if n == c.len() {\n        return c.freeze();\n    }\n    let r = __Chars::new(n);\n    r.copy(0, c, 0, n);\n    r.freeze()\n}\n\nfn __str_sub(s: String, a: Int, b: Int) -> String {\n    let x = __Chars::of(s);\n    let r = __Chars::new(b - a);\n    r.copy(0, x, a, b - a);\n    r.freeze()\n}\n\n// ---- operators ----\n\nfn __string_eq(a: String, b: String) -> Bool {\n    let x = __Chars::of(a);\n    let y = __Chars::of(b);\n    let n = x.len();\n    if n != y.len() {\n        return false;\n    }\n    let mut i = 0;\n    while i < n {\n        if x.get(i) != y.get(i) {\n            return false;\n        }\n        i = i + 1;\n    }\n    true\n}\n\nfn __string_concat(a: String, b: String) -> String {\n    let x = __Chars::of(a);\n    let y = __Chars::of(b);\n    let n = x.len();\n    let k = y.len();\n    if n == 0 {\n        return b;\n    }\n    if k == 0 {\n        return a;\n    }\n    let r = __Chars::new(n + k);\n    r.copy(0, x, 0, n);\n    r.copy(n, y, 0, k);\n    r.freeze()\n}\n\n// __str_less orders strings by UTF-16 code units.\nfn __str_less(a: String, b: String) -> Bool {\n    let x = __Chars::of(a);\n    let y = __Chars::of(b);\n    let n = x.len();\n    let k = y.len();\n    let mut i = 0;\n    while i < n && i < k {\n        let p = x.get(i);\n        let q = y.get(i);\n        if p != q {\n            return p < q;\n        }\n        i = i + 1;\n    }\n    n < k\n}\n\n// ---- Int and Bool ----\n\nfn __int_min_value() -> Int {\n    0 - 9223372036854775807 - 1\n}\n\nfn __int_to_string(x: Int) -> String {\n    if x == 0 {\n        return \"0\";\n    }\n    // digits of a non-positive number (so that MIN works)\n    let mut v = if x < 0 { x } else { 0 - x };\n    let tmp = __Chars::new(20);\n    let mut i = 20;\n    while v != 0 {\n        i = i - 1;\n        tmp.set(i, 48 - v % 10);\n        v = v / 10;\n    }\n    let neg = if x < 0 { 1 } else { 0 };\n    let r = __Chars::new(20 - i + neg);\n    if neg == 1 {\n        r.set(0, 45);\n    }\n    r.copy(neg, tmp, i, 20 - i);\n    r.freeze()\n}\n\nfn __int_abs(x: Int) -> Int {\n    if x < 0 { 0 - x } else { x }\n}\n\nfn __int_min(a: Int, b: Int) -> Int {\n    if a < b { a } else { b }\n}\n\nfn __int_max(a: Int, b: Int) -> Int {\n    if a > b { a } else { b }\n}\n\nfn __bool_to_string(b: Bool) -> String {\n    if b { \"true\" } else { \"false\" }\n}\n\n// ---- String ----\n\nfn __string_len(s: String) -> Int {\n    __Chars::of(s).len()\n}\n\n// `^[+-]?[0-9]+$` within the range of Int, else None.\nfn __string_parse_int(s: String) -> Option<Int> {\n    let x = __Chars::of(s);\n    let n = x.len();\n    let mut i = 0;\n    let mut neg = false;\n    if n > 0 && (x.get(0) == 45 || x.get(0) == 43) {\n        neg = x.get(0) == 45;\n        i = 1;\n    }\n    if i >= n {\n        return None;\n    }\n    let min = __int_min_value();\n    // accumulate negatively: |MIN| > MAX\n    let mut acc = 0;\n    while i < n {\n        let c = x.get(i);\n        if c < 48 || c > 57 {\n            return None;\n        }\n        let d = c - 48;\n        if acc < min / 10 {\n            return None;\n        }\n        acc = acc * 10;\n        if acc < min + d {\n            return None;\n        }\n        acc = acc - d;\n        i = i + 1;\n    }\n    if neg {\n        return Some(acc);\n    }\n    if acc == min {\n        return None;\n    }\n    Some(0 - acc)\n}\n\nfn __str_index_from(x: __Chars, y: __Chars, from: Int) -> Int {\n    let n = x.len();\n    let k = y.len();\n    let mut i = from;\n    while i + k <= n {\n        let mut j = 0;\n        while j < k && x.get(i + j) == y.get(j) {\n            j = j + 1;\n        }\n        if j == k {\n            return i;\n        }\n        i = i + 1;\n    }\n    -1\n}\n\nfn __string_contains(s: String, t: String) -> Bool {\n    __str_index_from(__Chars::of(s), __Chars::of(t), 0) >= 0\n}\n\nfn __string_index_of(s: String, t: String) -> Option<Int> {\n    let i = __str_index_from(__Chars::of(s), __Chars::of(t), 0);\n    if i < 0 { None } else { Some(i) }\n}\n\nfn __string_starts_with(s: String, t: String) -> Bool {\n    let x = __Chars::of(s);\n    let y = __Chars::of(t);\n    let k = y.len();\n    if k > x.len() {\n        return false;\n    }\n    let mut i = 0;\n    while i < k {\n        if x.get(i) != y.get(i) {\n            return false;\n        }\n        i = i + 1;\n    }\n    true\n}\n\nfn __string_ends_with(s: String, t: String) -> Bool {\n    let x = __Chars::of(s);\n    let y = __Chars::of(t);\n    let k = y.len();\n    let off = x.len() - k;\n    if off < 0 {\n        return false;\n    }\n    let mut i = 0;\n    while i < k {\n        if x.get(off + i) != y.get(i) {\n            return false;\n        }\n        i = i + 1;\n    }\n    true\n}\n\n// JavaScript WhiteSpace and LineTerminator.\nfn __is_space(c: Int) -> Bool {\n    (c >= 9 && c <= 13)\n        || c == 32\n        || c == 160\n        || c == 5760\n        || (c >= 8192 && c <= 8202)\n        || c == 8232\n        || c == 8233\n        || c == 8239\n        || c == 8287\n        || c == 12288\n        || c == 65279\n}\n\nfn __string_trim(s: String) -> String {\n    let x = __Chars::of(s);\n    let mut a = 0;\n    let mut b = x.len();\n    while a < b && __is_space(x.get(a)) {\n        a = a + 1;\n    }\n    while b > a && __is_space(x.get(b - 1)) {\n        b = b - 1;\n    }\n    if a == 0 && b == x.len() {\n        return s;\n    }\n    __str_sub(s, a, b)\n}\n\n// ASCII-only case mapping.\nfn __str_map_case(s: String, lo: Int, hi: Int, delta: Int) -> String {\n    let x = __Chars::of(s);\n    let n = x.len();\n    let r = __Chars::new(n);\n    let mut i = 0;\n    while i < n {\n        let c = x.get(i);\n        if c >= lo && c <= hi {\n            r.set(i, c + delta);\n        } else {\n            r.set(i, c);\n        }\n        i = i + 1;\n    }\n    r.freeze()\n}\n\nfn __string_to_upper(s: String) -> String {\n    __str_map_case(s, 97, 122, -32)\n}\n\nfn __string_to_lower(s: String) -> String {\n    __str_map_case(s, 65, 90, 32)\n}\n\nfn __string_char_at(s: String, i: Int) -> Option<Int> {\n    let x = __Chars::of(s);\n    if i >= 0 && i < x.len() {\n        Some(x.get(i))\n    } else {\n        None\n    }\n}\n\n// Indices are clamped to [0, len].\nfn __string_slice(s: String, a: Int, b: Int) -> String {\n    let n = __Chars::of(s).len();\n    let lo = if a < 0 {\n        0\n    } else if a > n { n } else { a };\n    let hi = if b < 0 {\n        0\n    } else if b > n { n } else { b };\n    if hi <= lo {\n        return \"\";\n    }\n    if lo == 0 && hi == n {\n        return s;\n    }\n    __str_sub(s, lo, hi)\n}\n\nfn __is_high(c: Int) -> Bool {\n    c >= 55296 && c < 56320\n}\n\nfn __is_low(c: Int) -> Bool {\n    c >= 56320 && c < 57344\n}\n\n// An empty separator splits into code points.\nfn __string_split(s: String, sep: String) -> Vec<String> {\n    let out = Vec::new();\n    let x = __Chars::of(s);\n    let y = __Chars::of(sep);\n    let n = x.len();\n    let k = y.len();\n    if k == 0 {\n        let mut i = 0;\n        while i < n {\n            let mut w = 1;\n            if __is_high(x.get(i)) && i + 1 < n && __is_low(x.get(i + 1)) {\n                w = 2;\n            }\n            out.push(__str_sub(s, i, i + w));\n            i = i + w;\n        }\n        return out;\n    }\n    let mut start = 0;\n    while true {\n        let j = __str_index_from(x, y, start);\n        if j < 0 {\n            break;\n        }\n        out.push(__str_sub(s, start, j));\n        start = j + k;\n    }\n    out.push(__str_sub(s, start, n));\n    out\n}\n\nfn __string_replace(s: String, a: String, b: String) -> String {\n    if __Chars::of(a).len() == 0 {\n        return s;\n    }\n    __string_split(s, a).join(b)\n}\n\nfn __string_from_char(c: Int) -> String {\n    let r = __Chars::new(1);\n    r.set(0, c.bit_and(65535));\n    r.freeze()\n}\n\n// ---- UTF-8 ----\n\n// __utf8_each calls the encoder on every code point of s: lone surrogates\n// become U+FFFD.\nfn __code_point_at(x: __Chars, i: Int, n: Int) -> Int {\n    let c = x.get(i);\n    if __is_high(c) && i + 1 < n && __is_low(x.get(i + 1)) {\n        return 65536 + (c - 55296) * 1024 + (x.get(i + 1) - 56320);\n    }\n    if __is_high(c) || __is_low(c) {\n        return 65533;\n    }\n    c\n}\n\nfn __utf8_len(cp: Int) -> Int {\n    if cp < 128 {\n        1\n    } else if cp < 2048 {\n        2\n    } else if cp < 65536 { 3 } else { 4 }\n}\n\nfn __string_to_bytes(s: String) -> Vec<Int> {\n    let out = Vec::new();\n    let x = __Chars::of(s);\n    let n = x.len();\n    let mut i = 0;\n    while i < n {\n        let cp = __code_point_at(x, i, n);\n        i = i + if cp >= 65536 { 2 } else { 1 };\n        if cp < 128 {\n            out.push(cp);\n        } else if cp < 2048 {\n            out.push(192 + cp.shr(6));\n            out.push(128 + cp.bit_and(63));\n        } else if cp < 65536 {\n            out.push(224 + cp.shr(12));\n            out.push(128 + cp.shr(6).bit_and(63));\n            out.push(128 + cp.bit_and(63));\n        } else {\n            out.push(240 + cp.shr(18));\n            out.push(128 + cp.shr(12).bit_and(63));\n            out.push(128 + cp.shr(6).bit_and(63));\n            out.push(128 + cp.bit_and(63));\n        }\n    }\n    out\n}\n\n// __Utf8Dec is the WHATWG UTF-8 decoder: invalid sequences become U+FFFD\n// (maximal subparts).\nstruct __Utf8Dec {\n    sb: __Sb,\n    needed: Int,\n    seen: Int,\n    cp: Int,\n    lower: Int,\n    upper: Int,\n}\n\nfn __utf8_dec_new(cap: Int) -> __Utf8Dec {\n    __Utf8Dec { sb: __sb_new(cap), needed: 0, seen: 0, cp: 0, lower: 128, upper: 191 }\n}\n\nfn __utf8_emit(d: __Utf8Dec, cp: Int) {\n    if cp >= 65536 {\n        let w = cp - 65536;\n        __sb_char(d.sb, 55296 + w.shr(10));\n        __sb_char(d.sb, 56320 + w.bit_and(1023));\n    } else {\n        __sb_char(d.sb, cp);\n    }\n}\n\nfn __utf8_byte(d: __Utf8Dec, b: Int) {\n    if d.needed == 0 {\n        if b <= 127 {\n            __sb_char(d.sb, b);\n        } else if b >= 194 && b <= 223 {\n            d.needed = 1;\n            d.cp = b.bit_and(31);\n        } else if b >= 224 && b <= 239 {\n            d.needed = 2;\n            d.cp = b.bit_and(15);\n            if b == 224 {\n                d.lower = 160;\n            }\n            if b == 237 {\n                d.upper = 159;\n            }\n        } else if b >= 240 && b <= 244 {\n            d.needed = 3;\n            d.cp = b.bit_and(7);\n            if b == 240 {\n                d.lower = 144;\n            }\n            if b == 244 {\n                d.upper = 143;\n            }\n        } else {\n            __sb_char(d.sb, 65533);\n        }\n        return;\n    }\n    if b < d.lower || b > d.upper {\n        d.needed = 0;\n        d.seen = 0;\n        d.cp = 0;\n        d.lower = 128;\n        d.upper = 191;\n        __sb_char(d.sb, 65533);\n        // reprocess this byte from the initial state\n        __utf8_byte(d, b);\n        return;\n    }\n    d.lower = 128;\n    d.upper = 191;\n    d.cp = d.cp * 64 + b.bit_and(63);\n    d.seen = d.seen + 1;\n    if d.seen == d.needed {\n        __utf8_emit(d, d.cp);\n        d.needed = 0;\n        d.seen = 0;\n        d.cp = 0;\n    }\n}\n\nfn __utf8_dec_finish(d: __Utf8Dec) -> String {\n    if d.needed != 0 {\n        __sb_char(d.sb, 65533);\n    }\n    __sb_finish(d.sb)\n}\n\nfn __string_from_bytes(v: Vec<Int>) -> String {\n    let d = __utf8_dec_new(v.len());\n    let n = v.len();\n    let mut i = 0;\n    // a leading byte order mark is removed\n    if n >= 3\n        && v.get(0).unwrap_or(0).bit_and(255) == 239\n        && v.get(1).unwrap_or(0).bit_and(255) == 187\n        && v.get(2).unwrap_or(0).bit_and(255) == 191 {\n        i = 3;\n    }\n    while i < n {\n        __utf8_byte(d, v.get(i).unwrap_or(0).bit_and(255));\n        i = i + 1;\n    }\n    __utf8_dec_finish(d)\n}\n\n// ---- JSON strings ----\n\nfn __hex_digit(d: Int) -> String {\n    \"0123456789abcdef\".slice(d, d + 1)\n}\n\n// __json_quote is JSON.stringify for strings.\nfn __json_quote(s: String) -> String {\n    let b = __sb_new(__string_len(s) + 2);\n    __sb_char(b, 34);\n    let x = __Chars::of(s);\n    let n = x.len();\n    let mut i = 0;\n    while i < n {\n        let c = x.get(i);\n        if c == 34 {\n            __sb_str(b, \"\\\\\\\"\");\n        } else if c == 92 {\n            __sb_str(b, \"\\\\\\\\\");\n        } else if c == 10 {\n            __sb_str(b, \"\\\\n\");\n        } else if c == 13 {\n            __sb_str(b, \"\\\\r\");\n        } else if c == 9 {\n            __sb_str(b, \"\\\\t\");\n        } else if c == 8 {\n            __sb_str(b, \"\\\\b\");\n        } else if c == 12 {\n            __sb_str(b, \"\\\\f\");\n        } else if c < 32\n            || (__is_high(c) && !(i + 1 < n && __is_low(x.get(i + 1))))\n            || (__is_low(c) && !(i > 0 && __is_high(x.get(i - 1)))) {\n            __sb_str(\n                b,\n                \"\\\\u\"\n                    + __hex_digit(c.shr(12).bit_and(15))\n                    + __hex_digit(c.shr(8).bit_and(15))\n                    + __hex_digit(c.shr(4).bit_and(15))\n                    + __hex_digit(c.bit_and(15)),\n            );\n        } else {\n            __sb_char(b, c);\n        }\n        i = i + 1;\n    }\n    __sb_char(b, 34);\n    __sb_finish(b)\n}\n",
    );
    prelude_file(
        v,
        "test.kek",
        "// `kek test`: mock capabilities and result reporting.\n//\n// The test program's #[main] (synthesized by `kek test`) runs one test,\n// named by its first argument, in a fresh process. The mocks are\n// configured through the environment:\n//   KEK_TEST=1            enable the mocks\n//   KEK_TEST_CLOCK=ms     fixed time of &Clock\n//   KEK_TEST_SEED=n       seed of &Random (mixed with the test name)\n//   KEK_TEST_NET=file     canned &Net responses: {\"GET url\": \"body\", \"POST url\": {\"error\": \"msg\"}}\n//   KEK_TEST_DB=file      initial contents of &Db: {\"key\": \"value\"}\n\nfn __test_setup(rt: __Rt, env: Vec<String>) {\n    rt.clock_ms = __env_lookup(env, \"KEK_TEST_CLOCK\").parse_int().unwrap_or(0);\n    rt.rand = __env_lookup(env, \"KEK_TEST_SEED\").parse_int().unwrap_or(0);\n}\n\n// FNV-1a over the UTF-8 bytes\nfn __fnv64(s: String) -> Int {\n    let mut h = -3750763034362895579;\n    for b in s.to_bytes() {\n        h = h.bit_xor(b) * 1099511628211;\n    }\n    h\n}\n\n// __test_begin loads the mocks for test `name` and starts its clock. It\n// returns false (after reporting) when a mock file is invalid.\nfn __test_begin(name: String) -> Bool {\n    let rt = __Rt::get();\n    let env = __env_all(rt);\n    rt.test_name = name;\n    rt.rand = rt.rand.bit_xor(__fnv64(name));\n    let netf = __env_lookup(env, \"KEK_TEST_NET\");\n    if netf != \"\" {\n        match __fs_read(__Any::null(), netf) {\n            Ok(text) => {\n                let p = __json_new(text);\n                if !__json_object(p, rt, netf, false) {\n                    __eprint(netf + \": \" + p.err);\n                    return false;\n                }\n            }\n            Err(e) => {\n                __eprint(\"open \" + netf + \": no such file or directory\");\n                return false;\n            }\n        }\n    }\n    let dbf = __env_lookup(env, \"KEK_TEST_DB\");\n    if dbf != \"\" {\n        match __fs_read(__Any::null(), dbf) {\n            Ok(text) => {\n                let p = __json_new(text);\n                if !__json_object(p, rt, dbf, true) {\n                    __eprint(dbf + \": \" + p.err);\n                    return false;\n                }\n            }\n            Err(e) => {\n                __eprint(\"open \" + dbf + \": no such file or directory\");\n                return false;\n            }\n        }\n    }\n    rt.start_ns = __now_ns(1);\n    true\n}\n\nfn __test_elapsed() -> String {\n    let rt = __Rt::get();\n    let tenths = (__now_ns(1) - rt.start_ns) / 100000;\n    (tenths / 10).to_string() + \".\" + (tenths % 10).to_string() + \"ms\"\n}\n\nfn __test_ok(name: String, kind: String) -> Int {\n    __print(\"test \" + name + \" ... ok (\" + kind + \"; \" + __test_elapsed() + \")\");\n    0\n}\n\nfn __test_failed(name: String, kind: String, why: String) -> Int {\n    let rt = __Rt::get();\n    __print(\"test \" + name + \" ... FAILED (\" + kind + \"; \" + __test_elapsed() + \")\");\n    __print(\"    \" + why);\n    for l in rt.lines {\n        __print(\"    \" + l);\n    }\n    for s in rt.sent {\n        __print(\"    outbox: \" + s);\n    }\n    1\n}\n\nfn __test_false(name: String, kind: String) -> Int {\n    __test_failed(name, kind, \"returned false\")\n}\n\nfn __test_err(name: String, kind: String, msg: String) -> Int {\n    __test_failed(name, kind, \"Err: \" + msg)\n}\n\n// ---- a small JSON reader for the mock files ----\n\nstruct __Json {\n    s: String,\n    i: Int,\n    err: String,\n}\n\nfn __json_new(s: String) -> __Json {\n    __Json { s: s, i: 0, err: \"\" }\n}\n\nfn __json_peek(p: __Json) -> Int {\n    p.s.char_at(p.i).unwrap_or(-1)\n}\n\nfn __json_ws(p: __Json) {\n    while true {\n        let c = __json_peek(p);\n        if c == 32 || c == 9 || c == 10 || c == 13 {\n            p.i = p.i + 1;\n        } else {\n            return;\n        }\n    }\n}\n\nfn __json_fail(p: __Json, m: String) -> Bool {\n    if p.err == \"\" {\n        p.err = m;\n    }\n    false\n}\n\nfn __json_hex(c: Int) -> Int {\n    if c >= 48 && c <= 57 {\n        c - 48\n    } else if c >= 97 && c <= 102 {\n        c - 87\n    } else if c >= 65 && c <= 70 { c - 55 } else { -1 }\n}\n\n// __json_string reads a string literal (the opening quote is current).\nfn __json_string(p: __Json) -> Option<String> {\n    p.i = p.i + 1;\n    let b = __sb_new(16);\n    while true {\n        let c = __json_peek(p);\n        if c < 0 {\n            __json_fail(p, \"unterminated string in JSON\");\n            return None;\n        }\n        p.i = p.i + 1;\n        if c == 34 {\n            return Some(__sb_finish(b));\n        }\n        if c != 92 {\n            __sb_char(b, c);\n            continue;\n        }\n        let e = __json_peek(p);\n        p.i = p.i + 1;\n        if e == 110 {\n            __sb_char(b, 10);\n        } else if e == 116 {\n            __sb_char(b, 9);\n        } else if e == 114 {\n            __sb_char(b, 13);\n        } else if e == 98 {\n            __sb_char(b, 8);\n        } else if e == 102 {\n            __sb_char(b, 12);\n        } else if e == 117 {\n            let mut v = 0;\n            for k in 0..4 {\n                let h = __json_hex(__json_peek(p));\n                if h < 0 {\n                    __json_fail(p, \"bad escape in JSON string\");\n                    return None;\n                }\n                v = v * 16 + h;\n                p.i = p.i + 1;\n            }\n            __sb_char(b, v);\n        } else if e == 34 || e == 92 || e == 47 {\n            __sb_char(b, e);\n        } else {\n            __json_fail(p, \"bad escape in JSON string\");\n            return None;\n        }\n    }\n    None\n}\n\n// __json_scalar reads a number, true, false or null as its source text.\nfn __json_scalar(p: __Json) -> Option<String> {\n    let start = p.i;\n    while true {\n        let c = __json_peek(p);\n        if c < 0 || c == 44 || c == 125 || c == 93 || c == 32 || c == 10 || c == 13 || c == 9 {\n            break;\n        }\n        p.i = p.i + 1;\n    }\n    if p.i == start {\n        __json_fail(p, \"unexpected character in JSON\");\n        return None;\n    }\n    Some(p.s.slice(start, p.i))\n}\n\n// __json_error_obj reads `{\"error\": \"msg\"}` (other members are ignored)\n// and returns the message, or \"\" when there is none.\nfn __json_error_obj(p: __Json) -> Option<String> {\n    p.i = p.i + 1;\n    let mut msg = \"\";\n    __json_ws(p);\n    if __json_peek(p) == 125 {\n        p.i = p.i + 1;\n        return Some(msg);\n    }\n    while true {\n        __json_ws(p);\n        if __json_peek(p) != 34 {\n            __json_fail(p, \"expected a string key in JSON\");\n            return None;\n        }\n        let k = __json_string(p)?;\n        __json_ws(p);\n        if __json_peek(p) != 58 {\n            __json_fail(p, \"expected ':' in JSON\");\n            return None;\n        }\n        p.i = p.i + 1;\n        __json_ws(p);\n        let v = if __json_peek(p) == 34 {\n            __json_string(p)?\n        } else {\n            __json_scalar(p)?\n        };\n        if k == \"error\" {\n            msg = v;\n        }\n        __json_ws(p);\n        let c = __json_peek(p);\n        p.i = p.i + 1;\n        if c == 125 {\n            return Some(msg);\n        }\n        if c != 44 {\n            __json_fail(p, \"expected ',' or '}' in JSON\");\n            return None;\n        }\n    }\n    None\n}\n\n// __json_object reads the top-level object of a mock file into rt (the\n// &Db store when db is set, else the canned &Net responses).\nfn __json_object(p: __Json, rt: __Rt, file: String, db: Bool) -> Bool {\n    __json_ws(p);\n    if __json_peek(p) != 123 {\n        return __json_fail(p, if db {\n            \"expected a JSON object of strings\"\n        } else {\n            \"expected a JSON object\"\n        });\n    }\n    p.i = p.i + 1;\n    __json_ws(p);\n    if __json_peek(p) == 125 {\n        return true;\n    }\n    while true {\n        __json_ws(p);\n        if __json_peek(p) != 34 {\n            return __json_fail(p, \"expected a string key in JSON\");\n        }\n        let k = match __json_string(p) {\n            Some(x) => x,\n            None => {\n                return false;\n            }\n        };\n        __json_ws(p);\n        if __json_peek(p) != 58 {\n            return __json_fail(p, \"expected ':' in JSON\");\n        }\n        p.i = p.i + 1;\n        __json_ws(p);\n        let c = __json_peek(p);\n        if c == 34 {\n            match __json_string(p) {\n                Some(v) => {\n                    if db {\n                        __store_put(rt.store, k, v);\n                    } else {\n                        rt.net.insert(k, v);\n                    }\n                }\n                None => {\n                    return false;\n                }\n            }\n        } else if db {\n            return __json_fail(p, \"expected a JSON object of strings\");\n        } else if c == 123 {\n            match __json_error_obj(p) {\n                Some(m) => {\n                    rt.net_err.insert(k, m);\n                }\n                None => {\n                    return false;\n                }\n            }\n        } else {\n            match __json_scalar(p) {\n                Some(v) => {\n                    rt.net.insert(k, v);\n                }\n                None => {\n                    return false;\n                }\n            }\n        }\n        __json_ws(p);\n        let d = __json_peek(p);\n        p.i = p.i + 1;\n        if d == 125 {\n            return true;\n        }\n        if d != 44 {\n            return __json_fail(p, \"expected ',' or '}' in JSON\");\n        }\n    }\n    false\n}\n",
    );
    prelude_file(
        v,
        "types.kek",
        "// Runtime prelude: compiled together with every program by `kek build`.\n//\n// The prelude implements the builtin operations in Kekkai itself, on top\n// of a few intrinsics that the code generator emits inline (`__Chars`,\n// `__Mem`, `__Wasi`, `__Any`, `__Int`). A builtin operation `recv.name`\n// (for example `string.split`) is implemented by the function\n// `__recv_name`, whose parameters are the receiver and the arguments.\n//\n// Identifiers starting with `__` are reserved: user programs cannot name\n// anything defined here.\n\n// ---- builtin types implemented as structs ----\n\nstruct Response {\n    status: Int,\n    body: String,\n    has_body: Bool,\n    // header names and values, alternating\n    headers: Vec<String>,\n}\n\nstruct TxError {\n    message: String,\n    retryable: Bool,\n}\n\nstruct NetError {\n    message: String,\n}\n\nstruct IoError {\n    message: String,\n}\n\n// ---- boxes for Map values ----\n\nstruct __BoxInt {\n    v: Int,\n}\n\n// ---- runtime state ----\n\n// __Rt is created by `__rt_new` the first time `__Rt::get()` runs.\nstruct __Rt {\n    // capabilities are mocks (`kek test`)\n    test: Bool,\n    // linear memory scratch area: [base, brk)\n    base: Int,\n    brk: Int,\n    cwd: String,\n    store: __Store,\n    // test mode\n    test_name: String,\n    clock_ms: Int,\n    rand: Int,\n    net: Map<String, String>,\n    net_err: Map<String, String>,\n    lines: Vec<String>,\n    sent: Vec<String>,\n    start_ns: Int,\n}\n",
    );
    prelude_file(
        v,
        "wasi.kek",
        "// Command-line programs run on WASI (preview 1). The host preopens the\n// file system root as \"/\"; relative paths are resolved against $PWD.\n\n// ---- linear memory scratch area ----\n\nfn __mem_reset(rt: __Rt) {\n    rt.brk = rt.base;\n}\n\nfn __mem_ensure(end: Int) {\n    let pages = (end + 65535) / 65536;\n    let have = __Mem::size();\n    if pages > have {\n        __Mem::grow(pages - have);\n    }\n}\n\n// __mem_alloc reserves n bytes (8-aligned) of scratch memory.\nfn __mem_alloc(rt: __Rt, n: Int) -> Int {\n    let a = (rt.brk + 7).bit_and(-8);\n    rt.brk = a + n;\n    __mem_ensure(rt.brk);\n    a\n}\n\n// __mem_put_utf8 writes s as UTF-8 at scratch memory and returns the\n// address; the length is stored at the returned address - 8.\nfn __mem_utf8(rt: __Rt, s: String) -> Int {\n    let x = __Chars::of(s);\n    let n = x.len();\n    let a = __mem_alloc(rt, 8 + n * 3);\n    let mut p = a + 8;\n    let mut i = 0;\n    while i < n {\n        let c = x.get(i);\n        if c < 128 {\n            __Mem::store8(p, c);\n            p = p + 1;\n            i = i + 1;\n        } else {\n            let cp = __code_point_at(x, i, n);\n            i = i + if cp >= 65536 { 2 } else { 1 };\n            if cp < 2048 {\n                __Mem::store8(p, 192 + cp.shr(6));\n                __Mem::store8(p + 1, 128 + cp.bit_and(63));\n                p = p + 2;\n            } else if cp < 65536 {\n                __Mem::store8(p, 224 + cp.shr(12));\n                __Mem::store8(p + 1, 128 + cp.shr(6).bit_and(63));\n                __Mem::store8(p + 2, 128 + cp.bit_and(63));\n                p = p + 3;\n            } else {\n                __Mem::store8(p, 240 + cp.shr(18));\n                __Mem::store8(p + 1, 128 + cp.shr(12).bit_and(63));\n                __Mem::store8(p + 2, 128 + cp.shr(6).bit_and(63));\n                __Mem::store8(p + 3, 128 + cp.bit_and(63));\n                p = p + 4;\n            }\n        }\n    }\n    __Mem::store64(a, p - a - 8);\n    a + 8\n}\n\nfn __mem_len(a: Int) -> Int {\n    __Mem::load64(a - 8)\n}\n\n// __mem_string decodes n bytes of UTF-8 at address a (a byte order mark\n// is kept).\nfn __mem_string(a: Int, n: Int) -> String {\n    let d = __utf8_dec_new(n);\n    let mut i = 0;\n    while i < n {\n        let b = __Mem::load8(a + i);\n        if b < 128 && d.needed == 0 {\n            __sb_char(d.sb, b);\n        } else {\n            __utf8_byte(d, b);\n        }\n        i = i + 1;\n    }\n    __utf8_dec_finish(d)\n}\n\n// ---- output ----\n\nfn __write_fd(fd: Int, s: String) {\n    let rt = __Rt::get();\n    __mem_reset(rt);\n    let p = __mem_utf8(rt, s);\n    let n = __mem_len(p);\n    let iov = __mem_alloc(rt, 16);\n    let out = __mem_alloc(rt, 8);\n    let mut off = 0;\n    while off < n {\n        __Mem::store32(iov, p + off);\n        __Mem::store32(iov + 4, n - off);\n        let e = __Wasi::fd_write(fd, iov, 1, out);\n        if e != 0 {\n            return;\n        }\n        let w = __Mem::load32(out);\n        if w <= 0 {\n            return;\n        }\n        off = off + w;\n    }\n}\n\nfn __print(s: String) {\n    __write_fd(1, s + \"\\n\");\n}\n\nfn __eprint(s: String) {\n    __write_fd(2, s + \"\\n\");\n}\n\nfn __exit(code: Int) {\n    __Wasi::proc_exit(code);\n}\n\n// ---- arguments and environment ----\n\nfn __read_strings(rt: __Rt, count: Int, ptrs: Int, end: Int) -> Vec<String> {\n    let out = Vec::new();\n    for i in 0..count {\n        let p = __Mem::load32(ptrs + i * 4);\n        let mut q = p;\n        while q < end && __Mem::load8(q) != 0 {\n            q = q + 1;\n        }\n        out.push(__mem_string(p, q - p));\n    }\n    out\n}\n\n// __args returns the command-line arguments without the program name.\nfn __args() -> Vec<String> {\n    let rt = __Rt::get();\n    __mem_reset(rt);\n    let sz = __mem_alloc(rt, 16);\n    __Wasi::args_sizes_get(sz, sz + 4);\n    let argc = __Mem::load32(sz);\n    let bytes = __Mem::load32(sz + 4);\n    let ptrs = __mem_alloc(rt, argc * 4 + 4);\n    let buf = __mem_alloc(rt, bytes + 1);\n    __Wasi::args_get(ptrs, buf);\n    let all = __read_strings(rt, argc, ptrs, buf + bytes);\n    let out = Vec::new();\n    for i in 1..all.len() {\n        out.push(all.get(i).unwrap_or(\"\"));\n    }\n    out\n}\n\nfn __env_all(rt: __Rt) -> Vec<String> {\n    __mem_reset(rt);\n    let sz = __mem_alloc(rt, 16);\n    __Wasi::environ_sizes_get(sz, sz + 4);\n    let n = __Mem::load32(sz);\n    let bytes = __Mem::load32(sz + 4);\n    let ptrs = __mem_alloc(rt, n * 4 + 4);\n    let buf = __mem_alloc(rt, bytes + 1);\n    __Wasi::environ_get(ptrs, buf);\n    __read_strings(rt, n, ptrs, buf + bytes)\n}\n\nfn __env_lookup(env: Vec<String>, name: String) -> String {\n    let pre = name + \"=\";\n    for kv in env {\n        if kv.starts_with(pre) {\n            return kv.slice(pre.len(), kv.len());\n        }\n    }\n    \"\"\n}\n\n// ---- clock and randomness ----\n\nfn __now_ns(clock: Int) -> Int {\n    let rt = __Rt::get();\n    __mem_reset(rt);\n    let out = __mem_alloc(rt, 8);\n    if __Wasi::clock_time_get(clock, 1000, out) != 0 {\n        return 0;\n    }\n    __Mem::load64(out)\n}\n\nfn __random_u64() -> Int {\n    let rt = __Rt::get();\n    __mem_reset(rt);\n    let out = __mem_alloc(rt, 8);\n    __Wasi::random_get(out, 8);\n    __Mem::load64(out)\n}\n\n// ---- paths ----\n\n// __path_abs makes p absolute (against cwd) and normalizes `.` and `..`.\nfn __path_abs(cwd: String, p: String) -> String {\n    let full = if p.starts_with(\"/\") { p } else { cwd + \"/\" + p };\n    let parts = Vec::new();\n    for seg in full.split(\"/\") {\n        if seg == \"\" || seg == \".\" {\n            continue;\n        }\n        if seg == \"..\" {\n            parts.pop();\n        } else {\n            parts.push(seg);\n        }\n    }\n    parts.join(\"/\")\n}\n\nfn __errno_text(e: Int) -> String {\n    match e {\n        2 => \"EACCES: permission denied\",\n        8 => \"EBADF: bad file descriptor\",\n        20 => \"EEXIST: file already exists\",\n        28 => \"EINVAL: invalid argument\",\n        29 => \"EIO: i/o error\",\n        31 => \"EISDIR: illegal operation on a directory\",\n        44 => \"ENOENT: no such file or directory\",\n        51 => \"ENOSPC: no space left on device\",\n        54 => \"ENOTDIR: not a directory\",\n        55 => \"ENOTEMPTY: directory not empty\",\n        63 => \"EPERM: operation not permitted\",\n        76 => \"ENOTCAPABLE: file system access is not permitted\",\n        _ => \"error \" + e.to_string(),\n    }\n}\n\nfn __io_err(e: Int, op: String, path: String) -> IoError {\n    IoError { message: __errno_text(e) + \", \" + op + \" '\" + path + \"'\" }\n}\n\n// the root preopen\nfn __root_fd() -> Int {\n    3\n}\n\n// __open opens path (relative to the root preopen) with the given rights\n// and returns the fd, or -errno.\nfn __open(rt: __Rt, path: String, oflags: Int, rights: Int) -> Int {\n    let rel = __path_abs(rt.cwd, path);\n    let rp = __mem_utf8(rt, if rel == \"\" { \".\" } else { rel });\n    let out = __mem_alloc(rt, 8);\n    let e = __Wasi::path_open(__root_fd(), 1, rp, __mem_len(rp), oflags, rights, rights, 0, out);\n    if e != 0 {\n        return 0 - e;\n    }\n    __Mem::load32(out)\n}\n\n// ---- &Fs ----\n\nfn __fs_read(fs: __Any, path: String) -> Result<String, IoError> {\n    let rt = __Rt::get();\n    __mem_reset(rt);\n    // fd_read | fd_seek\n    let fd = __open(rt, path, 0, 6);\n    if fd < 0 {\n        return Err(__io_err(0 - fd, \"open\", path));\n    }\n    let iov = __mem_alloc(rt, 16);\n    let nread = __mem_alloc(rt, 8);\n    let mut cap = 65536;\n    let mut buf = __mem_alloc(rt, cap);\n    let mut len = 0;\n    while true {\n        if len == cap {\n            // move to a buffer twice as large at the end of the scratch area\n            let nb = __mem_alloc(rt, cap * 2);\n            for i in 0..len {\n                __Mem::store8(nb + i, __Mem::load8(buf + i));\n            }\n            buf = nb;\n            cap = cap * 2;\n        }\n        __Mem::store32(iov, buf + len);\n        __Mem::store32(iov + 4, cap - len);\n        let e = __Wasi::fd_read(fd, iov, 1, nread);\n        if e != 0 {\n            __Wasi::fd_close(fd);\n            return Err(__io_err(e, \"read\", path));\n        }\n        let k = __Mem::load32(nread);\n        if k == 0 {\n            break;\n        }\n        len = len + k;\n    }\n    __Wasi::fd_close(fd);\n    Ok(__mem_string(buf, len))\n}\n\nfn __write_all(rt: __Rt, fd: Int, p: Int, n: Int) -> Int {\n    let iov = __mem_alloc(rt, 16);\n    let out = __mem_alloc(rt, 8);\n    let mut off = 0;\n    while off < n {\n        __Mem::store32(iov, p + off);\n        __Mem::store32(iov + 4, n - off);\n        let e = __Wasi::fd_write(fd, iov, 1, out);\n        if e != 0 {\n            return e;\n        }\n        off = off + __Mem::load32(out);\n    }\n    0\n}\n\nfn __fs_write_mem(rt: __Rt, path: String, p: Int, n: Int) -> Result<(), IoError> {\n    // O_CREAT | O_TRUNC, fd_write\n    let fd = __open(rt, path, 9, 64);\n    if fd < 0 {\n        return Err(__io_err(0 - fd, \"open\", path));\n    }\n    let e = __write_all(rt, fd, p, n);\n    __Wasi::fd_close(fd);\n    if e != 0 {\n        return Err(__io_err(e, \"write\", path));\n    }\n    Ok(())\n}\n\nfn __fs_write(fs: __Any, path: String, content: String) -> Result<(), IoError> {\n    let rt = __Rt::get();\n    __mem_reset(rt);\n    let p = __mem_utf8(rt, content);\n    __fs_write_mem(rt, path, p, __mem_len(p))\n}\n\nfn __fs_write_bytes(fs: __Any, path: String, bytes: Vec<Int>) -> Result<(), IoError> {\n    let rt = __Rt::get();\n    __mem_reset(rt);\n    let n = bytes.len();\n    let p = __mem_alloc(rt, n);\n    for i in 0..n {\n        __Mem::store8(p + i, bytes.get(i).unwrap_or(0));\n    }\n    __fs_write_mem(rt, path, p, n)\n}\n\n// Entry names of a directory (without \".\" and \"..\"), sorted.\nfn __fs_list(fs: __Any, path: String) -> Result<Vec<String>, IoError> {\n    let rt = __Rt::get();\n    __mem_reset(rt);\n    // O_DIRECTORY, fd_readdir\n    let fd = __open(rt, path, 2, 16384);\n    if fd < 0 {\n        return Err(__io_err(0 - fd, \"scandir\", path));\n    }\n    let names = Vec::new();\n    let used = __mem_alloc(rt, 8);\n    let size = 65536;\n    let buf = __mem_alloc(rt, size);\n    let mut cookie = 0;\n    while true {\n        let e = __Wasi::fd_readdir(fd, buf, size, cookie, used);\n        if e != 0 {\n            __Wasi::fd_close(fd);\n            return Err(__io_err(e, \"scandir\", path));\n        }\n        let n = __Mem::load32(used);\n        let mut off = 0;\n        let mut progressed = false;\n        // dirent: d_next u64, d_ino u64, d_namlen u32, d_type u8, name\n        while off + 24 <= n {\n            let namlen = __Mem::load32(buf + off + 16);\n            if off + 24 + namlen > n {\n                break;\n            }\n            let name = __mem_string(buf + off + 24, namlen);\n            cookie = __Mem::load64(buf + off);\n            progressed = true;\n            if name != \".\" && name != \"..\" {\n                names.push(name);\n            }\n            off = off + 24 + namlen;\n        }\n        if n < size || !progressed {\n            break;\n        }\n    }\n    __Wasi::fd_close(fd);\n    __sort_strings(names);\n    Ok(names)\n}\n\n// insertion sort by UTF-16 code units\nfn __sort_strings(v: Vec<String>) {\n    let n = v.len();\n    for i in 1..n {\n        let x = v.get(i).unwrap_or(\"\");\n        let mut j = i;\n        while j > 0 && __str_less(x, v.get(j - 1).unwrap_or(\"\")) {\n            v.set(j, v.get(j - 1).unwrap_or(\"\"));\n            j = j - 1;\n        }\n        v.set(j, x);\n    }\n}\n\nfn __ioError_message(e: IoError) -> String {\n    e.message\n}\n",
    );
    v
}
