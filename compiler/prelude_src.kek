        "// Capabilities of command-line programs and of `kek test` (mocks).\n//\n// Capability values carry no state on WASI: there is one instance of each\n// kind per program, and the state lives in `__Rt`.\n\nfn __rt_new() -> __Rt {\n    let rt = __Rt {\n        test: false,\n        base: 1024,\n        brk: 1024,\n        cwd: \"\",\n        store: __store_new(),\n        test_name: \"\",\n        clock_ms: 0,\n        rand: 0,\n        net: Map::new(),\n        net_err: Map::new(),\n        lines: Vec::new(),\n        sent: Vec::new(),\n        start_ns: 0,\n    };\n    let env = __env_all(rt);\n    rt.cwd = __env_lookup(env, \"PWD\");\n    if __env_lookup(env, \"KEK_TEST\") == \"1\" {\n        rt.test = true;\n        __test_setup(rt, env);\n    }\n    rt\n}\n\n// ---- &Log ----\n\nfn __log_line(level: String, m: String) {\n    let rt = __Rt::get();\n    if rt.test {\n        rt.lines.push(level + \": \" + m);\n    } else if level == \"info\" {\n        __print(m);\n    } else {\n        __eprint(m);\n    }\n}\n\nfn __log_info(log: __Any, m: String) {\n    __log_line(\"info\", m)\n}\n\nfn __log_warn(log: __Any, m: String) {\n    __log_line(\"warn\", m)\n}\n\nfn __log_error(log: __Any, m: String) {\n    __log_line(\"error\", m)\n}\n\n// ---- &Clock ----\n\nfn __clock_now_ms(c: __Any) -> Int {\n    let rt = __Rt::get();\n    if rt.test {\n        return rt.clock_ms;\n    }\n    __now_ns(0) / 1000000\n}\n\n// ---- &Random ----\n\n// SplitMix64\nfn __splitmix(rt: __Rt) -> Int {\n    rt.rand = rt.rand + -7046029254386353131;\n    let mut z = rt.rand;\n    z = z.bit_xor(z.ushr(30)) * -4658895280553007687;\n    z = z.bit_xor(z.ushr(27)) * -7723592293110705685;\n    z.bit_xor(z.ushr(31))\n}\n\n// A uniform integer in [lo, hi) (lo when the range is empty).\nfn __random_int(r: __Any, lo: Int, hi: Int) -> Int {\n    if hi <= lo {\n        return lo;\n    }\n    let rt = __Rt::get();\n    let x = if rt.test {\n        __splitmix(rt)\n    } else {\n        __random_u64()\n    };\n    lo + __Int::rem_u(x, hi - lo)\n}\n\n// ---- &Net ----\n\nfn __net_request(\n    method: String,\n    url: String,\n    body: String,\n    has_body: Bool,\n) -> Result<String, NetError> {\n    let rt = __Rt::get();\n    if !rt.test {\n        return Err(NetError { message: \"network access is not available to command-line programs\" });\n    }\n    let key = method + \" \" + url;\n    rt.lines.push(\n        \"net: \" + key + if has_body {\n            \" \" + __json_quote(body)\n        } else {\n            \"\"\n        },\n    );\n    match rt.net_err.get(key) {\n        Some(m) => {\n            return Err(NetError { message: m });\n        }\n        None => {}\n    }\n    match rt.net.get(key) {\n        Some(v) => Ok(v),\n        None => Err(NetError {\n            message: \"network access is mocked in tests: no canned response for \" + key,\n        }),\n    }\n}\n\nfn __net_get(net: __Any, url: String) -> Result<String, NetError> {\n    __net_request(\"GET\", url, \"\", false)\n}\n\nfn __net_post(net: __Any, url: String, body: String) -> Result<String, NetError> {\n    __net_request(\"POST\", url, body, true)\n}\n\nfn __netError_message(e: NetError) -> String {\n    e.message\n}\n\n// ---- &Db: an in-memory store with optimistic concurrency control ----\n\nstruct __Entry {\n    value: String,\n    version: Int,\n}\n\nstruct __Store {\n    data: Map<String, __Entry>,\n    clock: Int,\n}\n\nstruct __Tx {\n    // key -> version observed (0 = absent)\n    reads: Map<String, Int>,\n    // key -> new value (None = delete)\n    writes: Map<String, Option<String>>,\n    // url, body pairs\n    outbox: Vec<String>,\n    open: Bool,\n}\n\nfn __store_new() -> __Store {\n    __Store { data: Map::new(), clock: 0 }\n}\n\nfn __store_put(s: __Store, k: String, v: String) {\n    s.clock = s.clock + 1;\n    s.data.insert(k, __Entry { value: v, version: s.clock });\n}\n\nfn __db_get(db: __Any, key: String) -> Result<Option<String>, TxError> {\n    match __Rt::get().store.data.get(key) {\n        Some(e) => Ok(Some(e.value)),\n        None => Ok(None),\n    }\n}\n\nfn __db_begin(db: __Any) -> __Any {\n    __Tx::to_any(__Tx { reads: Map::new(), writes: Map::new(), outbox: Vec::new(), open: true })\n}\n\nfn __tx_get(t: __Any, key: String) -> Result<Option<String>, TxError> {\n    let tx = __Tx::from_any(t);\n    match tx.writes.get(key) {\n        Some(w) => {\n            return Ok(w);\n        }\n        None => {}\n    }\n    let e = __Rt::get().store.data.get(key);\n    if !tx.reads.contains(key) {\n        tx.reads.insert(key, match e {\n            Some(x) => x.version,\n            None => 0,\n        });\n    }\n    match e {\n        Some(x) => Ok(Some(x.value)),\n        None => Ok(None),\n    }\n}\n\nfn __tx_put(t: __Any, key: String, value: String) -> Result<(), TxError> {\n    __Tx::from_any(t).writes.insert(key, Some(value));\n    Ok(())\n}\n\nfn __tx_delete(t: __Any, key: String) -> Result<(), TxError> {\n    __Tx::from_any(t).writes.insert(key, None);\n    Ok(())\n}\n\nfn __tx_outbox(t: __Any, url: String, body: String) {\n    let tx = __Tx::from_any(t);\n    tx.outbox.push(url);\n    tx.outbox.push(body);\n}\n\nfn __tx_commit(t: __Any) -> Result<(), TxError> {\n    let tx = __Tx::from_any(t);\n    tx.open = false;\n    let rt = __Rt::get();\n    let s = rt.store;\n    for k in tx.reads.keys() {\n        let seen = tx.reads.get(k).unwrap_or(0);\n        let cur = match s.data.get(k) {\n            Some(x) => x.version,\n            None => 0,\n        };\n        if cur != seen {\n            tx.writes = Map::new();\n            tx.outbox = Vec::new();\n            return Err(TxError { message: \"conflict on key \" + __json_quote(k), retryable: true });\n        }\n    }\n    for k in tx.writes.keys() {\n        match tx.writes.get(k) {\n            Some(Some(v)) => __store_put(s, k, v),\n            _ => s.data.remove(k),\n        }\n    }\n    // irrevocable effects run only after a successful commit\n    let n = tx.outbox.len() / 2;\n    for i in 0..n {\n        let url = tx.outbox.get(i * 2).unwrap_or(\"\");\n        let body = tx.outbox.get(i * 2 + 1).unwrap_or(\"\");\n        if rt.test {\n            rt.sent.push(url + \" \" + __json_quote(body));\n        } else {\n            __eprint(\"kekkai outbox: POST \" + url + \" \" + __json_quote(body));\n        }\n    }\n    tx.outbox = Vec::new();\n    Ok(())\n}\n\nfn __tx_rollback(t: __Any) {\n    let tx = __Tx::from_any(t);\n    tx.open = false;\n    tx.writes = Map::new();\n    tx.outbox = Vec::new();\n}\n\nfn __tx_finish(t: __Any) {\n    let tx = __Tx::from_any(t);\n    if tx.open {\n        __tx_rollback(t);\n    }\n}\n\nfn __txError_message(e: TxError) -> String {\n    e.message\n}\n\nfn __txError_retryable(e: TxError) -> Bool {\n    e.retryable\n}\n",
