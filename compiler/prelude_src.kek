        "// Conversions between JS values and Kekkai values (Workers). Strings\n// cross through linear memory as UTF-16 code units, starting at byte 1024.\n\nfn __js_string(a: __Any) -> String {\n    let n = __Js::str_len(a);\n    __mem_ensure(1024 + n * 2);\n    __Js::str_to_mem(a, 1024);\n    let r = __Chars::new(n);\n    for i in 0..n {\n        r.set(i, __Mem::load16(1024 + i * 2));\n    }\n    r.freeze()\n}\n\nfn __js_from_string(s: String) -> __Any {\n    let x = __Chars::of(s);\n    let n = x.len();\n    __mem_ensure(1024 + n * 2);\n    for i in 0..n {\n        __Mem::store16(1024 + i * 2, x.get(i));\n    }\n    __Js::str_from_mem(1024, n)\n}\n\nfn __js_lift_TxError(e: __Any) -> TxError {\n    TxError { message: __js_string(__Js::err_message(e)), retryable: __Js::err_retryable(e) }\n}\n\nfn __js_lift_NetError(e: __Any) -> NetError {\n    NetError { message: __js_string(__Js::err_message(e)) }\n}\n\nfn __js_lift_IoError(e: __Any) -> IoError {\n    IoError { message: __js_string(__Js::err_message(e)) }\n}\n\n// ---- reading a Response (exported as resp_*) ----\n\nfn __js_export_resp_status(r: __Any) -> Int {\n    Response::from_any(r).status\n}\n\n// the body as a JS string, or null\nfn __js_export_resp_body(r: __Any) -> __Any {\n    let x = Response::from_any(r);\n    if !x.has_body {\n        return __Any::null();\n    }\n    __js_from_string(x.body)\n}\n\nfn __js_export_resp_header_count(r: __Any) -> Int {\n    Response::from_any(r).headers.len()\n}\n\nfn __js_export_resp_header(r: __Any, i: Int) -> __Any {\n    __js_from_string(Response::from_any(r).headers.get(i).unwrap_or(\"\"))\n}\n",
