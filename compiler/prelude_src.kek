        "// Map<K, V> with Int or String keys, in insertion order.\n//\n// Entries live in parallel vectors (removed entries leave a hole that is\n// compacted away when the table grows); `slots` is an open-addressing hash\n// table of entry index + 1 (0 = empty). Values are boxed into `__Any` by\n// the code generator.\n\nstruct __Map {\n    str_keys: Bool,\n    ikeys: Vec<Int>,\n    skeys: Vec<String>,\n    vals: Vec<__Any>,\n    live: Vec<Bool>,\n    count: Int,\n    slots: Vec<Int>,\n}\n\nfn __map_new(str_keys: Bool) -> __Map {\n    __Map {\n        str_keys: str_keys,\n        ikeys: Vec::new(),\n        skeys: Vec::new(),\n        vals: Vec::new(),\n        live: Vec::new(),\n        count: 0,\n        slots: __map_empty_slots(8),\n    }\n}\n\nfn __map_empty_slots(n: Int) -> Vec<Int> {\n    let v = Vec::new();\n    for i in 0..n {\n        v.push(0);\n    }\n    v\n}\n\nfn __hash_int(k: Int) -> Int {\n    let mut h = k * -7046029254386353131;\n    h = h.bit_xor(h.ushr(29));\n    h\n}\n\nfn __hash_str(s: String) -> Int {\n    let x = __Chars::of(s);\n    let n = x.len();\n    let mut h = -3750763034362895579;\n    let mut i = 0;\n    while i < n {\n        h = h.bit_xor(x.get(i)) * 1099511628211;\n        i = i + 1;\n    }\n    h.bit_xor(h.ushr(29))\n}\n\n// __map_find_int returns the entry index of key k, or -1.\nfn __map_find_int(m: __Map, k: Int) -> Int {\n    let mask = m.slots.len() - 1;\n    let mut s = __hash_int(k).bit_and(mask);\n    while true {\n        let e = m.slots.get(s).unwrap_or(0);\n        if e == 0 {\n            return -1;\n        }\n        if m.ikeys.get(e - 1).unwrap_or(0) == k && m.live.get(e - 1).unwrap_or(false) {\n            return e - 1;\n        }\n        s = (s + 1).bit_and(mask);\n    }\n    -1\n}\n\nfn __map_find_str(m: __Map, k: String) -> Int {\n    let mask = m.slots.len() - 1;\n    let mut s = __hash_str(k).bit_and(mask);\n    while true {\n        let e = m.slots.get(s).unwrap_or(0);\n        if e == 0 {\n            return -1;\n        }\n        if m.live.get(e - 1).unwrap_or(false) && m.skeys.get(e - 1).unwrap_or(\"\") == k {\n            return e - 1;\n        }\n        s = (s + 1).bit_and(mask);\n    }\n    -1\n}\n\nfn __map_slot_of(m: __Map, e: Int) -> Int {\n    if m.str_keys {\n        __hash_str(m.skeys.get(e).unwrap_or(\"\"))\n    } else {\n        __hash_int(m.ikeys.get(e).unwrap_or(0))\n    }\n}\n\nfn __map_place(m: __Map, e: Int) {\n    let mask = m.slots.len() - 1;\n    let mut s = __map_slot_of(m, e).bit_and(mask);\n    while m.slots.get(s).unwrap_or(0) != 0 {\n        s = (s + 1).bit_and(mask);\n    }\n    m.slots.set(s, e + 1);\n}\n\n// __map_rebuild drops removed entries and rehashes into a table with room\n// for at least `want` live entries.\nfn __map_rebuild(m: __Map, want: Int) {\n    let ik = Vec::new();\n    let sk = Vec::new();\n    let vs = Vec::new();\n    let lv = Vec::new();\n    let n = m.live.len();\n    for i in 0..n {\n        if m.live.get(i).unwrap_or(false) {\n            if m.str_keys {\n                sk.push(m.skeys.get(i).unwrap_or(\"\"));\n            } else {\n                ik.push(m.ikeys.get(i).unwrap_or(0));\n            }\n            vs.push(m.vals.get(i).unwrap_or(__Any::null()));\n            lv.push(true);\n        }\n    }\n    m.ikeys = ik;\n    m.skeys = sk;\n    m.vals = vs;\n    m.live = lv;\n    let mut size = 8;\n    while size < want * 2 {\n        size = size * 2;\n    }\n    m.slots = __map_empty_slots(size);\n    for i in 0..lv.len() {\n        __map_place(m, i);\n    }\n}\n\nfn __map_grow(m: __Map) {\n    // entries (including holes) + the new one must stay below 3/4 full\n    if (m.live.len() + 1) * 4 >= m.slots.len() * 3 {\n        __map_rebuild(m, m.count + 1);\n    }\n}\n\nfn __map_insert_int(m: __Map, k: Int, v: __Any) {\n    let e = __map_find_int(m, k);\n    if e >= 0 {\n        m.vals.set(e, v);\n        return;\n    }\n    __map_grow(m);\n    m.ikeys.push(k);\n    m.vals.push(v);\n    m.live.push(true);\n    m.count = m.count + 1;\n    __map_place(m, m.live.len() - 1);\n}\n\nfn __map_insert_str(m: __Map, k: String, v: __Any) {\n    let e = __map_find_str(m, k);\n    if e >= 0 {\n        m.vals.set(e, v);\n        return;\n    }\n    __map_grow(m);\n    m.skeys.push(k);\n    m.vals.push(v);\n    m.live.push(true);\n    m.count = m.count + 1;\n    __map_place(m, m.live.len() - 1);\n}\n\nfn __map_val(m: __Map, e: Int) -> __Any {\n    m.vals.get(e).unwrap_or(__Any::null())\n}\n\nfn __map_remove_at(m: __Map, e: Int) {\n    if e < 0 {\n        return;\n    }\n    m.live.set(e, false);\n    m.vals.set(e, __Any::null());\n    m.count = m.count - 1;\n    // the slot keeps pointing at the dead entry (a tombstone); rebuild\n    // when holes dominate\n    if m.live.len() > 16 && m.count * 2 < m.live.len() {\n        __map_rebuild(m, m.count);\n    }\n}\n\nfn __map_remove_int(m: __Map, k: Int) {\n    __map_remove_at(m, __map_find_int(m, k));\n}\n\nfn __map_remove_str(m: __Map, k: String) {\n    __map_remove_at(m, __map_find_str(m, k));\n}\n\nfn __map_len(m: __Map) -> Int {\n    m.count\n}\n\nfn __map_keys_int(m: __Map) -> Vec<Int> {\n    let out = Vec::new();\n    for i in 0..m.live.len() {\n        if m.live.get(i).unwrap_or(false) {\n            out.push(m.ikeys.get(i).unwrap_or(0));\n        }\n    }\n    out\n}\n\nfn __map_keys_str(m: __Map) -> Vec<String> {\n    let out = Vec::new();\n    for i in 0..m.live.len() {\n        if m.live.get(i).unwrap_or(false) {\n            out.push(m.skeys.get(i).unwrap_or(\"\"));\n        }\n    }\n    out\n}\n\nfn __vec_join(v: Vec<String>, sep: String) -> String {\n    let n = v.len();\n    if n == 0 {\n        return \"\";\n    }\n    let b = __sb_new(16);\n    for i in 0..n {\n        if i > 0 {\n            __sb_str(b, sep);\n        }\n        __sb_str(b, v.get(i).unwrap_or(\"\"));\n    }\n    __sb_finish(b)\n}\n",
