// `kek test` support (port of internal/testrun):
//
//   test-build <file-or-dir> <outdir>              discover every #[test] and build them all
//   test-build <file-or-dir> <outdir> -list        discover only (no build)
//   test-build <file-or-dir> <outdir> -run a b ..  build only the named tests
//
// Writes <outdir>/tests.json (all discovered tests, in declaration order:
// [{"name", "caps", "result", "pure"}]) and, when at least one test is
// selected, <outdir>/module.wasm + kekkai_meta.js of the test program: the
// sources plus a synthesized `#[handler] fn __kek_test_main` that dispatches
// on the request path to each selected test. Any #[handler] of the program
// itself is demoted to a plain function. js/test_runner.mjs drives the
// result with mock capabilities.

struct TestrunTest {
    name: String,
    caps: Vec<String>, // capability kinds, in parameter order
    result: String, // "unit", "bool" or "result"
}

fn testrun_main_name() -> String {
    "__kek_test_main"
}

// testrun_discover lists the #[test] functions of a checked program
// (testrun.Discover).
fn testrun_discover(info: ChkInfo) -> Vec<TestrunTest> {
    let tests = Vec::new();
    for fun in info.func_list {
        if !fun.test {
            continue;
        }
        let caps = Vec::new();
        for p in fun.params {
            match p.ty {
                Ty::Cap(k, _) => caps.push(k),
                _ => {}
            }
        }
        let mut result = "unit";
        match fun.result {
            Ty::Result(_, _) => {
                result = "result";
            }
            _ => {
                if ty_is_prim(fun.result, "Bool") {
                    result = "bool";
                }
            }
        }
        tests.push(TestrunTest { name: fun.name, caps: caps, result: result });
    }
    tests
}

fn testrun_tests_json(tests: Vec<TestrunTest>) -> String {
    let items = Vec::new();
    for t in tests {
        let caps = Vec::new();
        for c in t.caps {
            caps.push(json_quote(c));
        }
        let pure = if t.caps.len() == 0 { "true" } else { "false" };
        items.push(
            "{\"name\":"
                + json_quote(t.name)
                + ",\"caps\":["
                + caps.join(",")
                + "],\"result\":"
                + json_quote(t.result)
                + ",\"pure\":"
                + pure
                + "}",
        );
    }
    "[" + items.join(",") + "]\n"
}

// testrun_harness returns the source of the synthesized handler
// (testrun.Harness; the text is identical).
fn testrun_harness(tests: Vec<TestrunTest>) -> String {
    let used: Map<String, Bool> = Map::new();
    for t in tests {
        for c in t.caps {
            used.insert(c, true);
        }
    }
    let mut b = "\n// ---- synthesized by kek test ----\n#[handler]\nfn "
        + testrun_main_name()
        + "(__req: Request";
    for c in "Log Clock Random Db Net".split(" ") {
        if used.get(c).unwrap_or(false) {
            b = b + ", __" + c.to_lower() + ": &" + c;
        }
    }
    b = b + ") -> Response {\n    let __name = __req.path();\n";
    for t in tests {
        let args = Vec::new();
        for c in t.caps {
            args.push("__" + c.to_lower());
        }
        let call = t.name + "(" + args.join(", ") + ")";
        b = b + "    if __name == \"/" + t.name + "\" {\n";
        if t.result == "bool" {
            b = b
                + "        if "
                + call
                + " {\n            return Response::text(200, \"\");\n        }\n";
            b = b + "        return Response::text(500, \"test returned false\");\n";
        } else if t.result == "result" {
            b = b + "        return match " + call + " {\n";
            b = b + "            Ok(_) => Response::text(200, \"\"),\n";
            b = b + "            Err(__e) => Response::text(500, __e),\n        };\n";
        } else {
            b = b + "        " + call + ";\n        return Response::text(200, \"\");\n";
        }
        b = b + "    }\n";
    }
    b + "    Response::not_found()\n}\n"
}

fn testrun_write(fs: &Fs, log: &Log, p: String, text: String) -> Bool {
    match fs.write(p, text) {
        Ok(_) => true,
        Err(e) => {
            log.error(p + ": " + e.message());
            false
        }
    }
}

fn testrun_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 3 {
        log.error("usage: test-build <file-or-dir> <outdir> [-list | -run name...]");
        return 2;
    }
    let path = args.get(1).unwrap_or("");
    let out_dir = frontend_clean_dir(args.get(2).unwrap_or(""));
    let mode = args.get(3).unwrap_or("");
    if mode != "" && mode != "-list" && mode != "-run" {
        log.error("test-build: unknown option " + mode);
        return 2;
    }
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return 1;
        }
    };
    let prog = frontend_parse_all(srcs);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return 1;
    }
    let res = chk_check(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return 1;
    }
    let all = testrun_discover(res.info);
    if !testrun_write(fs, log, out_dir + "/tests.json", testrun_tests_json(all)) {
        return 1;
    }
    if mode == "-list" {
        return 0;
    }
    let mut tests = all;
    if mode == "-run" {
        let want: Map<String, Bool> = Map::new();
        let mut i = 4;
        while i < args.len() {
            want.insert(args.get(i).unwrap_or(""), true);
            i = i + 1;
        }
        tests = Vec::new();
        for t in all {
            if want.get(t.name).unwrap_or(false) {
                tests.push(t);
            }
        }
    }
    if tests.len() == 0 {
        return 0;
    }
    testrun_build(srcs, tests, out_dir, fs, log)
}

// testrun_build compiles the sources plus the harness (appended to the
// last file, as stage0 appends it to the source text) with the program's
// own #[handler] demoted (testrun.Compile).
fn testrun_build(
    srcs: Vec<FeSource>,
    tests: Vec<TestrunTest>,
    out_dir: String,
    fs: &Fs,
    log: &Log,
) -> Int {
    match srcs.get(srcs.len() - 1) {
        Some(last) => {
            last.text = last.text + testrun_harness(tests);
        }
        None => {}
    }
    let prog = frontend_parse_all(srcs);
    if prog.errs.len() > 0 {
        log.error("kek test: internal error in synthesized harness:");
        frontend_print_errors(log, prog.errs);
        return 1;
    }
    for fd in prog.file.funcs {
        if fd.name == testrun_main_name() {
            continue;
        }
        let attrs = Vec::new();
        for a in fd.attrs {
            if a.name != "handler" {
                attrs.push(a);
            }
        }
        fd.attrs = attrs;
    }
    let res = chk_check(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return 1;
    }
    let ir = lower_lower(res.info);
    let out = wasm_compile(ir);
    if out.err != "" {
        log.error(out.err);
        return 1;
    }
    let wasm_path = out_dir + "/module.wasm";
    match fs.write_bytes(wasm_path, out.wasm) {
        Ok(_) => {}
        Err(e) => {
            log.error(wasm_path + ": " + e.message());
            return 1;
        }
    }
    let meta = "// Generated by kek. Do not edit.\nexport default "
        + backend_meta_json(out.strings, ir.handler_params)
        + ";\n";
    if !testrun_write(fs, log, out_dir + "/kekkai_meta.js", meta) {
        return 1;
    }
    0
}
