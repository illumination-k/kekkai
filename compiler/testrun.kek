// `kek test` support:
//
//   test-build <file-or-dir> <outdir>              discover every #[test] and build them all
//   test-build <file-or-dir> <outdir> -list        discover only (no build)
//   test-build <file-or-dir> <outdir> -run a b ..  build only the named tests
//
// Writes <outdir>/tests.json (all discovered tests, in declaration order:
// [{"name", "caps", "result", "pure"}]), <outdir>/tests.txt (one name per
// line) and, when at least one test is selected, <outdir>/module.wasm: the
// sources plus a synthesized `#[main] fn __kek_test_main` that runs the
// test named by its first argument with mock capabilities
// (lib/prelude/test.kek). Any #[handler] or #[main] of the program itself
// is demoted to a plain function. The launcher runs each test in its own
// process.

struct TestrunTest {
    name: String,
    caps: Vec<String>, // capability kinds, in parameter order
    result: String, // "unit", "bool" or "result"
}

fn testrun_main_name() -> String {
    "__kek_test_main"
}

// testrun_discover lists the #[test] functions of a checked program.
fn testrun_discover(info: ChkInfo) -> Vec<TestrunTest> {
    let tests = Vec::new();
    for fun in info.func_list {
        if !fun.test || chk_is_lib(fun) {
            continue;
        }
        let caps = Vec::new();
        for p in fun.params {
            match p.ty {
                Ty::Cap(k, _) => caps.push(k),
                _ => {}
            }
        }
        let mut result = "unit";
        match fun.result {
            Ty::Result(_, _) => {
                result = "result";
            }
            _ => {
                if ty_is_prim(fun.result, "Bool") {
                    result = "bool";
                }
            }
        }
        tests.push(TestrunTest { name: fun.name, caps: caps, result: result });
    }
    tests
}

fn testrun_tests_json(tests: Vec<TestrunTest>) -> String {
    let items = Vec::new();
    for t in tests {
        let caps = Vec::new();
        for c in t.caps {
            caps.push(json_quote(c));
        }
        let pure = if t.caps.len() == 0 { "true" } else { "false" };
        items.push(
            "{\"name\":"
                + json_quote(t.name)
                + ",\"caps\":["
                + caps.join(",")
                + "],\"result\":"
                + json_quote(t.result)
                + ",\"pure\":"
                + pure
                + "}",
        );
    }
    "[" + items.join(",") + "]\n"
}

fn testrun_kind(t: TestrunTest) -> String {
    if t.caps.len() == 0 {
        return "pure: hermetic, cacheable";
    }
    "mock " + t.caps.join(", ")
}

// testrun_harness returns the source of the synthesized #[main].
fn testrun_harness(tests: Vec<TestrunTest>) -> String {
    let used: HashMap<String, Bool> = HashMap::new();
    for t in tests {
        for c in t.caps {
            used.insert(c, true);
        }
    }
    let mut b = "// synthesized by kek test\n#[main]\nfn "
        + testrun_main_name()
        + "(__args: Vec<String>";
    for c in "Log Clock Random Db Net".split(" ") {
        if used.get(c).unwrap_or(false) {
            b = b + ", __" + c.to_lower() + ": &" + c;
        }
    }
    b = b + ") -> Int {\n    let __name = __args.get(0).unwrap_or(\"\");\n";
    b = b + "    if !__test_begin(__name) {\n        return 1;\n    }\n";
    b = b + "    if __name == \"\" {\n        return 0;\n    }\n";
    for t in tests {
        let args = Vec::new();
        for c in t.caps {
            args.push("__" + c.to_lower());
        }
        let call = t.name + "(" + args.join(", ") + ")";
        let who = json_quote(t.name) + ", " + json_quote(testrun_kind(t));
        b = b + "    if __name == " + json_quote(t.name) + " {\n";
        if t.result == "bool" {
            b = b
                + "        if "
                + call
                + " {\n            return __test_ok("
                + who
                + ");\n        }\n";
            b = b + "        return __test_false(" + who + ");\n";
        } else if t.result == "result" {
            b = b + "        return match " + call + " {\n";
            b = b + "            Ok(_) => __test_ok(" + who + "),\n";
            b = b + "            Err(__e) => __test_err(" + who + ", __e),\n        };\n";
        } else {
            b = b + "        " + call + ";\n        return __test_ok(" + who + ");\n";
        }
        b = b + "    }\n";
    }
    b + "    __eprint(\"kek test: no test named \" + __name);\n    2\n}\n"
}

fn testrun_write(fs: &Fs, log: &Log, p: String, text: String) -> Bool {
    match fs.write(p, text) {
        Ok(_) => true,
        Err(e) => {
            log.error(p + ": " + e.message());
            false
        }
    }
}

fn testrun_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 3 {
        log.error("usage: test-build <file-or-dir> <outdir> [-list | -run name...]");
        return 2;
    }
    let path = args.get(1).unwrap_or("");
    let out_dir = frontend_clean_dir(args.get(2).unwrap_or(""));
    let mode = args.get(3).unwrap_or("");
    if mode != "" && mode != "-list" && mode != "-run" {
        log.error("test-build: unknown option " + mode);
        return 2;
    }
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return 1;
        }
    };
    let prog = frontend_parse_all(srcs);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return 1;
    }
    let res = chk_check(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return 1;
    }
    let all = testrun_discover(res.info);
    if !testrun_write(fs, log, out_dir + "/tests.json", testrun_tests_json(all)) {
        return 1;
    }
    let names = Vec::new();
    for t in all {
        names.push(t.name + "\n");
    }
    if !testrun_write(fs, log, out_dir + "/tests.txt", names.join("")) {
        return 1;
    }
    if mode == "-list" {
        return 0;
    }
    let mut tests = all;
    if mode == "-run" {
        let want: HashMap<String, Bool> = HashMap::new();
        let mut i = 4;
        while i < args.len() {
            want.insert(args.get(i).unwrap_or(""), true);
            i = i + 1;
        }
        tests = Vec::new();
        for t in all {
            if want.get(t.name).unwrap_or(false) {
                tests.push(t);
            }
        }
    }
    if tests.len() == 0 {
        return 0;
    }
    testrun_build(srcs, tests, out_dir, fs, log)
}

// testrun_build compiles the sources plus the harness with the
// program's own entry point demoted.
fn testrun_build(
    srcs: Vec<FeSource>,
    tests: Vec<TestrunTest>,
    out_dir: String,
    fs: &Fs,
    log: &Log,
) -> Int {
    let all = Vec::new();
    for s in srcs {
        all.push(s);
    }
    all.push(FeSource { name: "<prelude>/kek_test_main.kek", text: testrun_harness(tests) });
    for s in prelude_sources() {
        all.push(s);
    }
    let prog = frontend_parse_all(all);
    if prog.errs.len() > 0 {
        log.error("kek test: internal error in synthesized harness:");
        frontend_print_errors(log, prog.errs);
        return 1;
    }
    for fd in prog.file.funcs {
        if fd.name == testrun_main_name() {
            continue;
        }
        let attrs = Vec::new();
        for a in fd.attrs {
            if a.name != "handler" && a.name != "main" {
                attrs.push(a);
            }
        }
        fd.attrs = attrs;
    }
    let res = chk_check_prelude(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return 1;
    }
    let ir = lower_lower(res.info);
    let out = wasm_compile(ir);
    if out.err != "" {
        log.error(out.err);
        return 1;
    }
    let wasm_path = out_dir + "/module.wasm";
    match fs.write_bytes(wasm_path, out.wasm) {
        Ok(_) => {}
        Err(e) => {
            log.error(wasm_path + ": " + e.message());
            return 1;
        }
    }
    0
}
