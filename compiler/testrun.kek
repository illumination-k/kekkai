// `kek test` support:
//
//   test-build <file-or-dir> <outdir>              discover every #[test] and build them all
//   test-build <file-or-dir> <outdir> -list        discover only (no build)
//   test-build <file-or-dir> <outdir> -run a b ..  build only the named tests
//
// Writes <outdir>/tests.json (all discovered tests, in declaration order:
// [{"name", "caps", "result", "pure", "params", "cases", "hash"}]),
// <outdir>/tests.txt (one name per line), <outdir>/tests.tsv (for the
// launcher: name, trans hash, number of generated parameters, cases (0 =
// the default), capabilities joined by ",") and, when at least one test is
// selected, <outdir>/module.wasm: the sources plus a synthesized
// `#[main] fn __kek_test_main` that runs the test named by its first
// argument with mock capabilities (lib/prelude/test.kek). A test with
// generated parameters is a property: the harness runs it on generated
// inputs and shrinks a failure (compiler/pbt.kek, lib/prelude/prop.kek).
// Any #[handler] or #[main] of the program itself is demoted to a plain
// function. The launcher runs each test in its own process.

struct TestrunTest {
    name: String,
    caps: Vec<String>, // capability kinds, in parameter order
    result: String, // "unit", "bool" or "result"
    // every parameter in order (capabilities and generated values)
    args: Vec<TestrunArg>,
    // #[test(cases = N)], 0 when not given
    cases: Int,
    // the definition hash (trans) of the test, "" until computed
    mut hash: String,
}

// TestrunArg is a test parameter: a capability (cap is its kind) or a
// generated value (cap is "").
struct TestrunArg {
    name: String,
    cap: String,
    ty: Ty,
}

fn testrun_main_name() -> String {
    "__kek_test_main"
}

// testrun_discover lists the #[test] functions of a checked program.
fn testrun_discover(info: ChkInfo) -> Vec<TestrunTest> {
    let tests = Vec::new();
    for fun in info.func_list {
        if !fun.test || chk_is_lib(fun) {
            continue;
        }
        let caps = Vec::new();
        let args = Vec::new();
        for p in fun.params {
            match p.ty {
                Ty::Cap(k, _) => {
                    caps.push(k);
                    args.push(TestrunArg { name: p.name, cap: k, ty: p.ty });
                }
                _ => args.push(TestrunArg { name: p.name, cap: "", ty: p.ty }),
            }
        }
        let mut cases = 0;
        match ast_find_attr(fun.decl.attrs, "test") {
            Some(a) => match ast_attr_value(a, "cases") {
                Some(v) => {
                    cases = v.parse_int().unwrap_or(0);
                }
                None => {}
            },
            None => {}
        }
        let mut result = "unit";
        match fun.result {
            Ty::Result(_, _) => {
                result = "result";
            }
            _ => {
                if ty_is_prim(fun.result, "Bool") {
                    result = "bool";
                }
            }
        }
        tests.push(TestrunTest {
            name: fun.name,
            caps: caps,
            result: result,
            args: args,
            cases: cases,
            hash: "",
        });
    }
    tests
}

// testrun_params returns the generated parameters of a test (none for an
// ordinary test).
fn testrun_params(t: TestrunTest) -> Vec<TestrunArg> {
    let out = Vec::new();
    for a in t.args {
        if a.cap == "" {
            out.push(a);
        }
    }
    out
}

// testrun_hash sets the definition hash (trans) of every test.
fn testrun_hash(tests: Vec<TestrunTest>, file: AstFile, info: ChkInfo) {
    let dh = dh_program(file, info);
    for t in tests {
        match dh.by_name.get(t.name) {
            Some(d) => {
                t.hash = d.trans;
            }
            None => {}
        }
    }
}

fn testrun_tests_tsv(tests: Vec<TestrunTest>) -> String {
    let lines = Vec::new();
    for t in tests {
        lines.push(
            t.name
                + "\t"
                + t.hash
                + "\t"
                + testrun_params(t).len().to_string()
                + "\t"
                + t.cases.to_string()
                + "\t"
                + t.caps.join(",")
                + "\n",
        );
    }
    lines.join("")
}

fn testrun_tests_json(tests: Vec<TestrunTest>) -> String {
    let items = Vec::new();
    for t in tests {
        let caps = Vec::new();
        for c in t.caps {
            caps.push(json_quote(c));
        }
        let pure = if t.caps.len() == 0 { "true" } else { "false" };
        let params = Vec::new();
        for p in testrun_params(t) {
            params.push(
                "{\"name\":" + json_quote(p.name) + ",\"type\":" + json_quote(ty_str(p.ty)) + "}",
            );
        }
        let cases = if t.cases > 0 {
            t.cases.to_string()
        } else {
            "null"
        };
        items.push(
            "{\"name\":"
                + json_quote(t.name)
                + ",\"caps\":["
                + caps.join(",")
                + "],\"result\":"
                + json_quote(t.result)
                + ",\"pure\":"
                + pure
                + ",\"params\":["
                + params.join(",")
                + "],\"cases\":"
                + cases
                + ",\"hash\":"
                + json_quote(t.hash)
                + "}",
        );
    }
    "[" + items.join(",") + "]\n"
}

fn testrun_kind(t: TestrunTest) -> String {
    if t.caps.len() == 0 {
        return "pure: hermetic, cacheable";
    }
    "mock " + t.caps.join(", ")
}

// testrun_harness returns the source of the synthesized #[main].
fn testrun_harness(tests: Vec<TestrunTest>) -> String {
    let used: HashMap<String, Bool> = HashMap::new();
    for t in tests {
        for c in t.caps {
            used.insert(c, true);
        }
    }
    let mut b = "// synthesized by kek test\n#[main]\nfn "
        + testrun_main_name()
        + "(__args: Vec<String>";
    for c in "Log Clock Random Db Net".split(" ") {
        if used.get(c).unwrap_or(false) {
            b = b + ", __" + c.to_lower() + ": &" + c;
        }
    }
    b = b + ") -> Int {\n    let __name = __args.get(0).unwrap_or(\"\");\n";
    let pg = pbt_new();
    let mut ti = 0;
    b = b + "    if !__test_begin(__name) {\n        return 1;\n    }\n";
    b = b + "    if __name == \"\" {\n        return 0;\n    }\n";
    for t in tests {
        let args = Vec::new();
        for c in t.caps {
            args.push("__" + c.to_lower());
        }
        let call = t.name + "(" + args.join(", ") + ")";
        let who = json_quote(t.name) + ", " + json_quote(testrun_kind(t));
        b = b + "    if __name == " + json_quote(t.name) + " {\n";
        ti = ti + 1;
        if testrun_params(t).len() > 0 {
            b = b + "        return __kt_" + ti.to_string() + "(" + args.join(", ") + ");\n    }\n";
            pg.out.push(testrun_property(pg, t, ti.to_string()));
            continue;
        }
        if t.result == "bool" {
            b = b
                + "        if "
                + call
                + " {\n            return __test_ok("
                + who
                + ");\n        }\n";
            b = b + "        return __test_false(" + who + ");\n";
        } else if t.result == "result" {
            b = b + "        return match " + call + " {\n";
            b = b + "            Ok(_) => __test_ok(" + who + "),\n";
            b = b + "            Err(__e) => __test_err(" + who + ", __e),\n        };\n";
        } else {
            b = b + "        " + call + ";\n        return __test_ok(" + who + ");\n";
        }
        b = b + "    }\n";
    }
    b + "    __eprint(\"kek test: no test named \" + __name);\n    2\n}\n\n" + pg.out.join("\n")
}

// testrun_property returns the functions running property test t (number
// n): __kp_n runs it once on given inputs with fresh mocks ("" when it
// passes, else why it failed), __kd_n renders a call, __kt_n generates
// the cases and shrinks the first failure.
fn testrun_property(pg: PbtGen, t: TestrunTest, n: String) -> String {
    let caps_decl = Vec::new();
    let caps_args = Vec::new();
    for c in t.caps {
        caps_decl.push("__" + c.to_lower() + ": &" + c);
        caps_args.push("__" + c.to_lower());
    }
    let ps = testrun_params(t);
    let ids = Vec::new();
    let vdecl = Vec::new();
    let mut k = 0;
    for p in ps {
        let id = pbt_ty(pg, p.ty);
        ids.push(id);
        vdecl.push("__a" + k.to_string() + ": " + ty_str(p.ty));
        k = k + 1;
    }
    // the call of the test, its parameters in declaration order
    let call_args = Vec::new();
    k = 0;
    for a in t.args {
        if a.cap != "" {
            call_args.push("__" + a.cap.to_lower());
        } else {
            call_args.push("__kc_" + ids.get(k).unwrap_or("") + "(__a" + k.to_string() + ")");
            k = k + 1;
        }
    }
    let call = t.name + "(" + call_args.join(", ") + ")";
    let all_decl = Vec::new();
    for d in caps_decl {
        all_decl.push(d);
    }
    for d in vdecl {
        all_decl.push(d);
    }
    let mut b = "fn __kp_" + n + "(" + all_decl.join(", ") + ") -> String {\n";
    b = b + "    __test_case_reset();\n";
    if t.result == "bool" {
        b = b + "    if " + call + " { \"\" } else { \"returned false\" }\n";
    } else if t.result == "result" {
        b = b
            + "    match "
            + call
            + " {\n        Ok(_) => \"\",\n        Err(__e) => \"Err: \" + __e,\n    }\n";
    } else {
        b = b + "    " + call + ";\n    \"\"\n";
    }
    b = b + "}\n\n";
    // __kd_n: `name(x = 1, ys = [])`
    let shows = Vec::new();
    k = 0;
    for p in ps {
        shows.push(
            json_quote(p.name + " = ")
                + " + __kw_"
                + ids.get(k).unwrap_or("")
                + "(__a"
                + k.to_string()
                + ")",
        );
        k = k + 1;
    }
    b = b + "fn __kd_" + n + "(" + vdecl.join(", ") + ") -> String {\n    ";
    b = b + json_quote(t.name + "(") + " + " + shows.join(" + \", \" + ") + " + \")\"\n}\n\n";
    // __kt_n
    let who = json_quote(t.name) + ", " + json_quote(testrun_kind(t));
    let gen_args = Vec::new();
    let cur_args = Vec::new();
    k = 0;
    for p in ps {
        gen_args.push("__a" + k.to_string());
        cur_args.push("__b" + k.to_string());
        k = k + 1;
    }
    b = b + "fn __kt_" + n + "(" + caps_decl.join(", ") + ") -> Int {\n";
    b = b + "    let __g = __gen_new(" + json_quote(t.name) + ");\n";
    b = b + "    let __n = __test_cases(" + t.cases.to_string() + ");\n";
    b = b + "    let mut __i = 0;\n    while __i < __n {\n        __gen_case(__g, __i, __n);\n";
    k = 0;
    for id in ids {
        b = b + "        let __a" + k.to_string() + " = __kg_" + id + "(__g, 0);\n";
        k = k + 1;
    }
    b = b + "        let __in = __kd_" + n + "(" + gen_args.join(", ") + ");\n";
    b = b + "        __test_note(\"case \" + (__i + 1).to_string() + \": \" + __in);\n";
    b = b + "        let __r = __kp_" + n + "(" + testrun_join2(caps_args, gen_args) + ");\n";
    b = b + "        if __r != \"\" {\n";
    b = b + "            let __s = __shrink_new(__r, \"case \" + (__i + 1).to_string());\n";
    k = 0;
    for p in ps {
        b = b + "            let mut __b" + k.to_string() + " = __a" + k.to_string() + ";\n";
        k = k + 1;
    }
    b = b
        + "            let mut __more = true;\n            while __more {\n                __more = false;\n";
    k = 0;
    for id in ids {
        let cand = Vec::new();
        let mut q = 0;
        for x in cur_args {
            cand.push(if q == k { "__c" } else { x });
            q = q + 1;
        }
        if k > 0 {
            b = b
                + "                if __more {\n                    continue;\n                }\n";
        }
        b = b + "                for __c in __ks_" + id + "(__b" + k.to_string() + ") {\n";
        b = b
            + "                    if !__shrink_try(__s, __kd_"
            + n
            + "("
            + cand.join(", ")
            + ")) {\n                        break;\n                    }\n";
        b = b
            + "                    let __r2 = __kp_"
            + n
            + "("
            + testrun_join2(caps_args, cand)
            + ");\n";
        b = b
            + "                    if __r2 != \"\" {\n                        __shrink_ok(__s, __r2);\n";
        b = b
            + "                        __b"
            + k.to_string()
            + " = __c;\n                        __more = true;\n                        break;\n                    }\n                }\n";
        k = k + 1;
    }
    b = b + "            }\n";
    b = b + "            // run the counterexample again: the mocks show its run\n";
    b = b + "            __kp_" + n + "(" + testrun_join2(caps_args, cur_args) + ");\n";
    b = b
        + "            return __test_prop_failed("
        + who
        + ", __s, __kd_"
        + n
        + "("
        + cur_args.join(", ")
        + "), __in, __i, __n);\n";
    b = b + "        }\n        __i = __i + 1;\n    }\n";
    b + "    __test_prop_ok(" + who + ", __n)\n}\n"
}

fn testrun_join2(a: Vec<String>, b: Vec<String>) -> String {
    let all = Vec::new();
    for x in a {
        all.push(x);
    }
    for x in b {
        all.push(x);
    }
    all.join(", ")
}

fn testrun_write(fs: &Fs, log: &Log, p: String, text: String) -> Bool {
    match fs.write(p, text) {
        Ok(_) => true,
        Err(e) => {
            log.error(p + ": " + e.message());
            false
        }
    }
}

fn testrun_main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 3 {
        log.error("usage: test-build <file-or-dir> <outdir> [-list | -run name...]");
        return 2;
    }
    let path = args.get(1).unwrap_or("");
    let out_dir = frontend_clean_dir(args.get(2).unwrap_or(""));
    let mode = args.get(3).unwrap_or("");
    if mode != "" && mode != "-list" && mode != "-run" {
        log.error("test-build: unknown option " + mode);
        return 2;
    }
    let srcs = match frontend_read_sources(path, fs, log) {
        Some(s) => s,
        None => {
            return 1;
        }
    };
    let prog = frontend_parse_all(srcs);
    if prog.errs.len() > 0 {
        frontend_print_errors(log, prog.errs);
        return 1;
    }
    let res = chk_check(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return 1;
    }
    let all = testrun_discover(res.info);
    testrun_hash(all, prog.file, res.info);
    if !testrun_write(fs, log, out_dir + "/tests.json", testrun_tests_json(all)) {
        return 1;
    }
    if !testrun_write(fs, log, out_dir + "/tests.tsv", testrun_tests_tsv(all)) {
        return 1;
    }
    let names = Vec::new();
    for t in all {
        names.push(t.name + "\n");
    }
    if !testrun_write(fs, log, out_dir + "/tests.txt", names.join("")) {
        return 1;
    }
    if mode == "-list" {
        return 0;
    }
    let mut tests = all;
    if mode == "-run" {
        let want: HashMap<String, Bool> = HashMap::new();
        let mut i = 4;
        while i < args.len() {
            want.insert(args.get(i).unwrap_or(""), true);
            i = i + 1;
        }
        tests = Vec::new();
        for t in all {
            if want.get(t.name).unwrap_or(false) {
                tests.push(t);
            }
        }
    }
    if tests.len() == 0 {
        return 0;
    }
    testrun_build(srcs, tests, out_dir, fs, log)
}

// testrun_build compiles the sources plus the harness with the
// program's own entry point demoted.
fn testrun_build(
    srcs: Vec<FeSource>,
    tests: Vec<TestrunTest>,
    out_dir: String,
    fs: &Fs,
    log: &Log,
) -> Int {
    let all = Vec::new();
    for s in srcs {
        all.push(s);
    }
    all.push(FeSource { name: "<prelude>/kek_test_main.kek", text: testrun_harness(tests) });
    for s in prelude_sources() {
        all.push(s);
    }
    let prog = frontend_parse_all(all);
    if prog.errs.len() > 0 {
        log.error("kek test: internal error in synthesized harness:");
        frontend_print_errors(log, prog.errs);
        return 1;
    }
    for fd in prog.file.funcs {
        if fd.name == testrun_main_name() {
            continue;
        }
        let attrs = Vec::new();
        for a in fd.attrs {
            if a.name != "handler" && a.name != "main" {
                attrs.push(a);
            }
        }
        fd.attrs = attrs;
    }
    let res = chk_check_prelude(prog.file);
    if res.errs.len() > 0 {
        frontend_print_errors(log, res.errs);
        return 1;
    }
    let ir = lower_lower(res.info);
    let out = wasm_compile(ir);
    if out.err != "" {
        log.error(out.err);
        return 1;
    }
    let wasm_path = out_dir + "/module.wasm";
    match fs.write_bytes(wasm_path, out.wasm) {
        Ok(_) => {}
        Err(e) => {
            log.error(wasm_path + ": " + e.message());
            return 1;
        }
    }
    0
}
