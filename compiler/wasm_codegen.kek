// WasmGC code generation from IR.
//
// The program is compiled together with the runtime prelude (lib/prelude):
// builtin operations become calls of prelude functions, so the module is
// self-contained. Two targets differ only in how the outside world is
// reached:
//   wasi     command-line programs: WASI preview 1 imports, `_start`
//   workers  #[handler] programs: capability operations are imported from
//            the JS host (js/kekkai_runtime.js)
//
// The output is deterministic: types, imports, function indices (including
// the lazy reservation order of helpers), locals and the string literal
// table are produced in a fixed order (the bootstrap fixed point relies on
// it). Function bodies are dispatcher loops; functions that can suspend
// become $new/$step state machines.

struct WasmSig {
    params: Vec<Int>,
    results: Vec<Int>,
}

// WasmComp is a struct type, or an array type when array is set (element
// in fields[0]).
struct WasmComp {
    fields: Vec<Int>,
    muts: Vec<Bool>,
    array: Bool,
}

struct WasmImport {
    module: String,
    name: String,
    sig: WasmSig,
    is_async: Bool,
}

struct WasmFunc {
    name: String,
    sig: WasmSig,
    locals: Vec<Int>, // excluding params
    body: Vec<Int>,
    export: String,
    built: Bool,
}

struct WasmMod {
    prog: IrProgram,
    target: String,
    structs: Vec<WasmComp>,
    agg_type: Vec<Int>, // IR aggregate index -> wasm type index
    vec_arr: Vec<Int>, // vec aggregate index -> wasm array type index
    agg_slots: Vec<Vec<Vec<Int>>>, // variant aggregates: [tag][field] -> struct field
    chars_t: Int, // (array (mut i16)): strings
    lits_t: Int, // (array (mut (ref null chars))): the literal cache
    box_t: Int, // (struct i64): boxed Int / Bool map values
    map_t: Int, // the prelude's __Map
    frame: Map<String, Int>,
    imports: Vec<WasmImport>,
    import_idx: Map<String, Int>,
    funcs: Vec<WasmFunc>,
    func_idx: Map<String, Int>,
    strings: Vec<String>,
    string_idx: Map<String, Int>,
    string_off: Vec<Int>, // byte offset of each literal in the data segment
    data_len: Int,
    lifts: Map<Int, Int>,
    prog_func: Map<String, Int>, // IR function name -> index in prog.funcs
    reach: Map<String, Bool>, // IR functions that are compiled
    err: String,
}

// WasmOutput is the result of compilation.
struct WasmOutput {
    wasm: Vec<Int>,
    err: String,
}

fn wasm_sig(params: Vec<Int>, results: Vec<Int>) -> WasmSig {
    WasmSig { params: params, results: results }
}

fn wasm_sig_key(s: WasmSig) -> String {
    let parts = Vec::new();
    for p in s.params {
        parts.push(p.to_string());
    }
    parts.push("|");
    for r in s.results {
        parts.push(r.to_string());
    }
    parts.join(",")
}

fn wasm_fail(m: WasmMod, msg: String) {
    if m.err == "" {
        m.err = msg;
    }
}

fn wasm_td(m: WasmMod, i: Int) -> IrTypeDef {
    match m.prog.types.get(i) {
        Some(t) => t,
        None => {
            wasm_fail(m, "bad aggregate index " + i.to_string());
            IrTypeDef {
                name: "",
                is_variant: false,
                fields: Vec::new(),
                variants: Vec::new(),
                coll: "",
                elem: ir_ty_none(),
                key: ir_ty_none(),
            }
        }
    }
}

fn wasm_tys_at(v: Vec<Vec<IrTy>>, i: Int) -> Vec<IrTy> {
    v.get(i).unwrap_or(Vec::new())
}

fn wasm_ty_at(v: Vec<IrTy>, i: Int) -> IrTy {
    match v.get(i) {
        Some(t) => t,
        None => ir_ty_none(),
    }
}

fn wasm_lookup(tbl: Map<String, Int>, k: String) -> Int {
    tbl.get(k).unwrap_or(-1)
}

// wasm_target picks the target of a program: Workers for #[handler],
// WASI otherwise.
fn wasm_target(p: IrProgram) -> String {
    if p.entry == "handler" {
        return "workers";
    }
    "wasi"
}

// wasm_compile translates an IR program (including the prelude) into a
// WasmGC module.
fn wasm_compile(p: IrProgram) -> WasmOutput {
    let m = WasmMod {
        prog: p,
        target: wasm_target(p),
        structs: Vec::new(),
        agg_type: Vec::new(),
        vec_arr: Vec::new(),
        agg_slots: Vec::new(),
        chars_t: 0,
        lits_t: 0,
        box_t: 0,
        map_t: 0,
        frame: Map::new(),
        imports: Vec::new(),
        import_idx: Map::new(),
        funcs: Vec::new(),
        func_idx: Map::new(),
        strings: Vec::new(),
        string_idx: Map::new(),
        string_off: Vec::new(),
        data_len: 0,
        lifts: Map::new(),
        prog_func: Map::new(),
        reach: Map::new(),
        err: "",
    };
    let mut fi = 0;
    for f in p.funcs {
        if !m.prog_func.contains(f.name) {
            m.prog_func.insert(f.name, fi);
        }
        fi = fi + 1;
    }
    wasm_layout_types(m);
    wasm_reachability(m);
    wasm_collect_imports(m);
    for f in p.funcs {
        if !m.reach.contains(f.name) {
            continue;
        }
        if f.is_async {
            wasm_reserve(m, f.name + "$new", wasm_new_sig(m, f));
            wasm_reserve(
                m,
                f.name + "$step",
                wasm_sig(wasm_v1(wasm_lookup(m.frame, f.name)), wasm_v1(wasm_i32_t())),
            );
        } else {
            wasm_reserve(m, f.name, wasm_func_sig(m, f));
        }
    }
    for f in p.funcs {
        if !m.reach.contains(f.name) {
            continue;
        }
        if f.is_async {
            wasm_gen_new(m, f);
            wasm_gen_step(m, f);
        } else {
            wasm_gen_sync(m, f);
        }
    }
    if p.entry == "handler" {
        wasm_gen_handler_exports(m);
        wasm_gen_js_exports(m);
    } else if p.entry == "main" {
        wasm_gen_start(m);
    }
    if m.err != "" {
        return WasmOutput { wasm: Vec::new(), err: m.err };
    }
    let bytes = wasm_encode(m);
    WasmOutput { wasm: bytes, err: m.err }
}

// ---- types ----

fn wasm_i16_storage() -> Int {
    -119
}

fn wasm_val(m: WasmMod, t: IrTy) -> Int {
    let k = t.kind;
    if k == "unit" || k == "bool" {
        return wasm_i32_t();
    }
    if k == "int" {
        return wasm_i64_t();
    }
    if k == "string" {
        return m.chars_t;
    }
    if k == "ext" {
        if t.ext == "__Chars" {
            return m.chars_t;
        }
        return wasm_any_t();
    }
    if k == "agg" {
        if wasm_td(m, t.agg).coll == "map" {
            return m.map_t;
        }
        return wasm_at(m.agg_type, t.agg);
    }
    wasm_fail(m, "bad type " + k);
    wasm_i32_t()
}

fn wasm_comp(fields: Vec<Int>, mutable: Bool, array: Bool) -> WasmComp {
    let muts = Vec::new();
    for f in fields {
        muts.push(mutable);
    }
    WasmComp { fields: fields, muts: muts, array: array }
}

// wasm_agg_named returns the IR aggregate named name (a prelude struct), or -1.
fn wasm_agg_named(m: WasmMod, name: String) -> Int {
    let mut i = 0;
    for td in m.prog.types {
        if td.name == name && td.coll == "" {
            return i;
        }
        i = i + 1;
    }
    -1
}

fn wasm_layout_types(m: WasmMod) {
    let p = m.prog;
    let n = p.types.len();
    for i in 0..n {
        m.agg_type.push(-1);
        m.vec_arr.push(-1);
        m.agg_slots.push(Vec::new());
    }
    // assign indices first: types may be (mutually) recursive
    let mut next = 0;
    for i in 0..n {
        let td = wasm_td(m, i);
        if td.coll == "map" {
            continue;
        }
        if td.coll == "vec" {
            m.agg_type.set(i, next);
            m.vec_arr.set(i, next + 1);
            next = next + 2;
        } else {
            m.agg_type.set(i, next);
            next = next + 1;
        }
    }
    m.chars_t = next;
    m.lits_t = next + 1;
    m.box_t = next + 2;
    next = next + 3;
    let map_agg = wasm_agg_named(m, "__Map");
    m.map_t = if map_agg >= 0 { wasm_at(m.agg_type, map_agg) } else { m.box_t };
    for i in 0..next {
        m.structs.push(wasm_comp(Vec::new(), true, false));
    }
    for i in 0..n {
        let td = wasm_td(m, i);
        if td.coll == "map" {
            continue;
        }
        let at = wasm_at(m.agg_type, i);
        if td.coll == "vec" {
            let va = wasm_at(m.vec_arr, i);
            m.structs.set(at, wasm_comp(wasm_v2(wasm_i32_t(), va), true, false));
            m.structs.set(va, wasm_comp(wasm_v1(wasm_val(m, td.elem)), true, true));
        } else if !td.is_variant {
            let fields = Vec::new();
            for f in td.fields {
                fields.push(wasm_val(m, f));
            }
            m.structs.set(at, wasm_comp(fields, true, false));
        } else {
            let fields = wasm_v1(wasm_i32_t()); // tag
            let slots = Vec::new();
            for vs in td.variants {
                let s = Vec::new();
                for f in vs {
                    s.push(fields.len());
                    fields.push(wasm_val(m, f));
                }
                slots.push(s);
            }
            m.agg_slots.set(i, slots);
            m.structs.set(at, wasm_comp(fields, false, false));
        }
    }
    m.structs.set(m.chars_t, wasm_comp(wasm_v1(wasm_i16_storage()), true, true));
    m.structs.set(m.lits_t, wasm_comp(wasm_v1(m.chars_t), true, true));
    m.structs.set(m.box_t, wasm_comp(wasm_v1(wasm_i64_t()), false, false));
    for f in p.funcs {
        if !f.is_async {
            continue;
        }
        let fields = wasm_v3(wasm_i32_t(), wasm_struct_t(), wasm_val(m, f.result));
        for l in f.locals {
            fields.push(wasm_val(m, l));
        }
        m.frame.insert(f.name, m.structs.len());
        m.structs.push(wasm_comp(fields, true, false));
    }
}

// frame struct fields: 0 state, 1 child, 2 ret, 3.. locals

fn wasm_func_sig(m: WasmMod, f: IrFunc) -> WasmSig {
    let params = Vec::new();
    for i in 0..f.nparams {
        params.push(wasm_val(m, wasm_ty_at(f.locals, i)));
    }
    wasm_sig(params, wasm_v1(wasm_val(m, f.result)))
}

fn wasm_new_sig(m: WasmMod, f: IrFunc) -> WasmSig {
    let s = wasm_func_sig(m, f);
    wasm_sig(s.params, wasm_v1(wasm_lookup(m.frame, f.name)))
}

// ---- operations: how each host operation is implemented ----

// wasm_js_op reports the operations that Workers programs import from the
// JS host.
fn wasm_js_op(name: String) -> Bool {
    name.starts_with("log.")
        || name.starts_with("clock.")
        || name.starts_with("random.")
        || name.starts_with("net.")
        || name.starts_with("db.")
        || name.starts_with("tx.")
        || name.starts_with("request.")
}

fn wasm_is_intrinsic(name: String) -> Bool {
    name.starts_with("__Chars.")
        || name.starts_with("__Mem.")
        || name.starts_with("__Any.")
        || name.starts_with("__Int.")
        || name.starts_with("__Wasi.")
        || name.starts_with("__Js.")
        || name == "__Rt.get"
        || name.ends_with(".from_any")
        || name.ends_with(".to_any")
}

// wasm_prelude_name is the prelude function implementing operation name.
fn wasm_prelude_name(name: String) -> String {
    "__" + name.replace(".", "_")
}

// wasm_op_kind classifies a host operation: "intrinsic", "coll", "int"
// (inline bit operation), "import" (JS host) or "prelude".
fn wasm_op_kind(m: WasmMod, name: String) -> String {
    if wasm_is_intrinsic(name) {
        return "intrinsic";
    }
    if wasm_is_collection_op(name) && name != "vec.join" {
        return "coll";
    }
    if wasm_is_inline_int_op(name) {
        return "int";
    }
    if m.target == "workers" && wasm_js_op(name) {
        return "import";
    }
    "prelude"
}

// ---- reachability ----

fn wasm_reach_add(m: WasmMod, work: Vec<String>, name: String) {
    if m.reach.contains(name) {
        return;
    }
    if !m.prog_func.contains(name) {
        return;
    }
    m.reach.insert(name, true);
    work.push(name);
}

// wasm_op_deps lists the prelude functions that the code for an
// instruction calls.
fn wasm_op_deps(m: WasmMod, f: IrFunc, ins: IrInstr) -> Vec<String> {
    let deps = Vec::new();
    if ins.op == "call" {
        deps.push(ins.name);
    } else if ins.op == "binop" {
        if wasm_ty_at(f.locals, wasm_at(ins.args, 0)).kind == "string" {
            deps.push("__string_eq");
            deps.push("__string_concat");
        }
    } else if ins.op == "host" || ins.op == "await" {
        let k = wasm_op_kind(m, ins.name);
        if k == "prelude" {
            deps.push(wasm_prelude_name(ins.name));
        } else if k == "coll" && ins.name.starts_with("map.") {
            for d in "__map_new __map_find_int __map_find_str __map_insert_int __map_insert_str __map_val __map_remove_int __map_remove_str __map_len __map_keys_int __map_keys_str".split(
                " ",
            ) {
                deps.push(d);
            }
        } else if k == "intrinsic" && ins.name == "__Rt.get" {
            deps.push("__rt_new");
        } else if k == "import" {
            // results are converted from JS values
            for d in "__js_string __js_from_string __js_lift_TxError __js_lift_NetError __js_lift_IoError".split(
                " ",
            ) {
                deps.push(d);
            }
        }
    }
    deps
}

fn wasm_reachability(m: WasmMod) {
    let work = Vec::new();
    if m.prog.handler != "" {
        wasm_reach_add(m, work, m.prog.handler);
    }
    if m.prog.entry == "main" {
        wasm_reach_add(m, work, "__args");
        wasm_reach_add(m, work, "__exit");
    }
    if m.prog.entry == "handler" {
        for f in m.prog.funcs {
            if f.name.starts_with("__js_export_") {
                wasm_reach_add(m, work, f.name);
            }
        }
    }
    while work.len() > 0 {
        let name = work.pop().unwrap_or("");
        let f = match m.prog.funcs.get(wasm_lookup(m.prog_func, name)) {
            Some(x) => x,
            None => {
                continue;
            }
        };
        for b in f.blocks {
            for ins in b.instrs {
                for d in wasm_op_deps(m, f, ins) {
                    wasm_reach_add(m, work, d);
                }
            }
        }
    }
}

// ---- imports and functions ----

fn wasm_add_import(m: WasmMod, module: String, name: String, s: WasmSig, is_async: Bool) {
    let key = module + "." + name;
    match m.import_idx.get(key) {
        Some(i) => {
            match m.imports.get(i) {
                Some(im) => {
                    if wasm_sig_key(im.sig) != wasm_sig_key(s) {
                        wasm_fail(m, "inconsistent signature for host operation " + name);
                    }
                }
                None => {}
            }
            return;
        }
        None => {}
    }
    m.import_idx.insert(key, m.imports.len());
    m.imports.push(WasmImport { module: module, name: name, sig: s, is_async: is_async });
}

fn wasm_kek_import(m: WasmMod, name: String, params: Vec<Int>, results: Vec<Int>) {
    wasm_add_import(m, "kek", name, wasm_sig(params, results), false);
}

// wasm_add_js_helper_imports: conversions of JS values (Workers).
fn wasm_add_js_helper_imports(m: WasmMod) {
    let i32 = wasm_i32_t();
    let i64 = wasm_i64_t();
    let any = wasm_any_t();
    wasm_kek_import(m, "take", wasm_v0(), wasm_v1(any));
    wasm_kek_import(m, "is_null", wasm_v1(any), wasm_v1(i32));
    wasm_kek_import(m, "to_i64", wasm_v1(any), wasm_v1(i64));
    wasm_kek_import(m, "to_i32", wasm_v1(any), wasm_v1(i32));
    wasm_kek_import(m, "res_tag", wasm_v1(any), wasm_v1(i32));
    wasm_kek_import(m, "res_val", wasm_v1(any), wasm_v1(any));
    wasm_kek_import(m, "res_err", wasm_v1(any), wasm_v1(any));
    wasm_kek_import(m, "arr_new", wasm_v0(), wasm_v1(any));
    wasm_kek_import(m, "arr_len", wasm_v1(any), wasm_v1(i32));
    wasm_kek_import(m, "arr_get", wasm_v2(any, i32), wasm_v1(any));
    wasm_kek_import(m, "arr_push", wasm_v2(any, any), wasm_v0());
    wasm_kek_import(m, "box_i64", wasm_v1(i64), wasm_v1(any));
    wasm_kek_import(m, "box_i32", wasm_v1(i32), wasm_v1(any));
}

// wasm_wasi_sig is the signature of a WASI preview 1 function: i32
// parameters except the 64-bit ones, an i32 errno result.
fn wasm_wasi_sig(name: String, n: Int) -> WasmSig {
    let params = Vec::new();
    for i in 0..n {
        let wide = (name == "clock_time_get" && i == 1)
            || (name == "fd_readdir" && i == 3)
            || (name == "path_open" && (i == 5 || i == 6));
        params.push(if wide { wasm_i64_t() } else { wasm_i32_t() });
    }
    if name == "proc_exit" {
        return wasm_sig(params, wasm_v0());
    }
    wasm_sig(params, wasm_v1(wasm_i32_t()))
}

// wasm_js_intrinsic_sig: `__Js::name` imports (Workers).
fn wasm_js_intrinsic_sig(name: String) -> WasmSig {
    let i32 = wasm_i32_t();
    let any = wasm_any_t();
    if name == "str_len" {
        return wasm_sig(wasm_v1(any), wasm_v1(i32));
    }
    if name == "str_to_mem" {
        return wasm_sig(wasm_v2(any, i32), wasm_v0());
    }
    if name == "str_from_mem" {
        return wasm_sig(wasm_v2(i32, i32), wasm_v1(any));
    }
    if name == "err_message" {
        return wasm_sig(wasm_v1(any), wasm_v1(any));
    }
    if name == "err_retryable" {
        return wasm_sig(wasm_v1(any), wasm_v1(i32));
    }
    if name == "is_null" {
        return wasm_sig(wasm_v1(any), wasm_v1(i32));
    }
    wasm_sig(wasm_v0(), wasm_v0())
}

// wasm_host_param is the import parameter type for an IR value passed to
// the JS host: strings and Vecs are converted to JS values.
fn wasm_host_param(m: WasmMod, t: IrTy) -> Int {
    if t.kind == "string" || wasm_is_vec(m, t) {
        return wasm_any_t();
    }
    if t.kind == "agg" {
        return wasm_any_t();
    }
    wasm_val(m, t)
}

// wasm_host_result maps an IR result type to the import's result type.
fn wasm_host_result(m: WasmMod, t: IrTy) -> Vec<Int> {
    if t.kind == "unit" {
        return Vec::new();
    }
    if t.kind == "agg" || t.kind == "string" {
        return wasm_v1(wasm_any_t());
    }
    wasm_v1(wasm_val(m, t))
}

fn wasm_collect_imports(m: WasmMod) {
    if m.target == "workers" {
        wasm_add_js_helper_imports(m);
    }
    for f in m.prog.funcs {
        if !m.reach.contains(f.name) {
            continue;
        }
        for b in f.blocks {
            for ins in b.instrs {
                if ins.op != "host" && ins.op != "await" {
                    continue;
                }
                let name = ins.name;
                if name.starts_with("__Wasi.") {
                    if m.target != "wasi" {
                        wasm_fail(m, "WASI is not available to Workers programs (" + f.name + ")");
                    }
                    let w = name.slice(7, name.len());
                    wasm_add_import(
                        m,
                        "wasi_snapshot_preview1",
                        w,
                        wasm_wasi_sig(w, ins.args.len()),
                        false,
                    );
                    continue;
                }
                if name.starts_with("__Js.") {
                    if m.target != "workers" {
                        wasm_fail(m, "the JS host is not available to command-line programs (" + f.name + ")");
                    }
                    let j = name.slice(5, name.len());
                    wasm_add_import(m, "kek", j, wasm_js_intrinsic_sig(j), false);
                    continue;
                }
                if wasm_op_kind(m, name) != "import" {
                    continue;
                }
                let params = Vec::new();
                for a in ins.args {
                    params.push(wasm_host_param(m, wasm_ty_at(f.locals, a)));
                }
                let mut results = Vec::new();
                if ins.op == "host" {
                    results = wasm_host_result(m, wasm_ty_at(f.locals, ins.dst));
                }
                wasm_add_import(m, "kek", name, wasm_sig(params, results), ins.op == "await");
            }
        }
    }
}

fn wasm_reserve(m: WasmMod, name: String, s: WasmSig) -> Int {
    match m.func_idx.get(name) {
        Some(i) => {
            return i;
        }
        None => {}
    }
    let i = m.imports.len() + m.funcs.len();
    m.func_idx.insert(name, i);
    m.funcs.push(WasmFunc {
        name: name,
        sig: s,
        locals: Vec::new(),
        body: Vec::new(),
        export: "",
        built: false,
    });
    i
}

fn wasm_def(m: WasmMod, name: String) -> WasmFunc {
    match m.funcs.get(wasm_lookup(m.func_idx, name) - m.imports.len()) {
        Some(f) => f,
        None => {
            wasm_fail(m, "unknown function " + name);
            WasmFunc {
                name: name,
                sig: wasm_sig(Vec::new(), Vec::new()),
                locals: Vec::new(),
                body: Vec::new(),
                export: "",
                built: true,
            }
        }
    }
}

fn wasm_imp(m: WasmMod, name: String) -> Int {
    wasm_lookup(m.import_idx, "kek." + name)
}

// wasm_prelude_func returns the function index of a prelude function
// (which must be reachable).
fn wasm_prelude_func(m: WasmMod, name: String) -> Int {
    match m.func_idx.get(name) {
        Some(i) => i,
        None => {
            wasm_fail(m, "runtime prelude function " + name + " is missing");
            0
        }
    }
}

// wasm_prelude_ir returns the IR of a prelude function.
fn wasm_prelude_ir(m: WasmMod, name: String) -> Option<IrFunc> {
    m.prog.funcs.get(wasm_lookup(m.prog_func, name))
}

// ---- string literals ----

// wasm_lit registers a literal; its UTF-16 code units are stored in the
// passive data segment.
fn wasm_lit(m: WasmMod, s: String) -> Int {
    match m.string_idx.get(s) {
        Some(i) => {
            return i;
        }
        None => {}
    }
    let i = m.strings.len();
    m.string_idx.insert(s, i);
    m.strings.push(s);
    m.string_off.push(m.data_len);
    m.data_len = m.data_len + s.len() * 2;
    i
}

// wasm_lit_func: (index, byte offset, length) -> string, cached in the
// global literal table.
fn wasm_lit_func(m: WasmMod) -> Int {
    let name = "$lit";
    match m.func_idx.get(name) {
        Some(i) => {
            return i;
        }
        None => {}
    }
    let i32 = wasm_i32_t();
    let d = wasm_helper_begin(
        m,
        name,
        wasm_sig(wasm_v3(i32, i32, i32), wasm_v1(m.chars_t)),
        wasm_v1(m.chars_t),
    );
    let c = d.body;
    cg_global_get(c, 0);
    cg_get(c, 0);
    cg_gc(c, 11); // array.get
    wasm_u32(c, m.lits_t);
    cg_tee(c, 3);
    cg_op(c, 209); // ref.is_null
    cg_open(c, 4); // if
    cg_get(c, 1);
    cg_get(c, 2);
    cg_gc(c, 9); // array.new_data
    wasm_u32(c, m.chars_t);
    wasm_u32(c, 0);
    cg_set(c, 3);
    cg_global_get(c, 0);
    cg_get(c, 0);
    cg_get(c, 3);
    cg_gc(c, 14); // array.set
    wasm_u32(c, m.lits_t);
    cg_end(c);
    cg_get(c, 3);
    wasm_helper_end(m, d)
}

fn cg_string_lit(m: WasmMod, c: Vec<Int>, s: String) {
    let i = wasm_lit(m, s);
    cg_i32(c, i);
    cg_i32(c, wasm_at(m.string_off, i));
    cg_i32(c, s.len());
    cg_call(c, wasm_lit_func(m));
}

// ---- helpers: total division ----

// wasm_div_func implements truncating division with x/0 = 0 and MIN/-1 = MIN.
fn wasm_div_func(m: WasmMod) -> Int {
    let name = "$div";
    match m.func_idx.get(name) {
        Some(i) => {
            return i;
        }
        None => {}
    }
    let i64 = wasm_i64_t();
    let i = wasm_reserve(m, name, wasm_sig(wasm_v2(i64, i64), wasm_v1(i64)));
    let f = wasm_def(m, name);
    let c = f.body;
    // if y == 0 { return 0 }
    cg_get(c, 1);
    cg_op(c, 80); // i64.eqz
    cg_open(c, 4); // if
    cg_i64(c, 0);
    cg_op(c, 15); // return
    cg_end(c);
    // if y == -1 { return 0 - x }
    cg_get(c, 1);
    cg_i64(c, -1);
    cg_op(c, 81); // i64.eq
    cg_open(c, 4);
    cg_i64(c, 0);
    cg_get(c, 0);
    cg_op(c, 125); // i64.sub
    cg_op(c, 15);
    cg_end(c);
    cg_get(c, 0);
    cg_get(c, 1);
    cg_op(c, 127); // i64.div_s
    cg_end(c);
    f.built = true;
    i
}

// wasm_rem_func implements x rem 0 = x.
fn wasm_rem_func(m: WasmMod) -> Int {
    let name = "$rem";
    match m.func_idx.get(name) {
        Some(i) => {
            return i;
        }
        None => {}
    }
    let i64 = wasm_i64_t();
    let i = wasm_reserve(m, name, wasm_sig(wasm_v2(i64, i64), wasm_v1(i64)));
    let f = wasm_def(m, name);
    let c = f.body;
    cg_get(c, 1);
    cg_op(c, 80); // i64.eqz
    cg_open(c, 4);
    cg_get(c, 0);
    cg_op(c, 15);
    cg_end(c);
    cg_get(c, 0);
    cg_get(c, 1);
    cg_op(c, 129); // i64.rem_s
    cg_end(c);
    f.built = true;
    i
}

// ---- the runtime state ----

// wasm_rt_func: `__Rt::get()`, creating the state on first use.
fn wasm_rt_func(m: WasmMod) -> Int {
    let name = "$rt";
    match m.func_idx.get(name) {
        Some(i) => {
            return i;
        }
        None => {}
    }
    let rt = wasm_agg_named(m, "__Rt");
    let rt_t = wasm_at(m.agg_type, rt);
    let d = wasm_helper_begin(m, name, wasm_sig(wasm_v0(), wasm_v1(rt_t)), wasm_v0());
    let c = d.body;
    cg_global_get(c, 1);
    cg_op(c, 209); // ref.is_null
    cg_open(c, 4);
    cg_call(c, wasm_prelude_func(m, "__rt_new"));
    cg_global_set(c, 1);
    cg_end(c);
    cg_global_get(c, 1);
    cg_cast_null(c, rt_t);
    wasm_helper_end(m, d)
}

// ---- conversions from JS values (Workers) ----

// wasm_lift_to emits code converting the JS value (anyref) on the stack to
// a value of type t.
fn wasm_lift_to(m: WasmMod, c: Vec<Int>, t: IrTy) {
    let k = t.kind;
    if k == "unit" {
        cg_op(c, 26); // drop
        cg_i32(c, 0);
    } else if k == "int" {
        cg_call(c, wasm_imp(m, "to_i64"));
    } else if k == "bool" {
        cg_call(c, wasm_imp(m, "to_i32"));
    } else if k == "string" {
        cg_call(c, wasm_prelude_func(m, "__js_string"));
    } else if k == "agg" {
        let td = wasm_td(m, t.agg);
        if td.coll == "vec" {
            cg_call(c, wasm_vec_from_host_func(m, t.agg));
        } else if td.coll == "map" {
            wasm_fail(m, "cannot convert a JS value into a Map");
        } else if !td.is_variant {
            cg_call(c, wasm_prelude_func(m, "__js_lift_" + td.name));
        } else {
            cg_call(c, wasm_lift_func(m, t.agg));
        }
    }
}

// wasm_lift_build emits struct.new for agg with only tag's fields filled.
// mode selects how a filled field is produced: 1 lift the parameter,
// 2 lift res_val(param), 3 lift res_err(param).
fn wasm_lift_build(m: WasmMod, c: Vec<Int>, agg: Int, tag: Int, mode: Int) {
    let td = wasm_td(m, agg);
    cg_i32(c, tag);
    let mut t2 = 0;
    for vs in td.variants {
        for ft in vs {
            if t2 == tag {
                cg_get(c, 0);
                if mode == 2 {
                    cg_call(c, wasm_imp(m, "res_val"));
                } else if mode == 3 {
                    cg_call(c, wasm_imp(m, "res_err"));
                }
                wasm_lift_to(m, c, ft);
            } else {
                cg_default(c, wasm_val(m, ft));
            }
        }
        t2 = t2 + 1;
    }
    cg_struct_new(c, wasm_at(m.agg_type, agg));
}

fn wasm_lift_func(m: WasmMod, agg: Int) -> Int {
    match m.lifts.get(agg) {
        Some(i) => {
            return i;
        }
        None => {}
    }
    let name = "$lift" + agg.to_string();
    let result = wasm_at(m.agg_type, agg);
    let i = wasm_reserve(m, name, wasm_sig(wasm_v1(wasm_any_t()), wasm_v1(result)));
    m.lifts.insert(agg, i);
    let f = wasm_def(m, name);
    let td = wasm_td(m, agg);
    let c = f.body;
    let v0 = wasm_tys_at(td.variants, 0);
    let v1 = wasm_tys_at(td.variants, 1);
    if td.variants.len() == 2 && v0.len() == 0 && v1.len() == 1 {
        // Option: null => None
        cg_get(c, 0);
        cg_call(c, wasm_imp(m, "is_null"));
        cg_op(c, 4); // if
        wasm_valtype(c, result);
        wasm_lift_build(m, c, agg, 0, 1);
        cg_op(c, 5); // else
        wasm_lift_build(m, c, agg, 1, 1);
        cg_end(c);
    } else if td.variants.len() == 2 && v0.len() == 1 && v1.len() == 1 {
        // Result: {ok, value} / {ok: false, error}
        cg_get(c, 0);
        cg_call(c, wasm_imp(m, "res_tag"));
        cg_op(c, 69); // i32.eqz
        cg_op(c, 4);
        wasm_valtype(c, result);
        wasm_lift_build(m, c, agg, 0, 2);
        cg_op(c, 5);
        wasm_lift_build(m, c, agg, 1, 3);
        cg_end(c);
    } else {
        wasm_fail(m, "cannot convert a JS value into " + td.name);
    }
    cg_end(c);
    f.built = true;
    i
}

// wasm_to_host converts the wasm value on the stack (of IR type t) into a
// JS value for an import.
fn wasm_to_host(m: WasmMod, c: Vec<Int>, t: IrTy) {
    if t.kind == "string" {
        cg_call(c, wasm_prelude_func(m, "__js_from_string"));
    } else if wasm_is_vec(m, t) {
        cg_call(c, wasm_vec_to_host_func(m, t.agg));
    }
}

// ---- function bodies ----

struct CgSeg {
    block: Int,
    start: Int, // instruction index where the segment starts
    // resume marks a segment that begins by completing a suspension of the
    // instruction at index start
    resume: Bool,
}

struct CgGen {
    m: WasmMod,
    f: IrFunc,
    is_async: Bool,
    c: Vec<Int>,
    local: Vec<Int>, // wasm local index of each IR local
    locals: Vec<Int>, // declared wasm locals (excluding params)
    state: Int,
    child: Int,
    frame_l: Int,
    frame_t: Int,
    segs: Vec<CgSeg>,
    block_seg: Vec<Int>,
    nseg: Int,
    cur: Int,
}

fn cg_local(g: CgGen, i: Int) -> Int {
    wasm_at(g.local, i)
}

fn cg_ty(g: CgGen, i: Int) -> IrTy {
    wasm_ty_at(g.f.locals, i)
}

fn cg_is_suspend(g: CgGen, ins: IrInstr) -> Bool {
    if !g.is_async {
        return false;
    }
    if ins.op == "await" {
        // operations of the prelude complete synchronously
        return wasm_op_kind(g.m, ins.name) == "import";
    }
    if ins.op == "call" {
        match g.m.prog_func.get(ins.name) {
            Some(fi) => match g.m.prog.funcs.get(fi) {
                Some(callee) => {
                    return callee.is_async;
                }
                None => {}
            },
            None => {}
        }
    }
    false
}

fn cg_plan_segments(g: CgGen) {
    let mut bi = 0;
    for b in g.f.blocks {
        g.block_seg.push(g.segs.len());
        g.segs.push(CgSeg { block: bi, start: 0, resume: false });
        let mut ii = 0;
        for ins in b.instrs {
            if cg_is_suspend(g, ins) {
                g.segs.push(CgSeg { block: bi, start: ii, resume: true });
            }
            ii = ii + 1;
        }
        bi = bi + 1;
    }
    g.nseg = g.segs.len();
}

// cg_loop_depth is the br depth of the dispatcher loop from the current segment.
fn cg_loop_depth(g: CgGen) -> Int {
    g.nseg - g.cur
}

fn cg_goto_seg(g: CgGen, s: Int) {
    cg_i32(g.c, s);
    cg_set(g.c, g.state);
    cg_br(g.c, cg_loop_depth(g));
}

fn cg_save_all(g: CgGen) {
    let c = g.c;
    let mut i = 0;
    for l in g.local {
        cg_get(c, g.frame_l);
        cg_get(c, l);
        cg_struct_set(c, g.frame_t, 3 + i);
        i = i + 1;
    }
    cg_get(c, g.frame_l);
    cg_get(c, g.child);
    cg_struct_set(c, g.frame_t, 1);
}

fn cg_suspend(g: CgGen, resume_seg: Int) {
    let c = g.c;
    cg_save_all(g);
    cg_get(c, g.frame_l);
    cg_i32(c, resume_seg);
    cg_struct_set(c, g.frame_t, 0);
    cg_i32(c, 1);
    cg_op(c, 15); // return
}

fn cg_body(g: CgGen) {
    let c = g.c;
    cg_plan_segments(g);
    cg_open(c, 3); // loop
    for i in 0..g.nseg + 1 {
        cg_open(c, 2); // block
    }
    cg_get(c, g.state);
    cg_op(c, 14); // br_table
    wasm_u32(c, g.nseg);
    for i in 0..g.nseg {
        wasm_u32(c, i);
    }
    wasm_u32(c, g.nseg);
    cg_end(c); // B_0
    for s in 0..g.nseg {
        g.cur = s;
        cg_segment(g, s);
        cg_end(c);
    }
    cg_op(c, 0); // default: invalid state
    cg_end(c); // loop
    cg_op(c, 0);
    cg_end(c); // function
}

fn cg_segment(g: CgGen, s: Int) {
    let seg = match g.segs.get(s) {
        Some(x) => x,
        None => CgSeg { block: 0, start: 0, resume: false },
    };
    let b = match g.f.blocks.get(seg.block) {
        Some(x) => x,
        None => {
            wasm_fail(g.m, "bad block");
            return;
        }
    };
    let mut i = seg.start;
    if seg.resume {
        match b.instrs.get(i) {
            Some(ins) => cg_resume(g, ins, s),
            None => {}
        }
        i = i + 1;
    }
    let n = b.instrs.len();
    while i < n {
        match b.instrs.get(i) {
            Some(ins) => {
                if cg_is_suspend(g, ins) {
                    cg_start_suspend(g, ins, s + 1);
                    return;
                }
                cg_instr(g, ins);
            }
            None => {}
        }
        i = i + 1;
    }
    cg_term(g, b.term);
}

fn cg_start_suspend(g: CgGen, ins: IrInstr, resume_seg: Int) {
    let c = g.c;
    if ins.op == "await" {
        for a in ins.args {
            cg_get(c, cg_local(g, a));
            wasm_to_host(g.m, c, cg_ty(g, a));
        }
        cg_call(c, wasm_imp(g.m, ins.name));
        cg_suspend(g, resume_seg);
        return;
    }
    // async call: allocate the callee frame, then step it in the resume segment
    for a in ins.args {
        cg_get(c, cg_local(g, a));
    }
    cg_call(c, wasm_lookup(g.m.func_idx, ins.name + "$new"));
    cg_set(c, g.child);
    cg_goto_seg(g, resume_seg);
}

fn cg_resume(g: CgGen, ins: IrInstr, s: Int) {
    let c = g.c;
    let dst_ty = cg_ty(g, ins.dst);
    if ins.op == "await" {
        cg_call(c, wasm_imp(g.m, "take"));
        wasm_lift_to(g.m, c, dst_ty);
        cg_set(c, cg_local(g, ins.dst));
        return;
    }
    let ft = wasm_lookup(g.m.frame, ins.name);
    cg_get(c, g.child);
    cg_cast_null(c, ft);
    cg_call(c, wasm_lookup(g.m.func_idx, ins.name + "$step"));
    cg_open(c, 4); // if
    // still suspended: propagate
    cg_suspend(g, s);
    cg_end(c);
    cg_get(c, g.child);
    cg_cast_null(c, ft);
    cg_struct_get(c, ft, 2);
    cg_set(c, cg_local(g, ins.dst));
}

fn cg_arg(g: CgGen, ins: IrInstr, k: Int) {
    cg_get(g.c, cg_local(g, wasm_at(ins.args, k)));
}

// cg_call_prelude calls the prelude function implementing an operation;
// the arguments must have the parameter types of the function.
fn cg_call_prelude(g: CgGen, ins: IrInstr, fname: String) {
    let m = g.m;
    let pf = match wasm_prelude_ir(m, fname) {
        Some(f) => f,
        None => {
            wasm_fail(
                m,
                "`" + ins.name + "` is not available to "
                    + if m.target == "wasi" { "command-line programs" } else { "Workers programs" }
                    + " (in " + g.f.name + ")",
            );
            return;
        }
    };
    if pf.nparams != ins.args.len() {
        wasm_fail(m, "runtime prelude: " + fname + " takes " + pf.nparams.to_string() + " arguments");
        return;
    }
    for k in 0..ins.args.len() {
        let at = cg_ty(g, wasm_at(ins.args, k));
        if wasm_val(m, at) != wasm_val(m, wasm_ty_at(pf.locals, k)) {
            wasm_fail(m, "runtime prelude: parameter " + k.to_string() + " of " + fname + " has the wrong type");
        }
        cg_arg(g, ins, k);
    }
    cg_call(g.c, wasm_prelude_func(m, fname));
    if wasm_val(m, pf.result) != wasm_val(m, cg_ty(g, ins.dst)) {
        wasm_fail(m, "runtime prelude: the result of " + fname + " has the wrong type");
    }
}

fn cg_instr(g: CgGen, ins: IrInstr) {
    let c = g.c;
    let m = g.m;
    let dst = cg_local(g, ins.dst);
    let dst_ty = cg_ty(g, ins.dst);
    let op = ins.op;
    if op == "const" {
        let k = ins.cst.kind;
        if k == "int" {
            cg_i64(c, ins.cst.int_val);
        } else if k == "bool" {
            if ins.cst.bool_val {
                cg_i32(c, 1);
            } else {
                cg_i32(c, 0);
            }
        } else if k == "string" {
            cg_string_lit(m, c, ins.cst.str_val);
        } else {
            cg_i32(c, 0);
        }
    } else if op == "copy" {
        cg_arg(g, ins, 0);
    } else if op == "unop" {
        if ins.name == "neg" {
            cg_i64(c, 0);
            cg_arg(g, ins, 0);
            cg_op(c, 125); // i64.sub
        } else {
            cg_arg(g, ins, 0);
            cg_op(c, 69); // i32.eqz
        }
    } else if op == "binop" {
        cg_binop(g, ins);
    } else if op == "call" {
        for k in 0..ins.args.len() {
            cg_arg(g, ins, k);
        }
        match m.func_idx.get(ins.name) {
            Some(idx) => cg_call(c, idx),
            None => wasm_fail(m, "codegen: call to unknown or async function " + ins.name),
        }
    } else if op == "host" || op == "await" {
        let kind = wasm_op_kind(m, ins.name);
        if kind == "coll" {
            cg_coll_op(g, ins);
        } else if kind == "int" {
            cg_int_op(g, ins);
        } else if kind == "intrinsic" {
            cg_intrinsic(g, ins);
        } else if kind == "prelude" {
            cg_call_prelude(g, ins, wasm_prelude_name(ins.name));
        } else {
            for k in 0..ins.args.len() {
                cg_arg(g, ins, k);
                wasm_to_host(m, c, cg_ty(g, wasm_at(ins.args, k)));
            }
            cg_call(c, wasm_imp(m, ins.name));
            if dst_ty.kind == "unit" {
                cg_i32(c, 0);
            } else if dst_ty.kind == "agg" || dst_ty.kind == "string" {
                wasm_lift_to(m, c, dst_ty);
            }
        }
    } else if op == "struct" {
        for k in 0..ins.args.len() {
            cg_arg(g, ins, k);
        }
        cg_struct_new(c, wasm_at(m.agg_type, ins.ty));
    } else if op == "field" {
        cg_arg(g, ins, 0);
        cg_struct_get(c, wasm_at(m.agg_type, ins.ty), ins.index);
    } else if op == "setfield" {
        cg_arg(g, ins, 0);
        cg_arg(g, ins, 1);
        cg_struct_set(c, wasm_at(m.agg_type, ins.ty), ins.index);
        cg_i32(c, 0);
    } else if op == "variant" {
        let td = wasm_td(m, ins.ty);
        cg_i32(c, ins.tag);
        let mut tag = 0;
        for vs in td.variants {
            let mut k = 0;
            for ft in vs {
                if tag == ins.tag {
                    cg_arg(g, ins, k);
                } else {
                    cg_default(c, wasm_val(m, ft));
                }
                k = k + 1;
            }
            tag = tag + 1;
        }
        cg_struct_new(c, wasm_at(m.agg_type, ins.ty));
    } else if op == "tag" {
        cg_arg(g, ins, 0);
        cg_struct_get(c, wasm_at(m.agg_type, ins.ty), 0);
        cg_op(c, 173); // i64.extend_i32_u
    } else if op == "vfield" {
        cg_arg(g, ins, 0);
        let slots = m.agg_slots.get(ins.ty).unwrap_or(Vec::new());
        cg_struct_get(
            c,
            wasm_at(m.agg_type, ins.ty),
            wasm_at(slots.get(ins.tag).unwrap_or(Vec::new()), ins.index),
        );
    } else {
        wasm_fail(m, "codegen: unknown instruction " + op);
    }
    cg_set(c, dst);
}

// ---- intrinsics ----

fn cg_wrap_arg(g: CgGen, ins: IrInstr, k: Int) {
    cg_arg(g, ins, k);
    cg_op(g.c, 167); // i32.wrap_i64
}

fn cg_memarg(c: Vec<Int>, op: Int, align: Int) {
    cg_op(c, op);
    wasm_u32(c, align);
    wasm_u32(c, 0);
}

fn cg_intrinsic(g: CgGen, ins: IrInstr) {
    let c = g.c;
    let m = g.m;
    let name = ins.name;
    let dst_ty = cg_ty(g, ins.dst);
    if name == "__Chars.new" {
        cg_wrap_arg(g, ins, 0);
        cg_gc(c, 7); // array.new_default
        wasm_u32(c, m.chars_t);
    } else if name == "__Chars.of" || name == "__Chars.freeze" {
        cg_arg(g, ins, 0);
    } else if name == "__Chars.len" {
        cg_arg(g, ins, 0);
        cg_gc(c, 15); // array.len
        cg_op(c, 173); // i64.extend_i32_u
    } else if name == "__Chars.get" {
        cg_arg(g, ins, 0);
        cg_wrap_arg(g, ins, 1);
        cg_gc(c, 13); // array.get_u
        wasm_u32(c, m.chars_t);
        cg_op(c, 173);
    } else if name == "__Chars.set" {
        cg_arg(g, ins, 0);
        cg_wrap_arg(g, ins, 1);
        cg_wrap_arg(g, ins, 2);
        cg_gc(c, 14); // array.set
        wasm_u32(c, m.chars_t);
        cg_i32(c, 0);
    } else if name == "__Chars.copy" {
        // dst.copy(at, src, from, n)
        cg_arg(g, ins, 0);
        cg_wrap_arg(g, ins, 1);
        cg_arg(g, ins, 2);
        cg_wrap_arg(g, ins, 3);
        cg_wrap_arg(g, ins, 4);
        cg_gc(c, 17); // array.copy
        wasm_u32(c, m.chars_t);
        wasm_u32(c, m.chars_t);
        cg_i32(c, 0);
    } else if name == "__Any.null" {
        cg_ref_null(c, 110);
    } else if name == "__Any.is_null" {
        cg_arg(g, ins, 0);
        cg_op(c, 209); // ref.is_null
    } else if name == "__Int.rem_u" || name == "__Int.div_u" || name == "__Int.lt_u" {
        cg_arg(g, ins, 0);
        cg_arg(g, ins, 1);
        cg_op(c, if name == "__Int.rem_u" { 130 } else if name == "__Int.div_u" { 128 } else { 84 });
    } else if name.starts_with("__Mem.load") {
        cg_wrap_arg(g, ins, 0);
        let w = name.slice(10, name.len());
        if w == "8" {
            cg_memarg(c, 49, 0); // i64.load8_u
        } else if w == "16" {
            cg_memarg(c, 51, 1); // i64.load16_u
        } else if w == "32" {
            cg_memarg(c, 53, 2); // i64.load32_u
        } else {
            cg_memarg(c, 41, 3); // i64.load
        }
    } else if name.starts_with("__Mem.store") {
        cg_wrap_arg(g, ins, 0);
        cg_arg(g, ins, 1);
        let w = name.slice(11, name.len());
        if w == "8" {
            cg_memarg(c, 60, 0); // i64.store8
        } else if w == "16" {
            cg_memarg(c, 61, 1); // i64.store16
        } else if w == "32" {
            cg_memarg(c, 62, 2); // i64.store32
        } else {
            cg_memarg(c, 55, 3); // i64.store
        }
        cg_i32(c, 0);
    } else if name == "__Mem.size" {
        cg_op(c, 63); // memory.size
        cg_op(c, 0);
        cg_op(c, 173);
    } else if name == "__Mem.grow" {
        cg_wrap_arg(g, ins, 0);
        cg_op(c, 64); // memory.grow
        cg_op(c, 0);
        cg_op(c, 172); // i64.extend_i32_s
    } else if name.starts_with("__Wasi.") {
        let w = name.slice(7, name.len());
        let s = wasm_wasi_sig(w, ins.args.len());
        for k in 0..ins.args.len() {
            cg_arg(g, ins, k);
            if wasm_at(s.params, k) == wasm_i32_t() {
                cg_op(c, 167); // i32.wrap_i64
            }
        }
        cg_call(c, wasm_lookup(m.import_idx, "wasi_snapshot_preview1." + w));
        if s.results.len() == 0 {
            cg_i64(c, 0);
        } else {
            cg_op(c, 173);
        }
    } else if name.starts_with("__Js.") {
        let j = name.slice(5, name.len());
        let s = wasm_js_intrinsic_sig(j);
        for k in 0..ins.args.len() {
            cg_arg(g, ins, k);
            if wasm_at(s.params, k) == wasm_i32_t() {
                cg_op(c, 167);
            }
        }
        cg_call(c, wasm_lookup(m.import_idx, "kek." + j));
        if s.results.len() == 0 {
            cg_i32(c, 0);
        } else if wasm_at(s.results, 0) == wasm_i32_t() {
            if dst_ty.kind == "int" {
                cg_op(c, 173);
            }
        }
    } else if name == "__Rt.get" {
        cg_call(c, wasm_rt_func(m));
    } else if name.ends_with(".to_any") {
        cg_arg(g, ins, 0);
    } else if name.ends_with(".from_any") {
        cg_arg(g, ins, 0);
        cg_cast_null(c, wasm_val(m, dst_ty));
    } else {
        wasm_fail(m, "codegen: unknown intrinsic " + name);
    }
}

fn cg_binop(g: CgGen, ins: IrInstr) {
    let c = g.c;
    let m = g.m;
    let x = cg_local(g, wasm_at(ins.args, 0));
    let y = cg_local(g, wasm_at(ins.args, 1));
    let kind = cg_ty(g, wasm_at(ins.args, 0)).kind;
    let name = ins.name;
    cg_get(c, x);
    cg_get(c, y);
    if kind == "int" {
        match name {
            "add" => cg_op(c, 124),
            "sub" => cg_op(c, 125),
            "mul" => cg_op(c, 126),
            "div" => cg_call(c, wasm_div_func(m)),
            "rem" => cg_call(c, wasm_rem_func(m)),
            "lt" => cg_op(c, 83),
            "le" => cg_op(c, 87),
            "gt" => cg_op(c, 85),
            "ge" => cg_op(c, 89),
            "eq" => cg_op(c, 81),
            "ne" => cg_op(c, 82),
            _ => wasm_fail(m, "codegen: bad int binop " + name),
        }
    } else if kind == "bool" || kind == "unit" {
        match name {
            "eq" => cg_op(c, 70),
            "ne" => cg_op(c, 71),
            _ => wasm_fail(m, "codegen: bad bool binop " + name),
        }
    } else if kind == "string" {
        match name {
            "eq" => cg_call(c, wasm_prelude_func(m, "__string_eq")),
            "ne" => {
                cg_call(c, wasm_prelude_func(m, "__string_eq"));
                cg_op(c, 69); // i32.eqz
            }
            "concat" => cg_call(c, wasm_prelude_func(m, "__string_concat")),
            _ => wasm_fail(m, "codegen: bad string binop " + name),
        }
    } else {
        wasm_fail(m, "codegen: binop on " + kind);
    }
}

fn cg_target_seg(g: CgGen, t: IrTerm, k: Int) -> Int {
    wasm_at(g.block_seg, wasm_at(t.targets, k))
}

fn cg_term(g: CgGen, t: IrTerm) {
    let c = g.c;
    let op = t.op;
    if op == "jump" {
        cg_goto_seg(g, cg_target_seg(g, t, 0));
    } else if op == "br" {
        cg_i32(c, cg_target_seg(g, t, 0));
        cg_i32(c, cg_target_seg(g, t, 1));
        cg_get(c, cg_local(g, wasm_at(t.args, 0)));
        cg_op(c, 27); // select
        cg_set(c, g.state);
        cg_br(c, cg_loop_depth(g));
    } else if op == "switch" {
        cg_goto_seg_dyn(g, t);
    } else if op == "ret" {
        if g.is_async {
            cg_get(c, g.frame_l);
            cg_get(c, cg_local(g, wasm_at(t.args, 0)));
            cg_struct_set(c, g.frame_t, 2);
            cg_i32(c, 0);
            cg_op(c, 15);
        } else {
            cg_get(c, cg_local(g, wasm_at(t.args, 0)));
            cg_op(c, 15);
        }
    } else {
        cg_op(c, 0); // unreachable
    }
}

// cg_goto_seg_dyn compiles a switch terminator as a chain of comparisons.
fn cg_goto_seg_dyn(g: CgGen, t: IrTerm) {
    let c = g.c;
    let n = t.targets.len() - 1;
    cg_i32(c, cg_target_seg(g, t, n));
    cg_set(c, g.state);
    for k in 0..n {
        cg_i32(c, cg_target_seg(g, t, k));
        cg_get(c, g.state);
        cg_get(c, cg_local(g, wasm_at(t.args, 0)));
        cg_i64(c, k);
        cg_op(c, 81); // i64.eq
        cg_op(c, 27); // select
        cg_set(c, g.state);
    }
    cg_br(c, cg_loop_depth(g));
}

fn cg_alloc(g: CgGen, next: Int, t: Int) -> Int {
    g.locals.push(t);
    next
}

fn cg_new_gen(m: WasmMod, f: IrFunc, is_async: Bool, nparams: Int) -> CgGen {
    let g = CgGen {
        m: m,
        f: f,
        is_async: is_async,
        c: Vec::new(),
        local: Vec::new(),
        locals: Vec::new(),
        state: 0,
        child: 0,
        frame_l: 0,
        frame_t: 0,
        segs: Vec::new(),
        block_seg: Vec::new(),
        nseg: 0,
        cur: 0,
    };
    let mut next = nparams;
    let mut i = 0;
    for t in f.locals {
        if !is_async && i < f.nparams {
            g.local.push(i);
        } else {
            g.local.push(cg_alloc(g, next, wasm_val(m, t)));
            next = next + 1;
        }
        i = i + 1;
    }
    g.state = cg_alloc(g, next, wasm_i32_t());
    next = next + 1;
    g.child = cg_alloc(g, next, wasm_struct_t());
    g
}

fn wasm_gen_sync(m: WasmMod, f: IrFunc) {
    let g = cg_new_gen(m, f, false, f.nparams);
    cg_body(g);
    let d = wasm_def(m, f.name);
    d.locals = g.locals;
    d.body = g.c;
    d.built = true;
}

fn wasm_gen_new(m: WasmMod, f: IrFunc) {
    let d = wasm_def(m, f.name + "$new");
    let c = d.body;
    cg_i32(c, 0); // state
    cg_ref_null(c, 107); // structref
    cg_default(c, wasm_val(m, f.result));
    let mut i = 0;
    for t in f.locals {
        if i < f.nparams {
            cg_get(c, i);
        } else {
            cg_default(c, wasm_val(m, t));
        }
        i = i + 1;
    }
    cg_struct_new(c, wasm_lookup(m.frame, f.name));
    cg_end(c);
    d.built = true;
}

fn wasm_gen_step(m: WasmMod, f: IrFunc) {
    let g = cg_new_gen(m, f, true, 1);
    g.frame_l = 0;
    g.frame_t = wasm_lookup(m.frame, f.name);
    let c = g.c;
    // load the frame into locals
    let mut i = 0;
    for l in g.local {
        cg_get(c, 0);
        cg_struct_get(c, g.frame_t, 3 + i);
        cg_set(c, l);
        i = i + 1;
    }
    cg_get(c, 0);
    cg_struct_get(c, g.frame_t, 1);
    cg_set(c, g.child);
    cg_get(c, 0);
    cg_struct_get(c, g.frame_t, 0);
    cg_set(c, g.state);
    cg_body(g);
    let d = wasm_def(m, f.name + "$step");
    d.locals = g.locals;
    d.body = c;
    d.built = true;
}

fn wasm_entry_func(m: WasmMod) -> Option<IrFunc> {
    let fi = wasm_lookup(m.prog_func, m.prog.handler);
    match m.prog.funcs.get(fi) {
        Some(f) => {
            if f.is_async {
                return Some(f);
            }
        }
        None => {}
    }
    wasm_fail(m, "entry point \"" + m.prog.handler + "\" must be compiled as async");
    None
}

// wasm_gen_handler_exports exports handler_new / handler_step /
// handler_result (Workers); frames are opaque to JS.
fn wasm_gen_handler_exports(m: WasmMod) {
    let f = match wasm_entry_func(m) {
        Some(x) => x,
        None => {
            return;
        }
    };
    let ft = wasm_lookup(m.frame, f.name);
    let params = Vec::new();
    for i in 0..f.nparams {
        params.push(wasm_val(m, wasm_ty_at(f.locals, i)));
    }
    wasm_reserve(m, "$handler_new", wasm_sig(params, wasm_v1(wasm_any_t())));
    let d = wasm_def(m, "$handler_new");
    for i in 0..f.nparams {
        cg_get(d.body, i);
    }
    cg_call(d.body, wasm_lookup(m.func_idx, f.name + "$new"));
    cg_end(d.body);
    d.export = "handler_new";
    d.built = true;

    wasm_reserve(m, "$handler_step", wasm_sig(wasm_v1(wasm_any_t()), wasm_v1(wasm_i32_t())));
    let d2 = wasm_def(m, "$handler_step");
    cg_get(d2.body, 0);
    cg_cast_null(d2.body, ft);
    cg_call(d2.body, wasm_lookup(m.func_idx, f.name + "$step"));
    cg_end(d2.body);
    d2.export = "handler_step";
    d2.built = true;

    wasm_reserve(m, "$handler_result", wasm_sig(wasm_v1(wasm_any_t()), wasm_v1(wasm_any_t())));
    let d3 = wasm_def(m, "$handler_result");
    cg_get(d3.body, 0);
    cg_cast_null(d3.body, ft);
    cg_struct_get(d3.body, ft, 2);
    cg_end(d3.body);
    d3.export = "handler_result";
    d3.built = true;
}

// wasm_gen_js_exports exports the prelude functions `__js_export_<name>`
// as `<name>` (Workers: reading Response values).
fn wasm_gen_js_exports(m: WasmMod) {
    for f in m.prog.funcs {
        if f.name.starts_with("__js_export_") && m.reach.contains(f.name) {
            wasm_def(m, f.name).export = f.name.slice(12, f.name.len());
        }
    }
}

// wasm_gen_start emits `_start` (WASI): run #[main] with the command-line
// arguments and exit with its result.
fn wasm_gen_start(m: WasmMod) {
    let f = match wasm_entry_func(m) {
        Some(x) => x,
        None => {
            return;
        }
    };
    let ft = wasm_lookup(m.frame, f.name);
    wasm_reserve(m, "$start", wasm_sig(wasm_v0(), wasm_v0()));
    let d = wasm_def(m, "$start");
    d.locals = wasm_v1(ft);
    let c = d.body;
    let mut i = 0;
    for p in m.prog.handler_params {
        if p.kind == "args" {
            cg_call(c, wasm_prelude_func(m, "__args"));
        } else {
            cg_default(c, wasm_val(m, wasm_ty_at(f.locals, i)));
        }
        i = i + 1;
    }
    cg_call(c, wasm_lookup(m.func_idx, f.name + "$new"));
    cg_set(c, 0);
    cg_open(c, 3); // loop
    cg_get(c, 0);
    cg_call(c, wasm_lookup(m.func_idx, f.name + "$step"));
    cg_op(c, 13); // br_if
    wasm_u32(c, 0);
    cg_end(c);
    cg_get(c, 0);
    cg_struct_get(c, ft, 2);
    cg_call(c, wasm_prelude_func(m, "__exit"));
    cg_op(c, 26); // drop
    cg_end(c);
    d.export = "_start";
    d.built = true;
}

// ---- encoding ----

fn wasm_str_less(a: String, b: String) -> Bool {
    let n = a.len();
    let k = b.len();
    let mut i = 0;
    while i < n && i < k {
        let x = a.char_at(i).unwrap_or(0);
        let y = b.char_at(i).unwrap_or(0);
        if x != y {
            return x < y;
        }
        i = i + 1;
    }
    n < k
}

fn wasm_type_of(sigs: Vec<WasmSig>, sig_idx: Map<String, Int>, base: Int, s: WasmSig) -> Int {
    let k = wasm_sig_key(s);
    match sig_idx.get(k) {
        Some(i) => {
            return i;
        }
        None => {}
    }
    let i = base + sigs.len();
    sig_idx.insert(k, i);
    sigs.push(s);
    i
}

fn wasm_sig_body(b: Vec<Int>, s: WasmSig) {
    wasm_u32(b, s.params.len());
    for p in s.params {
        wasm_valtype(b, p);
    }
    wasm_u32(b, s.results.len());
    for r in s.results {
        wasm_valtype(b, r);
    }
}

fn wasm_encode(m: WasmMod) -> Vec<Int> {
    // function types (after the rec group of struct types)
    let sigs: Vec<WasmSig> = Vec::new();
    let sig_idx: Map<String, Int> = Map::new();
    let base = m.structs.len();
    let import_types = Vec::new();
    for im in m.imports {
        import_types.push(wasm_type_of(sigs, sig_idx, base, im.sig));
    }
    let func_types = Vec::new();
    for f in m.funcs {
        if !f.built {
            wasm_fail(m, "function body not generated: " + f.name);
        }
        func_types.push(wasm_type_of(sigs, sig_idx, base, f.sig));
    }

    let out = Vec::new();
    out.push(0);
    out.push(97);
    out.push(115);
    out.push(109);
    out.push(1);
    out.push(0);
    out.push(0);
    out.push(0);

    let ts = Vec::new();
    wasm_u32(ts, sigs.len() + 1);
    ts.push(78); // 0x4e rec
    wasm_u32(ts, m.structs.len());
    for st in m.structs {
        if st.array {
            ts.push(94); // 0x5e array
        } else {
            ts.push(95); // 0x5f struct
            wasm_u32(ts, st.fields.len());
        }
        let mut i = 0;
        for f in st.fields {
            wasm_valtype(ts, f);
            if st.muts.get(i).unwrap_or(false) {
                ts.push(1);
            } else {
                ts.push(0);
            }
            i = i + 1;
        }
    }
    for s in sigs {
        ts.push(96); // 0x60 func
        wasm_sig_body(ts, s);
    }
    wasm_section(out, 1, ts);

    let is = Vec::new();
    wasm_u32(is, m.imports.len());
    let mut i = 0;
    for im in m.imports {
        wasm_name(is, im.module);
        wasm_name(is, im.name);
        is.push(0);
        wasm_u32(is, wasm_at(import_types, i));
        i = i + 1;
    }
    wasm_section(out, 2, is);

    let fs = Vec::new();
    wasm_u32(fs, m.funcs.len());
    for t in func_types {
        wasm_u32(fs, t);
    }
    wasm_section(out, 3, fs);

    // one memory (scratch space for WASI and for passing strings to JS)
    let ms = Vec::new();
    wasm_u32(ms, 1);
    ms.push(0); // no maximum
    wasm_u32(ms, 1);
    wasm_section(out, 5, ms);

    // globals: 0 the literal cache, 1 the runtime state
    let gs = Vec::new();
    wasm_u32(gs, 2);
    gs.push(99); // ref null lits
    wasm_s64(gs, m.lits_t);
    gs.push(1); // mutable
    cg_i32(gs, m.strings.len());
    cg_gc(gs, 7); // array.new_default
    wasm_u32(gs, m.lits_t);
    cg_end(gs);
    wasm_valtype(gs, wasm_any_t());
    gs.push(1);
    cg_ref_null(gs, 110);
    cg_end(gs);
    wasm_section(out, 6, gs);

    // exports sorted by name (insertion sort; names are unique)
    let exports = Vec::new();
    let names = Vec::new();
    let mut fi = 0;
    for f in m.funcs {
        if f.export != "" {
            let mut j = exports.len();
            exports.push(fi);
            names.push(f.export);
            while j > 0 && wasm_str_less(f.export, names.get(j - 1).unwrap_or("")) {
                exports.set(j, wasm_at(exports, j - 1));
                names.set(j, names.get(j - 1).unwrap_or(""));
                j = j - 1;
            }
            exports.set(j, fi);
            names.set(j, f.export);
        }
        fi = fi + 1;
    }
    let es = Vec::new();
    wasm_u32(es, exports.len() + 1);
    let mut k = 0;
    for e in exports {
        wasm_name(es, names.get(k).unwrap_or(""));
        es.push(0);
        wasm_u32(es, m.imports.len() + e);
        k = k + 1;
    }
    wasm_name(es, "memory");
    es.push(2);
    wasm_u32(es, 0);
    wasm_section(out, 7, es);

    // data count (array.new_data refers to the segment)
    let dc = Vec::new();
    wasm_u32(dc, 1);
    wasm_section(out, 12, dc);

    let cs = Vec::new();
    wasm_u32(cs, m.funcs.len());
    for f in m.funcs {
        let body = Vec::new();
        wasm_u32(body, f.locals.len());
        for l in f.locals {
            wasm_u32(body, 1);
            wasm_valtype(body, l);
        }
        wasm_append(body, f.body);
        wasm_u32(cs, body.len());
        wasm_append(cs, body);
    }
    wasm_section(out, 10, cs);

    // one passive data segment: the literals as UTF-16LE
    let ds = Vec::new();
    wasm_u32(ds, 1);
    ds.push(1); // passive
    wasm_u32(ds, m.data_len);
    for s in m.strings {
        let n = s.len();
        let mut j = 0;
        while j < n {
            let u = s.char_at(j).unwrap_or(0);
            ds.push(u.bit_and(255));
            ds.push(u.shr(8));
            j = j + 1;
        }
    }
    wasm_section(out, 11, ds);

    // name section (function names) for readable stack traces
    let names_sec = Vec::new();
    wasm_name(names_sec, "name");
    let sub = Vec::new();
    wasm_u32(sub, m.imports.len() + m.funcs.len());
    let mut ii = 0;
    for im in m.imports {
        wasm_u32(sub, ii);
        wasm_name(sub, im.module + "." + im.name);
        ii = ii + 1;
    }
    for f in m.funcs {
        wasm_u32(sub, ii);
        let mut nm = f.name;
        if nm.starts_with("$") {
            nm = nm.slice(1, nm.len());
        }
        wasm_name(sub, nm);
        ii = ii + 1;
    }
    names_sec.push(1);
    wasm_u32(names_sec, sub.len());
    wasm_append(names_sec, sub);
    wasm_section(out, 0, names_sec);
    out
}
