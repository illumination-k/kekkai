// An idempotent payment endpoint.
//
//   POST /accounts/<id>/deposit?amount=N            -> 200 {"balance":N}
//   GET  /accounts/<id>                             -> 200 {"balance":N}
//   POST /payments?account=<id>&amount=N&merchant=<m>
//        Idempotency-Key: <key>                     -> 201 {"payment":"<key>",...}
//   GET  /payments/<key>                            -> 200 the stored result
//
// The client may retry a payment any number of times (timeouts, 503s)
// with the same Idempotency-Key: the debit, the stored record and the
// charge notification happen at most once, because all three are part of
// one transaction. The notification to the payment processor is an
// irrevocable effect, so it is queued with `tx.outbox` and sent only after
// the commit succeeds; a conflicting or rolled-back attempt sends nothing.
//
// Layout: balance:<account>, payment:<key> (the JSON result).

enum PayError {
    MissingKey,
    BadRequest(String),
    Insufficient(Int),
    NoAccount,
    Store(TxError),
}

struct PaymentRequest {
    key: String,
    account: String,
    amount: Int,
    merchant: String,
}

enum PayOutcome {
    Created(String),
    Replayed(String),
}

fn balance_key(a: String) -> String {
    "balance:" + a
}

fn payment_key(k: String) -> String {
    "payment:" + k
}

// Identifiers end up in keys and JSON: allow a conservative alphabet only.
fn valid_id(s: String) -> Bool {
    s.len() > 0
        && s.len() <= 64
        && !s.contains("\"")
        && !s.contains("\\")
        && !s.contains(":")
        && !s.contains(" ")
}

fn positive(s: String) -> Option<Int> {
    let n = s.parse_int()?;
    if n > 0 { Some(n) } else { None }
}

fn read_balance(tx: &Tx, account: String) -> Result<Option<Int>, TxError> {
    match tx.get(balance_key(account))? {
        Some(s) => Ok(s.parse_int()),
        None => Ok(None),
    }
}

fn deposit(db: &Db, account: String, amount: Int) -> Result<Int, TxError> {
    db.transaction(|tx| {
        let b = read_balance(tx, account)?.unwrap_or(0) + amount;
        tx.put(balance_key(account), b.to_string())?;
        tx.commit()?;
        Ok(b)
    })
}

fn pay(
    db: &Db,
    log: &Log,
    key: String,
    account: String,
    amount: Int,
    merchant: String,
) -> Result<PayOutcome, PayError> {
    let r = db.transaction(|tx| {
        // A retry of a payment that already committed: answer with the
        // stored result and change nothing.
        match tx.get(payment_key(key))? {
            Some(previous) => {
                tx.rollback();
                return Ok(Ok(PayOutcome::Replayed(previous)));
            }
            None => {}
        }
        let balance = match read_balance(tx, account)? {
            Some(b) => b,
            None => {
                tx.rollback();
                return Ok(Err(PayError::NoAccount));
            }
        };
        if balance < amount {
            tx.rollback();
            return Ok(Err(PayError::Insufficient(balance)));
        }
        let result = "{\"payment\":\""
            + key
            + "\",\"account\":\""
            + account
            + "\",\"amount\":"
            + amount.to_string()
            + ",\"merchant\":\""
            + merchant
            + "\",\"balance\":"
            + (balance - amount).to_string()
            + "}";
        tx.put(balance_key(account), (balance - amount).to_string())?;
        tx.put(payment_key(key), result)?;
        // Irrevocable: runs only if the commit below succeeds.
        tx.outbox("https://processor.example/charges", result);
        log.info("payment " + key + " prepared");
        tx.commit()?;
        Ok(Ok(PayOutcome::Created(result)))
    });
    match r {
        Ok(inner) => inner,
        Err(e) => Err(PayError::Store(e)),
    }
}

fn error_response(e: PayError) -> Response {
    match e {
        PayError::MissingKey => Response::text(428, "Idempotency-Key header required"),
        PayError::BadRequest(m) => Response::bad_request(m),
        PayError::Insufficient(b) => Response::json(
            402,
            "{\"error\":\"insufficient funds\",\"balance\":" + b.to_string() + "}",
        ),
        PayError::NoAccount => Response::not_found(),
        // Safe to retry with the same key: nothing was applied.
        PayError::Store(err) => if err.retryable() {
            Response::text(503, "conflict, retry with the same Idempotency-Key").with_header(
                "retry-after",
                "1",
            )
        } else {
            Response::text(500, err.message())
        },
    }
}

fn payment_request(req: Request) -> Result<PaymentRequest, PayError> {
    let key = match req.header("idempotency-key") {
        Some(k) => k.trim(),
        None => {
            return Err(PayError::MissingKey);
        }
    };
    if !valid_id(key) {
        return Err(PayError::BadRequest("bad Idempotency-Key"));
    }
    let account = req.query("account").unwrap_or("");
    let merchant = req.query("merchant").unwrap_or("");
    if !valid_id(account) || !valid_id(merchant) {
        return Err(PayError::BadRequest("bad account or merchant"));
    }
    let amount = match positive(req.query("amount").unwrap_or("")) {
        Some(n) => n,
        None => {
            return Err(PayError::BadRequest("bad amount"));
        }
    };
    Ok(PaymentRequest { key: key, account: account, amount: amount, merchant: merchant })
}

#[handler]
fn handle(req: Request, db: &Db, log: &Log) -> Response {
    let section = req.segment(0).unwrap_or("");
    let method = req.method();

    if section == "payments" && method == "POST" && req.segment(1).is_none() {
        let p = match payment_request(req) {
            Ok(p) => p,
            Err(e) => {
                return error_response(e);
            }
        };
        return match pay(db, log, p.key, p.account, p.amount, p.merchant) {
            Ok(PayOutcome::Created(body)) => Response::json(201, body),
            Ok(PayOutcome::Replayed(body)) => Response::json(200, body).with_header(
                "idempotent-replay",
                "true",
            ),
            Err(e) => error_response(e),
        };
    }
    if section == "payments" && method == "GET" {
        let key = req.segment(1).unwrap_or("");
        return match db.get(payment_key(key)) {
            Ok(Some(body)) => Response::json(200, body),
            Ok(None) => Response::not_found(),
            Err(e) => error_response(PayError::Store(e)),
        };
    }
    if section == "accounts" {
        let account = req.segment(1).unwrap_or("");
        if !valid_id(account) {
            return Response::bad_request("bad account");
        }
        if method == "GET" && req.segment(2).is_none() {
            return match db.get(balance_key(account)) {
                Ok(Some(b)) => Response::json(200, "{\"balance\":" + b + "}"),
                Ok(None) => Response::not_found(),
                Err(e) => error_response(PayError::Store(e)),
            };
        }
        if method == "POST" && req.segment(2).unwrap_or("") == "deposit" {
            let amount = match positive(req.query("amount").unwrap_or("")) {
                Some(n) => n,
                None => {
                    return Response::bad_request("bad amount");
                }
            };
            return match deposit(db, account, amount) {
                Ok(b) => Response::json(200, "{\"balance\":" + b.to_string() + "}"),
                Err(e) => error_response(PayError::Store(e)),
            };
        }
    }
    Response::not_found()
}
