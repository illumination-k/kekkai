#!/bin/sh
# kek: the Kekkai toolchain launcher.
#
# The compiler (compiler/, written in Kekkai) is a WasmGC + WASI module run
# by wasmtime. The compiler that runs is built from the current compiler/
# sources by the committed bootstrap compiler (bootstrap/kek.wasm) and
# cached under .kek-cache/stage-<hash>/, keyed by the hash of the
# bootstrap, the sources, the runtime prelude (lib/prelude), the core
# library (lib/core) and the wasmtime version. Cache entries are built in
# a temporary directory and renamed into place, so concurrent launches
# need no lock.
#
#   kek <command> [args...]         run a compiler command (check, ir, build, ...)
#   kek run <file|dir> [args...]    build a #[main] program and run it
#   kek test [flags] <file|dir>     run #[test] functions with mock capabilities
#   kek cover [flags] <file|dir>    coverage of the tests (.kek-cache/cover/)
#   kek mutate [flags] <file|dir>   mutation testing (.kek-cache/mutate/)
#   kek similar -diff <rev> ...     similar code, only what changed since a git revision
#   KEK_STAGE=bootstrap kek ...     use the bootstrap compiler directly
#
# Results of `kek test` and the module.wasm of `kek build` / `kek run` are
# also cached (under test/ and build/), keyed by definition hashes.
#
# Maintenance:
#   kek bootstrap-check   rebuild the compiler with itself; require a fixed point
#   kek bootstrap-update  replace bootstrap/ with the current compiler (after the check)
set -eu

root=$(cd "$(dirname "$0")" && pwd)
cache=${KEK_CACHE:-$root/.kek-cache}
wasmtime=${WASMTIME:-wasmtime}
wasm_flags="-W gc=y,function-references=y"

die() {
	echo "$*" >&2
	exit 1
}

command -v "$wasmtime" >/dev/null 2>&1 || die "kek: wasmtime not found (install it with: mise install)"

sha() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum | cut -c1-24
	else
		shasum -a 256 | cut -c1-24
	fi
}

# wasm <module> [args...]: run a WASI module with the file system and the
# working directory of the caller. Extra flags (e.g. --env) come from
# $wasm_extra.
wasm() {
	_m=$1
	shift
	_pre=
	case $_m in *.cwasm) _pre=--allow-precompiled ;; esac
	# shellcheck disable=SC2086
	"$wasmtime" run $wasm_flags $_pre --dir / --env PWD="$PWD" ${wasm_extra:-} "$_m" "$@"
}

# compile <dir>: precompile <dir>/module.wasm into <dir>/module.cwasm.
precompile() {
	# shellcheck disable=SC2086
	"$wasmtime" compile $wasm_flags ${compile_extra:-} "$1/module.wasm" -o "$1/module.cwasm"
}

sources_hash() {
	{
		cat "$root/bootstrap/kek.wasm"
		"$wasmtime" --version
		for f in "$root"/compiler/*.kek "$root"/lib/prelude/*.kek "$root"/lib/core/*.kek; do
			printf '%s\0' "${f#"$root"/}"
			cat "$f"
			printf '\0'
		done
	} | sha
}

# build_compiler <compiler-module> <outdir>: compile compiler/ with the
# given compiler.
build_compiler() {
	mkdir -p "$2"
	(cd "$root" && wasm "$1" build compiler "$2") || return 1
	precompile "$2"
}

bootstrap_module() {
	echo "$root/bootstrap/kek.wasm"
}

# current_stage prints the directory of the current compiler.
current_stage() {
	if [ "${KEK_STAGE:-}" = bootstrap ]; then
		echo "$root/bootstrap"
		return
	fi
	_dir=$cache/stage-$(sources_hash)
	if [ ! -f "$_dir/module.cwasm" ]; then
		mkdir -p "$cache"
		# the prelude and the core library are embedded in the compiler:
		# regenerate them first
		(cd "$root" && wasm "$(bootstrap_module)" embed-prelude lib/prelude compiler/prelude_src.kek) >&2
		(cd "$root" && wasm "$(bootstrap_module)" embed-prelude lib/core compiler/core_src.kek -as core) >&2
		_dir=$cache/stage-$(sources_hash)
		if [ ! -f "$_dir/module.cwasm" ]; then
			_tmp=$(mktemp -d "$cache/tmp-XXXXXX")
			build_compiler "$(bootstrap_module)" "$_tmp" >&2 || {
				rm -rf "$_tmp"
				die "kek: building the compiler failed"
			}
			if [ -e "$_dir" ]; then
				rm -rf "$_tmp" # lost a race: the entry is already there
			else
				mv "$_tmp" "$_dir"
				# mv moved it inside if another launch won in between
				rm -rf "${_dir:?}/$(basename "$_tmp")"
			fi
		fi
	fi
	echo "$_dir"
}

stage_module() {
	if [ "$1" = "$root/bootstrap" ]; then
		echo "$1/kek.wasm"
	else
		echo "$1/module.cwasm"
	fi
}

# stage_dir sets $_stage_memo to the directory of the current compiler.
stage_dir() {
	[ -n "${_stage_memo:-}" ] || _stage_memo=$(current_stage) || exit 1
}

# stage_key names the current compiler in cache keys.
stage_key() {
	stage_dir
	if [ "$_stage_memo" = "$root/bootstrap" ]; then
		echo "bootstrap-$(sha <"$root/bootstrap/kek.wasm")"
	else
		echo "${_stage_memo##*/}"
	fi
}

# compiler <args...>: run the current compiler.
compiler() {
	stage_dir
	wasm "$(stage_module "$_stage_memo")" "$@"
}

# bootstrap_check requires stage1 (the current compiler, built by the
# bootstrap) to rebuild itself identically. With $1 = update, a change of
# the code the compiler generates for itself (e.g. in the runtime prelude)
# is allowed: stage2 (built by stage1) must then rebuild itself
# identically, and $_new is set to the module to install.
bootstrap_check() {
	_s1=$(current_stage)
	_new=$_s1/module.wasm
	_s2=$(mktemp -d "${TMPDIR:-/tmp}/kek-stage2-XXXXXX")
	if ! build_compiler "$_s1/module.cwasm" "$_s2"; then
		rm -rf "$_s2"
		echo "bootstrap-check: stage1 failed to build the compiler" >&2
		return 1
	fi
	if cmp -s "$_s1/module.wasm" "$_s2/module.wasm"; then
		echo "bootstrap-check: fixed point ($(wc -c <"$_s1/module.wasm" | tr -d ' ') bytes)"
		rm -rf "$_s2"
		return 0
	fi
	if [ "${1:-}" = update ]; then
		_s3=$(mktemp -d "${TMPDIR:-/tmp}/kek-stage3-XXXXXX")
		if build_compiler "$_s2/module.cwasm" "$_s3" && cmp -s "$_s2/module.wasm" "$_s3/module.wasm"; then
			echo "bootstrap-check: fixed point at stage2 ($(wc -c <"$_s2/module.wasm" | tr -d ' ') bytes)"
			_keep=$(mktemp -d "${TMPDIR:-/tmp}/kek-new-XXXXXX")
			cp "$_s2/module.wasm" "$_keep/module.wasm"
			_new=$_keep/module.wasm
			rm -rf "$_s2" "$_s3"
			return 0
		fi
		rm -rf "$_s3"
	fi
	rm -rf "$_s2"
	echo "bootstrap-check: no fixed point: module.wasm differs between stage1 and stage2" >&2
	return 1
}

usage() {
	cat <<'EOF'
kek — the Kekkai toolchain (self-hosted)

Usage:
  kek check <file|dir>            type-check (capabilities, effects, transactions)
  kek ir <file|dir>               print the intermediate representation
  kek build [-o dir] [-target d1|do] <file|dir>
                                  compile: a WASI command for #[main], a Worker for #[handler]
  kek run <file|dir> [args...]    compile a #[main] program and run it
  kek test [-run re] [-seed n] [-cases n] [-j n] [-json] [-no-cache]
           [-clock ms] [-net f.json] [-db f.json] <file|dir>
                                  run the #[test] functions with mock capabilities
                                  (property tests, results cached by definition hash)
  kek cover [-json] [-lcov file] [-run re] [-seed n] <file|dir>
                                  line and branch coverage of the tests
  kek mutate [-json] [-run re] [-base <file|dir> | -diff rev] [-timeout 2s] <file|dir>
                                  mutation testing (typed mutants, cached results)
  kek fmt [-w|-check] <paths>     format
  kek caps [-json] <file|dir>     capabilities (side effects) of each function
  kek search [-json] '<sig>' [path]
                                  search functions by type
  kek assure (plan|apply|check) [flags] <file|dir>
                                  the guarantee ledger kekkai.assure.lock (docs/assure.md)
  kek similar [-json] [-threshold pct] [-all] [-tests] [-base path | -diff rev] <file|dir>
                                  duplicate and similar definitions (exit 1 when found)

Compiler internals:
  kek lex <file> | kek ast <file> token / syntax tree dumps
  kek test-build <file|dir> <outdir> [-list | -run name...]
  kek cover-build <file|dir> <outdir> [-main] | kek cover-report [-json] [-lcov f] <outdir>
  kek mutate-build <file|dir> <outdir> [-base p] [-main] | kek mutate-report [-json] <outdir>
  kek embed-prelude lib/prelude compiler/prelude_src.kek [-check]
  kek embed-prelude lib/core compiler/core_src.kek -as core [-check]

Maintenance:
  kek bootstrap-check             rebuild the compiler with itself; require a fixed point
  kek bootstrap-update            replace bootstrap/ with the current compiler (after the check)
EOF
}

# ---- kek build ----

# cached_build <path> <outdir> [args...]: `compiler build` through the
# build cache. module.wasm is stored under $cache/build/<stage>/<key>/,
# keyed by the program's definition hash (see `kek hash`), its entry kind
# and its handler parameters, so a program changed only in comments or
# formatting is not compiled again; the other outputs (worker.js,
# wrangler.toml, kekkai_meta.js) are always written by the compiler.
# KEK_BUILD_CACHE=0 disables the cache.
cached_build() {
	_bp=$1
	_bo=$2
	shift 2
	if [ "${KEK_BUILD_CACHE:-1}" = 0 ]; then
		compiler build "$_bp" "$_bo" "$@"
		return
	fi
	stage_dir
	_bc=$cache/build/$(stage_key)
	_bres=$(compiler build "$_bp" "$_bo" "$@" -cache "$_bc") || return $?
	printf '%s\n' "$_bres" | grep -v '^kek-build-cache: ' | grep -v '^$' || true
	_bline=$(printf '%s\n' "$_bres" | grep '^kek-build-cache: ' | tail -n 1)
	_bkey=${_bline##* }
	case $_bline in
	*" hit "*)
		cp "$_bc/$_bkey/module.wasm" "$_bo/module.wasm"
		;;
	*" miss "*)
		[ ! -e "$_bc/$_bkey" ] || return 0
		mkdir -p "$_bc"
		_bt=$(mktemp -d "$_bc/tmp-XXXXXX")
		cp "$_bo/module.wasm" "$_bt/module.wasm"
		: >"$_bt/ok"
		if [ -e "$_bc/$_bkey" ]; then
			rm -rf "$_bt" # lost a race: the entry is already there
		else
			mv "$_bt" "$_bc/$_bkey"
			rm -rf "${_bc:?}/$_bkey/$(basename "$_bt")"
		fi
		;;
	esac
}

cmd_build() {
	_out=out
	_target=d1
	_path=
	_n=0
	while [ $# -gt 0 ]; do
		case $1 in
		-o | --o)
			[ $# -ge 2 ] || die "usage: kek build [-o dir] [-target d1|do] <file|dir>"
			_out=$2
			shift
			;;
		-o=* | --o=*) _out=${1#*=} ;;
		-target | --target)
			[ $# -ge 2 ] || die "usage: kek build [-o dir] [-target d1|do] <file|dir>"
			_target=$2
			shift
			;;
		-target=* | --target=*) _target=${1#*=} ;;
		*)
			_path=$1
			_n=$((_n + 1))
			;;
		esac
		shift
	done
	if [ "$_n" -ne 1 ]; then
		echo "usage: kek build [-o dir] [-target d1|do] <file|dir>" >&2
		exit 2
	fi
	mkdir -p "$_out"
	cached_build "$_path" "$_out" -target "$_target" || exit $?
	if [ -f "$_out/kekkai_meta.js" ]; then
		cp "$root/js/kekkai_runtime.js" "$_out/kekkai_runtime.js"
	fi
	echo "$_path -> $_out ($(wc -c <"$_out/module.wasm" | tr -d ' ') bytes of wasm)"
}

# ---- kek run ----

cmd_run() {
	if [ $# -lt 1 ]; then
		echo "usage: kek run <file|dir> [args...]" >&2
		exit 2
	fi
	_src=$1
	shift
	_out=$(mktemp -d "${TMPDIR:-/tmp}/kek-run-XXXXXX")
	trap 'rm -rf "$_out"' EXIT
	cached_build "$_src" "$_out" || exit $?
	if [ -f "$_out/kekkai_meta.js" ]; then
		die "kek run: $_src is a #[handler] program (serve it locally with scripts/dev.sh)"
	fi
	set +e
	wasm "$_out/module.wasm" "$@"
	_code=$?
	set -e
	exit $_code
}

# ---- kek test ----
#
# test-build -list discovers the tests with their definition hashes
# (tests.tsv). A test's result is a function of the compiler stage, its
# trans hash, the mock options (-seed, -clock, the contents of -net/-db
# files) and its number of cases, so results are cached under
# $cache/test/<options key>/<hash>-<cases>-<name>. Only the uncached tests
# are built (test-build -run) and run, -j at a time; the results are
# printed in declaration order.

test_usage() {
	cat >&2 <<'EOF'
Usage of test:
  -cases int
    	cases of a property test (a test with generated parameters) (default 100)
  -clock int
    	fixed time of the mock &Clock (ms since the epoch) (default 1767225600000)
  -db string
    	JSON file with the initial contents of the mock &Db store: {"key": "value"}
  -j int
    	run this many tests at a time (default: the number of CPUs)
  -json
    	print the results as JSON
  -net string
    	JSON file of canned &Net responses: {"GET url": "body", "POST url": {"error": "msg"}}
  -no-cache
    	run every test, ignoring cached results (also KEK_TEST_CACHE=0)
  -run string
    	run only tests whose name matches this extended regular expression
  -seed int
    	seed of the mock &Random and of the inputs of property tests
EOF
}

test_usage_error() {
	echo "$1" >&2
	test_usage
	exit 2
}

is_int64() {
	printf '%s' "$1" | grep -Eq '^[+-]?(0|[1-9][0-9]*)$' || return 1
	_d=${1#[+-]}
	[ ${#_d} -lt 19 ] && return 0
	[ ${#_d} -gt 19 ] && return 1
	case $1 in
	-*) [ "$_d" \< "9223372036854775809" ] ;;
	*) [ "$_d" \< "9223372036854775808" ] ;;
	esac
}

ncpu() {
	getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1
}

# json_str <s>: a JSON string literal (s has no control characters).
json_str() {
	printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# test_run_one <idx> <name>: runs one test of $_dir/module.cwasm into
# $_dir/r/<idx>.out and writes its status (ok, failed, trapped or error)
# to $_dir/r/<idx>.st last.
test_run_one() {
	_o=$_dir/r/$1
	set +e
	wasm "$_dir/module.cwasm" "$2" >"$_o.out" 2>"$_o.err"
	_c=$?
	set -e
	if [ $_c -eq 0 ]; then
		_st=ok
	elif [ $_c -eq 1 ]; then
		_st=failed
	else
		_st=error
		grep -q 'wasm trap: ' "$_o.err" && _st=trapped
		{
			echo "test $2 ... FAILED (trapped)"
			_trap=$(grep -E 'wasm trap: ' "$_o.err" | sed 's/.*wasm trap: //' | head -n 1)
			[ -n "$_trap" ] || _trap=$(grep -v '^kek-case: ' "$_o.err" | tail -n 1)
			echo "    trap: $_trap"
			# a property test notes each input before running it
			_in=$(grep '^kek-case: ' "$_o.err" | tail -n 1 | sed 's/^kek-case: //')
			[ -z "$_in" ] || echo "    last input: $_in"
		} >>"$_o.out"
	fi
	echo "$_st" >"$_o.st.tmp"
	mv "$_o.st.tmp" "$_o.st"
}

# test_launch starts the next uncached tests, keeping at most $_jobs
# running beyond the ones already reported.
test_launch() {
	while [ "$_launched" -lt "$_nrun" ] && [ $((_launched - _reported)) -lt "$_jobs" ]; do
		_launched=$((_launched + 1))
		eval "_li=\$_run_$_launched"
		eval "_ln=\$_name_$_li"
		test_run_one "$_li" "$_ln" &
		eval "_pid_$_li=\$!"
	done
}

# test_json_obj <name> <status> <cached> <caps> <hash> <result file>: one
# element of the "tests" array of `kek test -json`.
test_json_obj() {
	awk -v name="$1" -v status="$2" -v cached="$3" -v caps="$4" -v hash="$5" '
	function esc(s,   r, i, c) {
		gsub(/\\/, "\\\\", s)
		gsub(/"/, "\\\"", s)
		gsub(/\t/, "\\t", s)
		gsub(/\r/, "\\r", s)
		if (s ~ /[\001-\037]/) {
			r = ""
			for (i = 1; i <= length(s); i++) {
				c = substr(s, i, 1)
				r = r (c ~ /[\001-\037]/ ? sprintf("\\u%04x", ord[c]) : c)
			}
			s = r
		}
		return "\"" s "\""
	}
	BEGIN {
		for (i = 1; i < 32; i++) ord[sprintf("%c", i)] = i
		n = 0
		ce = "null"
		ms = "null"
	}
	NR == 1 {
		if (match($0, /; [0-9]+\.[0-9]+ms\)$/)) ms = substr($0, RSTART + 2, RLENGTH - 5)
		next
	}
	{
		line = $0
		sub(/^    /, "", line)
		out[n++] = esc(line)
		if (line ~ /^counterexample: /) ce = esc(substr(line, 17))
	}
	END {
		cs = ""
		k = split(caps, a, ",")
		for (i = 1; i <= k; i++) cs = cs (i > 1 ? "," : "") esc(a[i])
		o = ""
		for (i = 0; i < n; i++) o = o (i > 0 ? "," : "") out[i]
		printf "{\"name\":%s,\"status\":\"%s\",\"cached\":%s,\"pure\":%s,\"caps\":[%s],\"hash\":%s,\"ms\":%s,\"output\":[%s],\"counterexample\":%s}", esc(name), status, cached, (k == 0 ? "true" : "false"), cs, esc(hash), ms, o, ce
	}' "$6"
}

cmd_test() {
	_run=
	_seed=0
	_clock=1767225600000
	_net=
	_db=
	_cases=100
	_jobs=
	_json=0
	_nocache=0
	while [ $# -gt 0 ]; do
		case $1 in
		--) shift; break ;;
		-?*) ;;
		*) break ;;
		esac
		_name=${1#-}
		_name=${_name#-}
		_val=
		_has=0
		case $_name in
		*=*)
			_val=${_name#*=}
			_name=${_name%%=*}
			_has=1
			;;
		esac
		case $_name in
		h | help) test_usage; exit 0 ;;
		json | no-cache)
			if [ $_has -eq 0 ]; then
				_val=true
			fi
			case $_val in
			true | 1) _b=1 ;;
			false | 0) _b=0 ;;
			*) test_usage_error "invalid boolean value \"$_val\" for -$_name: parse error" ;;
			esac
			case $_name in
			json) _json=$_b ;;
			no-cache) _nocache=$_b ;;
			esac
			shift
			continue
			;;
		run | seed | clock | net | db | cases | j) ;;
		*) test_usage_error "flag provided but not defined: -$_name" ;;
		esac
		if [ $_has -eq 0 ]; then
			[ $# -ge 2 ] || test_usage_error "flag needs an argument: -$_name"
			_val=$2
			shift
		fi
		case $_name in
		seed | clock)
			is_int64 "$_val" || test_usage_error "invalid value \"$_val\" for flag -$_name: parse error"
			;;
		cases | j)
			printf '%s' "$_val" | grep -Eq '^[1-9][0-9]{0,8}$' ||
				test_usage_error "invalid value \"$_val\" for flag -$_name: want a positive integer"
			;;
		esac
		case $_name in
		run) _run=$_val ;;
		seed) _seed=$_val ;;
		clock) _clock=$_val ;;
		net) _net=$_val ;;
		db) _db=$_val ;;
		cases) _cases=$_val ;;
		j) _jobs=$_val ;;
		esac
		shift
	done
	[ $# -eq 1 ] || die "kek test: expected exactly one .kek file"
	_file=$1
	[ -e "$_file" ] || die "stat $_file: no such file or directory"
	[ "${_clock#+}" = 0 ] && _clock=1767225600000
	[ "${KEK_TEST_CACHE:-1}" != 0 ] || _nocache=1
	[ -n "$_jobs" ] || _jobs=$(ncpu)

	_dir=$(mktemp -d "${TMPDIR:-/tmp}/kek-test-XXXXXX")
	trap 'rm -rf "$_dir"' EXIT
	mkdir "$_dir/r"
	compiler test-build "$_file" "$_dir" -list || exit $?
	# errors in the options are reported after the program's diagnostics
	for _f in "$_net" "$_db"; do
		[ -z "$_f" ] || [ -f "$_f" ] || die "open $_f: no such file or directory"
	done
	if [ -n "$_run" ]; then
		set +e
		grep -E -- "$_run" "$_dir/tests.txt" >"$_dir/selected.txt" 2>"$_dir/grep.err"
		_g=$?
		set -e
		[ $_g -le 1 ] || die "kek test: -run: invalid regular expression: $_run"
	else
		cp "$_dir/tests.txt" "$_dir/selected.txt"
	fi
	_count=$(wc -l <"$_dir/selected.txt" | tr -d ' ')
	if [ "$_count" -eq 0 ]; then
		if [ $_json -eq 1 ]; then
			echo "{\"file\":$(json_str "$_file"),\"passed\":0,\"failed\":0,\"cached\":0,\"tests\":[]}"
		else
			echo "$_file: no tests"
		fi
		exit 0
	fi

	# the cache directory of these options
	_tc=$cache/test/$(
		{
			printf 'kek-test-1\n%s\n%s\n%s\n' "$(stage_key)" "$_seed" "$_clock"
			printf 'net\n'
			[ -z "$_net" ] || cat "$_net"
			printf '\ndb\n'
			[ -z "$_db" ] || cat "$_db"
		} | sha
	)
	# plan: the selected tests in declaration order; uncached ones get a
	# run number
	awk -F '\t' 'NR == FNR { want[$1] = 1; next } want[$1]' \
		"$_dir/selected.txt" "$_dir/tests.tsv" >"$_dir/plan.tsv"
	_i=0
	_nrun=0
	while IFS="$(printf '\t')" read -r _t _h _np _c _caps; do
		_i=$((_i + 1))
		[ "$_np" -gt 0 ] || _c=1
		[ "$_np" -eq 0 ] || [ "$_c" -gt 0 ] || _c=$_cases
		eval "_name_$_i=\$_t"
		eval "_hash_$_i=\$_h"
		eval "_caps_$_i=\$_caps"
		eval "_key_$_i=\$_h-\$_c-\$_t"
		eval "_cached_$_i=0"
		if [ $_nocache -eq 0 ] && [ -f "$_tc/$_h-$_c-$_t" ]; then
			eval "_cached_$_i=1"
		else
			_nrun=$((_nrun + 1))
			eval "_run_$_nrun=$_i"
			printf '%s\n' "$_t" >>"$_dir/run.txt"
		fi
	done <"$_dir/plan.tsv"

	if [ "$_nrun" -gt 0 ]; then
		# shellcheck disable=SC2046
		compiler test-build "$_file" "$_dir" -run $(cat "$_dir/run.txt") || exit $?
		# KEK_TEST_TIMEOUT (e.g. 10s) bounds each test process; the
		# interruption must be compiled in too
		[ -z "${KEK_TEST_TIMEOUT:-}" ] || compile_extra="-W epoch-interruption=y"
		precompile "$_dir"
		compile_extra=
	fi
	wasm_extra="--env KEK_TEST=1 --env KEK_TEST_CLOCK=$_clock --env KEK_TEST_SEED=$_seed --env KEK_TEST_CASES=$_cases"
	[ -z "$_net" ] || wasm_extra="$wasm_extra --env KEK_TEST_NET=$_net"
	[ -z "$_db" ] || wasm_extra="$wasm_extra --env KEK_TEST_DB=$_db"
	[ -z "${KEK_TEST_TIMEOUT:-}" ] || wasm_extra="$wasm_extra -W timeout=$KEK_TEST_TIMEOUT"
	if [ "$_nrun" -gt 0 ] && [ -n "$_net$_db" ]; then
		wasm "$_dir/module.cwasm" "" || exit 1
	fi
	if [ $_json -eq 0 ]; then
		if [ "$_count" -eq 1 ]; then
			echo "running 1 test from $_file"
		else
			echo "running $_count tests from $_file"
		fi
	fi
	_passed=0
	_failed=0
	_ncached=0
	_launched=0
	_reported=0
	test_launch
	_i=0
	while [ $_i -lt "$_count" ]; do
		_i=$((_i + 1))
		eval "_t=\$_name_$_i"
		eval "_key=\$_key_$_i"
		eval "_cached=\$_cached_$_i"
		_res=$_dir/r/$_i.res
		if [ "$_cached" -eq 1 ]; then
			_ncached=$((_ncached + 1))
			_st=$(head -n 1 "$_tc/$_key")
			tail -n +2 "$_tc/$_key" >"$_res"
		else
			eval "_p=\$_pid_$_i"
			wait "$_p" || true
			_reported=$((_reported + 1))
			test_launch
			_st=$(cat "$_dir/r/$_i.st" 2>/dev/null || echo error)
			cp "$_dir/r/$_i.out" "$_res"
			if [ "$_st" = error ]; then
				# not a test result (e.g. a crash of wasmtime): not cached
				_st=trapped
			elif [ $_nocache -eq 0 ]; then
				mkdir -p "$_tc"
				_tmp=$(mktemp "$_tc/tmp-XXXXXX")
				{
					echo "$_st"
					cat "$_res"
				} >"$_tmp"
				mv "$_tmp" "$_tc/$_key"
			fi
		fi
		if [ "$_st" = ok ]; then
			_passed=$((_passed + 1))
		else
			_failed=$((_failed + 1))
		fi
		if [ $_json -eq 1 ]; then
			_cj=false
			[ "$_cached" -eq 0 ] || _cj=true
			eval "_caps=\$_caps_$_i"
			eval "_h=\$_hash_$_i"
			test_json_obj "$_t" "$_st" "$_cj" "$_caps" "$_h" "$_res" >"$_dir/r/$_i.json"
		elif [ "$_cached" -eq 1 ]; then
			sed -e '1s/$/ (cached)/' "$_res"
		else
			cat "$_res"
		fi
	done
	if [ $_json -eq 1 ]; then
		printf '{"file":%s,"passed":%d,"failed":%d,"cached":%d,"tests":[' \
			"$(json_str "$_file")" "$_passed" "$_failed" "$_ncached"
		_i=0
		while [ $_i -lt "$_count" ]; do
			_i=$((_i + 1))
			[ $_i -eq 1 ] || printf ','
			cat "$_dir/r/$_i.json"
		done
		printf ']}\n'
		[ $_failed -eq 0 ] || exit 1
		exit 0
	fi
	_note=
	[ $_ncached -eq 0 ] || _note=" ($_ncached cached)"
	echo
	if [ $_failed -eq 0 ]; then
		echo "test result: ok. $_passed passed; $_failed failed$_note"
		exit 0
	fi
	echo "test result: FAILED. $_passed passed; $_failed failed$_note"
	exit 1
}

# ---- kek similar -diff <rev> ----

# cmd_similar runs `similar`. With -diff <rev>, the program as of the git
# revision rev is extracted into a temporary directory and passed as
# -base, so that only findings with a new or changed definition are
# reported (the CI mode for pull requests).
# similar_semantic <path> [-all] [-tests]: run the candidate pairs of the
# semantic kind as property tests (each compares the two functions'
# results on generated inputs) and print the path of the file listing the
# pairs that agreed on every input. Temporary files go to $_sem_dir.
similar_semantic() {
	_sem_dir=$(mktemp -d "${TMPDIR:-/tmp}/kek-semantic-XXXXXX")
	mkdir -p "$_sem_dir/prog"
	compiler similar -semantic_plan "$_sem_dir" "$@" || exit 2
	: >"$_sem_dir/equiv.txt"
	[ -s "$_sem_dir/pairs.tsv" ] || return 0
	set +e
	(KEK_TEST_TIMEOUT=${KEK_TEST_TIMEOUT:-10s} cmd_test -json -run '^kek_sim_eq_[0-9]+$' "$_sem_dir/prog") \
		>"$_sem_dir/result.json" 2>"$_sem_dir/result.err"
	set -e
	_tab=$(printf '\t')
	while IFS="$_tab" read -r _i _a _b; do
		if grep -q "\"name\":\"kek_sim_eq_$_i\",\"status\":\"ok\"" "$_sem_dir/result.json"; then
			printf '%s\t%s\n' "$_a" "$_b" >>"$_sem_dir/equiv.txt"
		fi
	done <"$_sem_dir/pairs.tsv"
}

cmd_similar() {
	# -semantic: compare outputs on generated inputs first (similar_semantic)
	_sem=0
	_sem_flags=
	_sem_path=
	_n=$#
	while [ $_n -gt 0 ]; do
		_a=$1
		shift
		_n=$((_n - 1))
		case $_a in
		-semantic | --semantic) _sem=1 ;;
		*)
			case $_a in
			-all | --all | -tests | --tests) _sem_flags="$_sem_flags $_a" ;;
			-*) ;;
			*) _sem_path=$_a ;;
			esac
			set -- "$@" "$_a"
			;;
		esac
	done
	if [ $_sem -eq 1 ]; then
		[ -n "$_sem_path" ] || die "usage: kek similar -semantic [flags] <file|dir>"
		# shellcheck disable=SC2086
		similar_semantic $_sem_flags "$_sem_path"
		set -- -equiv "$_sem_dir/equiv.txt" "$@"
		trap 'rm -rf "$_sem_dir"' EXIT
	fi
	_rev=
	_has_rev=0
	_path=
	_skip=0
	for _a in "$@"; do
		if [ $_skip -eq 1 ]; then
			_rev=$_a
			_skip=0
			continue
		fi
		case $_a in
		-diff | --diff) _skip=1; _has_rev=1 ;;
		-diff=* | --diff=*) _rev=${_a#*=}; _has_rev=1 ;;
		*) _path=$_a ;;
		esac
	done
	if [ $_has_rev -eq 0 ]; then
		compiler similar "$@"
		return
	fi
	if [ $_skip -eq 1 ] || [ -z "$_rev" ]; then
		echo "flag needs an argument: -diff" >&2
		echo "usage: kek similar [-json] [-threshold pct] [-all] [-tests] [-base path | -diff rev] <file|dir>" >&2
		exit 2
	fi
	# drop -diff <rev> from the arguments
	_skip=0
	_n=$#
	while [ $_n -gt 0 ]; do
		_a=$1
		shift
		_n=$((_n - 1))
		if [ $_skip -eq 1 ]; then
			_skip=0
			continue
		fi
		case $_a in
		-diff | --diff) _skip=1 ;;
		-diff=* | --diff=*) ;;
		*) set -- "$@" "$_a" ;;
		esac
	done
	if [ -z "$_path" ] || [ ! -e "$_path" ]; then
		echo "kek similar -diff: no such file or directory: ${_path:-<file|dir>}" >&2
		exit 2
	fi
	_top=$(git rev-parse --show-toplevel 2>/dev/null) || {
		echo "kek similar -diff: not in a git repository" >&2
		exit 2
	}
	git rev-parse --verify --quiet "$_rev^{commit}" >/dev/null || {
		echo "kek similar -diff: unknown revision $_rev" >&2
		exit 2
	}
	if [ -d "$_path" ]; then
		_abs=$(cd "$_path" && pwd -P)
	else
		_abs=$(cd "$(dirname "$_path")" && pwd -P)/$(basename "$_path")
	fi
	_top=$(cd "$_top" && pwd -P)
	case $_abs in
	"$_top") _rel=. ;;
	"$_top"/*) _rel=${_abs#"$_top"/} ;;
	*)
		echo "kek similar -diff: $_path is outside the repository $_top" >&2
		exit 2
		;;
	esac
	_base=$(mktemp -d "${TMPDIR:-/tmp}/kek-similar-XXXXXX")
	trap 'rm -rf "$_base" ${_sem_dir:+"$_sem_dir"}' EXIT
	set +e
	if git -C "$_top" archive --format=tar "$_rev" -- "$_rel" 2>/dev/null | tar -x -C "$_base" 2>/dev/null &&
		[ -e "$_base/$_rel" ]; then
		compiler similar -base "$_base/$_rel" -base_name "git:$_rev" "$@"
	else
		# the path did not exist at rev: every definition is new
		compiler similar "$@"
	fi
	_code=$?
	set -e
	exit $_code
}

# ---- kek cover / kek mutate ----

# tool_flags_parse <usage-fn> <spec> <args...>: Go-style flag parsing for
# cover and mutate. spec lists the flags: "json" is a boolean, "run=" takes
# a value, "seed#" an integer. Sets flag_<name> and leaves the remaining
# arguments in $tool_rest (count $tool_nrest, the path in $tool_path).
tool_flags_parse() {
	_tf_usage=$1
	_tf_spec=$2
	shift 2
	while [ $# -gt 0 ]; do
		case $1 in
		--) shift; break ;;
		-?*) ;;
		*) break ;;
		esac
		_name=${1#-}
		_name=${_name#-}
		_val=
		_has=0
		case $_name in
		*=*)
			_val=${_name#*=}
			_name=${_name%%=*}
			_has=1
			;;
		esac
		case $_name in
		h | help) "$_tf_usage"; exit 0 ;;
		esac
		_kind=
		for _s in $_tf_spec; do
			case $_s in
			"$_name") _kind=bool ;;
			"$_name=") _kind=str ;;
			"$_name#") _kind=int ;;
			esac
		done
		if [ -z "$_kind" ]; then
			echo "flag provided but not defined: -$_name" >&2
			"$_tf_usage"
			exit 2
		fi
		if [ "$_kind" = bool ]; then
			[ $_has -eq 1 ] || _val=true
			case $_val in
			1 | t | T | true | TRUE | True) _val=true ;;
			0 | f | F | false | FALSE | False) _val=false ;;
			*)
				echo "invalid boolean value \"$_val\" for -$_name: parse error" >&2
				"$_tf_usage"
				exit 2
				;;
			esac
		else
			if [ $_has -eq 0 ]; then
				if [ $# -lt 2 ]; then
					echo "flag needs an argument: -$_name" >&2
					"$_tf_usage"
					exit 2
				fi
				_val=$2
				shift
			fi
			if [ "$_kind" = int ] && ! is_int64 "$_val"; then
				echo "invalid value \"$_val\" for flag -$_name: parse error" >&2
				"$_tf_usage"
				exit 2
			fi
		fi
		eval "flag_$_name=\$_val"
		shift
	done
	tool_nrest=$#
	tool_path=${1:-}
}

# select_tests <dir> <re>: <dir>/selected.txt = the tests matching re.
select_tests() {
	if [ -n "$2" ]; then
		set +e
		grep -E -- "$2" "$1/tests.txt" >"$1/selected.txt" 2>/dev/null
		_g=$?
		set -e
		[ $_g -le 1 ] || die "kek: -run: invalid regular expression: $2"
	else
		cp "$1/tests.txt" "$1/selected.txt"
	fi
}

# test_key <dir> <test>: the trans hash of a test (testkeys.txt).
test_key() {
	awk -F '\t' -v t="$2" '$1 == t { print $2 }' "$1/testkeys.txt"
}

# cache_put <file> <content-file>: store a cache entry atomically.
cache_put() {
	_cp_tmp=$1.tmp.$$
	cp "$2" "$_cp_tmp" && mv "$_cp_tmp" "$1"
}

cover_usage() {
	cat >&2 <<'EOF'
Usage of cover: kek cover [flags] <file|dir>
  -j int
    	parallel test processes (default: number of CPUs)
  -json
    	print the report as JSON
  -lcov string
    	also write an lcov tracefile to this file
  -run string
    	run only tests whose name matches this extended regular expression
  -seed int
    	seed of the mock &Random
EOF
}

# test_jobs <dir>: "index test trans-hash" for every selected test.
test_jobs() {
	awk -F '\t' 'NR == FNR { k[$1] = $2; next } { printf "%05d %s %s\n", FNR, $0, k[$0] }' \
		"$1/testkeys.txt" "$1/selected.txt"
}

# cover_one <dir> <index> <test> <test key> (a parallel worker): runs one
# instrumented test and writes "test<TAB>status<TAB>probe ids" to
# <dir>/hits/<index>, and to the cache file $KEK_W_CACHE-<test key>.
cover_one() {
	wasm_extra="$KEK_W_EXTRA --env KEK_COVER_OUT=$1/ids/$2"
	set +e
	wasm "$1/module.cwasm" "$3" >"$1/out/$2" 2>&1
	_c=$?
	set -e
	case $_c in
	0) _st=ok ;;
	1) _st=failed ;;
	*) _st=trapped ;;
	esac
	printf '%s\t%s\t%s\n' "$3" "$_st" "$(cat "$1/ids/$2" 2>/dev/null)" >"$1/hits/$2"
	[ -z "${4:-}" ] || cache_put "$KEK_W_CACHE-$4" "$1/hits/$2"
}

cmd_cover() {
	flag_json=false
	flag_lcov=
	flag_run=
	flag_seed=0
	flag_j=$(ncpu)
	tool_flags_parse cover_usage "json lcov= run= seed# j#" "$@"
	[ "$tool_nrest" -eq 1 ] || { cover_usage; exit 2; }
	_file=$tool_path
	[ -e "$_file" ] || die "stat $_file: no such file or directory"
	_stage=$(current_stage)
	_dir=$(mktemp -d "${TMPDIR:-/tmp}/kek-cover-XXXXXX")
	trap 'rm -rf "$_dir"' EXIT
	compiler cover-build "$_file" "$_dir" || exit $?
	select_tests "$_dir" "$flag_run"
	mkdir -p "$_dir/hits" "$_dir/ids" "$_dir/out" "$cache/cover"
	if [ -s "$_dir/selected.txt" ]; then
		# a test's coverage is cached by the compiler, the probe table, the
		# seed and the test's trans hash (everything it can reach)
		KEK_W_CACHE=$cache/cover/$(basename "$_stage")-$(sha <"$_dir/sites.json")-$flag_seed
		KEK_W_EXTRA="--env KEK_TEST=1 --env KEK_TEST_CLOCK=1767225600000 --env KEK_TEST_SEED=$flag_seed --env KEK_TEST_CASES=100"
		export KEK_W_CACHE KEK_W_EXTRA
		: >"$_dir/torun.txt"
		test_jobs "$_dir" | while read -r _i _t _tk; do
			if [ -n "$_tk" ] && [ -f "$KEK_W_CACHE-$_tk" ]; then
				cp "$KEK_W_CACHE-$_tk" "$_dir/hits/$_i"
			else
				echo "$_i $_t $_tk" >>"$_dir/torun.txt"
			fi
		done
		if [ -s "$_dir/torun.txt" ]; then
			precompile "$_dir"
			xargs -L 1 -P "$flag_j" "$root/kek" __cover-one "$_dir" <"$_dir/torun.txt"
		fi
		cat "$_dir"/hits/* >"$_dir/hits.txt"
	else
		: >"$_dir/hits.txt"
	fi
	set -- "$_dir"
	[ "$flag_json" = true ] && set -- -json "$@"
	[ -z "$flag_lcov" ] || set -- -lcov "$flag_lcov" "$@"
	compiler cover-report "$@"
}

mutate_usage() {
	cat >&2 <<'EOF'
Usage of mutate: kek mutate [flags] <file|dir>
  -base string
    	mutate only the definitions that differ from this program (file or directory)
  -diff string
    	mutate only the definitions changed since this git revision
  -j int
    	parallel test processes (default: number of CPUs)
  -json
    	print the report as JSON
  -run string
    	use only tests whose name matches this extended regular expression
  -timeout string
    	time limit of a test run with a mutant: 2s, 500ms (default: 1s + 10x the slowest test)
EOF
}

# mutate_base_one <dir> <index> <test> <test key> (a parallel worker):
# runs a test without mutants, recording the mutant sites it reaches.
# Writes <dir>/base/<index> ("test<TAB>status<TAB>ms") and
# <dir>/reach/<index> (the ids), both cached in $KEK_W_CACHE-<test key>.
mutate_base_one() {
	wasm_extra="$KEK_W_EXTRA --env KEK_MUTANT=0 --env KEK_COVER_OUT=$1/reach/$2"
	set +e
	wasm "$1/module.cwasm" "$3" >"$1/out/$2" 2>&1
	_c=$?
	set -e
	case $_c in
	0) _st=ok ;;
	1) _st=failed ;;
	*) _st=trapped ;;
	esac
	_ms=$(sed -n 's/.*; \([0-9]*\)\.[0-9]*ms)$/\1/p' "$1/out/$2" | head -n 1)
	printf '%s\t%s\t%s\n' "$3" "$_st" "${_ms:-0}" >"$1/base/$2"
	[ -f "$1/reach/$2" ] || : >"$1/reach/$2"
	if [ -n "${4:-}" ]; then
		cat "$1/base/$2" "$1/reach/$2" >"$1/out/$2.cache"
		cache_put "$KEK_W_CACHE-$4" "$1/out/$2.cache"
	fi
}

# mutate_one <dir> <id> <mutant key> <test...> (a parallel worker): runs
# the tests that reach mutant <id> until one fails, and writes
# "id<TAB>killed|survived|timeout<TAB>test" to <dir>/res/<id>. The result
# of every (mutant, test) pair is cached in
# .kek-cache/mutate/run-<stage>-<mutant key>-<test key>.
mutate_one() {
	_d=$1
	_id=$2
	_mk=$3
	shift 3
	_res=survived
	_by=
	for _t in "$@"; do
		_tk=$(test_key "$_d" "$_t")
		_cf=$cache/mutate/run-$KEK_W_STAGE-$_mk-$_tk
		if [ -n "$_tk" ] && [ -f "$_cf" ]; then
			_r=$(cat "$_cf")
		else
			wasm_extra="$KEK_W_EXTRA --env KEK_MUTANT=$_id"
			set +e
			wasm "$_d/module.cwasm" "$_t" >"$_d/out/m$_id" 2>&1
			_c=$?
			set -e
			if [ $_c -eq 0 ]; then
				_r=survived
			elif grep -q 'wasm trap: interrupt' "$_d/out/m$_id"; then
				_r=timeout
			else
				_r=killed
			fi
			if [ -n "$_tk" ]; then
				echo "$_r" >"$_d/out/m$_id.cache"
				cache_put "$_cf" "$_d/out/m$_id.cache"
			fi
		fi
		if [ "$_r" != survived ]; then
			_res=$_r
			_by=$_t
			break
		fi
	done
	printf '%s\t%s\t%s\n' "$_id" "$_res" "$_by" >"$_d/res/$_id"
}

# mutate_extract <rev> <path> <outdir>: the program at a git revision.
# Prints the path of the base program.
mutate_extract() {
	if [ -d "$2" ]; then
		(cd "$2" && git archive --format=tar "$1:./") | tar -x -C "$3" ||
			die "kek mutate: -diff: cannot read $2 at $1"
		echo "$3"
	else
		_bn=$(basename "$2")
		(cd "$(dirname "$2")" && git show "$1:./$_bn") >"$3/$_bn" 2>/dev/null ||
			die "kek mutate: -diff: cannot read $2 at $1"
		echo "$3/$_bn"
	fi
}

# timeout_ms <s>: "2s", "500ms" or "2" (seconds) in milliseconds.
timeout_ms() {
	case $1 in
	*ms) _n=${1%ms}; _m=1 ;;
	*s) _n=${1%s}; _m=1000 ;;
	*) _n=$1; _m=1000 ;;
	esac
	printf '%s' "$_n" | grep -Eq '^[0-9]+$' || die "kek mutate: invalid -timeout $1 (use 2s or 500ms)"
	echo $((_n * _m))
}

cmd_mutate() {
	flag_json=false
	flag_run=
	flag_base=
	flag_diff=
	flag_timeout=
	flag_j=$(ncpu)
	tool_flags_parse mutate_usage "json run= base= diff= timeout= j#" "$@"
	[ "$tool_nrest" -eq 1 ] || { mutate_usage; exit 2; }
	_file=$tool_path
	[ -e "$_file" ] || die "stat $_file: no such file or directory"
	[ -z "$flag_base" ] || [ -z "$flag_diff" ] || die "kek mutate: -base and -diff are exclusive"
	_tmo=
	[ -z "$flag_timeout" ] || _tmo=$(timeout_ms "$flag_timeout")
	_stage=$(current_stage)
	_sk=$(basename "$_stage")
	_dir=$(mktemp -d "${TMPDIR:-/tmp}/kek-mutate-XXXXXX")
	trap 'rm -rf "$_dir"' EXIT
	_base=$flag_base
	if [ -n "$flag_diff" ]; then
		mkdir "$_dir/base-src"
		_base=$(mutate_extract "$flag_diff" "$_file" "$_dir/base-src")
	fi
	[ -z "$_base" ] || [ -e "$_base" ] || die "stat $_base: no such file or directory"
	# the build (mutant generation, type checks, schema) is cached by the
	# compiler and the contents of the program and of the base
	_bk=$(
		{
			echo "$_sk"
			for _p in "$_file" ${_base:+"$_base"}; do
				echo "=="
				if [ -d "$_p" ]; then
					for _f in "$_p"/*.kek; do
						printf '%s\0' "${_f##*/}"
						cat "$_f"
					done
				else
					cat "$_p"
				fi
			done
		} | sha
	)
	_b=$cache/mutate/build-$_bk
	mkdir -p "$cache/mutate"
	if [ ! -f "$_b/module.cwasm" ]; then
		_tmp=$(mktemp -d "$cache/tmp-XXXXXX")
		set +e
		if [ -n "$_base" ]; then
			compiler mutate-build "$_file" "$_tmp" -base "$_base"
		else
			compiler mutate-build "$_file" "$_tmp"
		fi
		_c=$?
		set -e
		if [ $_c -ne 0 ]; then
			rm -rf "$_tmp"
			exit $_c
		fi
		# the time limit needs epoch interruption compiled in
		# shellcheck disable=SC2086
		"$wasmtime" compile $wasm_flags -W epoch-interruption=y "$_tmp/module.wasm" -o "$_tmp/module.cwasm"
		if [ -e "$_b" ]; then
			rm -rf "$_tmp"
		else
			mv "$_tmp" "$_b"
			rm -rf "${_b:?}/$(basename "$_tmp")"
		fi
	fi
	for _f in tests.txt testkeys.txt mutants.txt mutants.json; do
		cp "$_b/$_f" "$_dir/$_f"
	done
	ln -s "$_b/module.cwasm" "$_dir/module.cwasm"
	select_tests "$_dir" "$flag_run"
	mkdir -p "$_dir/base" "$_dir/reach" "$_dir/out" "$_dir/res"
	: >"$_dir/baseline.txt"
	: >"$_dir/results.txt"
	if [ -s "$_dir/selected.txt" ] && [ -s "$_dir/mutants.txt" ]; then
		KEK_W_STAGE=$_sk
		KEK_W_CACHE=$cache/mutate/base-$_bk
		KEK_W_EXTRA="--env KEK_TEST=1 --env KEK_TEST_CLOCK=1767225600000 --env KEK_TEST_SEED=0 --env KEK_TEST_CASES=100 -W timeout=60s"
		export KEK_W_STAGE KEK_W_CACHE KEK_W_EXTRA
		# baseline: which mutant sites each test reaches
		: >"$_dir/torun.txt"
		test_jobs "$_dir" | while read -r _i _t _tk; do
			if [ -n "$_tk" ] && [ -f "$KEK_W_CACHE-$_tk" ]; then
				sed -n 1p "$KEK_W_CACHE-$_tk" >"$_dir/base/$_i"
				sed -n 2p "$KEK_W_CACHE-$_tk" >"$_dir/reach/$_i"
			else
				echo "$_i $_t $_tk" >>"$_dir/torun.txt"
			fi
		done
		if [ -s "$_dir/torun.txt" ]; then
			xargs -L 1 -P "$flag_j" "$root/kek" __mutate-base "$_dir" <"$_dir/torun.txt"
		fi
		cat "$_dir"/base/* >"$_dir/baseline.txt"
		if [ -z "$_tmo" ]; then
			_max=$(awk -F '\t' 'BEGIN { m = 0 } $3 + 0 > m { m = $3 + 0 } END { print m }' "$_dir/baseline.txt")
			_tmo=$((1000 + 10 * _max))
		fi
		KEK_W_EXTRA="--env KEK_TEST=1 --env KEK_TEST_CLOCK=1767225600000 --env KEK_TEST_SEED=0 --env KEK_TEST_CASES=100 -W timeout=${_tmo}ms"
		export KEK_W_EXTRA
		# plan: for every mutant, the passing tests that reach it; mutants
		# whose result is known from the cache are settled here
		for _bf in "$_dir"/base/*; do
			_i=${_bf##*/}
			awk -F '\t' -v r="$_dir/reach/$_i" '$2 == "ok" {
				while ((getline line < r) > 0) {
					n = split(line, ids, " ")
					for (k = 1; k <= n; k++) print ids[k], $1
				}
			}' "$_bf"
		done >"$_dir/reached.txt"
		awk -v reached="$_dir/reached.txt" -v keys="$_dir/testkeys.txt" -v res="$_dir/res/known" \
			-v pre="$cache/mutate/run-$_sk-" '
			BEGIN {
				while ((getline l < reached) > 0) { split(l, a, " "); t[a[1]] = t[a[1]] " " a[2] }
				while ((getline l < keys) > 0) { split(l, a, "\t"); k[a[1]] = a[2] }
				printf "" > res
			}
			{
				split($0, m, "\t")
				if (!(m[1] in t)) { printf "%s\tnocov\t\n", m[1] > res; next }
				n = split(t[m[1]], ts, " ")
				for (i = 1; i <= n; i++) {
					f = pre m[2] "-" k[ts[i]]
					r = ""
					if (k[ts[i]] != "" && (getline r < f) > 0) close(f)
					else r = ""
					if (r == "") { print m[1], m[2] t[m[1]]; next }
					if (r != "survived") { printf "%s\t%s\t%s\n", m[1], r, ts[i] > res; next }
				}
				printf "%s\tsurvived\t\n", m[1] > res
			}
		' "$_dir/mutants.txt" >"$_dir/plan.txt"
		if [ -s "$_dir/plan.txt" ]; then
			xargs -L 1 -P "$flag_j" "$root/kek" __mutate-one "$_dir" <"$_dir/plan.txt"
		fi
		cat "$_dir"/res/* >"$_dir/results.txt"
	elif [ -s "$_dir/selected.txt" ]; then
		awk '{ printf "%s\tok\t0\n", $0 }' "$_dir/selected.txt" >"$_dir/baseline.txt"
	fi
	set -- "$_dir"
	[ "$flag_json" = true ] && set -- -json "$@"
	compiler mutate-report "$@"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
bootstrap-check)
	bootstrap_check
	;;
bootstrap-update)
	bootstrap_check update
	cp "$_new" "$root/bootstrap/kek.wasm"
	echo "bootstrap/ updated"
	;;
build) cmd_build "$@" ;;
run) cmd_run "$@" ;;
test) cmd_test "$@" ;;
cover) cmd_cover "$@" ;;
mutate) cmd_mutate "$@" ;;
__cover-one) cover_one "$@" ;;
__mutate-base) mutate_base_one "$@" ;;
__mutate-one) mutate_one "$@" ;;
assure)
	# the compiler has no clock: pass today's date (KEK_TODAY overrides it)
	if [ $# -gt 0 ]; then
		_sub=$1
		shift
		compiler assure "$_sub" -today="${KEK_TODAY:-$(date +%Y-%m-%d)}" "$@"
	else
		compiler assure
	fi
	;;
similar) cmd_similar "$@" ;;
help | -h | --help) usage ;;
*) compiler "$cmd" "$@" ;;
esac
