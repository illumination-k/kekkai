#!/bin/sh
# kek: the Kekkai toolchain launcher.
#
# The compiler (compiler/, written in Kekkai) is a WasmGC + WASI module run
# by wasmtime. The compiler that runs is built from the current compiler/
# sources by the committed bootstrap compiler (bootstrap/kek.wasm) and
# cached under .kek-cache/stage-<hash>/, keyed by the hash of the
# bootstrap, the sources, the runtime prelude (lib/prelude), the core
# library (lib/core) and the wasmtime version. Cache entries are built in
# a temporary directory and renamed into place, so concurrent launches
# need no lock.
#
#   kek <command> [args...]         run a compiler command (check, ir, build, ...)
#   kek run <file|dir> [args...]    build a #[main] program and run it
#   kek test [flags] <file|dir>     run #[test] functions with mock capabilities
#   kek cover [flags] <file|dir>    coverage of the tests (.kek-cache/cover/)
#   kek mutate [flags] <file|dir>   mutation testing (.kek-cache/mutate/)
#   kek similar -diff <rev> ...     similar code, only what changed since a git revision
#   kek complexity -diff <rev> ...  complex code, only what changed since a git revision
#   KEK_STAGE=bootstrap kek ...     use the bootstrap compiler directly
#
# Results of `kek test` and the module.wasm of `kek build` / `kek run` are
# also cached (under test/ and build/), keyed by definition hashes.
#
# Maintenance:
#   kek bootstrap-check   rebuild the compiler with itself; require a fixed point
#   kek bootstrap-update  replace bootstrap/ with the current compiler (after the check)
set -eu

root=$(cd "$(dirname "$0")" && pwd)
ktab='	'
cache=${KEK_CACHE:-$root/.kek-cache}
wasmtime=${WASMTIME:-wasmtime}
wasm_flags="-W gc=y,function-references=y"
# Garbage collection: wasmtime's default (deferred reference counting) is
# several times slower than the copying collector on the compiler and on
# programs alike (the compiler builds itself in ~1.3s instead of ~10s). The
# compiler gets a large initial heap (reserved, not touched: a small
# program stays small). Precompiled modules must match these flags, so
# they are part of the compiler's cache key.
gc_compiler="-C collector=copying -O gc-heap-initial-size=1073741824"
gc_user="-C collector=copying"

die() {
	echo "$*" >&2
	exit 1
}

command -v "$wasmtime" >/dev/null 2>&1 || die "kek: wasmtime not found (install it with: mise install)"
# a mise shim costs ~0.1s per run and kek runs wasmtime many times: use the
# binary behind it (and pass it on to nested launches)
case $(command -v "$wasmtime") in
*/mise/shims/*)
	_real=$(cd "$root" && mise which wasmtime 2>/dev/null) || _real=
	if [ -n "$_real" ] && [ -x "$_real" ]; then
		wasmtime=$_real
		WASMTIME=$_real
		export WASMTIME
	fi
	;;
esac

sha() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum | cut -c1-24
	else
		shasum -a 256 | cut -c1-24
	fi
}

# wasm <module> [args...]: run a WASI module with the file system and the
# working directory of the caller. Extra flags (e.g. --env) come from
# $wasm_extra.
wasm() {
	_m=$1
	shift
	_pre=
	case $_m in *.cwasm) _pre=--allow-precompiled ;; esac
	# shellcheck disable=SC2086
	"$wasmtime" run $wasm_flags $(gc_flags "$_m") $_pre --dir / --env PWD="$PWD" ${wasm_extra:-} "$_m" "$@"
}

# gc_flags <module>: the collector of the compiler (the bootstrap, a stage,
# the stages of bootstrap-check) or of a program.
gc_flags() {
	case $1 in
	"$root"/bootstrap/* | "$cache"/stage-*/* | */kek-stage[23]-*/*) echo "$gc_compiler" ;;
	*) echo "$gc_user" ;;
	esac
}

# precompile <dir> [compiler]: precompile <dir>/module.wasm into
# <dir>/module.cwasm, for the compiler's or a program's collector.
precompile() {
	_g=$gc_user
	[ "${2:-}" != compiler ] || _g=$gc_compiler
	# shellcheck disable=SC2086
	"$wasmtime" compile $wasm_flags $_g ${compile_extra:-} "$1/module.wasm" -o "$1/module.cwasm"
}

sources_hash() {
	{
		cat "$root/bootstrap/kek.wasm"
		"$wasmtime" --version
		echo "$gc_compiler"
		for f in "$root"/compiler/*.kek "$root"/lib/prelude/*.kek "$root"/lib/core/*.kek; do
			printf '%s\0' "${f#"$root"/}"
			cat "$f"
			printf '\0'
		done
	} | sha
}

# build_compiler <compiler-module> <outdir>: compile compiler/ with the
# given compiler.
build_compiler() {
	mkdir -p "$2"
	(cd "$root" && wasm "$1" build compiler "$2") || return 1
	precompile "$2" compiler
}

bootstrap_module() {
	echo "$root/bootstrap/kek.wasm"
}

# current_stage prints the directory of the current compiler.
current_stage() {
	if [ "${KEK_STAGE:-}" = bootstrap ]; then
		echo "$root/bootstrap"
		return
	fi
	_dir=$cache/stage-$(sources_hash)
	if [ ! -f "$_dir/module.cwasm" ]; then
		mkdir -p "$cache"
		# the prelude and the core library are embedded in the compiler:
		# regenerate them first
		(cd "$root" && wasm "$(bootstrap_module)" embed-prelude lib/prelude compiler/prelude_src.kek) >&2
		(cd "$root" && wasm "$(bootstrap_module)" embed-prelude lib/core compiler/core_src.kek -as core) >&2
		_dir=$cache/stage-$(sources_hash)
		if [ ! -f "$_dir/module.cwasm" ]; then
			_tmp=$(mktemp -d "$cache/tmp-XXXXXX")
			build_compiler "$(bootstrap_module)" "$_tmp" >&2 || {
				rm -rf "$_tmp"
				die "kek: building the compiler failed"
			}
			if [ -e "$_dir" ]; then
				rm -rf "$_tmp" # lost a race: the entry is already there
			else
				mv "$_tmp" "$_dir"
				# mv moved it inside if another launch won in between
				rm -rf "${_dir:?}/$(basename "$_tmp")"
			fi
		fi
	fi
	echo "$_dir"
}

stage_module() {
	if [ "$1" = "$root/bootstrap" ]; then
		echo "$1/kek.wasm"
	else
		echo "$1/module.cwasm"
	fi
}

# stage_dir sets $_stage_memo to the directory of the current compiler.
stage_dir() {
	[ -n "${_stage_memo:-}" ] || _stage_memo=$(current_stage) || exit 1
}

# stage_key names the current compiler in cache keys.
stage_key() {
	stage_dir
	if [ "$_stage_memo" = "$root/bootstrap" ]; then
		echo "bootstrap-$(sha <"$root/bootstrap/kek.wasm")"
	else
		echo "${_stage_memo##*/}"
	fi
}

# compiler <args...>: run the current compiler (through the daemon when
# one is running for it and free).
compiler() {
	stage_dir
	if daemon_call "$@"; then
		return "$_dc_code"
	fi
	wasm "$(stage_module "$_stage_memo")" "$@"
}

# ---- the compiler daemon (kek daemon) ----
#
# `kek daemon start` keeps the compiler running (`serve`, compiler/serve.kek)
# with the parses of source files and of the core library in memory, so a
# build parses only what changed and no process starts. Requests are lines
# appended to <dir>/req.log, which `tail -f` feeds to its standard input;
# its output goes to <dir>/out.log and err.log, and <dir>/resp-<seq> holds
# the exit status. One request runs at a time: a launch that finds the
# daemon busy (<dir>/lock) runs the compiler itself instead.

daemon_dir() {
	echo "$cache/daemon/$(stage_key)"
}

# daemon_alive <dir>
daemon_alive() {
	[ -f "$1/pid" ] && kill -0 "$(cat "$1/pid")" 2>/dev/null
}

_dc_seq=0

# daemon_call <args...>: run a compiler command in the daemon. Returns 1
# (and the caller runs the compiler itself) when there is no daemon, it is
# busy or it died; otherwise sets _dc_code to the command's status.
daemon_call() {
	[ "${KEK_DAEMON:-1}" != 0 ] || return 1
	[ -n "${_stage_memo:-}" ] && [ "$_stage_memo" != "$root/bootstrap" ] || return 1
	_dd=$cache/daemon/${_stage_memo##*/}
	daemon_alive "$_dd" || return 1
	# fields are tab-separated: arguments with tabs, newlines or
	# backslashes go the direct way
	_dline=
	for _da in "$PWD" "$@"; do
		case $_da in
		*"$ktab"* | *"\\"* | *"
"*) return 1 ;;
		esac
		_dline="$_dline$ktab$_da"
	done
	mkdir "$_dd/lock" 2>/dev/null || return 1
	_dc_seq=$((_dc_seq + 1))
	_dseq=$$-$_dc_seq
	: >"$_dd/out.log"
	: >"$_dd/err.log"
	printf '%s%s\n' "$_dseq" "$_dline" >>"$_dd/req.log"
	_dn=0
	while [ ! -s "$_dd/resp-$_dseq" ]; do
		_dn=$((_dn + 1))
		if [ $((_dn % 50)) -eq 0 ] && ! daemon_alive "$_dd"; then
			rmdir "$_dd/lock" 2>/dev/null || true
			return 1
		fi
		sleep 0.005
	done
	cat "$_dd/out.log"
	cat "$_dd/err.log" >&2
	_dc_code=$(cat "$_dd/resp-$_dseq")
	rm -f "$_dd/resp-$_dseq"
	rmdir "$_dd/lock" 2>/dev/null || true
	return 0
}

cmd_daemon() {
	stage_dir
	[ "$_stage_memo" != "$root/bootstrap" ] || die "kek daemon: not with KEK_STAGE=bootstrap"
	_dd=$cache/daemon/${_stage_memo##*/}
	case ${1:-status} in
	start)
		if daemon_alive "$_dd"; then
			echo "kek daemon: running (pid $(cat "$_dd/pid"))"
			return 0
		fi
		mkdir -p "$_dd"
		rm -rf "$_dd/lock" "$_dd"/resp-*
		: >"$_dd/req.log"
		: >"$_dd/out.log"
		: >"$_dd/err.log"
		# shellcheck disable=SC2086
		nohup sh -c 'tail -n 0 -f "$1/req.log" | "$2" run $3 --allow-precompiled --dir / "$4" serve "$1" >>"$1/out.log" 2>>"$1/err.log"' \
			kek-daemon "$_dd" "$wasmtime" "$wasm_flags $gc_compiler" "$(stage_module "$_stage_memo")" >/dev/null 2>&1 &
		echo $! >"$_dd/pid"
		echo "kek daemon: started (pid $!)"
		;;
	stop)
		if ! daemon_alive "$_dd"; then
			echo "kek daemon: not running"
			return 0
		fi
		_dc_code=0
		daemon_call quit >/dev/null 2>&1 || true
		_p=$(cat "$_dd/pid")
		# the tail of the pipeline ends at its next write
		echo >>"$_dd/req.log"
		pkill -P "$_p" 2>/dev/null || true
		kill "$_p" 2>/dev/null || true
		rm -f "$_dd/pid"
		echo "kek daemon: stopped"
		;;
	status)
		if daemon_alive "$_dd"; then
			echo "kek daemon: running (pid $(cat "$_dd/pid"), compiler ${_stage_memo##*/})"
		else
			echo "kek daemon: not running"
			return 1
		fi
		;;
	stats)
		daemon_call serve-stats || die "kek daemon: not running or busy"
		;;
	*) die "usage: kek daemon start|stop|status|stats" ;;
	esac
}

# bootstrap_check requires stage1 (the current compiler, built by the
# bootstrap) to rebuild itself identically. With $1 = update, a change of
# the code the compiler generates for itself (e.g. in the runtime prelude)
# is allowed: stage2 (built by stage1) must then rebuild itself
# identically, and $_new is set to the module to install.
bootstrap_check() {
	_s1=$(current_stage)
	_new=$_s1/module.wasm
	_s2=$(mktemp -d "${TMPDIR:-/tmp}/kek-stage2-XXXXXX")
	if ! build_compiler "$_s1/module.cwasm" "$_s2"; then
		rm -rf "$_s2"
		echo "bootstrap-check: stage1 failed to build the compiler" >&2
		return 1
	fi
	if cmp -s "$_s1/module.wasm" "$_s2/module.wasm"; then
		echo "bootstrap-check: fixed point ($(wc -c <"$_s1/module.wasm" | tr -d ' ') bytes)"
		rm -rf "$_s2"
		return 0
	fi
	if [ "${1:-}" = update ]; then
		_s3=$(mktemp -d "${TMPDIR:-/tmp}/kek-stage3-XXXXXX")
		if build_compiler "$_s2/module.cwasm" "$_s3" && cmp -s "$_s2/module.wasm" "$_s3/module.wasm"; then
			echo "bootstrap-check: fixed point at stage2 ($(wc -c <"$_s2/module.wasm" | tr -d ' ') bytes)"
			_keep=$(mktemp -d "${TMPDIR:-/tmp}/kek-new-XXXXXX")
			cp "$_s2/module.wasm" "$_keep/module.wasm"
			_new=$_keep/module.wasm
			rm -rf "$_s2" "$_s3"
			return 0
		fi
		rm -rf "$_s3"
	fi
	rm -rf "$_s2"
	echo "bootstrap-check: no fixed point: module.wasm differs between stage1 and stage2" >&2
	return 1
}

usage() {
	cat <<'EOF'
kek — the Kekkai toolchain (self-hosted)

Usage:
  kek check <file|dir>            type-check (capabilities, effects, transactions)
  kek ir <file|dir>               print the intermediate representation
  kek build [-o dir] [-target d1|do] <file|dir>
                                  compile: a WASI command for #[main], a Worker for #[handler]
  kek run <file|dir> [args...]    compile a #[main] program and run it
  kek test [-run re] [-seed n] [-cases n] [-j n] [-json] [-no-cache] [-affected rev]
           [-clock ms] [-net f.json] [-db f.json] <file|dir>
                                  run the #[test] functions with mock capabilities
                                  (property tests, results cached by definition hash)
  kek cover [-json] [-lcov file] [-run re] [-seed n] <file|dir>
                                  line and branch coverage of the tests
  kek mutate [-json] [-run re] [-base <file|dir> | -diff rev] [-timeout 2s] <file|dir>
                                  mutation testing (typed mutants, cached results)
  kek fmt [-w|-check] <paths>     format
  kek fix [-w] <paths>            add the `mut` the mutability rules ask for
                                  (each path is a program; prints a diff without -w)
  kek caps [-json] <file|dir>     capabilities (side effects) of each function
  kek search [-json] '<sig>' [path]
                                  search functions by type
  kek affected [-json] (-base <file|dir> | -diff <rev>) <file|dir>
                                  definitions, tests and build output a change affects
  kek hash [-json] <file|dir>     definition hashes (alpha-normalized; trans = with dependencies)
  kek config                      print ./kekkai.toml as JSON
  kek assure (plan|apply|check) [flags] <file|dir>
                                  the guarantee ledger kekkai.assure.lock (docs/assure.md)
  kek similar [-json] [-threshold pct] [-all] [-tests] [-semantic] [-base path | -diff rev] <file|dir>
                                  duplicate and similar definitions (exit 1 when found)
  kek complexity [-json] [-all] [-tests] [-cognitive n] [-cyclomatic n] [-nesting n] [-lines n]
                 [-base path | -diff rev] <file|dir>
                                  cognitive / cyclomatic complexity and nesting of each function
                                  (exit 1 when one is over the limits)

Compiler internals:
  kek lex <file> | kek ast <file> token / syntax tree dumps
  kek test-build <file|dir> <outdir> [-list | -run name...]
  kek cover-build <file|dir> <outdir> [-main] | kek cover-report [-json] [-lcov f] <outdir>
  kek mutate-build <file|dir> <outdir> [-base p] [-main] | kek mutate-report [-json] <outdir>
  kek embed-prelude lib/prelude compiler/prelude_src.kek [-check]
  kek embed-prelude lib/core compiler/core_src.kek -as core [-check]

Editors:
  kek lsp                         language server on stdin/stdout (diagnostics, hover,
                                  definition, references, symbols; docs/tooling.md)

Daemon:
  kek daemon start|stop|status|stats
                                  keep the compiler running: parses stay in memory between builds

Maintenance:
  kek bootstrap-check             rebuild the compiler with itself; require a fixed point
  kek bootstrap-update            replace bootstrap/ with the current compiler (after the check)
EOF
}

# ---- kek build ----

# cached_build <path> <outdir> [args...]: `compiler build` through the
# build cache. module.wasm is stored under $cache/build/<stage>/<key>/,
# keyed by the program's definition hash (see `kek hash`), its entry kind
# and its handler parameters, so a program changed only in comments or
# formatting is not compiled again; the other outputs (worker.js,
# wrangler.toml, kekkai_meta.js) are always written by the compiler.
# KEK_BUILD_CACHE=0 disables the cache.
# src_digest <path> [args...]: the digest of an action's inputs: the
# compiler, the path, the arguments and the contents of the program's
# files (a directory's *.kek). Equal digests give equal outputs, so the
# compiler need not run at all (Bazel's action key).
src_digest() {
	_sd_p=$1
	shift
	{
		stage_key
		printf '%s\n%s\n' "$_sd_p" "$*"
		if [ -d "$_sd_p" ]; then
			for _sd_f in "$_sd_p"/*.kek; do
				printf '%s\0' "${_sd_f##*/}"
				cat "$_sd_f"
				printf '\0'
			done
		else
			cat "$_sd_p"
		fi
	} | sha
}

# ---- remote cache ----
#
# KEK_REMOTE_CACHE=<url> shares the action cache between machines (CI
# runners, developers) over the HTTP protocol of Bazel's remote cache:
# GET and PUT <url>/ac/<sha256>. bazel-remote serves it (with
# --disable_http_ac_validation, since the entries are kek's own), and so
# does any server accepting PUT; a file:// URL names a shared directory.
# A remote failure is a cache miss, never an error.

remote_key() {
	printf '%s' "$1" | {
		if command -v sha256sum >/dev/null 2>&1; then sha256sum; else shasum -a 256; fi
	} | cut -c1-64
}

# remote_get <name> <file>: fetch an entry (0 when found).
remote_get() {
	[ -n "${KEK_REMOTE_CACHE:-}" ] || return 1
	curl -fsS -o "$2" "${KEK_REMOTE_CACHE%/}/ac/$(remote_key "$1")" 2>/dev/null
}

# remote_put <name> <file>: upload an entry (errors are ignored).
remote_put() {
	[ -n "${KEK_REMOTE_CACHE:-}" ] || return 0
	case $KEK_REMOTE_CACHE in
	file://*) mkdir -p "${KEK_REMOTE_CACHE#file://}/ac" 2>/dev/null || true ;;
	esac
	curl -fsS -T "$2" "${KEK_REMOTE_CACHE%/}/ac/$(remote_key "$1")" >/dev/null 2>&1 || true
}

# action_fetch <dir>: when the action <dir> is not in the local cache,
# fetch it from the remote cache.
action_fetch() {
	[ -n "${KEK_REMOTE_CACHE:-}" ] && [ ! -e "$1" ] || return 0
	_af_t=$(mktemp -d "${TMPDIR:-/tmp}/kek-fetch-XXXXXX")
	if remote_get "${1#"$cache"/}" "$_af_t/a.tar" && mkdir "$_af_t/d" && tar -xf "$_af_t/a.tar" -C "$_af_t/d" 2>/dev/null && [ -f "$_af_t/d/ok" ]; then
		mkdir -p "${1%/*}"
		[ -e "$1" ] || mv "$_af_t/d" "$1" 2>/dev/null || true
	fi
	rm -rf "$_af_t"
}

# file_fetch <file> / file_push <file>: the same for a single-file entry.
file_fetch() {
	[ -n "${KEK_REMOTE_CACHE:-}" ] && [ ! -e "$1" ] || return 0
	_ff_t=$(mktemp "${TMPDIR:-/tmp}/kek-fetch-XXXXXX")
	if remote_get "${1#"$cache"/}" "$_ff_t"; then
		mkdir -p "${1%/*}"
		mv "$_ff_t" "$1"
	else
		rm -f "$_ff_t"
	fi
}

file_push() {
	[ -n "${KEK_REMOTE_CACHE:-}" ] || return 0
	remote_put "${1#"$cache"/}" "$1"
}

# action_put <dir> <files...>: store the files (those that exist) as the
# outputs of the action cached in <dir> (written aside, then renamed).
action_put() {
	_ap_d=$1
	shift
	[ ! -e "$_ap_d" ] || return 0
	mkdir -p "${_ap_d%/*}"
	_ap_t=$(mktemp -d "${_ap_d%/*}/tmp-XXXXXX")
	for _ap_f in "$@"; do
		[ ! -f "$_ap_f" ] || cp "$_ap_f" "$_ap_t/"
	done
	: >"$_ap_t/ok"
	if [ -e "$_ap_d" ]; then
		rm -rf "$_ap_t"
	else
		mv "$_ap_t" "$_ap_d"
		rm -rf "${_ap_d:?}/$(basename "$_ap_t")"
		if [ -n "${KEK_REMOTE_CACHE:-}" ]; then
			_ap_tar=$(mktemp "${TMPDIR:-/tmp}/kek-put-XXXXXX")
			tar -cf "$_ap_tar" -C "$_ap_d" . && remote_put "${_ap_d#"$cache"/}" "$_ap_tar"
			rm -f "$_ap_tar"
		fi
	fi
}

cached_build() {
	_bp=$1
	_bo=$2
	shift 2
	if [ "${KEK_BUILD_CACHE:-1}" = 0 ]; then
		compiler build "$_bp" "$_bo" "$@"
		return
	fi
	stage_dir
	# 1. the inputs are unchanged: reuse the outputs without the compiler
	# (its diagnostics are replayed). wrangler.toml is only written when
	# the output directory has none, as the compiler does.
	_bd=$cache/build/src-$(src_digest "$_bp" build "$@")
	action_fetch "$_bd"
	if [ -f "$_bd/ok" ] && { [ ! -f "$_bd/worker.js" ] || [ -f "$_bo/wrangler.toml" ] || [ -f "$_bd/wrangler.toml" ]; }; then
		for _bf in module.wasm kekkai_meta.js worker.js; do
			[ ! -f "$_bd/$_bf" ] || cp "$_bd/$_bf" "$_bo/$_bf"
		done
		[ -f "$_bo/wrangler.toml" ] || [ ! -f "$_bd/wrangler.toml" ] || cp "$_bd/wrangler.toml" "$_bo/wrangler.toml"
		[ ! -s "$_bd/stderr" ] || cat "$_bd/stderr" >&2
		return 0
	fi
	_btoml=0
	[ -f "$_bo/wrangler.toml" ] || _btoml=1
	# 2. otherwise the compiler checks the program and reuses the module
	# when its definition hashes are unchanged (comment-only edits)
	_bc=$cache/build/$(stage_key)
	_berr=$(mktemp "${TMPDIR:-/tmp}/kek-build-err-XXXXXX")
	set +e
	_bres=$(compiler build "$_bp" "$_bo" "$@" -cache "$_bc" 2>"$_berr")
	_bx=$?
	set -e
	cat "$_berr" >&2
	if [ $_bx -ne 0 ]; then
		rm -f "$_berr"
		return $_bx
	fi
	printf '%s\n' "$_bres" | grep -v '^kek-build-cache: ' | grep -v '^$' || true
	_bline=$(printf '%s\n' "$_bres" | grep '^kek-build-cache: ' | tail -n 1)
	# kek-build-cache: hit|miss <key> <entry>
	set -- $_bline
	_bkey=${3:-}
	_bentry=${4:-}
	case $_bline in
	*" hit "*)
		cp "$_bc/$_bkey/module.wasm" "$_bo/module.wasm"
		;;
	*" miss "*)
		mkdir -p "$_bc"
		_bt=$(mktemp -d "$_bc/tmp-XXXXXX")
		cp "$_bo/module.wasm" "$_bt/module.wasm"
		: >"$_bt/ok"
		if [ -e "$_bc/$_bkey" ]; then
			rm -rf "$_bt" # lost a race: the entry is already there
		else
			mv "$_bt" "$_bc/$_bkey"
			rm -rf "${_bc:?}/$_bkey/$(basename "$_bt")"
		fi
		;;
	esac
	# record the action: its outputs and diagnostics
	_bs=$(mktemp -d "${TMPDIR:-/tmp}/kek-build-out-XXXXXX")
	cp "$_bo/module.wasm" "$_bs/module.wasm"
	if [ "$_bentry" = handler ]; then
		cp "$_bo/kekkai_meta.js" "$_bo/worker.js" "$_bs/"
		[ $_btoml -eq 0 ] || cp "$_bo/wrangler.toml" "$_bs/wrangler.toml"
	fi
	mv "$_berr" "$_bs/stderr"
	action_put "$_bd" "$_bs"/*
	rm -rf "$_bs"
}

cmd_build() {
	_out=out
	_target=d1
	_path=
	_n=0
	while [ $# -gt 0 ]; do
		case $1 in
		-o | --o)
			[ $# -ge 2 ] || die "usage: kek build [-o dir] [-target d1|do] <file|dir>"
			_out=$2
			shift
			;;
		-o=* | --o=*) _out=${1#*=} ;;
		-target | --target)
			[ $# -ge 2 ] || die "usage: kek build [-o dir] [-target d1|do] <file|dir>"
			_target=$2
			shift
			;;
		-target=* | --target=*) _target=${1#*=} ;;
		*)
			_path=$1
			_n=$((_n + 1))
			;;
		esac
		shift
	done
	if [ "$_n" -ne 1 ]; then
		echo "usage: kek build [-o dir] [-target d1|do] <file|dir>" >&2
		exit 2
	fi
	mkdir -p "$_out"
	cached_build "$_path" "$_out" -target "$_target" || exit $?
	if [ -f "$_out/kekkai_meta.js" ]; then
		cp "$root/js/kekkai_runtime.js" "$_out/kekkai_runtime.js"
	fi
	echo "$_path -> $_out ($(wc -c <"$_out/module.wasm" | tr -d ' ') bytes of wasm)"
}

# ---- kek run ----

cmd_run() {
	if [ $# -lt 1 ]; then
		echo "usage: kek run <file|dir> [args...]" >&2
		exit 2
	fi
	_src=$1
	shift
	_out=$(mktemp -d "${TMPDIR:-/tmp}/kek-run-XXXXXX")
	trap 'rm -rf "$_out"' EXIT
	cached_build "$_src" "$_out" || exit $?
	if [ -f "$_out/kekkai_meta.js" ]; then
		die "kek run: $_src is a #[handler] program (serve it locally with scripts/dev.sh)"
	fi
	set +e
	wasm "$_out/module.wasm" "$@"
	_code=$?
	set -e
	exit $_code
}

# ---- kek test ----
#
# test-build -list discovers the tests with their definition hashes
# (tests.tsv). A test's result is a function of the compiler stage, its
# trans hash, the mock options (-seed, -clock, the contents of -net/-db
# files) and its number of cases, so results are cached under
# $cache/test/<options key>/<hash>-<cases>-<name>. Only the uncached tests
# are built (test-build -run) and run, -j at a time; the results are
# printed in declaration order.

test_usage() {
	cat >&2 <<'EOF'
Usage of test:
  -affected string
    	run only the tests that a change since this git revision can affect
  -cases int
    	cases of a property test (a test with generated parameters) (default 100)
  -clock int
    	fixed time of the mock &Clock (ms since the epoch) (default 1767225600000)
  -db string
    	JSON file with the initial contents of the mock &Db store: {"key": "value"}
  -j int
    	run this many tests at a time (default: the number of CPUs)
  -json
    	print the results as JSON
  -net string
    	JSON file of canned &Net responses: {"GET url": "body", "POST url": {"error": "msg"}}
  -no-cache
    	run every test, ignoring cached results (also KEK_TEST_CACHE=0)
  -run string
    	run only tests whose name matches this extended regular expression
  -seed int
    	seed of the mock &Random and of the inputs of property tests
EOF
}

test_usage_error() {
	echo "$1" >&2
	test_usage
	exit 2
}

is_int64() {
	printf '%s' "$1" | grep -Eq '^[+-]?(0|[1-9][0-9]*)$' || return 1
	_d=${1#[+-]}
	[ ${#_d} -lt 19 ] && return 0
	[ ${#_d} -gt 19 ] && return 1
	case $1 in
	-*) [ "$_d" \< "9223372036854775809" ] ;;
	*) [ "$_d" \< "9223372036854775808" ] ;;
	esac
}

ncpu() {
	getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 1
}

# json_str <s>: a JSON string literal (s has no control characters).
json_str() {
	printf '"%s"' "$(printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g')"
}

# test_batch <dir> <chunk> (a parallel worker): runs the tests of
# <dir>/chunk.<chunk> (lines `0 name`) with `module --batch`, many tests per
# process, and writes their whole output to <dir>/clog.<chunk>. A test that
# traps or times out ends its process: `kek-crash` and its stderr
# (`kek-err` lines) follow, and the remaining tests run in a new process.
# A wall-clock timeout (KEK_TEST_TIMEOUT) is per process, so a test
# interrupted after others ran in its process first runs again alone.
test_batch() {
	_d=$1
	_c=$2
	_rest=$_d/rest.$_c
	cp "$_d/chunk.$_c" "$_rest"
	: >"$_d/clog.$_c"
	while [ -s "$_rest" ]; do
		set +e
		wasm_extra="$KEK_W_EXTRA --env KEK_BATCH=$_rest"
		wasm "$_d/module.cwasm" --batch >"$_d/o.$_c" 2>"$_d/e.$_c"
		_x=$?
		set -e
		_n=$(grep -c '^kek-start' "$_d/o.$_c" || true)
		if [ $_x -ne 0 ] && [ "$_n" -gt 1 ] && grep -q 'wasm trap: interrupt' "$_d/e.$_c"; then
			awk -v n="$_n" '/^kek-start/ { k++ } k < n' "$_d/o.$_c" >>"$_d/clog.$_c"
			tail -n +"$_n" "$_rest" >"$_rest.tmp"
			mv "$_rest.tmp" "$_rest"
			continue
		fi
		cat "$_d/o.$_c" >>"$_d/clog.$_c"
		[ $_x -ne 0 ] || break
		[ "$_n" -gt 0 ] || _n=1
		echo "kek-crash" >>"$_d/clog.$_c"
		sed 's/^/kek-err /' "$_d/e.$_c" >>"$_d/clog.$_c"
		tail -n +$((_n + 1)) "$_rest" >"$_rest.tmp"
		mv "$_rest.tmp" "$_rest"
	done
}

# test_run_batch <dir> <jobs>: runs the tests of <dir>/run.txt in <jobs>
# batch processes and writes <dir>/r/<name>.out and .st (ok, failed or
# trapped), as one process per test would have.
test_run_batch() {
	_d=$1
	rm -f "$_d"/chunk.* "$_d"/clog.*
	awk -v n="$2" -v d="$_d" '{ print "0 " $0 > (d "/chunk." ((NR - 1) % n)) }' "$_d/run.txt"
	for _p in "$_d"/chunk.*; do
		test_batch "$_d" "${_p##*.}" &
	done
	wait
	cat "$_d"/clog.* | awk -v r="$_d/r" '
		function finish() {
			if (t == "") return
			if (crashed) {
				body = body "test " t " ... FAILED (trapped)\n"
				body = body "    trap: " (trap != "" ? trap : other) "\n"
				if (last != "") body = body "    last input: " last "\n"
			}
			printf "%s", body > (r "/" t ".out"); close(r "/" t ".out")
			print st > (r "/" t ".st"); close(r "/" t ".st")
			t = ""
		}
		/^kek-start / { next }
		/^kek-test / { finish(); t = $2; body = ""; st = "error"; crashed = 0; trap = ""; last = ""; other = ""; next }
		/^kek-base / { st = $3; next }
		/^kek-crash/ { crashed = 1; st = "trapped"; next }
		/^kek-err / {
			l = substr($0, 9)
			if (l ~ /wasm trap: /) { if (trap == "") { trap = l; sub(/.*wasm trap: /, "", trap) } }
			else if (l ~ /^kek-case: /) last = substr(l, 11)
			else if (l != "") other = l
			next
		}
		{ if (!crashed) body = body $0 "\n" }
		END { finish() }
	'
}

# ---- kek affected ----

cmd_affected() {
	_aj=
	_abase=
	_arev=
	while [ $# -gt 0 ]; do
		case $1 in
		-json | --json) _aj=-json ;;
		-base | --base) _abase=${2:-}; shift ;;
		-base=* | --base=*) _abase=${1#*=} ;;
		-diff | --diff) _arev=${2:-}; shift ;;
		-diff=* | --diff=*) _arev=${1#*=} ;;
		-h | -help | --help)
			echo "usage: kek affected [-json] (-base <file|dir> | -diff <rev>) <file|dir>" >&2
			exit 0
			;;
		-*) die "flag provided but not defined: $1" ;;
		*) break ;;
		esac
		shift
	done
	[ $# -eq 1 ] || die "usage: kek affected [-json] (-base <file|dir> | -diff <rev>) <file|dir>"
	[ -e "$1" ] || die "stat $1: no such file or directory"
	if [ -n "$_arev" ]; then
		[ -z "$_abase" ] || die "kek affected: -base and -diff are exclusive"
		_adir=$(mktemp -d "${TMPDIR:-/tmp}/kek-affected-XXXXXX")
		trap 'rm -rf "$_adir"' EXIT
		_abase=$(mutate_extract "$_arev" "$1" "$_adir")
	fi
	[ -n "$_abase" ] || die "kek affected: -base or -diff is required"
	# shellcheck disable=SC2086
	compiler affected $_aj -base "$_abase" "$1"
}

cmd_test() {
	_run=
	_seed=0
	_clock=1767225600000
	_net=
	_db=
	_cases=100
	_jobs=
	_json=0
	_nocache=0
	_affected=
	while [ $# -gt 0 ]; do
		case $1 in
		--) shift; break ;;
		-?*) ;;
		*) break ;;
		esac
		_name=${1#-}
		_name=${_name#-}
		_val=
		_has=0
		case $_name in
		*=*)
			_val=${_name#*=}
			_name=${_name%%=*}
			_has=1
			;;
		esac
		case $_name in
		h | help) test_usage; exit 0 ;;
		json | no-cache)
			if [ $_has -eq 0 ]; then
				_val=true
			fi
			case $_val in
			true | 1) _b=1 ;;
			false | 0) _b=0 ;;
			*) test_usage_error "invalid boolean value \"$_val\" for -$_name: parse error" ;;
			esac
			case $_name in
			json) _json=$_b ;;
			no-cache) _nocache=$_b ;;
			esac
			shift
			continue
			;;
		run | seed | clock | net | db | cases | j | affected) ;;
		*) test_usage_error "flag provided but not defined: -$_name" ;;
		esac
		if [ $_has -eq 0 ]; then
			[ $# -ge 2 ] || test_usage_error "flag needs an argument: -$_name"
			_val=$2
			shift
		fi
		case $_name in
		seed | clock)
			is_int64 "$_val" || test_usage_error "invalid value \"$_val\" for flag -$_name: parse error"
			;;
		cases | j)
			printf '%s' "$_val" | grep -Eq '^[1-9][0-9]{0,8}$' ||
				test_usage_error "invalid value \"$_val\" for flag -$_name: want a positive integer"
			;;
		esac
		case $_name in
		run) _run=$_val ;;
		seed) _seed=$_val ;;
		clock) _clock=$_val ;;
		net) _net=$_val ;;
		db) _db=$_val ;;
		cases) _cases=$_val ;;
		j) _jobs=$_val ;;
		affected) _affected=$_val ;;
		esac
		shift
	done
	[ $# -eq 1 ] || die "kek test: expected exactly one .kek file"
	_file=$1
	[ -e "$_file" ] || die "stat $_file: no such file or directory"
	[ "${_clock#+}" = 0 ] && _clock=1767225600000
	[ "${KEK_TEST_CACHE:-1}" != 0 ] || _nocache=1
	[ -n "$_jobs" ] || _jobs=$(ncpu)

	_dir=$(mktemp -d "${TMPDIR:-/tmp}/kek-test-XXXXXX")
	trap 'rm -rf "$_dir"' EXIT
	mkdir "$_dir/r"
	# the test list (names, hashes, parameters) is an action keyed by the
	# program's files: unchanged sources need no compiler run
	_ld=$cache/test-list/$(src_digest "$_file" test-list)
	action_fetch "$_ld"
	if [ -f "$_ld/ok" ]; then
		cp "$_ld/tests.txt" "$_ld/tests.tsv" "$_ld/tests.json" "$_dir/"
	else
		compiler test-build "$_file" "$_dir" -list || exit $?
		action_put "$_ld" "$_dir/tests.txt" "$_dir/tests.tsv" "$_dir/tests.json"
	fi
	# errors in the options are reported after the program's diagnostics
	for _f in "$_net" "$_db"; do
		[ -z "$_f" ] || [ -f "$_f" ] || die "open $_f: no such file or directory"
	done
	if [ -n "$_run" ]; then
		set +e
		grep -E -- "$_run" "$_dir/tests.txt" >"$_dir/selected.txt" 2>"$_dir/grep.err"
		_g=$?
		set -e
		[ $_g -le 1 ] || die "kek test: -run: invalid regular expression: $_run"
	else
		cp "$_dir/tests.txt" "$_dir/selected.txt"
	fi
	if [ -n "$_affected" ]; then
		# only the tests a change since the git revision can affect
		mkdir "$_dir/base-src"
		_abase=$(mutate_extract "$_affected" "$_file" "$_dir/base-src")
		compiler affected -tests_only -base "$_abase" "$_file" >"$_dir/affected.txt" || exit $?
		grep -Fx -f "$_dir/affected.txt" "$_dir/selected.txt" >"$_dir/sel2.txt" || true
		mv "$_dir/sel2.txt" "$_dir/selected.txt"
	fi
	_count=$(wc -l <"$_dir/selected.txt" | tr -d ' ')
	if [ "$_count" -eq 0 ]; then
		if [ $_json -eq 1 ]; then
			echo "{\"file\":$(json_str "$_file"),\"passed\":0,\"failed\":0,\"cached\":0,\"tests\":[]}"
		else
			echo "$_file: no tests"
		fi
		exit 0
	fi

	# the cache directory of these options
	_tc=$cache/test/$(
		{
			printf 'kek-test-1\n%s\n%s\n%s\n' "$(stage_key)" "$_seed" "$_clock"
			printf 'net\n'
			[ -z "$_net" ] || cat "$_net"
			printf '\ndb\n'
			[ -z "$_db" ] || cat "$_db"
		} | sha
	)
	# plan: the selected tests in declaration order; uncached ones get a
	# run number
	awk -F '\t' 'NR == FNR { want[$1] = 1; next } want[$1]' \
		"$_dir/selected.txt" "$_dir/tests.tsv" >"$_dir/plan.tsv"
	if [ -n "${KEK_REMOTE_CACHE:-}" ] && [ "$_nocache" -eq 0 ]; then
		awk -F '\t' -v tc="$_tc" -v cases="$_cases" '{
			c = $4 + 0
			if ($3 + 0 == 0) c = 1
			else if (c <= 0) c = cases
			print tc "/" $2 "-" c "-" $1
		}' "$_dir/plan.tsv" | while read -r _rf; do
			file_fetch "$_rf"
		done
	fi
	awk -F '\t' -v tc="$_tc" -v nocache="$_nocache" -v cases="$_cases" '
		{
			c = $4 + 0
			if ($3 + 0 == 0) c = 1
			else if (c <= 0) c = cases
			f = tc "/" $2 "-" c "-" $1
			if (!nocache && (getline l < f) > 0) { close(f); next }
			print $1
		}' "$_dir/plan.tsv" >"$_dir/run.txt"
	_nrun=$(wc -l <"$_dir/run.txt" | tr -d ' ')

	if [ "$_nrun" -gt 0 ]; then
		# shellcheck disable=SC2046
		compiler test-build "$_file" "$_dir" -run $(cat "$_dir/run.txt") || exit $?
		# KEK_TEST_TIMEOUT (e.g. 10s) bounds each test process; the
		# interruption must be compiled in too
		[ -z "${KEK_TEST_TIMEOUT:-}" ] || compile_extra="-W epoch-interruption=y"
		precompile "$_dir"
		compile_extra=
	fi
	wasm_extra="--env KEK_TEST=1 --env KEK_TEST_CLOCK=$_clock --env KEK_TEST_SEED=$_seed --env KEK_TEST_CASES=$_cases"
	[ -z "$_net" ] || wasm_extra="$wasm_extra --env KEK_TEST_NET=$_net"
	[ -z "$_db" ] || wasm_extra="$wasm_extra --env KEK_TEST_DB=$_db"
	[ -z "${KEK_TEST_TIMEOUT:-}" ] || wasm_extra="$wasm_extra -W timeout=$KEK_TEST_TIMEOUT"
	if [ "$_nrun" -gt 0 ] && [ -n "$_net$_db" ]; then
		wasm "$_dir/module.cwasm" "" || exit 1
	fi
	if [ $_json -eq 0 ]; then
		if [ "$_count" -eq 1 ]; then
			echo "running 1 test from $_file"
		else
			echo "running $_count tests from $_file"
		fi
	fi
	_passed=0
	_failed=0
	_ncached=0
	if [ "$_nrun" -gt 0 ]; then
		KEK_W_EXTRA=$wasm_extra
		test_run_batch "$_dir" "$_jobs"
	fi
	# report in declaration order, in one awk process (no fork per test):
	# cached results come from $_tc, new ones from the batch runs and are
	# added to the cache (written to a temporary file, then renamed)
	_jn=0
	[ $_json -eq 0 ] || _jn=1
	[ "$_nocache" -ne 0 ] || mkdir -p "$_tc"
	_ncache=$_nocache
	set +e
	awk -F '\t' -v tc="$_tc" -v r="$_dir/r" -v nocache="$_ncache" -v json="$_jn" \
		-v file="$_file" -v cases="$_cases" -v mv="$_dir/mv.txt" '
	function esc(s,   x, i, c) {
		gsub(/\\/, "\\\\", s)
		gsub(/"/, "\\\"", s)
		gsub(/\t/, "\\t", s)
		gsub(/\r/, "\\r", s)
		if (s ~ /[\001-\037]/) {
			x = ""
			for (i = 1; i <= length(s); i++) {
				c = substr(s, i, 1)
				x = x (c ~ /[\001-\037]/ ? sprintf("\\u%04x", ord[c]) : c)
			}
			s = x
		}
		return "\"" s "\""
	}
	# readall <file> into lines[1..n]; returns n (0 when missing)
	function readall(f,   n, l) {
		n = 0
		while ((getline l < f) > 0) lines[++n] = l
		close(f)
		return n
	}
	BEGIN {
		for (i = 1; i < 32; i++) ord[sprintf("%c", i)] = i
		printf "" > mv
	}
	{
		name = $1; hash = $2; np = $3 + 0; c = $4 + 0; caps = $5
		if (np == 0) c = 1
		else if (c <= 0) c = cases
		key = hash "-" c "-" name
		cached = 0
		n = 0
		if (!nocache) n = readall(tc "/" key)
		if (n > 0) {
			cached = 1
			st = lines[1]
			for (i = 2; i <= n; i++) out[i - 1] = lines[i]
			nout = n - 1
			ncached++
		} else {
			st = "error"
			if (readall(r "/" name ".st") > 0) st = lines[1]
			nout = readall(r "/" name ".out")
			for (i = 1; i <= nout; i++) out[i] = lines[i]
			if (st == "error") st = "trapped"
			else if (!nocache) {
				tmp = tc "/tmp-" key
				print st > tmp
				for (i = 1; i <= nout; i++) print out[i] > tmp
				close(tmp)
				print tmp "\t" tc "/" key > mv
			}
		}
		if (st == "ok") passed++
		else failed++
		if (json) {
			ms = "null"; ce = "null"; o = ""; k = 0
			if (nout > 0 && match(out[1], /; [0-9]+\.[0-9]+ms\)$/)) ms = substr(out[1], RSTART + 2, RLENGTH - 5)
			for (i = 2; i <= nout; i++) {
				line = out[i]
				sub(/^    /, "", line)
				o = o (k++ > 0 ? "," : "") esc(line)
				if (line ~ /^counterexample: /) ce = esc(substr(line, 17))
			}
			cs = ""
			m = split(caps, a, ",")
			for (i = 1; i <= m; i++) cs = cs (i > 1 ? "," : "") esc(a[i])
			objs = objs (NR > 1 ? "," : "") sprintf("{\"name\":%s,\"status\":\"%s\",\"cached\":%s,\"pure\":%s,\"caps\":[%s],\"hash\":%s,\"ms\":%s,\"output\":[%s],\"counterexample\":%s}", esc(name), st, (cached ? "true" : "false"), (m == 0 ? "true" : "false"), cs, esc(hash), ms, o, ce)
		} else {
			for (i = 1; i <= nout; i++) print out[i] (i == 1 && cached ? " (cached)" : "")
		}
	}
	END {
		passed += 0; failed += 0; ncached += 0
		if (json) {
			printf "{\"file\":%s,\"passed\":%d,\"failed\":%d,\"cached\":%d,\"tests\":[%s]}\n", esc(file), passed, failed, ncached, objs
		} else {
			note = (ncached > 0 ? " (" ncached " cached)" : "")
			print ""
			if (failed == 0) print "test result: ok. " passed " passed; " failed " failed" note
			else print "test result: FAILED. " passed " passed; " failed " failed" note
		}
		exit failed > 0 ? 1 : 0
	}' "$_dir/plan.tsv"
	_status=$?
	set -e
	if [ -s "$_dir/mv.txt" ]; then
		_tab=$(printf '\t')
		while IFS=$_tab read -r _from _to; do
			mv "$_from" "$_to"
			file_push "$_to"
		done <"$_dir/mv.txt"
	fi
	exit $_status
}

# ---- kek similar -diff <rev> ----

# cmd_similar runs `similar` (-diff <rev>: with_diff).
# similar_semantic <path> [-all] [-tests]: run the candidate pairs of the
# semantic kind as property tests (each compares the two functions'
# results on generated inputs) and print the path of the file listing the
# pairs that agreed on every input. Temporary files go to $_sem_dir.
similar_semantic() {
	_sem_dir=$(mktemp -d "${TMPDIR:-/tmp}/kek-semantic-XXXXXX")
	mkdir -p "$_sem_dir/prog"
	compiler similar -semantic_plan "$_sem_dir" "$@" || exit 2
	: >"$_sem_dir/equiv.txt"
	[ -s "$_sem_dir/pairs.tsv" ] || return 0
	set +e
	(KEK_TEST_TIMEOUT=${KEK_TEST_TIMEOUT:-10s} cmd_test -json -run '^kek_sim_eq_[0-9]+$' "$_sem_dir/prog") \
		>"$_sem_dir/result.json" 2>"$_sem_dir/result.err"
	set -e
	_tab=$(printf '\t')
	while IFS="$_tab" read -r _i _a _b; do
		if grep -q "\"name\":\"kek_sim_eq_$_i\",\"status\":\"ok\"" "$_sem_dir/result.json"; then
			printf '%s\t%s\n' "$_a" "$_b" >>"$_sem_dir/equiv.txt"
		fi
	done <"$_sem_dir/pairs.tsv"
}

cmd_similar() {
	# -semantic: compare outputs on generated inputs first (similar_semantic)
	_sem=0
	_sem_flags=
	_sem_path=
	_n=$#
	while [ $_n -gt 0 ]; do
		_a=$1
		shift
		_n=$((_n - 1))
		case $_a in
		-semantic | --semantic) _sem=1 ;;
		*)
			case $_a in
			-all | --all | -tests | --tests) _sem_flags="$_sem_flags $_a" ;;
			-*) ;;
			*) _sem_path=$_a ;;
			esac
			set -- "$@" "$_a"
			;;
		esac
	done
	if [ $_sem -eq 1 ]; then
		[ -n "$_sem_path" ] || die "usage: kek similar -semantic [flags] <file|dir>"
		# shellcheck disable=SC2086
		similar_semantic $_sem_flags "$_sem_path"
		set -- -equiv "$_sem_dir/equiv.txt" "$@"
		trap 'rm -rf "$_sem_dir"' EXIT
	fi
	with_diff similar "kek similar [-json] [-threshold pct] [-all] [-tests] [-base path | -diff rev] <file|dir>" "$@"
}

# with_diff <cmd> <usage> [args...]: run the compiler command cmd (similar,
# complexity). With -diff <rev>, the program as of the git revision rev is
# extracted into a temporary directory and passed as -base, so that only
# findings with a new or changed definition are reported (the CI mode for
# pull requests).
with_diff() {
	_cmd=$1
	_usage=$2
	shift 2
	_rev=
	_has_rev=0
	_path=
	_skip=0
	for _a in "$@"; do
		if [ $_skip -eq 1 ]; then
			_rev=$_a
			_skip=0
			continue
		fi
		case $_a in
		-diff | --diff) _skip=1; _has_rev=1 ;;
		-diff=* | --diff=*) _rev=${_a#*=}; _has_rev=1 ;;
		*) _path=$_a ;;
		esac
	done
	if [ $_has_rev -eq 0 ]; then
		compiler "$_cmd" "$@"
		return
	fi
	if [ $_skip -eq 1 ] || [ -z "$_rev" ]; then
		echo "flag needs an argument: -diff" >&2
		echo "usage: $_usage" >&2
		exit 2
	fi
	# drop -diff <rev> from the arguments
	_skip=0
	_n=$#
	while [ $_n -gt 0 ]; do
		_a=$1
		shift
		_n=$((_n - 1))
		if [ $_skip -eq 1 ]; then
			_skip=0
			continue
		fi
		case $_a in
		-diff | --diff) _skip=1 ;;
		-diff=* | --diff=*) ;;
		*) set -- "$@" "$_a" ;;
		esac
	done
	if [ -z "$_path" ] || [ ! -e "$_path" ]; then
		echo "kek $_cmd -diff: no such file or directory: ${_path:-<file|dir>}" >&2
		exit 2
	fi
	_top=$(git rev-parse --show-toplevel 2>/dev/null) || {
		echo "kek $_cmd -diff: not in a git repository" >&2
		exit 2
	}
	git rev-parse --verify --quiet "$_rev^{commit}" >/dev/null || {
		echo "kek $_cmd -diff: unknown revision $_rev" >&2
		exit 2
	}
	if [ -d "$_path" ]; then
		_abs=$(cd "$_path" && pwd -P)
	else
		_abs=$(cd "$(dirname "$_path")" && pwd -P)/$(basename "$_path")
	fi
	_top=$(cd "$_top" && pwd -P)
	case $_abs in
	"$_top") _rel=. ;;
	"$_top"/*) _rel=${_abs#"$_top"/} ;;
	*)
		echo "kek $_cmd -diff: $_path is outside the repository $_top" >&2
		exit 2
		;;
	esac
	_base=$(mktemp -d "${TMPDIR:-/tmp}/kek-$_cmd-XXXXXX")
	trap 'rm -rf "$_base" ${_sem_dir:+"$_sem_dir"}' EXIT
	set +e
	if git -C "$_top" archive --format=tar "$_rev" -- "$_rel" 2>/dev/null | tar -x -C "$_base" 2>/dev/null &&
		[ -e "$_base/$_rel" ]; then
		compiler "$_cmd" -base "$_base/$_rel" -base_name "git:$_rev" "$@"
	else
		# the path did not exist at rev: every definition is new
		compiler "$_cmd" "$@"
	fi
	_code=$?
	set -e
	exit $_code
}

# ---- kek complexity -diff <rev> ----

cmd_complexity() {
	with_diff complexity "kek complexity [-json] [-all] [-tests] [-cognitive n] [-cyclomatic n] [-nesting n] [-lines n] [-base path | -diff rev] <file|dir>" "$@"
}

# ---- kek cover / kek mutate ----

# tool_flags_parse <usage-fn> <spec> <args...>: Go-style flag parsing for
# cover and mutate. spec lists the flags: "json" is a boolean, "run=" takes
# a value, "seed#" an integer. Sets flag_<name> and leaves the remaining
# arguments in $tool_rest (count $tool_nrest, the path in $tool_path).
tool_flags_parse() {
	_tf_usage=$1
	_tf_spec=$2
	shift 2
	while [ $# -gt 0 ]; do
		case $1 in
		--) shift; break ;;
		-?*) ;;
		*) break ;;
		esac
		_name=${1#-}
		_name=${_name#-}
		_val=
		_has=0
		case $_name in
		*=*)
			_val=${_name#*=}
			_name=${_name%%=*}
			_has=1
			;;
		esac
		case $_name in
		h | help) "$_tf_usage"; exit 0 ;;
		esac
		_kind=
		for _s in $_tf_spec; do
			case $_s in
			"$_name") _kind=bool ;;
			"$_name=") _kind=str ;;
			"$_name#") _kind=int ;;
			esac
		done
		if [ -z "$_kind" ]; then
			echo "flag provided but not defined: -$_name" >&2
			"$_tf_usage"
			exit 2
		fi
		if [ "$_kind" = bool ]; then
			[ $_has -eq 1 ] || _val=true
			case $_val in
			1 | t | T | true | TRUE | True) _val=true ;;
			0 | f | F | false | FALSE | False) _val=false ;;
			*)
				echo "invalid boolean value \"$_val\" for -$_name: parse error" >&2
				"$_tf_usage"
				exit 2
				;;
			esac
		else
			if [ $_has -eq 0 ]; then
				if [ $# -lt 2 ]; then
					echo "flag needs an argument: -$_name" >&2
					"$_tf_usage"
					exit 2
				fi
				_val=$2
				shift
			fi
			if [ "$_kind" = int ] && ! is_int64 "$_val"; then
				echo "invalid value \"$_val\" for flag -$_name: parse error" >&2
				"$_tf_usage"
				exit 2
			fi
		fi
		eval "flag_$_name=\$_val"
		shift
	done
	tool_nrest=$#
	tool_path=${1:-}
}

# select_tests <dir> <re>: <dir>/selected.txt = the tests matching re.
select_tests() {
	if [ -n "$2" ]; then
		set +e
		grep -E -- "$2" "$1/tests.txt" >"$1/selected.txt" 2>/dev/null
		_g=$?
		set -e
		[ $_g -le 1 ] || die "kek: -run: invalid regular expression: $2"
	else
		cp "$1/tests.txt" "$1/selected.txt"
	fi
}

# test_key <dir> <test>: the trans hash of a test (testkeys.txt).
test_key() {
	awk -F '\t' -v t="$2" '$1 == t { print $2 }' "$1/testkeys.txt"
}

# cache_put <file> <content-file>: store a cache entry atomically.
cache_put() {
	_cp_tmp=$1.tmp.$$
	cp "$2" "$_cp_tmp" && mv "$_cp_tmp" "$1"
}

cover_usage() {
	cat >&2 <<'EOF'
Usage of cover: kek cover [flags] <file|dir>
  -j int
    	parallel test processes (default: number of CPUs)
  -json
    	print the report as JSON
  -lcov string
    	also write an lcov tracefile to this file
  -run string
    	run only tests whose name matches this extended regular expression
  -seed int
    	seed of the mock &Random
EOF
}

# test_jobs <dir>: "index test trans-hash" for every selected test.
test_jobs() {
	awk -F '\t' 'NR == FNR { k[$1] = $2; next } { printf "%05d %s %s\n", FNR, $0, k[$0] }' \
		"$1/testkeys.txt" "$1/selected.txt"
}

# cover_one <dir> <index> <test> <test key> (a parallel worker): runs one
# instrumented test and writes "test<TAB>status<TAB>probe ids" to
# <dir>/hits/<index>, and to the cache file $KEK_W_CACHE-<test key>.
cover_one() {
	wasm_extra="$KEK_W_EXTRA --env KEK_COVER_OUT=$1/ids/$2"
	set +e
	wasm "$1/module.cwasm" "$3" >"$1/out/$2" 2>&1
	_c=$?
	set -e
	case $_c in
	0) _st=ok ;;
	1) _st=failed ;;
	*) _st=trapped ;;
	esac
	printf '%s\t%s\t%s\n' "$3" "$_st" "$(cat "$1/ids/$2" 2>/dev/null)" >"$1/hits/$2"
	[ -z "${4:-}" ] || cache_put "$KEK_W_CACHE-$4" "$1/hits/$2"
}

cmd_cover() {
	flag_json=false
	flag_lcov=
	flag_run=
	flag_seed=0
	flag_j=$(ncpu)
	tool_flags_parse cover_usage "json lcov= run= seed# j#" "$@"
	[ "$tool_nrest" -eq 1 ] || { cover_usage; exit 2; }
	_file=$tool_path
	[ -e "$_file" ] || die "stat $_file: no such file or directory"
	_stage=$(current_stage)
	_dir=$(mktemp -d "${TMPDIR:-/tmp}/kek-cover-XXXXXX")
	trap 'rm -rf "$_dir"' EXIT
	compiler cover-build "$_file" "$_dir" || exit $?
	select_tests "$_dir" "$flag_run"
	mkdir -p "$_dir/hits" "$_dir/ids" "$_dir/out" "$cache/cover"
	if [ -s "$_dir/selected.txt" ]; then
		# a test's coverage is cached by the compiler, the probe table, the
		# seed and the test's trans hash (everything it can reach)
		KEK_W_CACHE=$cache/cover/$(basename "$_stage")-$(sha <"$_dir/sites.json")-$flag_seed
		KEK_W_EXTRA="--env KEK_TEST=1 --env KEK_TEST_CLOCK=1767225600000 --env KEK_TEST_SEED=$flag_seed --env KEK_TEST_CASES=100"
		export KEK_W_CACHE KEK_W_EXTRA
		: >"$_dir/torun.txt"
		test_jobs "$_dir" | while read -r _i _t _tk; do
			if [ -n "$_tk" ] && [ -f "$KEK_W_CACHE-$_tk" ]; then
				cp "$KEK_W_CACHE-$_tk" "$_dir/hits/$_i"
			else
				echo "$_i $_t $_tk" >>"$_dir/torun.txt"
			fi
		done
		if [ -s "$_dir/torun.txt" ]; then
			precompile "$_dir"
			xargs -L 1 -P "$flag_j" "$root/kek" __cover-one "$_dir" <"$_dir/torun.txt"
		fi
		cat "$_dir"/hits/* >"$_dir/hits.txt"
	else
		: >"$_dir/hits.txt"
	fi
	set -- "$_dir"
	[ "$flag_json" = true ] && set -- -json "$@"
	[ -z "$flag_lcov" ] || set -- -lcov "$flag_lcov" "$@"
	compiler cover-report "$@"
}

mutate_usage() {
	cat >&2 <<'EOF'
Usage of mutate: kek mutate [flags] <file|dir>
  -base string
    	mutate only the definitions that differ from this program (file or directory)
  -diff string
    	mutate only the definitions changed since this git revision
  -j int
    	parallel test processes (default: number of CPUs)
  -json
    	print the report as JSON
  -merge string
    	report the -results files of the shards (comma-separated) instead of running
  -results string
    	also write this run's raw results to a file (for -merge)
  -run string
    	use only tests whose name matches this extended regular expression
  -shard string
    	run only shard i of n (i/n, 0-based; default from TEST_SHARD_INDEX / TEST_TOTAL_SHARDS)
  -timeout string
    	wall-clock limit of one test process: 2s, 500ms (default 60s); a run with a
    	mutant is also limited to 10x the probe hits of its test without mutants
EOF
}

# mutate_batch <dir> <chunk> (a parallel worker): runs the plan
# <dir>/chunk.<chunk> through `module --batch` processes (one process for
# many (mutant, test) runs) and appends their `kek-` lines to
# <dir>/clog.<chunk>. A process that traps, runs out of its probe budget
# (exit status 3) or of wall-clock time stops in the middle of a line: that
# line gets `kek-crash killed|timeout` and the rest of the plan restarts in
# a new process.
mutate_batch() {
	_d=$1
	_c=$2
	_rest=$_d/rest.$_c
	cp "$_d/chunk.$_c" "$_rest"
	: >"$_d/clog.$_c"
	while [ -s "$_rest" ]; do
		wasm_extra="$KEK_W_EXTRA --env KEK_BATCH=$_rest"
		set +e
		wasm "$_d/module.cwasm" --batch >"$_d/o.$_c" 2>"$_d/e.$_c"
		_x=$?
		set -e
		grep '^kek-' "$_d/o.$_c" >>"$_d/clog.$_c" || true
		[ $_x -ne 0 ] || break
		_n=$(grep -c '^kek-start' "$_d/o.$_c" || true)
		if [ "$_n" -eq 0 ]; then
			# nothing started: the module itself cannot run
			echo "kek mutate: the test module failed:" >&2
			cat "$_d/e.$_c" >&2
			exit 1
		fi
		_why=killed
		[ $_x -ne 3 ] || _why=timeout
		if grep -q 'wasm trap: interrupt' "$_d/e.$_c"; then
			# the wall clock limit is per process: give the line that was
			# running a process of its own before calling it a timeout
			sed -n "${_n}p" "$_rest" >"$_rest.one"
			wasm_extra="$KEK_W_EXTRA --env KEK_BATCH=$_rest.one"
			set +e
			wasm "$_d/module.cwasm" --batch >"$_d/o.$_c" 2>"$_d/e.$_c"
			_x=$?
			set -e
			grep '^kek-' "$_d/o.$_c" >>"$_d/clog.$_c" || true
			_why=
			if [ $_x -eq 3 ] || grep -q 'wasm trap: interrupt' "$_d/e.$_c"; then
				_why=timeout
			elif [ $_x -ne 0 ]; then
				_why=killed
			fi
		fi
		[ -z "$_why" ] || echo "kek-crash $_why" >>"$_d/clog.$_c"
		tail -n +$((_n + 1)) "$_rest" >"$_rest.tmp"
		mv "$_rest.tmp" "$_rest"
	done
}

# mutate_run_plan <dir> <plan> <jobs>: splits the plan into <jobs> chunks,
# runs them in parallel (mutate_batch) and prints the combined log.
mutate_run_plan() {
	_d=$1
	rm -f "$_d"/chunk.* "$_d"/clog.*
	awk -v n="$3" -v d="$_d" '{ print > (d "/chunk." ((NR - 1) % n)) }' "$2"
	for _p in "$_d"/chunk.*; do
		mutate_batch "$_d" "${_p##*.}" &
	done
	wait
	cat "$_d"/clog.*
}

# mutate_extract <rev> <path> <outdir>: the program at a git revision.
# Prints the path of the base program.
mutate_extract() {
	if [ -d "$2" ]; then
		(cd "$2" && git archive --format=tar "$1:./") | tar -x -C "$3" ||
			die "kek mutate: -diff: cannot read $2 at $1"
		echo "$3"
	else
		_bn=$(basename "$2")
		(cd "$(dirname "$2")" && git show "$1:./$_bn") >"$3/$_bn" 2>/dev/null ||
			die "kek mutate: -diff: cannot read $2 at $1"
		echo "$3/$_bn"
	fi
}

# timeout_ms <s>: "2s", "500ms" or "2" (seconds) in milliseconds.
timeout_ms() {
	case $1 in
	*ms) _n=${1%ms}; _m=1 ;;
	*s) _n=${1%s}; _m=1000 ;;
	*) _n=$1; _m=1000 ;;
	esac
	printf '%s' "$_n" | grep -Eq '^[0-9]+$' || die "kek mutate: invalid -timeout $1 (use 2s or 500ms)"
	echo $((_n * _m))
}

cmd_mutate() {
	flag_json=false
	flag_run=
	flag_base=
	flag_diff=
	flag_timeout=
	flag_j=$(ncpu)
	flag_shard=
	flag_results=
	flag_merge=
	tool_flags_parse mutate_usage "json run= base= diff= timeout= j# shard= results= merge=" "$@"
	[ "$tool_nrest" -eq 1 ] || { mutate_usage; exit 2; }
	_file=$tool_path
	[ -e "$_file" ] || die "stat $_file: no such file or directory"
	[ -z "$flag_base" ] || [ -z "$flag_diff" ] || die "kek mutate: -base and -diff are exclusive"
	_tmo=
	[ -z "$flag_timeout" ] || _tmo=$(timeout_ms "$flag_timeout")
	_stage=$(current_stage)
	_sk=$(basename "$_stage")
	_dir=$(mktemp -d "${TMPDIR:-/tmp}/kek-mutate-XXXXXX")
	trap 'rm -rf "$_dir"' EXIT
	_base=$flag_base
	if [ -n "$flag_diff" ]; then
		mkdir "$_dir/base-src"
		_base=$(mutate_extract "$flag_diff" "$_file" "$_dir/base-src")
	fi
	[ -z "$_base" ] || [ -e "$_base" ] || die "stat $_base: no such file or directory"
	# the build (mutant generation, type checks, schema) is cached by the
	# compiler and the contents of the program and of the base
	_bk=$(
		{
			echo "$_sk"
			# the program's path too (the report names its files); the base
			# only by contents (-diff extracts it to a new directory)
			echo "path $_file"
			for _p in "$_file" ${_base:+"$_base"}; do
				echo "=="
				if [ -d "$_p" ]; then
					for _f in "$_p"/*.kek; do
						printf '%s\0' "${_f##*/}"
						cat "$_f"
					done
				else
					cat "$_p"
				fi
			done
		} | sha
	)
	_b=$cache/mutate/build-$_bk
	mkdir -p "$cache/mutate"
	if [ ! -f "$_b/module.cwasm" ]; then
		_tmp=$(mktemp -d "$cache/tmp-XXXXXX")
		set +e
		if [ -n "$_base" ]; then
			compiler mutate-build "$_file" "$_tmp" -base "$_base"
		else
			compiler mutate-build "$_file" "$_tmp"
		fi
		_c=$?
		set -e
		if [ $_c -ne 0 ]; then
			rm -rf "$_tmp"
			exit $_c
		fi
		# the time limit needs epoch interruption compiled in
		# shellcheck disable=SC2086
		"$wasmtime" compile $wasm_flags $gc_user -W epoch-interruption=y "$_tmp/module.wasm" -o "$_tmp/module.cwasm"
		if [ -e "$_b" ]; then
			rm -rf "$_tmp"
		else
			mv "$_tmp" "$_b"
			rm -rf "${_b:?}/$(basename "$_tmp")"
		fi
	fi
	for _f in tests.txt testkeys.txt mutants.txt mutants.json; do
		cp "$_b/$_f" "$_dir/$_f"
	done
	ln -s "$_b/module.cwasm" "$_dir/module.cwasm"
	select_tests "$_dir" "$flag_run"
	mkdir -p "$_dir/base" "$_dir/reach" "$_dir/out" "$_dir/res"
	: >"$_dir/baseline.txt"
	: >"$_dir/results.txt"
	# sharding: this run owns the mutants with index % n == i (-shard i/n,
	# or Bazel's TEST_SHARD_INDEX / TEST_TOTAL_SHARDS)
	_si=0
	_sn=1
	if [ -n "$flag_shard" ]; then
		_si=${flag_shard%%/*}
		_sn=${flag_shard#*/}
	elif [ -n "${TEST_TOTAL_SHARDS:-}" ]; then
		_si=${TEST_SHARD_INDEX:-0}
		_sn=$TEST_TOTAL_SHARDS
		[ -z "${TEST_SHARD_STATUS_FILE:-}" ] || : >"$TEST_SHARD_STATUS_FILE"
	fi
	case "$_si/$_sn" in
	*[!0-9/]* | /* | */) die "kek mutate: invalid -shard $flag_shard (use i/n)" ;;
	esac
	[ "$_sn" -ge 1 ] && [ "$_si" -lt "$_sn" ] || die "kek mutate: invalid shard $_si/$_sn"
	awk -F '\t' -v i="$_si" -v n="$_sn" -v skip="$_dir/skipped.txt" '
		BEGIN { printf "" > skip }
		(NR - 1) % n == i { print; next }
		{ printf "%s\tskipped\t\n", $1 > skip }
	' "$_dir/mutants.txt" >"$_dir/mine.txt"
	if [ -n "$flag_merge" ]; then
		# combine the -results files of the shards: a mutant's result is
		# the one of the shard that ran it
		: >"$_dir/merged.txt"
		_first=
		for _r in $(echo "$flag_merge" | tr ',' ' '); do
			[ -f "$_r" ] || die "kek mutate: -merge: no such file: $_r"
			[ -n "$_first" ] || _first=$_r
			cat "$_r" >>"$_dir/merged.txt"
		done
		awk -F '\t' '$1 == "B" { sub(/^B\t/, ""); print }' "$_first" >"$_dir/baseline.txt"
		awk -F '\t' '$1 == "R" && $3 != "skipped" { sub(/^R\t/, ""); print }' "$_dir/merged.txt" >"$_dir/results.txt"
	elif [ -s "$_dir/selected.txt" ] && [ -s "$_dir/mutants.txt" ]; then
		_wall=${_tmo:-60000}
		KEK_W_EXTRA="--env KEK_TEST=1 --env KEK_TEST_CLOCK=1767225600000 --env KEK_TEST_SEED=0 --env KEK_TEST_CASES=100 -W timeout=${_wall}ms"
		export KEK_W_EXTRA
		# baseline, in one process: each test's status, probe hits (ticks)
		# and the mutant sites it reaches
		awk '{ print "0 " $0 }' "$_dir/selected.txt" >"$_dir/plan0.txt"
		mutate_run_plan "$_dir" "$_dir/plan0.txt" 1 | awk -v base="$_dir/baseline.txt" -v reach="$_dir/reach.txt" '
			BEGIN { printf "" > base; printf "" > reach }
			$1 == "kek-test" { t = $2 }
			$1 == "kek-base" { printf "%s\t%s\t%s\n", $2, $3, $4 > base; if ($3 == "ok") print $2, $5 > reach }
			$1 == "kek-crash" { printf "%s\t%s\t0\n", t, ($2 == "timeout" ? "timeout" : "trapped") > base }
		'
		# plan: for each mutant of this shard, the passing tests that reach
		# it, cheapest first, each with a probe budget of 10x its baseline
		# ticks + 1000 (a deterministic time limit). Pairs already known
		# from the cache (mutant key x test key -> result) are not run.
		_pairs=$cache/mutate/pairs-$_sk.tsv
		[ -f "$_pairs" ] || : >"$_pairs"
		awk -v reach="$_dir/reach.txt" -v base="$_dir/baseline.txt" -v keys="$_dir/testkeys.txt" \
			-v pairs="$_pairs" -v known="$_dir/known.txt" '
			BEGIN {
				while ((getline l < base) > 0) { split(l, a, "\t"); ticks[a[1]] = a[3] + 0 }
				while ((getline l < keys) > 0) { split(l, a, "\t"); tk[a[1]] = a[2] }
				while ((getline l < pairs) > 0) { split(l, a, "\t"); pr[a[1] " " a[2]] = a[3] }
				# tests reaching each site, cheapest first (insertion sort)
				while ((getline l < reach) > 0) {
					split(l, a, " ")
					n = split(a[2], ids, ",")
					for (k = 1; k <= n; k++) {
						s = ids[k]
						c = ++cnt[s]
						tt[s, c] = a[1]
						for (j = c; j > 1 && ticks[tt[s, j - 1]] > ticks[tt[s, j]]; j--) {
							x = tt[s, j]; tt[s, j] = tt[s, j - 1]; tt[s, j - 1] = x
						}
					}
				}
				printf "" > known
			}
			{
				split($0, m, "\t")
				id = m[1]; mk = m[2]
				if (!(id in cnt)) { printf "%s\tnocov\t\n", id > known; next }
				line = ""; res = ""
				for (j = 1; j <= cnt[id]; j++) {
					t = tt[id, j]
					r = pr[mk " " tk[t]]
					if (r == "survived") continue
					if (r != "") { res = r; by = t; break }
					line = line " " t ":" (10 * ticks[t] + 1000)
				}
				if (res != "") printf "%s\t%s\t%s\n", id, res, by > known
				else if (line == "") printf "%s\tsurvived\t\n", id > known
				else print id line
			}
		' "$_dir/mine.txt" >"$_dir/plan.txt"
		cp "$_dir/known.txt" "$_dir/results.txt"
		if [ -s "$_dir/plan.txt" ]; then
			mutate_run_plan "$_dir" "$_dir/plan.txt" "$flag_j" >"$_dir/log.txt"
			# results, and the (mutant, test) pairs for the cache: the tests
			# before the one that killed a mutant let it survive
			awk -v mk="$_dir/mutants.txt" -v keys="$_dir/testkeys.txt" -v res="$_dir/results.txt" \
				-v pairs="$_dir/newpairs.txt" '
				BEGIN {
					while ((getline l < mk) > 0) { split(l, a, "\t"); key[a[1]] = a[2] }
					while ((getline l < keys) > 0) { split(l, a, "\t"); tk[a[1]] = a[2] }
					printf "" > pairs
				}
				function pair(t, r) { if (tk[t] != "") printf "%s\t%s\t%s\n", key[m], tk[t], r > pairs }
				$1 == "kek-start" { m = $2; t = ""; n = 0 }
				$1 == "kek-test" { if (t != "") pair(t, "survived"); t = $2 }
				$1 == "kek-result" {
					if ($3 == "survived") { if (t != "") pair(t, "survived"); printf "%s\tsurvived\t\n", m >> res }
					else { pair(t, "killed"); printf "%s\tkilled\t%s\n", m, t >> res }
					t = ""
				}
				$1 == "kek-crash" { pair(t, $2); printf "%s\t%s\t%s\n", m, $2, t >> res; t = "" }
			' "$_dir/log.txt"
			# appends of short lines are atomic: concurrent runs may share it
			cat "$_dir/newpairs.txt" >>"$_pairs"
		fi
		cat "$_dir/skipped.txt" >>"$_dir/results.txt"
	elif [ -s "$_dir/selected.txt" ]; then
		awk '{ printf "%s\tok\t0\n", $0 }' "$_dir/selected.txt" >"$_dir/baseline.txt"
	fi
	if [ -n "$flag_results" ]; then
		{
			awk '{ print "B\t" $0 }' "$_dir/baseline.txt"
			awk '{ print "R\t" $0 }' "$_dir/results.txt"
		} >"$flag_results"
	fi
	set -- "$_dir"
	[ "$flag_json" = true ] && set -- -json "$@"
	compiler mutate-report "$@"
}

cmd=${1:-help}
[ $# -gt 0 ] && shift
case $cmd in
bootstrap-check)
	bootstrap_check
	;;
bootstrap-update)
	bootstrap_check update
	cp "$_new" "$root/bootstrap/kek.wasm"
	echo "bootstrap/ updated"
	;;
build) cmd_build "$@" ;;
daemon) cmd_daemon "$@" ;;
run) cmd_run "$@" ;;
test) cmd_test "$@" ;;
affected) cmd_affected "$@" ;;
cover) cmd_cover "$@" ;;
mutate) cmd_mutate "$@" ;;
__cover-one) cover_one "$@" ;;
assure)
	# the compiler has no clock: pass today's date (KEK_TODAY overrides it)
	if [ $# -gt 0 ]; then
		_sub=$1
		shift
		compiler assure "$_sub" -today="${KEK_TODAY:-$(date +%Y-%m-%d)}" "$@"
	else
		compiler assure
	fi
	;;
similar) cmd_similar "$@" ;;
complexity) cmd_complexity "$@" ;;
lsp)
	# the language server reads its standard input for as long as the
	# editor runs: never through the daemon (compiler/lsp.kek)
	stage_dir
	wasm "$(stage_module "$_stage_memo")" lsp "$root"
	;;
help | -h | --help) usage ;;
*) compiler "$cmd" "$@" ;;
esac
