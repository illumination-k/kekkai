// Iterators, as in Rust's core::iter: the Iterator trait with its adapters
// and consumers, ranges, and the iterators of Vec.
//
// Closures are pure values here: an adapter keeps its closure in a field
// of type `fn(A) -> B`.

trait Iterator {
    type Item;

    fn next(&mut self) -> Option<Self::Item>;

    // ---- consumers ----

    fn count(mut self) -> Int {
        let mut n = 0;
        while let Some(_) = self.next() {
            n = n + 1;
        }
        n
    }

    fn last(mut self) -> Option<Self::Item> {
        let mut last = None;
        while let Some(x) = self.next() {
            last = Some(x);
        }
        last
    }

    fn nth(&mut self, n: Int) -> Option<Self::Item> {
        let mut i = 0;
        while i < n {
            if self.next().is_none() {
                return None;
            }
            i = i + 1;
        }
        self.next()
    }

    fn fold<B>(mut self, init: B, f: impl Fn(B, Self::Item) -> B) -> B {
        let mut acc = init;
        while let Some(x) = self.next() {
            acc = f(acc, x);
        }
        acc
    }

    fn for_each(mut self, f: impl Fn(Self::Item)) {
        while let Some(x) = self.next() {
            f(x);
        }
    }

    fn any(&mut self, p: impl Fn(Self::Item) -> Bool) -> Bool {
        while let Some(x) = self.next() {
            if p(x) {
                return true;
            }
        }
        false
    }

    fn all(&mut self, p: impl Fn(Self::Item) -> Bool) -> Bool {
        while let Some(x) = self.next() {
            if !p(x) {
                return false;
            }
        }
        true
    }

    fn find(&mut self, p: impl Fn(Self::Item) -> Bool) -> Option<Self::Item> {
        while let Some(x) = self.next() {
            if p(x) {
                return Some(x);
            }
        }
        None
    }

    fn find_map<B>(&mut self, f: impl Fn(Self::Item) -> Option<B>) -> Option<B> {
        while let Some(x) = self.next() {
            match f(x) {
                Some(y) => {
                    return Some(y);
                }
                None => {}
            }
        }
        None
    }

    fn position(&mut self, p: impl Fn(Self::Item) -> Bool) -> Option<Int> {
        let mut i = 0;
        while let Some(x) = self.next() {
            if p(x) {
                return Some(i);
            }
            i = i + 1;
        }
        None
    }

    #[fresh]
    fn collect<B: FromIterator<Self::Item>>(self) -> B {
        B::from_iter(self)
    }

    fn sum<S: Sum<Self::Item>>(self) -> S {
        S::sum(self)
    }

    fn product<P: Product<Self::Item>>(self) -> P {
        P::product(self)
    }

    fn max(mut self) -> Option<Self::Item>
    where
        Self::Item: Ord,
    {
        let mut best = None;
        while let Some(x) = self.next() {
            best = match best {
                Some(b) => if x >= b { Some(x) } else { Some(b) },
                None => Some(x),
            };
        }
        best
    }

    fn min(mut self) -> Option<Self::Item>
    where
        Self::Item: Ord,
    {
        let mut best = None;
        while let Some(x) = self.next() {
            best = match best {
                Some(b) => if x < b { Some(x) } else { Some(b) },
                None => Some(x),
            };
        }
        best
    }

    fn max_by_key<B: Ord>(mut self, f: impl Fn(Self::Item) -> B) -> Option<Self::Item> {
        let mut best = None;
        let mut best_k = None;
        while let Some(x) = self.next() {
            let k = f(x);
            let better = match best_k {
                Some(bk) => k >= bk,
                None => true,
            };
            if better {
                best = Some(x);
                best_k = Some(k);
            }
        }
        best
    }

    fn min_by_key<B: Ord>(mut self, f: impl Fn(Self::Item) -> B) -> Option<Self::Item> {
        let mut best = None;
        let mut best_k = None;
        while let Some(x) = self.next() {
            let k = f(x);
            let better = match best_k {
                Some(bk) => k < bk,
                None => true,
            };
            if better {
                best = Some(x);
                best_k = Some(k);
            }
        }
        best
    }

    // max_by and min_by compare with a function; max_by returns the last of
    // equal maxima and min_by the first of equal minima (as Rust's).
    fn max_by(mut self, f: impl Fn(Self::Item, Self::Item) -> Ordering) -> Option<Self::Item> {
        let mut best = None;
        while let Some(x) = self.next() {
            best = match best {
                Some(b) => match f(x, b) {
                    Ordering::Less => Some(b),
                    _ => Some(x),
                },
                None => Some(x),
            };
        }
        best
    }

    fn min_by(mut self, f: impl Fn(Self::Item, Self::Item) -> Ordering) -> Option<Self::Item> {
        let mut best = None;
        while let Some(x) = self.next() {
            best = match best {
                Some(b) => match f(x, b) {
                    Ordering::Less => Some(x),
                    _ => Some(b),
                },
                None => Some(x),
            };
        }
        best
    }

    // reduce folds with the first element as the initial value (None when
    // empty).
    fn reduce(mut self, f: impl Fn(Self::Item, Self::Item) -> Self::Item) -> Option<Self::Item> {
        match self.next() {
            Some(first) => {
                let mut acc = first;
                while let Some(x) = self.next() {
                    acc = f(acc, x);
                }
                Some(acc)
            }
            None => None,
        }
    }

    // try_fold folds while f returns Some / Ok, stopping at the first None /
    // Err (which it returns).
    fn try_fold<B, R: __Try<Output = B>>(&mut self, init: B, f: impl Fn(B, Self::Item) -> R) -> R {
        let mut acc = init;
        while let Some(x) = self.next() {
            let r = f(acc, x);
            match r.__output() {
                Some(b) => {
                    acc = b;
                }
                None => {
                    return r;
                }
            }
        }
        R::__from_output(acc)
    }

    // try_for_each calls f until it returns None / Err.
    fn try_for_each<R: __Try<Output = ()>>(&mut self, f: impl Fn(Self::Item) -> R) -> R {
        while let Some(x) = self.next() {
            let r = f(x);
            if r.__output().is_none() {
                return r;
            }
        }
        R::__from_output(())
    }

    // partition splits the elements into those satisfying p and the rest.
    #[fresh]
    fn partition(mut self, p: impl Fn(Self::Item) -> Bool) -> (Vec<Self::Item>, Vec<Self::Item>) {
        let mut yes = Vec::new();
        let mut no = Vec::new();
        while let Some(x) = self.next() {
            if p(x) {
                yes.push(x);
            } else {
                no.push(x);
            }
        }
        (yes, no)
    }

    #[fresh]
    fn unzip<A, B>(mut self) -> (Vec<A>, Vec<B>)
    where
        Self::Item: __Pair<First = A, Second = B>,
    {
        let mut va = Vec::new();
        let mut vb = Vec::new();
        while let Some(p) = self.next() {
            let (a, b) = p.__split();
            va.push(a);
            vb.push(b);
        }
        (va, vb)
    }

    fn is_sorted(mut self) -> Bool
    where
        Self::Item: Ord,
    {
        self.is_sorted_by(|a, b| a <= b)
    }

    // is_sorted_by checks f(a, b) for every adjacent pair.
    fn is_sorted_by(mut self, f: impl Fn(Self::Item, Self::Item) -> Bool) -> Bool {
        match self.next() {
            Some(first) => {
                let mut prev = first;
                while let Some(x) = self.next() {
                    if !f(prev, x) {
                        return false;
                    }
                    prev = x;
                }
                true
            }
            None => true,
        }
    }

    fn is_sorted_by_key<K: Ord>(mut self, f: impl Fn(Self::Item) -> K) -> Bool {
        self.map(f).is_sorted()
    }

    // cmp compares two iterators lexicographically.
    fn cmp<J: Iterator<Item = Self::Item>>(mut self, mut other: J) -> Ordering
    where
        Self::Item: Ord,
    {
        loop {
            match self.next() {
                Some(x) => match other.next() {
                    Some(y) => match x.cmp(&y) {
                        Ordering::Equal => {}
                        o => {
                            return o;
                        }
                    },
                    None => {
                        return Ordering::Greater;
                    }
                },
                None => {
                    if other.next().is_none() {
                        return Ordering::Equal;
                    }
                    return Ordering::Less;
                }
            }
        }
    }

    fn eq<J: Iterator<Item = Self::Item>>(mut self, mut other: J) -> Bool
    where
        Self::Item: PartialEq,
    {
        loop {
            match self.next() {
                Some(x) => match other.next() {
                    Some(y) => {
                        if x != y {
                            return false;
                        }
                    }
                    None => {
                        return false;
                    }
                },
                None => {
                    return other.next().is_none();
                }
            }
        }
    }

    fn ne<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool
    where
        Self::Item: PartialEq,
    {
        !self.eq(other)
    }

    fn lt<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool
    where
        Self::Item: Ord,
    {
        self.cmp(other) == Ordering::Less
    }

    fn le<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool
    where
        Self::Item: Ord,
    {
        self.cmp(other) != Ordering::Greater
    }

    fn gt<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool
    where
        Self::Item: Ord,
    {
        self.cmp(other) == Ordering::Greater
    }

    fn ge<J: Iterator<Item = Self::Item>>(self, other: J) -> Bool
    where
        Self::Item: Ord,
    {
        self.cmp(other) != Ordering::Less
    }

    // ---- adapters ----

    #[fresh]
    fn map<B>(self, f: impl Fn(Self::Item) -> B) -> Map<Self, Self::Item, B> {
        Map { iter: self, f: f }
    }

    #[fresh]
    fn filter(self, p: impl Fn(Self::Item) -> Bool) -> Filter<Self, Self::Item> {
        Filter { iter: self, p: p }
    }

    #[fresh]
    fn filter_map<B>(self, f: impl Fn(Self::Item) -> Option<B>) -> FilterMap<Self, Self::Item, B> {
        FilterMap { iter: self, f: f }
    }

    #[fresh]
    fn enumerate(self) -> Enumerate<Self> {
        Enumerate { iter: self, i: 0 }
    }

    #[fresh]
    fn zip<U: Iterator>(self, other: U) -> Zip<Self, U> {
        Zip { a: self, b: other }
    }

    #[fresh]
    fn chain<U: Iterator<Item = Self::Item>>(self, other: U) -> Chain<Self, U> {
        Chain { a: self, b: other, first: true }
    }

    #[fresh]
    fn take(self, n: Int) -> Take<Self> {
        Take { iter: self, n: n }
    }

    #[fresh]
    fn skip(self, n: Int) -> Skip<Self> {
        Skip { iter: self, n: n }
    }

    #[fresh]
    fn take_while(self, p: impl Fn(Self::Item) -> Bool) -> TakeWhile<Self, Self::Item> {
        TakeWhile { iter: self, p: p, done: false }
    }

    #[fresh]
    fn skip_while(self, p: impl Fn(Self::Item) -> Bool) -> SkipWhile<Self, Self::Item> {
        SkipWhile { iter: self, p: p, started: false }
    }

    #[fresh]
    fn step_by(self, step: Int) -> StepBy<Self> {
        StepBy { iter: self, step: step, first: true }
    }

    #[fresh]
    fn peekable(self) -> Peekable<Self, Self::Item> {
        Peekable { iter: self, peeked: None, has: false }
    }

    // flat_map maps each element to something iterable (Vec, Option,
    // HashMap, ...) and yields its elements in turn.
    #[fresh]
    fn flat_map<U: IntoIterator>(
        self,
        f: impl Fn(Self::Item) -> U,
    ) -> FlatMap<Self, Self::Item, U, U::IntoIter> {
        FlatMap { iter: self, f: f, cur: None }
    }

    // flatten yields the elements of each element (an iterator of Vec,
    // Option, ...).
    #[fresh]
    fn flatten<J>(self) -> FlatMap<Self, Self::Item, Self::Item, J>
    where
        Self::Item: IntoIterator<IntoIter = J>,
    {
        FlatMap { iter: self, f: |x| x, cur: None }
    }

    // scan threads a state through the elements: f(state, x) returns the
    // next state and the element to yield, or None to stop (Rust's closure
    // takes `&mut St` and returns Option<B>).
    #[fresh]
    fn scan<St, B>(
        self,
        init: St,
        f: impl Fn(St, Self::Item) -> Option<(St, B)>,
    ) -> Scan<Self, Self::Item, St, B> {
        Scan { iter: self, state: init, f: f, done: false }
    }

    // inspect calls f on each element as it passes.
    #[fresh]
    fn inspect(self, f: impl Fn(Self::Item)) -> Inspect<Self, Self::Item> {
        Inspect { iter: self, f: f }
    }

    // map_while maps while f returns Some, and stops at the first None.
    #[fresh]
    fn map_while<B>(self, f: impl Fn(Self::Item) -> Option<B>) -> MapWhile<Self, Self::Item, B> {
        MapWhile { iter: self, f: f, done: false }
    }

    // fuse stops for good after the first None.
    #[fresh]
    fn fuse(self) -> Fuse<Self> {
        Fuse { iter: self, done: false }
    }

    // cycle repeats the elements forever (nothing if there are none). The
    // elements of the first pass are remembered and replayed; since
    // closures are pure this is the same as restarting a clone.
    #[fresh]
    fn cycle(self) -> Cycle<Self, Self::Item> {
        Cycle { iter: self, buf: Vec::new(), first: true, i: 0 }
    }

    // copied and cloned: copied yields the elements as they are (values are
    // never borrowed in Kekkai); cloned yields clone() of each, so its
    // elements are owned even when the collection is borrowed (#[owned]:
    // the iterator it wraps is reachable only through a `__` field).
    #[fresh]
    fn copied(self) -> Self {
        self
    }

    #[owned]
    fn cloned(self) -> Cloned<Self, Self::Item>
    where
        Self::Item: Clone,
    {
        Cloned { __iter: self, __item: None }
    }
}

// An iterator that can also produce its elements from the back.
trait DoubleEndedIterator: Iterator {
    fn next_back(&mut self) -> Option<Self::Item>;

    #[fresh]
    fn rev(self) -> Rev<Self> {
        Rev { iter: self }
    }
}

// Conversion into an iterator (what a `for` loop iterates over).
trait IntoIterator {
    type Item;
    type IntoIter;

    #[fresh]
    fn into_iter(self) -> Self::IntoIter;
}

// Building a collection from an iterator (`collect`).
trait FromIterator<A> {
    #[fresh]
    fn from_iter<I: Iterator<Item = A>>(iter: I) -> Self;
}

trait Sum<A> {
    fn sum<I: Iterator<Item = A>>(iter: I) -> Self;
}

trait Product<A> {
    fn product<I: Iterator<Item = A>>(iter: I) -> Self;
}

// __Pair is what unzip accepts: a pair (A, B).
trait __Pair {
    type First;
    type Second;

    fn __split(self) -> (Self::First, Self::Second);
}

impl<A, B> __Pair for (A, B) {
    type First = A;
    type Second = B;

    fn __split(self) -> (A, B) {
        self
    }
}

// __Try is what try_fold and try_for_each accept from their closure:
// Option and Result (Rust's unstable Try trait). __output is the value to
// continue with, or None to stop and return the value itself.
trait __Try {
    type Output;

    fn __output(&self) -> Option<Self::Output>;

    fn __from_output(x: Self::Output) -> Self;
}

impl<T> __Try for Option<T> {
    type Output = T;

    fn __output(&self) -> Option<T> {
        *self
    }

    fn __from_output(x: T) -> Option<T> {
        Some(x)
    }
}

impl<T, E> __Try for Result<T, E> {
    type Output = T;

    fn __output(&self) -> Option<T> {
        match *self {
            Ok(x) => Some(x),
            Err(_) => None,
        }
    }

    fn __from_output(x: T) -> Result<T, E> {
        Ok(x)
    }
}

// ---- adapters ----

struct Map<I, A, B> {
    iter: I,
    f: fn(A) -> B,
}

impl<I: Iterator<Item = A>, A, B> Iterator for Map<I, A, B> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        match self.iter.next() {
            Some(x) => Some((self.f)(x)),
            None => None,
        }
    }
}

struct Filter<I, A> {
    iter: I,
    p: fn(A) -> Bool,
}

impl<I: Iterator<Item = A>, A> Iterator for Filter<I, A> {
    type Item = A;

    fn next(&mut self) -> Option<A> {
        while let Some(x) = self.iter.next() {
            if (self.p)(x) {
                return Some(x);
            }
        }
        None
    }
}

struct FilterMap<I, A, B> {
    iter: I,
    f: fn(A) -> Option<B>,
}

impl<I: Iterator<Item = A>, A, B> Iterator for FilterMap<I, A, B> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        while let Some(x) = self.iter.next() {
            match (self.f)(x) {
                Some(y) => {
                    return Some(y);
                }
                None => {}
            }
        }
        None
    }
}

struct Enumerate<I> {
    iter: I,
    mut i: Int,
}

impl<I: Iterator> Iterator for Enumerate<I> {
    type Item = (Int, I::Item);

    fn next(&mut self) -> Option<(Int, I::Item)> {
        match self.iter.next() {
            Some(x) => {
                let i = self.i;
                self.i = i + 1;
                Some((i, x))
            }
            None => None,
        }
    }
}

struct Zip<A, B> {
    a: A,
    b: B,
}

impl<A: Iterator, B: Iterator> Iterator for Zip<A, B> {
    type Item = (A::Item, B::Item);

    fn next(&mut self) -> Option<(A::Item, B::Item)> {
        match self.a.next() {
            Some(x) => match self.b.next() {
                Some(y) => Some((x, y)),
                None => None,
            },
            None => None,
        }
    }
}

struct Chain<A, B> {
    a: A,
    b: B,
    mut first: Bool,
}

impl<A: Iterator, B: Iterator<Item = A::Item>> Iterator for Chain<A, B> {
    type Item = A::Item;

    fn next(&mut self) -> Option<A::Item> {
        if self.first {
            match self.a.next() {
                Some(x) => {
                    return Some(x);
                }
                None => {
                    self.first = false;
                }
            }
        }
        self.b.next()
    }
}

struct Take<I> {
    iter: I,
    mut n: Int,
}

impl<I: Iterator> Iterator for Take<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        if self.n <= 0 {
            return None;
        }
        self.n = self.n - 1;
        self.iter.next()
    }
}

struct Skip<I> {
    iter: I,
    mut n: Int,
}

impl<I: Iterator> Iterator for Skip<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        while self.n > 0 {
            self.n = self.n - 1;
            if self.iter.next().is_none() {
                return None;
            }
        }
        self.iter.next()
    }
}

struct TakeWhile<I, A> {
    iter: I,
    p: fn(A) -> Bool,
    mut done: Bool,
}

impl<I: Iterator<Item = A>, A> Iterator for TakeWhile<I, A> {
    type Item = A;

    fn next(&mut self) -> Option<A> {
        if self.done {
            return None;
        }
        match self.iter.next() {
            Some(x) => {
                if (self.p)(x) {
                    return Some(x);
                }
                self.done = true;
                None
            }
            None => None,
        }
    }
}

struct SkipWhile<I, A> {
    iter: I,
    p: fn(A) -> Bool,
    mut started: Bool,
}

impl<I: Iterator<Item = A>, A> Iterator for SkipWhile<I, A> {
    type Item = A;

    fn next(&mut self) -> Option<A> {
        if self.started {
            return self.iter.next();
        }
        while let Some(x) = self.iter.next() {
            if !(self.p)(x) {
                self.started = true;
                return Some(x);
            }
        }
        None
    }
}

struct StepBy<I> {
    iter: I,
    step: Int,
    mut first: Bool,
}

impl<I: Iterator> Iterator for StepBy<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        if self.first {
            self.first = false;
            return self.iter.next();
        }
        self.iter.nth(self.step - 1)
    }
}

struct Peekable<I, A> {
    iter: I,
    mut peeked: Option<A>,
    mut has: Bool,
}

impl<I: Iterator<Item = A>, A> Peekable<I, A> {
    // peek returns the next element without consuming it.
    fn peek(&mut self) -> Option<A> {
        if !self.has {
            self.peeked = self.iter.next();
            self.has = true;
        }
        self.peeked
    }
}

impl<I: Iterator<Item = A>, A> Iterator for Peekable<I, A> {
    type Item = A;

    fn next(&mut self) -> Option<A> {
        if self.has {
            self.has = false;
            return self.peeked;
        }
        self.iter.next()
    }
}

struct FlatMap<I, A, U, J> {
    iter: I,
    f: fn(A) -> U,
    mut cur: Option<J>,
}

impl<I: Iterator<Item = A>, A, U: IntoIterator<IntoIter = J>, J: Iterator> Iterator for FlatMap<I, A, U, J> {
    type Item = J::Item;

    fn next(&mut self) -> Option<J::Item> {
        loop {
            match self.cur {
                Some(mut inner) => match inner.next() {
                    Some(x) => {
                        return Some(x);
                    }
                    None => {
                        self.cur = None;
                    }
                },
                None => {}
            }
            match self.iter.next() {
                Some(x) => {
                    self.cur = Some((self.f)(x).into_iter());
                }
                None => {
                    return None;
                }
            }
        }
    }
}

struct Scan<I, A, St, B> {
    iter: I,
    mut state: St,
    f: fn(St, A) -> Option<(St, B)>,
    mut done: Bool,
}

impl<I: Iterator<Item = A>, A, St, B> Iterator for Scan<I, A, St, B> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        if self.done {
            return None;
        }
        match self.iter.next() {
            Some(x) => match (self.f)(self.state, x) {
                Some((st, y)) => {
                    self.state = st;
                    Some(y)
                }
                None => {
                    self.done = true;
                    None
                }
            },
            None => None,
        }
    }
}

struct Inspect<I, A> {
    iter: I,
    f: fn(A),
}

impl<I: Iterator<Item = A>, A> Iterator for Inspect<I, A> {
    type Item = A;

    fn next(&mut self) -> Option<A> {
        match self.iter.next() {
            Some(x) => {
                (self.f)(x);
                Some(x)
            }
            None => None,
        }
    }
}

struct MapWhile<I, A, B> {
    iter: I,
    f: fn(A) -> Option<B>,
    mut done: Bool,
}

impl<I: Iterator<Item = A>, A, B> Iterator for MapWhile<I, A, B> {
    type Item = B;

    fn next(&mut self) -> Option<B> {
        if self.done {
            return None;
        }
        match self.iter.next() {
            Some(x) => {
                let y = (self.f)(x);
                if y.is_none() {
                    self.done = true;
                }
                y
            }
            None => None,
        }
    }
}

struct Fuse<I> {
    iter: I,
    mut done: Bool,
}

impl<I: Iterator> Iterator for Fuse<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        if self.done {
            return None;
        }
        let x = self.iter.next();
        if x.is_none() {
            self.done = true;
        }
        x
    }
}

struct Cycle<I, A> {
    iter: I,
    mut buf: Vec<A>,
    mut first: Bool,
    mut i: Int,
}

impl<I: Iterator<Item = A>, A> Iterator for Cycle<I, A> {
    type Item = A;

    fn next(&mut self) -> Option<A> {
        if self.first {
            match self.iter.next() {
                Some(x) => {
                    self.buf.push(x);
                    return Some(x);
                }
                None => {
                    self.first = false;
                }
            }
        }
        let n = self.buf.len();
        if n == 0 {
            return None;
        }
        if self.i >= n {
            self.i = 0;
        }
        let x = self.buf.get(self.i);
        self.i = self.i + 1;
        x
    }
}

struct Cloned<I, A> {
    __iter: I,
    __item: Option<A>,
}

impl<I: Iterator<Item = A>, A: Clone> Iterator for Cloned<I, A> {
    type Item = A;

    fn next(&mut self) -> Option<A> {
        match self.__iter.next() {
            Some(x) => Some(x.clone()),
            None => None,
        }
    }
}

struct Rev<I> {
    iter: I,
}

impl<I: DoubleEndedIterator> Iterator for Rev<I> {
    type Item = I::Item;

    fn next(&mut self) -> Option<I::Item> {
        self.iter.next_back()
    }
}

// ---- ranges ----

// `start..end`: the integers from start up to (excluding) end.
struct Range {
    mut start: Int,
    mut end: Int,
}

impl Range {
    fn contains(&self, x: Int) -> Bool {
        self.start <= x && x < self.end
    }

    fn len(&self) -> Int {
        if self.end > self.start {
            self.end - self.start
        } else {
            0
        }
    }

    fn is_empty(&self) -> Bool {
        self.start >= self.end
    }
}

impl Iterator for Range {
    type Item = Int;

    fn next(&mut self) -> Option<Int> {
        if self.start < self.end {
            let x = self.start;
            self.start = x + 1;
            Some(x)
        } else {
            None
        }
    }
}

impl DoubleEndedIterator for Range {
    fn next_back(&mut self) -> Option<Int> {
        if self.start < self.end {
            self.end = self.end - 1;
            Some(self.end)
        } else {
            None
        }
    }
}

// `start..=end`: the integers from start up to (including) end.
struct RangeInclusive {
    mut start: Int,
    mut end: Int,
}

impl RangeInclusive {
    fn contains(&self, x: Int) -> Bool {
        self.start <= x && x <= self.end
    }
}

impl Iterator for RangeInclusive {
    type Item = Int;

    fn next(&mut self) -> Option<Int> {
        if self.start <= self.end {
            let x = self.start;
            if x == self.end {
                // stop without overflowing at the largest Int
                self.end = x - 1;
                self.start = x;
            } else {
                self.start = x + 1;
            }
            Some(x)
        } else {
            None
        }
    }
}

impl DoubleEndedIterator for RangeInclusive {
    fn next_back(&mut self) -> Option<Int> {
        if self.start <= self.end {
            let x = self.end;
            if x == self.start {
                self.start = x + 1;
                self.end = x;
            } else {
                self.end = x - 1;
            }
            Some(x)
        } else {
            None
        }
    }
}

// ---- Vec ----

// Iter iterates over a Vec by index. Like a `for` loop over a Vec, it sees
// elements pushed while iterating.
struct Iter<T> {
    v: Vec<T>,
    mut i: Int,
    mut end: Int,
}

impl<T> Vec<T> {
    #[fresh]
    fn iter(&self) -> Iter<T> {
        Iter { v: *self, i: 0, end: -1 }
    }

    // `v[i] = x` is `v.__index_set(i, x)`: the bounds are proved as for
    // reading `v[i]` (and checked at run time: out of bounds traps).
    fn __index_set(&mut self, i: Int, x: T)
    where
        0 <= i,
        i < self.len(),
    {
        if !self.set(i, x) {
            let _ = self[i];
        }
    }
}

impl<T> Iterator for Iter<T> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        let n = if self.end < 0 { self.v.len() } else { self.end };
        if self.i < n {
            let x = self.v.get(self.i);
            self.i = self.i + 1;
            x
        } else {
            None
        }
    }
}

impl<T> DoubleEndedIterator for Iter<T> {
    fn next_back(&mut self) -> Option<T> {
        if self.end < 0 {
            self.end = self.v.len();
        }
        if self.i < self.end {
            self.end = self.end - 1;
            self.v.get(self.end)
        } else {
            None
        }
    }
}

impl<T> IntoIterator for Vec<T> {
    type Item = T;
    type IntoIter = Iter<T>;

    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

impl<T> FromIterator<T> for Vec<T> {
    fn from_iter<I: Iterator<Item = T>>(mut iter: I) -> Vec<T> {
        let mut v = Vec::new();
        while let Some(x) = iter.next() {
            v.push(x);
        }
        v
    }
}

impl FromIterator<String> for String {
    fn from_iter<I: Iterator<Item = String>>(mut iter: I) -> String {
        let mut parts = Vec::new();
        while let Some(s) = iter.next() {
            parts.push(s);
        }
        parts.join("")
    }
}

impl Sum<Int> for Int {
    fn sum<I: Iterator<Item = Int>>(mut iter: I) -> Int {
        let mut s = 0;
        while let Some(x) = iter.next() {
            s = s + x;
        }
        s
    }
}

impl Product<Int> for Int {
    fn product<I: Iterator<Item = Int>>(mut iter: I) -> Int {
        let mut p = 1;
        while let Some(x) = iter.next() {
            p = p * x;
        }
        p
    }
}

// collect of code points (`Int`, what `chars()` yields) into a String.
// Code points above U+FFFF become surrogate pairs; what is not a Unicode
// scalar value (negative, a surrogate, above U+10FFFF) becomes U+FFFD.
impl FromIterator<Int> for String {
    fn from_iter<I: Iterator<Item = Int>>(mut iter: I) -> String {
        let mut parts = Vec::new();
        while let Some(c) = iter.next() {
            if c < 0 || c > 0x10FFFF || (c >= 0xD800 && c <= 0xDFFF) {
                parts.push(String::from_char(0xFFFD));
            } else if c >= 0x10000 {
                let u = c - 0x10000;
                parts.push(String::from_char(0xD800 + (u >> 10)));
                parts.push(String::from_char(0xDC00 + (u & 0x3FF)));
            } else {
                parts.push(String::from_char(c));
            }
        }
        parts.join("")
    }
}

// collect into Option<C>: None at the first None, else Some of the
// collection of the values.
impl<A, C: FromIterator<A>> FromIterator<Option<A>> for Option<C> {
    fn from_iter<I: Iterator<Item = Option<A>>>(mut iter: I) -> Option<C> {
        let mut v = Vec::new();
        while let Some(x) = iter.next() {
            match x {
                Some(a) => v.push(a),
                None => {
                    return None;
                }
            }
        }
        Some(C::from_iter(v.iter()))
    }
}

// collect into Result<C, E>: the first Err, else Ok of the collection.
impl<A, E, C: FromIterator<A>> FromIterator<Result<A, E>> for Result<C, E> {
    fn from_iter<I: Iterator<Item = Result<A, E>>>(mut iter: I) -> Result<C, E> {
        let mut v = Vec::new();
        while let Some(x) = iter.next() {
            match x {
                Ok(a) => v.push(a),
                Err(e) => {
                    return Err(e);
                }
            }
        }
        Ok(C::from_iter(v.iter()))
    }
}

impl<A, S: Sum<A>> Sum<Option<A>> for Option<S> {
    fn sum<I: Iterator<Item = Option<A>>>(iter: I) -> Option<S> {
        let o: Option<Vec<A>> = iter.collect();
        match o {
            Some(v) => Some(S::sum(v.iter())),
            None => None,
        }
    }
}

impl<A, E, S: Sum<A>> Sum<Result<A, E>> for Result<S, E> {
    fn sum<I: Iterator<Item = Result<A, E>>>(iter: I) -> Result<S, E> {
        let r: Result<Vec<A>, E> = iter.collect();
        match r {
            Ok(v) => Ok(S::sum(v.iter())),
            Err(e) => Err(e),
        }
    }
}

impl<A, P: Product<A>> Product<Option<A>> for Option<P> {
    fn product<I: Iterator<Item = Option<A>>>(iter: I) -> Option<P> {
        let o: Option<Vec<A>> = iter.collect();
        match o {
            Some(v) => Some(P::product(v.iter())),
            None => None,
        }
    }
}

impl<A, E, P: Product<A>> Product<Result<A, E>> for Result<P, E> {
    fn product<I: Iterator<Item = Result<A, E>>>(iter: I) -> Result<P, E> {
        let r: Result<Vec<A>, E> = iter.collect();
        match r {
            Ok(v) => Ok(P::product(v.iter())),
            Err(e) => Err(e),
        }
    }
}

// Option iterates over its value (if any), so that flatten and flat_map
// accept it.
impl<T> IntoIterator for Option<T> {
    type Item = T;
    type IntoIter = Iter<T>;

    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}

impl<T, E> IntoIterator for Result<T, E> {
    type Item = T;
    type IntoIter = Iter<T>;

    fn into_iter(self) -> Iter<T> {
        self.iter()
    }
}
