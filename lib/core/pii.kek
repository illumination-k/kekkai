// Personal data (the minimal version of docs/refinement.md): a value
// wrapped in Pii<T> cannot be turned into a String by accident.
//
// The field is private to the core library: identifiers starting with
// `__` are reserved for the core library and the runtime prelude, so a
// program can neither read `__value` nor build `Pii { ... }`. Pii implements
// no trait that renders, orders or hashes it, so it cannot reach a log, a
// response or the store through `+`, `to_string`, a capability argument
// or a generic function. The only ways out are the declassifications
// below, which `kek caps` lists and `kek assure` records (pii.declassify):
//
//   p.mask()              Pii<String> -> String, for display
//   p.hash()              a fixed (unseeded) hash as 16 hex digits
//   p.expose_unchecked()  the value itself (the escape hatch)
//
// Two Pii values can be compared with `==` (PartialEq, Eq). There is no
// Ord (an order would let a value be found by binary search with
// Pii::new(guess)) and no Hash (a hash is a declassification, done with
// p.hash(); without Ord a Pii cannot be a HashMap key anyway: key a map
// by p.hash() instead).

struct Pii<T> {
    __value: T,
}

impl<T> Pii<T> {
    fn new(x: T) -> Pii<T> {
        Pii { __value: x }
    }

    // expose_unchecked returns the value: a declassification.
    fn expose_unchecked(&self) -> T {
        self.__value
    }
}

impl<T: Hash> Pii<T> {
    // hash is the default hasher's (fixed, unseeded) hash of the value, as
    // 16 lowercase hex digits: a declassification that keeps equality (to
    // join or count records) but not the value.
    fn hash(&self) -> String {
        let h = DefaultHasher::new();
        self.__value.hash(&mut h);
        __pii_hex(h.finish())
    }
}

impl Pii<String> {
    // mask keeps the first character and everything from the last `@` on
    // (the domain of an e-mail address) and replaces every other
    // character (code point) by `*`: "alice@example.com" ->
    // "a****@example.com", "bob" -> "b**". When the part before the `@` is
    // a single character it is masked too ("a@x.com" -> "*@x.com", "x" ->
    // "*"), and "" stays "".
    fn mask(&self) -> String {
        let s = self.__value;
        if s.len() == 0 {
            return "";
        }
        let cs = s.split("");
        let n = cs.len();
        let mut at = n;
        let mut i = 0;
        while i < n {
            if cs.get(i).unwrap_or("") == "@" {
                at = i;
            }
            i = i + 1;
        }
        let parts = Vec::new();
        for j in 0..at {
            if j == 0 && at > 1 {
                parts.push(cs.get(0).unwrap_or(""));
            } else {
                parts.push("*");
            }
        }
        for j in at..n {
            parts.push(cs.get(j).unwrap_or(""));
        }
        parts.join("")
    }
}

impl<T: PartialEq> PartialEq for Pii<T> {
    fn eq(&self, other: &Self) -> Bool {
        self.__value == other.__value
    }
}

impl<T: Eq> Eq for Pii<T> {}

// __pii_hex renders x as 16 lowercase hex digits (two's complement).
fn __pii_hex(x: Int) -> String {
    let digits = "0123456789abcdef";
    let parts = Vec::new();
    let mut i = 15;
    while i >= 0 {
        let d = x.ushr(i * 4).bit_and(15);
        parts.push(digits.slice(d, d + 1));
        i = i - 1;
    }
    parts.join("")
}
