// VecDeque, with Rust's API (std::collections): a double-ended queue in a
// ring buffer. push and pop at both ends are amortized O(1), get(i) is
// O(1). Like Vec, nothing panics: an index out of range gives None or does
// nothing.

struct VecDeque<T> {
    // slots of the ring (None: free); its length is the capacity
    mut __buf: Vec<Option<T>>,
    // the slot of the front element
    mut __head: Int,
    mut __len: Int,
}

impl<T> VecDeque<T> {
    fn new() -> VecDeque<T> {
        VecDeque { __buf: Vec::new(), __head: 0, __len: 0 }
    }

    fn with_capacity(n: Int) -> VecDeque<T> {
        let mut d = VecDeque::new();
        d.__grow_to(n);
        d
    }

    fn len(&self) -> Int {
        self.__len
    }

    fn is_empty(&self) -> Bool {
        self.__len == 0
    }

    fn capacity(&self) -> Int {
        self.__buf.len()
    }

    // __slot is the buffer slot of element i (0 <= i < capacity).
    fn __slot(&self, i: Int) -> Int {
        let cap = self.__buf.len();
        let j = self.__head + i;
        if j >= cap { j - cap } else { j }
    }

    // __grow_to makes room for n elements, moving them to the start.
    fn __grow_to(&mut self, n: Int) {
        let cap = self.__buf.len();
        if n <= cap {
            return;
        }
        let mut ncap = if cap < 4 { 4 } else { cap };
        while ncap < n {
            ncap = ncap * 2;
        }
        let mut nb = Vec::new();
        for i in 0..self.__len {
            nb.push(self.__buf.get(self.__slot(i)).unwrap_or(None));
        }
        while nb.len() < ncap {
            nb.push(None);
        }
        self.__buf = nb;
        self.__head = 0;
    }

    fn push_back(&mut self, x: T) {
        self.__grow_to(self.__len + 1);
        let s = self.__slot(self.__len);
        self.__buf.set(s, Some(x));
        self.__len = self.__len + 1;
    }

    fn push_front(&mut self, x: T) {
        self.__grow_to(self.__len + 1);
        let cap = self.__buf.len();
        self.__head = if self.__head == 0 {
            cap - 1
        } else {
            self.__head - 1
        };
        self.__buf.set(self.__head, Some(x));
        self.__len = self.__len + 1;
    }

    fn pop_front(&mut self) -> Option<T> {
        if self.__len == 0 {
            return None;
        }
        let x = self.__buf.get(self.__head).unwrap_or(None);
        self.__buf.set(self.__head, None);
        self.__head = self.__slot(1);
        self.__len = self.__len - 1;
        if self.__len == 0 {
            self.__head = 0;
        }
        x
    }

    fn pop_back(&mut self) -> Option<T> {
        if self.__len == 0 {
            return None;
        }
        let s = self.__slot(self.__len - 1);
        let x = self.__buf.get(s).unwrap_or(None);
        self.__buf.set(s, None);
        self.__len = self.__len - 1;
        x
    }

    // get returns element i from the front.
    fn get(&self, i: Int) -> Option<T> {
        if i < 0 || i >= self.__len {
            return None;
        }
        self.__buf.get(self.__slot(i)).unwrap_or(None)
    }

    // set replaces element i, reporting whether it exists (Vec::set).
    fn set(&mut self, i: Int, x: T) -> Bool {
        if i < 0 || i >= self.__len {
            return false;
        }
        self.__buf.set(self.__slot(i), Some(x))
    }

    fn front(&self) -> Option<T> {
        self.get(0)
    }

    fn back(&self) -> Option<T> {
        self.get(self.__len - 1)
    }

    fn clear(&mut self) {
        self.__buf = Vec::new();
        self.__head = 0;
        self.__len = 0;
    }

    // swap exchanges elements i and j (nothing if either is out of range).
    fn swap(&mut self, i: Int, j: Int) {
        match self.get(i) {
            Some(a) => match self.get(j) {
                Some(b) => {
                    self.set(i, b);
                    self.set(j, a);
                }
                None => {}
            },
            None => {}
        }
    }

    // truncate keeps the first n elements.
    fn truncate(&mut self, n: Int) {
        while self.__len > n && self.__len > 0 {
            self.pop_back();
        }
    }

    // insert puts x at position i (clamped to [0, len]), shifting the
    // following elements back.
    fn insert(&mut self, i: Int, x: T) {
        let at = if i < 0 {
            0
        } else if i > self.__len { self.__len } else { i };
        self.push_back(x);
        let mut j = self.__len - 1;
        while j > at {
            self.swap(j - 1, j);
            j = j - 1;
        }
    }

    // remove removes and returns element i.
    fn remove(&mut self, i: Int) -> Option<T> {
        if i < 0 || i >= self.__len {
            return None;
        }
        let mut j = i;
        while j + 1 < self.__len {
            self.swap(j, j + 1);
            j = j + 1;
        }
        self.pop_back()
    }

    fn retain(&mut self, f: impl Fn(T) -> Bool) {
        let mut keep = Vec::new();
        while let Some(x) = self.pop_front() {
            if f(x) {
                keep.push(x);
            }
        }
        for x in keep {
            self.push_back(x);
        }
    }

    // rotate_left moves the first k elements to the back (k is taken
    // modulo len).
    fn rotate_left(&mut self, k: Int) {
        if self.__len == 0 {
            return;
        }
        let mut n = k.rem_euclid(self.__len);
        while n > 0 {
            match self.pop_front() {
                Some(x) => self.push_back(x),
                None => {}
            }
            n = n - 1;
        }
    }

    fn rotate_right(&mut self, k: Int) {
        if self.__len == 0 {
            return;
        }
        let mut n = k.rem_euclid(self.__len);
        while n > 0 {
            match self.pop_back() {
                Some(x) => self.push_front(x),
                None => {}
            }
            n = n - 1;
        }
    }

    fn append(&mut self, other: &mut VecDeque<T>) {
        while let Some(x) = other.pop_front() {
            self.push_back(x);
        }
    }

    fn extend<I: Iterator<Item = T>>(&mut self, mut iter: I) {
        while let Some(x) = iter.next() {
            self.push_back(x);
        }
    }

    // iter returns the elements from front to back (both ends). Like Vec's,
    // it sees elements pushed at the back while iterating.
    #[fresh]
    fn iter(&self) -> VecDequeIter<T> {
        VecDequeIter { __dq: *self, __i: 0, __end: -1 }
    }

    // make_contiguous returns the elements as a Vec (front first).
    #[fresh]
    fn make_contiguous(&self) -> Vec<T> {
        self.iter().collect()
    }
}

impl<T: PartialEq> VecDeque<T> {
    fn contains(&self, x: &T) -> Bool {
        for y in self.iter() {
            if y == *x {
                return true;
            }
        }
        false
    }
}

struct VecDequeIter<T> {
    __dq: VecDeque<T>,
    mut __i: Int,
    mut __end: Int,
}

impl<T> Iterator for VecDequeIter<T> {
    type Item = T;

    fn next(&mut self) -> Option<T> {
        let n = if self.__end < 0 {
            self.__dq.len()
        } else {
            self.__end
        };
        if self.__i < n {
            let x = self.__dq.get(self.__i);
            self.__i = self.__i + 1;
            x
        } else {
            None
        }
    }
}

impl<T> DoubleEndedIterator for VecDequeIter<T> {
    fn next_back(&mut self) -> Option<T> {
        if self.__end < 0 {
            self.__end = self.__dq.len();
        }
        if self.__i < self.__end {
            self.__end = self.__end - 1;
            self.__dq.get(self.__end)
        } else {
            None
        }
    }
}

impl<T> IntoIterator for VecDeque<T> {
    type Item = T;
    type IntoIter = VecDequeIter<T>;

    fn into_iter(self) -> VecDequeIter<T> {
        self.iter()
    }
}

impl<T> FromIterator<T> for VecDeque<T> {
    fn from_iter<I: Iterator<Item = T>>(iter: I) -> VecDeque<T> {
        let mut d = VecDeque::new();
        d.extend(iter);
        d
    }
}

impl<T: Clone> Clone for VecDeque<T> {
    fn clone(&self) -> VecDeque<T> {
        let mut d = VecDeque::with_capacity(self.len());
        for x in self.iter() {
            d.push_back(x.clone());
        }
        d
    }
}

impl<T: PartialEq> PartialEq for VecDeque<T> {
    fn eq(&self, other: &VecDeque<T>) -> Bool {
        self.len() == other.len() && self.iter().eq(other.iter())
    }
}

impl<T: Eq> Eq for VecDeque<T> {}

impl<T> Default for VecDeque<T> {
    fn default() -> VecDeque<T> {
        VecDeque::new()
    }
}
