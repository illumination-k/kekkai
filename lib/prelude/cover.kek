// `kek cover` and `kek mutate`: runtime support of instrumented programs.
//
// `kek cover` inserts `__cov_hit(k);` probes into the user's functions
// (compiler/cover_walk.kek); `kek mutate` compiles every mutant into one
// module (a mutant schema) whose sites call `__mut_on(k)` and friends
// (compiler/mutate_gen.kek). Both record the probes / mutant sites that
// ran in `__Rt.cov`, and `__exit` writes them to the file named by the
// environment variable KEK_COVER_OUT (ids separated by spaces). The active
// mutant is KEK_MUTANT (0 or unset: none).

fn __cov_hit(k: Int) {
    let mut rt = __Rt::get();
    rt.ticks = rt.ticks + 1;
    if rt.budget > 0 && rt.ticks > rt.budget {
        // a deterministic time limit (`kek mutate`): the run took more
        // probe hits than its budget
        __print("kek-timeout");
        __exit(3);
    }
    let mut c = rt.cov;
    while c.len() <= k {
        c.push(false);
    }
    if !c.get(k).unwrap_or(false) {
        c.set(k, true);
        rt.cov_hits.push(k);
    }
}

// __cov_flush is called by __exit.
fn __cov_flush() {
    let rt = __Rt::get();
    if rt.cov_out == "" {
        return;
    }
    let mut ids = Vec::new();
    let mut i = 0;
    for b in rt.cov {
        if b {
            ids.push(i.to_string());
        }
        i = i + 1;
    }
    match __fs_write(__Any::null(), rt.cov_out, ids.join(" ") + "\n") {
        Ok(_) => {}
        Err(e) => __eprint("kek cover: " + rt.cov_out + ": " + e.message),
    }
}

// __mut_on records that mutant site k was reached and reports whether
// mutant k is the active one.
fn __mut_on(k: Int) -> Bool {
    __cov_hit(k);
    __Rt::get().mutant == k
}

fn __mut_is(k: Int) -> Bool {
    __Rt::get().mutant == k
}

fn __mut_isnot(k: Int) -> Bool {
    __Rt::get().mutant != k
}

// b, negated when mutant k is active (negated conditions, dropped `!`,
// flipped boolean literals, `==` / `!=` swaps).
fn __mut_flip(k: Int, b: Bool) -> Bool {
    if __mut_on(k) { !b } else { b }
}

// b XOR (mutant k is active): `&&` / `||` swaps (see mutate_gen.kek).
fn __mut_xor(k: Int, b: Bool) -> Bool {
    b != __mut_on(k)
}

// an integer replaced by alt when mutant k is active (literals, results)
fn __mut_int(k: Int, x: Int, alt: Int) -> Int {
    if __mut_on(k) { alt } else { x }
}

fn __mut_str(k: Int, s: String) -> String {
    if __mut_on(k) { "" } else { s }
}

// `-x`, or x when mutant k (dropping the minus) is active
fn __mut_neg(k: Int, x: Int) -> Int {
    if __mut_on(k) { x } else { 0 - x }
}

// operator codes: 1 + 2 - 3 * 4 / 5 % 6 < 7 <= 8 > 9 >=
fn __mut_iop(k: Int, x: Int, y: Int, op: Int, alt: Int) -> Int {
    let o = if __mut_on(k) { alt } else { op };
    if o == 1 {
        x + y
    } else if o == 2 {
        x - y
    } else if o == 3 {
        x * y
    } else if o == 4 { x / y } else { x % y }
}

fn __mut_icmp(k: Int, x: Int, y: Int, op: Int, alt: Int) -> Bool {
    let o = if __mut_on(k) { alt } else { op };
    if o == 6 {
        x < y
    } else if o == 7 {
        x <= y
    } else if o == 8 { x > y } else { x >= y }
}

// ---- batch runs (`kek mutate`) ----
//
// `<module> --batch` runs the plan in the file KEK_BATCH in one process
// instead of one process per (mutant, test). Each line is
// `mutant test:budget test:budget ...`. Mutant 0 is the baseline: every
// test runs and `kek-base test status ticks ids` reports its result, the
// number of probe hits and the mutant sites it reached. Otherwise the
// tests run until one fails and `kek-result mutant killed|survived test`
// reports it. `kek-start mutant` comes first, so the launcher knows which
// mutant was running when the process trapped or ran out of budget (exit
// status 3); it restarts the rest of the plan in a new process. The
// harness (compiler/testrun.kek) supplies the loop.

fn __batch_plan() -> Vec<String> {
    let rt = __Rt::get();
    let f = __env_lookup(__env_all(rt), "KEK_BATCH");
    let mut out = Vec::new();
    match __fs_read(__Any::null(), f) {
        Ok(text) => {
            for l in text.split("\n") {
                if l != "" {
                    out.push(l);
                }
            }
        }
        Err(e) => __eprint("kek: KEK_BATCH: " + f + ": " + e.message),
    }
    out
}

fn __batch_mutant(m: Int) {
    __Rt::get().mutant = m;
    __print("kek-start " + m.to_string());
}

// __batch_test resets the state for test `name:budget` and returns name.
fn __batch_test(tb: String) -> String {
    let mut rt = __Rt::get();
    // the name of a test in a module has `::` in it: the budget is what
    // follows the last `:` when it is a number
    let mut name = tb;
    let mut budget = "0";
    let mut i = tb.len() - 1;
    while i > 0 {
        if tb.char_at(i).unwrap_or(0) == 58 {
            let tail = tb.slice(i + 1, tb.len());
            if tail.parse_int().is_some() {
                name = tb.slice(0, i);
                budget = tail;
            }
            break;
        }
        i = i - 1;
    }
    __print("kek-test " + name);
    rt.rand = rt.seed;
    __test_begin(name);
    __test_case_reset();
    for k in rt.cov_hits {
        rt.cov.set(k, false);
    }
    rt.cov_hits = Vec::new();
    rt.ticks = 0;
    rt.budget = budget.parse_int().unwrap_or(0);
    name
}

// __batch_done reports a baseline run (mutant 0).
fn __batch_done(name: String, code: Int) {
    let mut rt = __Rt::get();
    rt.budget = 0;
    if rt.mutant != 0 {
        return;
    }
    let mut ids = Vec::new();
    for k in rt.cov_hits {
        ids.push(k.to_string());
    }
    let st = if code == 0 { "ok" } else { "failed" };
    __print("kek-base " + name + " " + st + " " + rt.ticks.to_string() + " " + ids.join(","));
}

fn __batch_result(m: Int, killed_by: String) {
    if killed_by == "" {
        __print("kek-result " + m.to_string() + " survived");
    } else {
        __print("kek-result " + m.to_string() + " killed " + killed_by);
    }
}
