// Map<K, V> with Int or String keys, in insertion order.
//
// Entries live in parallel vectors (removed entries leave a hole that is
// compacted away when the table grows); `slots` is an open-addressing hash
// table of entry index + 1 (0 = empty). Values are boxed into `__Any` by
// the code generator.

struct __Map {
    str_keys: Bool,
    ikeys: Vec<Int>,
    skeys: Vec<String>,
    vals: Vec<__Any>,
    live: Vec<Bool>,
    count: Int,
    slots: Vec<Int>,
}

fn __map_new(str_keys: Bool) -> __Map {
    __Map {
        str_keys: str_keys,
        ikeys: Vec::new(),
        skeys: Vec::new(),
        vals: Vec::new(),
        live: Vec::new(),
        count: 0,
        slots: __map_empty_slots(8),
    }
}

fn __map_empty_slots(n: Int) -> Vec<Int> {
    let v = Vec::new();
    for i in 0..n {
        v.push(0);
    }
    v
}

fn __hash_int(k: Int) -> Int {
    let mut h = k * -7046029254386353131;
    h = h.bit_xor(h.ushr(29));
    h
}

fn __hash_str(s: String) -> Int {
    let x = __Chars::of(s);
    let n = x.len();
    let mut h = -3750763034362895579;
    let mut i = 0;
    while i < n {
        h = h.bit_xor(x.get(i)) * 1099511628211;
        i = i + 1;
    }
    h.bit_xor(h.ushr(29))
}

// __map_find_int returns the entry index of key k, or -1.
fn __map_find_int(m: __Map, k: Int) -> Int {
    let mask = m.slots.len() - 1;
    let mut s = __hash_int(k).bit_and(mask);
    while true {
        let e = m.slots.get(s).unwrap_or(0);
        if e == 0 {
            return -1;
        }
        if m.ikeys.get(e - 1).unwrap_or(0) == k && m.live.get(e - 1).unwrap_or(false) {
            return e - 1;
        }
        s = (s + 1).bit_and(mask);
    }
    -1
}

fn __map_find_str(m: __Map, k: String) -> Int {
    let mask = m.slots.len() - 1;
    let mut s = __hash_str(k).bit_and(mask);
    while true {
        let e = m.slots.get(s).unwrap_or(0);
        if e == 0 {
            return -1;
        }
        if m.live.get(e - 1).unwrap_or(false) && m.skeys.get(e - 1).unwrap_or("") == k {
            return e - 1;
        }
        s = (s + 1).bit_and(mask);
    }
    -1
}

fn __map_slot_of(m: __Map, e: Int) -> Int {
    if m.str_keys {
        __hash_str(m.skeys.get(e).unwrap_or(""))
    } else {
        __hash_int(m.ikeys.get(e).unwrap_or(0))
    }
}

fn __map_place(m: __Map, e: Int) {
    let mask = m.slots.len() - 1;
    let mut s = __map_slot_of(m, e).bit_and(mask);
    while m.slots.get(s).unwrap_or(0) != 0 {
        s = (s + 1).bit_and(mask);
    }
    m.slots.set(s, e + 1);
}

// __map_rebuild drops removed entries and rehashes into a table with room
// for at least `want` live entries.
fn __map_rebuild(m: __Map, want: Int) {
    let ik = Vec::new();
    let sk = Vec::new();
    let vs = Vec::new();
    let lv = Vec::new();
    let n = m.live.len();
    for i in 0..n {
        if m.live.get(i).unwrap_or(false) {
            if m.str_keys {
                sk.push(m.skeys.get(i).unwrap_or(""));
            } else {
                ik.push(m.ikeys.get(i).unwrap_or(0));
            }
            vs.push(m.vals.get(i).unwrap_or(__Any::null()));
            lv.push(true);
        }
    }
    m.ikeys = ik;
    m.skeys = sk;
    m.vals = vs;
    m.live = lv;
    let mut size = 8;
    while size < want * 2 {
        size = size * 2;
    }
    m.slots = __map_empty_slots(size);
    for i in 0..lv.len() {
        __map_place(m, i);
    }
}

fn __map_grow(m: __Map) {
    // entries (including holes) + the new one must stay below 3/4 full
    if (m.live.len() + 1) * 4 >= m.slots.len() * 3 {
        __map_rebuild(m, m.count + 1);
    }
}

fn __map_insert_int(m: __Map, k: Int, v: __Any) {
    let e = __map_find_int(m, k);
    if e >= 0 {
        m.vals.set(e, v);
        return;
    }
    __map_grow(m);
    m.ikeys.push(k);
    m.vals.push(v);
    m.live.push(true);
    m.count = m.count + 1;
    __map_place(m, m.live.len() - 1);
}

fn __map_insert_str(m: __Map, k: String, v: __Any) {
    let e = __map_find_str(m, k);
    if e >= 0 {
        m.vals.set(e, v);
        return;
    }
    __map_grow(m);
    m.skeys.push(k);
    m.vals.push(v);
    m.live.push(true);
    m.count = m.count + 1;
    __map_place(m, m.live.len() - 1);
}

fn __map_val(m: __Map, e: Int) -> __Any {
    m.vals.get(e).unwrap_or(__Any::null())
}

fn __map_remove_at(m: __Map, e: Int) {
    if e < 0 {
        return;
    }
    m.live.set(e, false);
    m.vals.set(e, __Any::null());
    m.count = m.count - 1;
    // the slot keeps pointing at the dead entry (a tombstone); rebuild
    // when holes dominate
    if m.live.len() > 16 && m.count * 2 < m.live.len() {
        __map_rebuild(m, m.count);
    }
}

fn __map_remove_int(m: __Map, k: Int) {
    __map_remove_at(m, __map_find_int(m, k));
}

fn __map_remove_str(m: __Map, k: String) {
    __map_remove_at(m, __map_find_str(m, k));
}

fn __map_len(m: __Map) -> Int {
    m.count
}

fn __map_keys_int(m: __Map) -> Vec<Int> {
    let out = Vec::new();
    for i in 0..m.live.len() {
        if m.live.get(i).unwrap_or(false) {
            out.push(m.ikeys.get(i).unwrap_or(0));
        }
    }
    out
}

fn __map_keys_str(m: __Map) -> Vec<String> {
    let out = Vec::new();
    for i in 0..m.live.len() {
        if m.live.get(i).unwrap_or(false) {
            out.push(m.skeys.get(i).unwrap_or(""));
        }
    }
    out
}

fn __vec_join(v: Vec<String>, sep: String) -> String {
    let n = v.len();
    if n == 0 {
        return "";
    }
    let b = __sb_new(16);
    for i in 0..n {
        if i > 0 {
            __sb_str(b, sep);
        }
        __sb_str(b, v.get(i).unwrap_or(""));
    }
    __sb_finish(b)
}
