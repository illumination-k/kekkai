// `kek test`: mock capabilities and result reporting.
//
// The test program's #[main] (synthesized by `kek test`) runs one test,
// named by its first argument, in a fresh process. The mocks are
// configured through the environment:
//   KEK_TEST=1            enable the mocks
//   KEK_TEST_CLOCK=ms     fixed time of &Clock
//   KEK_TEST_SEED=n       seed of &Random and of the inputs of property
//                         tests (mixed with the test name)
//   KEK_TEST_CASES=n      cases of a property test (default 100)
//   KEK_TEST_NET=file     canned &Net responses: {"GET url": "body", "POST url": {"error": "msg"}}
//   KEK_TEST_DB=file      initial contents of &Db: {"key": "value"}

fn __test_setup(mut rt: __Rt, env: Vec<String>) {
    rt.clock_ms = __env_lookup(env, "KEK_TEST_CLOCK").parse_int().unwrap_or(0);
    rt.seed = __env_lookup(env, "KEK_TEST_SEED").parse_int().unwrap_or(0);
    rt.rand = rt.seed;
    rt.cases = __env_lookup(env, "KEK_TEST_CASES").parse_int().unwrap_or(100);
}

// FNV-1a over the UTF-8 bytes
fn __fnv64(s: String) -> Int {
    let mut h = -3750763034362895579;
    for b in s.to_bytes() {
        h = h.bit_xor(b) * 1099511628211;
    }
    h
}

// __test_begin loads the mocks for test `name` and starts its clock. It
// returns false (after reporting) when a mock file is invalid.
fn __test_begin(name: String) -> Bool {
    let mut rt = __Rt::get();
    let env = __env_all(rt);
    rt.test_name = name;
    rt.rand = rt.rand.bit_xor(__fnv64(name));
    let netf = __env_lookup(env, "KEK_TEST_NET");
    if netf != "" {
        match __fs_read(__Any::null(), netf) {
            Ok(text) => {
                let p = __json_new(text);
                if !__json_object(p, rt, netf, false) {
                    __eprint(netf + ": " + p.err);
                    return false;
                }
            }
            Err(e) => {
                __eprint("open " + netf + ": no such file or directory");
                return false;
            }
        }
    }
    let dbf = __env_lookup(env, "KEK_TEST_DB");
    if dbf != "" {
        match __fs_read(__Any::null(), dbf) {
            Ok(text) => {
                let p = __json_new(text);
                if !__json_object(p, rt, dbf, true) {
                    __eprint(dbf + ": " + p.err);
                    return false;
                }
                rt.db_text = text;
            }
            Err(e) => {
                __eprint("open " + dbf + ": no such file or directory");
                return false;
            }
        }
    }
    rt.rand0 = rt.rand;
    rt.start_ns = __now_ns(1);
    true
}

// __test_case_reset gives the next run of a property test fresh mocks:
// the &Db store of KEK_TEST_DB, no log lines or outbox, and the &Random
// sequence of the test's first run. Runs are independent, so a
// counterexample reproduces on its own.
fn __test_case_reset() {
    let mut rt = __Rt::get();
    rt.rand = rt.rand0;
    rt.lines = Vec::new();
    rt.sent = Vec::new();
    rt.store = __store_new();
    if rt.db_text != "" {
        __json_object(__json_new(rt.db_text), rt, "", true);
    }
}

fn __test_elapsed() -> String {
    let rt = __Rt::get();
    let tenths = (__now_ns(1) - rt.start_ns) / 100000;
    (tenths / 10).to_string() + "." + (tenths % 10).to_string() + "ms"
}

fn __test_ok(name: String, kind: String) -> Int {
    __print("test " + name + " ... ok (" + kind + "; " + __test_elapsed() + ")");
    0
}

fn __test_failed(name: String, kind: String, why: String) -> Int {
    __print("test " + name + " ... FAILED (" + kind + "; " + __test_elapsed() + ")");
    __print("    " + why);
    __test_mock_lines()
}

fn __test_mock_lines() -> Int {
    let rt = __Rt::get();
    for l in rt.lines {
        __print("    " + l);
    }
    for s in rt.sent {
        __print("    outbox: " + s);
    }
    1
}

fn __test_false(name: String, kind: String) -> Int {
    __test_failed(name, kind, "returned false")
}

fn __test_err(name: String, kind: String, msg: String) -> Int {
    __test_failed(name, kind, "Err: " + msg)
}

// ---- a small JSON reader for the mock files ----

struct __Json {
    s: String,
    mut i: Int,
    mut err: String,
}

fn __json_new(s: String) -> __Json {
    __Json { s: s, i: 0, err: "" }
}

fn __json_peek(p: __Json) -> Int {
    p.s.char_at(p.i).unwrap_or(-1)
}

fn __json_ws(mut p: __Json) {
    while true {
        let c = __json_peek(p);
        if c == 32 || c == 9 || c == 10 || c == 13 {
            p.i = p.i + 1;
        } else {
            return;
        }
    }
}

fn __json_fail(mut p: __Json, m: String) -> Bool {
    if p.err == "" {
        p.err = m;
    }
    false
}

fn __json_hex(c: Int) -> Int {
    if c >= 48 && c <= 57 {
        c - 48
    } else if c >= 97 && c <= 102 {
        c - 87
    } else if c >= 65 && c <= 70 { c - 55 } else { -1 }
}

// __json_string reads a string literal (the opening quote is current).
fn __json_string(mut p: __Json) -> Option<String> {
    p.i = p.i + 1;
    let b = __sb_new(16);
    while true {
        let c = __json_peek(p);
        if c < 0 {
            __json_fail(p, "unterminated string in JSON");
            return None;
        }
        p.i = p.i + 1;
        if c == 34 {
            return Some(__sb_finish(b));
        }
        if c != 92 {
            __sb_char(b, c);
            continue;
        }
        let e = __json_peek(p);
        p.i = p.i + 1;
        if e == 110 {
            __sb_char(b, 10);
        } else if e == 116 {
            __sb_char(b, 9);
        } else if e == 114 {
            __sb_char(b, 13);
        } else if e == 98 {
            __sb_char(b, 8);
        } else if e == 102 {
            __sb_char(b, 12);
        } else if e == 117 {
            let mut v = 0;
            for k in 0..4 {
                let h = __json_hex(__json_peek(p));
                if h < 0 {
                    __json_fail(p, "bad escape in JSON string");
                    return None;
                }
                v = v * 16 + h;
                p.i = p.i + 1;
            }
            __sb_char(b, v);
        } else if e == 34 || e == 92 || e == 47 {
            __sb_char(b, e);
        } else {
            __json_fail(p, "bad escape in JSON string");
            return None;
        }
    }
    None
}

// __json_scalar reads a number, true, false or null as its source text.
fn __json_scalar(mut p: __Json) -> Option<String> {
    let start = p.i;
    while true {
        let c = __json_peek(p);
        if c < 0 || c == 44 || c == 125 || c == 93 || c == 32 || c == 10 || c == 13 || c == 9 {
            break;
        }
        p.i = p.i + 1;
    }
    if p.i == start {
        __json_fail(p, "unexpected character in JSON");
        return None;
    }
    Some(p.s.slice(start, p.i))
}

// __json_error_obj reads `{"error": "msg"}` (other members are ignored)
// and returns the message, or "" when there is none.
fn __json_error_obj(mut p: __Json) -> Option<String> {
    p.i = p.i + 1;
    let mut msg = "";
    __json_ws(p);
    if __json_peek(p) == 125 {
        p.i = p.i + 1;
        return Some(msg);
    }
    while true {
        __json_ws(p);
        if __json_peek(p) != 34 {
            __json_fail(p, "expected a string key in JSON");
            return None;
        }
        let k = __json_string(p)?;
        __json_ws(p);
        if __json_peek(p) != 58 {
            __json_fail(p, "expected ':' in JSON");
            return None;
        }
        p.i = p.i + 1;
        __json_ws(p);
        let v = if __json_peek(p) == 34 {
            __json_string(p)?
        } else {
            __json_scalar(p)?
        };
        if k == "error" {
            msg = v;
        }
        __json_ws(p);
        let c = __json_peek(p);
        p.i = p.i + 1;
        if c == 125 {
            return Some(msg);
        }
        if c != 44 {
            __json_fail(p, "expected ',' or '}' in JSON");
            return None;
        }
    }
    None
}

// __json_object reads the top-level object of a mock file into rt (the
// &Db store when db is set, else the canned &Net responses).
fn __json_object(mut p: __Json, mut rt: __Rt, file: String, db: Bool) -> Bool {
    __json_ws(p);
    if __json_peek(p) != 123 {
        return __json_fail(p, if db {
            "expected a JSON object of strings"
        } else {
            "expected a JSON object"
        });
    }
    p.i = p.i + 1;
    __json_ws(p);
    if __json_peek(p) == 125 {
        return true;
    }
    while true {
        __json_ws(p);
        if __json_peek(p) != 34 {
            return __json_fail(p, "expected a string key in JSON");
        }
        let k = match __json_string(p) {
            Some(x) => x,
            None => {
                return false;
            }
        };
        __json_ws(p);
        if __json_peek(p) != 58 {
            return __json_fail(p, "expected ':' in JSON");
        }
        p.i = p.i + 1;
        __json_ws(p);
        let c = __json_peek(p);
        if c == 34 {
            match __json_string(p) {
                Some(v) => {
                    if db {
                        __store_put(rt.store, k, v);
                    } else {
                        rt.net.insert(k, v);
                    }
                }
                None => {
                    return false;
                }
            }
        } else if db {
            return __json_fail(p, "expected a JSON object of strings");
        } else if c == 123 {
            match __json_error_obj(p) {
                Some(m) => {
                    rt.net_err.insert(k, m);
                }
                None => {
                    return false;
                }
            }
        } else {
            match __json_scalar(p) {
                Some(v) => {
                    rt.net.insert(k, v);
                }
                None => {
                    return false;
                }
            }
        }
        __json_ws(p);
        let d = __json_peek(p);
        p.i = p.i + 1;
        if d == 125 {
            return true;
        }
        if d != 44 {
            return __json_fail(p, "expected ',' or '}' in JSON");
        }
    }
    false
}

// __panic_report reports a failed assert! or a panic! (compiler/macro.kek;
// they are only allowed in #[test] functions) on stderr and ends the
// process with status 101: `panicked at file.kek:L:C:`, the message, and
// under `kek test` the log lines and outbox of the mocks.
fn __panic_report(msg: String, at: String) {
    __eprint("panicked at " + at + ":");
    __eprint(msg);
    let rt = __Rt::get();
    for l in rt.lines {
        __eprint(l);
    }
    for s in rt.sent {
        __eprint("outbox: " + s);
    }
    __exit(101);
}
