// Runtime prelude: compiled together with every program by `kek build`.
//
// The prelude implements the builtin operations in Kekkai itself, on top
// of a few intrinsics that the code generator emits inline (`__Chars`,
// `__Mem`, `__Wasi`, `__Any`, `__Int`). A builtin operation `recv.name`
// (for example `string.split`) is implemented by the function
// `__recv_name`, whose parameters are the receiver and the arguments.
//
// Identifiers starting with `__` are reserved: user programs cannot name
// anything defined here.

// ---- builtin types implemented as structs ----

struct Response {
    status: Int,
    body: String,
    has_body: Bool,
    // header names and values, alternating
    headers: Vec<String>,
}

struct TxError {
    message: String,
    retryable: Bool,
}

struct NetError {
    message: String,
}

struct IoError {
    message: String,
}

// ---- runtime state ----

// __Rt is created by `__rt_new` the first time `__Rt::get()` runs.
struct __Rt {
    // capabilities are mocks (`kek test`)
    mut test: Bool,
    // linear memory scratch area: [base, brk)
    base: Int,
    mut brk: Int,
    mut cwd: String,
    mut store: __Store,
    // test mode
    mut test_name: String,
    mut clock_ms: Int,
    mut rand: Int,
    net: HashMap<String, String>,
    net_err: HashMap<String, String>,
    mut lines: Vec<String>,
    mut sent: Vec<String>,
    mut start_ns: Int,
    // `kek cover` / `kek mutate` (lib/prelude/cover.kek): probes hit, the
    // file they are written to at exit, the active mutant
    cov: Vec<Bool>,
    mut cov_out: String,
    mut mutant: Int,
    // property tests: KEK_TEST_SEED, KEK_TEST_CASES, the &Random state at
    // the start of the test and the text of KEK_TEST_DB (every case gets
    // fresh mocks)
    mut seed: Int,
    mut cases: Int,
    mut rand0: Int,
    mut db_text: String,
}
