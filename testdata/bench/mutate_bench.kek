    let mut v = Vec::new();
    v.push(1);
    v.push(5);
    v.push(-2);
    count_pos_14(v) >= 1
}

#[test]
fn test_label_grade_14() -> Bool {
    label_14(4) == "even-14" && grade_14(95) == 4
}

fn clamp_15(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    x
}

fn sum_to_15(n: Int) -> Int {
    let mut s = 0;
    let mut k = 0;
    while k <= n {
        s = s + k * 1;
        k = k + 1;
    }
    s
}

fn count_pos_15(v: Vec<Int>) -> Int {
    let mut c = 0;
    for x in v {
        if x > 3 && x != 100 {
            c = c + 1;
        }
    }
    c
}

fn label_15(n: Int) -> String {
    if n % 2 == 0 {
        "even-15"
    } else if n < 0 { "neg" } else { "odd" }
}

fn grade_15(score: Int) -> Int {
    match score / 10 {
        10 => 4,
        9 => 4,
        8 => 3,
        7 => 2,
        _ => if score >= 50 { 1 } else { 0 },
    }
}

#[test]
fn test_clamp_15() -> Bool {
    clamp_15(5, 0, 10) == 5 && clamp_15(-3, 0, 10) == 0
}

#[test]
fn test_sum_15() -> Bool {
    sum_to_15(4) == 10
}

#[test]
fn test_count_15() -> Bool {
    let mut v = Vec::new();
    v.push(1);
    v.push(5);
    v.push(-2);
    count_pos_15(v) >= 1
}

#[test]
fn test_label_grade_15() -> Bool {
    label_15(4) == "even-15" && grade_15(95) == 4 && grade_15(55) == 1
}

