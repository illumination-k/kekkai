// Benchmark program for kek mutate / kek cover (generated by tests/bench/gen.py).

fn clamp_0(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    x
}

fn sum_to_0(n: Int) -> Int {
    let mut s = 0;
    let mut k = 0;
    while k <= n {
        s = s + k * 1;
        k = k + 1;
    }
    s
}

fn count_pos_0(v: Vec<Int>) -> Int {
    let mut c = 0;
    for x in v {
        if x > 0 && x != 100 {
            c = c + 1;
        }
    }
    c
}

fn label_0(n: Int) -> String {
    if n % 2 == 0 {
        "even-0"
    } else if n < 0 { "neg" } else { "odd" }
}

fn grade_0(score: Int) -> Int {
    match score / 10 {
        10 => 4,
        9 => 4,
        8 => 3,
        7 => 2,
        _ => if score >= 50 { 1 } else { 0 },
    }
}

#[test]
fn test_clamp_0() -> Bool {
    clamp_0(5, 0, 10) == 5 && clamp_0(-3, 0, 10) == 0 && clamp_0(30, 0, 10) == 10
}

#[test]
fn test_sum_0() -> Bool {
    sum_to_0(4) == 10
}

#[test]
fn test_count_0() -> Bool {
    let mut v = Vec::new();
    v.push(1);
    v.push(5);
    v.push(-2);
    count_pos_0(v) >= 1
}

#[test]
fn test_label_grade_0() -> Bool {
    label_0(4) == "even-0" && grade_0(95) == 4 && grade_0(55) == 1
}

