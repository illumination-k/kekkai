// Personal data (Pii) cannot become a String except through a
// declassification (mask, hash, expose_unchecked).

struct User {
    name: String,
    email: Pii<String>,
}

fn to_log(log: &Log, p: Pii<String>) {
    log.info(p); // ERROR "expected `String`, found `Pii<String>` (personal data"
}

fn concat(p: Pii<String>) -> String {
    "x" + p // ERROR "string concatenation: expected `String`, found `Pii<String>`"
}

fn concat_left(p: Pii<String>) -> String {
    p + "x" // ERROR "string concatenation: expected `String`, found `Pii<String>`"
}

fn respond(p: Pii<String>) -> Response {
    Response::text(200, p) // ERROR "expected `String`, found `Pii<String>`"
}

fn render(p: Pii<String>) -> String {
    p.to_string() // ERROR "no method named `to_string` found for `Pii<String>` (personal data"
}

fn store(db: &Db, k: String, p: Pii<String>) -> Result<(), TxError> {
    db.transaction(|tx| {
        tx.put(k, p)?; // ERROR "expected `String`, found `Pii<String>`"
        tx.commit()
    })
}

fn compare_plain(p: Pii<String>, s: String) -> Bool {
    p == s // ERROR "cannot compare `Pii<String>` with `String` (personal data"
}

fn compare_plain_left(p: Pii<String>, s: String) -> Bool {
    s == p // ERROR "cannot compare `String` with `Pii<String>` (personal data"
}

fn ordered(a: Pii<Int>, b: Pii<Int>) -> Bool {
    a < b // ERROR "binary operation `<` cannot be applied to type `Pii<Int>`"
}

fn as_int(p: Pii<Int>) -> Int {
    p + 1 // ERROR "arithmetic: expected `Int`, found `Pii<Int>`"
}

fn user_line(u: User) -> String {
    u.name + " " + u.email // ERROR "expected `String`, found `Pii<String>`"
}

fn hash_key(m: HashMap<Pii<String>, Int>, p: Pii<String>) -> Option<Int> {
    m.get(&p) // ERROR "`Pii<String>: Hash` is not satisfied" ERROR "`Pii<String>: Ord` is not satisfied"
}

trait Show {
    fn show(&self) -> String;
}

fn show_all<T: Show>(v: Vec<T>) -> Vec<String> {
    v.iter().map(|x| x.show()).collect()
}

fn generic_leak(v: Vec<Pii<String>>) -> Vec<String> {
    show_all(v) // ERROR "`Pii<String>: Show` is not satisfied"
}

fn joined(v: Vec<Pii<String>>) -> String {
    v.join(",") // ERROR "join"
}

fn hashed_plain(p: Pii<Int>) -> Int {
    let h = DefaultHasher::new();
    p.hash(&mut h); // ERROR "takes 0 argument(s)"
    h.finish()
}

#[derive(PartialEq, Eq)]
struct Contact {
    email: Pii<String>,
}

#[derive(Hash)] // ERROR "cannot derive `Hash` for `Account`: field `email` holds personal data (`Pii`)"
struct Account {
    id: Int,
    email: Pii<String>,
}

#[derive(PartialOrd, Default)] // ERROR "cannot derive `PartialOrd` for `Person`" ERROR "cannot derive `Default` for `Person`"
struct Person {
    emails: Vec<Pii<String>>,
}

#[derive(PartialEq, Ord)] // ERROR "cannot derive `Ord` for `Who`: variant `Known` holds personal data"
enum Who {
    Anonymous,
    Known(Pii<String>),
}

// allowed: comparing two Pii values, and the declassifications
fn allowed(a: Contact, b: Contact, p: Pii<String>, log: &Log) -> Bool {
    log.info(p.mask() + " " + p.hash());
    let raw: String = p.expose_unchecked();
    a == b && a.email == Pii::new(raw)
}
