// Facts from range patterns, or-patterns, `@` bindings and match guards.
//
// kekkai.toml: [refine]
// kekkai.toml: division = "error"

fn range_arm(x: Int) -> Int {
    match x {
        1..=9 => 100 % x,
        -9..0 => 100 % x,
        0..=5 => 100 % x, // ERROR "cannot prove the divisor `x` is nonzero (counterexample: x = 0)"
        _ => 0,
    }
}

// the negations of earlier unguarded range arms hold in a later `_` arm
fn after_ranges(x: Int) -> Int {
    match x {
        ..=-1 => 1,
        0..1 => 2,
        _ => 100 % x,
    }
}

fn at_binding(o: Option<Int>) -> Int {
    match o {
        Some(n @ (1 | 2 | 3)) => 100 % n,
        Some(n @ 10..) => 100 % n,
        Some(n @ -5..=5) => 100 % n, // ERROR "cannot prove the divisor `n` is nonzero (counterexample: n = 0)"
        _ => 0,
    }
}

fn or_ints(x: Int) -> Int {
    match x {
        2 | 4 | 6 => 100 % x,
        n @ (0 | 1) => 100 % n, // ERROR "cannot prove the divisor `n` is nonzero (counterexample: n = 0)"
        _ => 0,
    }
}

fn guard_fact(o: Option<Int>) -> Int {
    match o {
        Some(n) if n > 0 => 100 % n,
        Some(n) if n != 0 => 100 % n,
        Some(n) => 100 % n, // ERROR "cannot prove the divisor `n` is nonzero"
        None => 0,
    }
}

// a guarded arm says nothing about the later arms
fn guarded_range(x: Int, b: Bool) -> Int {
    match x {
        0 if b => 1,
        ..=-1 if b => 1,
        _ => 100 % x, // ERROR "cannot prove the divisor `x` is nonzero (counterexample: x = 0)"
    }
}

fn if_let_range(x: Int) -> Int {
    if let 1..=9 = x {
        100 % x
    } else if let n @ 10.. = x {
        100 % n
    } else {
        0
    }
}

#[main]
fn main(log: &Log) -> Int {
    0
}
