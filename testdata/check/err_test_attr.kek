// #[test] functions: capabilities and generatable values (property tests),
// result (), Bool or Result<(), String>.
#[test]
fn ok_unit() {
}

#[test]
fn ok_bool() -> Bool {
    true
}

#[test]
fn ok_result(log: &Log, db: &Db) -> Result<(), String> {
    log.info("hi");
    Ok(())
}

#[test]
fn ok_property(x: Int, v: Vec<(String, Option<Bool>)>, log: &Log) -> Bool {
    x == x
}

struct Loop {
    next: Loop,
}

enum Endless {
    More(Endless),
}

#[test]
fn bad_param(f: fn(Int) -> Int) -> Bool { // ERROR "cannot generate inputs of type `fn(Int) -> Int` for a property test: functions cannot be generated"
    f(1) == 1
}

#[test]
fn bad_lib_type(m: HashMap<Int, Int>) { // ERROR "`HashMap` is a library type"
}

#[test]
fn bad_opaque(r: Request) { // ERROR "`Request` values cannot be generated"
}

#[test]
fn bad_loop(l: Option<Loop>) { // ERROR "the recursive struct `Loop` has no finite values"
}

#[test]
fn bad_endless(e: Endless) { // ERROR "every variant of the recursive enum `Endless` contains `Endless` itself"
}

#[test]
fn bad_result() -> Int { // ERROR "a test must return `()`, `Bool` or `Result<(), String>`, found `Int`"
    1
}

#[test]
fn bad_err() -> Result<(), Int> { // ERROR "found `Result<(), Int>`"
    Ok(())
}

#[test]
fn bad_tx(tx: &Tx) { // ERROR "test parameters must be capabilities (&Log, &Net, &Db, &Clock, &Random) or generatable values, found `&Tx`"
}

#[bench] // ERROR "unknown attribute `#[bench]`"
fn unknown() {
}

#[test(runs = 3)] // ERROR "unknown argument `runs = 3` of `#[test]`"
fn bad_test_arg() {
}

#[allow(dead_code)] // ERROR "`#[allow]` supports only `similar`"
fn bad_allow() {
}

#[rare(often)] // ERROR "`#[rare]` takes no arguments"
fn bad_rare_arg() {
}

#[test(cases = 10)]
fn ok_cases() {
}

#[allow(similar, reason = "kept apart on purpose", owner = "core", expires = "2027-01-01")]
#[rare]
fn ok_allow() {
}
