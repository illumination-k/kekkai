enum Color { Red, Green, Blue }

fn f(c: Color) -> Int {
    match c { // ERROR "non-exhaustive patterns in match on `Color`: missing `Color::Blue`"
        Red => 1,
        Green => 2,
    }
}

fn g(x: Int) -> String {
    x // ERROR "expected `String`, found `Int`"
}

fn h(r: Result<Int, TxError>) -> Result<Int, NetError> {
    let v = r?; // ERROR "cannot convert the error type `TxError` into `NetError`"
    Ok(v)
}

fn k() -> Int {
    let x = 1;
    x = 2; // ERROR "cannot assign twice"
    x
}

fn m(o: Option<Int>) -> Int {
    o? // ERROR "can only be used on `Option` in a function that returns `Option`"
}

#[handler]
fn handle(x: Int) -> Int { // ERROR "a handler must return `Response`" ERROR "handler parameters must be"
    1
} 

fn nested(r: Result<Option<Int>, String>) -> Int {
    match r { // ERROR "missing `Ok(_)`"
        Ok(Some(n)) => n,
        Err(_) => 0,
    }
}

fn nested_ok(r: Result<Option<Int>, String>) -> Int {
    match r {
        Ok(Some(1)) => 100,
        Ok(Some(n)) => n,
        Ok(None) => -1,
        Err("x") => 1,
        Err(_) => 0,
    }
}

fn unreachable_arm(o: Option<Bool>) -> Int {
    match o {
        Some(true) => 1,
        Some(false) => 2,
        None => 3,
        _ => 4, // ERROR "unreachable pattern"
    }
}
