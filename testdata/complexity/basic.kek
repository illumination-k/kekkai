// Fixtures of `kek complexity` (tests/suites/complexity.sh). The comments
// give the expected cognitive / cyclomatic complexity and nesting.

// 0 / 1 / 0
fn add(a: Int, b: Int) -> Int {
    a + b
}

// if, else if, else: 3 / 3 / 1
fn classify(n: Int) -> String {
    if n < 0 {
        "negative"
    } else if n == 0 { "zero" } else { "positive" }
}

// recursion: if, else, the recursive call: 3 / 2 / 1
fn fact(n: Int) -> Int {
    if n <= 1 { 1 } else { n * fact(n - 1) }
}

// a sequence of like operators counts once, a change of operator again:
// if, &&, ||: 3 / 4 / 1
fn in_range(x: Int, lo: Int, hi: Int, open: Bool) -> Bool {
    if (x >= lo && x <= hi) || open {
        return true;
    }
    false
}

// a closure nests: if inside it 1 + 1, else 1: 3 / 2 / 2
fn any_big(v: Vec<Int>) -> Bool {
    v.iter().any(|x| if x > 100 { true } else { false })
}

// match in a loop: for 1, match 1 + 1; three arms: 3 / 4 / 2
fn count_kinds(v: Vec<Int>) -> Int {
    let mut n = 0;
    for x in v {
        match x % 3 {
            0 => {
                n = n + 1;
            }
            1 => {
                n = n + 2;
            }
            _ => {}
        }
    }
    n
}

// `?`: 0 / 3 / 0
fn sum_halves(a: Int, b: Int) -> Result<Int, String> {
    let x = half(a)?;
    let y = half(b)?;
    Ok(x + y)
}

// 1 / 2 / 1
fn half(n: Int) -> Result<Int, String> {
    if n % 2 != 0 {
        return Err("odd");
    }
    Ok(n / 2)
}

// too deep: 1 + 2 + 3 + 4 + 5 = 15 / 6 / 5
fn deep(grid: Vec<Vec<Int>>) -> Int {
    let mut n = 0;
    for row in grid {
        for x in row {
            if x > 0 {
                if x % 2 == 0 {
                    if x > 10 {
                        n = n + 1;
                    }
                }
            }
        }
    }
    n
}

// too many branches: if 1, && 1, else if 1, else 1, if 1, || 1, && 1,
// match 1, while 1, if 1 + 1, else 1; five arms: 12 / 13 / 2
fn shipping(weight: Int, express: Bool, member: Bool, zone: Int) -> Int {
    let mut fee = 0;
    if weight > 1000 && !member {
        fee = fee + 500;
    } else if weight > 500 {
        fee = fee + 300;
    } else {
        fee = fee + 100;
    }
    if express || (zone > 3 && !member) {
        fee = fee * 2;
    }
    match zone {
        0 => {
            fee = fee + 0;
        }
        1 => {
            fee = fee + 50;
        }
        2 => {
            fee = fee + 100;
        }
        3 => {
            fee = fee + 150;
        }
        _ => {
            fee = fee + 300;
        }
    }
    while fee > 5000 {
        if member {
            fee = fee - 1000;
        } else {
            fee = fee - 500;
        }
    }
    fee
}

// the same as deep, allowed
#[allow(complexity, reason = "a fixture", owner = "tests", expires = "2099-01-01")]
fn deep_allowed(grid: Vec<Vec<Int>>) -> Int {
    let mut n = 0;
    for row in grid {
        for x in row {
            if x > 0 {
                if x % 2 == 0 {
                    if x > 10 {
                        n = n + 1;
                    }
                }
            }
        }
    }
    n
}

// skipped unless -tests: 15 / 6 / 5
#[test]
fn deep_test() -> Bool {
    let mut n = 0;
    for i in 0..3 {
        for j in 0..3 {
            if i > 0 {
                if j > 0 {
                    if i != j {
                        n = n + 1;
                    }
                }
            }
        }
    }
    n == 2
}
