// Fixture of `kek cover` (tests/suites/cover.sh): the tests leave a match
// arm, an if branch, a loop body, an uncalled function and a #[rare]
// function uncovered.

enum Shape {
    Circle(Int),
    Rect(Int, Int),
    Square(Int),
}

fn area(s: Shape) -> Int {
    match s {
        Shape::Circle(r) => 3 * r * r,
        Shape::Rect(w, h) => w * h,
        Shape::Square(a) => a * a,
    }
}

fn describe(n: Int) -> String {
    if n < 0 {
        return "negative";
    }
    let mut s = "large";
    if n == 0 {
        s = "zero";
    } else if n < 10 {
        s = "small";
    }
    s
}

fn total(v: Vec<Shape>) -> Int {
    let mut t = 0;
    for s in v {
        t = t + area(s);
    }
    t
}

fn unused() -> Int {
    7
}

// A path that is rarely taken: reported apart, not counted.
#[rare]
fn recover_from_disaster() -> Int {
    42
}

#[test]
fn areas() -> Bool {
    area(Shape::Rect(2, 3)) == 6 && area(Shape::Square(2)) == 4
}

#[test]
fn descriptions() -> Bool {
    describe(0) == "zero" && describe(5) == "small"
}

#[test]
fn empty_total() -> Bool {
    total(Vec::new()) == 0
}
