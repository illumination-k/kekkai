// Fixture of `kek mutate` (tests/suites/mutate.sh). The tests are
// deliberately weak in places, so that some mutants survive; deleting the
// increment of the loop in `triangle` never terminates (timeout); deleting
// `tx.commit()?;` in `deposit` is rejected by the type checker (killed by
// types).

fn clamp(x: Int, lo: Int, hi: Int) -> Int {
    if x < lo {
        return lo;
    }
    if x > hi {
        return hi;
    }
    x
}

// 1 + 2 + ... + n
fn triangle(n: Int) -> Int {
    let mut total = 0;
    let mut i = 1;
    while i <= n {
        total = total + i;
        i = i + 1;
    }
    total
}

fn is_adult(age: Int) -> Bool {
    age >= 18
}

fn deposit(db: &Db, account: String, amount: Int) -> Result<Int, TxError> {
    db.transaction(|tx| {
        let old = tx.get(account)?.unwrap_or("0").parse_int().unwrap_or(0);
        let new = old + amount;
        tx.put(account, new.to_string())?;
        tx.commit()?;
        Ok(new)
    })
}

#[test]
fn clamp_inside() -> Bool {
    clamp(5, 0, 10) == 5
}

// (no test below `lo`: mutants of the first `if` survive)
#[test]
fn clamp_above() -> Bool {
    clamp(50, 0, 10) == 10
}

#[test]
fn triangle_of_4() -> Bool {
    triangle(4) == 10
}

// (the boundary, 18, is not tested: `>=` → `>` survives)
#[test]
fn adults() -> Bool {
    is_adult(30) && !is_adult(3)
}

#[test]
fn deposits_add_up(db: &Db) -> Result<(), String> {
    match deposit(db, "alice", 5) {
        Ok(n) => if n == 5 {
            Ok(())
        } else {
            Err("balance " + n.to_string())
        },
        Err(e) => Err(e.message()),
    }
}
