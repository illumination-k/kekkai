// exit: 3
struct Tok {
    kind: String,
    text: String,
}

fn is_digit(c: Int) -> Bool {
    c >= 48 && c <= 57
}

fn is_alpha(c: Int) -> Bool {
    (c >= 97 && c <= 122) || (c >= 65 && c <= 90) || c == 95
}

// A tiny lexer: the kind of code the self-hosted compiler needs.
fn lex(src: String) -> Vec<Tok> {
    let toks = Vec::new();
    let mut i = 0;
    let n = src.len();
    while i < n {
        let c = src.char_at(i).unwrap_or(0);
        if c == 32 || c == 10 {
            i = i + 1;
        } else if is_digit(c) {
            let start = i;
            while i < n && is_digit(src.char_at(i).unwrap_or(0)) {
                i = i + 1;
            }
            toks.push(Tok { kind: "int", text: src.slice(start, i) });
        } else if is_alpha(c) {
            let start = i;
            while i < n
                && (is_alpha(src.char_at(i).unwrap_or(0)) || is_digit(src.char_at(i).unwrap_or(0))) {
                i = i + 1;
            }
            toks.push(Tok { kind: "ident", text: src.slice(start, i) });
        } else {
            toks.push(Tok { kind: "punct", text: String::from_char(c) });
            i = i + 1;
        }
    }
    toks
}

fn leb128(v: Int, out: Vec<Int>) {
    let mut x = v;
    let mut more = true;
    while more {
        let b = x.bit_and(127);
        x = x.ushr(7);
        if x == 0 {
            out.push(b);
            more = false;
        } else {
            out.push(b.bit_or(128));
        }
    }
}

#[main]
fn main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    let toks = lex("let x1 = 42 + foo;");
    let parts = Vec::new();
    for t in toks {
        parts.push(t.kind + ":" + t.text);
    }
    log.info(parts.join(" "));

    let counts: Map<String, Int> = Map::new();
    for t in toks {
        let c = counts.get(t.kind).unwrap_or(0);
        counts.insert(t.kind, c + 1);
    }
    let ks = counts.keys();
    let mut summary = "";
    for k in ks {
        summary = summary + k + "=" + counts.get(k).unwrap_or(0).to_string() + ";";
    }
    log.info(summary);

    let nested: Map<Int, Vec<String>> = Map::new();
    nested.insert(1, Vec::new());
    match nested.get(1) {
        Some(v) => {
            v.push("a");
            v.push("b");
        }
        None => {}
    }
    log.info(nested.get(1).unwrap_or(Vec::new()).join(","));

    let bytes = Vec::new();
    leb128(624485, bytes);
    let hex = Vec::new();
    for b in bytes {
        hex.push(b.to_string());
    }
    log.info(hex.join(" "));

    let mut total = 0;
    for i in 0..10 {
        total = total + i;
    }
    log.info("total " + total.to_string() + " args " + args.len().to_string());
    match bytes.pop() {
        Some(b) => log.info("popped " + b.to_string() + " left " + bytes.len().to_string()),
        None => log.info("empty"),
    }
    log.info(
        "get(-1) "
            + bytes.get(-1).is_none().to_string()
            + " set "
            + bytes.set(0, 7).to_string()
            + " "
            + bytes.get(0).unwrap_or(0).to_string(),
    );
    log.info(
        "split "
            + "a,b,,c".split(",").len().to_string()
            + " idx "
            + "hello".index_of("ll").unwrap_or(-1).to_string(),
    );

    let path = args.get(0).unwrap_or("kek_run_test.txt");
    match fs.write(path, "written by kekkai") {
        Ok(_) => {}
        Err(e) => {
            log.error(e.message());
            return 1;
        }
    }
    match fs.read(path) {
        Ok(s) => log.info("read back: " + s),
        Err(e) => {
            log.error(e.message());
            return 1;
        }
    }
    match fs.read("/nonexistent/file") {
        Ok(_) => 1,
        Err(_) => 3,
    }
}
