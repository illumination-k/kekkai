#[derive(Debug, PartialEq)]
struct Meters(Int);

#[derive(Debug)]
struct Unit;

#[derive(Debug)]
enum Sh {
    Rect { w: Int, h: Int },
    Sq(Int),
    Dot,
}

#[main]
fn main(args: Vec<String>, log: &Log) -> Int {
    log.info(
        format!(
            "{:?} {:?} {:?} {:?} {:?}",
            Meters(3),
            Unit,
            Sh::Rect { w: 1, h: 2 },
            Sh::Sq(4),
            Sh::Dot,
        ),
    );
    log.info(format!("{}", matches!(Sh::Sq(2), Sh::Sq(1..=3))));
    0
}
