// exit: 0
// Trait objects (compiler/chk_dyn.kek): `Box<dyn Trait>` in a Vec, a
// field, parameters and results; supertrait methods, default methods,
// `&mut self` methods, `dyn Display` / `dyn Debug` with format!, a generic
// trait object `dyn Iterator<Item = Int>` and upcasting.

trait Shape: Display {
    fn area(&self) -> Int;
    fn name(&self) -> String;

    fn describe(&self) -> String {
        format!("{} with area {}", self.name(), self.area())
    }
}

struct Circle {
    r: Int,
}

struct Rect {
    w: Int,
    h: Int,
}

impl Shape for Circle {
    fn area(&self) -> Int {
        3 * self.r * self.r
    }

    fn name(&self) -> String {
        "circle"
    }
}

impl Display for Circle {
    fn fmt(&self, f: &mut Formatter) {
        write!(f, "Circle(r={})", self.r);
    }
}

impl Shape for Rect {
    fn area(&self) -> Int {
        self.w * self.h
    }

    fn name(&self) -> String {
        "rect"
    }

    fn describe(&self) -> String {
        format!("a {}x{} rectangle", self.w, self.h)
    }
}

impl Display for Rect {
    fn fmt(&self, f: &mut Formatter) {
        write!(f, "Rect({}x{})", self.w, self.h);
    }
}

struct Scene {
    shapes: Vec<Box<dyn Shape>>,
    focus: Box<dyn Shape>,
}

fn total_area(shapes: &Vec<Box<dyn Shape>>) -> Int {
    let mut sum = 0;
    for s in shapes.iter() {
        sum += s.area();
    }
    sum
}

fn make(kind: Int) -> Box<dyn Shape> {
    if kind == 0 {
        Box::new(Circle { r: kind + 1 })
    } else {
        Box::new(Rect { w: kind, h: 2 })
    }
}

fn pick(kind: Int) -> Box<dyn Shape> {
    match kind {
        0 => Box::new(Rect { w: 1, h: 1 }),
        _ => Box::new(Circle { r: kind }),
    }
}

fn largest(a: &dyn Shape, b: &dyn Shape) -> String {
    if a.area() >= b.area() {
        a.to_string()
    } else {
        b.to_string()
    }
}

fn boxed<T: Shape>(x: T) -> Box<dyn Shape> {
    Box::new(x)
}

trait Counter {
    fn bump(&mut self) -> Int;
}

struct ByOne {
    mut n: Int,
}

struct ByTen {
    mut n: Int,
}

impl Counter for ByOne {
    fn bump(&mut self) -> Int {
        self.n += 1;
        self.n
    }
}

impl Counter for ByTen {
    fn bump(&mut self) -> Int {
        self.n += 10;
        self.n
    }
}

fn bump_all(cs: &mut Vec<Box<dyn Counter>>) -> Int {
    let mut last = 0;
    for mut c in cs.iter() {
        last += c.bump();
    }
    last
}

#[derive(Debug)]
struct Point {
    x: Int,
    y: Int,
}

struct Countdown {
    mut n: Int,
}

impl Iterator for Countdown {
    type Item = Int;

    fn next(&mut self) -> Option<Int> {
        if self.n == 0 {
            return None;
        }
        self.n -= 1;
        Some(self.n + 1)
    }
}

fn numbers(up: Bool) -> Box<dyn Iterator<Item = Int>> {
    if up {
        Box::new(1..4)
    } else {
        Box::new(Countdown { n: 3 })
    }
}

#[main]
fn main(log: &Log) -> Int {
    let shapes: Vec<Box<dyn Shape>> = vec![
        Box::new(Circle { r: 2 }),
        Box::new(Rect { w: 3, h: 4 }),
        make(0),
        make(5),
    ];
    log.info(format!("total {}", total_area(&shapes)));
    for s in shapes.iter() {
        log.info(format!("{}: {}", s, s.describe()));
    }
    let mut scene = Scene { shapes: Vec::new(), focus: pick(0) };
    scene.shapes.push(Box::new(Circle { r: 1 }));
    scene.shapes.push(pick(3));
    scene.shapes.push(boxed(Rect { w: 2, h: 2 }));
    log.info(format!("scene {} focus {}", total_area(&scene.shapes), scene.focus));
    log.info(largest(&Circle { r: 1 }, &Rect { w: 2, h: 5 }));
    let mut counters: Vec<Box<dyn Counter>> = Vec::new();
    counters.push(Box::new(ByOne { n: 0 }));
    counters.push(Box::new(ByTen { n: 0 }));
    bump_all(&mut counters);
    log.info(format!("bumped {}", bump_all(&mut counters)));
    let shown: Vec<Box<dyn Display>> = vec![Box::new(1), Box::new("two"), Box::new(Circle { r: 3 })];
    let mut parts = Vec::new();
    for d in shown.iter() {
        parts.push(format!("[{}]", d));
    }
    log.info(parts.join(" "));
    let dbg: Vec<Box<dyn Debug>> = vec![
        Box::new(Point { x: 1, y: 2 }),
        Box::new(Some(3)),
        Box::new(vec!["a"]),
    ];
    log.info(format!("{:?}", dbg));
    let up: Vec<Int> = numbers(true).collect();
    let down: Vec<Int> = numbers(false).map(|x| x * 10).collect();
    log.info(format!("{:?} {:?}", up, down));
    let mut it = numbers(false);
    let mut sum = 0;
    while let Some(x) = it.next() {
        sum += x;
    }
    log.info(format!("sum {}", sum));
    let as_display: Box<dyn Display> = make(1);
    log.info(format!("upcast {}", as_display));
    0
}
