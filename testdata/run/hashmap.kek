#[derive(PartialEq, Eq, PartialOrd, Ord, Hash)]
enum Color {
    Red,
    Green,
    Rgb(Int, Int, Int),
}

#[main]
fn main(log: &Log) -> Int {
    let mut m: HashMap<String, Int> = HashMap::new();
    log.info(m.insert("a", 1).is_none().to_string());
    m.insert("b", 2);
    m.insert("c", 3);
    log.info(m.insert("a", 10).unwrap_or(-1).to_string() + " " + m.len().to_string());
    log.info(m.get(&"a").unwrap_or(0).to_string() + " " + m.get(&"z").is_none().to_string());
    log.info(
        m.remove(&"b").unwrap_or(0).to_string()
            + " "
            + m.contains_key(&"b").to_string()
            + " "
            + m.len().to_string(),
    );
    m.insert("d", 4);
    let keys: Vec<String> = m.keys().collect();
    log.info(keys.join(","));
    let mut total = 0;
    for (k, v) in m.iter() {
        total = total + v;
    }
    log.info(total.to_string());
    // composite keys
    let mut pm: HashMap<(Int, String), Color> = HashMap::new();
    pm.insert((1, "x"), Color::Red);
    pm.insert((2, "y"), Color::Rgb(1, 2, 3));
    log.info(
        (pm.get(&(2, "y")) == Some(Color::Rgb(1, 2, 3))).to_string()
            + " "
            + pm.contains_key(&(1, "y")).to_string(),
    );
    let mut cm: HashMap<Color, Int> = HashMap::new();
    cm.insert(Color::Green, 7);
    cm.insert(Color::Rgb(0, 0, 0), 8);
    log.info(cm.get(&Color::Rgb(0, 0, 0)).unwrap_or(0).to_string());
    // many entries, removals, growth
    let mut big: HashMap<Int, Int> = HashMap::new();
    for i in 0..2000 {
        big.insert(i * 7919 % 10007, i);
    }
    for i in 0..1000 {
        big.remove(&(i * 7919 % 10007));
    }
    let mut ok = true;
    for i in 1000..2000 {
        if big.get(&(i * 7919 % 10007)) != Some(i) {
            ok = false;
        }
    }
    log.info(big.len().to_string() + " " + ok.to_string());
    // live view: insert while iterating
    let mut lv: HashMap<Int, Int> = HashMap::new();
    lv.insert(1, 1);
    let mut seen = 0;
    for (k, v) in lv.iter() {
        seen = seen + 1;
        if k < 5 {
            lv.insert(k + 1, v);
        }
    }
    log.info(seen.to_string());
    // sets
    let mut s: HashSet<String> = HashSet::new();
    log.info(
        s.insert("x").to_string() + " " + s.insert("x").to_string() + " " + s.len().to_string(),
    );
    let t: HashSet<String> = vec_of("x y z").into_iter().collect();
    log.info(
        t.len().to_string()
            + " "
            + t.intersection(&s).len().to_string()
            + " "
            + t.difference(&s).len().to_string(),
    );
    let mut counts: HashMap<String, Int> = HashMap::new();
    for w in vec_of("a b a c b a") {
        counts.insert(w, counts.get_or(&w, 0) + 1);
    }
    let pairs: Vec<String> = counts.iter().map(|p| p.0 + "=" + p.1.to_string()).collect();
    log.info(pairs.join(" "));
    0
}

fn vec_of(s: String) -> Vec<String> {
    s.split(" ")
}
