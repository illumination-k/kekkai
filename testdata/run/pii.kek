// exit: 0
// Personal data: Pii values leave only through mask, hash and
// expose_unchecked.

#[derive(PartialEq, Eq)]
struct Customer {
    id: Int,
    email: Pii<String>,
}

fn label(c: Customer) -> String {
    "#" + c.id.to_string() + " " + c.email.mask()
}

#[main]
fn main(log: &Log) -> Int {
    let mut inputs = Vec::new();
    inputs.push("alice@example.com");
    inputs.push("bob");
    inputs.push("a@x.com");
    inputs.push("x");
    inputs.push("");
    inputs.push("@example.com");
    inputs.push("日本@例え.jp");
    inputs.push("😀ab@c.d");
    inputs.push("a@b@c.com");
    for s in inputs {
        let p = Pii::new(s);
        log.info("[" + p.mask() + "] " + p.hash());
    }
    // the hash is fixed: equal values have equal hashes
    let a = Pii::new("alice@example.com");
    let b = Pii::new("alice@example.com");
    let c = Pii::new("carol@example.com");
    log.info((a == b).to_string() + " " + (a == c).to_string() + " " + (a != c).to_string());
    log.info((a.hash() == b.hash()).to_string() + " " + (a.hash() == c.hash()).to_string());
    log.info(Pii::new(42).hash() + " " + Pii::new(7).hash() + " " + Pii::new(0).hash());
    // derived equality compares the Pii fields
    let x = Customer { id: 1, email: a };
    let y = Customer { id: 1, email: b };
    let z = Customer { id: 1, email: c };
    log.info((x == y).to_string() + " " + (x == z).to_string());
    log.info(label(x));
    // in collections, keyed by the hash
    let mut seen: HashMap<String, Int> = HashMap::new();
    for p in vec_of(a, b, c) {
        let k = p.hash();
        seen.insert(k, seen.get_or(&k, 0) + 1);
    }
    log.info(seen.len().to_string() + " distinct");
    let raw: String = c.expose_unchecked();
    log.info(raw.len().to_string());
    0
}

fn vec_of(a: Pii<String>, b: Pii<String>, c: Pii<String>) -> Vec<Pii<String>> {
    let mut v = Vec::new();
    v.push(a);
    v.push(b);
    v.push(c);
    v
}
