// exit: 0
enum Expr {
    Num(Int),
    Add(Expr, Expr),
    Mul(Expr, Expr),
    Neg(Expr),
}

struct Env {
    names: Vec<String>,
    exprs: HashMap<String, Expr>,
}

fn eval(e: Expr) -> Int {
    match e {
        Expr::Num(n) => n,
        Expr::Add(a, b) => eval(a) + eval(b),
        Expr::Mul(a, b) => eval(a) * eval(b),
        Expr::Neg(a) => -eval(a),
    }
}

fn show(e: Expr) -> String {
    match e {
        Expr::Num(n) => n.to_string(),
        Expr::Add(a, b) => "(" + show(a) + " + " + show(b) + ")",
        Expr::Mul(a, b) => show(a) + " * " + show(b),
        Expr::Neg(a) => "-" + show(a),
    }
}

fn build(n: Int) -> Expr {
    if n == 0 {
        Expr::Num(1)
    } else {
        Expr::Add(build(n - 1), Expr::Mul(Expr::Num(n), Expr::Neg(Expr::Num(2))))
    }
}

#[main]
fn main(log: &Log) -> Int {
    let mut env = Env { names: Vec::new(), exprs: HashMap::new() };
    env.exprs.insert("e", build(3));
    env.names.push("e");
    for n in env.names {
        match env.exprs.get(n) {
            Some(e) => log.info(n + " = " + show(e) + " = " + eval(e).to_string()),
            None => {}
        }
    }
    0
}
