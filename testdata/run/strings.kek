// exit: 0
// String literals that need escaping in JSON (IR and program metadata).
#[main]
fn main(log: &Log) -> Int {
    let mut xs = Vec::new();
    xs.push("<tag> & \"quoted\" \\ back");
    xs.push("tab\tnl\ncr\rnul\0end");
    xs.push("café 漢字 😀");
    xs.push("sep line para");
    xs.push(String::from_char(8) + String::from_char(12) + String::from_char(31));
    let mut total = 0;
    for x in xs {
        total = total + x.len();
    }
    log.info("strings " + xs.len().to_string() + " units " + total.to_string());
    log.info(xs.get(0).unwrap_or(""));
    log.info(xs.get(2).unwrap_or(""));
    0
}
