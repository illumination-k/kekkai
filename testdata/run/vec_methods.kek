// Vec methods of core (lib/core/vec.kek): out of range never traps.
fn show(v: &Vec<Int>) -> String {
    let parts: Vec<String> = v.iter().map(|x| x.to_string()).collect();
    "[" + parts.join(",") + "]"
}

fn show_all(vs: &Vec<Vec<Int>>) -> String {
    let parts: Vec<String> = vs.iter().map(|v| show(v)).collect();
    parts.join(" ")
}

fn ints(n: Int) -> Vec<Int> {
    (0..n).collect()
}

fn of(s: String) -> Vec<Int> {
    s.split(" ").iter().map(|w| w.parse_int().unwrap_or(0)).collect()
}

fn opt(o: Option<Int>) -> String {
    match o {
        Some(x) => "Some(" + x.to_string() + ")",
        None => "None",
    }
}

fn res(r: Result<Int, Int>) -> String {
    match r {
        Ok(x) => "Ok(" + x.to_string() + ")",
        Err(x) => "Err(" + x.to_string() + ")",
    }
}

#[derive(Clone)]
struct Person {
    name: String,
    age: Int,
}

#[main]
fn main(log: &Log) -> Int {
    // is_empty, first, last
    let e: Vec<Int> = Vec::with_capacity(10);
    log.info(
        e.is_empty().to_string()
            + " "
            + opt(e.first())
            + " "
            + opt(e.last())
            + " "
            + opt(ints(3).last()),
    );

    // insert (clamped), remove, swap_remove, swap
    let mut v = ints(3);
    v.insert(1, 9);
    v.insert(-5, 7);
    v.insert(100, 8);
    log.info("insert " + show(&v));
    log.info(
        "remove "
            + opt(v.remove(0))
            + " "
            + opt(v.remove(10))
            + " "
            + opt(v.remove(-1))
            + " "
            + show(&v),
    );
    log.info("swap_remove " + opt(v.swap_remove(0)) + " " + show(&v));
    v.swap(0, 3);
    v.swap(0, 9);
    log.info("swap " + show(&v));

    // reverse, truncate, clear
    let mut r = ints(5);
    r.reverse();
    let mut r2 = ints(4);
    r2.reverse();
    let mut r0: Vec<Int> = Vec::new();
    r0.reverse();
    log.info("reverse " + show(&r) + " " + show(&r2) + " " + show(&r0));
    r.truncate(10);
    log.info("truncate " + show(&r));
    r.truncate(2);
    log.info("truncate " + show(&r));
    r.truncate(-1);
    log.info("truncate " + show(&r));
    r2.clear();
    log.info("clear " + show(&r2) + " " + r2.len().to_string());

    // extend, extend_from_slice, append
    let mut a = ints(2);
    a.extend(5..7);
    a.extend_from_slice(&ints(2));
    let mut b = ints(3);
    a.append(&mut b);
    log.info("extend " + show(&a) + " " + show(&b));

    // split_off, slice
    let mut s = ints(5);
    let tail = s.split_off(3);
    log.info(
        "split_off " + show(&s) + " " + show(&tail) + " " + show(&s.split_off(9)) + " " + show(&s),
    );
    log.info(
        "slice "
            + show(&ints(5).slice(1, 3))
            + " "
            + show(&ints(5).slice(-2, 99))
            + " "
            + show(&ints(5).slice(4, 2)),
    );

    // retain, dedup
    let mut t = ints(10);
    t.retain(|x| x % 3 == 0);
    log.info("retain " + show(&t));
    let mut d = of("1 1 2 2 2 3 1 1");
    d.dedup();
    log.info("dedup " + show(&d));
    let mut dk = ints(10);
    dk.dedup_by_key(|x| x / 4);
    log.info("dedup_by_key " + show(&dk));

    // sort, sort_by, sort_by_key (stable)
    let u = of("5 -3 9 0 2 2 -8 7 1 4 6");
    let mut u1 = u.clone();
    u1.sort();
    log.info("sort " + show(&u1));
    let mut u2 = u.clone();
    u2.sort_by(|a, b| b.cmp(a));
    log.info("sort_by " + show(&u2));
    let mut u3 = u.clone();
    u3.sort_by_key(|x| x.abs());
    log.info("sort_by_key " + show(&u3));
    let mut people = Vec::new();
    people.push(Person { name: "ann", age: 30 });
    people.push(Person { name: "bob", age: 25 });
    people.push(Person { name: "cid", age: 30 });
    people.push(Person { name: "dan", age: 25 });
    people.sort_by_key(|p| p.age);
    let names: Vec<String> = people.iter().map(|p| p.name).collect();
    log.info("stable " + names.join(","));
    let mut big: Vec<Int> = (0..100).map(|i| i * 37 % 101).collect();
    big.sort_unstable();
    let sorted = big.windows(2).iter().all(|w| w.first().unwrap_or(0) <= w.last().unwrap_or(0));
    log.info("sort 100 " + sorted.to_string() + " " + opt(big.first()) + " " + opt(big.last()));

    // binary_search, partition_point
    log.info(
        "binary_search "
            + res(u1.binary_search(&4))
            + " "
            + res(u1.binary_search(&3))
            + " "
            + res(u1.binary_search(&-100))
            + " "
            + res(u1.binary_search(&100))
            + " "
            + res(e.binary_search(&1)),
    );
    log.info("partition_point " + u1.partition_point(|x| x < 2).to_string());

    // contains, starts_with, ends_with
    log.info(
        "contains "
            + u.contains(&9).to_string()
            + " "
            + u.contains(&10).to_string()
            + " "
            + ints(4).starts_with(&ints(2)).to_string()
            + " "
            + ints(4).starts_with(&ints(5)).to_string()
            + " "
            + ints(4).ends_with(&ints(4).slice(2, 4)).to_string()
            + " "
            + ints(4).ends_with(&e).to_string(),
    );

    // chunks, windows, concat
    log.info("chunks " + show_all(&ints(7).chunks(3)) + " | " + show_all(&ints(3).chunks(0)));
    log.info("windows " + show_all(&ints(4).windows(2)) + " | " + show_all(&ints(2).windows(3)));
    log.info("concat " + show(&ints(5).chunks(2).concat()));

    // fill, resize, repeat, rotate
    let mut f = ints(3);
    f.fill(7);
    log.info("fill " + show(&f));
    f.resize(5, 1);
    log.info("resize " + show(&f));
    f.resize(1, 0);
    log.info(
        "resize "
            + show(&f)
            + " repeat "
            + show(&ints(2).repeat(3))
            + " "
            + show(&ints(2).repeat(-1)),
    );
    let mut ro = ints(5);
    ro.rotate_left(2);
    log.info("rotate_left " + show(&ro));
    ro.rotate_right(7);
    log.info("rotate_right " + show(&ro));
    0
}
// exit: 0
