// An older version of basic.kek, the base of `kek similar -base`
// (tests/suites/similar.sh): findings among these definitions alone are
// not reported against basic.kek.

struct Point {
    x: Int,
    y: Int,
}

fn sum_positive(v: Vec<Int>) -> Int {
    let mut total = 0;
    for x in v {
        if x > 0 {
            total = total + x;
        }
    }
    total
}

fn add_up_positive(items: Vec<Int>) -> Int {
    let mut acc = 0;
    for it in items {
        if it > 0 {
            acc = acc + it;
        }
    }
    acc
}

fn shipping_fee(weight: Int) -> Int {
    if weight > 1000 {
        return weight / 100 * 3 + 500;
    }
    500
}

fn describe(p: Point) -> String {
    let xs = p.x.to_string();
    let ys = p.y.to_string();
    let mut parts = Vec::new();
    parts.push(xs);
    parts.push(ys);
    "(" + parts.join(", ") + ")"
}

fn describe_point(p: Point) -> String {
    let a = p.x.to_string();
    let b = p.y.to_string();
    let mut parts = Vec::new();
    parts.push(a);
    parts.push(b);
    parts.push("z");
    "(" + parts.join(", ") + ")"
}
