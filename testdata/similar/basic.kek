// Fixtures of `kek similar` (tests/suites/similar.sh).

#[derive(PartialEq, Eq, Hash)]
struct Point {
    x: Int,
    y: Int,
}

#[derive(PartialEq, Eq, Hash)]
struct Size {
    w: Int,
    h: Int,
}

// duplicate: the same code up to the names of the function and locals
fn sum_positive(v: Vec<Int>) -> Int {
    let mut total = 0;
    for x in v {
        if x > 0 {
            total = total + x;
        }
    }
    total
}

fn add_up_positive(items: Vec<Int>) -> Int {
    let mut acc = 0;
    for it in items {
        if it > 0 {
            acc = acc + it;
        }
    }
    acc
}

// literals: only the constants differ
fn shipping_fee(weight: Int) -> Int {
    if weight > 1000 {
        return weight / 100 * 3 + 500;
    }
    500
}

fn express_fee(weight: Int) -> Int {
    if weight > 2000 {
        return weight / 100 * 3 + 800;
    }
    800
}

// structural: one extra statement
fn describe(p: Point) -> String {
    let xs = p.x.to_string();
    let ys = p.y.to_string();
    let mut parts = Vec::new();
    parts.push(xs);
    parts.push(ys);
    "(" + parts.join(", ") + ")"
}

fn describe_point(p: Point) -> String {
    let a = p.x.to_string();
    let b = p.y.to_string();
    let mut parts = Vec::new();
    parts.push(a);
    parts.push(b);
    parts.push("z");
    "(" + parts.join(", ") + ")"
}

// different signature: only compared with -all
fn describe_size(s: Size) -> String {
    let a = s.w.to_string();
    let b = s.h.to_string();
    let mut parts = Vec::new();
    parts.push(a);
    parts.push(b);
    "(" + parts.join(", ") + ")"
}

// too small to compare (min_nodes)
fn twice(x: Int) -> Int {
    x * 2
}

fn double(y: Int) -> Int {
    y * 2
}

// intentional duplicates
#[allow(similar, reason = "kept apart on purpose", owner = "billing", expires = "2027-01-01")]
fn count_even(v: Vec<Int>) -> Int {
    let mut n = 0;
    for x in v {
        if x % 2 == 0 {
            n = n + 1;
        }
    }
    n
}

fn tally_even(v: Vec<Int>) -> Int {
    let mut c = 0;
    for y in v {
        if y % 2 == 0 {
            c = c + 1;
        }
    }
    c
}

#[test]
fn test_sum() -> Bool {
    let mut v = Vec::new();
    v.push(1);
    v.push(-2);
    v.push(3);
    sum_positive(v) == 4
}

#[test]
fn test_add_up() -> Bool {
    let mut w = Vec::new();
    w.push(1);
    w.push(-2);
    w.push(3);
    add_up_positive(w) == 4
}
