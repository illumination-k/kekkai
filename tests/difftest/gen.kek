// Random well-typed Kekkai programs for differential testing (WasmGC vs the
// Lean reference interpreter of the IR, see docs/design.md §検証戦略) and
// for the round trips of `kek fmt`.
//
//   ./kek run tests/difftest/gen.kek <out-dir> <first-seed> [count]
//
// For every seed S in [first-seed, first-seed + count) (count defaults to
// 1) it writes, into the existing directory <out-dir>/seedS:
//   prog.kek   the generated pure functions f0..fn: (a: Int, b: Int, c: Bool) -> Int
//   main.kek   a #[main] driver that calls every function on a fixed list of
//              argument sets and prints one line per call:
//              `f1(7, 3, true) = 42`
//   calls.txt  the same calls, one per line: `f1 7 3 true` (the arguments
//              are JSON values, ready for kekkai-ref)
//
// Generation is driven by a seeded PRNG (splitmix64), so a seed always
// gives the same program.
//
// Programs exercise arithmetic edge cases (also Float: IEEE operations,
// NaN, signed zeros, saturating conversions, the bit patterns and the
// shortest round-trip text), control flow, early returns,
// enums, Option, `?`, loops, string host operations, Vec/Map collections,
// `for` loops with break/continue and mutable structs shared through
// aliases. Function i may only call functions j < i, loops are bounded
// (`while` and `for` over ranges with small constant trip counts; `for`
// over a Vec never pushes in its body), so every program terminates.
// Collections and structs are always bound with `let mut` (any alias may
// be mutated later; docs/mutability.md).

// Variable types.
fn t_int() -> Int {
    0
}

fn t_bool() -> Int {
    1
}

fn t_vec() -> Int {
    2
}

fn t_mapi() -> Int {
    3
}

fn t_maps() -> Int {
    4
}

fn t_acc() -> Int {
    5
}

// A variable in scope of the generated code.
struct Var {
    name: String,
    ty: Int,
    mutable: Bool,
}

struct Gen {
    // PRNG state
    mut state: Int,
    out: Vec<String>,
    vars: Vec<Var>,
    mut fresh: Int,
    // loop nesting depth of the statement being generated
    mut loops: Int,
    // inside `for x in vec`: no pushes (the loop re-reads the length)
    mut no_push: Bool,
    // labels of the enclosing `for` loops ("" for an unlabeled one)
    labels: Vec<String>,
}

// ---- random source ----

fn next_u64(mut g: Gen) -> Int {
    g.state = g.state + -7046029254386353131;
    let mut z = g.state;
    z = z.bit_xor(z.ushr(30)) * -4658895280553007687;
    z = z.bit_xor(z.ushr(27)) * -7723592293110705685;
    z.bit_xor(z.ushr(31))
}

// intn returns a uniform-enough integer in [0, n).
fn intn(g: Gen, n: Int) -> Int {
    next_u64(g).ushr(1) % n
}

// pick returns one of the `~`-separated alternatives.
fn pick(g: Gen, alts: String) -> String {
    let xs = alts.split("~");
    xs.get(intn(g, xs.len())).unwrap_or("")
}

fn new_gen(seed: Int) -> Gen {
    let g = Gen {
        state: seed * 1000003,
        out: Vec::new(),
        vars: Vec::new(),
        fresh: 0,
        loops: 0,
        no_push: false,
        labels: Vec::new(),
    };
    // warm up
    for i in 0..4 {
        next_u64(g);
    }
    g
}

// ---- output and scopes ----

fn w(mut g: Gen, s: String) {
    g.out.push(s);
}

fn ln(mut g: Gen, s: String) {
    g.out.push(s + "\n");
}

fn fresh(mut g: Gen, prefix: String) -> String {
    g.fresh = g.fresh + 1;
    prefix + g.fresh.to_string()
}

fn declare(mut g: Gen, ty: Int, prefix: String, mutable: Bool) -> String {
    let v = fresh(g, prefix);
    g.vars.push(Var { name: v, ty: ty, mutable: mutable });
    v
}

fn add_var(mut g: Gen, name: String, ty: Int, mutable: Bool) {
    g.vars.push(Var { name: name, ty: ty, mutable: mutable });
}

// truncate drops the variables declared after the first n.
fn truncate(mut g: Gen, n: Int) {
    while g.vars.len() > n {
        g.vars.pop();
    }
}

fn count_vars(g: Gen, ty: Int, mut_only: Bool) -> Int {
    let mut n = 0;
    for v in g.vars {
        if v.ty == ty && (v.mutable || !mut_only) {
            n = n + 1;
        }
    }
    n
}

// pick_var returns the name of a random variable of type ty ("" if none).
fn pick_var(g: Gen, ty: Int, mut_only: Bool) -> String {
    let n = count_vars(g, ty, mut_only);
    if n == 0 {
        return "";
    }
    let mut k = intn(g, n);
    for v in g.vars {
        if v.ty == ty && (v.mutable || !mut_only) {
            if k == 0 {
                return v.name;
            }
            k = k - 1;
        }
    }
    ""
}

// ---- the fixed part of every program ----

fn prelude(g: Gen) {
    ln(g, "enum Shape {");
    ln(g, "    Dot,");
    ln(g, "    Line(Int),");
    ln(g, "    Rect(Int, Int),");
    ln(g, "    Flag(Bool, Int),");
    ln(g, "}");
    ln(g, "");
    ln(g, "fn half(x: Int) -> Option<Int> {");
    ln(g, "    if x % 2 == 0 { Some(x / 2) } else { None }");
    ln(g, "}");
    ln(g, "");
    ln(g, "fn quarter(x: Int) -> Option<Int> {");
    ln(g, "    let h = half(x)?;");
    ln(g, "    half(h)");
    ln(g, "}");
    ln(g, "");
    ln(g, "fn area(s: Shape) -> Int {");
    ln(g, "    match s {");
    ln(g, "        Shape::Dot => 0,");
    ln(g, "        Shape::Line(n) => n,");
    ln(g, "        Shape::Rect(w, h) => w * h,");
    ln(g, "        Shape::Flag(true, n) => n,");
    ln(g, "        Shape::Flag(false, _) => -1,");
    ln(g, "    }");
    ln(g, "}");
    ln(g, "");
    ln(g, "struct Acc {");
    ln(g, "    mut total: Int,");
    ln(g, "    mut hits: Int,");
    ln(g, "    log: Vec<Int>,");
    ln(g, "}");
    ln(g, "");
    ln(g, "// mutates its argument: visible through every alias of acc");
    ln(g, "fn bump(mut acc: Acc, x: Int) {");
    ln(g, "    acc.total = acc.total + x;");
    ln(g, "    acc.hits = acc.hits + 1;");
    ln(g, "    acc.log.push(x);");
    ln(g, "}");
    ln(g, "");
    ln(g, "fn vsum(v: Vec<Int>) -> Int {");
    ln(g, "    let mut s = 0;");
    ln(g, "    for x in v {");
    ln(g, "        s = s * 3 + x;");
    ln(g, "    }");
    ln(g, "    s");
    ln(g, "}");
    ln(g, "");
    ln(g, "fn mfold(m: HashMap<Int, Int>) -> Int {");
    ln(g, "    let mut s = 0;");
    ln(g, "    for k in m.keys() {");
    ln(g, "        s = s * 31 + k * 7 + m.get(&k).unwrap_or(0);");
    ln(g, "    }");
    ln(g, "    s");
    ln(g, "}");
    ln(g, "");
    ln(g, "fn sfold(m: HashMap<String, Int>) -> Int {");
    ln(g, "    let mut s = 0;");
    ln(g, "    for k in m.keys() {");
    ln(g, "        s = s * 31 + hash(k) + m.get(&k).unwrap_or(0);");
    ln(g, "    }");
    ln(g, "    s");
    ln(g, "}");
    ln(g, "");
    ln(g, "fn hash(s: String) -> Int {");
    ln(g, "    let mut h = 7;");
    ln(g, "    for b in s.to_bytes() {");
    ln(g, "        h = h * 31 + b;");
    ln(g, "    }");
    ln(g, "    h");
    ln(g, "}");
    ln(g, "");
}

fn interesting(g: Gen) -> String {
    pick(
        g,
        "0~1~2~3~7~10~100~255~65536~2147483647~4294967296~9223372036854775807~(-9223372036854775807 - 1)~0xff~0b1010~1_000~0x7fff_ffff_ffff_ffff~'a'~(!0)",
    )
}

fn str_lit(g: Gen) -> String {
    pick(
        g,
        "\"\"~\",\"~\"a\"~\"ab\"~\"a,b,,c\"~\"  x y  \"~\"12\"~\"-7\"~\"hello\"~\"9223372036854775808\"~\"Hi, There\"~\"café\"",
    )
}

// ---- functions and statements ----

fn gen_fn(mut g: Gen, idx: Int) {
    truncate(g, 0);
    add_var(g, "a", t_int(), false);
    add_var(g, "b", t_int(), false);
    add_var(g, "c", t_bool(), false);
    g.loops = 0;
    g.no_push = false;
    ln(g, "fn f" + idx.to_string() + "(a: Int, b: Int, c: Bool) -> Int {");
    let n = 1 + intn(g, 7);
    for i in 0..n {
        stmt(g, idx, "    ");
    }
    ln(g, "    " + int_expr(g, idx, 3));
    ln(g, "}");
    ln(g, "");
}

fn stmt(g: Gen, idx: Int, ind: String) {
    let k = intn(g, 19);
    if k == 18 {
        // early return
        let cond = bool_expr(g, idx, 2);
        ln(g, ind + "if " + cond + " {");
        ln(g, ind + "    return " + int_expr(g, idx, 2) + ";");
        ln(g, ind + "}");
        return;
    }
    if k >= 5 {
        // 0..9 are collection statements; 10..12 favour mutating existing ones
        let mut c = k - 5;
        if c == 10 {
            c = 1;
        } else if c == 11 {
            c = 3;
        } else if c == 12 {
            c = 5;
        }
        coll_stmt(g, idx, ind, c);
        return;
    }
    if k <= 1 {
        let e = int_expr(g, idx, 3);
        let v = declare(g, t_int(), "x", false);
        ln(g, ind + "let " + v + " = " + e + ";");
    } else if k == 2 {
        let e = bool_expr(g, idx, 2);
        let v = declare(g, t_bool(), "p", false);
        ln(g, ind + "let " + v + " = " + e + ";");
    } else if k == 3 {
        // bounded loop accumulating into a mutable variable
        let init = int_expr(g, idx, 2);
        let acc = fresh(g, "acc");
        let i = fresh(g, "i");
        ln(g, ind + "let mut " + acc + " = " + init + ";");
        ln(g, ind + "let mut " + i + " = 0;");
        let saved = g.vars.len();
        add_var(g, acc, t_int(), true);
        let n = (1 + intn(g, 6)).to_string();
        let form = intn(g, 3);
        if form == 2 {
            // `loop` as an expression: `break value`
            ln(g, ind + acc + " = loop {");
            ln(g, ind + "    if " + i + " >= " + n + " {");
            ln(g, ind + "        break " + int_expr(g, idx, 2) + ";");
            ln(g, ind + "    }");
            ln(g, ind + "    " + acc + " = " + int_expr(g, idx, 2) + ";");
            ln(g, ind + "    " + i + " += 1;");
            ln(g, ind + "};");
            truncate(g, saved);
            add_var(g, acc, t_int(), true);
            return;
        }
        if form == 0 {
            ln(g, ind + "while " + i + " < " + n + " {");
        } else {
            ln(g, ind + "loop {");
            ln(g, ind + "    if " + i + " >= " + n + " {");
            ln(g, ind + "        break;");
            ln(g, ind + "    }");
        }
        ln(g, ind + "    " + acc + " = " + int_expr(g, idx, 2) + ";");
        ln(g, ind + "    " + i + " += 1;");
        ln(g, ind + "}");
        truncate(g, saved);
        add_var(g, acc, t_int(), true);
    } else {
        let m = pick_var(g, t_int(), true);
        let e = int_expr(g, idx, 2);
        if m != "" {
            if intn(g, 3) == 0 {
                ln(g, ind + m + " " + pick(g, "+~-~*~/~%~&~|~^~<<~>>") + "= " + e + ";");
            } else {
                ln(g, ind + m + " = " + e + ";");
            }
        } else {
            let v = declare(g, t_int(), "m", true);
            ln(g, ind + "let mut " + v + " = " + e + ";");
        }
    }
}

fn int_leaf(g: Gen) -> String {
    let n = count_vars(g, t_int(), false);
    if n > 0 && intn(g, 3) > 0 {
        return pick_var(g, t_int(), false);
    }
    interesting(g)
}

fn bool_leaf(g: Gen) -> String {
    let n = count_vars(g, t_bool(), false);
    if n > 0 && intn(g, 2) == 0 {
        return pick_var(g, t_bool(), false);
    }
    pick(g, "true~false")
}

fn paren(a: String, op: String, b: String) -> String {
    "(" + a + " " + op + " " + b + ")"
}

fn int_expr(g: Gen, idx: Int, d: Int) -> String {
    if d <= 0 {
        return int_leaf(g);
    }
    let k = intn(g, 24);
    if k >= 22 {
        return float_to_int(g, idx, d - 1);
    }
    if k >= 14 {
        return coll_int_expr(g, idx, d, k - 14);
    }
    match k {
        0 => int_leaf(g),
        1 => int_leaf(g),
        2 => paren(
            int_expr(g, idx, d - 1),
            pick(g, "+~-~*~/~%~+~-~&~|~^~<<~>>"),
            int_expr(g, idx, d - 1),
        ),
        3 => paren(
            int_expr(g, idx, d - 1),
            pick(g, "+~-~*~/~%~+~-~&~|~^~<<~>>"),
            int_expr(g, idx, d - 1),
        ),
        4 => paren(
            int_expr(g, idx, d - 1),
            pick(g, "+~-~*~/~%~+~-~&~|~^~<<~>>"),
            int_expr(g, idx, d - 1),
        ),
        5 => "(-" + int_expr(g, idx, d - 1) + ")",
        6 => {
            let c = bool_expr(g, idx, d - 1);
            let t = int_expr(g, idx, d - 1);
            "(if " + c + " { " + t + " } else { " + int_expr(g, idx, d - 1) + " })"
        }
        7 => {
            if idx == 0 {
                return int_leaf(g);
            }
            let callee = intn(g, idx);
            let x = int_expr(g, idx, d - 1);
            let y = int_expr(g, idx, d - 1);
            "f" + callee.to_string() + "(" + x + ", " + y + ", " + bool_expr(g, idx, d - 1) + ")"
        }
        8 => {
            let y = fresh(g, "y");
            let e = int_expr(g, idx, d - 1);
            let l = int_leaf(g);
            "(match quarter("
                + e
                + ") { Some("
                + y
                + ") => "
                + y
                + " + "
                + l
                + ", None => "
                + int_expr(g, idx, d - 1)
                + " })"
        }
        9 => "area(" + shape(g, idx, d - 1) + ")",
        10 => int_expr(g, idx, d - 1) + ".to_string().len()",
        11 => int_expr(g, idx, d - 1) + ".abs()",
        12 => {
            let e = int_expr(g, idx, d - 1);
            let l0 = int_leaf(g);
            let l1 = int_leaf(g);
            "(match "
                + e
                + " { 0 => "
                + l0
                + ", 1 => "
                + l1
                + ", _ => "
                + int_expr(g, idx, d - 1)
                + " })"
        }
        _ => {
            let z = fresh(g, "z");
            "{ let " + z + " = " + int_expr(g, idx, d - 1) + "; " + z + " * 2 - " + z + " }"
        }
    }
}

// ---- Float ----
//
// Float values reach the Int results through the bit pattern (NaN is
// canonical), saturating conversions, comparisons and the shortest
// round-trip text (Display / Debug / `{:.n}`, computed by the core
// library on both sides).

fn float_to_int(g: Gen, idx: Int, d: Int) -> String {
    let x = float_expr(g, idx, d);
    match intn(g, 9) {
        0 => x + ".to_bits()",
        1 => x + ".to_bits()",
        2 => x + ".trunc_to_int()",
        3 => x + ".round_to_int()",
        4 => "(if "
            + x
            + " "
            + pick(g, "<~<=~>~>=~==~!=")
            + " "
            + float_expr(g, idx, d)
            + " { 1 } else { 0 })",
        // (text of moderate values only: the exact algorithms take up to
        // 150k reference steps for the extremes, and calls may loop)
        5 => float_tame(g, idx) + ".to_string().len()",
        6 => "format!(\"{:?}\", " + float_tame(g, idx) + ").len()",
        7 => "format!(\"{:." + intn(g, 4).to_string() + "}\", " + float_tame(g, idx) + ").len()",
        _ => "(match "
            + float_tame(g, idx)
            + ".to_string().parse_float() { Some(y) => y.to_bits(), None => -1 })",
    }
}

// float_tame is a Float of moderate magnitude (or 0, NaN, ±inf).
fn float_tame(g: Gen, idx: Int) -> String {
    if intn(g, 2) == 0 {
        return "(("
            + int_leaf(g)
            + " % 100000).to_float() / "
            + pick(g, "8.0~3.0~10.0~0.0~-7.0")
            + ")";
    }
    pick(g, "0.1~(-0.0)~1e15~1e16~1.5e-5~123.456~(1.0 / 3.0)~Float::NAN~Float::NEG_INFINITY~2.5")
}

fn float_leaf(g: Gen, idx: Int) -> String {
    if intn(g, 2) == 0 {
        return int_leaf(g) + ".to_float()";
    }
    pick(
        g,
        "0.0~(-0.0)~1.0~0.5~(-2.5)~0.1~1e300~(-1e-300)~3.0e-5~1e16~123.456~5e-324~Float::INFINITY~Float::NAN~Float::MAX~Float::EPSILON~1_000.25",
    )
}

fn float_expr(g: Gen, idx: Int, d: Int) -> String {
    if d <= 0 {
        return float_leaf(g, idx);
    }
    match intn(g, 9) {
        0 => float_leaf(g, idx),
        1 => paren(float_expr(g, idx, d - 1), pick(g, "+~-~*~/~%~+~*"), float_expr(g, idx, d - 1)),
        2 => paren(float_expr(g, idx, d - 1), pick(g, "+~-~*~/~%~-~/"), float_expr(g, idx, d - 1)),
        3 => "(-" + float_expr(g, idx, d - 1) + ")",
        4 => float_expr(g, idx, d - 1)
            + "."
            + pick(g, "sqrt~floor~ceil~trunc~abs~round~signum~fract")
            + "()",
        5 => {
            let a = float_expr(g, idx, d - 1);
            a + "." + pick(g, "min~max~copysign~hypot") + "(" + float_expr(g, idx, d - 1) + ")"
        }
        6 => float_expr(g, idx, d - 1) + ".powi(" + intn(g, 7).to_string() + " - 3)",
        7 => {
            let c = bool_expr(g, idx, d - 1);
            let t = float_expr(g, idx, d - 1);
            "(if " + c + " { " + t + " } else { " + float_expr(g, idx, d - 1) + " })"
        }
        _ => "Float::from_int(" + int_expr(g, idx, d - 1) + ")",
    }
}

fn shape(g: Gen, idx: Int, d: Int) -> String {
    match intn(g, 4) {
        0 => "Shape::Dot",
        1 => "Shape::Line(" + int_expr(g, idx, d) + ")",
        2 => {
            let x = int_expr(g, idx, d);
            "Shape::Rect(" + x + ", " + int_expr(g, idx, d) + ")"
        }
        _ => {
            let b = bool_expr(g, idx, d);
            "Shape::Flag(" + b + ", " + int_expr(g, idx, d) + ")"
        }
    }
}

fn bool_expr(g: Gen, idx: Int, d: Int) -> String {
    if d <= 0 {
        return bool_leaf(g);
    }
    match intn(g, 9) {
        0 => bool_leaf(g),
        1 => paren(int_expr(g, idx, d - 1), pick(g, "<~<=~>~>=~==~!="), int_expr(g, idx, d - 1)),
        2 => paren(int_expr(g, idx, d - 1), pick(g, "<~<=~>~>=~==~!="), int_expr(g, idx, d - 1)),
        3 => paren(bool_expr(g, idx, d - 1), pick(g, "&&~||"), bool_expr(g, idx, d - 1)),
        4 => "(!" + bool_expr(g, idx, d - 1) + ")",
        5 => {
            let x = int_expr(g, idx, d - 1);
            "(" + x + ".to_string() == " + int_expr(g, idx, d - 1) + ".to_string())"
        }
        6 => {
            let s = str_expr(g, idx, d - 1);
            let m = pick(g, "contains~starts_with~ends_with");
            s + "." + m + "(" + str_expr(g, idx, d - 1) + ")"
        }
        7 => {
            let v = pick_var(g, t_vec(), false);
            if v == "" {
                return bool_leaf(g);
            }
            v + ".get(" + vec_index(g, idx) + ")." + pick(g, "is_some~is_none") + "()"
        }
        _ => paren(bool_expr(g, idx, d - 1), "==", bool_expr(g, idx, d - 1)),
    }
}

// ---- collections, structs, for loops and strings ----

// small_int is an Int expression in [0, 8] used as a loop trip count
// (`lo..(lo + n)` is then empty or has at most 8 iterations, even when
// `lo + n` wraps around).
fn small_int(g: Gen, idx: Int) -> String {
    if intn(g, 2) == 0 {
        return intn(g, 9).to_string();
    }
    "(" + int_expr(g, idx, 1) + " % 9).abs()"
}

fn vec_index(g: Gen, idx: Int) -> String {
    if intn(g, 7) == 0 {
        return "(" + int_expr(g, idx, 1) + " % 4)";
    }
    pick(g, "0~1~2~-1~3~100")
}

fn map_key(g: Gen, idx: Int, ty: Int) -> String {
    if ty == t_mapi() {
        return match intn(g, 6) {
            0 => "(" + int_expr(g, idx, 1) + " % 3)",
            1 => int_leaf(g),
            _ => pick(g, "0~1~2~-1"),
        };
    }
    if intn(g, 5) == 0 {
        return "(" + int_expr(g, idx, 1) + " % 3).to_string()";
    }
    pick(g, "\"a\"~\"b\"~\"\"~\"ab\"")
}

fn map_type(ty: Int) -> String {
    if ty == t_mapi() {
        "HashMap<Int, Int>"
    } else {
        "HashMap<String, Int>"
    }
}

fn coll_stmt(g: Gen, idx: Int, ind: String, k: Int) {
    if k == 0 {
        // new Vec, optionally prefilled
        let v = fresh(g, "v");
        ln(g, ind + "let mut " + v + ": Vec<Int> = Vec::new();");
        let n = intn(g, 4);
        for i in 0..n {
            ln(g, ind + v + ".push(" + int_expr(g, idx, 2) + ");");
        }
        add_var(g, v, t_vec(), false);
    } else if k == 1 {
        // Vec mutation
        let v = pick_var(g, t_vec(), false);
        if v == "" {
            coll_stmt(g, idx, ind, 0);
            return;
        }
        let mut op = intn(g, 4);
        if op == 0 && g.no_push {
            op = 1;
        }
        if op == 0 {
            ln(g, ind + v + ".push(" + int_expr(g, idx, 2) + ");");
        } else if op == 1 {
            let i = vec_index(g, idx);
            let x = int_expr(g, idx, 2);
            let p = declare(g, t_bool(), "p", false);
            ln(g, ind + "let " + p + " = " + v + ".set(" + i + ", " + x + ");");
        } else if op == 2 {
            let d = int_leaf(g);
            let x = declare(g, t_int(), "x", false);
            ln(g, ind + "let " + x + " = " + v + ".pop().unwrap_or(" + d + ");");
        } else {
            // alias
            let a = declare(g, t_vec(), "w", false);
            ln(g, ind + "let mut " + a + " = " + v + ";");
        }
    } else if k == 2 {
        // new Map
        let mut ty = t_mapi();
        let mut prefix = "m";
        if intn(g, 2) == 1 {
            ty = t_maps();
            prefix = "n";
        }
        let m = declare(g, ty, prefix, false);
        ln(g, ind + "let mut " + m + ": " + map_type(ty) + " = HashMap::new();");
        let n = intn(g, 4);
        for i in 0..n {
            let key = map_key(g, idx, ty);
            ln(g, ind + m + ".insert(" + key + ", " + int_expr(g, idx, 2) + ");");
        }
    } else if k == 3 {
        // Map mutation
        let mut ty = t_mapi();
        if intn(g, 2) == 1 {
            ty = t_maps();
        }
        let m = pick_var(g, ty, false);
        if m == "" {
            coll_stmt(g, idx, ind, 2);
            return;
        }
        let key = map_key(g, idx, ty);
        let op = intn(g, 4);
        if op <= 1 {
            ln(g, ind + m + ".insert(" + key + ", " + int_expr(g, idx, 2) + ");");
        } else if op == 2 {
            ln(g, ind + m + ".remove(&" + key + ");");
        } else {
            let a = declare(g, ty, "alias", false);
            ln(g, ind + "let mut " + a + " = " + m + ";");
        }
    } else if k == 4 {
        // struct
        let e = int_expr(g, idx, 2);
        let a = declare(g, t_acc(), "s", false);
        ln(g, ind + "let mut " + a + " = Acc { total: " + e + ", hits: 0, log: Vec::new() };");
    } else if k == 5 {
        // struct mutation through an alias or a call
        let a = pick_var(g, t_acc(), false);
        if a == "" {
            coll_stmt(g, idx, ind, 4);
            return;
        }
        let op = intn(g, 4);
        if op == 0 {
            ln(g, ind + a + ".total = " + int_expr(g, idx, 2) + ";");
        } else if op == 1 {
            if g.no_push {
                ln(g, ind + a + ".hits = " + a + ".hits * 2;");
            } else {
                ln(g, ind + "bump(" + a + ", " + int_expr(g, idx, 2) + ");");
            }
        } else if op == 2 {
            let t = declare(g, t_acc(), "t", false);
            ln(g, ind + "let mut " + t + " = " + a + ";");
        } else if g.no_push {
            ln(g, ind + a + ".total = " + a + ".total - " + a + ".log.len();");
        } else {
            ln(g, ind + a + ".log.push(" + int_expr(g, idx, 1) + ");");
        }
    } else if k == 6 || k == 7 {
        // for loops
        if g.loops >= 2 {
            stmt(g, idx, ind);
            return;
        }
        for_loop(g, idx, ind);
    } else if k == 8 {
        // string-valued binding folded into an Int
        let e = str_expr(g, idx, 3);
        let x = declare(g, t_int(), "h", false);
        ln(g, ind + "let " + x + " = hash(" + e + ");");
    } else {
        // Vec<String> join
        let s = str_expr(g, idx, 2);
        let sep = str_lit(g);
        let e = "hash(" + s + ".split(" + sep + ").join(" + str_lit(g) + "))";
        let x = declare(g, t_int(), "j", false);
        ln(g, ind + "let " + x + " = " + e + ";");
    }
}

fn for_loop(mut g: Gen, idx: Int, ind: String) {
    let init = int_expr(g, idx, 1);
    let acc = fresh(g, "acc");
    ln(g, ind + "let mut " + acc + " = " + init + ";");
    let mut label = "";
    let mut lp = "";
    if intn(g, 2) == 0 {
        label = "'" + fresh(g, "l");
        lp = label + ": ";
    }
    let saved = g.vars.len();
    let saved_no_push = g.no_push;
    let x = fresh(g, "k");
    let v = pick_var(g, t_vec(), false);
    let a = pick_var(g, t_acc(), false);
    if v != "" && intn(g, 2) == 0 {
        ln(g, ind + lp + "for " + x + " in " + v + " {");
        g.no_push = true;
    } else if a != "" && intn(g, 3) == 0 {
        ln(g, ind + lp + "for " + x + " in " + a + ".log {");
        g.no_push = true;
    } else {
        let mut lo = pick(g, "0~1~-2~");
        if lo == "" {
            lo = int_leaf(g);
        }
        ln(g, ind + lp + "for " + x + " in " + lo + "..(" + lo + " + " + small_int(g, idx) + ") {");
    }
    add_var(g, x, t_int(), false);
    add_var(g, acc, t_int(), true);
    g.loops = g.loops + 1;
    g.labels.push(label);
    let inner = ind + "    ";
    let n = 1 + intn(g, 3);
    for i in 0..n {
        let k = intn(g, 5);
        if k == 0 {
            ln(g, inner + "if " + bool_expr(g, idx, 1) + " {");
            ln(g, inner + "    continue" + jump_label(g) + ";");
            ln(g, inner + "}");
        } else if k == 1 {
            ln(g, inner + "if " + bool_expr(g, idx, 1) + " {");
            ln(g, inner + "    break" + jump_label(g) + ";");
            ln(g, inner + "}");
        } else {
            stmt(g, idx, inner);
        }
    }
    ln(g, inner + acc + " = " + int_expr(g, idx, 2) + ";");
    g.loops = g.loops - 1;
    g.labels.pop();
    ln(g, ind + "}");
    // variables declared in the body are dropped; outer collections may
    // have been mutated
    truncate(g, saved);
    add_var(g, acc, t_int(), true);
    g.no_push = saved_no_push;
}

fn coll_int_expr(g: Gen, idx: Int, d: Int, k: Int) -> String {
    if k <= 1 {
        let v = pick_var(g, t_vec(), false);
        if v != "" {
            return match intn(g, 4) {
                0 => v + ".len()",
                1 => v + ".get(" + vec_index(g, idx) + ").unwrap_or(" + int_leaf(g) + ")",
                2 => {
                    let y = fresh(g, "e");
                    let i = vec_index(g, idx);
                    "(match "
                        + v
                        + ".get("
                        + i
                        + ") { Some("
                        + y
                        + ") => "
                        + y
                        + " * 3, None => "
                        + int_leaf(g)
                        + " })"
                }
                _ => "vsum(" + v + ")",
            };
        }
    } else if k == 2 {
        let mut ty = t_mapi();
        if intn(g, 2) == 1 {
            ty = t_maps();
        }
        let m = pick_var(g, ty, false);
        if m != "" {
            let key = map_key(g, idx, ty);
            return match intn(g, 4) {
                0 => m + ".len()",
                1 => m + ".get(&" + key + ").unwrap_or(" + int_leaf(g) + ")",
                2 => {
                    let l = int_leaf(g);
                    "(if "
                        + m
                        + ".contains_key(&"
                        + key
                        + ") { "
                        + l
                        + " } else { "
                        + int_leaf(g)
                        + " })"
                }
                _ => {
                    if ty == t_mapi() {
                        "mfold(" + m + ")"
                    } else {
                        "sfold(" + m + ")"
                    }
                }
            };
        }
    } else if k == 3 {
        let a = pick_var(g, t_acc(), false);
        if a != "" {
            return match intn(g, 4) {
                0 => a + ".total",
                1 => a + ".hits",
                2 => a + ".log.len()",
                _ => "vsum(" + a + ".log)",
            };
        }
    } else if k == 4 {
        return "hash(" + str_expr(g, idx, d - 1) + ")";
    } else if k == 5 {
        let s = str_expr(g, idx, d - 1);
        return match intn(g, 5) {
            0 => s + ".len()",
            1 => s + ".index_of(" + str_expr(g, idx, d - 1) + ").unwrap_or(-1)",
            2 => s + ".char_at(" + vec_index(g, idx) + ").unwrap_or(-1)",
            3 => s + ".split(" + str_lit(g) + ").len()",
            _ => s + ".parse_int().unwrap_or(" + int_leaf(g) + ")",
        };
    } else if k == 6 {
        let x = int_expr(g, idx, d - 1);
        let m = pick(g, "min~max");
        return x + "." + m + "(" + int_expr(g, idx, d - 1) + ")";
    } else {
        let x = int_expr(g, idx, d - 1);
        let m = pick(g, "bit_and~bit_or~bit_xor~shl~shr~ushr");
        return x + "." + m + "(" + int_expr(g, idx, d - 1) + ")";
    }
    int_leaf(g)
}

fn str_expr(g: Gen, idx: Int, d: Int) -> String {
    if d <= 0 {
        return str_lit(g);
    }
    match intn(g, 10) {
        0 => str_lit(g),
        1 => str_lit(g),
        2 => int_expr(g, idx, d - 1) + ".to_string()",
        3 => {
            let x = str_expr(g, idx, d - 1);
            "(" + x + " + " + str_expr(g, idx, d - 1) + ")"
        }
        4 => {
            let s = str_expr(g, idx, d - 1);
            let i = vec_index(g, idx);
            s + ".slice(" + i + ", " + vec_index(g, idx) + ")"
        }
        5 => {
            let s = str_expr(g, idx, d - 1);
            let x = str_lit(g);
            s + ".replace(" + x + ", " + str_lit(g) + ")"
        }
        6 => str_expr(g, idx, d - 1) + "." + pick(g, "trim~to_upper~to_lower") + "()",
        7 => "String::from_char(32 + (" + int_expr(g, idx, d - 1) + " % 90).abs())",
        8 => "String::from_bytes(" + str_expr(g, idx, d - 1) + ".to_bytes())",
        _ => {
            let s = str_expr(g, idx, d - 1);
            let x = str_lit(g);
            s + ".split(" + x + ").join(" + str_lit(g) + ")"
        }
    }
}

// ---- programs ----

struct Program {
    prog: String,
    main: String,
    calls: String,
}

// arg_sets: the arguments every generated function is called with, as
// "a b c" (JSON values); `min` stands for the smallest Int.
fn arg_sets() -> Vec<String> {
    let mut v = Vec::new();
    v.push("0 0 false");
    v.push("1 -1 true");
    v.push("7 3 true");
    v.push("-13 4 false");
    v.push("9223372036854775807 -1 true");
    v.push("-9223372036854775808 -1 false");
    v.push("123456789 0 true");
    v.push("42 65536 false");
    v
}

// int_src writes an Int argument as a Kekkai expression (the smallest Int
// has no literal).
fn int_src(s: String) -> String {
    if s == "-9223372036854775808" {
        return "(-9223372036854775807 - 1)";
    }
    s
}

fn generate(seed: Int) -> Program {
    let g = new_gen(seed);
    prelude(g);
    let nfuncs = 2 + intn(g, 4);
    for i in 0..nfuncs {
        gen_fn(g, i);
    }
    let prog = g.out.join("");

    let mut main = Vec::new();
    let mut calls = Vec::new();
    main.push("// Driver of the generated program prog.kek (seed " + seed.to_string() + ").\n");
    main.push("#[main]\n");
    main.push("fn main(args: Vec<String>, log: &Log) -> Int {\n");
    for i in 0..nfuncs {
        let f = "f" + i.to_string();
        for set in arg_sets() {
            let xs = set.split(" ");
            let a = xs.get(0).unwrap_or("0");
            let b = xs.get(1).unwrap_or("0");
            let c = xs.get(2).unwrap_or("false");
            let label = f + "(" + a + ", " + b + ", " + c + ")";
            let call = f + "(" + int_src(a) + ", " + int_src(b) + ", " + c + ")";
            main.push("    log.info(\"" + label + " = \" + " + call + ".to_string());\n");
            calls.push(f + " " + set + "\n");
        }
    }
    main.push("    0\n");
    main.push("}\n");
    Program { prog: prog, main: main.join(""), calls: calls.join("") }
}

fn write(fs: &Fs, log: &Log, path: String, s: String) -> Bool {
    match fs.write(path, s) {
        Ok(_) => true,
        Err(e) => {
            log.error(path + ": " + e.message());
            false
        }
    }
}

#[main]
fn main(args: Vec<String>, fs: &Fs, log: &Log) -> Int {
    if args.len() < 2 || args.len() > 3 {
        log.error("usage: gen.kek <out-dir> <first-seed> [count]");
        return 2;
    }
    let dir = args.get(0).unwrap_or(".");
    let first = match args.get(1).unwrap_or("").parse_int() {
        Some(n) => n,
        None => {
            log.error("gen.kek: bad seed");
            return 2;
        }
    };
    let count = match args.get(2).unwrap_or("1").parse_int() {
        Some(n) => n,
        None => {
            log.error("gen.kek: bad count");
            return 2;
        }
    };
    for seed in first..first + count {
        let p = generate(seed);
        let d = dir + "/seed" + seed.to_string() + "/";
        if !write(fs, log, d + "prog.kek", p.prog)
            || !write(fs, log, d + "main.kek", p.main)
            || !write(fs, log, d + "calls.txt", p.calls) {
            return 1;
        }
    }
    0
}

// jump_label is the label of a `break` / `continue`: " 'l3" for one of the
// labeled enclosing loops, or "" (the innermost loop).
fn jump_label(g: Gen) -> String {
    let k = intn(g, g.labels.len() + 1);
    let l = g.labels.get(k).unwrap_or("");
    if l == "" {
        return "";
    }
    " " + l
}
