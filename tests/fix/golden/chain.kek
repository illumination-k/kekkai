// A mutated `&T` parameter becomes `&mut T`; then its callers need
// mutable bindings, which the next round adds.

fn add(v: &mut Vec<Int>, x: Int) {
    v.push(x);
}

fn add_twice(v: &mut Vec<Int>, x: Int) {
    add(v, x);
    add(v, x);
}

#[main]
fn main(log: &Log) -> Int {
    let mut v = Vec::new();
    add_twice(&mut v, 1);
    log.info(v.len().to_string());
    0
}
