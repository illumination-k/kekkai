// Personal data of P1 (`Pii<T>`) becomes a labeled value: the type and the
// constructor are rewritten, and the missing `mut` added as usual.
struct User {
    id: Int,
    email: Labeled<PII, String>, // the address
}

fn users(raw: Vec<String>) -> Vec<User> {
    let mut out = Vec::new();
    let mut i = 0;
    for s in raw {
        out.push(User { id: i, email: PII::label(s) });
        i = i + 1;
    }
    out
}

fn first_masked(us: Vec<Labeled<PII, String>>) -> String {
    match us.get(0) {
        Some(p) => p.mask(),
        None => "",
    }
}
