#[derive(PartialEq, Eq, Hash)]
struct P {
    x: Int,
}

trait Shape: PartialEq {
    type Unit;
    fn area(&self) -> Int;
    fn twice(&self) -> Int {
        self.area() * 2
    }
}

impl Shape for P {
    type Unit = Int;
    fn area(&self) -> Int {
        self.x
    }
}

fn big<T>(v: Vec<T>) -> Option<T>
where
    T: Ord + Hash,
{
    v.iter().max()
}

fn apply<F: Fn(Int) -> Int>(f: F) -> impl Fn(Int) -> Int {
    move |x| f(x) + 1
}

